// 20. Two siblings and the parent reading one finished child's closure at
// once, each getting a clone of it (MYLA-148): part 2 of t18, on its own
struct P {
    name: str,
    tags: [str],
}

fun make(s: str, p: P) -> (int) -> int {
    let xs = [1, 2, 3]
    let g = (k: int) => k + len(p.tags)
    return (n: int) => n + len(s) + len(xs) + g(n) + len(p.name)
}

async fun use(f: (int) -> int, n: int) -> int {
    var t = 0
    for i in 0..n {
        t = t + f(i)
    }
    return t
}

async fun maker(i: int) -> (int) -> int {
    return make(f"k{i}", P { name: "pq", tags: ["a", f"t{i}"] })
}

#main
async fun main() {
    var total = 0
    var round = 0
    while round < 2000 {
        async let m = maker(round)
        async let c = use(await m, 5)
        async let d = use(await m, 7)
        let mine = await m
        total = total + await c + await d + mine(2)
        round = round + 1
    }
    print(total)
}
