// 8. A failure while a sibling computes without a suspension point
// (MYLA-170): the failure is reported when it happens; the program ends once
// the sibling reaches its next suspension point (D94 (2), D97), here the
// call of the actor after its loop. The failure happens in that actor's
// method, which holds it: a sibling that comes to the actor after it can't
// go on, and one that came before has passed its suspension point before
// the failure and goes on legitimately (on many workers the sibling may
// start and finish its loop before the failing task starts, MYLA-781), so
// it prints only what came after the failure: nothing, ever. Whether the
// sibling has started by then depends on timing, so it prints nothing
// before it.
actor Log {
    n: int,
}

impl Log {
    fun note(var self) -> int {
        self.n = self.n + 1
        return self.n
    }

    fun fail(var self) -> int {
        self.n = self.n + 1
        panic("failure beside a busy sibling")
        return self.n
    }
}

async fun busy(log: Log) -> int {
    var x = 0
    for i in 0..300000 {
        x = (x * 17 + 5) % 1009
    }
    let n = await log.note()
    if n > 1 {
        print("never")
    }
    return x
}

async fun fail_soon(log: Log) -> int {
    return await log.fail()
}

#main
async fun main() {
    let log = Log { n: 0 }
    async let a = busy(log)
    async let b = fail_soon(log)
    print(await a + await b)
}
