// 5. Three siblings and the parent all reading one child's heap result
struct Rec {
    name: str,
    tags: [str],
}

actor Log {
    n: int,
}

impl Log {
    fun tick(var self) -> int {
        self.n = self.n + 1
        return self.n
    }
}

async fun make(i: int, log: Log) -> [Rec] {
    let x = await log.tick()
    return [Rec { name: f"r{i}", tags: ["a", f"t{i}"] }, Rec { name: "s", tags: [] }]
}

async fun size(rs: [Rec], log: Log) -> int {
    let x = await log.tick()
    var n = 0
    for r in rs {
        n = n + r.name.len() + r.tags.len()
    }
    return n
}

async fun extend(rs: [Rec]) -> int {
    var mine = rs
    mine[0].tags.push("more")
    return mine[0].tags.len()
}

#main
async fun main() {
    let log = Log { n: 0 }
    var total = 0
    var round = 0
    while round < 3000 {
        async let a = make(round, log)
        async let b = size(await a, log)
        async let c = extend(await a)
        async let d = size(await a, log)
        let mine = await a
        total = total + await b + await c + await d + mine[0].tags.len()
        round = round + 1
    }
    print(total)
}
