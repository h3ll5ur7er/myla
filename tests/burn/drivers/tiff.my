// std.tiff's `decode` (MYLA-965) through image_driver's protocol: page 0 at
// 8 bits. `pages` and `tags` run on every input too, so the fuzz runs reach
// them; their results don't matter here.

import std.tiff as tiff
from std.image import Image8, ImageError
import image_driver as driver

fun decode(b: [uint8], max: int64) -> Result<Image8, ImageError> {
    let all = tiff.pages(b)
    let found = tiff.tags(b, 0)
    let first = tiff.info(b)
    return tiff.decode(b, 0, max)
}

fun main() {
    driver.serve8(decode)
}
