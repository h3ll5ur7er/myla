// std.jpeg's encoder under tests/burn/test_jpeg_encode.py (MYLA-937): each
// line of stdin is `<input>\t<output>\t<quality>\t<subsampling>`, the input
// a PNM or PAM image (std.pnm) or `photo:<w>x<h>`, benchmarks/images_std.my's
// picture of that size; the subsampling `444`, `422` or `420`. The image is
// encoded into the output file, which std.jpeg's decoder reads back. Each
// line's answer:
//
//     ok <bytes> <width> <height> <layout> <decoded> <psnr> <file>
//     err <what>
//
// `decoded` is the SHA-256 of the samples decoded, `psnr` theirs against
// the image's (without its alpha) in dB to 3 places, `file` the SHA-256 of
// the file written.

import std.jpeg as jpeg
from std.jpeg import Subsampling
import std.pnm as pnm
import std.image as image
from std.image import Image, Image8, Layout
import std.imgproc as imgproc
import std.digest as digest
import std.encoding as encoding
import std.fs as fs
import std.num as num
from std.io import stdin, println

#test("444")[Some(Subsampling.S444)]
#test("422")[Some(Subsampling.S422)]
#test("420")[Some(Subsampling.S420)]
#test("411")[None]
fun subsampling_of(s: str) -> Option<Subsampling> {
    return match s {
        "444" => Some(Subsampling.S444)
        "422" => Some(Subsampling.S422)
        "420" => Some(Subsampling.S420)
        _ => None
    }
}

// benchmarks/images_std.my's picture, pixel (x, y) of `w` by `h` as
// r << 16 | g << 8 | b (images_pillow.py's `photo`).
#test(0, 0, 4000, 3000)[231]
#test(1333, 1500, 4000, 3000)[15017757]
#test(17, 2345, 4000, 3000)[1740981]
fun photo_rgb(x: int, y: int, w: int, h: int) -> int {
    let X = x as int64
    let Y = y as int64
    let W = w as int64
    let H = h as int64
    var m = ((X * 73856093i64) ^ (Y * 19349663i64)) & 0xFFFFFFFFi64
    m = ((m ^ (m >> 13i64)) * 0x5BD1E995i64) & 0xFFFFFFFFi64
    let n = ((m ^ (m >> 15i64)) & 31i64) - 16i64
    var r = X * 200i64 / W + Y * 55i64 / H + n
    var g = Y * 180i64 / H + (X + Y) * 60i64 / (W + H) + n
    var b = 255i64 - X * 128i64 / W - Y * 64i64 / H + n - 8i64
    if inside(X, Y, W / 3i64, H / 2i64, H / 5i64) {
        r = 230i64 + n
        g = 40i64 + n
        b = 30i64 + n
    } else if inside(X, Y, 2i64 * W / 3i64, H / 3i64, H / 7i64) {
        r = 20i64 + n
        g = 90i64 + n
        b = 200i64 + n
    }
    return ((clamp8(r) << 16i64) | (clamp8(g) << 8i64) | clamp8(b)) as int
}

fun inside(x: int64, y: int64, cx: int64, cy: int64, r: int64) -> bool {
    return (x - cx) * (x - cx) + (y - cy) * (y - cy) < r * r
}

fun clamp8(v: int64) -> int64 {
    return if v < 0i64 { 0i64 } else if v > 255i64 { 255i64 } else { v }
}

fun photo(w: int, h: int) -> Image8 {
    var data: [uint8] = []
    for y in 0..h {
        for x in 0..w {
            let p = photo_rgb(x, y, w, h)
            data.push(((p >> 16) & 255) as uint8)
            data.push(((p >> 8) & 255) as uint8)
            data.push((p & 255) as uint8)
        }
    }
    return Image { width: w, height: h, layout: Layout.Rgb, data: data }
}

// The image `input` names.
fun load(input: str) -> Result<Image8, str> {
    if input.starts_with("photo:") {
        let size = input[6:].split("x")
        if size.len() == 2 {
            if let Some(w) = num.parse_int(size[0]) {
                if let Some(h) = num.parse_int(size[1]) {
                    return Ok(photo(w as int, h as int))
                }
            }
        }
        return Err(f"no size in {input}")
    }
    let Ok(data) = fs.read_bytes(input) else { return Err(f"cannot read {input}") }
    return match pnm.decode(data, image.MAX_PIXELS) {
        Ok(img) => Ok(img)
        Err(e) => Err(f"{input}: {e}")
    }
}

fun one(input: str, out: str, quality: str, sub: str) -> str {
    let loaded = load(input)
    if let Err(e) = loaded {
        return f"err {e}"
    }
    let Ok(img) = loaded else { return "err" }
    let Some(q) = num.parse_int(quality) else { return f"err quality {quality}" }
    let Some(s) = subsampling_of(sub) else { return f"err subsampling {sub}" }
    let b = jpeg.encode(img, q as int, s)
    if let Err(e) = fs.write_bytes(out, b) {
        return f"err cannot write {out}: {e}"
    }
    let Ok(d) = jpeg.decode(b, image.MAX_PIXELS) else { return "err our decoder can't read our file" }
    let Ok(v) = imgproc.psnr(img.convert(d.layout), d) else { return "err psnr: the sizes differ" }
    let p = if v > 999.0 { "inf" } else { f"{v:.3}" }
    let hd = encoding.hex_encode(digest.sha256(d.data))
    let hf = encoding.hex_encode(digest.sha256(b))
    return f"ok {b.len()} {d.width} {d.height} {d.layout} {hd} {p} {hf}"
}

fun main() {
    var r = stdin()
    while true {
        let line = match r.read_line() {
            Ok(Some(l)) => l
            _ => ""
        }
        if line.len() == 0 {
            break
        }
        let parts = line.split("\t")
        if parts.len() != 4 {
            println(f"err a request of {parts.len()} fields")
        } else {
            println(one(parts[0], parts[1], parts[2], parts[3]))
        }
    }
}
