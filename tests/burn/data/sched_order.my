import std.task as task

async fun leaf(name: str, k: int) -> int {
    print(name)
    if k > 0 {
        let x = await leaf(name + ".", k - 1)
        print(name + " again")
        return x + 1
    }
    return 1
}

async fun node(name: str, depth: int) -> int {
    print("enter " + name)
    if depth == 0 {
        return await leaf(name, 1)
    }
    async let a = node(name + "a", depth - 1)
    async let b = node(name + "b", depth - 1)
    print("spawned " + name)
    let x = await a
    print("got a " + name)
    let y = await b
    print("got b " + name)
    return x + y
}

#main
async fun main() {
    var fs: [async () -> int] = []
    for i in 0..5 {
        let k = i
        push(fs, async () => await leaf(f"f{k}", k % 2))
    }
    let r = await task.all(fs)
    print(len(r))
    print(await node("n", 3))
}
