// subprocess/main.my — spawn an external program and capture its output.
//
// Programs are located by exact path (no PATH search); the child inherits the
// current environment. Output comes back as raw bytes (`[uint8]`).

from std.io import write, println, eprintln
from std.process import run, command, Output, ExitStatus, SpawnError, exit

// Decode a `[uint8]` byte buffer as UTF-8 text into a StringBuilder-backed str.
fun decode(bytes: [uint8]) -> str {
    var sb = StringBuilder()
    for b in bytes {
        append_byte(sb, b)
    }
    return build(sb)
}

fun describe_status(s: ExitStatus) -> str {
    return match s {
        ExitStatus.Exited(code) => format("exited {}", code),
        ExitStatus.Signaled(sig) => format("signaled {}", sig),
    }
}

fun describe_error(e: SpawnError) -> str {
    return match e {
        SpawnError.NotFound => "not found (as expected)",
        SpawnError.PermissionDenied => "permission denied",
        SpawnError.Other(code) => format("other errno {}", code),
    }
}

fun report(out: Output) {
    write(1, decode(out.stdout))
    println(describe_status(out.status))
}

fun main() {
    // 1) The convenience `run(program, args)` helper.
    match run("/bin/echo", ["hello", "from", "myla"]) {
        Ok(out) => report(out),
        Err(e) => {
            eprintln("spawn failed")
            exit(1)
        }
    }

    // 2) The `Command` builder.
    match command("/bin/echo").arg("built").arg("with").arg("Command").output() {
        Ok(out) => report(out),
        Err(e) => {
            eprintln("spawn failed")
            exit(1)
        }
    }

    // 3) An error path: a program that does not exist.
    match run("/no/such/program", []) {
        Ok(out) => {
            println("unexpected success")
        }
        Err(e) => {
            println(describe_error(e))
        }
    }
}
