// types_and_aliases.my — sized integer primitives, the built-in `int` alias,
// integer literal suffixes, and user-defined `typealias`.

typealias Byte = uint8

// uint8 arithmetic wraps modulo 2^8.
#test(255u8)[0u8]
#test(0u8)[1u8]
fun inc(b: Byte) -> Byte {
    return b + 1u8
}

// `int` is a built-in alias for `int32`, so the two are interchangeable.
#test(2, 40)[42]
fun add_mixed(a: int, b: int32) -> int {
    return a + b
}

// A wider type carries larger values; the literal adopts the operand's type.
#test(3)[9]
fun square(n: int64) -> int64 {
    return n * n
}

fun main() {
    print(inc(255u8))       // 0
    print(add_mixed(2, 40)) // 42
    print(square(3))        // 9
}
