// std.fs — minimal filesystem access (v0.5.4, D29).
//
// `read_to_string` opens a file, reads it whole, and closes it, returning the
// contents as a `str` or an `IoError` describing why it failed. Errors are
// carried in a `Result`, so callers compose them with `?` (D16/D36). The
// underlying open/read/close run as raw Linux syscalls natively and as Python
// file IO in the interpreter, with identical (errno-keyed) error mapping.

// Why a filesystem operation failed. `Other` carries the raw OS errno for
// anything not given its own variant.
pub enum IoError {
    NotFound,
    PermissionDenied,
    Other(int32),
}

// Map a (nonzero) OS errno to an `IoError`. ENOENT/EACCES on Linux.
fun from_errno(code: int32) -> IoError {
    if code == 2 {
        return IoError.NotFound
    }
    if code == 13 {
        return IoError.PermissionDenied
    }
    return IoError.Other(code)
}

// Read the entire file at `path` into a string. On success the bytes are
// returned verbatim (as UTF-8 text); on failure an `IoError` is returned.
pub fun read_to_string(path: str) -> Result<str, IoError> {
    let data = __read_file(path)
    let err = __io_errno()
    if err == 0 {
        return Ok(data)
    }
    return Err(from_errno(err))
}
