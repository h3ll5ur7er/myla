// gen_main.my -- `compile` tool, written in Myla (self-hosting v0.9).
//
// Reads a .my file, lexes + parses + type-checks it (prepending the same
// prelude `myla run` injects), generates x86-64 assembly, and writes that
// assembly to stdout. A thin host wrapper runs `as`/`ld` over it (§4 of
// docs/self-hosting.md), so this stays a pure front-end + codegen with no
// process spawning of its own.

from std.process import args, exit
from std.fs import read_to_string
from std.io import write, eprintln
from .checker import build_checker_src
from .codegen import new_codegen

fun emit_asm(src: str) -> int32 {
    return match build_checker_src(src) {
        Ok(c) => {
            var g = new_codegen(c)
            write(1, g.generate())
            0
        },
        Err(e) => {
            eprintln("gen_main: program failed to type-check")
            1
        },
    }
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        eprintln("usage: gen_main <file.my>")
        exit(2)
    }
    match read_to_string(argv[1]) {
        Ok(src) => {
            let code = emit_asm(src)
            exit(code)
        },
        Err(e) => {
            eprintln("gen_main: cannot read input file")
            exit(1)
        },
    }
}
