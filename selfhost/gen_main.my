// gen_main.my -- `compile` tool, written in Myla (self-hosting v0.9).
//
// Reads a .my file, loads and links its modules, type-checks the program
// (with the same prelude `myla run` injects), generates x86-64 assembly, and writes that
// assembly to stdout. A thin host wrapper runs `as`/`ld` over it (see
// docs/Architecture/Self-hosted-compiler.md), so this stays a pure front-end + codegen with no
// process spawning of its own. `--package name=dir` adds a dependency, as in
// `myla build` (MYLA-92); `--root dir` sets the project root (default: the
// file's directory), as the project tool does for files under `src/`.
// Every function goes through the IR (D79, MYLA-107); `--emit-ir` prints it
// instead of the assembly.

from std.process import args, exit
from std.io import write, eprintln
from std.platform import TARGET
from .checker import build_checker_with
from .codegen import new_codegen
from .dwarf import read_gdb_script
from .loader import load_program_opts, load_options, for_target, parse_package_flag, Loaded, type_errors
from .stdroot import default_stdlib_root
from .diag import render

// How the assembly is generated: `debug`, DWARF debug information, so gdb
// steps through the Myla source and shows its variables (MYLA-71, MYLA-66),
// with the pretty-printers from `stdlib_root` embedded (D82); `emit_ir`, the
// IR's text instead of the assembly (every function goes through the IR,
// MYLA-107).
// `frames`: async functions run on frames even without an `async let`
// (`--async-frames`, for the tests of D90's lowering). `ssa`: D123's
// prototype, each function's scalar slots promoted before it is emitted
// (`--ssa`; `--ssa-stats` also reports what that did on stderr, and with
// `--emit-ir` the text shows the promoted functions). `no_inline`: no
// small function copied into its callers (`--no-inline`, for the tests of
// one function's code). `target`: `x86_64-linux`, `aarch64-linux`
// (MYLA-163) or `wasm32-wasi` (MYLA-158) with `--target`; by default the
// target this compiler was built for, the machine's it runs on (MYLA-276).
// `primitives`: the program may call the raw-memory primitives
// (`--primitives`, for the tests of their code; an error otherwise).
struct Mode { debug: bool, emit_ir: bool, frames: bool, ssa: bool, ssa_stats: bool, no_inline: bool, target: str, primitives: bool }

fun emit_asm(prog: Loaded, mode: Mode, stdlib_root: str) -> int32 {
    return match build_checker_with(prog.decls, prog.next_id, mode.primitives) {
        Ok(c) => {
            var g = new_codegen(c)
            if mode.frames { g.frames = true }
            if mode.target == "aarch64-linux" { g.a64 = true }
            if mode.target == "wasm32-wasi" { g.wasm = true }
            g.set_sources(prog.spans, prog.next_id)
            if mode.debug { g.enable_debug_info(read_gdb_script(stdlib_root)) }
            if mode.emit_ir { g.keep_ir_text() }
            if mode.ssa { g.ssa = true }
            if mode.no_inline { g.inlining = false }
            let asm = g.generate()
            if g.refused.len() > 0 {
                eprintln(render(type_errors(prog, g.refused)))
                return 1
            }
            if mode.ssa_stats {
                // D123's prototype: what promoting the scalar slots did
                let st = g.ssa_stats
                eprintln(format("ssa: {} of {} slots promoted; {} loads and {} stores removed (weighted {} and {}); {} join values, {} copies into them (weighted {})", st.promoted, st.slots, st.loads, st.stores, st.wloads, st.wstores, st.joins, st.copies, st.wcopies))
            }
            if mode.emit_ir { write(1, g.ir_text()) } else { write(1, asm) }
            0
        },
        Err(errs) => {
            eprintln(render(type_errors(prog, errs)))
            1
        },
    }
}

fun main() {
    let argv = args()
    if argv.len() < 2 {
        eprintln("usage: gen_main <file.my> [stdlib_root] [-g] [--emit-ir] [--no-inline] [--primitives] [--ssa | --ssa-stats] [--target x86_64-linux|aarch64-linux|wasm32-wasi] [--package name=dir]... [--root dir]")
        exit(2)
    }
    var opts = load_options(default_stdlib_root())
    opts.runtime = true
    var mode = Mode { debug: false, emit_ir: false, frames: false, ssa: false, ssa_stats: false, no_inline: false, target: TARGET, primitives: false }
    var j = 2
    while j < argv.len() {
        if argv[j] == "-g" {
            mode.debug = true
        } else if argv[j] == "--emit-ir" {
            mode.emit_ir = true
        } else if argv[j] == "--async-frames" {
            mode.frames = true
        } else if argv[j] == "--no-inline" {
            mode.no_inline = true
        } else if argv[j] == "--primitives" {
            mode.primitives = true
        } else if argv[j] == "--ssa" {
            mode.ssa = true
        } else if argv[j] == "--ssa-stats" {
            mode.ssa = true
            mode.ssa_stats = true
        } else if argv[j] == "--package" && j + 1 < argv.len() {
            match parse_package_flag(argv[j + 1]) {
                Ok(pkg) => { opts.packages.push(pkg) },
                Err(r) => {
                    eprintln(render(r))
                    exit(1)
                },
            }
            j = j + 1
        } else if argv[j] == "--target" && j + 1 < argv.len() {
            mode.target = argv[j + 1]
            if mode.target != "x86_64-linux" && mode.target != "aarch64-linux" && mode.target != "wasm32-wasi" {
                eprintln(format("gen_main: unknown target '{}' (x86_64-linux, aarch64-linux, wasm32-wasi)", mode.target))
                exit(2)
            }
            j = j + 1
        } else if argv[j] == "--root" && j + 1 < argv.len() {
            opts.root = argv[j + 1]
            j = j + 1
        } else {
            opts.stdlib_root = argv[j]
        }
        j = j + 1
    }
    if mode.debug && mode.target != "x86_64-linux" {
        eprintln(format("gen_main: -g is not supported for {} yet", mode.target))
        exit(2)
    }
    match load_program_opts(argv[1], for_target(opts, mode.target)) {
        Ok(prog) => {
            let code = emit_asm(prog, mode, opts.stdlib_root)
            exit(code)
        },
        Err(r) => {
            eprintln(render(r))
            exit(1)
        },
    }
}
