// gen_main.my -- `compile` tool, written in Myla (self-hosting v0.9).
//
// Reads a .my file, loads and links its modules, type-checks the program
// (with the same prelude `myla run` injects), generates x86-64 assembly, and writes that
// assembly to stdout. A thin host wrapper runs `as`/`ld` over it (§4 of
// docs/self-hosting.md), so this stays a pure front-end + codegen with no
// process spawning of its own.

from std.process import args, exit
from std.io import write, eprintln
from .checker import build_checker_decls
from .codegen import new_codegen
from .loader import load_program, Loaded, file_of
from .diag import render, type_report

// `debug`: DWARF line tables, so gdb steps through the Myla source (MYLA-71).
fun emit_asm(prog: Loaded, debug: bool) -> int32 {
    return match build_checker_decls(prog.decls, prog.next_id) {
        Ok(c) => {
            var g = new_codegen(c)
            if debug { g.enable_line_tables(prog.spans, prog.next_id) }
            let asm = g.generate()
            write(1, asm)
            0
        },
        Err(e) => {
            eprintln(render(type_report(e.line, e.col, e.msg, file_of(prog, e.decl))))
            1
        },
    }
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        eprintln("usage: gen_main <file.my> [stdlib_root] [-g]")
        exit(2)
    }
    var stdlib = ""
    var debug = false
    var j = 2
    while j < len(argv) {
        if argv[j] == "-g" { debug = true } else { stdlib = argv[j] }
        j = j + 1
    }
    match load_program(argv[1], stdlib) {
        Ok(prog) => {
            let code = emit_asm(prog, debug)
            exit(code)
        },
        Err(r) => {
            eprintln(render(r))
            exit(1)
        },
    }
}
