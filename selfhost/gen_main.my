// gen_main.my -- `compile` tool, written in Myla (self-hosting v0.9).
//
// Reads a .my file, loads and links its modules, type-checks the program
// (with the same prelude `myla run` injects), generates x86-64 assembly, and writes that
// assembly to stdout. A thin host wrapper runs `as`/`ld` over it (see
// docs/Architecture/Self-hosted-compiler.md), so this stays a pure front-end + codegen with no
// process spawning of its own. `--package name=dir` adds a dependency, as in
// `myla build` (MYLA-92); `--root dir` sets the project root (default: the
// file's directory), as the project tool does for files under `src/`.

from std.process import args, exit
from std.io import write, eprintln
from .checker import build_checker_decls
from .codegen import new_codegen
from .dwarf import read_gdb_script
from .loader import load_program_opts, load_options, parse_package_flag, Loaded, file_of, default_stdlib_root
from .diag import render, type_report

// `debug`: DWARF debug information, so gdb steps through the Myla source and
// shows its variables (MYLA-71, MYLA-66), with the pretty-printers from
// `stdlib_root` embedded (D82).
fun emit_asm(prog: Loaded, debug: bool, stdlib_root: str) -> int32 {
    return match build_checker_decls(prog.decls, prog.next_id) {
        Ok(c) => {
            var g = new_codegen(c)
            g.set_sources(prog.spans, prog.next_id)
            if debug { g.enable_debug_info(read_gdb_script(stdlib_root)) }
            let asm = g.generate()
            write(1, asm)
            0
        },
        Err(e) => {
            eprintln(render(type_report(e.line, e.col, e.sp, e.msg, file_of(prog, e.decl))))
            1
        },
    }
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        eprintln("usage: gen_main <file.my> [stdlib_root] [-g] [--package name=dir]... [--root dir]")
        exit(2)
    }
    var opts = load_options(default_stdlib_root(argv[0]))
    var debug = false
    var j = 2
    while j < len(argv) {
        if argv[j] == "-g" {
            debug = true
        } else if argv[j] == "--package" && j + 1 < len(argv) {
            match parse_package_flag(argv[j + 1]) {
                Ok(pkg) => { push(opts.packages, pkg) },
                Err(r) => {
                    eprintln(render(r))
                    exit(1)
                },
            }
            j = j + 1
        } else if argv[j] == "--root" && j + 1 < len(argv) {
            opts.root = argv[j + 1]
            j = j + 1
        } else {
            opts.stdlib_root = argv[j]
        }
        j = j + 1
    }
    match load_program_opts(argv[1], opts) {
        Ok(prog) => {
            let code = emit_asm(prog, debug, opts.stdlib_root)
            exit(code)
        },
        Err(r) => {
            eprintln(render(r))
            exit(1)
        },
    }
}
