// gen_main.my -- `compile` tool, written in Myla (self-hosting v0.9).
//
// Reads a .my file, loads and links its modules, type-checks the program
// (with the same prelude `myla run` injects), generates x86-64 assembly, and writes that
// assembly to stdout. A thin host wrapper runs `as`/`ld` over it (§4 of
// docs/self-hosting.md), so this stays a pure front-end + codegen with no
// process spawning of its own.

from std.process import args, exit
from std.io import write, eprintln
from .checker import build_checker_decls
from .codegen import new_codegen
from .loader import load_program, Loaded
from .diag import render

fun emit_asm(prog: Loaded) -> int32 {
    return match build_checker_decls(prog.decls, prog.next_id) {
        Ok(c) => {
            var g = new_codegen(c)
            let asm = g.generate()
            write(1, asm)
            0
        },
        Err(e) => {
            eprintln(format("gen_main: type-check failed at {}:{}", e.line, e.col))
            1
        },
    }
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        eprintln("usage: gen_main <file.my> [stdlib_root]")
        exit(2)
    }
    var stdlib = ""
    if len(argv) >= 3 {
        stdlib = argv[2]
    }
    match load_program(argv[1], stdlib) {
        Ok(prog) => {
            let code = emit_asm(prog)
            exit(code)
        },
        Err(r) => {
            eprintln(render(r))
            exit(1)
        },
    }
}
