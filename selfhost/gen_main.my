// gen_main.my -- `compile` tool, written in Myla (self-hosting v0.9).
//
// Reads a .my file, loads and links its modules, type-checks the program
// (with the same prelude `myla run` injects), generates x86-64 assembly, and writes that
// assembly to stdout. A thin host wrapper runs `as`/`ld` over it (see
// docs/Architecture/Self-hosted-compiler.md), so this stays a pure front-end + codegen with no
// process spawning of its own. `--package name=dir` adds a dependency, as in
// `myla build` (MYLA-92); `--root dir` sets the project root (default: the
// file's directory), as the project tool does for files under `src/`.
// `--ir` lowers functions to the IR first (MYLA-103, D79), `--ir-stats` also
// reports on stderr how many went through it and why the others didn't,
// `--emit-ir` prints their IR instead of the assembly.

from std.process import args, exit
from std.io import write, eprintln
from .checker import build_checker_decls
from .codegen import new_codegen
from .dwarf import read_gdb_script
from .loader import load_program_opts, load_options, parse_package_flag, Loaded, default_stdlib_root, type_errors
from .diag import render

// How the assembly is generated: `debug`, DWARF debug information, so gdb
// steps through the Myla source and shows its variables (MYLA-71, MYLA-66),
// with the pretty-printers from `stdlib_root` embedded (D82);
// `ir`, through the IR, with its statistics (`ir_stats`) or its text instead
// of the assembly (`emit_ir`).
struct Mode { debug: bool, emit_ir: bool }

fun emit_asm(prog: Loaded, mode: Mode, stdlib_root: str) -> int32 {
    return match build_checker_decls(prog.decls, prog.next_id) {
        Ok(c) => {
            var g = new_codegen(c)
            g.set_sources(prog.spans, prog.next_id)
            if mode.debug { g.enable_debug_info(read_gdb_script(stdlib_root)) }
            if mode.emit_ir { g.keep_ir_text() }
            let asm = g.generate()
            if mode.emit_ir { write(1, g.ir_text()) } else { write(1, asm) }
            0
        },
        Err(errs) => {
            eprintln(render(type_errors(prog, errs)))
            1
        },
    }
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        eprintln("usage: gen_main <file.my> [stdlib_root] [-g] [--emit-ir] [--package name=dir]... [--root dir]")
        exit(2)
    }
    var opts = load_options(default_stdlib_root(argv[0]))
    var mode = Mode { debug: false, emit_ir: false }
    var j = 2
    while j < len(argv) {
        if argv[j] == "-g" {
            mode.debug = true
        } else if argv[j] == "--emit-ir" {
            mode.emit_ir = true
        } else if argv[j] == "--package" && j + 1 < len(argv) {
            match parse_package_flag(argv[j + 1]) {
                Ok(pkg) => { push(opts.packages, pkg) },
                Err(r) => {
                    eprintln(render(r))
                    exit(1)
                },
            }
            j = j + 1
        } else if argv[j] == "--root" && j + 1 < len(argv) {
            opts.root = argv[j + 1]
            j = j + 1
        } else {
            opts.stdlib_root = argv[j]
        }
        j = j + 1
    }
    match load_program_opts(argv[1], opts) {
        Ok(prog) => {
            let code = emit_asm(prog, mode, opts.stdlib_root)
            exit(code)
        },
        Err(r) => {
            eprintln(render(r))
            exit(1)
        },
    }
}
