// Wrap a raw `[uint8]` buffer (e.g. captured subprocess output) as a `VList`
// of `VInt` byte values, matching the `[uint8]` type the `__run_*` primitives
// report to the checker.
#test([])[Value.VList([])]
#test([0, 1])[Value.VList([Value.VInt(0), Value.VInt(1)])]
fun bytes_to_value(bytes: [uint8]) -> Value {
    var items: [Value] = []
    for b in bytes { items.push(Value.VInt(b as int64)) }
    return Value.VList(items)
}

