#test([Value.VInt(4), Value.VInt(2)], Value.VStruct("Name", ["text"], [Value.VStr("bob")]))[[Value.VInt(4), Value.VInt(2), Value.VStruct("Name", ["text"], [Value.VStr("bob")])]]
fun append_value(xs: [Value], v: Value) -> [Value] {
    var out: [Value] = []
    for x in xs { out.push(x) }
    out.push(v)
    return out
}

