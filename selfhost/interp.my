// interp.my -- the Myla tree-walking interpreter (self-hosting v0.8).
//
// Mirrors src/myla/interpreter.py: runs a type-checked program produced by
// `build_checker_decls` (checker.my). Integer arithmetic wraps at each type's
// width; structs/tuples/enums/lists/maps have value semantics (copied on bind,
// assign, argument passing, return, and construction). Type information the
// runtime needs (integer widths, print/format rendering, casts) comes from the
// checker's `resolved` side table, keyed by AST node id.

from .ast import Expr, ExprKind, Stmt, StmtKind, Block, Decl, DeclKind, FunData, Param, MatchArm, Pattern, PatternKind, FieldPat, BindElem, ExprOrBlock, ElseTail, FieldInit, MapEntry, Attribute, TypeExpr, TypeKind, TypeParam, bind_elems, names_in_expr, names_in_block, Expected, expected_failure
from .tokens import SrcSpan, no_span
from .checker import is_notify_primitive
from .checker import Checker, Type, Subst, subst_type, subst_get, unify_param, type_name, is_raw_memory_primitive, is_net_primitive, is_term_primitive, checker_on, builtin_method, builtin_method_name, is_wrapping_method, add_overflows, sub_overflows, mul_overflows, int_min, int_neg_overflows, shift_out_of_range, is_slice_expr, from_end_of, slice_parts, is_hole_part
from .anf import Norm, new_norm, stmt_suspends, body_suspends
from .util import cp_utf8, format_specs
from std.fmt import fmt_int, fmt_float, fmt_text
from std.slice import range_of, str_whole, take_str
from std.num import f64_literal_bits, f32_round_bits, float_from_bits, pow2, format_float
from std.io import write, eprint, errno_text
from std.process import exit
from std.fs import read_to_string, make_dir_all, remove_dir_all
from .parser import expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of  // AST values for #test cases (MYLA-184)

// =========================================================================
// Runtime values
// =========================================================================

pub enum Value {
    VInt(int64),
    VFloat(float64),
    VBool(bool),
    VStr(str),
    VChar(int64),
    VUnit,
    VStruct(str, [str], [Value]),          // name, field names, field values
    VTuple([Value]),
    VEnum(str, str, [Value]),              // enum name, variant, payload
    VList([Value]),
    VMap(MapV),                            // the entries in insertion order, indexed (MYLA-310)
    VSB([int64]),                          // StringBuilder: raw byte buffer
    VClosure([Param], ExprOrBlock, [str], [Value], str, bool),  // params, body, capNames, capVals, funcName, isFunc
    VCompose([Value]),                     // composed functions, applied left-to-right
    VPartial(Value, [Value], [bool]),      // base callable, arg slots, which slots are holes
    VActor(int32),                         // an actor's handle: its state in Interp.actors (D89)
    VTask(int32),                          // an `async let`'s child: Interp.tasks
}
impl Value {
    #test(Value.VInt(0))["VInt(0)"]
    #test(Value.VStruct("Counter", ["n"], [Value.VInt(4)]))["VStruct(Counter)"]
    #test(Value.VStruct("Money", ["cents"], [Value.VInt(100)]))["VStruct(Money)"]
    fun to_string(self) -> str {
        return match self {
            VInt(i) => f"VInt({i})"
            VFloat(f) => f"VFloat({f})"
            VBool(b) => f"VBool({b})"
            VStr(s) => f"VStr({s})"
            VChar(i) => f"VChar({i})"
            VUnit => f"VUnit"
            VStruct(name, fields, values) => f"VStruct({name})"
            VTuple(t) => f"VTuple()"
            VEnum(name, variant, fields) => f"VEnum({name}, {variant})"
            VList(l) => f"VList()"
            VMap(m) => f"VMap()"
            VSB(sb) => f"VSB()"
            VClosure(params, body, capNames, capVals, funcName, isFunc) => f"VClosure({funcName}, {isFunc})"
            VCompose(c) => f"VCompose()"
            VPartial(func, slots, holes) => f"VPartial()"
            VActor(i) => f"VActor({i})"
            VTask(i) => f"VTask({i})"
        }
    }
}

// --- signals (control flow) ----------------------------------------------
// Myla has no exceptions, so block/call execution returns a Flow describing
// how it finished: normal fallthrough, a `return`, a loop `break`/`continue`,
// or a process `exit`.

// Pending control-flow signal. Held on the interpreter so it can escape from
// inside expression evaluation (a `return`/`?` inside a match-arm value, an
// `exit`/`panic` mid-expression), which a return-value-based scheme cannot.
pub enum Ctrl {
    CNone,
    CReturn,
    CBecome,
    CBreak,
    CContinue,
    CExit,
}

// The call a `become` (D87) leaves pending for the loop that runs the
// function (run_tail): a function, a method with its receiver, a `var self`
// method on the same `self`, or a function value; and its arguments.
pub enum TailCall {
    TNone,
    TFunc(int32, [Value]),
    TMethod(int32, Value, [Value]),
    TSelfMethod(int32, [Value]),
    TValue(Value, [Value]),
}

// A scope's variables, and its deferred blocks (D135) in the order they were
// met.
pub struct RtFrame { names: [str], vals: [Value], defers: [Deferral] }

// A deferred block, and how many of its scope's names were declared before
// it: the ones it sees when it runs.
pub struct Deferral { body: Block, names: int32 }

// -- concurrency (D89, MYLA-139) --------------------------------------------
//
// Where a call of an async function, method or lambda stands, for the async
// evaluator: its continuations, innermost last.
enum Cont {
    KStmts([Stmt], int32),                     // a block's statements, from the i-th
    KScope,                                    // a scope's end: its children, then the scope
    KWhile(Expr, Block),                       // a `while`: its condition, then its body again
    KFor(str, [Value], int64, int64, Block),   // variable, items (none: a range), next index or value, end, body
    KLet(str, int32),                          // waiting: the child task awaited (-1: a call), its result for a name
}

// A call being evaluated asynchronously: its variables, where it stands, the
// place a `var self` method's `self` goes back to, and how it is leaving
// (`pend`: a `return`, `break`, `continue` or failure on its way out of the
// blocks, with its value, error and exit code).
struct AFrame { scopes: [RtFrame], conts: [Cont], place: Option<Place>, pend: Ctrl, pval: Value, perr: Option<RtError>, pcode: int32 }

// A task: its calls, innermost last; `state` 0 ready, 1 waiting, 2 done with
// its result or failure (a runtime error, or an `exit` with `code`), which
// ends the program at once (D97, `failing`); `awaited`: it was asked for;
// `waiters`: the tasks waiting for it. `cancelled`: a failure cancelled it
// (D94, D97), so it stops when it next runs (after a suspension); `kids`:
// its child tasks, cancelled with it; `requested`: `task.cancel` asked it,
// or a task above it, to stop (D96).
struct Task { frames: [AFrame], state: int32, value: Value, failed: bool, err: Option<RtError>, code: int32, awaited: bool, waiters: [int32], cancelled: bool, kids: [int32], requested: bool }

// A task asleep (`std.task.sleep`, D124): until `at` on the interpreter's
// clock (`Interp.now`), `seq` the order tasks went to sleep in; `wait` the
// wait on a notifier whose time limit it is (MYLA-387), else -1.
struct Sleeper { at: int64, seq: int64, task: int32, wait: int32 }

// A notifier (`std.task.notifier`, MYLA-387): its permits (each a
// `notify_one` nobody waited for, which the next wait takes), how many
// `notify_all`s it had, the waits parked on it (`Interp.pwaits`), oldest
// first.
struct Notif { permits: int64, gen: int64, waits: [int32] }

// A wait on the notifier `n` (`__waiter`): its task once it parks, the
// generation it waits from (-1: any), its time limit in milliseconds (-1:
// none), its state: 0 made, 1 parked, 2 notified, 3 timed out, 4 cancelled.
struct PWait { task: int32, n: int32, since: int64, ms: int64, state: int32 }

// A task waiting for input on `fd` (D124, `std.io`'s async reads).
// `events` 0: until `fd` (or `fd2`) is readable; else until the socket `fd`
// is ready for them (`__wait_socket`, MYLA-346)
struct FdWait { fd: int32, fd2: int32, task: int32, events: int32 }

// A task's deadline (`std.task.timeout`, D124): at `at` the task `task` is
// cancelled and `Interp.fired[rec]` says so.
struct Deadline { at: int64, task: int32, rec: int32 }

// A call whose async body the async evaluator takes over (Interp.defer).
struct Deferred { scopes: [RtFrame], body: Block }

// What an input of the REPL did: the variables afterwards, the value to
// show, the runtime error, or the `exit` that ends the session.
pub struct SessionStep { names: [str], vals: [Value], shown: Option<Value>, err: Option<RtError>, exited: bool, code: int32 }

pub struct MatchRes { ok: bool, names: [str], vals: [Value] }

// =========================================================================
// Interpreter
// =========================================================================

pub struct Interp {
    decls: [Decl],
    resolved: [int32: Type],
    func_names: [str],
    func_decls: [FunData],
    // the structs and enums with an `eq` written for them, and those with a
    // `hash` written for them (not derived), by name (D163, MYLA-313)
    own_eq: [str: bool],
    own_hash: [str: bool],
    const_names: [str],
    const_vals: [Value],
    enum_names: [str],
    scopes: [RtFrame],
    ctrl: Ctrl,
    ctrl_val: Value,
    exit_code: int32,
    argv: [str],            // what the program's `args()` returns
    rt_err: Option<RtError>, // the runtime error that stopped the program
    cell: Value,            // the value `update_cell` is changing
    receivers: [Value],     // `var self` receivers on their way into a call
    tail: TailCall,         // the call a `become` left pending (Ctrl.CBecome)
    // concurrency (D89): the actor types and the actors' states (by handle);
    // the tasks, those ready to run (a ring: `qlen` of them from `qhead`,
    // the newest last; `sched` the order they run in, `rng` the generator of
    // `seed:N`, D110), the one running
    // and its calls (`frames`; the innermost's variables are `scopes`); the
    // normalizer, the normalized async bodies and what statements suspend, by
    // node id; whether the next call of an async body is deferred to the
    // async evaluator, the call deferred and its `var self` receiver's place;
    // whether the running task waits (`parked`) or lets the others run
    actor_types: [str: bool],
    actors: [Value],
    tasks: [Task],
    queue: [int32],
    qhead: int32,
    qlen: int32,
    sched: int32,
    rng: uint64,
    cur: int32,
    frames: [AFrame],
    norm: Norm,
    bodies: [int32: Block],
    suspending: [int32: bool],
    defer: bool,
    deferred: Option<Deferred>,
    deferred_place: Option<Place>,
    parked: bool,
    yielding: bool,
    // the call an `await` makes entered an async function or method that ran
    // at once: no turn for the others after it, as native code (MYLA-228)
    entered_async: bool,
    // D97: a task has failed, so the program ends: every other task stops at
    // its next suspension point, the first task with this failure
    failing: bool,
    fail_err: Option<RtError>,
    fail_code: int32,
    // MYLA-170: called with a task's runtime error when it fails, before the
    // other tasks stop; the drivers report it there (true: reported)
    on_failure: (RtError) -> bool,
    fail_reported: bool,
    // calls in progress, up to MAX_CALL_DEPTH (MYLA-182)
    depth: int32,
    // D124: the tasks asleep, and the clock (MYLA_TIME=virtual: `vclock`,
    // which moves to the next deadline when no task is ready)
    sleepers: [Sleeper],
    deadlines: [Deadline],
    fired: [bool],
    fd_waits: [FdWait],
    // MYLA-387: the notifiers, the waits on them (`free_waits`: the slots
    // `__woken` gave back) and those parked now (as native code's
    // `__parked`)
    notifs: [Notif],
    pwaits: [PWait],
    free_waits: [int32],
    parked_waits: [int32],
    sleep_seq: int64,
    virtual_time: bool,
    vclock: int64,
    // D162: a `#test` case is running (`myla test`): a failure unwinds its
    // deferred blocks, which record their own failures in `defer_errs`; its
    // standard output is kept in `captured` for the report; its scratch
    // root (`std.test.temp_dir`), made on the first call and removed when
    // the case ends; the project's program under test (`std.test.program`)
    testing: bool,
    defer_errs: [str],
    captured: [str],
    test_root: str,
    test_program: str,
    // the checked program: the report's names of methods on built-in types
    // and its values by their types (a uint64 unsigned, MYLA-357, MYLA-361)
    checker: Checker,
    // functions without `self` (D172): their calls, by the call's id, with
    // the type each is called on (`T` of `T.zero()`); each function's impl
    // target by its name (and a generic impl's methods'), which solves the
    // impl's type parameters; the type arguments of the generic calls, by
    // the call's id. When a program calls one on a type parameter
    // (`type_env`), a generic function's frame binds its type parameters
    // to their types, as `%:T` (an index into `types`, `type_ix` by name),
    // and `tparams` holds each function's (its impl's first); `env_next`
    // is what the next call entered binds when it enters function `env_fi`
    // (a call that doesn't happen, its arguments stopped, leaves nothing to
    // a later one), `env_tail` and `env_tail_fi` a `become`'s
    static_calls: [int32: Type],
    impl_selfs: [str: Type],
    call_types: [int32: [Type]],
    type_env: bool,
    tparams: [[str]],
    types: [Type],
    type_ix: [str: int32],
    env_next: Option<[Subst]>,
    env_fi: int32,
    env_tail: Option<[Subst]>,
    env_tail_fi: int32,
}

// A runtime error, with the Python interpreter's message; `node` is the id of
// the expression it happened at (its file: loader.file_of), `sp` its range,
// `line` 0 for none.
pub struct RtError { msg: str, line: int32, col: int32, sp: SrcSpan, node: int32 }

// The results of a run of `#test` cases: a PASS/FAIL line for each case, and
// how many passed of how many (run_test_cases).
pub struct TestRun { report: [str], passed: int32, total: int32 }

// What `myla test` was asked (D162): `only`, a text the cases run must have
// in their function's name ("" for all); `list`, to name the cases
// without running them; `program`, the path of the project's program for
// `std.test.program()` ("" outside a project with one).
pub struct TestOptions { only: str, list: bool, program: str }

pub fun all_tests() -> TestOptions {
    return TestOptions { only: "", list: false, program: "" }
}

// Whether the case of the function `name` is selected by `only`: its text
// in the name (a method's `T.m`).
#test("add", "")[true]
#test("P.plus", "plus")[true]
#test("add", "plus")[false]
pub fun selected(name: str, only: str) -> bool {
    if only == "" { return true }
    if only.len() > name.len() { return false }
    var i = 0
    while i + only.len() <= name.len() {
        var k = 0
        while k < only.len() && name[i + k] == only[k] { k = k + 1 }
        if k == only.len() { return true }
        i = i + 1
    }
    return false
}

// The name a case's report gives the function the checker names `name`:
// a method on a list or a map by its receiver's type (`[str].width`, not
// the checker's `__list.width`, MYLA-357), any other as it is (`P.plus`,
// `int8.half`).
#test(checker_on("impl [str] {\n    fun w(self) -> int { return 0 }\n}"), "__list.w")["[str].w"]
#test(checker_on("impl [str: int] {\n    fun w(self) -> int { return 0 }\n}"), "__map.w")["[str: int32].w"]
#test(checker_on("fun f() {}"), "f")["f"]
pub fun case_func_name(ch: Checker, name: str) -> str {
    var key = ""
    if name.len() > 7 && name[0:7] == "__list." { key = "__list" }
    if name.len() > 6 && name[0:6] == "__map." { key = "__map" }
    if key == "" { return name }
    let fi = ch.func_idx(name)
    if fi < 0 || ch.functions[fi].params.len() == 0 { return name }
    return type_name(ch.functions[fi].params[0]) + name[key.len():]
}

// The checked result type of the function `name`, None for none.
fun case_ret(ch: Checker, name: str) -> Option<Type> {
    let fi = ch.func_idx(name)
    if fi < 0 { return None }
    return ch.functions[fi].ret
}

// How a case's call ended: with a value, a runtime error, or `exit`.
enum Outcome {
    Returned(Value),
    Failed(str),
    Exited(int32),
}

// A partial application's arguments: its filled slots, and `argv` in its holes.
#test([Value.VInt(2), Value.VUnit], [false, true], [Value.VInt(4)])[[Value.VInt(2), Value.VInt(4)]]
#test([Value.VInt(5), Value.VUnit], [false, true], [Value.VInt(10)])[[Value.VInt(5), Value.VInt(10)]]
#test([Value.VUnit, Value.VInt(2)], [true, false], [Value.VInt(40)])[[Value.VInt(40), Value.VInt(2)]]
fun fill_holes(slots: [Value], holes: [bool], argv: [Value]) -> [Value] {
    var full: [Value] = []
    var hi = 0
    var i = 0
    while i < slots.len() {
        if holes[i] {
            full.push(argv[hi])
            hi = hi + 1
        } else {
            full.push(slots[i])
        }
        i = i + 1
    }
    return full
}

// Whether the loader qualified `name` with a module id (`geo$area`,
// `geo$Point.eq`): it isn't declared in the entry module.
#test("area")[false]
#test("Point.eq")[false]
#test("geo$area")[true]
#test("util$strings$Point.eq")[true]
fun is_qualified(name: str) -> bool {
    for c in name.chars() {
        if c == '$' { return true }
    }
    return false
}

// A step of an assignable place: a struct field, or an index (evaluated once)
// with the expression it came from.
enum Step {
    SField(str),
    SIndex(Value, Expr),
}

// A variable and the path into it that an assignment, `push`/`pop`, a builder
// or map builtin, or a `var self` call updates.
struct Place { root: str, steps: [Step] }

// What an update does at the end of a place (`Interp.update_place`).
enum PlaceOp {
    OSet(Value),
    OPush(Value),
    OPop,
    ORemove(Value),
    OAppend(str),
    OAppendByte(int64),
}

// An interpreter for the checked program `c`, run as `argv` (argv[0] is the
// program's path, as for `myla run`).
// The deepest the interpreter's calls go (MYLA-182): an interpreted call takes
// some 12 to 25 KB of native stack (every IR slot has a cell of its own,
// MYLA-183), and the runtime lets the main stack grow to 120 MiB.
const MAX_CALL_DEPTH: int32 = 2500

// The orders ready tasks run in (D110, MYLA-231; `Interp.ready`): the newest
// first (the default), the oldest (MYLA_SCHED=fifo), each queued at the end
// the generator x * SCHED_MUL + SCHED_ADD picks (seed:N; Knuth's MMIX
// constants, native code's too)
const SCHED_LIFO: int32 = 0
const SCHED_FIFO: int32 = 1
const SCHED_SEED: int32 = 2
const SCHED_MUL: uint64 = 6364136223846793005
const SCHED_ADD: uint64 = 1442695040888963407

// The order `spec` (MYLA_SCHED's value) names, and its seed.
#test("fifo")[(1, 0u64)]
#test("seed:42")[(2, 42u64)]
#test("lifo")[(0, 0u64)]
#test("")[(0, 0u64)]
#test("seed:")[(2, 0u64)]
#test("Fifo")[(0, 0u64)]
pub fun sched_of(spec: str) -> (int32, uint64) {
    if spec == "fifo" { return (SCHED_FIFO, 0u64) }
    if spec.len() < 5 || !(spec[0] == 's' && spec[1] == 'e' && spec[2] == 'e' && spec[3] == 'd' && spec[4] == ':') { return (SCHED_LIFO, 0u64) }
    var seed: uint64 = 0
    var i = 5
    while i < spec.len() && spec[i] >= '0' && spec[i] <= '9' {
        seed = seed * 10u64 + ((spec[i] - '0') as uint64)
        i = i + 1
    }
    return (SCHED_SEED, seed)
}

// MYLA_SCHED's value in the environment `environ` (/proc/self/environ:
// NAME=value entries, each ended by a NUL), "" when it has none.
#test("A=1\0MYLA_SCHED=fifo\0B=2\0")["fifo"]
#test("MYLA_SCHEDX=1\0")[""]
#test("")[""]
pub fun sched_in(environ: str) -> str {
    return env_entry(environ, "MYLA_SCHED=")
}

// The value of the entry starting with `key` (`NAME=`) in the environment
// `environ`, "" when it has none.
#test("A=1\0MYLA_TIME=virtual\0", "MYLA_TIME=")["virtual"]
#test("A=1\0", "MYLA_TIME=")[""]
pub fun env_entry(environ: str, key: str) -> str {
    var i = 0
    while i < environ.len() {
        var j = i
        while j < environ.len() && environ[j] != '\0' { j = j + 1 }
        var k = 0
        while k < key.len() && i + k < j && environ[i + k] == key[k] { k = k + 1 }
        if k == key.len() {
            var sb = StringBuilder()
            sb.append(environ, i + k, j)
            return sb.build()
        }
        i = j + 1
    }
    return ""
}

// MYLA_SCHED's value in this process's environment, "" without one.
pub fun sched_from_env() -> str {
    return match read_to_string("/proc/self/environ") {
        Ok(e) => sched_in(e),
        Err(_) => "",
    }
}

// MYLA_TIME's value in this process's environment (D124), "" without one.
pub fun time_from_env() -> str {
    return match read_to_string("/proc/self/environ") {
        Ok(e) => env_entry(e, "MYLA_TIME="),
        Err(_) => "",
    }
}

// Whether the awaited `op` calls a function value (a local, or any callee
// but a name or a method), which goes on at once natively (MYLA-228).
#test(expr_of("f(1)"), [RtFrame { names: ["f"], vals: [Value.VUnit], defers: [] }])[true]
#test(expr_of("f(1)"), [])[false]
#test(expr_of("a.m()"), [])[false]
#test(expr_of("fs[0]()"), [])[true]
fun calls_a_value(op: Expr, scopes: [RtFrame]) -> bool {
    match op.kind {
        ExprKind.Call(c, args, _) => {
            match c.kind {
                ExprKind.Name(n) => {
                    for fr in scopes { for k in fr.names { if k == n { return true } } }
                    return false
                },
                ExprKind.GetField(t, f) => { return false },
                _ => { return true },
            }
        },
        _ => {},
    }
    return false
}

pub fun new_interp(c: Checker, argv: [str]) -> Interp {
    var it = Interp {
        decls: c.decls,
        resolved: c.resolved,
        func_names: [], func_decls: [], own_eq: [:], own_hash: [:],
        const_names: [], const_vals: [],
        enum_names: [],
        scopes: [],
        ctrl: Ctrl.CNone,
        ctrl_val: Value.VUnit,
        exit_code: 0,
        argv: argv,
        rt_err: None,
        cell: Value.VUnit,
        receivers: [],
        tail: TailCall.TNone,
        actor_types: c.actors,
        actors: [],
        tasks: [],
        queue: [], qhead: 0, qlen: 0, sched: SCHED_LIFO, rng: 0, cur: -1, frames: [],
        norm: new_norm(2000000000),
        bodies: [:], suspending: [:],
        defer: false, deferred: None, deferred_place: None,
        parked: false, yielding: false, entered_async: false,
        failing: false, fail_err: None, fail_code: 0,
        on_failure: (r: RtError) => false, fail_reported: false,
        depth: 0,
        sleepers: [], deadlines: [], fired: [], fd_waits: [], notifs: [], pwaits: [], free_waits: [], parked_waits: [], sleep_seq: 0, virtual_time: false, vclock: 0,
        testing: false, defer_errs: [], captured: [], test_root: "", test_program: "", checker: c,
        static_calls: c.static_calls, impl_selfs: c.static_selfs, call_types: [:], type_env: c.on_type_params,
        tparams: [], types: [], type_ix: [:], env_next: None, env_fi: -1, env_tail: None, env_tail_fi: -1,
    }
    if it.type_env {
        it.call_types = c.call_types
        // a generic impl's methods: their receiver's type solves the impl's
        // type parameters when the call has none recorded (a bound's)
        for f in c.functions {
            if f.params.len() > 0 && f.type_params.len() > f.own_type_params && match f.decl.receiver { Some(r) => true, None => false } { it.impl_selfs[f.name] = f.params[0] }
        }
    }
    return it
}

// An interpreter of `src` with its functions collected and its constants
// evaluated, the receiver of `#test` cases of the interpreter's methods
// (MYLA-184).
pub fun interp_on(src: str) -> Interp {
    var it = new_interp(checker_on(src), [])
    it.collect()
    it.eval_consts()
    return it
}

// The interpreter runs a program's I/O itself, through the standard
// library's primitives (D161: their warning silenced here, MYLA-285).
#allow(primitive)
impl Interp {
    // -- table construction ----------------------------------------------

    fun collect(var self) {
        var derived: [str: bool] = [:]
        var derived_eq: [str: bool] = [:]
        for d in self.decls {
            match d.kind {
                DeclKind.FunDecl(fd) => {
                    self.add_func(fd.name, fd)
                    self.tparams.push(tp_names_i(fd.type_params))
                },
                DeclKind.EnumDecl(n, variants, attrs, tps, isp) => {
                    self.enum_names.push(n)
                    if derives_trait(attrs, "Hash") { derived[n] = true }
                    if derives_trait(attrs, "Eq") { derived_eq[n] = true }
                },
                DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => {
                    if derives_trait(attrs, "Hash") { derived[n] = true }
                    if derives_trait(attrs, "Eq") { derived_eq[n] = true }
                },
                DeclKind.ImplDecl(target, methods, tps, trnm, targs, dattrs) => {
                    let key = canon_type_name(self.type_name_of(target))
                    for m in methods {
                        self.add_func(format("{}.{}", key, m.name), m)
                        var names = tp_names_i(tps)
                        for t in m.type_params { names.push(t.name) }
                        self.tparams.push(names)
                        let written = match m.body {
                            Some(b) => true,
                            None => false,
                        }
                        if written && m.name == "eq" { self.own_eq[key] = true }
                        if written && m.name == "hash" { self.own_hash[key] = true }
                    }
                },
                _ => {},
            }
        }
        // a derived `hash` is written as source, but hashing by the members
        // gives the same equal hashes
        for n in derived.keys() { self.own_hash.remove(n) }
        // and so is a generic type's derived `eq` (MYLA-379), which compares
        // as the members do
        for n in derived_eq.keys() { self.own_eq.remove(n) }
    }

    fun add_func(var self, name: str, fd: FunData) {
        self.func_names.push(name)
        self.func_decls.push(fd)
    }

    #test(interp_on("[int]"), "inc")[-1]
    fun func_idx(self, name: str) -> int32 {
        var i = 0
        while i < self.func_names.len() {
            if self.func_names[i] == name { return i }
            i = i + 1
        }
        return -1
    }

    #test(interp_on("[int]"), TypeExpr { id: 87, line: 46, col: 6, sp: SrcSpan { sline: 46, scol: 6, eline: 46, ecol: 9 }, kind: TypeKind.TRef("int", []) })["int"]
    fun type_name_of(self, te: TypeExpr) -> str {
        return match te.kind {
            TypeKind.TRef(name, args) => name,
            // an impl on lists or maps (MYLA-221), keyed as the checker keys it
            TypeKind.TList(e) => "__list",
            TypeKind.TMap(k, v) => "__map",
            _ => "",
        }
    }

    #test(interp_on("[int]"), "a")[false]
    fun is_enum_name(self, n: str) -> bool {
        for e in self.enum_names { if e == n { return true } }
        return false
    }

    #test(interp_on("[int]"), "KIB")[-1]
    fun const_idx(self, name: str) -> int32 {
        var i = 0
        while i < self.const_names.len() {
            if self.const_names[i] == name { return i }
            i = i + 1
        }
        return -1
    }

    // -- scopes -----------------------------------------------------------

    fun push_scope(var self) { self.scopes.push(RtFrame { names: [], vals: [], defers: [] }) }
    fun pop_scope(var self) { self.scopes = drop_last_frame(self.scopes) }

    fun define(var self, name: str, v: Value) {
        let top = self.scopes.len() - 1
        self.scopes[top].names.push(name)
        self.scopes[top].vals.push(v)
    }

    #test(interp_on("[int]"), "a")[None]
    fun lookup(self, name: str) -> Option<Value> {
        var i = self.scopes.len() - 1
        while i >= 0 {
            var j = self.scopes[i].names.len() - 1
            while j >= 0 {
                if self.scopes[i].names[j] == name { return Some(self.scopes[i].vals[j]) }
                j = j - 1
            }
            i = i - 1
        }
        return None
    }

    // -- program entry ----------------------------------------------------

    // One input of the REPL (MYLA-82): run `stmts` in a scope holding the
    // session's variables (`names`, `vals`, the latest of a name last), and
    // keep the value of the last one when `show_last` and it is an expression
    // giving one. The scope afterwards is the session's next.
    #test(interp_on("enum E { A, B(int) }"), ["x"], [Value.VInt(3)], [Stmt { id: 6, line: 4, col: 1, sp: SrcSpan { sline: 4, scol: 1, eline: 4, ecol: 2 }, kind: StmtKind.ExprStmt(Expr { id: 5, line: 4, col: 1, sp: SrcSpan { sline: 4, scol: 1, eline: 4, ecol: 2 }, kind: ExprKind.Name("x") }) }], true)[SessionStep { names: ["x"], vals: [Value.VInt(3)], shown: Some(Value.VInt(3)), err: None, exited: false, code: 0 }]
    fun session_step(var self, names: [str], vals: [Value], stmts: [Stmt], show_last: bool) -> SessionStep {
        self.collect()
        self.eval_consts()
        self.scopes = []
        self.push_scope()
        var i = 0
        while i < names.len() {
            self.define(names[i], vals[i])
            i = i + 1
        }
        var shown: Option<Value> = None
        var k = 0
        while k < stmts.len() && !self.stop() {
            var done = false
            if k == stmts.len() - 1 && show_last {
                match stmts[k].kind {
                    StmtKind.ExprStmt(e) => {
                        let v = self.eval(e)
                        if !self.stop() {
                            match v {
                                Value.VUnit => {},
                                _ => { shown = Some(v) },
                            }
                        }
                        done = true
                    },
                    _ => {},
                }
            }
            if !done { self.exec_stmt(stmts[k]) }
            k = k + 1
        }
        var exited = false
        match self.ctrl {
            Ctrl.CExit => {
                match self.rt_err {
                    Some(r) => {},
                    None => { exited = true },
                }
            },
            _ => {},
        }
        return SessionStep { names: self.scopes[0].names, vals: self.scopes[0].vals, shown: shown, err: self.rt_err, exited: exited, code: self.exit_code }
    }

    #test(interp_on("[int]"))[1]
    fun run(var self) -> int32 {
        self.collect()
        self.eval_consts()
        let ei = self.entry_idx()
        if ei < 0 {
            self.rt_err = Some(RtError { msg: "no entry point: define '#main' or a function named 'main'", line: 0, col: 0, sp: no_span(), node: -1 })
            return 1
        }
        if self.body_suspends_fd(self.func_decls[ei]) { self.run_async(ei) }
        else { self.call_func(ei, []) }
        match self.ctrl { Ctrl.CExit => { return self.exit_code }, _ => {} }
        return 0
    }

    // Run every function's `#test(args…)[expected]` cases, then print a
    // PASS/FAIL line for each (after whatever the tests printed) and the
    // summary, as the Python CLI does (`Interpreter.run_tests`, MYLA-81); the
    // exit status: 0 if all pass (or none exist), else 1.
    // `myla test file.my`: the entry file's own cases, not those of the
    // modules it imports (MYLA-187)
    fun run_tests(var self, sel: TestOptions) -> int32 {
        let r = self.run_test_cases(sel)
        if r.total == 0 {
            if sel.only != "" {
                write(1, format("no #test cases match '{}'.\n", sel.only))
                return 1
            }
            write(1, "no #test cases found.\n")
            return 0
        }
        for line in r.report { write(1, line) }
        if sel.list { return 0 }
        write(1, format("\n{}/{} passed.\n", r.passed, r.total))
        if r.passed == r.total { return 0 }
        return 1
    }

    // Run the `#test` cases of the entry module's own functions (`myla test`
    // of a file, MYLA-187, and in a project, MYLA-94: the entry's names are
    // the ones the loader doesn't qualify with a module id), and collect a
    // PASS/FAIL line for each.
    #test(interp_on("[int]"), TestOptions { only: "", list: false, program: "" })[TestRun { report: [], passed: 0, total: 0 }]
    fun run_test_cases(var self, sel: TestOptions) -> TestRun {
        self.collect()
        self.eval_consts()
        self.test_program = sel.program
        var report: [str] = []
        var total = 0
        var passed = 0
        var i = 0
        while i < self.func_decls.len() {
            let fd = self.func_decls[i]
            // a method's is `T.m` (D116), one on a list or map by its type
            let name = case_func_name(self.checker, self.func_names[i])
            var idx = 0
            for attr in fd.attributes {
                if attr.name == "test" && !is_qualified(self.func_names[i]) && selected(name, sel.only) {
                    idx = idx + 1
                    // a test function (a bare `#test`, D162) is named by its
                    // name, a case by its number, both by a comment after
                    // the attribute (MYLA-239)
                    let is_fn = match attr.outputs { Some(outs) => false, None => true }
                    var case_name = name
                    if !is_fn { case_name = format("{} #{}", name, idx) }
                    if attr.label != "" { case_name = format("{} ({})", case_name, attr.label) }
                    total = total + 1
                    if sel.list {
                        report.push(case_name + "\n")
                    } else {
                        let detail = self.run_case(i, fd, attr, is_fn)
                        if detail == "" {
                            passed = passed + 1
                            report.push(format("PASS  {}\n", case_name))
                        } else {
                            report.push(format("FAIL  {}: {}\n", case_name, on_one_line(detail)))
                            // what the case printed, under its line
                            for line in output_lines(self.captured) { report.push("      | " + line + "\n") }
                        }
                    }
                }
            }
            i = i + 1
        }
        return TestRun { report: report, passed: passed, total: total }
    }

    // One case of the function `fi`: its arguments and expected value
    // evaluated, the call made with the case running (a failure unwinds its
    // deferred blocks, D162), its scratch directory removed; "" when it
    // passed, else why it failed.
    fun run_case(var self, fi: int32, fd: FunData, attr: Attribute, is_fn: bool) -> str {
        self.push_scope()
        var argv: [Value] = []
        for a in attr.args { argv.push(self.eval(a)) }
        var expected = Value.VUnit
        var want = Expected.Value
        match attr.outputs {
            Some(outs) => {
                if outs.len() > 0 {
                    want = expected_failure(outs[0])
                    match want { Expected.Value => { expected = self.eval(outs[0]) }, _ => {} }
                }
            },
            None => {},
        }
        self.pop_scope()
        self.testing = true
        self.defer_errs = []
        self.captured = []
        var actual = Value.VUnit
        match fd.receiver {
            // a method's receiver is its first argument (D116)
            Some(r) => {
                var rest: [Value] = []
                var k = 1
                while k < argv.len() {
                    rest.push(argv[k])
                    k = k + 1
                }
                let (rv, final_self) = self.call_method(fi, argv[0], rest)
                actual = rv
            },
            None => {
                if self.body_suspends_fd(fd) {
                    // an async case is the entry task of a program of its
                    // own (D162): the tasks it starts end before it does
                    let saved = self.scopes
                    self.reset_tasks()
                    actual = self.run_as_first_task(fi, argv)
                    self.scopes = saved
                } else { actual = self.call_func(fi, argv) }
            },
        }
        self.testing = false
        var outcome = Outcome.Returned(actual)
        match self.ctrl {
            Ctrl.CExit => {
                // a runtime error or `exit` ends this case only
                outcome = match self.rt_err {
                    Some(r) => Outcome.Failed(r.msg),
                    None => Outcome.Exited(self.exit_code),
                }
                self.ctrl = Ctrl.CNone
                self.rt_err = None
                self.exit_code = 0
            },
            _ => {},
        }
        if self.test_root != "" {
            let gone = remove_dir_all(self.test_root)
            self.test_root = ""
        }
        var parts: [str] = []
        // the values shown by the function's checked result type (MYLA-361)
        let rt = case_ret(self.checker, self.func_names[fi])
        let returns = match fd.ret_type { Some(t) => true, None => false }
        let ch = self.checker
        match want {
            Expected.Value => {
                match outcome {
                    Outcome.Returned(v) => {
                        if is_fn {
                            // a test function's `Err(e)` fails it with `e` (D162)
                            match v {
                                Value.VEnum(en, vr, pl) => { if vr == "Err" { parts.push(self.shown(pl[0], err_type(rt))) } },
                                _ => {},
                            }
                        } else if !value_eq(v, expected) { parts.push("expected " + typed_repr(ch, expected, rt) + ", got " + typed_repr(ch, v, rt)) }
                    },
                    Outcome.Failed(m) => { parts.push("runtime error: " + m) },
                    Outcome.Exited(c) => { parts.push(format("exited with status {}", c)) },
                }
            },
            Expected.Panics(m) => {
                let wanted = format("expected runtime error '{}'", m)
                match outcome {
                    Outcome.Returned(v) => { parts.push(wanted + ", " + returned_text(ch, v, returns, rt)) },
                    Outcome.Failed(got) => { if got != m { parts.push(format("{}, got runtime error '{}'", wanted, got)) } },
                    Outcome.Exited(c) => { parts.push(format("{}, exited with status {}", wanted, c)) },
                }
            },
            Expected.Exits(n) => {
                let wanted = format("expected exit status {}", n)
                match outcome {
                    Outcome.Returned(v) => { parts.push(wanted + ", " + returned_text(ch, v, returns, rt)) },
                    Outcome.Failed(got) => { parts.push(format("{}, got runtime error '{}'", wanted, got)) },
                    Outcome.Exited(c) => { if c as int64 != n { parts.push(format("{}, exited with status {}", wanted, c)) } },
                }
            },
        }
        // the deferred blocks that failed while the case unwound (D162)
        for d in self.defer_errs { parts.push("deferred block: runtime error: " + d) }
        return join_parts(parts)
    }

    fun eval_consts(var self) {
        for d in self.decls {
            match d.kind {
                DeclKind.ConstDecl(n, ty, value, attrs, isp) => {
                    self.push_scope()
                    let v = self.eval(value)
                    self.pop_scope()
                    self.const_names.push(n)
                    self.const_vals.push(v)
                },
                _ => {},
            }
        }
    }

    #test(interp_on("[int]"))[-1]
    fun entry_idx(self) -> int32 {
        // prefer a function carrying the #main attribute, else one named `main`.
        var i = 0
        while i < self.func_decls.len() {
            for a in self.func_decls[i].attributes { if a.name == "main" { return i } }
            i = i + 1
        }
        return self.func_idx("main")
    }

    #test(interp_on("[int]"))[false]
    fun stop(self) -> bool {
        return match self.ctrl { Ctrl.CNone => false, _ => true }
    }

    #test(interp_on("[int]"))[false]
    fun returning(self) -> bool {
        return match self.ctrl { Ctrl.CReturn => true, _ => false }
    }

    #test(interp_on("[int]"))[false]
    fun becoming(self) -> bool {
        return match self.ctrl { Ctrl.CBecome => true, _ => false }
    }

    // Stop the program with a runtime error at `e` (exit status 1).
    fun fail(var self, e: Expr, msg: str) {
        if self.stop() { return }
        self.rt_err = Some(RtError { msg: msg, line: e.line, col: e.col, sp: e.sp, node: e.id })
        self.ctrl = Ctrl.CExit
        self.exit_code = 1
    }

    // Whether `c[k]` can be read (or, `assigning`, written: a missing map key
    // is then an insert); fails with the Python interpreter's message if not.
    #test(interp_on("enum E { A, B(int) }"), Value.VList([Value.VInt(7)]), Value.VInt(0), expr_of("a.b[0]"), false)[true]
    fun check_index(var self, c: Value, k: Value, e: Expr, assigning: bool) -> bool {
        let msg = index_error(c, k, assigning, self.place_in(c, k))
        if msg.len() > 0 {
            self.fail(e, msg)
            return false
        }
        return true
    }

    // Whether every index on the path to `p` is still valid, without failing.
    #test(interp_on("[int]"), Place { root: "b", steps: [] })[true]
    fun place_valid(var self, p: Place) -> bool {
        var v = self.lookup_or_unit(p.root)
        if p.steps.len() > 0 { v = self.deref(v) }
        var i = 0
        while i < p.steps.len() {
            match p.steps[i] {
                Step.SField(f) => { v = get_field(v, f) },
                Step.SIndex(k, nd) => {
                    let last = i == p.steps.len() - 1
                    if index_error(v, k, last, self.place_in(v, k)).len() > 0 { return false }
                    if !last { v = index_get(v, k, self.place_in(v, k)) }
                },
            }
            i = i + 1
        }
        return true
    }

    // -- places -----------------------------------------------------------

    // Resolve the place `e` names, evaluating each index once, left to right;
    // a containing index is read (and bounds-checked) before the next key.
    #test(interp_on("[int]"), Expr { id: 22, line: 24, col: 9, sp: SrcSpan { sline: 24, scol: 9, eline: 24, ecol: 10 }, kind: ExprKind.Name("i") })[Place { root: "i", steps: [] }]
    fun place_of(var self, e: Expr) -> Place {
        return match e.kind {
            ExprKind.GetField(t, f) => {
                var p = self.place_of(t)
                p.steps.push(Step.SField(f))
                p
            },
            ExprKind.Index(t, i) => {
                var p = self.place_of(t)
                var k = Value.VUnit
                match from_end_of(i) {
                    // `^n`: from the end of the list there (D142)
                    Some(n) => { k = Value.VInt(value_len(self.read_place(p)) - as_int(self.eval(n))) },
                    None => {
                        if p.steps.len() > 0 { self.read_place(p) }
                        k = self.eval(i)
                    },
                }
                p.steps.push(Step.SIndex(k, e))
                p
            },
            ExprKind.Name(n) => Place { root: n, steps: [] },
            _ => Place { root: "", steps: [] },
        }
    }

    // The value at `p`, bounds-checked at every index (a read).
    #test(interp_on("[int]"), Place { root: "b", steps: [] })[Value.VUnit]
    fun read_place(var self, p: Place) -> Value {
        var v = self.lookup_or_unit(p.root)
        if p.steps.len() > 0 { v = self.deref(v) }
        for st in p.steps {
            if self.stop() { return Value.VUnit }
            match st {
                Step.SField(f) => { v = get_field(v, f) },
                Step.SIndex(k, nd) => {
                    if !self.check_index(v, k, nd, false) { return Value.VUnit }
                    v = index_get(v, k, self.place_in(v, k))
                },
            }
        }
        return v
    }

    // Store `v` at `p`; writing past the end of a list fails, at the target.
    fun write_place(var self, p: Place, v: Value) {
        if self.stop() || p.root.len() == 0 { return }
        let n = p.steps.len()
        if n > 0 {
            var parent = Place { root: p.root, steps: [] }
            var i = 0
            while i < n - 1 {
                parent.steps.push(p.steps[i])
                i = i + 1
            }
            match p.steps[n - 1] {
                Step.SIndex(k, nd) => {
                    if !self.check_index(self.read_place(parent), k, nd, true) { return }
                },
                // a field: the indices on the way are read, so a missing map
                // key fails (`m[k].f = v`) as in the Python interpreter
                _ => {
                    if !self.readable(parent) { return }
                },
            }
        }
        self.update_place(p, PlaceOp.OSet(v))
    }

    // Whether `p` can be read: every index on the way is checked, failing
    // like a read. The value read is released before anything is written, so
    // the write doesn't copy the containers on the way (MYLA-74).
    #test(interp_on("[int]"), Place { root: "c", steps: [] })[true]
    fun readable(var self, p: Place) -> bool {
        self.read_place(p)
        return !self.stop()
    }

    // Apply `op` to the value at `p`, whose indices are already checked, in
    // place; yields what `op` yields (the popped element), else unit.
    //
    // The variable's value moves into `self.cell`, leaving unit behind, so
    // when the interpreted program shares nothing the interpreter holds the
    // only reference and the native copy-on-write doesn't copy: `push` and
    // `xs[i] = v` cost O(1) instead of rebuilding the container (MYLA-74).
    #test(interp_on("[int]"), Place { root: "i", steps: [] }, PlaceOp.OSet(Value.VInt(1)))[Value.VUnit]
    fun update_place(var self, p: Place, op: PlaceOp) -> Value {
        var i = self.scopes.len() - 1
        while i >= 0 {
            var j = self.scopes[i].names.len() - 1
            while j >= 0 {
                if self.scopes[i].names[j] == p.root {
                    match self.scopes[i].vals[j] {
                        Value.VActor(id) => {
                            if p.steps.len() > 0 {
                                // a part of an actor's state, changed by its method
                                self.cell = self.actors[id]
                                self.actors[id] = Value.VUnit
                                let r = self.update_cell(p.steps, 0, op)
                                self.actors[id] = self.cell
                                self.cell = Value.VUnit
                                return r
                            }
                        },
                        _ => {},
                    }
                    self.cell = self.scopes[i].vals[j]
                    self.scopes[i].vals[j] = Value.VUnit
                    let r = self.update_cell(p.steps, 0, op)
                    self.scopes[i].vals[j] = self.cell
                    self.cell = Value.VUnit
                    return r
                }
                j = j - 1
            }
            i = i - 1
        }
        return Value.VUnit
    }

    // Apply `op` at `steps[i..]` below `self.cell`, in place. Each container
    // on the path is taken apart (its parts held only here), the child moves
    // into the cell for the next step, and everything is put back after.
    #test(interp_on("[int]"), [], 0, PlaceOp.OSet(Value.VInt(1)))[Value.VUnit]
    fun update_cell(var self, steps: [Step], i: int32, op: PlaceOp) -> Value {
        if i == steps.len() { return self.apply_op(op) }
        var r = Value.VUnit
        match steps[i] {
            Step.SField(f) => {
                if !is_vstruct(self.cell) { return r }
                let n = struct_name(self.cell)
                let names = struct_field_names(self.cell)
                var vals = struct_values(self.cell)
                self.cell = Value.VUnit
                var j = 0
                while j < names.len() && names[j] != f { j = j + 1 }
                if j < vals.len() {
                    self.cell = vals[j]
                    vals[j] = Value.VUnit
                    r = self.update_cell(steps, i + 1, op)
                    vals[j] = self.cell
                }
                self.cell = Value.VStruct(n, names, vals)
            },
            Step.SIndex(k, nd) => {
                if is_vmap(self.cell) {
                    var m = map_parts(self.cell)
                    self.cell = Value.VUnit
                    let (found, h) = self.key_place(m, k)
                    var j = found
                    if j < 0 { j = m.add_key(k, h) }
                    self.cell = m.vs[j]
                    m.vs[j] = Value.VUnit
                    r = self.update_cell(steps, i + 1, op)
                    m.vs[j] = self.cell
                    self.cell = Value.VMap(m)
                } else if is_vlist(self.cell) {
                    var xs = list_values(self.cell)
                    self.cell = Value.VUnit
                    let j = as_int(k) as int32
                    self.cell = xs[j]
                    xs[j] = Value.VUnit
                    r = self.update_cell(steps, i + 1, op)
                    xs[j] = self.cell
                    self.cell = Value.VList(xs)
                }
            },
        }
        return r
    }

    // Apply `op` to `self.cell` itself.
    #test(interp_on("[int]"), PlaceOp.OSet(Value.VInt(1)))[Value.VUnit]
    fun apply_op(var self, op: PlaceOp) -> Value {
        match op {
            PlaceOp.OSet(v) => { self.cell = v },
            PlaceOp.OPush(v) => {
                var xs = list_values(self.cell)
                self.cell = Value.VUnit
                xs.push(v)
                self.cell = Value.VList(xs)
            },
            PlaceOp.OPop => {
                var xs = list_values(self.cell)
                self.cell = Value.VUnit
                let last = xs.pop()
                self.cell = Value.VList(xs)
                return last
            },
            PlaceOp.ORemove(k) => {
                if is_vmap(self.cell) {
                    var m = map_parts(self.cell)
                    self.cell = Value.VUnit
                    let (j, h) = self.key_place(m, k)
                    if j >= 0 { m.remove_at(j) }
                    self.cell = Value.VMap(m)
                }
            },
            PlaceOp.OAppend(piece) => {
                var b = sb_bytes(self.cell)
                self.cell = Value.VUnit
                var j = 0
                while j < piece.len() {
                    b.push(piece[j] as int64)
                    j = j + 1
                }
                self.cell = Value.VSB(b)
            },
            PlaceOp.OAppendByte(byte) => {
                var b = sb_bytes(self.cell)
                self.cell = Value.VUnit
                b.push(byte & 255)
                self.cell = Value.VSB(b)
            },
        }
        return Value.VUnit
    }

    // The length of the value at `p`, its indices checked (a read).
    #test(interp_on("[int]"), Place { root: "ys", steps: [] })[0]
    fun place_len(var self, p: Place) -> int64 {
        return value_len(self.read_place(p))
    }

    fun exec_block_body(var self, body: Option<Block>) {
        match body {
            Some(b) => { self.exec_block(b) },
            None => {},
        }
    }

    // -- statements -------------------------------------------------------

    fun exec_block(var self, b: Block) {
        self.push_scope()
        var i = 0
        while i < b.stmts.len() {
            if self.stop() { i = b.stmts.len() }
            else {
                self.exec_stmt(b.stmts[i])
                i = i + 1
            }
        }
        self.run_defers()
        self.pop_scope()
    }

    // The deferred blocks of the innermost scope, the last met first, as it
    // ends (D135): after a `return`'s value, a `?`, `break`, `continue` or
    // the arguments of a `become`, which wait for them; not on a failure or
    // `exit`, which end the program (D97), except under a `#test` case,
    // which they end instead: the case unwinds through them, and one that
    // fails itself is noted for the report (D162). Each sees the names
    // declared before it.
    fun run_defers(var self) {
        let top = self.scopes.len() - 1
        if self.scopes[top].defers.len() == 0 { return }
        let ds = self.scopes[top].defers
        self.scopes[top].defers = []
        match self.ctrl { Ctrl.CExit => { if !self.testing { return } }, _ => {} }
        let saved_ctrl = self.ctrl
        let saved_val = self.ctrl_val
        let saved_tail = self.tail
        let saved_err = self.rt_err
        let saved_code = self.exit_code
        self.ctrl = Ctrl.CNone
        self.rt_err = None
        self.exit_code = 0
        var i = ds.len() - 1
        while i >= 0 {
            let names = self.scopes[top].names
            let vals = self.scopes[top].vals
            var nb: [str] = []
            var vb: [Value] = []
            var k = 0
            while k < ds[i].names {
                nb.push(names[k])
                vb.push(vals[k])
                k = k + 1
            }
            self.scopes[top].names = nb
            self.scopes[top].vals = vb
            self.exec_block(ds[i].body)
            // the later names back, after what the block changed
            var after = self.scopes[top].vals
            while k < names.len() {
                nb.push(names[k])
                after.push(vals[k])
                k = k + 1
            }
            self.scopes[top].names = nb
            self.scopes[top].vals = after
            match self.ctrl {
                Ctrl.CExit => {
                    if !self.testing { return }
                    self.note_defer_failure()
                },
                _ => {},
            }
            i = i - 1
        }
        self.ctrl = saved_ctrl
        self.ctrl_val = saved_val
        self.tail = saved_tail
        self.rt_err = saved_err
        self.exit_code = saved_code
    }

    // A deferred block of a `#test` case failed: noted for the report, and
    // the unwinding goes on (D162).
    fun note_defer_failure(var self) {
        match self.rt_err {
            Some(r) => { self.defer_errs.push(r.msg) },
            None => { self.defer_errs.push(format("exited with status {}", self.exit_code)) },
        }
        self.ctrl = Ctrl.CNone
        self.rt_err = None
        self.exit_code = 0
    }

    // -- concurrency (D89, MYLA-139) --------------------------------------
    //
    // An async body with an `await` or an `async let` runs on the async
    // evaluator, normalized (anf.my): its statements are continuations
    // (`Cont`) of its call (`AFrame`) in its task (`Task`), so that the task
    // can stop at an `await` and go on later. Each statement without one runs
    // on the synchronous evaluator, as everywhere else. The tasks take turns:
    // each runs until it waits for a child, or until an `await` lets the
    // others run; a scope waits for the children it started before it ends.
    // Actors need no lock: one task runs at a time, and a method that waits
    // doesn't hold its actor (reentrancy).

    // Run the program from its async entry `fi`, as the first task.
    fun run_async(var self, fi: int32) {
        let v = self.run_as_first_task(fi, [])
    }

    // The tasks of an earlier run gone, for the next `#test` case of an
    // async function (D162): each runs as a program of its own.
    fun reset_tasks(var self) {
        self.tasks = []
        self.queue = []
        self.qhead = 0
        self.qlen = 0
        self.cur = -1
        self.frames = []
        self.deferred = None
        self.deferred_place = None
        self.parked = false
        self.yielding = false
        self.entered_async = false
        self.failing = false
        self.fail_err = None
        self.fail_code = 0
        self.sleepers = []
        self.deadlines = []
        self.fired = []
        self.fd_waits = []
        self.notifs = []
        self.pwaits = []
        self.free_waits = []
        self.parked_waits = []
    }

    // The async function `fi` called with `argv` as the first task, every
    // task it starts run to its end: its result; a failure of the first task
    // (its own, or a child's that ended the program, D97) is left in `ctrl`,
    // `rt_err` and `exit_code` as a synchronous call leaves one.
    fun run_as_first_task(var self, fi: int32, argv: [Value]) -> Value {
        self.defer = true
        self.deferred = None
        self.enter_func(fi, argv)
        self.defer = false
        match self.deferred {
            Some(d) => {
                self.deferred = None
                self.new_task(d.scopes, d.body)
            },
            None => { return Value.VUnit },
        }
        self.scopes = []
        while true {
            self.wake_sleepers()
            if self.qlen == 0 {
                if self.wait_for_sleeper() { continue }
                break
            }
            let t = self.next_ready()
            self.cur = t
            self.frames = self.tasks[t].frames
            self.tasks[t].frames = []
            self.scopes = self.frames[self.frames.len() - 1].scopes
            // a cancelled task stops here, at a suspension point: it leaves
            // its calls as a failing one does, its scopes cancelling and
            // waiting for its own children (D94)
            if self.tasks[t].cancelled {
                let ft = self.frames.len() - 1
                match self.frames[ft].pend {
                    Ctrl.CNone => {
                        self.frames[ft].pend = Ctrl.CExit
                        self.frames[ft].perr = None
                        self.frames[ft].pcode = 0
                        // the first task stops with the failure that ends the
                        // program (D97)
                        if t == 0 && self.failing {
                            self.frames[ft].perr = self.fail_err
                            self.frames[ft].pcode = self.fail_code
                        }
                    },
                    _ => {},
                }
            }
            self.run_task()
            if self.tasks[t].state != 2 {
                self.frames[self.frames.len() - 1].scopes = self.scopes
                self.tasks[t].frames = self.frames
            }
            self.frames = []
            self.scopes = []
        }
        // no task ready, none asleep or waiting for input, and the first
        // not done: every task waits on a notifier nobody can wake
        // (MYLA-387), as native code's `exec_stuck` reports it
        if self.tasks[0].state != 2 && !self.failing {
            self.rt_err = Some(RtError { msg: "every task waits for another one", line: 0, col: 0, sp: no_span(), node: -1 })
            self.ctrl = Ctrl.CExit
            self.exit_code = 1
            return Value.VUnit
        }
        // the first task's failure is the program's
        if self.tasks[0].failed {
            self.rt_err = self.tasks[0].err
            self.ctrl = Ctrl.CExit
            self.exit_code = self.tasks[0].code
            return Value.VUnit
        }
        return self.tasks[0].value
    }

    // A task running `body` with the variables `scopes`, ready to run.
    #test(interp_on("fun main() { print(1 + 2) }"), [RtFrame { names: [], vals: [], defers: [] }], block_of("{ }"))[0]
    fun new_task(var self, scopes: [RtFrame], body: Block) -> int32 {
        var sc = scopes
        sc.push(RtFrame { names: [], vals: [], defers: [] })
        let f = AFrame { scopes: sc, conts: [Cont.KScope, Cont.KStmts(body.stmts, 0)], place: None, pend: Ctrl.CNone, pval: Value.VUnit, perr: None, pcode: 0 }
        self.tasks.push(Task { frames: [f], state: 0, value: Value.VUnit, failed: false, err: None, code: 0, awaited: false, waiters: [], cancelled: false, kids: [], requested: false })
        let id = self.tasks.len() - 1
        self.ready(id)
        return id
    }

    // -- the ready tasks (D110, MYLA-231) ----------------------------------
    //
    // The order native code runs frames in on one worker (`emit_executor`):
    // the newest ready task first, depth first; a task yielding a turn goes
    // to the oldest end, behind the others. MYLA_SCHED=fifo runs the oldest
    // first (a yield goes to the newest end, behind the others); seed:N
    // queues each ready task at the end a generator picks.

    // Run the ready tasks in the order `spec` (MYLA_SCHED's value) names.
    fun schedule(var self, spec: str) {
        let (order, seed) = sched_of(spec)
        self.sched = order
        self.rng = seed
    }

    // The clock MYLA_TIME's value `spec` names (D124): "virtual", one that
    // moves only to the next deadline when no task is ready; else the real
    // monotonic clock.
    fun time_mode(var self, spec: str) {
        self.virtual_time = spec == "virtual"
    }

    // The interpreter's clock, in nanoseconds.
    fun now(self) -> int64 {
        if self.virtual_time { return self.vclock }
        return __clock_ns()
    }

    // The tasks whose time to wake came (all of them once a task failed, so
    // the others stop at once, D97) ready so that the earliest runs first,
    // as native code's timers fire: the newest runs first, so they are made
    // ready latest first (fifo: earliest first).
    fun wake_sleepers(var self) {
        if self.deadlines.len() > 0 { self.fire_deadlines() }
        if self.fd_waits.len() > 0 { let any = self.wake_readers() }
        if self.sleepers.len() == 0 { return }
        let now = self.now()
        var due: [int32] = []
        while true {
            var best = -1
            var i = 0
            while i < self.sleepers.len() {
                let s = self.sleepers[i]
                if s.at <= now || self.failing {
                    if best < 0 || s.at < self.sleepers[best].at || (s.at == self.sleepers[best].at && s.seq < self.sleepers[best].seq) { best = i }
                }
                i = i + 1
            }
            if best < 0 { break }
            let t = self.sleepers[best].task
            let wi = self.sleepers[best].wait
            var rest: [Sleeper] = []
            var j = 0
            while j < self.sleepers.len() {
                if j != best { rest.push(self.sleepers[j]) }
                j = j + 1
            }
            self.sleepers = rest
            // a wait whose time passed: off its notifier (MYLA-387)
            if wi >= 0 { self.unpark(wi, 3, false) }
            self.tasks[t].state = 0
            due.push(t)
        }
        if self.sched == SCHED_FIFO {
            for t in due { self.ready(t) }
        } else {
            var i = due.len()
            while i > 0 {
                i = i - 1
                self.ready(due[i])
            }
        }
    }

    // The deadlines that passed: each cancels its task (its sleepers' time
    // comes at once) and is marked fired.
    fun fire_deadlines(var self) {
        let now = self.now()
        var rest: [Deadline] = []
        var due: [Deadline] = []
        for d in self.deadlines {
            if d.at <= now { due.push(d) } else { rest.push(d) }
        }
        self.deadlines = rest
        for d in due {
            self.fired[d.rec] = true
            self.request_cancel(d.task)
        }
    }

    // The tasks whose descriptor is readable ready (in the order they began
    // waiting); whether there were any.
    fun wake_readers(var self) -> bool {
        var rest: [FdWait] = []
        var woke = false
        for w in self.fd_waits {
            if fd_wait_over(w) {
                self.tasks[w.task].state = 0
                self.ready(w.task)
                woke = true
            } else {
                rest.push(w)
            }
        }
        self.fd_waits = rest
        return woke
    }

    // No task ready: until the earliest sleeper's or deadline's time (the
    // virtual clock moved to it), or a waiting task's input is there; false
    // when no task sleeps or waits.
    fun wait_for_sleeper(var self) -> bool {
        if self.fd_waits.len() > 0 {
            // a millisecond at a time, until input or the next sleeper's time
            // (the virtual clock moves only once no input came)
            while true {
                if self.wake_readers() { return true }
                if (self.sleepers.len() > 0 || self.deadlines.len() > 0) && self.virtual_time { break }
                var due = false
                for s in self.sleepers {
                    if s.at <= self.now() { due = true }
                }
                for d in self.deadlines {
                    if d.at <= self.now() { due = true }
                }
                if due { return true }
                __sleep_ns(1000000)
            }
        }
        if self.sleepers.len() == 0 && self.deadlines.len() == 0 { return false }
        var at: int64 = -1
        for s in self.sleepers {
            if at < 0 || s.at < at { at = s.at }
        }
        for d in self.deadlines {
            if at < 0 || d.at < at { at = d.at }
        }
        if self.virtual_time {
            if at > self.vclock { self.vclock = at }
        } else {
            let left = at - __clock_ns()
            if left > 0 { __sleep_ns(left) }
        }
        return true
    }

    // Room for one more ready task: the ring doubled, its tasks in order.
    fun q_room(var self) {
        let cap = self.queue.len()
        if self.qlen < cap { return }
        var bigger: [int32] = []
        var i = 0
        while i < self.qlen {
            bigger.push(self.queue[(self.qhead + i) % cap])
            i = i + 1
        }
        while bigger.len() < 2 * cap + 16 { bigger.push(-1) }
        self.queue = bigger
        self.qhead = 0
    }

    // The task `t` is ready: the newest (seed:N: at the end the generator's
    // next value picks, its bit 33, as `__exec_push`).
    fun ready(var self, t: int32) {
        if self.sched == SCHED_SEED {
            self.rng = self.rng.wrapping_mul(SCHED_MUL).wrapping_add(SCHED_ADD)
            if (self.rng / 8589934592u64) % 2u64 == 1u64 {
                self.q_front(t)
                return
            }
        }
        self.q_room()
        self.queue[(self.qhead + self.qlen) % self.queue.len()] = t
        self.qlen = self.qlen + 1
    }

    // The task `t` yields its turn: the oldest (fifo: the newest, behind the
    // others).
    fun ready_behind(var self, t: int32) {
        if self.sched == SCHED_FIFO {
            self.ready(t)
            return
        }
        self.q_front(t)
    }

    // The task `t` at the oldest end.
    fun q_front(var self, t: int32) {
        self.q_room()
        let cap = self.queue.len()
        self.qhead = (self.qhead + cap - 1) % cap
        self.queue[self.qhead] = t
        self.qlen = self.qlen + 1
    }

    // The ready task to run next (there is one): the newest (fifo: the
    // oldest), as `__exec_find`.
    fun next_ready(var self) -> int32 {
        let cap = self.queue.len()
        if self.sched == SCHED_FIFO {
            let t = self.queue[self.qhead]
            self.qhead = (self.qhead + 1) % cap
            self.qlen = self.qlen - 1
            return t
        }
        let last = (self.qhead + self.qlen - 1) % cap
        self.qlen = self.qlen - 1
        return self.queue[last]
    }

    // Run the current task until it waits, lets the others run, or ends.
    fun run_task(var self) {
        while self.frames.len() > 0 {
            let top = self.frames.len() - 1
            let leaving = match self.frames[top].pend { Ctrl.CNone => false, _ => true }
            if leaving { self.unwind_step() }
            else if self.frames[top].conts.len() == 0 { self.finish_frame(true, Value.VUnit, None, 0) }
            else { self.step() }
            if self.parked {
                self.parked = false
                // (an `await` of a sleep asks for a turn too: it has it)
                self.yielding = false
                return
            }
            if self.yielding {
                self.yielding = false
                if self.frames.len() > 0 {
                    self.ready_behind(self.cur)
                    return
                }
            }
        }
    }

    // One step of the current call: its innermost continuation.
    fun step(var self) {
        let top = self.frames.len() - 1
        let ci = self.frames[top].conts.len() - 1
        match self.frames[top].conts[ci] {
            Cont.KStmts(stmts, i) => {
                if i >= stmts.len() {
                    self.frames[top].conts.pop()
                    return
                }
                self.frames[top].conts[ci] = Cont.KStmts(stmts, i + 1)
                let s = stmts[i]
                if self.suspends(s) { self.exec_async(s) } else { self.exec_stmt(s) }
                self.take_ctrl()
            },
            Cont.KScope => { self.close_scope() },
            Cont.KWhile(c, b) => {
                let cv = self.eval(c)
                if self.stop() {
                    self.take_ctrl()
                    return
                }
                if as_bool(cv) { self.push_block(b) } else { self.frames[top].conts.pop() }
            },
            Cont.KFor(v, items, i, hi, body) => {
                if i >= hi {
                    self.frames[top].conts.pop()
                    return
                }
                self.frames[top].conts[ci] = Cont.KFor(v, items, i + 1, hi, body)
                var item = Value.VInt(i)
                if items.len() > 0 { item = items[i as int32] }
                self.push_scope()
                self.define(v, item)
                self.frames[top].conts.push(Cont.KScope)
                self.push_block(body)
            },
            Cont.KLet(name, child) => {
                self.frames[top].conts.pop()
                self.deliver(name, child)
                self.take_ctrl()
            },
        }
    }

    // A block of the current call: its scope, then its statements.
    fun push_block(var self, b: Block) {
        self.push_scope()
        let top = self.frames.len() - 1
        self.frames[top].conts.push(Cont.KScope)
        self.frames[top].conts.push(Cont.KStmts(b.stmts, 0))
    }

    // A block: on this evaluator when it can suspend, else run now.
    fun run_block(var self, b: Block) {
        if self.block_has_suspend(b) { self.push_block(b) } else { self.exec_block(b) }
    }

    // A `return`, `break`, `continue` or failure a statement left: the
    // current call leaves its blocks with it.
    fun take_ctrl(var self) {
        match self.ctrl {
            Ctrl.CNone => { return },
            _ => {},
        }
        let top = self.frames.len() - 1
        self.frames[top].pend = self.ctrl
        self.frames[top].pval = self.ctrl_val
        self.frames[top].perr = self.rt_err
        self.frames[top].pcode = self.exit_code
        self.ctrl = Ctrl.CNone
        self.ctrl_val = Value.VUnit
        self.rt_err = None
        self.exit_code = 0
    }

    // One step of leaving: the innermost continuation goes, a scope after its
    // children; a loop stops at `break` and goes on at `continue`; the call
    // ends when none is left.
    fun unwind_step(var self) {
        let top = self.frames.len() - 1
        let n = self.frames[top].conts.len()
        if n == 0 {
            let pend = self.frames[top].pend
            let pval = self.frames[top].pval
            let perr = self.frames[top].perr
            let pcode = self.frames[top].pcode
            match pend {
                Ctrl.CReturn => { self.finish_frame(true, pval, None, 0) },
                Ctrl.CExit => { self.finish_frame(false, Value.VUnit, perr, pcode) },
                _ => { self.finish_frame(true, Value.VUnit, None, 0) },
            }
            return
        }
        match self.frames[top].conts[n - 1] {
            Cont.KScope => { self.close_scope() },
            Cont.KWhile(c, b) => { self.leave_loop() },
            Cont.KFor(v, items, i, hi, body) => { self.leave_loop() },
            _ => { self.frames[top].conts.pop() },
        }
    }

    fun leave_loop(var self) {
        let top = self.frames.len() - 1
        match self.frames[top].pend {
            Ctrl.CBreak => {
                self.frames[top].conts.pop()
                self.frames[top].pend = Ctrl.CNone
            },
            Ctrl.CContinue => { self.frames[top].pend = Ctrl.CNone },
            _ => { self.frames[top].conts.pop() },
        }
    }

    // A scope's end: it waits for the children it started; one that failed
    // unawaited fails the call, unless it is failing already; then the scope
    // goes.
    fun close_scope(var self) {
        let s = self.scopes.len() - 1
        // a failing scope cancels its children first (D94)
        let ft = self.frames.len() - 1
        let fails = match self.frames[ft].pend { Ctrl.CExit => true, _ => false }
        if fails {
            for v in self.scopes[s].vals {
                match v {
                    Value.VTask(id) => { if self.tasks[id].state != 2 { self.cancel_task(id) } },
                    _ => {},
                }
            }
        }
        for v in self.scopes[s].vals {
            match v {
                Value.VTask(id) => {
                    if self.tasks[id].state != 2 {
                        self.wait_for(id)
                        return
                    }
                },
                _ => {},
            }
        }
        let top = self.frames.len() - 1
        for v in self.scopes[s].vals {
            match v {
                Value.VTask(id) => {
                    let failing = match self.frames[top].pend { Ctrl.CExit => true, _ => false }
                    if self.tasks[id].failed && !self.tasks[id].awaited && !failing {
                        self.frames[top].pend = Ctrl.CExit
                        self.frames[top].perr = self.tasks[id].err
                        self.frames[top].pcode = self.tasks[id].code
                    }
                    self.tasks[id].awaited = true
                    self.tasks[id].value = Value.VUnit
                },
                _ => {},
            }
        }
        // its deferred blocks, once its children have ended (D135); a
        // failing scope's too under a `#test` case (D162), the failure kept
        let failing = match self.frames[top].pend { Ctrl.CExit => true, _ => false }
        if !failing {
            self.run_defers()
            self.take_ctrl()
        } else if self.testing {
            self.ctrl = Ctrl.CExit
            self.rt_err = self.frames[top].perr
            self.exit_code = self.frames[top].pcode
            self.run_defers()
            self.ctrl = Ctrl.CNone
            self.rt_err = None
            self.exit_code = 0
        }
        self.pop_scope()
        self.frames[top].conts.pop()
    }

    // The task `id` and its children, cancelled: each stops when it next runs.
    fun cancel_task(var self, id: int32) {
        if self.tasks[id].cancelled { return }
        self.tasks[id].cancelled = true
        for k in self.tasks[id].kids { self.cancel_task(k) }
    }

    // `task.cancel` of the task `id`: it and its children asked to stop (D96).
    fun request_cancel(var self, id: int32) {
        self.tasks[id].requested = true
        // asleep, it wakes at once (D124); waiting for input, too
        var i = 0
        while i < self.sleepers.len() {
            if self.sleepers[i].task == id { self.sleepers[i].at = -1 }
            i = i + 1
        }
        if self.fd_waits.len() > 0 {
            var rest: [FdWait] = []
            for w in self.fd_waits {
                if w.task == id {
                    self.tasks[id].state = 0
                    self.ready(id)
                } else {
                    rest.push(w)
                }
            }
            self.fd_waits = rest
        }
        // waiting on a notifier (MYLA-387): the wait cancelled, ready
        for wi in self.parked_waits {
            if self.pwaits[wi].task == id {
                self.unpark(wi, 4, true)
                self.ready(id)
            }
        }
        for k in self.tasks[id].kids { self.request_cancel(k) }
    }

    // -- notifiers (MYLA-387) -------------------------------------------
    //
    // As native code's (std.rt's `park_frame`, `notify`): a wait takes a
    // permit, or sees a `notify_all` since its generation, or parks on its
    // notifier until `notify_one` (oldest first) or `notify_all` wakes it,
    // its time limit passes (a sleeper of its own) or its task is asked to
    // stop; a failure (D97) wakes every wait, which then stops.

    // `__notifier()`, `__notify(n, all)`, `__notify_gen(n)`, `__waiter(n,
    // since, ms)`, `__park(w)` and `__woken(w)`.
    fun notify_primitive(var self, nm: str, args: [Expr]) -> Value {
        var ints: [int64] = []
        var all = false
        for a in args {
            match self.eval(a) {
                Value.VBool(b) => { all = b },
                v => { ints.push(as_int(v)) },
            }
        }
        if self.stop() { return Value.VUnit }
        if nm == "__notifier" {
            self.notifs.push(Notif { permits: 0, gen: 0, waits: [] })
            return Value.VInt((self.notifs.len() - 1) as int64)
        }
        if nm == "__notify_gen" { return Value.VInt(self.notifs[ints[0] as int32].gen) }
        if nm == "__notify" {
            self.notify(ints[0] as int32, all)
            return Value.VUnit
        }
        if nm == "__waiter" {
            let w = PWait { task: -1, n: ints[0] as int32, since: ints[1], ms: ints[2], state: 0 }
            if self.free_waits.len() > 0 {
                let wi = self.free_waits.pop()
                self.pwaits[wi] = w
                return Value.VInt(wi as int64)
            }
            self.pwaits.push(w)
            return Value.VInt((self.pwaits.len() - 1) as int64)
        }
        if nm == "__woken" {
            let st = self.pwaits[ints[0] as int32].state
            self.free_waits.push(ints[0] as int32)
            if st == 2 { return Value.VInt(1) }
            if st == 4 { return Value.VInt(2) }
            return Value.VInt(0)
        }
        self.park(ints[0] as int32)
        return Value.VUnit
    }

    // `__park(w)`: the running task parked on the wait `w`,
    // or ready again at once when it needn't wait, as native code queues
    // it; outside any task nobody can wake it, so it ends at once, after
    // its time, or never (every task waits).
    fun park(var self, wi: int32) {
        let ni = self.pwaits[wi].n
        let outside = self.cur < 0 || self.cur >= self.tasks.len()
        var st = 1
        if !outside && (self.tasks[self.cur].requested || self.tasks[self.cur].cancelled) {
            st = 4
        } else if self.notifs[ni].permits > 0 {
            self.notifs[ni].permits = self.notifs[ni].permits - 1
            st = 2
        } else if self.pwaits[wi].since >= 0 && self.notifs[ni].gen != self.pwaits[wi].since {
            st = 2
        } else if self.pwaits[wi].ms == 0 {
            st = 3
        }
        if outside {
            if st == 1 {
                let ms = self.pwaits[wi].ms
                if ms < 0 {
                    self.rt_err = Some(RtError { msg: "every task waits for another one", line: 0, col: 0, sp: no_span(), node: -1 })
                    self.ctrl = Ctrl.CExit
                    self.exit_code = 1
                    return
                }
                if self.virtual_time { self.vclock = self.vclock + ms * 1000000 } else { __sleep_ns(ms * 1000000) }
                st = 3
            }
            self.pwaits[wi].state = st
            return
        }
        self.parked = true
        if st != 1 {
            self.pwaits[wi].state = st
            self.ready(self.cur)
            return
        }
        self.pwaits[wi].state = 1
        self.pwaits[wi].task = self.cur
        self.notifs[ni].waits.push(wi)
        self.parked_waits.push(wi)
        let ms = self.pwaits[wi].ms
        if ms > 0 {
            self.sleepers.push(Sleeper { at: self.now() + ms * 1000000, seq: self.sleep_seq, task: self.cur, wait: wi })
            self.sleep_seq = self.sleep_seq + 1
        }
        self.tasks[self.cur].state = 1
    }

    // The parked wait `w` off its notifier and the parked ones, its time
    // limit off the sleepers (`forget`: unless it is the one that woke
    // it), its state `st`, its task no longer waiting (not yet ready).
    fun unpark(var self, wi: int32, st: int32, forget: bool) {
        let ni = self.pwaits[wi].n
        var rest: [int32] = []
        for x in self.notifs[ni].waits {
            if x != wi { rest.push(x) }
        }
        self.notifs[ni].waits = rest
        var left: [int32] = []
        for x in self.parked_waits {
            if x != wi { left.push(x) }
        }
        self.parked_waits = left
        if forget && self.pwaits[wi].ms > 0 {
            var keep: [Sleeper] = []
            for z in self.sleepers {
                if z.wait != wi { keep.push(z) }
            }
            self.sleepers = keep
        }
        self.pwaits[wi].state = st
        self.tasks[self.pwaits[wi].task].state = 0
    }

    // `__notify(n, all)`: the oldest wait on the notifier `n` woken, or a
    // permit added when none waits; `all`: every wait woken and the
    // generation counted, no permit. Made ready so that the one that waited
    // longest runs first, as native code queues them.
    fun notify(var self, ni: int32, all: bool) {
        if !all {
            if self.notifs[ni].waits.len() == 0 {
                self.notifs[ni].permits = self.notifs[ni].permits + 1
                return
            }
            let wi = self.notifs[ni].waits[0]
            self.unpark(wi, 2, true)
            self.ready(self.pwaits[wi].task)
            return
        }
        self.notifs[ni].gen = self.notifs[ni].gen + 1
        let ws = self.notifs[ni].waits
        var due: [int32] = []
        for wi in ws {
            self.unpark(wi, 2, true)
            due.push(self.pwaits[wi].task)
        }
        if self.sched == SCHED_FIFO {
            for t in due { self.ready(t) }
        } else {
            var i = due.len()
            while i > 0 {
                i = i - 1
                self.ready(due[i])
            }
        }
    }

    // The current task waits for the task `id` to end.
    fun wait_for(var self, id: int32) {
        self.tasks[id].waiters.push(self.cur)
        self.tasks[self.cur].state = 1
        self.parked = true
    }

    // A normalized statement with an `await` or an `async let`.
    fun exec_async(var self, s: Stmt) {
        match s.kind {
            StmtKind.VarDecl(kind, name, ty, init) => {
                if kind == "async" {
                    self.start_child(name, init)
                    return
                }
                match init.kind {
                    ExprKind.Await(op) => { self.exec_await(name, op) },
                    _ => { self.exec_stmt(s) },
                }
            },
            StmtKind.IfS(c, th, el) => {
                let cv = self.eval(c)
                if self.stop() { return }
                if as_bool(cv) {
                    self.run_block(th)
                    return
                }
                match el {
                    Some(et) => {
                        match et {
                            ElseTail.ElseBlock(b) => { self.run_block(b) },
                            ElseTail.ElseIf(s2) => {
                                if self.suspends(s2) { self.exec_async(s2) } else { self.exec_stmt(s2) }
                            },
                        }
                    },
                    None => {},
                }
            },
            StmtKind.WhileS(c, b) => { self.frames[self.frames.len() - 1].conts.push(Cont.KWhile(c, b)) },
            StmtKind.ForS(v, st, en, body, it) => {
                var items: [Value] = []
                var lo: int64 = 0
                var hi: int64 = 0
                match it {
                    Some(x) => {
                        items = self.iter_items(self.eval(x))
                        hi = items.len() as int64
                    },
                    None => {
                        match st { Some(a) => { lo = as_int(self.eval(a)) }, None => {} }
                        match en { Some(b) => { hi = as_int(self.eval(b)) }, None => {} }
                    },
                }
                if self.stop() { return }
                self.frames[self.frames.len() - 1].conts.push(Cont.KFor(v, items, lo, hi, body))
            },
            StmtKind.ExprStmt(x) => {
                match x.kind {
                    ExprKind.MatchE(sc, arms) => { self.async_match(sc, arms) },
                    _ => { self.exec_stmt(s) },
                }
            },
            _ => { self.exec_stmt(s) },
        }
    }

    // A `match` statement whose arms can suspend: the arm is chosen now (its
    // guard has no `await`), its body runs on this evaluator.
    fun async_match(var self, sc: Expr, arms: [MatchArm]) {
        let sv = self.eval(sc)
        if self.stop() { return }
        for arm in arms {
            let mr = self.match_pattern(arm.pattern, sv)
            if mr.ok {
                self.push_scope()
                var j = 0
                while j < mr.names.len() {
                    self.define(mr.names[j], mr.vals[j])
                    j = j + 1
                }
                var guard_ok = true
                match arm.guard { Some(g) => { guard_ok = as_bool(self.eval(g)) }, None => {} }
                if self.stop() {
                    self.pop_scope()
                    return
                }
                if guard_ok {
                    match arm.body {
                        ExprOrBlock.EB_Block(b) => {
                            if self.block_has_suspend(b) {
                                self.frames[self.frames.len() - 1].conts.push(Cont.KScope)
                                self.push_block(b)
                            } else {
                                self.exec_block(b)
                                self.pop_scope()
                            }
                        },
                        ExprOrBlock.EB_Expr(x) => {
                            self.eval(x)
                            self.pop_scope()
                        },
                    }
                    return
                }
                self.pop_scope()
            }
        }
    }

    // `let name = await op`: the result of an `async let`'s child (waiting
    // for it if it hasn't ended), or of a call. A call whose body can suspend
    // is entered on this evaluator; any other runs now, and then the other
    // tasks may run.
    fun exec_await(var self, name: str, op: Expr) {
        match op.kind {
            ExprKind.Name(n) => {
                match self.lookup(n) {
                    Some(v) => {
                        match v {
                            Value.VTask(id) => {
                                // a child that has ended: its result at
                                // once, no turn for the others (as native
                                // code's `myla___wait`, D110)
                                if self.tasks[id].state == 2 {
                                    self.deliver(name, id)
                                } else {
                                    self.frames[self.frames.len() - 1].conts.push(Cont.KLet(name, id))
                                    self.wait_for(id)
                                }
                                return
                            },
                            _ => {},
                        }
                    },
                    None => {},
                }
            },
            _ => {},
        }
        self.deferred = None
        self.deferred_place = None
        self.defer = true
        self.entered_async = false
        let by_value = calls_a_value(op, self.scopes)
        let v = self.eval(op)
        self.defer = false
        if self.stop() {
            self.deferred = None
            return
        }
        match self.deferred {
            Some(d) => {
                self.deferred = None
                let place = self.deferred_place
                self.deferred_place = None
                let top = self.frames.len() - 1
                self.frames[top].conts.push(Cont.KLet(name, -1))
                self.frames[top].scopes = self.scopes
                self.frames.push(AFrame { scopes: d.scopes, conts: [], place: place, pend: Ctrl.CNone, pval: Value.VUnit, perr: None, pcode: 0 })
                self.scopes = d.scopes
                self.push_block(d.body)
            },
            None => {
                self.define(name, v)
                // after a synchronous or actor call, not after an async function,
                // method or function value that ran at once: native code's turns
                // (MYLA-228)
                if !self.entered_async && !by_value { self.yielding = true }
                self.entered_async = false
            },
        }
    }

    // The ended child task `id`'s result, for `name`; its failure, the
    // current call's.
    fun deliver(var self, name: str, id: int32) {
        self.tasks[id].awaited = true
        if self.tasks[id].failed {
            self.rt_err = self.tasks[id].err
            self.ctrl = Ctrl.CExit
            self.exit_code = self.tasks[id].code
            return
        }
        self.define(name, self.tasks[id].value)
    }

    // The current call ends, returning `v` (`ok`) or failing; a `var self`
    // method's `self` goes back to its receiver.
    fun finish_frame(var self, ok: bool, v: Value, err: Option<RtError>, code: int32) {
        let done = self.frames.pop()
        var final_self = Value.VUnit
        match done.place { Some(p) => { final_self = self.lookup_or_unit("self") }, None => {} }
        if self.frames.len() == 0 {
            self.end_task(ok, v, err, code)
            return
        }
        let top = self.frames.len() - 1
        self.scopes = self.frames[top].scopes
        if ok {
            match done.place { Some(p) => { self.write_place(p, final_self) }, None => {} }
        }
        let ci = self.frames[top].conts.len() - 1
        match self.frames[top].conts[ci] {
            Cont.KLet(name, child) => {
                self.frames[top].conts.pop()
                if ok {
                    self.define(name, v)
                } else {
                    self.frames[top].pend = Ctrl.CExit
                    self.frames[top].perr = err
                    self.frames[top].pcode = code
                }
            },
            _ => {},
        }
    }

    // The current task ends; the tasks waiting for it are ready again.
    fun end_task(var self, ok: bool, v: Value, err: Option<RtError>, code: int32) {
        let t = self.cur
        self.tasks[t].state = 2
        // its deadline, if it has one, no longer fires (D124)
        if self.deadlines.len() > 0 {
            var rest: [Deadline] = []
            for d in self.deadlines {
                if d.task != t { rest.push(d) }
            }
            self.deadlines = rest
        }
        self.tasks[t].value = v
        self.tasks[t].failed = !ok
        self.tasks[t].err = err
        self.tasks[t].code = code
        // a failure, not a cancelled task's stop, ends the program at once
        // (D97): the first one is the program's, every task is cancelled
        if !ok && t != 0 && !self.tasks[t].cancelled && !self.failing {
            self.failing = true
            self.fail_err = err
            self.fail_code = code
            self.cancel_task(0)
            // the tasks parked on notifiers stop too (MYLA-387): nobody may
            // wake them now
            for wi in self.parked_waits {
                let pt = self.pwaits[wi].task
                self.unpark(wi, 4, true)
                self.ready(pt)
            }
            match err {
                Some(r) => { self.fail_reported = self.on_failure(r) },
                None => {},
            }
        }
        for w in self.tasks[t].waiters {
            self.tasks[w].state = 0
            self.ready(w)
        }
        self.tasks[t].waiters = []
        self.scopes = []
    }

    // `async let name = init`: a child task with copies of the variables,
    // awaiting the call `init` makes, ready to run after this one.
    fun start_child(var self, name: str, init: Expr) {
        let body = self.task_body(init)
        let id = self.new_task(self.scopes, body)
        self.tasks[self.cur].kids.push(id)
        if self.tasks[self.cur].cancelled { self.tasks[id].cancelled = true }
        if self.tasks[self.cur].requested { self.tasks[id].requested = true }
        self.define(name, Value.VTask(id))
    }

    // -- what goes to the async evaluator ---------------------------------

    // Whether the call being entered, with the body `b`, goes to the async
    // evaluator (Interp.defer): its body can suspend; it is deferred with the
    // variables just made.
    fun defer_block(var self, b: Option<Block>) -> bool {
        if !self.defer { return false }
        match b {
            Some(bl) => {
                if !self.block_has_suspend(bl) { return false }
                self.defer = false
                self.deferred = Some(Deferred { scopes: self.scopes, body: self.normalized(bl) })
                return true
            },
            None => {},
        }
        return false
    }

    fun defer_lambda(var self, body: ExprOrBlock) -> bool {
        if !self.defer { return false }
        match body {
            ExprOrBlock.EB_Block(bl) => { return self.defer_block(Some(bl)) },
            ExprOrBlock.EB_Expr(e) => {
                if !body_suspends(body) { return false }
                self.defer = false
                self.deferred = Some(Deferred { scopes: self.scopes, body: self.lambda_body(e) })
                return true
            },
        }
        return false
    }

    #test(interp_on("struct P { x: int, y: int }"), fun_of("fun g() { print(1) }"))[false]
    fun body_suspends_fd(var self, fd: FunData) -> bool {
        return match fd.body { Some(b) => self.block_has_suspend(b), None => false }
    }

    #test(interp_on("fun main() { print(1 + 2) }"), block_of("{ }"))[false]
    fun block_has_suspend(var self, b: Block) -> bool {
        for s in b.stmts { if self.suspends(s) { return true } }
        return false
    }

    // Whether `s` has an `await` or an `async let` (by statement).
    #test(interp_on("[int]"), Stmt { id: 89, line: 44, col: 5, sp: SrcSpan { sline: 44, scol: 5, eline: 44, ecol: 20 }, kind: StmtKind.VarDecl("let", "s", None, Expr { id: 88, line: 44, col: 13, sp: SrcSpan { sline: 44, scol: 13, eline: 44, ecol: 20 }, kind: ExprKind.StrLit("hello") }) })[false]
    fun suspends(var self, s: Stmt) -> bool {
        match self.suspending.get(s.id) { Some(r) => { return r }, None => {} }
        let r = stmt_suspends(s)
        self.suspending[s.id] = r
        return r
    }

    // The normalized body of an async function or method (by its first
    // statement), of a lambda's expression (by its id), of an `async let`'s
    // child (by the initializer's id). The normalizer adds the types of the
    // nodes it makes to `resolved`, which it holds meanwhile.
    #test(interp_on("fun main() { print(1 + 2) }"), block_of("{ }"))[Block { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 4 }, stmts: [] }]
    fun normalized(var self, b: Block) -> Block {
        if b.stmts.len() == 0 { return b }
        let key = b.stmts[0].id
        match self.bodies.get(key) { Some(nb) => { return nb }, None => {} }
        self.norm.resolved = self.resolved
        self.resolved = [:]
        let nb = self.norm.block(b)
        self.resolved = self.norm.resolved
        self.norm.resolved = [:]
        self.bodies[key] = nb
        return nb
    }

    fun lambda_body(var self, e: Expr) -> Block {
        match self.bodies.get(e.id) { Some(nb) => { return nb }, None => {} }
        self.norm.resolved = self.resolved
        self.resolved = [:]
        let nb = self.norm.returning(e, false)
        self.resolved = self.norm.resolved
        self.norm.resolved = [:]
        self.bodies[e.id] = nb
        return nb
    }

    fun task_body(var self, init: Expr) -> Block {
        match self.bodies.get(init.id) { Some(nb) => { return nb }, None => {} }
        self.norm.resolved = self.resolved
        self.resolved = [:]
        let nb = self.norm.returning(init, true)
        self.resolved = self.norm.resolved
        self.norm.resolved = [:]
        self.bodies[init.id] = nb
        return nb
    }

    // The value `v` reaches its fields through: an actor's state.
    #test(interp_on("[int]"), Value.VStruct("Counter", ["n"], [Value.VInt(0)]))[Value.VStruct("Counter", ["n"], [Value.VInt(0)])]
    fun deref(self, v: Value) -> Value {
        return match v { Value.VActor(id) => self.actors[id], _ => v }
    }

    // Whether `name` is an actor type (an empty table needs no hashing).
    #test(interp_on("[int]"), "Box")[false]
    fun is_actor_type(self, name: str) -> bool {
        return self.actor_types.len() > 0 && self.actor_types.contains(name)
    }


    fun exec_stmt(var self, s: Stmt) {
        match s.kind {
            StmtKind.ExprStmt(e) => { self.eval(e) },
            StmtKind.VarDecl(kind, name, ty, init) => {
                let v = self.eval(init)
                self.define(name, v)
            },
            StmtKind.DestructDecl(kind, binding, ty, init) => {
                let v = self.eval(init)
                if self.stop() { return }           // `?` returned early: nothing to bind
                self.bind_destructure(bind_elems(binding), v)
            },
            StmtKind.Assign(target, value) => {
                let v = self.eval(value)            // the value first, as in Python
                let p = self.place_of(target)
                self.write_place(p, v)
            },
            StmtKind.ReturnS(v, tail) => {
                if tail {
                    match v { Some(ex) => { self.exec_become(ex) }, None => {} }
                    return
                }
                var rv = Value.VUnit
                match v { Some(ex) => { rv = self.eval(ex) }, None => {} }
                if !self.stop() { self.ctrl = Ctrl.CReturn
                    self.ctrl_val = rv }
            },
            StmtKind.IfS(cond, then, otherwise) => { self.exec_if(cond, then, otherwise) },
            StmtKind.WhileS(cond, body) => { self.exec_while(cond, body) },
            StmtKind.ForS(var_name, start, end, body, iter) => { self.exec_for(var_name, start, end, body, iter) },
            StmtKind.BreakS => { self.ctrl = Ctrl.CBreak },
            StmtKind.ContinueS => { self.ctrl = Ctrl.CContinue },
            StmtKind.DeferS(body) => {
                let top = self.scopes.len() - 1
                self.scopes[top].defers.push(Deferral { body: body, names: self.scopes[top].names.len() })
            },
        }
    }

    fun exec_if(var self, cond: Expr, then: Block, otherwise: Option<ElseTail>) {
        if as_bool(self.eval(cond)) { self.exec_block(then)
            return }
        match otherwise {
            Some(et) => { self.exec_else(et) },
            None => {},
        }
    }

    fun exec_else(var self, et: ElseTail) {
        match et {
            ElseTail.ElseBlock(b) => { self.exec_block(b) },
            ElseTail.ElseIf(s2) => { self.exec_stmt(s2) },
        }
    }

    fun exec_while(var self, cond: Expr, body: Block) {
        while as_bool(self.eval(cond)) {
            self.exec_block(body)
            match self.ctrl {
                Ctrl.CContinue => { self.ctrl = Ctrl.CNone },
                Ctrl.CBreak => { self.ctrl = Ctrl.CNone
                    return },
                Ctrl.CNone => {},
                _ => { return },
            }
        }
    }

    fun exec_for(var self, var_name: str, start: Option<Expr>, end: Option<Expr>, body: Block, iter: Option<Expr>) {
        match iter {
            Some(it) => {
                let v = self.eval(it)
                match v {
                    Value.VStr(s) => {
                        // a string's characters decoded as the loop goes,
                        // without the list `s.chars()` makes (MYLA-318)
                        var i = 0
                        while i < s.len() {
                            let r = utf8_at(s, i)
                            if !self.loop_iteration(var_name, Value.VChar(r & 0xFFFFFFFF), body) { return }
                            i = i + ((r >> 32) as int32)
                        }
                        return
                    },
                    _ => {},
                }
                for item in self.iter_items(v) {
                    if !self.loop_iteration(var_name, item, body) { return }
                }
            },
            None => {
                // an integer range runs without materializing its values
                var lo: int64 = 0
                var hi: int64 = 0
                match start { Some(s) => { lo = as_int(self.eval(s)) }, None => {} }
                match end { Some(e) => { hi = as_int(self.eval(e)) }, None => {} }
                var k = lo
                while k < hi {
                    if !self.loop_iteration(var_name, Value.VInt(k), body) { return }
                    k = k + 1
                }
            },
        }
    }

    // Run one iteration of a `for` body with the loop variable bound to `v`;
    // false when the loop ends (break, return, `?`, exit or a runtime error).
    #test(interp_on("fun main() { print(1 + 2) }"), "v", Value.VInt(4), block_of("{ }"))[true]
    fun loop_iteration(var self, var_name: str, v: Value, body: Block) -> bool {
        if self.stop() { return false }
        self.push_scope()
        self.define(var_name, v)
        self.exec_block(body)
        self.pop_scope()
        return match self.ctrl {
            Ctrl.CContinue => {
                self.ctrl = Ctrl.CNone
                true
            },
            Ctrl.CBreak => {
                self.ctrl = Ctrl.CNone
                false
            },
            Ctrl.CNone => true,
            _ => false,
        }
    }

    #test(interp_on("[int]"), Value.VList([]))[[]]
    fun iter_items(self, v: Value) -> [Value] {
        return match v {
            Value.VList(xs) => xs,
            Value.VMap(m) => map_keys_of(m),
            // (an async function's loop holds its items: a string's
            // characters, MYLA-318)
            Value.VStr(s) => match decode_chars(s) { Value.VList(cs) => cs, _ => empty_values() },
            _ => empty_values(),
        }
    }

    // -- lvalues / destructuring -----------------------------------------

    fun bind_destructure(var self, b: [BindElem], v: Value) {
        let elems = match v { Value.VTuple(es) => es, _ => empty_values() }
        var i = 0
        while i < b.len() {
            self.bind_elem(b[i], elems[i])
            i = i + 1
        }
    }

    fun bind_elem(var self, b: BindElem, v: Value) {
        match b {
            BindElem.BName(n, l, c, sp) => { self.define(n, v) },
            BindElem.BWild => {},
            BindElem.BTuple(sub, l, c, sp) => {
                let elems = match v { Value.VTuple(es) => es, _ => empty_values() }
                var i = 0
                while i < sub.len() {
                    self.bind_elem(sub[i], elems[i])
                    i = i + 1
                }
            },
        }
    }

    // -- expressions ------------------------------------------------------

    #test(interp_on("[int]"), Expr { id: 12, line: 9, col: 12, sp: SrcSpan { sline: 9, scol: 12, eline: 9, ecol: 13 }, kind: ExprKind.Name("a") })[Value.VUnit]
    fun eval(var self, e: Expr) -> Value {
        if self.stop() { return Value.VUnit }
        return match e.kind {
            ExprKind.StrLit(s) => Value.VStr(s),
            ExprKind.IntLit(v, suf, isc, big) => self.eval_int_lit(e, v, isc),
            ExprKind.FloatLit(lex, suf) => self.eval_float_lit(e, lex),
            ExprKind.BoolLit(b) => Value.VBool(b),
            ExprKind.Name(n) => self.eval_name(e, n),
            ExprKind.Unary(op, x) => self.eval_unary(e, op, x),
            ExprKind.Binary(op, l, r) => self.eval_binary(e, op, l, r),
            ExprKind.Call(c, args, _) => self.eval_call(e, c, args),
            ExprKind.Cast(x, ty) => self.eval_cast(e, x),
            ExprKind.GetField(tgt, field) => self.eval_getfield(e, tgt, field),
            ExprKind.TupleLit(elems) => self.eval_tuple_lit(elems),
            ExprKind.TupleIndex(tgt, idx) => self.eval_tuple_index(tgt, idx),
            ExprKind.ListLit(elems) => self.eval_list_lit(elems),
            ExprKind.MapLit(entries) => self.eval_map_lit(entries),
            ExprKind.Index(tgt, idx) => self.eval_index(e, tgt, idx),
            ExprKind.StructLit(name, fields) => self.eval_struct_lit(name, fields),
            ExprKind.MatchE(scrut, arms) => self.eval_match(scrut, arms),
            ExprKind.Try(inner) => self.eval_try(inner),
            ExprKind.Lambda(params, ret, body, asy) => self.eval_lambda(params, body),
            ExprKind.Await(x) => self.eval(x),     // unreachable: the async evaluator takes `await`s
            _ => Value.VUnit,
        }
    }

    // -- match / patterns -------------------------------------------------

    fun eval_match(var self, scrut: Expr, arms: [MatchArm]) -> Value {
        let sv = self.eval(scrut)
        var i = 0
        while i < arms.len() {
            let arm = arms[i]
            let mr = self.match_pattern(arm.pattern, sv)
            if mr.ok {
                self.push_scope()
                var j = 0
                while j < mr.names.len() {
                    self.define(mr.names[j], mr.vals[j])
                    j = j + 1
                }
                var guard_ok = true
                match arm.guard { Some(g) => { guard_ok = as_bool(self.eval(g)) }, None => {} }
                if guard_ok {
                    let rv = self.eval_arm_body(arm.body)
                    self.pop_scope()
                    return rv
                }
                self.pop_scope()
            }
            i = i + 1
        }
        return Value.VUnit
    }

    #test(interp_on("[int]"), ExprOrBlock.EB_Expr(Expr { id: 57, line: 29, col: 25, sp: SrcSpan { sline: 29, scol: 25, eline: 29, ecol: 31 }, kind: ExprKind.StrLit("warm") }))[Value.VStr("warm")]
    fun eval_arm_body(var self, body: ExprOrBlock) -> Value {
        return match body {
            ExprOrBlock.EB_Expr(ex) => self.eval(ex),
            ExprOrBlock.EB_Block(b) => self.eval_block_value(b),
        }
    }

    // A block in value position (match-arm body): execute its statements; the
    // value is the trailing expression statement (if control didn't escape).
    #test(interp_on("fun main() { print(1 + 2) }"), block_of("{ }"))[Value.VUnit]
    fun eval_block_value(var self, b: Block) -> Value {
        self.push_scope()
        var result = Value.VUnit
        let n = b.stmts.len()
        var i = 0
        while i < n {
            if self.stop() { i = n }
            else {
                let s = b.stmts[i]
                if i == n - 1 {
                    match s.kind {
                        StmtKind.ExprStmt(e) => { result = self.eval(e) },
                        _ => { self.exec_stmt(s) },
                    }
                } else {
                    self.exec_stmt(s)
                }
                i = i + 1
            }
        }
        // its value first, then its deferred blocks (D135)
        self.run_defers()
        self.pop_scope()
        return result
    }

    #test(interp_on("[int]"), Pattern { id: 22, line: 18, col: 22, sp: SrcSpan { sline: 18, scol: 22, eline: 18, ecol: 23 }, kind: PatternKind.PBind("r") }, Value.VInt(2))[MatchRes { ok: true, names: ["r"], vals: [Value.VInt(2)] }]
    fun match_pattern(var self, p: Pattern, v: Value) -> MatchRes {
        return match p.kind {
            PatternKind.PWild => mr_ok(),
            PatternKind.PBind(n) => self.match_bind_or_variant(n, v),
            PatternKind.PLit(lit) => mr_bool(value_eq(self.eval(lit), v)),
            PatternKind.PEnum(en, variant, elems, has_payload) => self.match_enum(variant, elems, v),
            PatternKind.PTuple(elems) => self.match_seq(elems, i_tuple_elems(v)),
            PatternKind.PStruct(name, fps) => self.match_struct(fps, v),
            PatternKind.POr(alts) => self.match_or(alts, v),
        }
    }

    // A bare name pattern is a no-payload variant match if it names a known
    // nullary variant (the checker reclassifies these); otherwise a binding.
    #test(interp_on("[int]"), "h", Value.VInt(4))[MatchRes { ok: true, names: ["h"], vals: [Value.VInt(4)] }]
    fun match_bind_or_variant(var self, n: str, v: Value) -> MatchRes {
        match self.nullary_variant_enum(n) {
            Some(en) => {
                let info = enum_info(v)
                if info.ok && info.names[0] == n { return mr_ok() }
                return mr_fail()
            },
            None => {},
        }
        return mr_bind(n, v)
    }

    #test(interp_on("[int]"), "Empty", [], Value.VEnum("Shape", "Empty", []))[MatchRes { ok: true, names: [], vals: [] }]
    fun match_enum(var self, variant: str, elems: [Pattern], v: Value) -> MatchRes {
        let info = enum_info(v)
        if !info.ok { return mr_fail() }
        if info.names[0] != variant { return mr_fail() }
        return self.match_seq(elems, info.vals)
    }

    #test(interp_on("enum E { A, B(int) }"), [FieldPat { line: 9, col: 19, sp: SrcSpan { sline: 9, scol: 19, eline: 9, ecol: 24 }, name: "count", pattern: Pattern { id: 6, line: 9, col: 19, sp: SrcSpan { sline: 9, scol: 19, eline: 9, ecol: 24 }, kind: PatternKind.PBind("count") } }], Value.VInt(0))[MatchRes { ok: true, names: ["count"], vals: [Value.VUnit] }]
    fun match_struct(var self, fps: [FieldPat], v: Value) -> MatchRes {
        var res = mr_ok()
        var i = 0
        while i < fps.len() {
            let fv = get_field(v, fps[i].name)
            let sub = self.match_pattern(fps[i].pattern, fv)
            if !sub.ok { return mr_fail() }
            res = mr_merge(res, sub)
            i = i + 1
        }
        return res
    }

    #test(interp_on("[int]"), [], [])[MatchRes { ok: true, names: [], vals: [] }]
    fun match_seq(var self, pats: [Pattern], vals: [Value]) -> MatchRes {
        var res = mr_ok()
        var i = 0
        while i < pats.len() {
            let sub = self.match_pattern(pats[i], vals[i])
            if !sub.ok { return mr_fail() }
            res = mr_merge(res, sub)
            i = i + 1
        }
        return res
    }

    #test(interp_on("enum E { A, B(int) }"), [Pattern { id: 58, line: 30, col: 9, sp: SrcSpan { sline: 30, scol: 9, eline: 30, ecol: 14 }, kind: PatternKind.PBind("Green") }, Pattern { id: 59, line: 30, col: 17, sp: SrcSpan { sline: 30, scol: 17, eline: 30, ecol: 21 }, kind: PatternKind.PBind("Blue") }], Value.VEnum("Color", "Blue", []))[MatchRes { ok: true, names: ["Green"], vals: [Value.VEnum("Color", "Blue", [])] }]
    fun match_or(var self, alts: [Pattern], v: Value) -> MatchRes {
        var i = 0
        while i < alts.len() {
            let sub = self.match_pattern(alts[i], v)
            if sub.ok { return sub }
            i = i + 1
        }
        return mr_fail()
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[Value.VUnit]
    fun eval_try(var self, inner: Expr) -> Value {
        let v = self.eval(inner)
        return match v {
            Value.VEnum(en, vr, pl) => self.try_unwrap(v, vr, pl),
            _ => v,
        }
    }

    #test(interp_on("[int]"), Value.VEnum("Option", "None", []), "None", [])[Value.VUnit]
    fun try_unwrap(var self, v: Value, vr: str, pl: [Value]) -> Value {
        if vr == "Some" || vr == "Ok" { return pl[0] }
        // None / Err: propagate the same carrier as the function's result
        self.ctrl = Ctrl.CReturn
        self.ctrl_val = v
        return Value.VUnit
    }

    #test(interp_on("[int]"), Expr { id: 0, line: 5, col: 7, sp: SrcSpan { sline: 5, scol: 7, eline: 5, ecol: 8 }, kind: ExprKind.IntLit(1, None, false, "") }, 1, false)[Value.VInt(1)]
    fun eval_int_lit(self, e: Expr, v: int64, isc: bool) -> Value {
        if isc { return Value.VChar(v) }
        return Value.VInt(wrap_opt(v, self.resolved_of(e.id)))
    }

    #test(interp_on("[int]"), Expr { id: 10, line: 8, col: 12, sp: SrcSpan { sline: 8, scol: 12, eline: 8, ecol: 13 }, kind: ExprKind.Name("c") }, "c")[Value.VUnit]
    fun eval_name(var self, e: Expr, n: str) -> Value {
        match self.lookup(n) {
            Some(v) => { return v },
            None => {},
        }
        let ci = self.const_idx(n)
        if ci >= 0 { return self.const_vals[ci] }
        // a bare no-payload enum variant, e.g. `None` or `North`
        match self.nullary_variant_enum(n) {
            Some(en) => { return Value.VEnum(en, n, []) },
            None => {},
        }
        // a top-level function used as a value (fun-as-value)
        let fi = self.func_idx(n)
        if fi >= 0 { return Value.VClosure(empty_params(), eb_dummy(), [], [], n, true) }
        return Value.VUnit
    }

    #test(interp_on("[int]"), "h")[None]
    fun nullary_variant_enum(self, name: str) -> Option<str> {
        for d in self.decls {
            match d.kind {
                DeclKind.EnumDecl(en, variants, attrs, tps, isp) => {
                    for v in variants { if v.name == name && v.payload.len() == 0 { return Some(en) } }
                },
                _ => {},
            }
        }
        return None
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "-", expr_of("a.b[0]"))[Value.VInt(0)]
    fun eval_unary(var self, e: Expr, op: str, x: Expr) -> Value {
        let v = self.eval(x)
        if op == "!" { return Value.VBool(!as_bool(v)) }
        if op == "-" {
            match v { Value.VFloat(f) => { return Value.VFloat(-f) }, _ => {} }
            let rt = self.resolved_of(e.id)
            let i = as_int(v)
            // `-x` that doesn't fit traps (D175); a negative literal fits
            let literal = match x.kind { ExprKind.IntLit(n, suf, isc, big) => true, _ => false }
            match rt {
                Some(Type.TInt(w, s)) => {
                    if !literal && int_neg_overflows(i, w, s) {
                        self.fail(e, "integer overflow")
                        return Value.VUnit
                    }
                },
                _ => {},
            }
            return Value.VInt(wrap_opt(i.wrapping_neg(), rt))
        }
        // "~"
        return Value.VInt(wrap_opt(~as_int(v), self.resolved_of(e.id)))
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "*", expr_of("a.b[0]"), expr_of("a.b[0]"))[Value.VInt(0)]
    fun eval_binary(var self, e: Expr, op: str, l: Expr, r: Expr) -> Value {
        if op == "&&" {
            if !as_bool(self.eval(l)) { return Value.VBool(false) }
            return Value.VBool(as_bool(self.eval(r)))
        }
        if op == "||" {
            if as_bool(self.eval(l)) { return Value.VBool(true) }
            return Value.VBool(as_bool(self.eval(r)))
        }
        let lv = self.eval(l)
        let rv = self.eval(r)
        let rt = self.resolved_of(e.id)
        // function composition: `f >> g` when the left operand is callable
        if op == ">>" && is_callable(lv) { return compose_values(lv, rv) }
        // operator overloading: dispatch to a trait method for user types
        if i_is_struct_or_enum(lv) { return self.eval_op_overload(op, lv, rv) }
        // string concatenation (`==`/`!=` on strings compare, below)
        if op == "+" && is_vstr(lv) { return Value.VStr(as_str(lv) + as_str(rv)) }
        // comparisons -> bool (a tuple's or list's elements each as `==`
        // compares them, D163)
        if op == "==" { return Value.VBool(self.values_equal(lv, rv)) }
        if op == "!=" { return Value.VBool(!self.values_equal(lv, rv)) }
        if is_cmp_op(op) {
            if is_u64(self.resolved_of(l.id)) { return Value.VBool(ucompare(op, as_int(lv), as_int(rv))) }
            return Value.VBool(self.compare(op, lv, rv))
        }
        // float arithmetic
        var is_float_op = false
        match lv { Value.VFloat(f) => { is_float_op = true }, _ => {} }
        if is_float_op {
            let a = as_float(lv)
            let b = as_float(rv)
            var f = 0.0f64
            if op == "+" { f = a + b }
            else if op == "-" { f = a - b }
            else if op == "*" { f = a * b }
            else if op == "/" { f = a / b }
            else { f = a % b }
            return Value.VFloat(round_float(f, rt))
        }
        // integer arithmetic / bitwise / shift
        let a = as_int(lv)
        let b = as_int(rv)
        var res: int64 = 0
        // an operation whose result doesn't fit its integer type traps
        // (D175): `+`, `-`, `*` and the signed minimum `/ -1`; a shift's
        // count must be below the width (`w` is 0 for a char's `c + n`,
        // checked as a char below)
        let (w, sg) = match rt { Some(Type.TInt(n, s)) => (n, s), _ => (0, false) }
        var over = false
        if op == "+" {
            res = a.wrapping_add(b)
            over = w > 0 && add_overflows(a, b, res, w, sg)
        } else if op == "-" {
            res = a.wrapping_sub(b)
            over = w > 0 && sub_overflows(a, b, res, w, sg)
        } else if op == "*" {
            res = a.wrapping_mul(b)
            over = w > 0 && mul_overflows(a, b, res, w, sg)
        } else if op == "/" {
            if b == 0 {
                self.fail(e, "division by zero")
                return Value.VUnit
            }
            if sg && b == -1 && a == int_min(w) {
                self.fail(e, "integer overflow")
                return Value.VUnit
            }
            if is_u64(rt) { res = ((a as uint64) / (b as uint64)) as int64 } else { res = idiv(a, b) }
        }
        else if op == "%" {
            if b == 0 {
                self.fail(e, "modulo by zero")
                return Value.VUnit
            }
            if is_u64(rt) { res = ((a as uint64) % (b as uint64)) as int64 } else { res = imod(a, b) }
        }
        else if op == "&" { res = a & b }
        else if op == "|" { res = a | b }
        else if op == "^" { res = a ^ b }
        else if op == "<<" || op == ">>" {
            if w > 0 && shift_out_of_range(b, w) {
                self.fail(e, "shift amount out of range")
                return Value.VUnit
            }
            res = if op == "<<" { a << shift_count(b, rt) } else { shr_typed(a, b, rt) }
        }
        if over {
            self.fail(e, "integer overflow")
            return Value.VUnit
        }
        // `c + n`, `c - n`: a char again, as a cast to char checks it
        // (MYLA-318; the sum wraps as an int32 does natively)
        if is_char_type(rt) {
            let cp = wrap_opt(res, Some(Type.TInt(32, true)))
            if cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343) {
                self.fail(e, format("invalid char: {} is not a Unicode scalar value", cp))
                return Value.VUnit
            }
            return Value.VChar(cp)
        }
        return Value.VInt(wrap_opt(res, rt))
    }

    // `x.wrapping_add(y)` and the other wrapping methods (D175): modulo
    // 2^width, never an overflow.
    fun eval_wrapping(var self, e: Expr, nm: str, args: [Expr]) -> Value {
        return self.eval_wrapping_on(e, nm, args[0], args[1:])
    }

    // `recv.nm(rest)`, a wrapping method on the integer `recv`.
    fun eval_wrapping_on(var self, e: Expr, nm: str, recv: Expr, rest: [Expr]) -> Value {
        let a = as_int(self.eval(recv))
        var res: int64 = 0
        if rest.len() == 0 { res = a.wrapping_neg() }
        else {
            let b = as_int(self.eval(rest[0]))
            if nm == "wrapping_add" { res = a.wrapping_add(b) }
            else if nm == "wrapping_sub" { res = a.wrapping_sub(b) }
            else { res = a.wrapping_mul(b) }
        }
        return Value.VInt(wrap_opt(res, self.resolved_of(e.id)))
    }

    #test(interp_on("[int]"), "<", Value.VInt(0), Value.VInt(3))[true]
    fun compare(self, op: str, lv: Value, rv: Value) -> bool {
        match lv {
            Value.VFloat(f) => { return fcompare(op, f, as_float(rv)) },
            _ => {},
        }
        var c = 0
        match lv {
            Value.VStr(s) => { c = scmp(as_str(lv), as_str(rv)) },
            Value.VChar(ch) => { c = icmp(as_int(lv), as_int(rv)) },
            _ => { c = icmp(as_int(lv), as_int(rv)) },
        }
        if op == "<" { return c < 0 }
        if op == "<=" { return c <= 0 }
        if op == ">" { return c > 0 }
        return c >= 0
    }

    // A float literal's value: the correctly rounded double of its text, and
    // for a float32 that rounded again to single precision (MYLA-29).
    #test(interp_on("[int]"), Expr { id: 0, line: 3, col: 8, sp: SrcSpan { sline: 3, scol: 8, eline: 3, ecol: 14 }, kind: ExprKind.FloatLit("2.0f64", Some("f64")) }, "2.0f64")[Value.VFloat(2.0)]
    fun eval_float_lit(self, e: Expr, lex: str) -> Value {
        var bits = f64_literal_bits(lex)
        if is_float32_type(self.resolved_of(e.id)) { bits = f32_round_bits(bits) }
        return Value.VFloat(float_from_bits(bits))
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"))[Value.VUnit]
    fun eval_cast(var self, e: Expr, x: Expr) -> Value {
        let v = self.eval(x)
        let src = self.resolved_of(x.id)
        let tgt = self.resolved_of(e.id)
        let r = cast_value(v, src, tgt)
        // a char is a Unicode scalar: anything else traps (MYLA-177)
        let to_char = match tgt { Some(tt) => match tt { Type.TChar => true, _ => false }, None => false }
        let from_char = match src { Some(st) => match st { Type.TChar => true, _ => false }, None => false }
        if to_char && !from_char {
            let cp = as_int(v)
            if cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343) {
                self.fail(e, format("invalid char: {} is not a Unicode scalar value", cp))
                return Value.VUnit
            }
        }
        return r
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), "Nil")[Value.VUnit]
    fun eval_getfield(var self, e: Expr, tgt: Expr, field: str) -> Value {
        // `Enum.Variant` (no-payload) when the target names an enum type
        match tgt.kind {
            ExprKind.Name(tn) => {
                if self.is_enum_name(tn) {
                    match self.lookup(tn) { Some(x) => {}, None => { return Value.VEnum(tn, field, []) } }
                }
            },
            _ => {},
        }
        let c = self.eval(tgt)
        return get_field(self.deref(c), field)
    }

    #test(interp_on("[int]"), [Expr { id: 43, line: 36, col: 13, sp: SrcSpan { sline: 36, scol: 13, eline: 36, ecol: 14 }, kind: ExprKind.Name("x") }])[Value.VTuple([Value.VUnit])]
    fun eval_tuple_lit(var self, elems: [Expr]) -> Value {
        var vs: [Value] = []
        for el in elems { vs.push(self.eval(el)) }
        return Value.VTuple(vs)
    }

    #test(interp_on("[int]"), Expr { id: 53, line: 41, col: 12, sp: SrcSpan { sline: 41, scol: 12, eline: 41, ecol: 13 }, kind: ExprKind.Name("t") }, 0)[Value.VUnit]
    fun eval_tuple_index(var self, tgt: Expr, idx: int64) -> Value {
        let c = self.eval(tgt)
        return match c { Value.VTuple(es) => es[idx as int32], _ => Value.VUnit }
    }

    #test(interp_on("[int]"), [])[Value.VList([])]
    fun eval_list_lit(var self, elems: [Expr]) -> Value {
        var vs: [Value] = []
        for el in elems { vs.push(self.eval(el)) }
        return Value.VList(vs)
    }

    #test(interp_on("[int]"), "Name", [FieldInit { line: 54, col: 20, sp: SrcSpan { sline: 54, scol: 20, eline: 54, ecol: 27 }, name: "text", value: Expr { id: 96, line: 54, col: 26, sp: SrcSpan { sline: 54, scol: 26, eline: 54, ecol: 27 }, kind: ExprKind.Name("a") } }])[Value.VStruct("Name", ["text"], [Value.VUnit])]
    fun eval_struct_lit(var self, name: str, fields: [FieldInit]) -> Value {
        var names: [str] = []
        var vals: [Value] = []
        for f in fields {
            names.push(f.name)
            vals.push(self.eval(f.value))
        }
        if self.is_actor_type(name) {     // starts the actor (D89)
            self.actors.push(Value.VStruct(name, names, vals))
            return Value.VActor(self.actors.len() - 1)
        }
        return Value.VStruct(name, names, vals)
    }

    // `[k: v, …]`: a key given again replaces the value and keeps the
    // first one's place, as `m[k] = v` would.
    #test(interp_on("[int]"), [])[Value.VMap(new_mapv())]
    fun eval_map_lit(var self, entries: [MapEntry]) -> Value {
        var m = new_mapv()
        for en in entries {
            let k = self.eval(en.key)
            let (found, h) = self.key_place(m, k)
            var j = found
            if j < 0 { j = m.add_key(k, h) }
            m.vs[j] = self.eval(en.value)
        }
        return Value.VMap(m)
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), expr_of("a.b[0]"))[Value.VUnit]
    fun eval_index(var self, e: Expr, tgt: Expr, idx: Expr) -> Value {
        let c = self.eval(tgt)
        if is_slice_expr(idx) { return self.eval_slice(e, c, idx) }
        let k = self.index_value(c, idx)
        if self.stop() || !self.check_index(c, k, e, false) { return Value.VUnit }
        return index_get(c, k, self.place_in(c, k))
    }

    // An index's value: `^n` counted from the end of `c` (D142).
    fun index_value(var self, c: Value, idx: Expr) -> Value {
        match from_end_of(idx) {
            Some(n) => { return Value.VInt(value_len(c) - as_int(self.eval(n))) },
            None => {},
        }
        return self.eval(idx)
    }

    // A slice of the list or string `c` (D142, D143): the indices std.slice
    // gives, the same as native code takes.
    fun eval_slice(var self, e: Expr, c: Value, idx: Expr) -> Value {
        let p = slice_parts(idx)
        let a = self.bound_value(p.start)
        let b = self.bound_value(p.stop)
        var step: int64 = 1
        if !is_hole_part(p.step) { step = as_int(self.eval(p.step)) }
        if self.stop() { return Value.VUnit }
        // a plain negative bound is an error, as a negative index is (D154)
        if (a.1 && !a.2 && a.0 < 0) || (b.1 && !b.2 && b.0 < 0) {
            self.fail(e, "index out of bounds")
            return Value.VUnit
        }
        if step == 0 {
            self.fail(e, "slice step is zero")
            return Value.VUnit
        }
        match c {
            Value.VStr(s) => {
                if !str_whole(s, a.0, a.1, a.2, b.0, b.1, b.2, step) {
                    self.fail(e, "a slice bound inside a character")
                    return Value.VUnit
                }
                return Value.VStr(take_str(s, a.0, a.1, a.2, b.0, b.1, b.2, step))
            },
            Value.VList(xs) => {
                let r = range_of(xs.len() as int64, a.0, a.1, a.2, b.0, b.1, b.2, step)
                var out: [Value] = []
                var i = r.first
                var k: int64 = 0
                while k < r.count {
                    out.push(xs[i])
                    i += r.step
                    k += 1
                }
                return Value.VList(out)
            },
            _ => {},
        }
        return Value.VUnit
    }

    // A slice's bound: its value, whether it was given, whether it counts
    // from the end.
    fun bound_value(var self, b: Expr) -> (int64, bool, bool) {
        if is_hole_part(b) { return (0, false, false) }
        match from_end_of(b) {
            Some(n) => { return (as_int(self.eval(n)), true, true) },
            None => {},
        }
        return (as_int(self.eval(b)), true, false)
    }

    #test(interp_on("[int]"), 0)[None]
    fun resolved_of(self, id: int32) -> Option<Type> {
        return self.resolved.get(id)
    }

    // -- calls ------------------------------------------------------------

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), [Expr { id: 40, line: 23, col: 22, sp: SrcSpan { sline: 23, scol: 22, eline: 23, ecol: 23 }, kind: ExprKind.Name("s") }])[Value.VUnit]
    fun eval_call(var self, e: Expr, callee: Expr, args: [Expr]) -> Value {
        // partial application: `f(a, _)` builds a closure awaiting the holes
        if i_args_have_hole(args) { return self.eval_partial(callee, args) }
        match callee.kind {
            ExprKind.Name(nm) => {
                // a local binding shadows a function or builtin of the same
                // name: the checker typed the callee as a value (MYLA-152)
                if self.resolved.contains(callee.id) {
                    match self.lookup(nm) {
                        Some(v) => { return self.call_value(v, self.eval_args(args)) },
                        None => {},
                    }
                }
                return self.eval_name_call(e, nm, args)
            },
            ExprKind.GetField(tgt, field) => {
                // `h.wrapping_mul(k)` (D175) first: hashes and digests make
                // many, and no impl can define the name on an integer
                if is_wrapping_method(field) && is_int_value_type(self.resolved_of(tgt.id)) { return self.eval_wrapping_on(e, field, tgt, args) }
                // `T.zero()`, `int.zero()`: a function of the type (D172)
                match self.static_calls.get(e.id) {
                    Some(st) => { return self.eval_static_call(e, st, field, args) },
                    None => {},
                }
                // a builtin function called as a method of its first argument
                // (`xs.push(v)` is `push(xs, v)`, D103, MYLA-221)
                if builtin_method_name(field) && self.func_idx(format("{}.{}", self.recv_key(tgt), field)) < 0 {
                    let is_builtin = match self.resolved_of(tgt.id) { Some(t) => builtin_method(t, field), None => false }
                    if is_builtin {
                        var all: [Expr] = [tgt]
                        for a in args { all.push(a) }
                        return self.eval_name_call(e, field, all)
                    }
                }
                return self.eval_getfield_call(e, tgt, field, args)
            },
            _ => {},
        }
        // indirect call on an arbitrary closure-valued expression
        return self.call_value(self.eval(callee), self.eval_args(args))
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), [Expr { id: 120, line: 59, col: 20, sp: SrcSpan { sline: 59, scol: 20, eline: 59, ecol: 21 }, kind: ExprKind.IntLit(5, None, false, "") }, Expr { id: 121, line: 59, col: 23, sp: SrcSpan { sline: 59, scol: 23, eline: 59, ecol: 24 }, kind: ExprKind.Hole }])[Value.VPartial(Value.VUnit, [Value.VInt(5), Value.VUnit], [false, true])]
    fun eval_partial(var self, callee: Expr, args: [Expr]) -> Value {
        var slots: [Value] = []
        var holes: [bool] = []
        // `recv.method(_, …)`: the method as a function value, the receiver its
        // first (filled) argument
        match callee.kind {
            ExprKind.GetField(recv, field) => {
                let mname = format("{}.{}", self.recv_key(recv), field)
                if self.func_idx(mname) >= 0 {
                    slots.push(self.eval(recv))
                    holes.push(false)
                    return self.partial_slots(Value.VClosure(empty_params(), eb_dummy(), [], [], mname, true), slots, holes, args)
                }
            },
            _ => {},
        }
        return self.partial_slots(self.eval(callee), slots, holes, args)
    }

    fun partial_slots(var self, base: Value, given_slots: [Value], given_holes: [bool], args: [Expr]) -> Value {
        var slots = given_slots
        var holes = given_holes
        for a in args {
            match a.kind {
                ExprKind.Hole => {
                    slots.push(Value.VUnit)
                    holes.push(true)
                },
                _ => {
                    slots.push(self.eval(a))
                    holes.push(false)
                },
            }
        }
        return Value.VPartial(base, slots, holes)
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), "f", [Expr { id: 240, line: 100, col: 16, sp: SrcSpan { sline: 100, scol: 16, eline: 100, ecol: 17 }, kind: ExprKind.Name("n") }])[Value.VUnit]
    fun eval_getfield_call(var self, e: Expr, tgt: Expr, field: str, args: [Expr]) -> Value {
        // `Enum.Variant(args)` constructor when the target names an enum type
        match tgt.kind {
            ExprKind.Name(tn) => {
                if self.is_enum_name(tn) && !self.has_local(tn) {
                    return Value.VEnum(tn, field, self.eval_args(args))
                }
            },
            _ => {},
        }
        // otherwise a method call `recv.method(args)`
        return self.eval_method_call(e, tgt, field, args)
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), "get", [])[Value.VUnit]
    fun eval_method_call(var self, e: Expr, recv: Expr, method: str, args: [Expr]) -> Value {
        // a temporary whose type is a type parameter (`x.scaled(2).area()`
        // with `x: T`) has no type to key by and no place to read again:
        // evaluated once, keyed by its value (MYLA-391)
        if !self.key_by_type(recv) {
            let rv = self.eval(recv)
            if self.stop() { return Value.VUnit }
            let vfi = self.func_idx(format("{}.{}", value_key(rv), method))
            if vfi >= 0 {
                let argv = self.eval_args(args)
                if self.stop() { return Value.VUnit }
                return self.call_method(vfi, rv, argv).0
            }
        }
        let key = self.recv_key(recv)
        // a derived `eq` has no body: structural equality, as `==` (MYLA-132)
        if self.derived_eq(key, method, args) {
            let a = self.eval(recv)
            let b = self.eval(args[0])
            return Value.VBool(value_eq(a, b))
        }
        let fi = self.func_idx(format("{}.{}", key, method))
        if fi < 0 && method == "hash" && args.len() == 1 {
            // a tuple's `hash` is the language's (D163): its elements' in turn
            let rv = self.eval(recv)
            match rv {
                Value.VTuple(es) => {
                    let h = self.eval(args[0])
                    if self.stop() { return Value.VUnit }
                    return self.hash_all(es, h)
                },
                Value.VUnit => { return self.eval(args[0]) },
                _ => {},
            }
        }
        if fi >= 0 {
            // the receiver first (once), then the arguments, as in Python;
            // an actor's handle is passed as it is: its methods change the actor
            if self.method_is_var_self(fi) && !self.is_actor_type(key) {
                // The receiver's value moves into the call, so the method can
                // change it in place (MYLA-74): its place (indices once)
                // first, then the arguments, then its value, which keeps what
                // the arguments changed in it (`c.add(c.bump_get())`, as the
                // Python interpreter and native code do); the final `self` is
                // stored back after.
                let p = self.place_of(recv)
                let argv = self.eval_args(args)
                if self.stop() { return Value.VUnit }
                self.receivers.push(self.read_place(p))
                if self.place_valid(p) { self.update_place(p, PlaceOp.OSet(Value.VUnit)) }
                self.bind_next(fi, e.id, self.resolved_of(recv.id))
                let (rv, final_self) = self.call_with_receiver(fi, argv)
                self.write_place(p, final_self)
                // an async body deferred: its `self` goes back here when it ends
                match self.deferred { Some(d) => { self.deferred_place = Some(p) }, None => {} }
                return rv
            }
            let rv0 = self.eval(recv)
            let argv = self.eval_args(args)
            if self.stop() { return Value.VUnit }
            self.bind_next(fi, e.id, self.resolved_of(recv.id))
            let (rv, fs) = self.call_method(fi, rv0, argv)
            return rv
        }
        // not a method: a struct field holding a closure, called indirectly
        let fv = get_field(self.eval(recv), method)
        return self.call_value(fv, self.eval_args(args))
    }

    // The hasher `h` given each of `xs` in turn, through its type's `hash`
    // (a tuple's its elements', D163).
    fun hash_all(var self, xs: [Value], h: Value) -> Value {
        var g = h
        for x in xs {
            match x {
                Value.VTuple(es) => { g = self.hash_all(es, g) },
                Value.VUnit => {},
                _ => {
                    let (rv, fs) = self.call_method(self.func_idx(value_key(x) + ".hash"), x, [g])
                    g = rv
                },
            }
            if self.stop() { return Value.VUnit }
        }
        return g
    }

    // `P.f(args)` on the type `st` (D172), a type parameter's the type the
    // running function's frame binds it to: the function of that type's
    // impl, its impl's type parameters solved by the type.
    fun eval_static_call(var self, e: Expr, st: Type, field: str, args: [Expr]) -> Value {
        let t = self.env_type(st)
        let fi = self.func_idx(format("{}.{}", type_key_of(t), field))
        let argv = self.eval_args(args)
        if self.stop() { return Value.VUnit }
        if fi < 0 {
            self.fail(e, format("type '{}' has no function '{}'", type_name(t), field))
            return Value.VUnit
        }
        self.bind_next(fi, e.id, Some(t))
        return self.call_func(fi, argv)
    }

    // `t` with the type parameters the frames in scope bind (D172).
    #test(interp_on("[int]"), Type.TParam("T"))[Type.TParam("T")]
    #test(interp_on("[int]"), Type.TStr)[Type.TStr]
    fun env_type(self, t: Type) -> Type {
        if !self.type_env { return t }
        var sub: [Subst] = []
        var i = self.scopes.len() - 1
        while i >= 0 {
            var j = self.scopes[i].names.len() - 1
            while j >= 0 {
                let n = self.scopes[i].names[j]
                if n.len() > 2 && n[0] == '%' && n[1] == ':' {
                    match self.scopes[i].vals[j] {
                        Value.VInt(k) => { sub.push(Subst { name: n[2:], ty: self.types[k as int32] }) },
                        _ => {},
                    }
                }
                j -= 1
            }
            i -= 1
        }
        if sub.len() == 0 { return t }
        return subst_type(t, sub)
    }

    // What the frame of function `fi`, called by the call `id` (on a value
    // or a type of type `self_t`), binds its type parameters to: the
    // checker's type arguments of the call, else those the receiver's type
    // gives its impl's (D172); in the caller's frame, before the call.
    #test(interp_on("[int]"), -1, 0, None)[None]
    fun env_of(self, fi: int32, id: int32, self_t: Option<Type>) -> Option<[Subst]> {
        if !self.type_env || fi < 0 || self.tparams[fi].len() == 0 { return None }
        let tps = self.tparams[fi]
        var sub: [Subst] = []
        match self.call_types.get(id) {
            Some(ts) => {
                var i = 0
                while i < tps.len() && i < ts.len() {
                    sub.push(Subst { name: tps[i], ty: self.env_type(ts[i]) })
                    i += 1
                }
            },
            None => {
                match self_t {
                    Some(st) => {
                        match self.impl_selfs.get(self.func_names[fi]) {
                            Some(pat) => { sub = unify_param(pat, self.env_type(st), []).subst },
                            None => {},
                        }
                    },
                    None => {},
                }
            },
        }
        return Some(sub)
    }

    fun bind_next(var self, fi: int32, id: int32, self_t: Option<Type>) {
        if self.type_env {
            self.env_next = self.env_of(fi, id, self_t)
            self.env_fi = fi
        }
    }

    // Bind the type parameters `env_next` gives in the frame of function
    // `fi` just made.
    fun bind_types(var self, fi: int32) {
        if !self.type_env { return }
        let next = self.env_next
        self.env_next = None
        if self.env_fi != fi { return }
        match next {
            Some(sub) => {
                for b in sub {
                    let tn = type_name(b.ty)
                    var k = -1
                    match self.type_ix.get(tn) {
                        Some(x) => { k = x },
                        None => {
                            k = self.types.len()
                            self.types.push(b.ty)
                            self.type_ix[tn] = k
                        },
                    }
                    self.define("%:" + b.name, Value.VInt(k as int64))
                }
            },
            None => {},
        }
    }

    // The runtime method-dispatch key for a receiver: its checker-resolved type
    // key when known (needed for builtins like int), else the value's own tag.
    #test(interp_on("[int]"), Expr { id: 116, line: 57, col: 5, sp: SrcSpan { sline: 57, scol: 5, eline: 57, ecol: 6 }, kind: ExprKind.Name("c") })[""]
    fun recv_key(self, recv: Expr) -> str {
        match self.resolved_of(recv.id) {
            Some(t) => {
                var k = type_key_of(t)
                // a type parameter's, the type its frame binds (D172)
                if k == "" && self.type_env { k = type_key_of(self.env_type(t)) }
                if k != "" { return k }
            },
            None => {},
        }
        return value_key(self.eval_pure(recv))
    }

    // Whether `recv_key` finds `recv`'s key without evaluating a call: its
    // type names one, its frame binds its type parameter, or it is a name or
    // a field of one (`eval_pure`).
    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b"))[true]
    fun key_by_type(self, recv: Expr) -> bool {
        match self.resolved_of(recv.id) {
            Some(t) => {
                if type_key_of(t) != "" { return true }
                if self.type_env && type_key_of(self.env_type(t)) != "" { return true }
            },
            None => {},
        }
        return match recv.kind {
            ExprKind.Name(n) => true,
            ExprKind.GetField(t, f) => self.key_by_type(t),
            _ => false,
        }
    }

    #test(interp_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[Value.VUnit]
    fun eval_pure(self, recv: Expr) -> Value {
        // a non-mutating receiver evaluation for key derivation only
        return match recv.kind {
            ExprKind.Name(n) => self.lookup_or_unit(n),
            // a field of one, such as `self.inner` whose type is a type
            // parameter: its value's tag (MYLA-365)
            ExprKind.GetField(t, f) => get_field(self.eval_pure(t), f),
            _ => Value.VUnit,
        }
    }

    #test(interp_on("[int]"), "b")[Value.VUnit]
    fun lookup_or_unit(self, n: str) -> Value {
        match self.lookup(n) { Some(v) => { return v }, None => {} }
        return Value.VUnit
    }

    #test(interp_on("fun k(f: (int) -> int) -> int { return f(2) }; fun z() -> int { return k((x: int) => x + 1) }"), 1)[false]
    fun method_is_var_self(self, fi: int32) -> bool {
        return match self.func_decls[fi].receiver { Some(r) => r == "var self", None => false }
    }

    #test(interp_on("fun k(f: (int) -> int) -> int { return f(2) }; fun z() -> int { return k((x: int) => x + 1) }"), 1, Value.VStruct("Counter", ["n"], [Value.VInt(4)]), [])[(Value.VInt(3), Value.VStruct("Counter", ["n"], [Value.VInt(4)]))]
    fun call_method(var self, fi: int32, recv_val: Value, argv: [Value]) -> (Value, Value) {
        self.receivers.push(recv_val)
        return self.call_with_receiver(fi, argv)
    }

    // Call method `fi` on the receiver on top of `self.receivers`, which
    // moves into the method's `self`; yields the result and the final `self`.
    fun call_with_receiver(var self, fi: int32, argv: [Value]) -> (Value, Value) {
        if self.stop() { return Value.VUnit, self.receivers.pop() }   // as call_func (MYLA-366)
        if !self.enter_call() { return Value.VUnit, self.receivers.pop() }
        let saved = self.scopes
        self.enter_method(fi, argv)
        // `become self.m(…)` with a `var self` method goes on with this `self`
        // (the checker allows no other receiver), so the final `self` is that
        // of the last of them
        while self.becoming() && self.tail_on_self() {
            self.ctrl = Ctrl.CNone
            let t = self.tail
            self.tail = TailCall.TNone
            self.env_next = self.env_tail
            self.env_fi = self.env_tail_fi
            self.env_tail = None
            match t {
                TailCall.TSelfMethod(next, args) => {
                    self.receivers.push(self.lookup_or_unit("self"))
                    self.enter_method(next, args)
                },
                _ => {},
            }
        }
        let final_self = self.lookup_or_unit("self")
        let rv = self.run_tail()
        self.scopes = saved
        self.depth = self.depth - 1
        return rv, final_self
    }

    // One call deeper; past MAX_CALL_DEPTH a runtime error, as the Python
    // interpreter's `stack overflow`, instead of running out of native stack
    // (MYLA-182) and false.
    #test(interp_on("[int]"))[true]
    fun enter_call(var self) -> bool {
        if self.depth >= MAX_CALL_DEPTH {
            if !self.stop() {
                self.rt_err = Some(RtError { msg: "stack overflow", line: 0, col: 0, sp: no_span(), node: -1 })
                self.ctrl = Ctrl.CExit
                self.exit_code = 1
            }
            return false
        }
        self.depth = self.depth + 1
        return true
    }

    #test(interp_on("[int]"))[false]
    fun tail_on_self(self) -> bool {
        return match self.tail { TailCall.TSelfMethod(fi, args) => true, _ => false }
    }

    // -- `become` (D87) ---------------------------------------------------

    // `become call`: the callee and the arguments, evaluated as a call's
    // would be, left pending for run_tail.
    fun exec_become(var self, ex: Expr) {
        // a derived `eq` is the interpreter's own comparison, which returns
        match ex.kind {
            ExprKind.Call(callee, args, _) => {
                match callee.kind {
                    ExprKind.GetField(tgt, field) => {
                        if self.derived_eq(self.recv_key(tgt), field, args) {
                            let v = self.eval(ex)
                            if !self.stop() {
                                self.ctrl = Ctrl.CReturn
                                self.ctrl_val = v
                            }
                            return
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        let t = match ex.kind {
            ExprKind.Call(callee, args, _) => self.tail_call(callee, args),
            _ => TailCall.TNone,
        }
        if self.type_env {
            // the callee's type parameters, which its frame binds (D172)
            let recv_t = match ex.kind {
                ExprKind.Call(callee, args, _) => match callee.kind { ExprKind.GetField(tgt, f) => self.resolved_of(tgt.id), _ => None },
                _ => None,
            }
            self.env_tail = None
            match t {
                TailCall.TFunc(fi, argv) => {
                    self.env_tail = self.env_of(fi, ex.id, None)
                    self.env_tail_fi = fi
                },
                TailCall.TMethod(fi, rv, argv) => {
                    self.env_tail = self.env_of(fi, ex.id, recv_t)
                    self.env_tail_fi = fi
                },
                TailCall.TSelfMethod(fi, argv) => {
                    self.env_tail = self.env_of(fi, ex.id, recv_t)
                    self.env_tail_fi = fi
                },
                _ => {},
            }
        }
        if !self.stop() {
            self.ctrl = Ctrl.CBecome
            self.tail = t
        }
    }

    fun tail_call(var self, callee: Expr, args: [Expr]) -> TailCall {
        match callee.kind {
            ExprKind.Name(nm) => {
                // a local binding shadows a function of the same name (MYLA-102)
                match self.lookup(nm) {
                    Some(v) => { return TailCall.TValue(v, self.eval_args(args)) },
                    None => {},
                }
                return TailCall.TFunc(self.func_idx(nm), self.eval_args(args))
            },
            ExprKind.GetField(tgt, field) => {
                let fi = self.func_idx(format("{}.{}", self.recv_key(tgt), field))
                if fi >= 0 {
                    if self.method_is_var_self(fi) { return TailCall.TSelfMethod(fi, self.eval_args(args)) }
                    let rv0 = self.eval(tgt)
                    return TailCall.TMethod(fi, rv0, self.eval_args(args))
                }
                // a struct field holding a closure
                let fv = get_field(self.eval(tgt), field)
                return TailCall.TValue(fv, self.eval_args(args))
            },
            _ => {},
        }
        return TailCall.TValue(self.eval(callee), self.eval_args(args))
    }

    // Run the calls `become` leaves pending one after another in this loop,
    // instead of recursing, and yield the last one's result.
    #test(interp_on("[int]"))[Value.VUnit]
    fun run_tail(var self) -> Value {
        while self.becoming() {
            self.ctrl = Ctrl.CNone
            let t = self.tail
            self.tail = TailCall.TNone
            self.env_next = self.env_tail
            self.env_fi = self.env_tail_fi
            self.env_tail = None
            match t {
                TailCall.TFunc(fi, argv) => { self.enter_func(fi, argv) },
                TailCall.TMethod(fi, recv, argv) => {
                    self.receivers.push(recv)
                    self.enter_method(fi, argv)
                },
                TailCall.TSelfMethod(fi, argv) => {
                    self.receivers.push(self.lookup_or_unit("self"))
                    self.enter_method(fi, argv)
                },
                TailCall.TValue(v, argv) => { self.enter_value(v, argv) },
                TailCall.TNone => {},
            }
        }
        return self.take_return()
    }

    // Function `fi` in a frame of its own with its parameters: its body runs,
    // leaving its result (or the next `become`) pending.
    fun enter_func(var self, fi: int32, argv: [Value]) {
        if fi < 0 { return }
        let fd = self.func_decls[fi]
        self.scopes = []
        self.push_scope()
        self.bind_types(fi)
        var i = 0
        while i < fd.params.len() {
            self.define(fd.params[i].name, argv[i])
            i = i + 1
        }
        if self.defer && fd.is_async { self.entered_async = true }
        if self.defer_block(fd.body) { return }
        self.exec_block_body(fd.body)
    }

    // Method `fi` on the receiver on top of `self.receivers`, which moves
    // into its `self`.
    fun enter_method(var self, fi: int32, argv: [Value]) {
        let fd = self.func_decls[fi]
        self.scopes = []
        self.push_scope()
        self.bind_types(fi)
        self.define("self", self.receivers.pop())
        var i = 0
        while i < fd.params.len() {
            self.define(fd.params[i].name, argv[i])
            i = i + 1
        }
        if self.defer && fd.is_async { self.entered_async = true }
        if self.defer_block(fd.body) { return }
        self.exec_block_body(fd.body)
    }

    // The function value `v`: as call_value, but entered (a composition's
    // last function, a partial application's base) instead of called.
    fun enter_value(var self, v: Value, argv: [Value]) {
        match v {
            Value.VClosure(ps, body, cnames, cvals, fname, isfunc) => {
                if isfunc {
                    let fi = self.func_idx(fname)
                    if fi < 0 { return }
                    if is_method_name(fname) {
                        // a method value: argv[0] is the receiver
                        self.receivers.push(argv[0])
                        var rest: [Value] = []
                        var k = 1
                        while k < argv.len() {
                            rest.push(argv[k])
                            k = k + 1
                        }
                        self.enter_method(fi, rest)
                        return
                    }
                    self.enter_func(fi, argv)
                    return
                }
                self.scopes = []
                self.push_scope()
                var i = 0
                while i < cnames.len() {
                    self.define(cnames[i], cvals[i])
                    i = i + 1
                }
                var k = 0
                while k < ps.len() {
                    self.define(ps[k].name, argv[k])
                    k = k + 1
                }
                match body {
                    ExprOrBlock.EB_Expr(ex) => {
                        let rv = self.eval(ex)
                        // a `?` in the body has returned from the lambda (MYLA-72)
                        if !self.stop() {
                            self.ctrl = Ctrl.CReturn
                            self.ctrl_val = rv
                        }
                    },
                    ExprOrBlock.EB_Block(b) => { self.exec_block(b) },
                }
            },
            Value.VCompose(fs) => {
                var x = argv[0]
                var i = 0
                while i < fs.len() - 1 {
                    x = self.call_value(fs[i], [x])
                    i = i + 1
                }
                self.enter_value(fs[fs.len() - 1], [x])
            },
            Value.VPartial(base, slots, holes) => { self.enter_value(base, fill_holes(slots, holes, argv)) },
            _ => {},
        }
    }

    // Whether `recv.method(args)` calls the `eq` of a `#derive(Eq)` type.
    #test(interp_on("[int]"), "Shape", "area", [])[false]
    fun derived_eq(self, key: str, method: str, args: [Expr]) -> bool {
        return method == "eq" && args.len() == 1 && !self.has_method_body(key, "eq")
    }

    #test(interp_on("[int]"), "Vec2", "eq")[false]
    fun has_method_body(self, key: str, name: str) -> bool {
        let fi = self.func_idx(format("{}.{}", key, name))
        if fi < 0 { return false }
        return match self.func_decls[fi].body { Some(b) => true, None => false }
    }

    // `a == b` as the language has it: a struct or enum through its own `eq`
    // when one is written, else (`#derive(Eq)`, whose synthesized `eq` has
    // no body) member by member; a tuple's and a list's elements in turn
    // (D163), each compared the same way, as native code compares them.
    #test(interp_on("[int]"), Value.VTuple([Value.VInt(1), Value.VStr("a")]), Value.VTuple([Value.VInt(1), Value.VStr("a")]))[true]
    #test(interp_on("[int]"), Value.VList([Value.VInt(1)]), Value.VList([Value.VInt(1), Value.VInt(2)]))[false]
    #test(interp_on("[int]"), Value.VEnum("Color", "Red", []), Value.VEnum("Color", "Red", []))[true]
    fun values_equal(var self, a: Value, b: Value) -> bool {
        return match a {
            Value.VStruct(n, fns, fvs) => {
                if self.own_eq.contains(n) {
                    let (rr, fs) = self.call_method(self.func_idx(format("{}.eq", n)), a, [b])
                    return as_bool(rr)
                }
                match b {
                    Value.VStruct(n2, fns2, fvs2) => n == n2 && self.all_equal(fvs, fvs2),
                    _ => false,
                }
            },
            Value.VEnum(en, vr, pl) => {
                if self.own_eq.contains(en) {
                    let (rr, fs) = self.call_method(self.func_idx(format("{}.eq", en)), a, [b])
                    return as_bool(rr)
                }
                match b {
                    Value.VEnum(en2, vr2, pl2) => en == en2 && vr == vr2 && self.all_equal(pl, pl2),
                    _ => false,
                }
            },
            Value.VTuple(es) => match b {
                Value.VTuple(es2) => self.all_equal(es, es2),
                Value.VUnit => es.len() == 0,
                _ => false,
            },
            Value.VList(xs) => match b {
                Value.VList(ys) => self.all_equal(xs, ys),
                _ => false,
            },
            _ => value_eq(a, b),
        }
    }

    // Whether `a` and `b` are as long and equal element by element
    // (`values_equal`).
    fun all_equal(var self, a: [Value], b: [Value]) -> bool {
        if a.len() != b.len() { return false }
        var i = 0
        while i < a.len() {
            if !self.values_equal(a[i], b[i]) { return false }
            i = i + 1
        }
        return true
    }

    // The hash of the map key `v` (D163, MYLA-313): by its structure, as
    // `value_hash` gives it, but for a struct or enum with a `hash` written
    // for it, which is called (from a hasher of state 0). Keys `==` finds
    // equal hash equal as long as a written `hash` keeps D163's promise.
    fun key_hash(var self, v: Value) -> int64 {
        return match v {
            Value.VTuple(es) => self.keys_hash(3, es),
            Value.VList(xs) => self.keys_hash(mix_key(4, xs.len() as int64), xs),
            Value.VStruct(n, fns, fvs) => {
                if self.own_hash.contains(n) { return self.written_hash(n, v) }
                self.keys_hash(mix_key(5, str_key_hash(n)), fvs)
            },
            Value.VEnum(en, vr, pl) => {
                if self.own_hash.contains(en) { return self.written_hash(en, v) }
                self.keys_hash(mix_key(6, str_key_hash(vr)), pl)
            },
            _ => value_hash(v),
        }
    }

    // `key_hash` of each of `xs` mixed into `h` in turn.
    fun keys_hash(var self, h: int64, xs: [Value]) -> int64 {
        var g = h
        for x in xs { g = mix_key(g, self.key_hash(x)) }
        return g
    }

    // The state the `hash` written for the type `key` gives `v`.
    fun written_hash(var self, key: str, v: Value) -> int64 {
        let h0 = Value.VStruct("Hasher", ["state"], [Value.VInt(0)])
        let (rv, fs) = self.call_method(self.func_idx(key + ".hash"), v, [h0])
        return as_int(get_field(rv, "state"))
    }

    // The place of the key `k` in the map `m`, or -1, and its hash (0 for a
    // number or a string): a compound key's among those of its hash, by
    // `==` (`values_equal`).
    fun key_place(var self, m: MapV, k: Value) -> (int32, int64) {
        if is_plain_key(k) { return (m.place(k), 0) }
        let h = self.key_hash(k)
        var j = m.first_of(h)
        while j >= 0 {
            if self.values_equal(m.ks[j], k) { return (j, h) }
            j = m.nexts[j]
        }
        return (-1, h)
    }

    // The place of `k` in the map value `c` (`key_place`), -1 for none or
    // for a value that isn't a map.
    fun place_in(var self, c: Value, k: Value) -> int32 {
        return match c {
            Value.VMap(m) => self.key_place(m, k).0,
            _ => -1,
        }
    }

    // Dispatch a binary operator on a user-defined struct/enum to its trait
    // method. `==`/`!=` compare as `values_equal` does.
    #test(interp_on("[int]"), "==", Value.VEnum("Color", "Green", []), Value.VEnum("Color", "Blue", []))[Value.VBool(false)]
    fun eval_op_overload(var self, op: str, lv: Value, rv: Value) -> Value {
        let key = value_key(lv)
        if op == "==" || op == "!=" {
            let eq = self.values_equal(lv, rv)
            if op == "==" { return Value.VBool(eq) }
            return Value.VBool(!eq)
        }
        if is_cmp_op(op) {
            let (rr, fs) = self.call_method(self.func_idx(format("{}.cmp", key)), lv, [rv])
            return Value.VBool(cmp_to_bool(op, as_int(rr)))
        }
        let (rr, fs) = self.call_method(self.func_idx(format("{}.{}", key, i_arith_method(op))), lv, [rv])
        return rr
    }

    #test(interp_on("[int]"), [Expr { id: 244, line: 126, col: 19, sp: SrcSpan { sline: 126, scol: 19, eline: 126, ecol: 45 }, kind: ExprKind.StrLit("braces {{}} stay literal") }])[Value.VStr("braces {} stay literal")]
    fun eval_format(var self, args: [Expr]) -> Value {
        let fmt = as_str(self.eval(args[0]))
        let specs = format_specs(fmt)
        var parts: [str] = []
        var i = 1
        while i < args.len() {
            let v = self.eval(args[i])
            let t = self.resolved_of(args[i].id)
            parts.push(self.format_spec_value(v, t, specs[i - 1]))
            i = i + 1
        }
        return Value.VStr(render_format(fmt, parts))
    }

    // One hole's text (D139): a value of a type with its own `format`
    // through it, the spec passed as it is; else the print form, formatted by
    // the spec with std.fmt as native code does.
    fun format_spec_value(var self, v: Value, t: Option<Type>, spec: str) -> str {
        match v {
            Value.VStruct(n, fns, fvs) => { return self.user_format(v, spec) },
            Value.VEnum(en, vr, pl) => { return self.user_format(v, spec) },
            _ => {},
        }
        let text = format_typed(v, t)
        if spec == "" { return text }
        return match t {
            Some(Type.TInt(w, sg)) => fmt_int(as_int(v), w, sg, spec),
            Some(Type.TFloat(w)) => fmt_float(as_float(v), text, spec),
            _ => fmt_text(text, spec),
        }
    }

    // A value as `{}` shows it: through its `format` when its type has one,
    // else in its print form, a struct's or enum's as the report's (D162).
    fun shown(var self, v: Value, t: Option<Type>) -> str {
        match v {
            Value.VStruct(n, fns, fvs) => { if self.func_idx(format("{}.format", value_key(v))) < 0 { return without_module_ids(typed_repr(self.checker, v, t)) } },
            Value.VEnum(en, vr, pl) => { if self.func_idx(format("{}.format", value_key(v))) < 0 { return without_module_ids(typed_repr(self.checker, v, t)) } },
            _ => {},
        }
        return self.format_spec_value(v, t, "")
    }

    fun user_format(var self, v: Value, spec: str) -> str {
        let fi = self.func_idx(format("{}.format", value_key(v)))
        let (rr, fs) = self.call_method(fi, v, [Value.VStr(spec)])
        return as_str(rr)
    }

    #test(interp_on("[int]"), "List")[false]
    fun has_local(self, n: str) -> bool {
        match self.lookup(n) { Some(x) => { return true }, None => {} }
        return false
    }

    #test(interp_on("[int]"), [Expr { id: 46, line: 32, col: 21, sp: SrcSpan { sline: 32, scol: 21, eline: 32, ecol: 22 }, kind: ExprKind.Name("x") }])[[Value.VUnit]]
    fun eval_args(var self, args: [Expr]) -> [Value] {
        var argv: [Value] = []
        for a in args { argv.push(self.eval(a)) }
        return argv
    }

    // MYLA-346's socket primitives (`is_net_primitive`): the host's own,
    // each argument evaluated in order
    fun net_primitive(var self, nm: str, args: [Expr]) -> Value {
        var ints: [int32] = []
        var strs: [str] = []
        for a in args {
            match self.eval(a) {
                Value.VStr(x) => { strs.push(x) },
                v => { ints.push(as_int(v) as int32) },
            }
        }
        if self.stop() { return Value.VUnit }
        if nm == "__sock_recv" { return Value.VStr(__sock_recv(ints[0], ints[1])) }
        if nm == "__sock_recv_from" { return Value.VStr(__sock_recv_from(ints[0], ints[1])) }
        if nm == "__sock_addr" { return Value.VStr(__sock_addr(ints[0], ints[1])) }
        if nm == "__net_config" { return Value.VStr(__net_config(ints[0])) }
        var r = -1
        if nm == "__sock_open" { r = __sock_open(ints[0], ints[1]) }
        if nm == "__sock_set_nonblocking" { r = __sock_set_nonblocking(ints[0], ints[1]) }
        if nm == "__sock_bind" { r = __sock_bind(ints[0], strs[0]) }
        if nm == "__sock_listen" { r = __sock_listen(ints[0], ints[1]) }
        if nm == "__sock_accept" { r = __sock_accept(ints[0]) }
        if nm == "__sock_connect" { r = __sock_connect(ints[0], strs[0]) }
        if nm == "__sock_error" { r = __sock_error(ints[0]) }
        if nm == "__sock_send" { r = __sock_send(ints[0], strs[0], ints[1]) }
        if nm == "__sock_send_to" { r = __sock_send_to(ints[0], strs[0], strs[1]) }
        if nm == "__sock_shutdown" { r = __sock_shutdown(ints[0], ints[1]) }
        if nm == "__sock_option" { r = __sock_option(ints[0], ints[1], ints[2]) }
        if nm == "__sock_poll" { r = __sock_poll(ints[0], ints[1], ints[2]) }
        if nm == "__sock_close" { r = __sock_close(ints[0]) }
        return Value.VInt(r as int64)
    }

    // MYLA-350's terminal and signal primitives (`is_term_primitive`): the
    // host's own, so the interpreted program has the interpreter's terminal
    // and signals
    fun term_primitive(var self, nm: str, args: [Expr]) -> Value {
        let fd = as_int(self.eval(args[0])) as int32
        var mode = ""
        if nm == "__term_set" { mode = as_str(self.eval(args[1])) }
        if self.stop() { return Value.VUnit }
        if nm == "__term_get" { return Value.VStr(__term_get(fd)) }
        var r = -1
        if nm == "__term_is_tty" { r = __term_is_tty(fd) }
        if nm == "__term_size" { r = __term_size(fd) }
        if nm == "__term_set" { r = __term_set(fd, mode) }
        if nm == "__term_raw" { r = __term_raw(fd) }
        if nm == "__term_vt" { r = __term_vt(fd) }
        if nm == "__signal_listen" { r = __signal_listen(fd) }
        if nm == "__signal_take" { r = __signal_take(fd) }
        return Value.VInt(r as int64)
    }

    #test(interp_on("[int]"), Expr { id: 133, line: 83, col: 20, sp: SrcSpan { sline: 83, scol: 11, eline: 83, ecol: 22 }, kind: ExprKind.Call(Expr { id: 132, line: 83, col: 11, sp: SrcSpan { sline: 83, scol: 11, eline: 83, ecol: 20 }, kind: ExprKind.Name("page_size") }, [], []) }, "page_size", [])[Value.VUnit]
    fun eval_name_call(var self, e: Expr, nm: str, args: [Expr]) -> Value {
        if nm == "std$task$cancel" {
            match self.eval(args[0]) {
                Value.VTask(id) => { self.request_cancel(id) },
                _ => {},
            }
            return Value.VUnit
        }
        // a deadline for the child (D124, `task.timeout`), and whether it had
        // not passed
        if nm == "__cancel_after" {
            let c = self.eval(args[0])
            let ms = as_int(self.eval(args[1]))
            let rec = self.fired.len()
            self.fired.push(false)
            match c {
                Value.VTask(id) => {
                    if self.tasks[id].state != 2 { self.deadlines.push(Deadline { at: self.now() + ms * 1000000, task: id, rec: rec }) }
                },
                _ => {},
            }
            return Value.VInt(rec as int64)
        }
        if nm == "__disarm" {
            let rec = as_int(self.eval(args[0]))
            return Value.VBool(!self.fired[rec as int32])
        }
        if nm == "__task_cancelled" {
            return Value.VBool(self.cur < self.tasks.len() && self.tasks[self.cur].requested)
        }
        // std.task's notifiers (MYLA-387)
        if is_notify_primitive(nm) { return self.notify_primitive(nm, args) }
        // nothing but the turn its `await` gives (MYLA-228)
        if nm == "__yield" { return Value.VUnit }
        // the running task asleep (D124): parked until its time, which
        // `wake_sleepers` sees; outside any task, the thread asleep
        if nm == "__sleep" {
            let ms = as_int(self.eval(args[0]))
            if self.stop() { return Value.VUnit }
            if self.cur < 0 || self.cur >= self.tasks.len() {
                if ms > 0 && !self.virtual_time { __sleep_ns(ms * 1000000) }
                if ms > 0 && self.virtual_time { self.vclock = self.vclock + ms * 1000000 }
                return Value.VUnit
            }
            var d = ms
            // no time at all in a task already asked to stop
            if d < 0 || self.tasks[self.cur].requested { d = 0 }
            self.sleepers.push(Sleeper { at: self.now() + d * 1000000, seq: self.sleep_seq, task: self.cur, wait: -1 })
            self.sleep_seq = self.sleep_seq + 1
            self.tasks[self.cur].state = 1
            self.parked = true
            return Value.VUnit
        }
        if nm == "__clock_ns" { return Value.VInt(self.now()) }
        // the wall clock (MYLA-334): the host's, also under MYLA_TIME=virtual
        if nm == "__wall_ns" { return Value.VInt(__wall_ns()) }
        // waiting for input (D124): parked until `fd` is readable, unless it
        // is now or the task was asked to stop; outside any task, nothing.
        // A negative descriptor, which poll(2) ignores, is ready at once, as
        // natively, where the poller can't watch it (`wait_fds` in std.rt)
        if nm == "__wait_readable" {
            let fd = as_int(self.eval(args[0])) as int32
            if self.stop() { return Value.VUnit }
            if self.cur < 0 || self.cur >= self.tasks.len() || self.tasks[self.cur].requested || fd < 0 || __poll(fd, 0) != 0 { return Value.VUnit }
            self.fd_waits.push(FdWait { fd: fd, fd2: -1, task: self.cur, events: 0 })
            self.tasks[self.cur].state = 1
            self.parked = true
            return Value.VUnit
        }
        // waiting for a socket (MYLA-346): as for input, through the host's
        // `__sock_poll`; outside any task the thread waits in it
        if nm == "__wait_socket" {
            let h = as_int(self.eval(args[0])) as int32
            let ev = as_int(self.eval(args[1])) as int32
            if self.stop() { return Value.VUnit }
            if self.cur < 0 || self.cur >= self.tasks.len() {
                let r = __sock_poll(h, ev, -1)
                return Value.VUnit
            }
            if self.tasks[self.cur].requested || h < 0 || __sock_poll(h, ev, 0) != 0 { return Value.VUnit }
            self.fd_waits.push(FdWait { fd: h, fd2: -1, task: self.cur, events: ev })
            self.tasks[self.cur].state = 1
            self.parked = true
            return Value.VUnit
        }
        if nm == "__wait_either" {
            let fa = as_int(self.eval(args[0])) as int32
            let fb = as_int(self.eval(args[1])) as int32
            if self.stop() { return Value.VUnit }
            // (`fb` negative is "only `fa`", as natively)
            if self.cur < 0 || self.cur >= self.tasks.len() || self.tasks[self.cur].requested || fa < 0 || __poll(fa, 0) != 0 || (fb >= 0 && __poll(fb, 0) != 0) { return Value.VUnit }
            self.fd_waits.push(FdWait { fd: fa, fd2: fb, task: self.cur, events: 0 })
            self.tasks[self.cur].state = 1
            self.parked = true
            return Value.VUnit
        }
        if nm == "__sleep_ns" {
            let n = as_int(self.eval(args[0]))
            if self.stop() { return Value.VUnit }
            if self.virtual_time { self.vclock = self.vclock + n } else if n > 0 { __sleep_ns(n) }
            return Value.VUnit
        }
        if nm == "print" {
            let v = self.eval(args[0])
            if self.stop() { return Value.VUnit }
            // a struct or enum through its `format` (D159), the rest as before
            self.emit(self.format_spec_value(v, self.resolved_of(args[0].id), ""))
            self.emit("\n")
            return Value.VUnit
        }
        if nm == "__write" {
            let fd = as_int(self.eval(args[0])) as int32
            let s = as_str(self.eval(args[1]))
            if self.stop() { return Value.VUnit }
            if fd == 1 && self.testing { self.captured.push(s) }
            else { write(fd, s) }
            return Value.VUnit
        }
        if nm == "__exit" {
            let code = as_int(self.eval(args[0])) as int32
            self.ctrl = Ctrl.CExit
            self.exit_code = code
            return Value.VUnit
        }
        if nm == "__read_file" {
            return Value.VStr(__read_file(as_str(self.eval(args[0]))))
        }
        if nm == "__read" {
            let fd = as_int(self.eval(args[0])) as int32
            return Value.VStr(__read(fd, as_int(self.eval(args[1])) as int32))
        }
        // `__read` and `__write` of bytes (D177): here through a string
        if nm == "__read_bytes" {
            let fd = as_int(self.eval(args[0])) as int32
            return bytes_to_value(__str_to_bytes(__read(fd, as_int(self.eval(args[1])) as int32)))
        }
        if nm == "__write_bytes" {
            let fd = as_int(self.eval(args[0])) as int32
            var sb = StringBuilder()
            match self.eval(args[1]) {
                Value.VList(xs) => { for x in xs { sb.append_byte(as_int(x) as uint8) } },
                _ => {},
            }
            if self.stop() { return Value.VUnit }
            let s = sb.build()
            if fd == 1 && self.testing { self.captured.push(s) }
            else { write(fd, s) }
            return Value.VUnit
        }
        if nm == "__poll" {
            let fd = as_int(self.eval(args[0])) as int32
            return Value.VInt(__poll(fd, as_int(self.eval(args[1])) as int32) as int64)
        }
        if nm == "__io_errno" { return Value.VInt(__io_errno() as int64) }
        if nm == "__getcwd" { return Value.VStr(__getcwd()) }
        if nm == "__test_dir" {
            // the case's scratch root, made on the first call (D162)
            if self.test_root == "" && self.testing {
                var base = __getenv("TMPDIR")
                if base == "" { base = "/tmp" }
                let root = format("{}/myla-test-{}", base, __clock_ns())
                match make_dir_all(root) {
                    Ok(()) => { self.test_root = root },
                    Err(err) => { self.fail(e, format("test.temp_dir() could not create {}", root)) },
                }
            }
            return Value.VStr(self.test_root)
        }
        if nm == "__test_program" { return Value.VStr(self.test_program) }
        if nm == "__getenv" { return Value.VStr(__getenv(as_str(self.eval(args[0])))) }
        if nm == "__sqrt" { return Value.VFloat(__sqrt(as_float(self.eval(args[0])))) }
        if is_raw_memory_primitive(nm) {
            self.fail(e, format("'{}' reads and writes raw memory, which only native code does", nm))
            return Value.VUnit
        }
        if nm == "__f64_bits" { return Value.VInt(__f64_bits(as_float(self.eval(args[0]))) as int64) }
        if nm == "__f64_from_bits" { return Value.VFloat(__f64_from_bits(as_int(self.eval(args[0])) as uint64)) }
        if nm == "__write_file" {
            __write_file(as_str(self.eval(args[0])), as_str(self.eval(args[1])))
            return Value.VUnit
        }
        if nm == "__list_dir" { return Value.VStr(__list_dir(as_str(self.eval(args[0])))) }
        if nm == "__stat" { return Value.VInt(__stat(as_str(self.eval(args[0]))) as int64) }
        if nm == "__mkdir" {
            let path = as_str(self.eval(args[0]))
            __mkdir(path, as_int(self.eval(args[1])) as int32)
            return Value.VUnit
        }
        if nm == "__unlink" {
            __unlink(as_str(self.eval(args[0])))
            return Value.VUnit
        }
        if nm == "__rmdir" {
            __rmdir(as_str(self.eval(args[0])))
            return Value.VUnit
        }
        if nm == "__rename" {
            let from_path = as_str(self.eval(args[0]))
            __rename(from_path, as_str(self.eval(args[1])))
            return Value.VUnit
        }
        if nm == "__args" {
            var out: [Value] = []
            for a in self.argv { out.push(Value.VStr(a)) }
            return Value.VList(out)
        }
        // a child not waited for (D124): the native primitives' own
        if nm == "__spawn" {
            let prog = as_str(self.eval(args[0]))
            var argv: [str] = []
            match self.eval(args[1]) {
                Value.VList(xs) => { for x in xs { argv.push(as_str(x)) } },
                _ => {},
            }
            var out: [Value] = []
            for x in __spawn(prog, argv) { out.push(Value.VInt(x as int64)) }
            return Value.VList(out)
        }
        // `__run` and `__spawn` with D147's options: the host's own
        if nm == "__run_with" || nm == "__spawn_with" {
            let prog = as_str(self.eval(args[0]))
            var argv: [str] = []
            match self.eval(args[1]) {
                Value.VList(xs) => { for x in xs { argv.push(as_str(x)) } },
                _ => {},
            }
            var opts: [str] = []
            match self.eval(args[2]) {
                Value.VList(xs) => { for x in xs { opts.push(as_str(x)) } },
                _ => {},
            }
            if nm == "__run_with" { return bytes_to_value(__run_with(prog, argv, opts)) }
            var out: [Value] = []
            for x in __spawn_with(prog, argv, opts) { out.push(Value.VInt(x as int64)) }
            return Value.VList(out)
        }
        if nm == "__reap" { return Value.VInt(__reap(as_int(self.eval(args[0])) as int32) as int64) }
        // MYLA-336's: entropy, descriptors, a child with pipes; the host's own
        if nm == "__random_bytes" { return bytes_to_value(__random_bytes(as_int(self.eval(args[0])) as int32)) }
        if nm == "__open" {
            let path = as_str(self.eval(args[0]))
            let flags = as_int(self.eval(args[1])) as int32
            return Value.VInt(__open(path, flags, as_int(self.eval(args[2])) as int32) as int64)
        }
        if nm == "__seek" {
            let fd = as_int(self.eval(args[0])) as int32
            let offset = as_int(self.eval(args[1]))
            return Value.VInt(__seek(fd, offset, as_int(self.eval(args[2])) as int32))
        }
        if nm == "__fstat" {
            var out: [Value] = []
            for x in __fstat(as_int(self.eval(args[0])) as int32) { out.push(Value.VInt(x)) }
            return Value.VList(out)
        }
        // a string's bytes as a list and back (MYLA-369)
        if nm == "__str_to_bytes" { return bytes_to_value(__str_to_bytes(as_str(self.eval(args[0])))) }
        if nm == "__bytes_to_str" {
            match self.eval(args[0]) {
                Value.VList(xs) => {
                    var sb = StringBuilder(xs.len())
                    for x in xs { sb.append_byte(as_int(x) as uint8) }
                    return Value.VStr(sb.build())
                }
                _ => {}
            }
            return Value.VStr("")
        }
        if nm == "__path_stat" {
            let path = as_str(self.eval(args[0]))
            let follow = as_bool(self.eval(args[1]))
            var out: [Value] = []
            for x in __path_stat(path, follow) { out.push(Value.VInt(x)) }
            return Value.VList(out)
        }
        if nm == "__spawn_piped" {
            let prog = as_str(self.eval(args[0]))
            var argv: [str] = []
            match self.eval(args[1]) {
                Value.VList(xs) => { for x in xs { argv.push(as_str(x)) } },
                _ => {},
            }
            var opts: [str] = []
            match self.eval(args[2]) {
                Value.VList(xs) => { for x in xs { opts.push(as_str(x)) } },
                _ => {},
            }
            var out: [Value] = []
            for x in __spawn_piped(prog, argv, opts) { out.push(Value.VInt(x as int64)) }
            return Value.VList(out)
        }
        if is_net_primitive(nm) { return self.net_primitive(nm, args) }
        if is_term_primitive(nm) { return self.term_primitive(nm, args) }
        if nm == "__try_reap" { return Value.VInt(__try_reap(as_int(self.eval(args[0])) as int32) as int64) }
        if nm == "__close" {
            __close(as_int(self.eval(args[0])) as int32)
            return Value.VUnit
        }
        if nm == "__kill" {
            let pid = as_int(self.eval(args[0])) as int32
            __kill(pid, as_int(self.eval(args[1])) as int32)
            return Value.VUnit
        }
        if nm == "__run" {
            let prog = as_str(self.eval(args[0]))
            var argv: [str] = []
            match self.eval(args[1]) {
                Value.VList(xs) => { for x in xs { argv.push(as_str(x)) } },
                _ => {},
            }
            return bytes_to_value(__run(prog, argv))
        }
        if nm == "__run_stderr" { return bytes_to_value(__run_stderr()) }
        if nm == "__run_exit_code" { return Value.VInt(__run_exit_code() as int64) }
        if nm == "__run_signal" { return Value.VInt(__run_signal() as int64) }
        if nm == "__run_errno" { return Value.VInt(__run_errno() as int64) }
        if nm == "assert" {
            let ok = as_bool(self.eval(args[0]))
            if !ok && !self.stop() {
                var msg = "assertion failed"
                if args.len() == 2 { msg = as_str(self.eval(args[1])) }
                self.fail(e, msg)
            }
            return Value.VUnit
        }
        if nm == "panic" {
            let msg = as_str(self.eval(args[0]))
            self.fail(e, msg)
            return Value.VUnit
        }
        if nm == "unreachable" {
            self.fail(e, "reached unreachable code")
            return Value.VUnit
        }
        if nm == "len" { return Value.VInt(value_len(self.eval(args[0]))) }
        if is_wrapping_method(nm) { return self.eval_wrapping(e, nm, args) }
        if nm == "push" {
            // the list's place, then the value; the list is changed afterwards,
            // so `push(xs, pop(xs))` sees the pop
            let p = self.place_of(args[0])
            let v = self.eval(args[1])
            self.read_place(p)                  // checks the indices
            if self.stop() { return Value.VUnit }
            self.update_place(p, PlaceOp.OPush(v))
            return Value.VUnit
        }
        if nm == "pop" {
            let p = self.place_of(args[0])
            let n = self.place_len(p)
            if self.stop() { return Value.VUnit }
            if n == 0 {
                self.fail(e, "pop from an empty list")
                return Value.VUnit
            }
            return self.update_place(p, PlaceOp.OPop)
        }
        if nm == "contains" {
            let m = self.eval(args[0])
            return Value.VBool(self.place_in(m, self.eval(args[1])) >= 0)
        }
        if nm == "remove" {
            let p = self.place_of(args[0])
            let k = self.eval(args[1])
            self.read_place(p)
            if self.stop() { return Value.VUnit }
            self.update_place(p, PlaceOp.ORemove(k))
            return Value.VUnit
        }
        if nm == "keys" { return map_keys(self.eval(args[0])) }
        if nm == "chars" { return decode_chars(as_str(self.eval(args[0]))) }
        if nm == "format" { return self.eval_format(args) }
        if nm == "StringBuilder" {
            // a capacity (MYLA-369) is evaluated; the interpreter's buffer
            // grows as a list does
            for a in args { self.eval(a) }
            return Value.VSB(empty_bytes())
        }
        if nm == "append" {
            let p = self.place_of(args[0])
            var piece = as_str(self.eval(args[1]))
            if args.len() == 4 {                    // append(sb, s, start, end) (MYLA-85)
                let start = as_int(self.eval(args[2]))
                let end = as_int(self.eval(args[3]))
                if self.stop() { return Value.VUnit }
                if start < 0 || start > end || end > (piece.len() as int64) {
                    self.fail(e, format("string range {}..{} out of bounds (len {})", start, end, piece.len()))
                    return Value.VUnit
                }
                var sb = StringBuilder()
                sb.append(piece, start as int32, end as int32)
                piece = sb.build()
            }
            self.read_place(p)
            if self.stop() { return Value.VUnit }
            self.update_place(p, PlaceOp.OAppend(piece))
            return Value.VUnit
        }
        if nm == "append_char" {
            // the character's UTF-8 bytes (MYLA-390)
            let p = self.place_of(args[0])
            let c = self.eval(args[1])
            self.read_place(p)
            if self.stop() { return Value.VUnit }
            match c {
                Value.VChar(cp) => self.update_place(p, PlaceOp.OAppend(cp_utf8(cp as int32)))
                _ => {}
            }
            return Value.VUnit
        }
        if nm == "append_byte" {
            let p = self.place_of(args[0])
            let b = as_int(self.eval(args[1]))
            self.read_place(p)
            if self.stop() { return Value.VUnit }
            self.update_place(p, PlaceOp.OAppendByte(b))
            return Value.VUnit
        }
        if nm == "build" { return Value.VStr(sb_build(self.eval(args[0]))) }
        // a bare enum constructor with payload, e.g. `Some(x)`, `Ok(x)`
        match self.variant_enum(nm) {
            Some(en) => { return Value.VEnum(en, nm, self.eval_args(args)) },
            None => {},
        }
        // indirect call: `f(args)` where f is a closure value; a local binding
        // shadows a function of the same name, as the checker types it (MYLA-102)
        match self.lookup(nm) {
            Some(v) => { return self.call_value(v, self.eval_args(args)) },
            None => {},
        }
        let fi = self.func_idx(nm)
        if fi >= 0 {
            let argv = self.eval_args(args)
            self.bind_next(fi, e.id, None)
            return self.call_func(fi, argv)
        }
        return Value.VUnit
    }

    #test(interp_on("[int]"), "length")[None]
    fun variant_enum(self, name: str) -> Option<str> {
        for d in self.decls {
            match d.kind {
                DeclKind.EnumDecl(en, variants, attrs, tps, isp) => {
                    for v in variants { if v.name == name { return Some(en) } }
                },
                _ => {},
            }
        }
        return None
    }

    #test(interp_on("[int]"), Value.VClosure([], ExprOrBlock.EB_Block(Block { line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, stmts: [] }), [], [], "inc", true), [Value.VInt(3)])[Value.VUnit]
    fun call_value(var self, v: Value, argv: [Value]) -> Value {
        if self.stop() { return Value.VUnit }   // as call_func (MYLA-366)
        return match v {
            Value.VClosure(ps, body, cnames, cvals, fname, isfunc) => self.call_closure(ps, body, cnames, cvals, fname, isfunc, argv),
            Value.VCompose(fs) => self.call_compose(fs, argv),
            Value.VPartial(base, slots, holes) => self.call_partial(base, slots, holes, argv),
            _ => Value.VUnit,
        }
    }

    // Apply a composition `f0 >> f1 >> …` left-to-right to a single argument.
    fun call_compose(var self, fs: [Value], argv: [Value]) -> Value {
        var v = argv[0]
        for f in fs { v = self.call_value(f, [v]) }
        return v
    }

    // Fill a partial application's holes with the supplied args, in order.
    #test(interp_on("[int]"), Value.VClosure([], ExprOrBlock.EB_Block(Block { line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, stmts: [] }), [], [], "mul", true), [Value.VInt(2), Value.VUnit], [false, true], [Value.VInt(4)])[Value.VUnit]
    fun call_partial(var self, base: Value, slots: [Value], holes: [bool], argv: [Value]) -> Value {
        return self.call_value(base, fill_holes(slots, holes, argv))
    }

    // A lambda captures every currently-visible local by value (a snapshot).
    // Over-capturing is harmless: unreferenced names are simply never read, and
    // by-value copies give the deep-immutability semantics (D14/D48).
    // A lambda's value: its body with the variables it reads, copied (by
    // value, as natively). Only those: a copy of every variable in scope made
    // each lambda keep the lists around it, and a loop pushing lambdas onto
    // a list copied the list once per push (10,000 `task.all` sleepers took
    // 600 MB, MYLA-296).
    fun eval_lambda(self, params: [Param], body: ExprOrBlock) -> Value {
        let reads = match body {
            ExprOrBlock.EB_Expr(x) => names_in_expr(x, []),
            ExprOrBlock.EB_Block(b) => names_in_block(b, []),
        }
        var wanted: [str: bool] = [:]
        for n in reads { wanted[n] = true }
        var cnames: [str] = []
        var cvals: [Value] = []
        var i = 0
        while i < self.scopes.len() {
            var j = 0
            while j < self.scopes[i].names.len() {
                let n = self.scopes[i].names[j]
                // and the type parameters bound in scope (D172)
                if wanted.contains(n) || (self.type_env && n.len() > 2 && n[0] == '%' && n[1] == ':') {
                    cnames.push(self.scopes[i].names[j])
                    cvals.push(self.scopes[i].vals[j])
                }
                j = j + 1
            }
            i = i + 1
        }
        return Value.VClosure(params, body, cnames, cvals, "", false)
    }

    #test(interp_on("[int]"), [], ExprOrBlock.EB_Block(Block { line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, stmts: [] }), [], [], "inc", true, [Value.VInt(3)])[Value.VUnit]
    fun call_closure(var self, ps: [Param], body: ExprOrBlock, cnames: [str], cvals: [Value], fname: str, isfunc: bool, argv: [Value]) -> Value {
        if isfunc {
            let fi = self.func_idx(fname)
            if fi < 0 { return Value.VUnit }
            if is_method_name(fname) {
                // a method value (partial application): argv[0] is the receiver
                var rest: [Value] = []
                var k = 1
                while k < argv.len() {
                    rest.push(argv[k])
                    k = k + 1
                }
                let (rv, final_self) = self.call_method(fi, argv[0], rest)
                return rv
            }
            return self.call_func(fi, argv)
        }
        if !self.enter_call() { return Value.VUnit }
        let saved = self.scopes
        self.scopes = []
        self.push_scope()
        var i = 0
        while i < cnames.len() {
            self.define(cnames[i], cvals[i])
            i = i + 1
        }
        var k = 0
        while k < ps.len() {
            self.define(ps[k].name, argv[k])
            k = k + 1
        }
        if self.defer_lambda(body) {
            self.scopes = saved
            self.depth = self.depth - 1
            return Value.VUnit
        }
        var rv = Value.VUnit
        match body {
            ExprOrBlock.EB_Expr(ex) => {
                rv = self.eval(ex)
                // a `?` in the body returns from the lambda (MYLA-72)
                if self.returning() { rv = self.take_return() }
            },
            ExprOrBlock.EB_Block(b) => {
                self.exec_block(b)
                rv = self.run_tail()
            },
        }
        self.scopes = saved
        self.depth = self.depth - 1
        return rv
    }

    #test(interp_on("fun k(f: (int) -> int) -> int { return f(2) }; fun z() -> int { return k((x: int) => x + 1) }"), 1, [Value.VChar(53)])[Value.VInt(3)]
    fun call_func(var self, fi: int32, argv: [Value]) -> Value {
        // an argument that stopped (a `?`, a failure) leaves no call to make
        // (MYLA-366): its arguments are short
        if self.stop() { return Value.VUnit }
        if !self.enter_call() { return Value.VUnit }
        let saved = self.scopes
        self.enter_func(fi, argv)
        let rv = self.run_tail()
        self.scopes = saved
        self.depth = self.depth - 1
        return rv
    }

    // Consume a pending `return`/`?` control signal, yielding its value. Leaves
    // `exit` pending so it propagates out to `run`; clears stray break/continue.
    #test(interp_on("[int]"))[Value.VUnit]
    fun take_return(var self) -> Value {
        return match self.ctrl {
            Ctrl.CReturn => {
                self.ctrl = Ctrl.CNone
                let v = self.ctrl_val
                self.ctrl_val = Value.VUnit
                v
            },
            Ctrl.CExit => Value.VUnit,
            _ => {
                self.ctrl = Ctrl.CNone
                Value.VUnit
            },
        }
    }

    // -- output -----------------------------------------------------------

    // A program's output; one the system won't take ends the program with
    // a runtime error, as natively (D153; a closed pipe ends it quietly in
    // `write`, D146).
    fun emit(var self, s: str) {
        // a `#test` case's output is kept for its report (D162)
        if self.testing {
            self.captured.push(s)
            return
        }
        match write(1, s) {
            Ok(()) => {},
            Err(e) => {
                let code = __io_errno()
                eprint(f"runtime error: write failed: {errno_text(code)}\n")
                exit(1)
            },
        }
    }
}

