// `f >> g`: chain the right callable after the left, flattening nested chains.
#test(Value.VInt(0), Value.VInt(0))[Value.VCompose([Value.VInt(0), Value.VInt(0)])]
#test(Value.VStruct("Name", ["text"], [Value.VStr("al")]), Value.VStruct("Name", ["text"], [Value.VStr("al")]))[Value.VCompose([Value.VStruct("Name", ["text"], [Value.VStr("al")]), Value.VStruct("Name", ["text"], [Value.VStr("al")])])]
#test(Value.VList([Value.VInt(10), Value.VInt(20), Value.VInt(30)]), Value.VList([Value.VInt(10), Value.VInt(20), Value.VInt(30)]))[Value.VCompose([Value.VList([Value.VInt(10), Value.VInt(20), Value.VInt(30)]), Value.VList([Value.VInt(10), Value.VInt(20), Value.VInt(30)])])]
fun compose_values(lv: Value, rv: Value) -> Value {
    return match lv {
        Value.VCompose(fs) => Value.VCompose(append_value(fs, rv)),
        _ => Value.VCompose([lv, rv]),
    }
}

#test([Value.VChar(53)], Value.VInt(0))[[Value.VChar(53), Value.VInt(0)]]
