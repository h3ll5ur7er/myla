}

// Round to the precision of float type `t` (float32: to nearest single).
#test(1.0, Some(Type.TFloat(64)))[1.0]
#test(6.0, Some(Type.TFloat(64)))[6.0]
#test(0.30000000447034836, Some(Type.TFloat(32)))[0.30000001192092896]
fun round_float(f: float64, t: Option<Type>) -> float64 {
    if is_float32_type(t) { return (f as float32) as float64 }
    return f
}

#test(Value.VInt(0))["0"]
#test(Value.VInt(955))["955"]
#test(Value.VStr("This is not the error you are looking for. It is the answer to life, the universe, and everything."))["This is not the error you are looking for. It is the answer to life, the universe, and everything."]
fun format_value(v: Value) -> str {
    return match v {
        Value.VStr(s) => s,
        Value.VBool(b) => match b { true => "true", false => "false" },
        Value.VInt(n) => format("{}", n),
        Value.VFloat(f) => format("{}", f),
        Value.VChar(c) => cp_utf8(c as int32),
        _ => format("ERR: {}", v.to_string()),
    }
}

// Whether the wait `w` is over: its descriptor readable, or its socket
// ready for what it waits for (the host's `__poll`, `__sock_poll`).
#allow(primitive)
fun fd_wait_over(w: FdWait) -> bool {
    if w.events != 0 { return __sock_poll(w.fd, w.events, 0) != 0 }
    return __poll(w.fd, 0) != 0 || (w.fd2 >= 0 && __poll(w.fd2, 0) != 0)
}

