#test(Type.TInt(32, true))["int32"]
#test(Type.TActor("Account", []))["Account"]
#test(Type.TStruct("Box", [Type.TInt(32, true)]))["Box"]
fun type_key_of(t: Type) -> str {
    return match t {
        Type.TStruct(n, a) => n,
        Type.TActor(n, a) => n,
        Type.TEnum(n, a) => n,
        Type.TInt(w, s) => int_type_name_i(w, s),
        Type.TBool => "bool",
        Type.TStr => "str",
        Type.TSB => "StringBuilder",
        // as the checker keys them (MYLA-221)
        Type.TChar => "char",
        Type.TFloat(w) => format("float{}", w),
        Type.TList(e) => "__list",
        Type.TMap(k, v) => "__map",
        _ => "",
    }
}

