// Why `c[k]` can't be read (or, `assigning`, written: a missing map key is
// then an insert), with the Python interpreter's message; "" if it can.
#test(Value.VStr("a"), Value.VInt(0), false, -1)[""]
#test(Value.VStr("b"), Value.VInt(0), false, -1)[""]
#test(Value.VStr("e"), Value.VInt(0), false, -1)[""]
#test(Value.VMap(new_mapv()), Value.VInt(0), false, -1)["map key 0 not found"]
// (`place`: a map key's place, as `Interp.place_in` finds it)
fun index_error(c: Value, k: Value, assigning: bool, place: int32) -> str {
    match c {
        Value.VList(xs) => {
            let i = as_int(k)
            if i < 0 || i >= (xs.len() as int64) {
                return format("list index {} out of bounds (len {})", i, xs.len())
            }
        },
        Value.VStr(str_) => {
            let i = as_int(k)
            if i < 0 || i >= (str_.len() as int64) {
                return format("string index {} out of bounds (len {})", i, str_.len())
            }
        },
        Value.VMap(m) => {
            if !assigning && place < 0 {
                return format("map key {} not found", py_repr(k))
            }
        },
        _ => {},
    }
    return ""
}

// The parts of a container value (empty for any other value), for
