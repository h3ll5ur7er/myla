    return op == "<" || op == "<=" || op == ">" || op == ">="
}

#test("x", 1, 1)[true]
#test("y", 2, 2)[true]
#test("d1", 3, 3)[true]
fun ucompare(op: str, a: int64, b: int64) -> bool {
    let x = a as uint64
    let y = b as uint64
    if op == "<" { return x < y }
    if op == "<=" { return x <= y }
    if op == ">" { return x > y }
    return x >= y
}

#test(0, 0)[0]
#test(1, 0)[1]
#test(0, 1)[-1]
fun icmp(a: int64, b: int64) -> int32 {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

// float comparison with IEEE semantics: anything involving NaN is false
#test("<", 2.0, 3.0)[true]
fun fcompare(op: str, a: float64, b: float64) -> bool {
    if op == "<" { return a < b }
    if op == "<=" { return a <= b }
    if op == ">" { return a > b }
    return a >= b
}

#test("a", "a")[0]
#test("x", "x")[0]
#test("y", "y")[0]
fun scmp(a: str, b: str) -> int32 {
    let la = a.len()
    let lb = b.len()
    var i = 0
    while i < la && i < lb {
        let ca = a[i] as int32
        let cb = b[i] as int32
        if ca < cb { return -1 }
        if ca > cb { return 1 }
        i = i + 1
    }
    if la < lb { return -1 }
    if la > lb { return 1 }
    return 0
}

// `a / b` truncated toward zero; the int64 minimum divided by -1 wraps to
// itself instead of trapping (MYLA-5).
#test(-7, 2)[-3]
#test(-9223372036854775807 - 1, 10)[-922337203685477580]
#test(-9223372036854775807 - 1, -1)[-9223372036854775807 - 1]
fun idiv(a: int64, b: int64) -> int64 {
    if b == 0 { return 0 }
    if b == -1 { return a.wrapping_neg() }
    return a / b
}

#test(1, 2)[1]
#test(2, 2)[0]
#test(17, 5)[2]
fun imod(a: int64, b: int64) -> int64 {
    if b == 0 { return 0 }
    return a.wrapping_sub(idiv(a, b).wrapping_mul(b))   // MIN % -1 is 0
}

#test(Some(Type.TInt(8, false)))[8]
#test(Some(Type.TInt(32, true)))[32]
fun width_of(rt: Option<Type>) -> int32 {
    return match rt { Some(t) => match t { Type.TInt(w, s) => w, _ => 0 }, None => 0 }
}

#test(2, Some(Type.TInt(32, true)))[2]
#test(4, Some(Type.TInt(32, true)))[4]
#test(10, Some(Type.TInt(32, true)))[10]
fun shift_count(b: int64, rt: Option<Type>) -> int64 {
    let w = width_of(rt)
    if w > 0 { return b & ((w as int64) - 1) }
    return b
}

#test(-32, 2, Some(Type.TInt(32, true)))[-8]
#test(240, 4, Some(Type.TInt(8, false)))[15]
fun shr_typed(a: int64, b: int64, rt: Option<Type>) -> int64 {
    let count = shift_count(b, rt)
    let aw = wrap_opt(a, rt)
    let unsigned64 = match rt { Some(t) => match t { Type.TInt(w, sg) => w == 64 && !sg, _ => false }, None => false }
    if unsigned64 { return ((aw as uint64) >> (count as uint64)) as int64 }   // logical
    return wrap_opt(aw >> count, rt)
}

// Whether `t` is an integer type (a receiver of the wrapping methods).
#test(Some(Type.TInt(8, false)))[true]
#test(Some(Type.TChar))[false]
#test(None)[false]
fun is_int_value_type(t: Option<Type>) -> bool {
    return match t { Some(Type.TInt(w, s)) => true, _ => false }
}

#test(1, Some(Type.TParam("T")))[1]
#test(99, Some(Type.TInt(32, true)))[99]
#test(100000, Some(Type.TInt(32, true)))[100000]
fun wrap_opt(v: int64, rt: Option<Type>) -> int64 {
    return match rt {
        Some(t) => match t { Type.TInt(w, s) => wrap_int_w(v, w, s), _ => v },
        None => v,
    }
}

#test(0, 32, true)[0]
#test(98, 32, true)[98]
#test(100000, 32, true)[100000]
fun wrap_int_w(value: int64, w: int32, signed: bool) -> int64 {
    if w >= 64 { return value }
    var mask: int64 = 1
    mask = (mask << w) - 1
    var m = value & mask
    var signbit: int64 = 1
    signbit = signbit << (w - 1)
    if signed && (m & signbit) != 0 {
        var span: int64 = 1
        span = span << w
        m = m - span
    }
    return m
}

#test(Value.VChar(0), Some(Type.TChar), Some(Type.TInt(32, true)))[Value.VInt(0)]
#test(Value.VInt(9), Some(Type.TInt(32, true)), Some(Type.TFloat(64)))[Value.VFloat(9.0)]
#test(Value.VInt(200), Some(Type.TInt(8, false)), Some(Type.TInt(8, true)))[Value.VInt(-56)]
fun cast_value(v: Value, src: Option<Type>, tgt: Option<Type>) -> Value {
    var t = Type.TBool
    var has = false
    match tgt { Some(tt) => { t = tt
        has = true }, None => {} }
    if !has { return v }
    match t {
        Type.TChar => { return Value.VChar(as_int(v)) },
        Type.TFloat(w) => {
            var f = as_float(v)
            let from_u64 = match src { Some(Type.TInt(sw, ss)) => sw == 64 && !ss, _ => false }
            if from_u64 { f = (as_int(v) as uint64) as float64 }
            return Value.VFloat(round_float(f, tgt))
        },
        Type.TInt(w, s) => {
            match v { Value.VFloat(f) => { return Value.VInt(float_to_int(f, w, s)) }, _ => {} }
            return Value.VInt(wrap_int_w(as_int(v), w, s))
        },
        _ => {},
    }
    return v
}

// `f as` an integer of width `w`: truncate toward zero, clamp to the range,
// NaN gives 0 (D59). A uint64 above 2^63 comes back as its bit pattern.
#test(3.9, 32, true)[3]
fun float_to_int(f: float64, w: int32, s: bool) -> int64 {
    if f != f { return 0 }
    var top = w                                  // high + 1 = 2^top
    if s { top = w - 1 }
    if f >= pow2(top) {
        if top == 64 { return -1 }               // all ones: the uint64 maximum
        return (1i64 << (top as int64)) - 1
    }
    if s {
        if f <= -pow2(top) { return -(1i64 << (top as int64)) }
    } else if f <= 0.0f64 {
        return 0
    }
    if f >= pow2(63) { return ((f - pow2(63)) as int64) | (1i64 << 63) }
    return f as int64
}

