// A map's entries (`Value.VMap`, MYLA-310): its keys and values in the
// order of insertion (D105), a removed one leaving a hole (`here` false),
// and an index from each key to its place, so that a lookup, an insert and
// a removal take constant time, not time in the map's size. The holes are
// dropped and the places renumbered when they outnumber the entries. An
// integer, `char` or `bool` key is indexed by its number, as `value_eq`
// compares them; a string by itself; a key of another kind (a tuple, a
// struct, an enum, a list: any `Eq + Hash` type, D163, MYLA-313) by its hash
// (`hashes`, as `Interp.key_hash` gives it): `heads` the first place of
// each hash, `nexts` the next place of the same hash, -1 at the end. The
// interpreter finds such a key among those of its hash with `==`
// (`Interp.key_place`), which may call a type's own `eq`.
pub struct MapV {
    ks: [Value],
    vs: [Value],
    here: [bool],
    ints: [int64: int32],
    strs: [str: int32],
    count: int32,
    hashes: [int64],
    heads: [int64: int32],
    nexts: [int32],
}

#test()[MapV { ks: [], vs: [], here: [], ints: [:], strs: [:], count: 0, hashes: [], heads: [:], nexts: [] }]
pub fun new_mapv() -> MapV {
    return MapV { ks: [], vs: [], here: [], ints: [:], strs: [:], count: 0, hashes: [], heads: [:], nexts: [] }
}

// The map of `ks` and `vs`, inserted in that order (a key given again
// replaces the value, keeping its first place); a compound key's hash its
// structure's (`value_hash`).
#test([Value.VInt(1)], [Value.VInt(2)])[MapV { ks: [Value.VInt(1)], vs: [Value.VInt(2)], here: [true], ints: [1: 0], strs: [:], count: 1, hashes: [0], heads: [:], nexts: [-1] }]
#test([Value.VStr("a"), Value.VStr("a")], [Value.VInt(1), Value.VInt(2)])[MapV { ks: [Value.VStr("a")], vs: [Value.VInt(2)], here: [true], ints: [:], strs: ["a": 0], count: 1, hashes: [0], heads: [:], nexts: [-1] }]
pub fun mapv_of(ks: [Value], vs: [Value]) -> MapV {
    var m = new_mapv()
    var i = 0
    while i < ks.len() {
        m.put(ks[i], vs[i])
        i = i + 1
    }
    return m
}

// Whether the attributes `attrs` derive the trait `trnm` (`#derive(...)`).
fun derives_trait(attrs: [Attribute], trnm: str) -> bool {
    for a in attrs {
        if a.name == "derive" {
            for arg in a.args {
                match arg.kind {
                    ExprKind.Name(n) => { if n == trnm { return true } },
                    _ => {},
                }
            }
        }
    }
    return false
}

// Whether `k` is indexed by its number.
#test(Value.VChar(97))[true]
#test(Value.VStr("a"))[false]
fun is_int_key(k: Value) -> bool {
    return match k {
        Value.VInt(n) => true,
        Value.VChar(c) => true,
        Value.VBool(b) => true,
        _ => false,
    }
}

// Whether `k` is indexed by itself (a number or a string), not by its hash.
#test(Value.VStr("a"))[true]
#test(Value.VTuple([Value.VInt(1)]))[false]
fun is_plain_key(k: Value) -> bool {
    return match k {
        Value.VStr(s) => true,
        _ => is_int_key(k),
    }
}

impl MapV {
    // The place of `k` in `ks` and `vs`, or -1: a compound key's found
    // among those of its structure's hash (`value_hash`) by `value_eq`, for
    // maps made without the interpreter (`mapv_of`); the interpreter's own
    // go through `Interp.key_place`.
    #test(mapv_of([Value.VInt(5), Value.VInt(7)], [Value.VUnit, Value.VUnit]), Value.VInt(7))[1]
    #test(mapv_of([Value.VInt(97)], [Value.VUnit]), Value.VChar(97))[0]
    #test(mapv_of([Value.VStr("a")], [Value.VUnit]), Value.VStr("b"))[-1]
    #test(mapv_of([Value.VTuple([Value.VInt(1)])], [Value.VUnit]), Value.VTuple([Value.VInt(1)]))[0]
    fun place(self, k: Value) -> int32 {
        if let Value.VStr(s) = k {
            return match self.strs.get(s) {
                Some(j) => j,
                None => -1,
            }
        }
        if is_int_key(k) {
            return match self.ints.get(as_int(k)) {
                Some(j) => j,
                None => -1,
            }
        }
        var j = self.first_of(value_hash(k))
        while j >= 0 {
            if value_eq(self.ks[j], k) { return j }
            j = self.nexts[j]
        }
        return -1
    }

    // The first place of a compound key whose hash is `h`, or -1.
    fun first_of(self, h: int64) -> int32 {
        return match self.heads.get(h) {
            Some(j) => j,
            None => -1,
        }
    }

    // `k` indexed at the place `j`: by its number or itself, else by its
    // hash `h`, first among those of `h`.
    fun index(var self, k: Value, h: int64, j: int32) {
        if let Value.VStr(s) = k {
            self.strs[s] = j
        } else if is_int_key(k) {
            self.ints[as_int(k)] = j
        } else {
            self.nexts[j] = self.first_of(h)
            self.heads[h] = j
        }
    }

    // A new entry for the key `k` (whose hash, a compound key's, is `h`) at
    // the end, its value `()`: its place.
    fun add_key(var self, k: Value, h: int64) -> int32 {
        let j = self.ks.len()
        self.ks.push(k)
        self.vs.push(Value.VUnit)
        self.here.push(true)
        self.hashes.push(h)
        self.nexts.push(-1)
        self.index(k, h, j)
        self.count = self.count + 1
        return j
    }

    // The place of `k`, made at the end (its value `()`) when it is missing.
    #test(new_mapv(), Value.VInt(3))[0]
    #test(mapv_of([Value.VInt(5), Value.VInt(7)], [Value.VUnit, Value.VUnit]), Value.VInt(5))[0]
    fun place_or_add(var self, k: Value) -> int32 {
        let found = self.place(k)
        if found >= 0 { return found }
        var h: int64 = 0
        if !is_plain_key(k) { h = value_hash(k) }
        return self.add_key(k, h)
    }

    // `k` set to `v`: a new key goes last, a known one keeps its place.
    fun put(var self, k: Value, v: Value) {
        let j = self.place_or_add(k)
        self.vs[j] = v
    }

    // `k`'s entry removed (nothing when it is missing).
    fun take_out(var self, k: Value) {
        let j = self.place(k)
        if j >= 0 { self.remove_at(j) }
    }

    // The entry at the place `j` removed: a hole in its place, the entries
    // compacted once the holes outnumber them.
    fun remove_at(var self, j: int32) {
        let k = self.ks[j]
        if let Value.VStr(s) = k {
            self.strs.remove(s)
        } else if is_int_key(k) {
            self.ints.remove(as_int(k))
        } else {
            // out of its hash's chain
            let h = self.hashes[j]
            if self.first_of(h) == j {
                if self.nexts[j] >= 0 { self.heads[h] = self.nexts[j] } else { self.heads.remove(h) }
            } else {
                var at = self.first_of(h)
                while at >= 0 && self.nexts[at] != j { at = self.nexts[at] }
                if at >= 0 { self.nexts[at] = self.nexts[j] }
            }
        }
        self.ks[j] = Value.VUnit
        self.vs[j] = Value.VUnit
        self.here[j] = false
        self.count = self.count - 1
        let holes = self.ks.len() - self.count
        if holes >= 16 && holes > self.count { self.compact() }
    }

    // The holes dropped: the entries at the places 0 … count - 1, in order.
    fun compact(var self) {
        var ks: [Value] = []
        var vs: [Value] = []
        var here: [bool] = []
        var hashes: [int64] = []
        let old_hashes = self.hashes
        self.ints = [:]
        self.strs = [:]
        self.heads = [:]
        self.nexts = []
        var i = 0
        while i < self.ks.len() {
            if self.here[i] {
                self.nexts.push(-1)
                self.index(self.ks[i], old_hashes[i], ks.len())
                ks.push(self.ks[i])
                vs.push(self.vs[i])
                here.push(true)
                hashes.push(old_hashes[i])
            }
            i = i + 1
        }
        self.ks = ks
        self.vs = vs
        self.here = here
        self.hashes = hashes
    }
}

// The hash of the key `v` by its structure, as `value_eq` compares it: what
// `Interp.key_hash` gives for a key no type's own `hash` is in.
#test(Value.VUnit)[7]
#test(Value.VList([]))[mix_key(4, 0)]
fun value_hash(v: Value) -> int64 {
    return match v {
        Value.VInt(n) => mix_key(1, n),
        Value.VChar(c) => mix_key(1, c),
        Value.VBool(b) => mix_key(1, if b { 1 } else { 0 }),
        Value.VStr(s) => str_key_hash(s),
        Value.VUnit => 7,
        Value.VTuple(es) => values_hash(3, es),
        Value.VList(xs) => values_hash(mix_key(4, xs.len() as int64), xs),
        Value.VStruct(n, fns, fvs) => values_hash(mix_key(5, str_key_hash(n)), fvs),
        Value.VEnum(en, vr, pl) => values_hash(mix_key(6, str_key_hash(vr)), pl),
        Value.VFloat(f) => mix_key(8, f as int64),
        _ => 9,
    }
}

// `value_hash` of each of `xs` mixed into `h` in turn.
fun values_hash(h: int64, xs: [Value]) -> int64 {
    var g = h
    for x in xs { g = mix_key(g, value_hash(x)) }
    return g
}

// `w` mixed into the hash `h` (a multiply by 2^64/phi and the top bits
// folded down, as native code's `__khash_<K>` mixes a word).
#test(0, 0)[0]
fun mix_key(h: int64, w: int64) -> int64 {
    let m = (h ^ w).wrapping_mul(-7046029254386353131)
    return m ^ (((m as uint64) >> 29) as int64)
}

// The bytes of `s` mixed in, eight to a word.
fun str_key_hash(s: str) -> int64 {
    var h = mix_key(2, s.len() as int64)
    var i = 0
    while i < s.len() {
        h = mix_key(h, s[i] as int64)
        i = i + 1
    }
    return h
}

// The keys of `m` in the order of insertion.
#test(new_mapv())[[]]
#test(mapv_of([Value.VStr("a"), Value.VStr("c"), Value.VStr("d")], [Value.VInt(10), Value.VInt(3), Value.VInt(4)]))[[Value.VStr("a"), Value.VStr("c"), Value.VStr("d")]]
pub fun map_keys_of(m: MapV) -> [Value] {
    if m.count == m.ks.len() { return m.ks }
    return present(m.ks, m.here)
}

// The values of `m`, in the same order.
#test(mapv_of([Value.VInt(0), Value.VInt(1)], [Value.VInt(5), Value.VInt(6)]))[[Value.VInt(5), Value.VInt(6)]]
pub fun map_vals_of(m: MapV) -> [Value] {
    if m.count == m.ks.len() { return m.vs }
    return present(m.vs, m.here)
}

// The elements of `xs` whose place is `here`.
#test([Value.VInt(1), Value.VUnit, Value.VInt(3)], [true, false, true])[[Value.VInt(1), Value.VInt(3)]]
fun present(xs: [Value], here: [bool]) -> [Value] {
    var out: [Value] = []
    var i = 0
    while i < xs.len() {
        if here[i] { out.push(xs[i]) }
        i = i + 1
    }
    return out
}

#test(Value.VMap(new_mapv()))[Value.VList([])]
#test(Value.VMap(mapv_of([Value.VInt(0), Value.VInt(1), Value.VInt(2)], [Value.VInt(1), Value.VInt(2), Value.VInt(3)])))[Value.VList([Value.VInt(0), Value.VInt(1), Value.VInt(2)])]
fun map_keys(c: Value) -> Value {
    return match c {
        Value.VMap(m) => Value.VList(map_keys_of(m)),
        _ => Value.VList(empty_values()),
    }
}

#test("")[Value.VList([])]
#test("héλ")[Value.VList([Value.VChar(104), Value.VChar(233), Value.VChar(955)])]
#test("héllo")[Value.VList([Value.VChar(104), Value.VChar(233), Value.VChar(108), Value.VChar(108), Value.VChar(111)])]
fun decode_chars(s: str) -> Value {
    var out: [Value] = []
    for ch in s.chars() {
        out.push(Value.VChar(ch as int64))
    }
    return Value.VList(out)
}

// The character at byte `i` of `s` and its length in bytes, as
// `cp | len << 32`: U+FFFD and 1 for a byte that isn't part of a
// well-formed UTF-8 sequence, as `s.chars()` decodes it (std.rt's
// `decode_at`; MYLA-318).
#test("a", 0)[4294967393]
#test("é", 0)[8589934825]
#test("x😀", 1)[17179997696]
#test("\u{FFFD}", 1)[4295032829]
fun utf8_at(s: str, i: int32) -> int64 {
    let n = s.len()
    let b = s[i] as int64
    if b < 128 { return b | (1i64 << 32) }
    var need = 0
    var cp: int64 = 0
    var least: int64 = 0
    if b >= 0xC2 && b < 0xE0 {
        need = 2
        cp = b & 0x1F
        least = 0x80
    } else if b >= 0xE0 && b < 0xF0 {
        need = 3
        cp = b & 0x0F
        least = 0x800
    } else if b >= 0xF0 && b < 0xF5 {
        need = 4
        cp = b & 0x07
        least = 0x10000
    }
    if need == 0 || i + need > n { return 0xFFFD | (1i64 << 32) }
    var k = 1
    while k < need {
        let c = s[i + k] as int64
        if (c & 0xC0) != 0x80 { return 0xFFFD | (1i64 << 32) }
        cp = (cp << 6) | (c & 0x3F)
        k += 1
    }
    if cp < least || cp > 0x10FFFF || (cp & -2048) == 0xD800 { return 0xFFFD | (1i64 << 32) }
    return cp | ((need as int64) << 32)
}

#test()[[]]
fun empty_bytes() -> [int64] {
    let x: [int64] = []
    return x
}

#test(Value.VSB([]))[""]
#test(Value.VSB([48, 49, 50, 51, 52]))["01234"]
#test(Value.VSB([72, 101, 108, 108, 111, 44, 32, 119, 111, 114, 108, 100, 33]))["Hello, world!"]
fun sb_build(c: Value) -> str {
    return match c {
        Value.VSB(b) => bytes_to_str(b),
        _ => "",
    }
}

#test([])[""]
#test([48, 49, 50, 51, 52])["01234"]
#test([72, 101, 108, 108, 111, 44, 32, 119, 111, 114, 108, 100, 33])["Hello, world!"]
fun bytes_to_str(b: [int64]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < b.len() {
        sb.append_byte(b[i] as uint8)
        i = i + 1
    }
    return sb.build()
}

#test("{}€", ["6"])["6€"]
#test("{} + {} = {}", ["2", "3", "5"])["2 + 3 = 5"]
#test("{}:{}:{}: there is no error, this is just a test", ["main.my", "3", "12"])["main.my:3:12: there is no error, this is just a test"]
fun render_format(fmt: str, parts: [str]) -> str {
    var sb = StringBuilder()
    let n = fmt.len()
    var i = 0
    var arg = 0
    while i < n {
        let c = fmt[i] as int32
        if c == 123 && i + 1 < n && (fmt[i + 1] as int32) == 123 {
            sb.append_byte(123)
            i = i + 2
        } else if c == 125 && i + 1 < n && (fmt[i + 1] as int32) == 125 {
            sb.append_byte(125)
            i = i + 2
        } else if c == 123 {
            // a hole, its spec (D139) applied already
            sb.append(parts[arg])
            arg = arg + 1
            while i < n && (fmt[i] as int32) != 125 { i = i + 1 }
            i = i + 1
        } else {
            sb.append_byte(fmt[i])
            i = i + 1
        }
    }
    return sb.build()
}

#test()[MatchRes { ok: true, names: [], vals: [] }]
fun mr_ok() -> MatchRes { return MatchRes { ok: true, names: [], vals: [] } }
#test()[MatchRes { ok: false, names: [], vals: [] }]
fun mr_fail() -> MatchRes { return MatchRes { ok: false, names: [], vals: [] } }
#test(true)[MatchRes { ok: true, names: [], vals: [] }]
#test(false)[MatchRes { ok: false, names: [], vals: [] }]
fun mr_bool(b: bool) -> MatchRes { return MatchRes { ok: b, names: [], vals: [] } }
#test("a", Value.VInt(4))[MatchRes { ok: true, names: ["a"], vals: [Value.VInt(4)] }]
#test("w", Value.VInt(3))[MatchRes { ok: true, names: ["w"], vals: [Value.VInt(3)] }]
#test("t", Value.VEnum("List", "Cons", [Value.VInt(6), Value.VEnum("List", "Nil", [])]))[MatchRes { ok: true, names: ["t"], vals: [Value.VEnum("List", "Cons", [Value.VInt(6), Value.VEnum("List", "Nil", [])])] }]
fun mr_bind(n: str, v: Value) -> MatchRes {
    var names: [str] = []
    var vals: [Value] = []
    names.push(n)
    vals.push(v)
    return MatchRes { ok: true, names: names, vals: vals }
}
#test(MatchRes { ok: true, names: [], vals: [] }, MatchRes { ok: true, names: [], vals: [] })[MatchRes { ok: true, names: [], vals: [] }]
#test(MatchRes { ok: true, names: [], vals: [] }, MatchRes { ok: true, names: ["v"], vals: [Value.VInt(8)] })[MatchRes { ok: true, names: ["v"], vals: [Value.VInt(8)] }]
#test(MatchRes { ok: true, names: [], vals: [] }, MatchRes { ok: true, names: ["rest"], vals: [Value.VEnum("List", "Nil", [])] })[MatchRes { ok: true, names: ["rest"], vals: [Value.VEnum("List", "Nil", [])] }]
fun mr_merge(a: MatchRes, b: MatchRes) -> MatchRes {
    var names = a.names
    var vals = a.vals
    var i = 0
    while i < b.names.len() {
        names.push(b.names[i])
        vals.push(b.vals[i])
        i = i + 1
    }
    return MatchRes { ok: true, names: names, vals: vals }
}

struct RtEnumInfo { ok: bool, names: [str], vals: [Value] }

#test(Value.VEnum("List", "Nil", []))[RtEnumInfo { ok: true, names: ["Nil"], vals: [] }]
#test(Value.VEnum("Option", "Some", [Value.VInt(8)]))[RtEnumInfo { ok: true, names: ["Some"], vals: [Value.VInt(8)] }]
#test(Value.VEnum("List", "Cons", [Value.VStr("z"), Value.VEnum("List", "Nil", [])]))[RtEnumInfo { ok: true, names: ["Cons"], vals: [Value.VStr("z"), Value.VEnum("List", "Nil", [])] }]
fun enum_info(v: Value) -> RtEnumInfo {
    return match v {
        Value.VEnum(en, vr, pl) => mk_enum_info(vr, pl),
        _ => RtEnumInfo { ok: false, names: [], vals: [] },
    }
}

#test("Nil", [])[RtEnumInfo { ok: true, names: ["Nil"], vals: [] }]
#test("Some", [Value.VInt(8)])[RtEnumInfo { ok: true, names: ["Some"], vals: [Value.VInt(8)] }]
#test("Cons", [Value.VStr("z"), Value.VEnum("List", "Nil", [])])[RtEnumInfo { ok: true, names: ["Cons"], vals: [Value.VStr("z"), Value.VEnum("List", "Nil", [])] }]
fun mk_enum_info(vr: str, pl: [Value]) -> RtEnumInfo {
    var names: [str] = []
    names.push(vr)
    return RtEnumInfo { ok: true, names: names, vals: pl }
}

#test(Value.VInt(0))[[]]
#test(Value.VInt(1))[[]]
#test(Value.VList([Value.VInt(7)]))[[]]
fun i_tuple_elems(v: Value) -> [Value] {
    return match v { Value.VTuple(es) => es, _ => empty_values() }
}

#test(Value.VInt(0), Value.VInt(0))[true]
#test(Value.VInt(1), Value.VInt(1))[true]
#test(Value.VInt(0), Value.VInt(1))[false]
fun value_eq(a: Value, b: Value) -> bool {
    return match a {
        Value.VInt(x) => icmp(x, as_int(b)) == 0,
        Value.VChar(x) => match b { Value.VChar(y) => x == y, Value.VInt(y) => x == y, _ => false },
        Value.VBool(x) => match b { Value.VBool(y) => x == y, _ => false },
        Value.VStr(x) => match b { Value.VStr(y) => x == y, _ => false },
        Value.VFloat(x) => match b { Value.VFloat(y) => x == y, _ => false },
        // a function's "nothing" is the unit value `()` (D140)
        Value.VUnit => match b { Value.VUnit => true, Value.VTuple(es) => es.len() == 0, _ => false },
        Value.VStruct(n, fns, fvs) => match b { Value.VStruct(n2, fns2, fvs2) => n == n2 && values_eq(fvs, fvs2), _ => false },
        Value.VTuple(es) => match b { Value.VTuple(es2) => values_eq(es, es2), Value.VUnit => es.len() == 0, _ => false },
        Value.VEnum(en, vr, pl) => match b { Value.VEnum(en2, vr2, pl2) => en == en2 && vr == vr2 && values_eq(pl, pl2), _ => false },
        Value.VList(xs) => match b { Value.VList(ys) => values_eq(xs, ys), _ => false },
        Value.VMap(m) => match b { Value.VMap(m2) => maps_eq(m, m2), _ => false },
        _ => false,
    }
}

// A value as the Python interpreter's repr shows it, for a failed #test:
// chars as code points, `True`, `None`, strings quoted as Python quotes them,
// `P { x: 1 }`, `E.B(1)`, `(a, b)`, `[a]`, `[k: v]`.
#test(Value.VBool(true))["True"]
#test(Value.VList([Value.VInt(1), Value.VChar(97)]))["[1, 97]"]
#test(Value.VMap(new_mapv()))["[]"]
#test(Value.VEnum("E", "B", [Value.VStr("it's")]))["E.B(\"it's\")"]
// (Also the key in a "map key … not found" message.)
#test(Value.VStr("a b"))["'a\\xa0b'"]
pub fun py_repr(v: Value) -> str {
    return match v {
        Value.VInt(i) => format("{}", i),
        Value.VChar(c) => format("{}", c),
        Value.VBool(b) => bool_repr(b),
        Value.VFloat(f) => format_float(f),
        Value.VStr(t) => py_repr_str(t),
        Value.VUnit => "None",
        Value.VStruct(n, names, vals) => struct_repr(n, names, vals),
        Value.VTuple(es) => "(" + reprs(es) + ")",
        Value.VEnum(en, vr, pl) => enum_repr(en, vr, pl),
        Value.VList(xs) => "[" + reprs(xs) + "]",
        Value.VMap(m) => map_repr(map_keys_of(m), map_vals_of(m)),
        Value.VSB(bs) => "StringBuilder(" + bytes_repr(bs) + ")",
        Value.VClosure(ps, body, cn, cv, fname, is_func) => format("<closure {} param(s), {} capture(s)>", ps.len(), cn.len()),
        _ => "<function>",
    }
}

// `py_repr` of `v` by its type `t` (None: unknown), as the report shows a
// value: a uint64, which is stored as the int64 of its bits, unsigned, inside
// a struct, tuple, list, map or enum too (MYLA-361).
#test(checker_on("fun f() {}"), Value.VInt(-1), Some(Type.TInt(64, false)))["18446744073709551615"]
#test(checker_on("fun f() {}"), Value.VInt(-1), Some(Type.TInt(64, true)))["-1"]
#test(checker_on("fun f() {}"), Value.VTuple([Value.VInt(-1), Value.VInt(-1)]), Some(Type.TTuple([Type.TInt(64, false), Type.TInt(32, true)])))["(18446744073709551615, -1)"]
#test(checker_on("struct H { s: uint64 }"), Value.VStruct("H", ["s"], [Value.VInt(-2)]), Some(Type.TStruct("H", [])))["H { s: 18446744073709551614 }"]
#test(checker_on("fun f() {}"), Value.VEnum("Option", "Some", [Value.VList([Value.VInt(-1)])]), Some(Type.TEnum("Option", [Type.TList(Type.TInt(64, false))])))["Option.Some([18446744073709551615])"]
#test(checker_on("fun f() {}"), Value.VInt(-1), None)["-1"]
pub fun typed_repr(ch: Checker, v: Value, t: Option<Type>) -> str {
    let ty = match t { Some(x) => x, None => { return py_repr(v) } }
    match ty {
        Type.TInt(w, sg) => { match v { Value.VInt(i) => { if w == 64 && !sg { return format("{}", i as uint64) } }, _ => {} } },
        Type.TTuple(ts) => {
            match v { Value.VTuple(es) => { if es.len() == ts.len() { return "(" + typed_reprs(ch, es, ts) + ")" } }, _ => {} }
        },
        Type.TList(e) => {
            match v {
                Value.VList(xs) => {
                    var ts: [Type] = []
                    for x in xs { ts.push(e) }
                    return "[" + typed_reprs(ch, xs, ts) + "]"
                },
                _ => {},
            }
        },
        Type.TMap(kt, vt) => {
            match v {
                Value.VMap(m) => {
                    let ks = map_keys_of(m)
                    let vs = map_vals_of(m)
                    var sb = StringBuilder()
                    sb.append("[")
                    var i = 0
                    while i < ks.len() {
                        if i > 0 { sb.append(", ") }
                        sb.append(typed_repr(ch, ks[i], Some(kt)) + ": " + typed_repr(ch, vs[i], Some(vt)))
                        i = i + 1
                    }
                    sb.append("]")
                    return sb.build()
                },
                _ => {},
            }
        },
        Type.TStruct(sn, args) => {
            match v {
                Value.VStruct(n, names, vals) => {
                    let fields = ch.struct_field_types(sn, args)
                    var sb = StringBuilder()
                    sb.append(n + " { ")
                    var i = 0
                    while i < names.len() {
                        if i > 0 { sb.append(", ") }
                        var ft: Option<Type> = None
                        for f in fields { if f.name == names[i] { ft = Some(f.ty) } }
                        sb.append(names[i] + ": " + typed_repr(ch, vals[i], ft))
                        i = i + 1
                    }
                    sb.append(" }")
                    return sb.build()
                },
                _ => {},
            }
        },
        Type.TEnum(en, args) => {
            match v {
                Value.VEnum(n, vr, pl) => {
                    if pl.len() == 0 { return n + "." + vr }
                    var ts: [Type] = []
                    if en == "Option" && args.len() == 1 { ts = [args[0]] }
                    else if en == "Result" && args.len() == 2 { ts = if vr == "Ok" { [args[0]] } else { [args[1]] } }
                    else { ts = match ch.enum_variant_payload(en, args, vr) { Some(p) => p, None => [] } }
                    if ts.len() == pl.len() { return n + "." + vr + "(" + typed_reprs(ch, pl, ts) + ")" }
                },
                _ => {},
            }
        },
        _ => {},
    }
    return py_repr(v)
}

fun typed_reprs(ch: Checker, vs: [Value], ts: [Type]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < vs.len() {
        if i > 0 { sb.append(", ") }
        sb.append(typed_repr(ch, vs[i], Some(ts[i])))
        i = i + 1
    }
    return sb.build()
}

// The error type of a test function's `Result<(), E>`, None for another.
#test(Some(Type.TEnum("Result", [Type.TTuple([]), Type.TStr])))[Some(Type.TStr)]
#test(None)[None]
fun err_type(rt: Option<Type>) -> Option<Type> {
    return match rt { Some(Type.TEnum(en, args)) => if en == "Result" && args.len() == 2 { Some(args[1]) } else { None }, _ => None }
}

#test(true)["True"]
#test(false)["False"]
fun bool_repr(b: bool) -> str {
    if b { return "True" }
    return "False"
}

#test([Value.VChar(53)])["53"]
#test([Value.VChar(113)])["113"]
#test([Value.VInt(4), Value.VInt(2)])["4, 2"]
fun reprs(vs: [Value]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < vs.len() {
        if i > 0 { sb.append(", ") }
        sb.append(py_repr(vs[i]))
        i = i + 1
    }
    return sb.build()
}

#test("a", ["x"], [Value.VChar(113)])["a { x: 113 }"]
#test("y", [], [Value.VInt(0), Value.VInt(0)])["y {  }"]
#test("x", ["T", "E"], [Value.VInt(4), Value.VInt(2)])["x { T: 4, E: 2 }"]
fun struct_repr(n: str, names: [str], vals: [Value]) -> str {
    var sb = StringBuilder()
    sb.append(n + " { ")
    var i = 0
    while i < names.len() {
        if i > 0 { sb.append(", ") }
        sb.append(names[i] + ": " + py_repr(vals[i]))
        i = i + 1
    }
    sb.append(" }")
    return sb.build()
}

#test("a", "a", [Value.VChar(113)])["a.a(113)"]
#test("x", "x", [Value.VInt(4), Value.VInt(2)])["x.x(4, 2)"]
#test("let", "let", [Value.VInt(1), Value.VInt(2)])["let.let(1, 2)"]
fun enum_repr(en: str, vr: str, pl: [Value]) -> str {
    if pl.len() == 0 { return en + "." + vr }
    return en + "." + vr + "(" + reprs(pl) + ")"
}

#test([Value.VChar(53)], [Value.VChar(53)])["[53: 53]"]
#test([Value.VChar(113)], [Value.VChar(113)])["[113: 113]"]
#test([Value.VInt(4), Value.VInt(2)], [Value.VInt(4), Value.VInt(2)])["[4: 4, 2: 2]"]
fun map_repr(ks: [Value], vs: [Value]) -> str {
    var sb = StringBuilder()
    sb.append("[")
    var i = 0
    while i < ks.len() {
        if i > 0 { sb.append(", ") }
        sb.append(py_repr(ks[i]) + ": " + py_repr(vs[i]))
        i = i + 1
    }
    sb.append("]")
    return sb.build()
}

// Python's repr of bytes: b'…' with printable ASCII as is.
#test([])["b''"]
#test([0, 1])["b'\\x00\\x01'"]
fun bytes_repr(bs: [int64]) -> str {
    var has_single = false
    var has_double = false
    for b in bs {
        if b == 39 { has_single = true }
        if b == 34 { has_double = true }
    }
    var quote: int64 = 39
    if has_single && !has_double { quote = 34 }
    var sb = StringBuilder()
    sb.append("b" + cp_utf8(quote as int32))
    for b in bs {
        if b == quote || b == 92 {
            sb.append("\\" + cp_utf8(b as int32))
        } else if b == 9 {
            sb.append("\\t")
        } else if b == 10 {
            sb.append("\\n")
        } else if b == 13 {
            sb.append("\\r")
        } else if b < 32 || b >= 127 {
            sb.append("\\x" + hex2(b as int32))
        } else {
            sb.append(cp_utf8(b as int32))
        }
    }
    sb.append(cp_utf8(quote as int32))
    return sb.build()
}

// Two maps hold the same entries, in whatever order (a #test's expected map
// against the actual one, as the Python interpreter compares dicts).
#test(mapv_of([Value.VChar(53)], [Value.VChar(53)]), mapv_of([Value.VChar(53)], [Value.VChar(53)]))[true]
#test(mapv_of([Value.VInt(1), Value.VInt(2)], [Value.VInt(10), Value.VInt(20)]), mapv_of([Value.VInt(2), Value.VInt(1)], [Value.VInt(20), Value.VInt(10)]))[true]
#test(mapv_of([Value.VInt(1), Value.VInt(2)], [Value.VInt(10), Value.VInt(20)]), mapv_of([Value.VInt(2), Value.VInt(1)], [Value.VInt(20), Value.VInt(11)]))[false]
#test(mapv_of([Value.VStr("a")], [Value.VInt(1)]), mapv_of([Value.VStr("b")], [Value.VInt(1)]))[false]
fun maps_eq(a: MapV, b: MapV) -> bool {
    if a.count != b.count { return false }
    var i = 0
    while i < a.ks.len() {
        if a.here[i] {
            var j = -1
            if is_plain_key(a.ks[i]) {
                j = b.place(a.ks[i])
            } else {
                // among b's keys of the same hash (both the interpreter's)
                var at = b.first_of(a.hashes[i])
                while at >= 0 && j < 0 {
                    if value_eq(b.ks[at], a.ks[i]) { j = at }
                    at = b.nexts[at]
                }
            }
            if j < 0 || !value_eq(a.vs[i], b.vs[j]) { return false }
        }
        i = i + 1
    }
    return true
}

#test([], [])[true]
#test([Value.VInt(5)], [Value.VInt(5)])[true]
#test([Value.VStruct("Vec2", ["x", "y"], [Value.VInt(1), Value.VInt(1)]), Value.VEnum("Color", "Red", [])], [Value.VStruct("Vec2", ["x", "y"], [Value.VInt(1), Value.VInt(1)]), Value.VEnum("Color", "Blue", [])])[false]
fun values_eq(a: [Value], b: [Value]) -> bool {
    if a.len() != b.len() { return false }
    var i = 0
    while i < a.len() {
        if !value_eq(a[i], b[i]) { return false }
        i = i + 1
    }
    return true
}

#test(Value.VStruct("Box", ["v"], [Value.VInt(1)]), "v")[Value.VInt(1)]
#test(Value.VStruct("Account", ["balance"], [Value.VInt(18)]), "balance")[Value.VInt(18)]
#test(Value.VStruct("Point", ["x", "y"], [Value.VInt(-3), Value.VInt(1)]), "x")[Value.VInt(-3)]
fun get_field(v: Value, field: str) -> Value {
    match v {
        Value.VStruct(n, names, vals) => {
            var i = 0
            while i < names.len() {
                if names[i] == field { return vals[i] }
                i = i + 1
            }
        },
        _ => {},
    }
    return Value.VUnit
}

// `c[k]`; a map's value at the place `place` of `k` (`Interp.place_in`).
#test(Value.VStr("a"), Value.VInt(0), -1)[Value.VInt(97)]
#test(Value.VList([Value.VInt(1), Value.VInt(2)]), Value.VInt(1), -1)[Value.VInt(2)]
#test(Value.VList([Value.VList([Value.VInt(1), Value.VInt(20)]), Value.VList([Value.VInt(3), Value.VInt(4), Value.VInt(5)])]), Value.VInt(1), -1)[Value.VList([Value.VInt(3), Value.VInt(4), Value.VInt(5)])]
#test(Value.VMap(mapv_of([Value.VChar(120)], [Value.VInt(2)])), Value.VChar(120), 0)[Value.VInt(2)]
fun index_get(c: Value, k: Value, place: int32) -> Value {
    return match c {
        Value.VList(xs) => xs[as_int(k) as int32],
        Value.VStr(s) => Value.VInt(s[as_int(k) as int32] as int64),
        Value.VMap(m) => {
            if place < 0 { return Value.VUnit }
            m.vs[place]
        },
        _ => Value.VUnit,
    }
}

#test([RtFrame { names: [], vals: [], defers: [] }])[[]]
#test([RtFrame { names: ["s"], vals: [Value.VStr("Hi")], defers: [] }, RtFrame { names: ["c"], vals: [Value.VInt(72)], defers: [] }])[[RtFrame { names: ["s"], vals: [Value.VStr("Hi")], defers: [] }]]
#test([RtFrame { names: ["s"], vals: [Value.VStr("apple")], defers: [] }, RtFrame { names: [], vals: [], defers: [] }, RtFrame { names: [], vals: [], defers: [] }])[[RtFrame { names: ["s"], vals: [Value.VStr("apple")], defers: [] }, RtFrame { names: [], vals: [], defers: [] }]]
fun drop_last_frame(xs: [RtFrame]) -> [RtFrame] {
    var out: [RtFrame] = []
    var i = 0
    while i < xs.len() - 1 {
        out.push(xs[i])
        i = i + 1
    }
    return out
}

// `Key.method`: a method's mangled name (plain function names have no dot).
#test("add")[false]
#test("inc")[false]
#test("mul")[false]
fun is_method_name(name: str) -> bool {
    for c in name.chars() {
        if c == '.' { return true }
    }
    return false
}

#test("a")["'a'"]
#test("d2")["'d2'"]
#test("right")["'right'"]
fun py_repr_str(s: str) -> str {
    var has_single = false
    var has_double = false
    for c in s.chars() {
        if c == '\'' { has_single = true }
        if c == '"' { has_double = true }
    }
    var quote = '\''
    if has_single && !has_double { quote = '"' }
    var sb = StringBuilder()
    sb.append(cp_utf8(quote as int32))
    for c in s.chars() {
        let cp = c as int32
        if c == '\\' { sb.append("\\\\") }
        else if c == quote { sb.append("\\" + cp_utf8(cp)) }
        else if cp == 10 { sb.append("\\n") }
        else if cp == 9 { sb.append("\\t") }
        else if cp == 13 { sb.append("\\r") }
        else if cp < 32 || (cp >= 127 && cp <= 160) || cp == 173 { sb.append(format("\\x{}", hex2(cp))) }
        else { sb.append(cp_utf8(cp)) }
    }
    sb.append(cp_utf8(quote as int32))
    return sb.build()
}

#test(24)["18"]
#test(50)["32"]
#test(108)["6c"]
fun hex2(v: int32) -> str {
    let digits = "0123456789abcdef"
    var sb = StringBuilder()
    sb.append_byte(digits[(v / 16) % 16])
    sb.append_byte(digits[v % 16])
    return sb.build()
}

// The lines a case printed (`captured`, the pieces as they were written),
// for the report; a last line without its newline counts.
#test(["a\nb", "c\n"])[["a", "bc"]]
#test([])[[]]
#test(["\n"])[[""]]
fun output_lines(pieces: [str]) -> [str] {
    var sb = StringBuilder()
    for p in pieces { sb.append(p) }
    let text = sb.build()
    var out: [str] = []
    var line = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == '\n' {
            out.push(line.build())
            line = StringBuilder()
        } else {
            line.append_byte(text[i])
        }
        i = i + 1
    }
    let rest = line.build()
    if rest.len() > 0 { out.push(rest) }
    return out
}

// How a call that was expected to fail ended instead: with its value, or,
// for a function without a result, by returning.
#test(checker_on("fun f() {}"), Value.VInt(2), true, None)["got 2"]
#test(checker_on("fun f() {}"), Value.VInt(-1), true, Some(Type.TInt(64, false)))["got 18446744073709551615"]
#test(checker_on("fun f() {}"), Value.VUnit, false, None)["the call returned"]
fun returned_text(ch: Checker, v: Value, returns: bool, t: Option<Type>) -> str {
    if !returns { return "the call returned" }
    return "got " + typed_repr(ch, v, t)
}

#test(["a", "b"])["a; b"]
#test([])[""]
fun join_parts(parts: [str]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < parts.len() {
        if i > 0 { sb.append("; ") }
        sb.append(parts[i])
        i = i + 1
    }
    return sb.build()
}

// `text` with the loader's module ids taken off the names in it:
// `std$fs$IoError.NotFound` is `IoError.NotFound`.
#test("std$fs$IoError.NotFound")["IoError.NotFound"]
#test("P { x: a$Q { y: 1 } }")["P { x: Q { y: 1 } }"]
#test("plain")["plain"]
fun without_module_ids(text: str) -> str {
    var sb = StringBuilder()
    var word = StringBuilder()
    var i = 0
    while i < text.len() {
        let c = text[i]
        if c == '$' {
            word = StringBuilder()
        } else if is_name_byte(c) {
            word.append_byte(c)
        } else {
            sb.append(word.build())
            word = StringBuilder()
            sb.append_byte(c)
        }
        i = i + 1
    }
    sb.append(word.build())
    return sb.build()
}

#test('a')[true]
#test('_')[true]
#test('7')[true]
#test(' ')[false]
fun is_name_byte(c: uint8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// `text` for a report line: its newlines shown as `\n`.
#test("expected a\n, got b")["expected a\\n, got b"]
#test("plain")["plain"]
fun on_one_line(text: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == '\n' { sb.append("\\n") } else { sb.append_byte(text[i]) }
        i = i + 1
    }
    return sb.build()
}
