// floatlit.my -- float literals to IEEE-754 bit patterns, in integer arithmetic.
//
// The code generators and the interpreter need the exact value of a literal
// such as `0.1f32`. The Python toolchain takes `float(text)` (the correctly
// rounded double) and, for a float32, rounds that double again to single
// precision. This does the same with big integers, so the compiler itself
// needs no float arithmetic (MYLA-29).
//
// A big integer is a list of 32-bit limbs held in uint64, least significant
// first, with no high zero limbs (zero is the empty list).

const LIMB: uint64 = 4294967296
const F64_INF: uint64 = 9218868437227405312     // 0x7ff0000000000000

fun big_norm(a: [uint64]) -> [uint64] {
    var r = a
    while len(r) > 0 && r[len(r) - 1] == 0 {
        pop(r)
    }
    return r
}

fun big_from_u64(x: uint64) -> [uint64] {
    return big_norm([x % LIMB, x / LIMB])
}

// a * m + add, for m, add < 2^32
fun big_mul_add(a: [uint64], m: uint64, add: uint64) -> [uint64] {
    var out: [uint64] = []
    var carry = add
    for limb in a {
        let t = limb * m + carry
        push(out, t % LIMB)
        carry = t / LIMB
    }
    if carry > 0 {
        push(out, carry)
    }
    return big_norm(out)
}

fun u64_bitlen(x: uint64) -> int32 {
    var n = 0
    var v = x
    while v > 0 {
        v = v >> 1
        n = n + 1
    }
    return n
}

fun big_bitlen(a: [uint64]) -> int32 {
    if len(a) == 0 {
        return 0
    }
    return (len(a) as int32 - 1) * 32 + u64_bitlen(a[len(a) - 1])
}

fun big_bit(a: [uint64], i: int32) -> bool {
    let limb = i / 32
    if limb >= len(a) as int32 {
        return false
    }
    return ((a[limb] >> ((i % 32) as uint64)) & 1) == 1
}

// whether any of the low `n` bits of `a` is set
fun big_low_bits_set(a: [uint64], n: int32) -> bool {
    var i = 0
    while i < n {
        if big_bit(a, i) {
            return true
        }
        i = i + 1
    }
    return false
}

fun big_shl(a: [uint64], s: int32) -> [uint64] {
    if len(a) == 0 {
        return a
    }
    var out: [uint64] = []
    var i = 0
    while i < s / 32 {
        push(out, 0)
        i = i + 1
    }
    let bits = (s % 32) as uint64
    var carry: uint64 = 0
    for limb in a {
        let t = (limb << bits) | carry
        push(out, t % LIMB)
        carry = t / LIMB
    }
    if carry > 0 {
        push(out, carry)
    }
    return big_norm(out)
}

fun big_shr(a: [uint64], s: int32) -> [uint64] {
    let skip = s / 32
    let bits = (s % 32) as uint64
    var out: [uint64] = []
    var i = skip
    while i < len(a) as int32 {
        var t = a[i] >> bits
        if i + 1 < len(a) as int32 && bits > 0 {
            t = t | ((a[i + 1] << (32 - bits)) % LIMB)
        }
        push(out, t)
        i = i + 1
    }
    return big_norm(out)
}

fun big_cmp(a: [uint64], b: [uint64]) -> int32 {
    if len(a) != len(b) {
        return match len(a) < len(b) { true => -1, false => 1 }
    }
    var i = len(a) as int32 - 1
    while i >= 0 {
        if a[i] != b[i] {
            return match a[i] < b[i] { true => -1, false => 1 }
        }
        i = i - 1
    }
    return 0
}

// a - b, for a >= b
fun big_sub(a: [uint64], b: [uint64]) -> [uint64] {
    var out: [uint64] = []
    var borrow: uint64 = 0
    var i = 0
    while i < len(a) {
        var sub = borrow
        if i < len(b) {
            sub = sub + b[i]
        }
        if a[i] >= sub {
            push(out, a[i] - sub)
            borrow = 0
        } else {
            push(out, a[i] + LIMB - sub)
            borrow = 1
        }
        i = i + 1
    }
    return big_norm(out)
}

fun big_to_u64(a: [uint64]) -> uint64 {
    var r: uint64 = 0
    if len(a) > 0 {
        r = a[0]
    }
    if len(a) > 1 {
        r = r | (a[1] << 32)
    }
    return r
}

struct DivMod { q: [uint64], r: [uint64] }

// schoolbook binary long division; the quotients here have about 64 bits
fun big_divmod(n: [uint64], d: [uint64]) -> DivMod {
    var q: [uint64] = []
    var r: [uint64] = []
    var i = big_bitlen(n) - 1
    while i >= 0 {
        r = big_shl(r, 1)
        if big_bit(n, i) {
            r = big_mul_add(r, 1, 1)
        }
        q = big_shl(q, 1)
        if big_cmp(r, d) >= 0 {
            r = big_sub(r, d)
            q = big_mul_add(q, 1, 1)
        }
        i = i - 1
    }
    return DivMod { q: q, r: r }
}

// A rounded binary value: mant * 2^exp, or infinity.
struct Rounded { mant: uint64, exp: int32, inf: bool }

// Round v * 2^e0 (plus a nonzero tail below it when `sticky`) to nearest, ties
// to even, keeping at most `prec` significant bits and no bit below 2^emin
// (which makes subnormals come out right); infinity above 2^(emax+1).
fun round_binary(v: [uint64], e0: int32, sticky: bool, prec: int32, emin: int32, emax: int32) -> Rounded {
    let bl = big_bitlen(v)
    if bl == 0 {
        return Rounded { mant: 0, exp: 0, inf: false }
    }
    var drop = bl - prec
    if emin - e0 > drop {
        drop = emin - e0
    }
    var mant: uint64 = 0
    var e = e0
    if drop <= 0 {
        mant = big_to_u64(v)     // exact; a sticky tail alone rounds down
    } else {
        mant = big_to_u64(big_shr(v, drop))
        let half = big_bit(v, drop - 1)
        let rest = sticky || big_low_bits_set(v, drop - 1)
        if half && (rest || (mant & 1) == 1) {
            mant = mant + 1
        }
        e = e0 + drop
        if mant == (1 as uint64) << (prec as uint64) {
            mant = mant >> 1
            e = e + 1
        }
    }
    if mant != 0 && u64_bitlen(mant) - 1 + e > emax {
        return Rounded { mant: 0, exp: 0, inf: true }
    }
    return Rounded { mant: mant, exp: e, inf: false }
}

// The double bits of the exact value mant * 2^e (representable as a double).
fun f64_bits_exact(r: Rounded) -> uint64 {
    if r.inf {
        return F64_INF
    }
    if r.mant == 0 {
        return 0
    }
    let bl = u64_bitlen(r.mant)
    let top = bl - 1 + r.exp
    if top >= -1022 {
        let m53 = r.mant << ((53 - bl) as uint64)
        return (((top + 1023) as uint64) << 52) | (m53 - ((1 as uint64) << 52))
    }
    return r.mant << ((r.exp + 1074) as uint64)    // subnormal
}

// The correctly rounded double of a float literal's lexeme, such as
// `3.25`, `1_000.5e-3`, `2f32` (underscores and the suffix are ignored).
#test("0.5")[4602678819172646912u64]
#test("0.1")[4591870180066957722u64]
#test("2f32")[4611686018427387904u64]
#test("1e400")[9218868437227405312u64]
pub fun f64_literal_bits(lexeme: str) -> uint64 {
    var n: [uint64] = []
    var digits = 0               // significant digits seen (for the zero test)
    var frac = 0                 // digits after the point
    var in_frac = false
    var exp = 0
    var exp_neg = false
    var in_exp = false
    var i = 0
    while i < len(lexeme) {
        let c = lexeme[i]
        if c == 'f' {
            break                // the suffix
        } else if c == '_' {
            i = i + 1
            continue
        } else if c == '.' {
            in_frac = true
        } else if c == 'e' || c == 'E' {
            in_exp = true
        } else if c == '-' {
            exp_neg = true
        } else if c == '+' {
            exp_neg = false
        } else if in_exp {
            if exp < 100000 {
                exp = exp * 10 + (c - '0') as int32
            }
        } else {
            n = big_mul_add(n, 10, (c - '0') as uint64)
            if len(n) > 0 {
                digits = digits + 1
            }
            if in_frac {
                frac = frac + 1
            }
        }
        i = i + 1
    }
    if len(n) == 0 {
        return 0
    }
    if exp_neg {
        exp = -exp
    }
    let e10 = exp - frac
    if e10 >= 0 {
        if e10 > 400 {
            return F64_INF
        }
        return f64_bits_exact(round_binary(big_mul_pow10(n, e10), 0, false, 53, -1074, 1023))
    }
    if digits + e10 < -400 {
        return 0
    }
    let d = big_mul_pow10([1], -e10)
    var s = 64 + big_bitlen(d) - big_bitlen(n)
    if s < 0 {
        s = 0
    }
    let qr = big_divmod(big_shl(n, s), d)
    return f64_bits_exact(round_binary(qr.q, -s, len(qr.r) > 0, 53, -1074, 1023))
}

fun big_mul_pow10(n: [uint64], k: int32) -> [uint64] {
    var r = n
    var i = 0
    while i < k {
        r = big_mul_add(r, 10, 0)
        i = i + 1
    }
    return r
}

// Round a double (given as bits) to single precision and widen it back: the
// double bits of the float32 nearest to it, as the Python toolchain does.
#test(4591870180066957722u64)[4591870180174331904u64]
#test(9218868437227405312u64)[9218868437227405312u64]
pub fun f32_round_bits(bits: uint64) -> uint64 {
    let sign = bits & 9223372036854775808u64
    let biased = ((bits >> 52) & 2047) as int32
    if biased == 2047 {
        return bits                  // inf / nan stay as they are
    }
    var mant = bits & 4503599627370495
    var e = -1074
    if biased > 0 {
        mant = mant | ((1 as uint64) << 52)
        e = biased - 1075
    }
    return sign | f64_bits_exact(round_binary(big_from_u64(mant), e, false, 24, -149, 127))
}
