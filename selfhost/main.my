// main.my -- the unified `myla` command-line tool (self-hosting).
//
// Dispatches subcommands, mirroring the Python `myla` CLI:
//
//   myla run   <file.my> [--stdlib <dir>] [args...]   interpret a program
//   myla test  <file.my> [--stdlib <dir>]             run its #test cases
//   myla build <file.my> [-o <out>] [-g] [--stdlib <dir>]  compile to a native binary
//   myla repl  [--stdlib <dir>]                       the interactive interpreter (repl.my)
//
// `run` passes the arguments after the file to the program (its argv is the
// file, then those), as the Python `myla run` does. `build` type-checks and
// generates x86-64 assembly (with `-g`, DWARF line tables for gdb, MYLA-71),
// writes it to `<out>.s`, then shells out to the system assembler and linker
// (`as`/`ld`, located via `/usr/bin/env` so PATH is honored) to produce the
// executable `<out>`, and removes the intermediate files. The stdlib root
// defaults to `src/myla` next to the `build/` directory this binary is in
// (`default_stdlib_root`, MYLA-31).

from std.process import args, exit, run, Output, ExitStatus, SpawnError
from std.io import write, eprintln
from std.fs import write_to_file
from .repl import repl
from .loader import load_program, file_of, default_stdlib_root, Loaded
from .diag import render, type_report, Report
from .checker import build_checker_decls, Checker, CheckErr
from .codegen import new_codegen
from .interp import new_interp, RtError

// Decode a captured `[uint8]` buffer (e.g. a child's stderr) as UTF-8 text.
fun decode(bytes: [uint8]) -> str {
    var sb = StringBuilder()
    for b in bytes { append_byte(sb, b) }
    return build(sb)
}

// A checked program, and the linked one (for the files of its node ids).
struct Checked { checker: Checker, prog: Loaded }

// Load, link and type-check the program rooted at `file`. Errors are carried as
// the diagnostic text to print.
fun load_and_check(file: str, stdlib: str) -> Result<Checked, str> {
    let prog = match load_program(file, stdlib) {
        Ok(p) => p,
        Err(r) => { return Err(render(r)) },
    }
    return match build_checker_decls(prog.decls, prog.next_id) {
        Ok(c) => Ok(Checked { checker: c, prog: prog }),
        Err(e) => Err(render(type_report(e.line, e.col, e.msg, file_of(prog, e.decl)))),
    }
}

// Type-check `file`, then generate its x86-64 assembly (`debug`: with DWARF
// line tables, MYLA-71).
fun compile_asm(file: str, stdlib: str, debug: bool) -> Result<str, str> {
    let ch = load_and_check(file, stdlib)?
    var g = new_codegen(ch.checker)
    g.set_sources(ch.prog.spans, ch.prog.next_id)
    if debug { g.enable_debug_info() }
    return Ok(g.generate())
}

// Inspect a finished child's status; return true on failure (nonzero exit or a
// terminating signal), echoing its stderr and `label`.
fun step_failed(out: Output, label: str) -> bool {
    match out.status {
        ExitStatus.Exited(code) => {
            if code != 0 {
                eprintln(label)
                write(2, decode(out.stderr))
                return true
            }
            return false
        },
        ExitStatus.Signaled(sig) => {
            eprintln(label)
            return true
        },
    }
    return false
}

// Run one build step (`program args…`); return true on failure (nonzero exit,
// terminating signal, or spawn error), echoing the child's stderr and `label`.
fun run_step(program: str, argv: [str], label: str) -> bool {
    var failed = false
    match run(program, argv) {
        Ok(out) => {
            failed = step_failed(out, label)
        },
        Err(e) => {
            eprintln(label)
            failed = true
        },
    }
    return failed
}

// `myla run <file> [args]` / `myla test`: interpret the program with argv
// `[file, args...]`, or run its #test cases; the exit status.
fun cmd_interp(file: str, stdlib: str, tests: bool, prog_args: [str]) -> int32 {
    match load_and_check(file, stdlib) {
        Ok(ch) => {
            var argv = [file]
            for a in prog_args { push(argv, a) }
            var it = new_interp(ch.checker, argv)
            if tests {
                return it.run_tests()
            }
            let code = it.run()
            match it.rt_err {
                Some(r) => { eprintln(render(Report { kind: "runtime error", msg: r.msg, path: file_of(ch.prog, r.node), line: r.line, col: r.col })) },
                None => {},
            }
            return code
        },
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    return 0
}

// `myla build <file> -o <out> [stdlib]`: compile to a native binary at `out`.
fun cmd_build(file: str, output: str, stdlib: str, debug: bool) -> int32 {
    let asm = match compile_asm(file, stdlib, debug) {
        Ok(a) => a,
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    let asm_path = output + ".s"
    let obj_path = output + ".o"
    match write_to_file(asm_path, asm) {
        Ok(n) => {},
        Err(e) => {
            eprintln("myla: cannot write assembly to " + asm_path)
            return 1
        },
    }
    if run_step("/usr/bin/env", ["as", "--64", "-o", obj_path, asm_path], "myla: assembler failed") {
        return 1
    }
    if run_step("/usr/bin/env", ["ld", "-o", output, obj_path], "myla: linker failed") {
        return 1
    }
    // the assembly and object file were only steps (MYLA-35)
    if run_step("/usr/bin/env", ["rm", "-f", asm_path, obj_path], "myla: cannot remove the intermediate files") {
        return 1
    }
    return 0
}

fun usage() {
    eprintln("usage: myla <command> <file.my> [options]")
    eprintln("commands:")
    eprintln("  run   <file.my> [--stdlib <dir>] [args...]  interpret a program with these arguments")
    eprintln("  test  <file.my> [--stdlib <dir>]            run its #test cases")
    eprintln("  build <file.my> [-o <out>] [-g] [--stdlib <dir>]  compile to a binary (-g: line tables for gdb)")
    eprintln("  repl  [--stdlib <dir>]                      the interactive interpreter")
    eprintln("--stdlib: the directory holding std/ (default: src/myla next to this binary's build/ directory)")
}

fun main() {
    let argv = args()
    if len(argv) >= 2 && argv[1] == "repl" {
        var stdlib = default_stdlib_root(argv[0])
        if len(argv) == 4 && argv[2] == "--stdlib" {
            stdlib = argv[3]
        } else if len(argv) != 2 {
            usage()
            exit(2)
        }
        exit(repl(stdlib))
    }
    if len(argv) < 3 {
        usage()
        exit(2)
    }
    let cmd = argv[1]
    let file = argv[2]
    var stdlib = default_stdlib_root(argv[0])

    if cmd == "run" || cmd == "test" {
        // `--stdlib <dir>` anywhere; everything else goes to the program
        var rest: [str] = []
        var j = 3
        while j < len(argv) {
            if argv[j] == "--stdlib" && j + 1 < len(argv) {
                stdlib = argv[j + 1]
                j = j + 2
            } else {
                push(rest, argv[j])
                j = j + 1
            }
        }
        exit(cmd_interp(file, stdlib, cmd == "test", rest))
    }

    if cmd == "build" {
        var output = "a.out"
        var debug = false
        var j = 3
        while j < len(argv) {
            if argv[j] == "-o" && j + 1 < len(argv) {
                output = argv[j + 1]
                j = j + 2
            } else if argv[j] == "--stdlib" && j + 1 < len(argv) {
                stdlib = argv[j + 1]
                j = j + 2
            } else if argv[j] == "-g" {
                debug = true
                j = j + 1
            } else {
                eprintln("myla: unknown option '" + argv[j] + "'")
                usage()
                exit(2)
            }
        }
        exit(cmd_build(file, output, stdlib, debug))
    }

    eprintln("myla: unknown command '" + cmd + "'")
    usage()
    exit(2)
}
