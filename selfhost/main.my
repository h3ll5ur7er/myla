// main.my -- the unified `myla` command-line tool (self-hosting).
//
// With a file, the commands mirror the Python `myla` CLI:
//
//   myla run   <file.my> [options] [args...]          interpret a program
//   myla test  <file.my> [options]                    run its #test cases
//   myla build <file.my> [-o <out>] [-g] [options]    compile to a native binary
//   myla check <file.my> [options]                    type-check it (prints `ok`)
//   myla repl  [options]                              the interactive interpreter (repl.my)
//
// Without a file (the first argument after the command doesn't end in `.my`)
// they work on the project around the working directory, found by its
// `myla.toml` (project_cmd.my, MYLA-94, D73): `myla build [-g]` writes
// `build/<name>`, `myla run [args...]` interprets `src/main.my`, `myla test` and
// `myla check` take every file under `src/`; and `myla new <name>` creates a
// project, `myla clean [--deps]` removes `build/` (and `.myla/`), `myla fetch
// [--update]` resolves the Git dependencies and writes `myla.lock` (MYLA-95).
//
// The options, before or after the file: `--stdlib <dir>`, `--package
// name=dir` (repeatable), a dependency whose modules `import name…` finds in
// `dir` (MYLA-92), and `--root <dir>`, the project root (D162: `myla test`
// runs a project's test programs through this tool with it). `run` passes the other arguments after the file to the
// program (its argv is the file, then those), as the Python `myla run` does.
// What the commands do with a file is in driver.my. The standard library is
// the one this binary carries, unless `--stdlib` or MYLA_STDLIB name a
// directory (`default_stdlib_root`, MYLA-243).

from std.process import args, exit
from std.io import eprintln, println
from std.platform import TARGET
from .repl import repl
from .loader import load_options, LoadOptions, parse_package_flag
from .stdroot import default_stdlib_root
from .diag import render
from .driver import cmd_build, cmd_interp, cmd_test, load_and_check
from .interp import TestOptions, all_tests
from .project_cmd import project_build, project_run, project_test, project_check, project_clean, project_new, project_fetch, ends_with

// The usage text, a line each (MYLA-178: `--help` prints it on stdout).
fun usage_lines() -> [str] {
    return [
        "usage: myla <command> [<file.my>] [options]",
        "commands on a file:",
        "  run   <file.my> [options] [args...]  interpret a program with these arguments",
        "  test  <file.my> [--only <text>] [--list] [options]  run its #test cases (--only: those whose function's name has the text;",
        "                                       --list: name them without running them)",
        "  build <file.my> [-o <out>] [-g] [--target <t>] [options]  compile to a binary (-g: debug information for gdb;",
        "                                       <t>: x86_64-linux, aarch64-linux or wasm32-wasi; the default " + TARGET + ", this machine's)",
        "  check <file.my> [options]            type-check it",
        "  repl  [options]                      the interactive interpreter",
        "commands on the project around the working directory (myla.toml):",
        "  new   [--lib] <name>                 create a project in the directory <name> (--lib: a library)",
        "  build [-g] [--target <t>] [options]  compile src/main.my to build/<name>",
        "  run   [options] [args...]            interpret src/main.my with these arguments",
        "  test  [--only <text>] [--list] [options]  run the #test cases of every file under src/",
        "  check [options]                      type-check every file under src/",
        "  clean [--deps]                       remove build/ (--deps: and the fetched dependencies, .myla/)",
        "  fetch [--update]                     resolve the Git dependencies, check them out and write myla.lock",
        "options:",
        "  --stdlib <dir>        the directory holding std/ (default: $MYLA_STDLIB, else the standard library built into myla)",
        "  --package <name=dir>  a dependency: imports of <name> resolve in <dir> (repeatable)",
        "  --root <dir>          with a file: the project root its absolute imports resolve in (default: the file's directory;",
        "                        what `myla test` gives the test programs of tests/)",
    ]
}

fun usage() {
    for l in usage_lines() { eprintln(l) }
}

// A command's arguments: its file ("" in project mode), the load options,
// `build`'s output and `-g`, `clean`'s `--deps`, `fetch`'s `--update`, `new`'s
// name, `test`'s selection (D162), and the program's arguments (`run`).
struct CommandLine { file: str, opts: LoadOptions, output: str, debug: bool, target: str, deps: bool, update: bool, name: str, lib: bool, tests: TestOptions, rest: [str] }

// A command line that can't be run: the message, and whether the usage
// follows it (exit status 2; else 1).
struct CliError { msg: str, usage: bool }

// The arguments after the command; `--stdlib`, `--package` and `--root` anywhere, `-o`
// and `-g` for `build`, `--deps` for `clean`, `--update` for `fetch`,
// `--only` and `--list` for `test`. The first other argument is the file if
// it ends in `.my` (else there is none: project mode); then `run` passes the
// rest to the program, `new` takes one name, and other commands reject them.
#test(["/work/myla/selfhost/main.my", "new", "freshlib", "more"])[Err(CliError { msg: "myla: unknown option 'more'", usage: true })]
fun parse_command_line(argv: [str]) -> Result<CommandLine, CliError> {
    let cmd = argv[1]
    var cl = CommandLine { file: "", opts: load_options(default_stdlib_root()), output: "a.out", debug: false, target: TARGET, deps: false, update: false, name: "", lib: false, tests: all_tests(), rest: [] }
    var positional = 0
    var j = 2
    while j < argv.len() {
        let a = argv[j]
        let has_value = j + 1 < argv.len()
        if a == "--stdlib" && has_value {
            cl.opts.stdlib_root = argv[j + 1]
            j = j + 2
        } else if a == "--package" && has_value {
            match parse_package_flag(argv[j + 1]) {
                Ok(pkg) => { cl.opts.packages.push(pkg) },
                Err(r) => { return Err(CliError { msg: render(r), usage: false }) },
            }
            j = j + 2
        } else if a == "--root" && has_value {
            cl.opts.root = argv[j + 1]
            j = j + 2
        } else if cmd == "build" && a == "-o" && has_value {
            cl.output = argv[j + 1]
            j = j + 2
        } else if cmd == "build" && a == "-g" {
            cl.debug = true
            j = j + 1
        } else if cmd == "build" && a == "--target" && has_value {
            cl.target = argv[j + 1]
            if cl.target != "x86_64-linux" && cl.target != "aarch64-linux" && cl.target != "wasm32-wasi" {
                return Err(CliError { msg: "myla: unknown target '" + cl.target + "' (x86_64-linux, aarch64-linux, wasm32-wasi)", usage: false })
            }
            j = j + 2
        } else if cmd == "test" && a == "--only" && has_value {
            cl.tests.only = argv[j + 1]
            j = j + 2
        } else if cmd == "test" && a == "--list" {
            cl.tests.list = true
            j = j + 1
        } else if cmd == "clean" && a == "--deps" {
            cl.deps = true
            j = j + 1
        } else if cmd == "fetch" && a == "--update" {
            cl.update = true
            j = j + 1
        } else if cmd == "new" && a == "--lib" {
            // a library project (MYLA-244)
            cl.lib = true
            j = j + 1
        } else if cmd == "new" && cl.name == "" {
            cl.name = a
            j = j + 1
        } else if positional == 0 && cmd != "repl" && cmd != "new" && cmd != "clean" && cmd != "fetch" && ends_with(a, ".my") {
            cl.file = a
            positional = 1
            j = j + 1
        } else if cmd == "run" {
            cl.rest.push(a)
            positional = positional + 1
            j = j + 1
        } else {
            return Err(CliError { msg: "myla: unknown option '" + a + "'", usage: true })
        }
    }
    return Ok(cl)
}

fun main() {
    let argv = args()
    if argv.len() < 2 {
        usage()
        exit(2)
    }
    let cmd = argv[1]
    if cmd == "--help" || cmd == "-h" || cmd == "help" {
        for l in usage_lines() { println(l) }
        exit(0)
    }
    let known = ["run", "test", "build", "check", "repl", "new", "clean", "fetch"]
    var ok = false
    for k in known { if k == cmd { ok = true } }
    if !ok {
        eprintln("myla: unknown command '" + cmd + "'")
        usage()
        exit(2)
    }
    var cl = CommandLine { file: "", opts: load_options(""), output: "", debug: false, target: TARGET, deps: false, update: false, name: "", lib: false, tests: all_tests(), rest: [] }
    match parse_command_line(argv) {
        Ok(c) => { cl = c },
        Err(e) => {
            eprintln(e.msg)
            if e.usage {
                usage()
                exit(2)
            }
            exit(1)
        },
    }
    if cmd == "repl" {
        exit(repl(cl.opts.stdlib_root, cl.opts.packages))
    }
    if cmd == "new" {
        if cl.name == "" {
            usage()
            exit(2)
        }
        exit(project_new(cl.name, cl.lib))
    }
    if cmd == "clean" { exit(project_clean(cl.deps)) }
    if cmd == "fetch" { exit(project_fetch(cl.update)) }
    if cl.file == "" {
        // project mode (MYLA-94)
        if cmd == "build" { exit(project_build(cl.opts, cl.debug, cl.target)) }
        if cmd == "run" { exit(project_run(cl.opts, cl.rest)) }
        if cmd == "test" { exit(project_test(cl.opts, cl.tests)) }
        exit(project_check(cl.opts))
    }
    if cmd == "build" {
        exit(cmd_build(cl.file, cl.output, cl.opts, cl.debug, cl.target))
    }
    if cmd == "check" {
        match load_and_check(cl.file, cl.opts) {
            Ok(ch) => {
                print("ok")
                exit(0)
            },
            Err(e) => {
                eprintln(e)
                exit(1)
            },
        }
    }
    if cmd == "test" { exit(cmd_test(cl.file, cl.opts, cl.tests)) }
    exit(cmd_interp(cl.file, cl.opts, cl.rest))
}
