// main.my -- the unified `myla` command-line tool (self-hosting).
//
// Dispatches subcommands, mirroring the Python `myla` CLI:
//
//   myla run   <file.my> [options] [args...]          interpret a program
//   myla test  <file.my> [options]                    run its #test cases
//   myla build <file.my> [-o <out>] [-g] [options]    compile to a native binary
//   myla repl  [options]                              the interactive interpreter (repl.my)
//
// The options, before or after the file: `--stdlib <dir>`, and `--package
// name=dir` (repeatable), a dependency whose modules `import name…` finds in
// `dir` (MYLA-92). `run` passes the other arguments after the file to the
// program (its argv is the file, then those), as the Python `myla run` does. `build` type-checks and
// generates x86-64 assembly (with `-g`, DWARF debug information for gdb: line
// tables and variables, MYLA-71, MYLA-66),
// writes it to `<out>.s`, then shells out to the system assembler and linker
// (`as`/`ld`, located via `/usr/bin/env` so PATH is honored) to produce the
// executable `<out>`, and removes the intermediate files. The stdlib root
// defaults to `src/myla` next to the `build/` directory this binary is in
// (`default_stdlib_root`, MYLA-31).

from std.process import args, exit, run, Output, ExitStatus, SpawnError
from std.io import write, eprintln
from std.fs import write_to_file
from .repl import repl
from .loader import load_program_opts, load_options, LoadOptions, parse_package_flag, file_of, default_stdlib_root, Loaded
from .diag import render, type_report, Report
from .checker import build_checker_decls, Checker, CheckErr
from .codegen import new_codegen
from .interp import new_interp, RtError

// Decode a captured `[uint8]` buffer (e.g. a child's stderr) as UTF-8 text.
fun decode(bytes: [uint8]) -> str {
    var sb = StringBuilder()
    for b in bytes { append_byte(sb, b) }
    return build(sb)
}

// A checked program, and the linked one (for the files of its node ids).
struct Checked { checker: Checker, prog: Loaded }

// Load, link and type-check the program rooted at `file`, as `opts` says.
// Errors are carried as the diagnostic text to print.
fun load_and_check(file: str, opts: LoadOptions) -> Result<Checked, str> {
    let prog = match load_program_opts(file, opts) {
        Ok(p) => p,
        Err(r) => { return Err(render(r)) },
    }
    return match build_checker_decls(prog.decls, prog.next_id) {
        Ok(c) => Ok(Checked { checker: c, prog: prog }),
        Err(e) => Err(render(type_report(e.line, e.col, e.sp, e.msg, file_of(prog, e.decl)))),
    }
}

// Type-check `file`, then generate its x86-64 assembly (`debug`: with DWARF
// debug information, MYLA-71, MYLA-66).
fun compile_asm(file: str, opts: LoadOptions, debug: bool) -> Result<str, str> {
    let ch = load_and_check(file, opts)?
    var g = new_codegen(ch.checker)
    g.set_sources(ch.prog.spans, ch.prog.next_id)
    if debug { g.enable_debug_info() }
    return Ok(g.generate())
}

// Inspect a finished child's status; return true on failure (nonzero exit or a
// terminating signal), echoing its stderr and `label`.
fun step_failed(out: Output, label: str) -> bool {
    match out.status {
        ExitStatus.Exited(code) => {
            if code != 0 {
                eprintln(label)
                write(2, decode(out.stderr))
                return true
            }
            return false
        },
        ExitStatus.Signaled(sig) => {
            eprintln(label)
            return true
        },
    }
    return false
}

// Run one build step (`program args…`); return true on failure (nonzero exit,
// terminating signal, or spawn error), echoing the child's stderr and `label`.
fun run_step(program: str, argv: [str], label: str) -> bool {
    var failed = false
    match run(program, argv) {
        Ok(out) => {
            failed = step_failed(out, label)
        },
        Err(e) => {
            eprintln(label)
            failed = true
        },
    }
    return failed
}

// `myla run <file> [args]` / `myla test`: interpret the program with argv
// `[file, args...]`, or run its #test cases; the exit status.
fun cmd_interp(file: str, opts: LoadOptions, tests: bool, prog_args: [str]) -> int32 {
    match load_and_check(file, opts) {
        Ok(ch) => {
            var argv = [file]
            for a in prog_args { push(argv, a) }
            var it = new_interp(ch.checker, argv)
            if tests {
                return it.run_tests()
            }
            let code = it.run()
            match it.rt_err {
                Some(r) => { eprintln(render(Report { kind: "runtime error", msg: r.msg, path: file_of(ch.prog, r.node), line: r.line, col: r.col, sp: r.sp })) },
                None => {},
            }
            return code
        },
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    return 0
}

// `myla build <file> -o <out>`: compile to a native binary at `out`.
fun cmd_build(file: str, output: str, opts: LoadOptions, debug: bool) -> int32 {
    let asm = match compile_asm(file, opts, debug) {
        Ok(a) => a,
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    let asm_path = output + ".s"
    let obj_path = output + ".o"
    match write_to_file(asm_path, asm) {
        Ok(n) => {},
        Err(e) => {
            eprintln("myla: cannot write assembly to " + asm_path)
            return 1
        },
    }
    if run_step("/usr/bin/env", ["as", "--64", "-o", obj_path, asm_path], "myla: assembler failed") {
        return 1
    }
    if run_step("/usr/bin/env", ["ld", "-o", output, obj_path], "myla: linker failed") {
        return 1
    }
    // the assembly and object file were only steps (MYLA-35)
    if run_step("/usr/bin/env", ["rm", "-f", asm_path, obj_path], "myla: cannot remove the intermediate files") {
        return 1
    }
    return 0
}

fun usage() {
    eprintln("usage: myla <command> <file.my> [options]")
    eprintln("commands:")
    eprintln("  run   <file.my> [options] [args...]  interpret a program with these arguments")
    eprintln("  test  <file.my> [options]            run its #test cases")
    eprintln("  build <file.my> [-o <out>] [-g] [options]  compile to a binary (-g: debug information for gdb)")
    eprintln("  repl  [options]                      the interactive interpreter")
    eprintln("options:")
    eprintln("  --stdlib <dir>        the directory holding std/ (default: src/myla next to this binary's build/ directory)")
    eprintln("  --package <name=dir>  a dependency: imports of <name> resolve in <dir> (repeatable)")
}

// A command's arguments: its file ("" for none), the load options, `build`'s
// output and `-g`, and the program's arguments (`run`).
struct CommandLine { file: str, opts: LoadOptions, output: str, debug: bool, rest: [str] }

// A command line that can't be run: the message, and whether the usage
// follows it (exit status 2; else 1).
struct CliError { msg: str, usage: bool }

// The arguments after the command; `--stdlib` and `--package` anywhere, `-o`
// and `-g` for `build`; the first other argument is the file, `run` and
// `test` pass the rest to the program, other commands reject them.
fun parse_command_line(argv: [str]) -> Result<CommandLine, CliError> {
    let cmd = argv[1]
    var cl = CommandLine { file: "", opts: load_options(default_stdlib_root(argv[0])), output: "a.out", debug: false, rest: [] }
    var j = 2
    while j < len(argv) {
        let a = argv[j]
        let has_value = j + 1 < len(argv)
        if a == "--stdlib" && has_value {
            cl.opts.stdlib_root = argv[j + 1]
            j = j + 2
        } else if a == "--package" && has_value {
            match parse_package_flag(argv[j + 1]) {
                Ok(pkg) => { push(cl.opts.packages, pkg) },
                Err(r) => { return Err(CliError { msg: render(r), usage: false }) },
            }
            j = j + 2
        } else if cmd == "build" && a == "-o" && has_value {
            cl.output = argv[j + 1]
            j = j + 2
        } else if cmd == "build" && a == "-g" {
            cl.debug = true
            j = j + 1
        } else if cl.file == "" && cmd != "repl" {
            cl.file = a
            j = j + 1
        } else if cmd == "run" || cmd == "test" {
            push(cl.rest, a)
            j = j + 1
        } else {
            return Err(CliError { msg: "myla: unknown option '" + a + "'", usage: true })
        }
    }
    return Ok(cl)
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        usage()
        exit(2)
    }
    let cmd = argv[1]
    if cmd != "run" && cmd != "test" && cmd != "build" && cmd != "repl" {
        eprintln("myla: unknown command '" + cmd + "'")
        usage()
        exit(2)
    }
    var cl = CommandLine { file: "", opts: load_options(""), output: "", debug: false, rest: [] }
    match parse_command_line(argv) {
        Ok(c) => { cl = c },
        Err(e) => {
            eprintln(e.msg)
            if e.usage {
                usage()
                exit(2)
            }
            exit(1)
        },
    }
    if cmd == "repl" {
        exit(repl(cl.opts.stdlib_root, cl.opts.packages))
    }
    if cl.file == "" {
        usage()
        exit(2)
    }
    if cmd == "build" {
        exit(cmd_build(cl.file, cl.output, cl.opts, cl.debug))
    }
    exit(cmd_interp(cl.file, cl.opts, cmd == "test", cl.rest))
}
