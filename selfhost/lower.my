// lower.my -- the checked AST of a function or lambda → IR (MYLA-103 to
// MYLA-107, D79; wiki: Architecture/IR).
//
// `lower_function` and `lower_lambda` read the code generator's state (the
// checker's types, the signatures, the layouts, the monomorphizer's
// substitution) and build an `IrFunc`, with the lambda bodies and thunks it
// needs (`Lowered`), which the code generator verifies and emits. Every
// construct is lowered:
//
// - scalars, with their operators, traps and casts; aggregates (structs,
//   tuples, enums) in slots reached through addresses, a recursive enum's
//   members boxed; strings, lists, maps, builders and function values;
// - every statement, `match` with every kind of pattern, `?`, calls (direct,
//   generic, methods, through function values), lambdas, partial
//   application, composition, and the builtins;
// - every ownership rule as an instruction: a local owns its value (a binding
//   copies and retains; owners are dropped at the end of their scope, before
//   `return` and on `break`/`continue`); an owned temporary (a call's result,
//   a new string, list or map, an aggregate literal holding one) is dropped at
//   the end of its statement, or right after a condition, a guard or an
//   operand of `&&`/`||`; parameters and match bindings borrow; an assignment
//   retains the new value before it releases the old one (`p = p`); a value
//   bound for a container waits in an owning slot until it is stored; a match
//   copies its scrutinee, and retains the copy only when an arm may write the
//   variable it came from.
//
// It keeps the old one-pass path's order of evaluation, scopes, positions and
// copies, which the Python backend shares, so both backends behave alike.

from std.num import f64_literal_bits, f32_round_bits
from .ast import Expr, ExprKind, Stmt, StmtKind, Block, FunData, ElseTail, ExprOrBlock, MatchArm, Pattern, PatternKind, FieldInit, MapEntry, BindElem, bind_elems, Param, call_targs
from .checker import CheckErr, REG_ARG_WORDS, type_name, Type, is_unit, is_slice_expr, from_end_of, slice_parts, is_hole_part, is_raw_memory_primitive, is_platform_primitive, Subst, FuncSig, opt_subst_type, subst_type, builtin_method, is_wrapping_method, int_op_overflows, int_min
from .checker import is_notify_primitive
from .codegen import codegen_on, type_job_name, recv_by_address, may_write_expr, is_mutating_builtin, list_has_str, contains_int, is_actor_t, is_sb_t, is_async_t, CodeGen, LamJob, PartialJob, Cap, DropEntry, tfunc_params, tfunc_ret, is_hole_expr, mangle_fn, is_builtin_call_name, is_aggregate, tuple_elems, is_struct_or_enum_t, is_tfunc, is_overloadable_op, arith_method_cg, enum_name_of, is_tstr, is_cmp, place_root, is_aggregate_opt, arms_may_write, is_cell_t, list_elem, is_list_t, is_map_t, is_str_t, map_key, map_val, format_segments, args_have_hole, success_variant, failure_variant
from .util import format_specs
from .tokens import Note, no_span
from .ir_x86 import slots_at, frame_size
from .ir import IrFunc, IrBlock, Inst, Term, Slot, Pos, Instance, ENV_WORD, Intrinsic, primitive_intrinsic
from .ir_util import is_char_type
from .parser import expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of  // AST values for #test cases (MYLA-184)

// A name in scope: the slot holding it.
// A variable in scope; `fixed`: nothing writes it while it lives (a `let`,
// a parameter other than `var self`, a capture, a `for` loop's element), so
// a `let` copying a part of it can borrow (MYLA-122).
struct Local { name: str, slot: int32, fixed: bool }

// What the lowering knows of a slot's value for bounds checks (MYLA-251):
// a range loop's variable below the length of the list or string `key`
// names (`len_key`), or a `let` holding that length.
struct LenFact { slot: int32, key: str }

// Where `continue` and `break` go in the innermost loop, and how many owner
// and temporary scopes were open when it began (those it leaves are dropped).
struct LoopTarget { cont: int32, brk: int32, owners: int32, temps: int32 }

// The function being lowered: the IR so far, the block instructions go to,
// the names in scope (innermost scope last), the owning slots of each scope
// (dropped when it ends), the owned temporaries of each statement or
// condition being lowered (dropped when it ends), the loops, the slot holding
// the result's address (an aggregate result, else -1), the bindings of the
// match arm being lowered, and the first construct that can't be lowered (""
// while there is none).
// `lams`, `partials` and `fnvals`: the lambda bodies, partial-application
// thunks and function-value thunks the function needs, which the code
// generator emits after it. `holder`: per temporary, the owning slot it was
// stored into, read from or is the address of (-1: none), for `take`.
// `into`: the slot the next aggregate `addr` makes may be built in (-1:
// none; see `build_slot`); `placed`: per temporary, whether it is the address
// of a value built there (a flag would be overwritten by a `return` nested in
// the value). `tail`: the next call lowered ends the function by `become`
// (D87); `tailed`: it did.
// `frame_fn`: an async function's frame function (D90), `result` the slot its
// result goes to (-1: none); `tasks`: the child tasks of the open scopes;
// `actor_self`: the slot of an actor method's `self`, whose actor its frame
// function holds between suspensions (D92), or -1; `deep_res`: an actor
// method's result is copied deeply before it leaves the actor (D92).
// `scope_ids`: the open scopes' indices in `f.scope_parent` (MYLA-183).
// `checked`: integer overflow traps here (D175's checked build, but not in
// the runtime, `checked_code`).
struct Lower { f: IrFunc, cur: int32, scopes: [[Local]], scope_ids: [int32], owners: [[int32]], temps: [[int32]], loops: [LoopTarget], sret: int32, arm_binds: [Local], err: str, lams: [LamJob], partials: [PartialJob], fnvals: [str], holder: [int32], into: int32, placed: [bool], tail: bool, tailed: bool, frame_fn: bool, result: int32, tasks: [TaskSlot], actor_self: int32, actor_off: int32, deep_res: bool, narrow: [int32: int32], wants: [Want], defers: [LDefer], received: int32, refused: [CheckErr], fn_name: str, by_addr: int32, by_addr_t: Type, resized: [str], scanned: bool, below: [LenFact], len_lets: [LenFact], nonneg: [int32], checked: bool }

// A per-type routine a routine built as IR calls, for the code generator to
// emit (MYLA-162): `kind` 0 a cell's deep copy, 1 an inline value's deep
// walk, 2 a boxed enum's contents' deep walk, 3 a copy-on-write clone, 4 a
// release walk, 5 a retain walk, 6 a cell type's drop routine; of
// type `t`, a deep clone's when `clone`.
pub struct Want { kind: int32, t: Type, clone: bool }

// A routine's IR and the routines it calls.
pub struct Routine { f: IrFunc, wants: [Want] }

// A function's IR, with the code it needs generated besides (see `Lower`).
// A child task of an `async let` (D89): the slot holding its frame, its
// result's type (`void`: none; `owns`: it owns heap memory), and the depth of
// the scope that joins it.
// `foreign`: a sibling's, which a child awaits (MYLA-148): never joined here
// (depth -1), its result read as a deep clone, the parent reading it too.
// `walk`: the release walk of a recursive enum result, held inline in the
// frame, "" for any other type (H3).
struct TaskSlot { slot: int32, ty: Type, void: bool, owns: bool, depth: int32, foreign: bool, walk: str }

// The release walk of a recursive enum `t` held inline (as a frame holds a
// child's result), "" for any other type.
fun boxed_drop_walk(cg: CodeGen, t: Type) -> str {
    if cg.is_boxed(t) { return cg.walk_label(t, false) }
    return ""
}

// `refused`: what the function can't be built for, at its place (an
// instance's `become` passing more stack words than it received, MYLA-272).
pub struct Lowered { f: IrFunc, lams: [LamJob], partials: [PartialJob], fnvals: [str], refused: [CheckErr], wants: [Want] }

// A deferred block (D135): the owners' scope it belongs to, and the names it
// sees, those of the first `nscopes` scopes, of the last only the first
// `nnames` (declared before it); the code generator it is lowered with (the
// function's, which doesn't change while it is lowered). Emitted where each
// way out of that scope leaves it.
struct LDefer { depth: int32, nscopes: int32, nnames: int32, body: Block, cg: CodeGen }

// A lowering of a function `test` without a result, at the start of its
// entry block, the receiver of `#test` cases of the lowering's methods
// (MYLA-184), with a code generator from `codegen_on` as their `cg`.
pub fun lower_on() -> Lower {
    var lw = Lower { f: IrFunc { name: "test", ret: None, slots: [], temps: [], blocks: [], order: [], instances: [], frame: false, scope_parent: [-1] }, cur: 0, scopes: [[]], scope_ids: [0], owners: [[]], temps: [], loops: [], sret: -1, arm_binds: [], err: "", lams: [], partials: [], fnvals: [], holder: [], into: -1, placed: [], tail: false, tailed: false, frame_fn: false, result: -1, tasks: [], actor_self: -1, actor_off: 0, deep_res: false, narrow: [:], wants: [], defers: [], received: -1, refused: [], fn_name: "", by_addr: -1, by_addr_t: Type.TBool, resized: [], scanned: false, below: [], len_lets: [], nonneg: [], checked: false }
    lw.start(lw.new_block())
    return lw
}

// The IR of the function `fd`, generated as `mangled`; Err: why it can't be
// lowered yet.
#test(codegen_on("struct P { x: int }; fun get(p: P) -> int { return p.x }"), fun_of("fun h(xs: [int]) -> int { return len(xs) }"), "add")[Err("the builtin len")]
pub fun lower_function(cg: CodeGen, fd: FunData, mangled: str) -> Result<Lowered, str> {
    let sig = cg.sig_of(fd.name)
    let ret = opt_subst_type(sig.ret, cg.subst)
    var lw = Lower { f: IrFunc { name: mangled, ret: ret, slots: [], temps: [], blocks: [], order: [], instances: [], frame: false, scope_parent: [-1] }, cur: 0, scopes: [[]], scope_ids: [0], owners: [[]], temps: [], loops: [], sret: -1, arm_binds: [], err: "", lams: [], partials: [], fnvals: [], holder: [], into: -1, placed: [], tail: false, tailed: false, frame_fn: false, result: -1, tasks: [], actor_self: -1, actor_off: 0, deep_res: false, narrow: [:], wants: [], defers: [], received: -1, refused: [], fn_name: "", by_addr: -1, by_addr_t: Type.TBool, resized: [], scanned: false, below: [], len_lets: [], nonneg: [], checked: false }
    lw.fn_name = fd.name
    lw.checked = cg.checked && checked_code(mangled)
    var first_word = 0
    // an async function, when tasks take turns: its frame function, its
    // slots in its heap frame, the result in the first (D90)
    let frame = cg.frames && fd.is_async
    if frame {
        lw.f.frame = true
        lw.frame_fn = true
    }
    match ret {
        Some(t) => {
            if !lowerable(cg, t) { return Err("its result type") }
            if frame {
                var rsize = 8
                if is_aggregate(t) { rsize = cg.size(t) }
                lw.result = lw.new_slot("__result", t, rsize, -1, false)
                if is_aggregate(t) { lw.sret = lw.result }
            } else if is_aggregate(t) {
                lw.sret = lw.new_slot("__sret", t, 8, 0, false)
                first_word = 1
            }
        },
        None => {},
    }
    let entry = lw.new_block()
    lw.start(entry)
    var word = first_word
    var i = 0
    while i < fd.params.len() {
        let t = subst_type(sig.params[i], cg.subst)
        if !lowerable(cg, t) { return Err("a parameter's type") }
        if frame {
            // an owned copy in the frame, which `__new` makes; a `var self`
            // method's struct goes back to its caller, which takes it at the
            // end (`await_let`), so the frame doesn't drop it
            var psize = 8
            if is_aggregate(t) { psize = cg.size(t) }
            let goes_back = i == 0 && is_aggregate(t) && match fd.receiver { Some(r) => r == "var self", None => false }
            let ps = lw.new_slot(fd.params[i].name, t, psize, i, cg.owns_heap(t) && !goes_back)
            lw.f.slots[ps].inline = true
            lw.declare_as(fd.params[i].name, ps, i > 0 || match fd.receiver { Some(r) => r != "var self", None => true })
            lw.own(ps)
            lw.add(Inst.Bind(fd.params[i].name, ps))
            i = i + 1
            continue
        }
        // a parameter passed owned holds the caller's reference, which the
        // function drops on every exit unless it moves it on (MYLA-127); one
        // passed by value holds the aggregate in its argument words, owning
        // what it holds (D88)
        var s = -1
        if recv_by_address(sig, i, t) {
            // a built-in value's `var self`: the address of the caller's
            // place, read and written through (D144)
            s = lw.new_slot(fd.params[i].name, Type.TPtr, 8, word, false)
            lw.by_addr = s
            lw.by_addr_t = t
        } else if cg.byval_param(sig, i, t) {
            s = lw.new_slot(fd.params[i].name, t, cg.word_size(t), word, cg.owns_heap(t))
            lw.f.slots[s].inline = true
        } else { s = lw.new_slot(fd.params[i].name, t, 8, word, cg.owned_param(sig, i, t)) }
        word = word + lw.f.slots[s].size / 8
        let writes_self = i == 0 && match fd.receiver { Some(r) => r == "var self", None => false }
        lw.declare_as(fd.params[i].name, s, !writes_self)
        lw.own(s)
        lw.add(Inst.Bind(fd.params[i].name, s))
        i = i + 1
    }
    // the argument words it received, which a `become` may pass on the
    // stack again (D131): known per instance (MYLA-272)
    if !frame { lw.received = word }
    // an actor's async method holds the actor while it runs (D92)
    let actor_method = cg.frames && fd.params.len() > 0 && has_receiver(fd) && is_actor_t(lw.f.slots[lw.lookup(fd.params[0].name)].ty)
    if frame && actor_method {
        lw.actor_self = lw.lookup(fd.params[0].name)
        lw.actor_off = actor_record_offset(cg, lw.f.slots[lw.actor_self].ty)
        lw.enter_self()
    }
    // an actor method's arguments and result are copied deeply, as they
    // cross between the caller and the actor (D92)
    if actor_method {
        lw.deep_res = match ret { Some(t) => cg.owns_heap(t) && !is_actor_t(t), None => false }
        var pi = 1
        while pi < fd.params.len() {
            let pt = subst_type(sig.params[pi], cg.subst)
            if cg.owns_heap(pt) && !is_actor_t(pt) { lw.deep_param(cg, fd.params[pi].name, pt) }
            pi = pi + 1
        }
    }
    match fd.body {
        Some(b) => {
            lw.resized = resized_in_block(b, [])
            lw.scanned = true
            lw.block(cg, b)
        },
        None => {},
    }
    if lw.refused.len() > 0 { return Ok(Lowered { f: lw.f, lams: [], partials: [], fnvals: [], refused: lw.refused, wants: [] }) }
    if lw.err != "" { return Err(lw.err) }
    // the end of the body falls through to the epilogue
    lw.drop_owners(0)
    lw.exit_fn(-1, true)
    if lw.err != "" { return Err(lw.err) }
    return Ok(Lowered { f: lw.f, lams: lw.lams, partials: lw.partials, fnvals: lw.fnvals, refused: lw.refused, wants: lw.wants })
}

// The IR of a lambda's body, lifted into `job.lifted` (MYLA-106): called with
// the result's address (if any) and its arguments, its environment a hidden
// parameter outside the argument words (`ENV_WORD`, D119). Each capture is copied out of the environment into a slot of its
// own at entry, borrowed as a parameter is (captures are immutable, D48).
pub fun lower_lambda(cg: CodeGen, job: LamJob) -> Result<Lowered, str> {
    let ret = opt_subst_type(tfunc_ret(job.ftype), cg.subst)
    var lw = Lower { f: IrFunc { name: job.lifted, ret: ret, slots: [], temps: [], blocks: [], order: [], instances: [], frame: false, scope_parent: [-1] }, cur: 0, scopes: [[]], scope_ids: [0], owners: [[]], temps: [], loops: [], sret: -1, arm_binds: [], err: "", lams: [], partials: [], fnvals: [], holder: [], into: -1, placed: [], tail: false, tailed: false, frame_fn: false, result: -1, tasks: [], actor_self: -1, actor_off: 0, deep_res: false, narrow: [:], wants: [], defers: [], received: -1, refused: [], fn_name: "", by_addr: -1, by_addr_t: Type.TBool, resized: [], scanned: false, below: [], len_lets: [], nonneg: [], checked: false }
    lw.checked = cg.checked && checked_code(job.lifted)
    // an async lambda, when tasks take turns: a frame function, as an async
    // function's (D90); its frame holds the environment and the arguments
    let frame = cg.frames && is_async_t(job.ftype)
    if frame {
        lw.f.frame = true
        lw.frame_fn = true
    }
    var first_word = 0
    match ret {
        Some(t) => {
            if !lowerable(cg, t) { return Err("its result type") }
            if frame {
                var rsize = 8
                if is_aggregate(t) { rsize = cg.size(t) }
                lw.result = lw.new_slot("__result", t, rsize, -1, false)
                if is_aggregate(t) { lw.sret = lw.result }
            } else if is_aggregate(t) {
                lw.sret = lw.new_slot("__sret", t, 8, 0, false)
                first_word = 1
            }
        },
        None => {},
    }
    let entry = lw.new_block()
    lw.start(entry)
    let env = lw.new_slot("__env", Type.TPtr, 8, ENV_WORD, false)
    if frame { lw.f.slots[env].inline = true }
    let ptypes = tfunc_params(job.ftype)
    var i = 0
    while i < job.params.len() {
        let t = subst_type(ptypes[i], cg.subst)
        if !lowerable(cg, t) { return Err("a parameter's type") }
        if frame {
            var psize = 8
            if is_aggregate(t) { psize = cg.size(t) }
            let ps = lw.new_slot(job.params[i].name, t, psize, first_word + i, cg.owns_heap(t))
            lw.f.slots[ps].inline = true
            lw.declare_as(job.params[i].name, ps, true)
            lw.own(ps)
            lw.add(Inst.Bind(job.params[i].name, ps))
            i = i + 1
            continue
        }
        let s = lw.new_slot(job.params[i].name, t, 8, first_word + i, false)
        lw.declare_as(job.params[i].name, s, true)
        lw.add(Inst.Bind(job.params[i].name, s))
        i = i + 1
    }
    for c in job.caps {
        if !lowerable(cg, c.ty) { return Err("a capture's type") }
        // a frame's copy owns what it holds: the environment goes before
        // the frame does
        let s = lw.value_slot(cg, c.name, c.ty, frame)
        let e = lw.temp(Type.TPtr)
        lw.add(Inst.Load(e, env))
        if is_aggregate(c.ty) {
            lw.add(Inst.Copy(lw.slot_addr(s), lw.offset(e, c.off), cg.size(c.ty)))
            if frame { lw.retain(cg, c.ty, lw.slot_addr(s)) }
        } else {
            let v = lw.temp(c.ty)
            lw.add_load(v, e, c.off)
            lw.add(Inst.Store(s, v))
            if frame { lw.retain(cg, c.ty, v) }
        }
        lw.declare_as(c.name, s, true)
        if frame { lw.own(s) }
        lw.add(Inst.Bind(c.name, s))
        // a sibling's task: awaited here, joined by the parent (MYLA-148)
        if c.task { lw.tasks.push(TaskSlot { slot: s, ty: c.task_ty, void: c.task_void, owns: cg.owns_heap(c.task_ty), depth: -1, foreign: true, walk: boxed_drop_walk(cg, c.task_ty) }) }
    }
    if frame {
        let e = lw.temp(Type.TPtr)
        lw.add(Inst.Load(e, env))
        lw.add(Inst.Rt(-1, "__func_drop", [e]))
    }
    match job.body {
        ExprOrBlock.EB_Block(b) => {
            lw.resized = resized_in_block(b, [])
            lw.scanned = true
            lw.block(cg, b)
        },
        ExprOrBlock.EB_Expr(ex) => {
            lw.add(Inst.Loc(Pos { line: ex.line, col: ex.col }))
            lw.begin_temps()
            match ret {
                Some(t) => { lw.ret_value(cg, ex) },
                None => { lw.discard(cg, ex) },
            }
            lw.end_temps()
        },
    }
    if lw.err != "" { return Err(lw.err) }
    if frame {
        lw.drop_owners(0)
        lw.exit_fn(-1, true)
        if lw.err != "" { return Err(lw.err) }
    } else {
        lw.finish(Term.Ret(-1))
    }
    return Ok(Lowered { f: lw.f, lams: lw.lams, partials: lw.partials, fnvals: lw.fnvals, refused: lw.refused, wants: lw.wants })
}

// Whether `t` is a scalar: an integer, float, bool, char or address.
#test(Type.TSB)[false]
#test(Type.TBool)[true]
#test(Type.TChar)[true]
#test(Type.TPtr)[true]
fun is_scalar(t: Type) -> bool {
    return match t {
        Type.TInt(w, s) => true
        Type.TFloat(w) => true
        Type.TBool => true
        Type.TChar => true
        Type.TPtr => true
        _ => false
    }
}

// The variable `e` names, or whose field or tuple element it is ("" for
// anything else, an index included).
#test(expr_of("c.name"))["c"]
#test(expr_of("xs[0]"))[""]
fun field_root(e: Expr) -> str {
    return match e.kind {
        ExprKind.Name(n) => n,
        ExprKind.GetField(t, f) => field_root(t),
        ExprKind.TupleIndex(t, i) => field_root(t),
        _ => "",
    }
}

// Whether `t` is no type (a function without a result).
#test(None)[true]
#test(Some(Type.TBool))[false]
fun is_none_type(t: Option<Type>) -> bool {
    return match t { Some(x) => false, None => true }
}

// Whether values of type `t` can be lowered: scalars, strings, lists, maps,
// builders, function values, and structs, tuples and enums (recursive ones
// too, whose members are boxed) of such values.
#test(codegen_on("[int]"), Type.TStr)[true]
fun lowerable(cg: CodeGen, t: Type) -> bool {
    return member_lowerable(t, cg.ir_blocked)
}

// `lowerable` for a type whose structs and enums are lowerable unless named
// in `blocked`, with their type arguments; a type parameter (in a
// declaration) is.
#test(Type.TSB, [])[true]
#test(Type.TStr, [])[true]
#test(Type.TBool, [])[true]
fun member_lowerable(t: Type, blocked: [str]) -> bool {
    if is_scalar(t) { return true }
    return match t {
        Type.TStr => true
        Type.TSB => true
        Type.TParam(n) => true
        Type.TList(et) => member_lowerable(et, blocked)
        Type.TMap(kt, vt) => member_lowerable(kt, blocked) && member_lowerable(vt, blocked)
        Type.TTuple(es) => all_lowerable(es, blocked)
        Type.TStruct(n, a) => !has_name(blocked, n) && all_lowerable(a, blocked)
        Type.TEnum(n, a) => !has_name(blocked, n) && all_lowerable(a, blocked)
        Type.TFunc(ps, r) => all_lowerable(ps, blocked) && match r {
            Some(rt) => member_lowerable(rt, blocked)
            None => true
        }
        Type.TAsync(f) => member_lowerable(f, blocked)
        Type.TActor(n, a) => !has_name(blocked, n) && all_lowerable(a, blocked)
        _ => false
    }
}

#test([], [])[true]
#test([Type.TStr], [])[true]
#test([Type.TParam("E")], [])[true]
fun all_lowerable(ts: [Type], blocked: [str]) -> bool {
    for t in ts {
        if !member_lowerable(t, blocked) { return false }
    }
    return true
}

#test([], "a")[false]
#test([], "f")[false]
#test(["double", "inc"], "double")[true]
fun has_name(names: [str], n: str) -> bool {
    for x in names {
        if x == n { return true }
    }
    return false
}

// The structs and enums whose declared members can't be lowered (through
// another such type, to a fixed point; `Self`); a generic one is lowerable
// for lowerable type arguments.
#test(codegen_on("[int]"))[[]]
pub fun blocked_types(cg: CodeGen) -> [str] {
    var blocked: [str] = []
    var changed = true
    while changed {
        changed = false
        for s in cg.structs {
            if !has_name(blocked, s.name) {
                var ok = true
                for f in s.fields {
                    if !member_lowerable(f.ty, blocked) { ok = false }
                }
                if !ok {
                    blocked.push(s.name)
                    changed = true
                }
            }
        }
        for e in cg.enums {
            if !has_name(blocked, e.name) {
                var ok = true
                for v in e.variants {
                    if !all_lowerable(v.payload, blocked) { ok = false }
                }
                if !ok {
                    blocked.push(e.name)
                    changed = true
                }
            }
        }
    }
    return blocked
}

// Whether `t`'s values are a pointer to a heap cell held in 8 bytes (a
// string so far): a scalar for the frame, with a reference count.
// Where a frame's caller and its result are (`[resume fn][caller][state]
// [task]`, then the result: D90, ir_x86's FRAME_HEADER).
const FRAME_CALLER: int32 = 8
const FRAME_TASK: int32 = 24
const FRAME_RESULT: int32 = 72

// A frame's task (its first frame), a task's flags (2: `task.cancel` asked
// it to stop, D96) and its parent task.
const FRAME_ROOT: int32 = 40
const FRAME_PARENT: int32 = 56

// An actor's executor (D92), after its fields: `[lock][running][first
// frame waiting][last]`.
const ACTOR_RECORD: int32 = 32

// Whether computing `e` leaves the variable `root` as it was and keeps no
// reference to it (H4): no method call on it or given it (but the reading
// builtins), no block (an `if` or `match` may assign), no lambda, no
// `await`. Such a key, index or argument may be computed after a place of
// `root` was made unique; any other is computed before it, as the
// interpreter does, so that a copy it takes doesn't see the write and a
// growth it makes doesn't leave the write in a freed cell.
#test(expr_of("xs[i + 1] * 2"), "xs")[true]
#test(expr_of("xs.len() - 1"), "xs")[true]
#test(expr_of("f(xs, g(1))"), "xs")[true]
#test(expr_of("h.snap(1)"), "h")[false]
#test(expr_of("o.keep(h.m)"), "h")[false]
#test(expr_of("o.next()"), "h")[true]
#test(expr_of("if c { 1 } else { 2 }"), "h")[false]
fun settled_operand(e: Expr, root: str) -> bool {
    return match e.kind {
        ExprKind.Unary(op, x) => settled_operand(x, root),
        ExprKind.Binary(op, l, r) => settled_operand(l, root) && settled_operand(r, root),
        ExprKind.Cast(x, t) => settled_operand(x, root),
        ExprKind.Try(x) => settled_operand(x, root),
        ExprKind.GetField(x, f) => settled_operand(x, root),
        ExprKind.TupleIndex(x, i) => settled_operand(x, root),
        ExprKind.Index(x, i) => settled_operand(x, root) && settled_operand(i, root),
        ExprKind.TupleLit(es) => settled_operands(es, root),
        ExprKind.ListLit(es) => settled_operands(es, root),
        ExprKind.StructLit(n, fields) => {
            var ok = true
            for fi in fields { ok = ok && settled_operand(fi.value, root) }
            ok
        },
        ExprKind.MapLit(entries) => {
            var ok = true
            for en in entries { ok = ok && settled_operand(en.key, root) && settled_operand(en.value, root) }
            ok
        },
        // a function or a closure can't reach the caller's variables
        // (closures capture by value): only what it is given, for the call
        ExprKind.Call(c, args, targs) => match c.kind {
            ExprKind.GetField(recv, m) => {
                if m == "len" || m == "contains" || m == "get" || m == "get_or" || m == "is_empty" { settled_operand(recv, root) && settled_operands(args, root) }
                else { place_root(recv) != root && settled_operand(recv, root) && settled_operands(args, root) && !mentions_any(args, root) }
            },
            _ => settled_operand(c, root) && settled_operands(args, root),
        },
        ExprKind.MatchE(s, arms) => false,
        ExprKind.Lambda(ps, rt, body, asy) => false,
        ExprKind.Await(x) => false,
        _ => true,
    }
}

fun settled_operands(es: [Expr], root: str) -> bool {
    for x in es { if !settled_operand(x, root) { return false } }
    return true
}

// Whether one of `es` names the variable `root` (anything holding a block
// counts as naming it).
#test([expr_of("f(a.b, 1)")], "a")[true]
#test([expr_of("f(b, 1)")], "a")[false]
fun mentions_any(es: [Expr], root: str) -> bool {
    for e in es {
        let named = match e.kind {
            ExprKind.Name(n) => n == root,
            ExprKind.Unary(op, x) => mentions_any([x], root),
            ExprKind.Binary(op, l, r) => mentions_any([l, r], root),
            ExprKind.Cast(x, t) => mentions_any([x], root),
            ExprKind.Try(x) => mentions_any([x], root),
            ExprKind.Await(x) => mentions_any([x], root),
            ExprKind.GetField(x, f) => mentions_any([x], root),
            ExprKind.TupleIndex(x, i) => mentions_any([x], root),
            ExprKind.Index(x, i) => mentions_any([x, i], root),
            ExprKind.TupleLit(xs) => mentions_any(xs, root),
            ExprKind.ListLit(xs) => mentions_any(xs, root),
            ExprKind.StructLit(n, fields) => {
                var vs: [Expr] = []
                for fi in fields { vs.push(fi.value) }
                mentions_any(vs, root)
            },
            ExprKind.MapLit(entries) => {
                var vs: [Expr] = []
                for en in entries {
                    vs.push(en.key)
                    vs.push(en.value)
                }
                mentions_any(vs, root)
            },
            ExprKind.Call(c, args, targs) => mentions_any([c], root) || mentions_any(args, root),
            ExprKind.MatchE(s, arms) => true,
            ExprKind.Lambda(ps, rt, body, asy) => true,
            _ => false,
        }
        if named { return true }
    }
    return false
}

// Whether every index on the path of the place `e` is settled
// (`settled_operand`) against the variable the place starts at.
#test(expr_of("a.b[i][j + 1].c"))[true]
#test(expr_of("a.b[a.f()]"))[false]
fun settled_path(e: Expr) -> bool {
    let root = place_root(e)
    var cur = e
    while true {
        match cur.kind {
            ExprKind.GetField(x, f) => { cur = x },
            ExprKind.TupleIndex(x, i) => { cur = x },
            ExprKind.Index(x, i) => {
                if !settled_operand(i, root) { return false }
                cur = x
            },
            _ => { return true },
        }
    }
    return true
}

// Whether an argument after `argv[i]` may write the variable `argv[i]` is
// read from (through a method that may take `var self`, or a mutating
// builtin): then `argv[i]` is copied when it is evaluated (MYLA-237).
fun later_writes(argv: [Expr], i: int32) -> bool {
    let root = place_root(argv[i])
    if root == "" { return false }
    var j = i + 1
    while j < argv.len() {
        if may_write_expr(argv[j], root) { return true }
        j = j + 1
    }
    return false
}

// Whether `fd` is a method (it has a receiver).
#test(fun_of("fun g() { print(1) }"))[false]
fun has_receiver(fd: FunData) -> bool {
    return match fd.receiver { Some(r) => true, None => false }
}

// Where an actor's executor begins in its cell: after its fields.
#test(codegen_on("struct P { x: int, y: int }"), Type.TActor("Account", []))[16]
fun actor_record_offset(cg: CodeGen, t: Type) -> int32 {
    return (cg.size(actor_fields(t)) + 7) / 8 * 8
}

// The struct whose fields the actor type `t` holds: a generic actor's with
// its type arguments (MYLA-386).
#test(Type.TActor("Cell", [Type.TStr]))[Type.TStruct("Cell", [Type.TStr])]
#test(Type.TActor("Account", []))[Type.TStruct("Account", [])]
fun actor_fields(t: Type) -> Type {
    return match t { Type.TActor(n, a) => Type.TStruct(n, a), _ => t }
}

// The function a call calls (Lower.call_target).
struct CallTarget { name: str, params: [Type], ret: Option<Type> }

impl Lower {
    // `load [%p + off]` added, as wide as what `p` points at: an element of
    // a list stored at its natural size (`narrow`, D120), else 8 bytes.
    fun add_load(var self, d: int32, p: int32, off: int32) {
        let w = self.width_at(p, off)
        self.add(Inst.LoadAt(d, p, off, w))
    }

    // `store [%p + off], %v` added, as wide as what `p` points at.
    fun add_store(var self, p: int32, off: int32, v: int32) {
        let w = self.width_at(p, off)
        self.add(Inst.StoreAt(p, off, v, w))
    }

    // The width of the scalar at `p + off`: an element's (`narrow`) at its
    // address, else 8 bytes.
    #test(lower_on(), 0, 0)[8]
    fun width_at(self, p: int32, off: int32) -> int32 {
        if off == 0 && self.narrow.len() > 0 && self.narrow.contains(p) { return self.narrow[p] }
        return 8
    }

    // A program without tasks waiting for a socket (`await __wait_socket(h,
    // events)`, MYLA-346): the thread blocked in `__sock_poll(h, events, -1)`
    // until it is ready, as a blocking operation would be.
    fun poll_socket(var self, cg: CodeGen, h: int32, ev: int32) {
        let forever = self.int_const(-1)
        let d = self.temp(Type.TInt(32, true))
        self.rt_call(cg, d, "__sock_poll", [h, ev, forever])
    }

    // Whether `x`, awaited without tasks, is a socket's wait, which is then
    // lowered as `poll_socket`.
    fun socket_wait_without_tasks(var self, cg: CodeGen, x: Expr) -> bool {
        match x.kind {
            ExprKind.Call(c, a, _) => {
                match c.kind {
                    ExprKind.Name(n) => {
                        if n == "__wait_socket" {
                            let h = self.expr(cg, a[0])
                            let ev = self.expr(cg, a[1])
                            self.poll_socket(cg, h, ev)
                            return true
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        return false
    }

    // A runtime helper's call: the function of the runtime written in Myla
    // (`std.rt`, MYLA-162) when the program has it (a native build) and it
    // takes nothing owned, else the assembly routine.
    fun rt_call(var self, cg: CodeGen, d: int32, name: str, args: [int32]) {
        let f = myla_runtime_function(name)
        if f != "" && cg.has_func(f) && !cg.owning.contains(f) { self.add(Inst.Call(d, f, args)) }
        else { self.add(rt_inst(d, name, args)) }
    }

    // `d`, the address of a list element of `size` bytes, marked for the
    // loads and stores through it when it is narrower than a word (D120).
    fun mark_elem(var self, d: int32, size: int32) {
        if size < 8 { self.narrow[d] = size }
    }

    // --- building -------------------------------------------------------------

    #test(lower_on())[1]
    fun new_block(var self) -> int32 {
        self.f.blocks.push(IrBlock { insts: [], term: Term.Open })
        return self.f.blocks.len() - 1
    }

    // Make `b` the block instructions go to (blocks are emitted in this order).
    fun start(var self, b: int32) {
        self.cur = b
        self.f.order.push(b)
    }

    fun add(var self, inst: Inst) {
        self.f.blocks[self.cur].insts.push(inst)
        match inst {
            Inst.Store(s, v) => { if self.f.slots[s].owns { self.holder[v] = s } },
            Inst.Addr(d, s) => { if self.f.slots[s].owns { self.holder[d] = s } },
            Inst.Load(d, s) => { if self.f.slots[s].owns { self.holder[d] = s } },
            _ => {},
        }
    }

    // End the current block with `t` (if it isn't ended yet).
    fun finish(var self, t: Term) {
        match self.f.blocks[self.cur].term {
            Term.Open => { self.f.blocks[self.cur].term = t },
            _ => {},
        }
    }

    // End the current block with `t` and continue in a new block, which only a
    // jump made later can reach (the code after a `return` or `break`).
    fun leave(var self, t: Term) {
        self.finish(t)
        let next = self.new_block()
        self.start(next)
    }

    #test(lower_on(), Type.TBool)[0]
    fun temp(var self, t: Type) -> int32 {
        self.f.temps.push(t)
        self.holder.push(-1)
        self.placed.push(false)
        return self.f.temps.len() - 1
    }

    // Whether the value `v` (a cell, or an aggregate's address) is held by an
    // owned temporary of a statement still open, which then hands its
    // references over (`moved`) instead of being retained into a place and
    // dropped (MYLA-108).
    fun take(var self, v: int32) -> bool {
        let s = self.holder[v]
        if s < 0 { return false }
        for ts in self.temps {
            for x in ts {
                if x == s {
                    self.moved(s)
                    return true
                }
            }
        }
        return false
    }

    // Whether the value `v` of type `t`, which owns heap values, is taken
    // from an owned temporary (`take`).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TBool, 86)[false]
    fun took(var self, cg: CodeGen, t: Type, v: int32) -> bool {
        return cg.owns_heap(t) && self.take(v)
    }

    // Whether the value `v` is held by an owned temporary of a statement still
    // open (as `take`, without taking it).
    fun holds(self, v: int32) -> bool {
        let s = self.holder[v]
        if s < 0 { return false }
        for ts in self.temps {
            for x in ts {
                if x == s { return true }
            }
        }
        return false
    }

    // The argument words of the aggregate of type `t` at `src`, passed by
    // value (D88): with a reference of their own to what it holds (taken from
    // an owned temporary, else retained), read in place.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TBool, 86)[[0]]
    fun value_words(var self, cg: CodeGen, t: Type, src: int32) -> [int32] {
        if !self.took(cg, t, src) { self.retain(cg, t, src) }
        var ws: [int32] = []
        var off = 0
        while off < cg.word_size(t) {
            let w = self.temp(Type.TInt(64, false))
            self.add_load(w, src, off)
            ws.push(w)
            off = off + 8
        }
        return ws
    }

    // `retain` unless the value is taken from an owned temporary.
    fun retain_or_take(var self, cg: CodeGen, t: Type, v: int32) {
        if !cg.owns_heap(t) { return }
        if self.take(v) { return }
        self.retain(cg, t, v)
    }

    #test(lower_on(), "a", Type.TBool, 86, 86, true)[0]
    fun new_slot(var self, name: str, t: Type, size: int32, word: int32, owns: bool) -> int32 {
        self.f.slots.push(Slot { name: name, ty: t, size: size, word: word, owns: owns, inline: false, scope: -1 })
        return self.f.slots.len() - 1
    }

    // A slot for a value of type `t` (its size, at least 8 bytes); `owns`: it
    // owns the heap values it will hold.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "a", Type.TBool, true)[0]
    fun value_slot(var self, cg: CodeGen, name: str, t: Type, owns: bool) -> int32 {
        var size = 8
        if is_aggregate(t) { size = cg.size(t) }
        if size < 8 { size = 8 }
        return self.new_slot(name, t, size, -1, owns && cg.owns_heap(t))
    }

    fun declare(var self, name: str, slot: int32) { self.declare_as(name, slot, false) }

    fun declare_as(var self, name: str, slot: int32, fixed: bool) {
        self.scopes[self.scopes.len() - 1].push(Local { name: name, slot: slot, fixed: fixed })
        // the scope the local lives in, for the frame layout (MYLA-183): a
        // slot declared in two scopes keeps a cell of its own (-2)
        let here = self.scope_ids[self.scope_ids.len() - 1]
        let was = self.f.slots[slot].scope
        if was == -1 { self.f.slots[slot].scope = here } else if was != here { self.f.slots[slot].scope = -2 }
    }

    // A scope opens: its index in `f.scope_parent`, under the innermost open one.
    fun enter_scope(var self) {
        self.scope_ids.push(self.f.scope_parent.len())
        self.f.scope_parent.push(self.scope_ids[self.scope_ids.len() - 2])
    }

    // Whether `e` is a part of a fixed variable (`Local`): the variable, a
    // field, a tuple's element or an element of a list or map in it.
    #test(lower_on(), expr_of("-n * 2"))[false]
    fun fixed_place(self, e: Expr) -> bool {
        return match e.kind {
            ExprKind.Name(n) => {
                // an async actor method's `self`: the actor's other calls
                // change its fields at every suspension point
                if self.shared_self(n) { return false }
                var i = self.scopes.len() - 1
                while i >= 0 {
                    var j = self.scopes[i].len() - 1
                    while j >= 0 {
                        if self.scopes[i][j].name == n { return self.scopes[i][j].fixed }
                        j = j - 1
                    }
                    i = i - 1
                }
                false
            },
            ExprKind.GetField(t, f) => self.fixed_place(t),
            ExprKind.TupleIndex(t, i) => self.fixed_place(t),
            // a slice is a new value, not a part (D142)
            ExprKind.Index(t, i) => !is_slice_expr(i) && self.fixed_place(t),
            _ => false,
        }
    }

    // Whether `name` is the `self` of an async actor method, whose fields
    // the actor's other calls change while it waits (its `let`s, loops and
    // matches can't borrow from them).
    #test(lower_on(), "a")[false]
    fun shared_self(self, name: str) -> bool {
        return self.actor_self >= 0 && self.lookup(name) == self.actor_self
    }

    // The slot of the innermost `name` in scope, or -1.
    #test(lower_on(), "a")[-1]
    fun lookup(self, name: str) -> int32 {
        var i = self.scopes.len() - 1
        while i >= 0 {
            var j = self.scopes[i].len() - 1
            while j >= 0 {
                if self.scopes[i][j].name == name { return self.scopes[i][j].slot }
                j = j - 1
            }
            i = i - 1
        }
        return -1
    }

    // The type of a place: a variable's from its slot (the checker leaves
    // assignment targets untyped), a field's or element's from its aggregate.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[Type.TInt(32, true)]
    fun place_type(self, cg: CodeGen, e: Expr) -> Type {
        match e.kind {
            ExprKind.Name(n) => {
                let slot = self.lookup(n)
                if slot >= 0 { return self.var_type(slot) }
            },
            ExprKind.GetField(t, f) => { return cg.struct_field_type_t(self.place_type(cg, t), f) },
            ExprKind.Index(b, i) => {
                let bt = self.place_type(cg, b)
                // a slice is the same kind of list (D142)
                if is_slice_expr(i) { return bt }
                if is_list_t(bt) { return list_elem(bt) }
                if is_map_t(bt) { return map_val(bt) }
            },
            ExprKind.TupleIndex(t, i) => {
                let es = tuple_elems(self.place_type(cg, t))
                let ix = i as int32
                if ix < es.len() { return es[ix] }
            },
            _ => {},
        }
        return cg.type_of(e.id)
    }

    // `store [rt_addr sym], v` of the width `w` (MYLA-263).
    fun store_rt_var(var self, sym: str, v: int32, w: int32) {
        let at = self.temp(Type.TPtr)
        self.add(Inst.Intr(at, Intrinsic.RtAddr(sym), []))
        self.add(Inst.StoreAt(at, 0, v, w))
    }

    // A narrow list element a `var self` method was given in a cell of its
    // own (`back`: the cell, the element's address) stored back after the
    // call (D144); nothing for (-1, -1).
    fun write_back(var self, back: (int32, int32)) {
        if back.0 < 0 { return }
        let v = self.temp(self.f.slots[back.0].ty)
        self.add(Inst.Load(v, back.0))
        self.add_store(back.1, 0, v)
    }

    // The type of the variable in slot `s` (a built-in value's `var self`
    // receiver's slot holds an address, D144).
    fun var_type(self, s: int32) -> Type {
        if s == self.by_addr { return self.by_addr_t }
        return self.f.slots[s].ty
    }

    // The value of the scalar variable in slot `s`: through the address it
    // holds for a built-in value's `var self` receiver (D144).
    fun read_var(var self, s: int32) -> int32 {
        if s == self.by_addr {
            let p = self.temp(Type.TPtr)
            self.add(Inst.Load(p, s))
            let v = self.temp(self.by_addr_t)
            self.add(Inst.LoadAt(v, p, 0, 8))
            return v
        }
        let d = self.temp(self.f.slots[s].ty)
        self.add(Inst.Load(d, s))
        return d
    }

    // The address of the aggregate in slot `s`: an aggregate parameter's slot
    // holds the caller's address, another slot holds the value itself.
    fun slot_addr(var self, s: int32) -> int32 {
        let d = self.temp(Type.TPtr)
        if self.f.slots[s].word >= 0 && !self.f.slots[s].inline { self.add(Inst.Load(d, s)) } else { self.add(Inst.Addr(d, s)) }
        return d
    }

    // `p + off` in a temporary of its own, also at offset 0: the address of a
    // member, which the verifier mustn't read as the whole slot's.
    #test(lower_on(), 0, 0)[0]
    fun offset(var self, p: int32, off: int32) -> int32 {
        let d = self.temp(Type.TPtr)
        self.add(Inst.Offset(d, p, off))
        return d
    }

    #test(lower_on(), Type.TChar, 97)[0]
    fun konst(var self, t: Type, v: int64) -> int32 {
        let d = self.temp(t)
        self.add(Inst.Const(d, t, v))
        return d
    }

    // `a op b` of type `rt` when the block's last two instructions made `a`
    // and `b` integer constants (both taken back), wrapped as at run time;
    // division and shifts out of range are left to run time.
    fun folded(var self, op: str, lt: Type, rt: Type, a: int32, b: int32, checked: bool) -> Option<int64> {
        let w = match lt { Type.TInt(n, sg) => n, _ => 0 }
        if w == 0 || !type_eq_ir(lt, rt) { return None }
        let signed = match lt { Type.TInt(n, sg) => sg, _ => false }
        let n = self.f.blocks[self.cur].insts.len()
        if n < 2 { return None }
        var u: int64 = 0
        var v: int64 = 0
        var both = 0
        match self.f.blocks[self.cur].insts[n - 2] { Inst.Const(d, t, k) => { if d == a { u = k; both += 1 } }, _ => {} }
        match self.f.blocks[self.cur].insts[n - 1] { Inst.Const(d, t, k) => { if d == b { v = k; both += 1 } }, _ => {} }
        if both != 2 { return None }
        // an overflow left to trap where it runs, in a checked build (D175)
        if checked && int_op_overflows(op, u, v, w, signed) { return None }
        var r: int64 = 0
        if op == "+" { r = u.wrapping_add(v) }
        else if op == "-" { r = u.wrapping_sub(v) }
        else if op == "*" { r = u.wrapping_mul(v) }
        else if op == "&" { r = u & v }
        else if op == "|" { r = u | v }
        else if op == "^" { r = u ^ v }
        else if op == "<<" && v >= 0 && v < (w as int64) { r = u << v }
        else if op == ">>" && v >= 0 && v < (w as int64) && (signed || u >= 0) { r = u >> v }
        else { return None }
        let popped1 = self.f.blocks[self.cur].insts.pop()
        let popped2 = self.f.blocks[self.cur].insts.pop()
        return Some(wrap_ir(r, lt))
    }

    // Record the first construct that can't be lowered; returns a dummy temp.
    #test(lower_on(), "a")[0]
    fun unsupported(var self, what: str) -> int32 {
        if self.err == "" { self.err = what }
        return self.temp(Type.TInt(64, true))
    }

    // --- ownership --------------------------------------------------------------

    // A lexical scope: names, and the owners dropped when it ends.
    fun open_scope(var self) {
        var names: [Local] = []
        self.scopes.push(names)
        var slots: [int32] = []
        self.owners.push(slots)
        self.enter_scope()
        self.add(Inst.Scope(true))
    }

    fun close_scope(var self) {
        let depth = self.owners.len() - 1
        self.drop_owners(depth)
        while self.defers.len() > 0 && self.defers[self.defers.len() - 1].depth >= depth { let d = self.defers.pop() }
        while self.tasks.len() > 0 && self.tasks[self.tasks.len() - 1].depth >= depth { let t = self.tasks.pop() }
        self.scopes.pop()
        self.owners.pop()
        let id = self.scope_ids.pop()
        self.add(Inst.Scope(false))
    }

    // Leave the scopes from the innermost down to index `depth`, each in
    // turn: it waits for the child tasks it started (D89, D90), the latest
    // first, then its deferred blocks run, the last met first (D135), then
    // its owners are dropped in reverse order (they stay registered).
    fun drop_owners(var self, depth: int32) {
        var j = self.tasks.len() - 1
        var s = self.owners.len() - 1
        while s >= depth {
            while j >= 0 && self.tasks[j].depth >= s {
                self.join_task(self.tasks[j])
                j = j - 1
            }
            if self.defers.len() > 0 { self.emit_defers(s) }
            var i = self.owners[s].len() - 1
            while i >= 0 {
                let slot = self.owners[s][i]
                // an async actor method's handle to its actor is dropped by
                // `exit_fn`, once the method has left the actor through it
                if slot != self.actor_self { self.add(Inst.DropSlot(self.f.slots[slot].ty, slot)) }
                i = i - 1
            }
            s = s - 1
        }
    }

    // Whether `e` is a parameter of this function, or a field or element of
    // a tuple of one, that its caller holds (it came as an argument word and
    // this function doesn't own it): what a `become` may pass on borrowed,
    // since nothing of the frame it leaves keeps it (MYLA-253).
    fun caller_holds(self, e: Expr) -> bool {
        let root = field_root(e)
        if root == "" { return false }
        let slot = self.lookup(root)
        return slot >= 0 && self.f.slots[slot].word >= 0 && !self.f.slots[slot].owns
    }

    // The deferred blocks of the owners' scope `s`, the last met first (D135),
    // each with the names it saw where it stands.
    fun emit_defers(var self, s: int32) {
        let ds = self.defers
        var i = ds.len() - 1
        while i >= 0 {
            if ds[i].depth == s {
                let d = ds[i]
                let saved = self.scopes
                var cut: [[Local]] = []
                var k = 0
                while k < d.nscopes - 1 {
                    cut.push(saved[k])
                    k = k + 1
                }
                var last: [Local] = []
                var j = 0
                while j < d.nnames {
                    last.push(saved[d.nscopes - 1][j])
                    j = j + 1
                }
                cut.push(last)
                self.scopes = cut
                self.block(d.cg, d.body)
                self.scopes = saved
                self.defers = ds
            }
            i = i - 1
        }
    }

    // The innermost scope owns `slot` from now on.
    fun own(var self, slot: int32) {
        if !self.f.slots[slot].owns { return }
        self.owners[self.owners.len() - 1].push(slot)
    }

    // A statement's or condition's owned temporaries: those registered until
    // the matching `end_temps` are dropped there.
    fun begin_temps(var self) {
        var ts: [int32] = []
        self.temps.push(ts)
    }

    fun end_temps(var self) {
        self.drop_temps(self.temps.len() - 1)
        self.temps.pop()
    }

    fun drop_temps(var self, depth: int32) {
        var s = self.temps.len() - 1
        while s >= depth {
            var i = self.temps[s].len() - 1
            while i >= 0 {
                let slot = self.temps[s][i]
                self.add(Inst.DropSlot(self.f.slots[slot].ty, slot))
                i = i - 1
            }
            s = s - 1
        }
    }

    // The owned temporary in `slot` (holding its value now) is dropped when
    // the innermost temporary scope ends.
    fun own_temp(var self, slot: int32) {
        if !self.f.slots[slot].owns { return }
        if self.temps.len() == 0 {
            let d = self.unsupported("a temporary outside a statement")
            return
        }
        self.temps[self.temps.len() - 1].push(slot)
    }

    // The cell value `v` of type `t` is a new reference (a call's result, a
    // concatenation): keep it in an owning slot dropped with the statement.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), 86, Type.TBool)[86]
    fun owned_value(var self, cg: CodeGen, v: int32, t: Type) -> int32 {
        if !cg.owns_heap(t) { return v }
        let slot = self.value_slot(cg, "__temp", t, true)
        self.add(Inst.Store(slot, v))
        self.own_temp(slot)
        return v
    }

    // One more reference to the value of type `t`: `v` holds a cell pointer
    // (a string) or an aggregate's address.
    fun retain(var self, cg: CodeGen, t: Type, v: int32) {
        if !cg.owns_heap(t) { return }
        if is_aggregate(t) { self.add(Inst.Retain(t, v)) } else { self.add(Inst.RetainVal(t, v)) }
    }

    // A scalar expression evaluated where nothing ends its temporaries (a
    // condition, a guard, an operand of `&&`/`||`): they are dropped as soon
    // as its value is known, which owns nothing.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[0]
    fun cond(var self, cg: CodeGen, e: Expr) -> int32 {
        self.begin_temps()
        let v = self.expr(cg, e)
        self.end_temps()
        return v
    }

    // Go to `yes` when the condition `e` holds, else to `no`: `&&`, `||` and
    // `!` become branches, with no boolean in between; any other condition is
    // evaluated (`cond`) and tested.
    fun branch(var self, cg: CodeGen, e: Expr, yes: int32, no: int32) {
        match e.kind {
            ExprKind.Binary(op, l, r) => {
                if op == "&&" || op == "||" {
                    let mid = self.new_block()
                    if op == "&&" { self.branch(cg, l, mid, no) } else { self.branch(cg, l, yes, mid) }
                    self.start(mid)
                    self.branch(cg, r, yes, no)
                    return
                }
            },
            ExprKind.Unary(op, x) => {
                if op == "!" {
                    self.branch(cg, x, no, yes)
                    return
                }
            },
            // `while true`: a jump, nothing tested
            ExprKind.BoolLit(b) => {
                if b { self.finish(Term.Jmp(yes)) } else { self.finish(Term.Jmp(no)) }
                return
            },
            _ => {},
        }
        let v = self.cond(cg, e)
        self.finish(Term.Br(v, yes, no))
    }

    // --- statements -------------------------------------------------------------

    fun block(var self, cg: CodeGen, b: Block) {
        self.open_scope()
        for s in b.stmts { self.stmt(cg, s) }
        self.close_scope()
    }

    fun stmt(var self, cg: CodeGen, s: Stmt) {
        if self.err != "" { return }
        self.add(Inst.Loc(Pos { line: s.line, col: s.col }))
        self.begin_temps()
        self.stmt_body(cg, s)
        self.end_temps()
    }

    fun stmt_body(var self, cg: CodeGen, s: Stmt) {
        match s.kind {
            StmtKind.ExprStmt(e) => { self.discard(cg, e) },
            StmtKind.VarDecl(k, name, ty, init) => {
                if k == "async" {
                    self.async_let(cg, name, init)
                    return
                }
                // `let x = await …` in a frame function (normalized: the only
                // place an `await` stands, D90)
                if self.frame_fn {
                    match init.kind {
                        ExprKind.Await(op) => {
                            self.await_let(cg, s, k, name, op)
                            return
                        },
                        _ => {},
                    }
                }
                let t = cg.type_of(init.id)
                if !lowerable(cg, t) {
                    let d = self.unsupported("a local's type")
                    return
                }
                let slot = self.value_slot(cg, name, t, true)
                // a `let` of a part of a fixed variable borrows it: neither
                // changes while the `let` lives, and the variable outlives it
                // (it is in scope), so the copy needs no reference of its own
                // (MYLA-122)
                let borrows = k == "let" && self.fixed_place(init)
                // `let n = xs.len()`: below it, a range up to `n` is one up to
                // the length (MYLA-251)
                var len_of = ""
                if k == "let" { len_of = self.len_call_key(cg, init) }
                if is_aggregate(t) {
                    // built in the variable's slot when it can be
                    self.into = slot
                    let src = self.addr(cg, init)
                    self.into = -1
                    if !self.is_placed(src) {
                        let took = self.took(cg, t, src)
                        let dst = self.slot_addr(slot)
                        self.add(Inst.Copy(dst, src, cg.size(t)))
                        if !took && borrows { self.f.slots[slot].owns = false }
                        else if !took { self.retain(cg, t, dst) }
                    }
                } else {
                    let v = self.expr(cg, init)
                    let took = self.took(cg, t, v)
                    self.add(Inst.Store(slot, v))
                    if !took && borrows { self.f.slots[slot].owns = false }
                    else if !took { self.retain(cg, t, v) }
                }
                self.declare_as(name, slot, k == "let")
                if len_of != "" { self.len_lets.push(LenFact { slot: slot, key: len_of }) }
                self.own(slot)
                self.add(Inst.Bind(name, slot))
            },
            StmtKind.Assign(target, value) => { self.assign(cg, target, value) },
            StmtKind.ReturnS(ov, tail) => {
                // `return ()` (or another such call) in a function without a
                // result: the value for its effects, then as `return` (D140)
                var unit_ret = false
                match ov {
                    Some(e) => { unit_ret = !tail && is_none_type(self.f.ret) },
                    None => {},
                }
                if unit_ret {
                    match ov { Some(e) => { self.discard(cg, e) }, None => {} }
                    self.drop_temps(0)
                    self.drop_owners(0)
                    self.exit_fn(-1, false)
                    return
                }
                match ov {
                    Some(e) => { if tail { self.become_call(cg, e) } else { self.ret_value(cg, e) } },
                    None => {
                        self.drop_temps(0)
                        self.drop_owners(0)
                        self.exit_fn(-1, false)
                    },
                }
            },
            StmtKind.IfS(c, then, otherwise) => { self.if_stmt(cg, c, then, otherwise) },
            StmtKind.WhileS(c, body) => {
                let forever = match c.kind { ExprKind.BoolLit(b) => b, _ => false }
                if forever {
                    let head = self.new_block()
                    self.finish(Term.Jmp(head))
                    self.start(head)
                    let end = self.new_block()
                    self.loops.push(LoopTarget { cont: head, brk: end, owners: self.owners.len(), temps: self.temps.len() })
                    self.block(cg, body)
                    self.loops.pop()
                    self.finish(Term.Jmp(head))
                    self.start(end)
                } else {
                    // tested on the way in and again at the end of each turn
                    // (where `continue` goes): one jump a turn, back to the
                    // body, not two (MYLA-162)
                    let body_b = self.new_block()
                    let latch = self.new_block()
                    let end = self.new_block()
                    self.branch(cg, c, body_b, end)
                    self.start(body_b)
                    self.loops.push(LoopTarget { cont: latch, brk: end, owners: self.owners.len(), temps: self.temps.len() })
                    self.block(cg, body)
                    self.loops.pop()
                    self.finish(Term.Jmp(latch))
                    self.start(latch)
                    self.branch(cg, c, body_b, end)
                    self.start(end)
                }
            },
            StmtKind.ForS(vn, start, end, body, iter) => { self.for_range(cg, vn, start, end, body, iter) },
            StmtKind.BreakS => {
                let lp = self.loops[self.loops.len() - 1]
                self.drop_temps(lp.temps)
                self.drop_owners(lp.owners)
                self.leave(Term.Jmp(lp.brk))
            },
            StmtKind.ContinueS => {
                let lp = self.loops[self.loops.len() - 1]
                self.drop_temps(lp.temps)
                self.drop_owners(lp.owners)
                self.leave(Term.Jmp(lp.cont))
            },
            StmtKind.DestructDecl(k, binding, ty, init) => {
                let t = cg.type_of(init.id)
                if !lowerable(cg, t) {
                    let d = self.unsupported("a local's type")
                    return
                }
                let src = self.addr(cg, init)
                self.destructure(cg, bind_elems(binding), src, t)
            },
            // emitted where its scope is left (`drop_owners`, D135)
            StmtKind.DeferS(body) => {
                let top = self.scopes.len() - 1
                self.defers.push(LDefer { depth: self.owners.len() - 1, nscopes: self.scopes.len(), nnames: self.scopes[top].len(), body: body, cg: cg })
            },
        }
    }

    // The names of a tuple binding (`let (a, (b, _)) = …`): each a variable of
    // its own, holding a retained copy of its element of the tuple at `base`.
    fun destructure(var self, cg: CodeGen, elems: [BindElem], base: int32, t: Type) {
        let ets = tuple_elems(t)
        var i = 0
        for b in elems {
            let et = ets[i]
            let off = cg.elem_offset(t, i)
            match b {
                BindElem.BName(n, l, c, sp) => {
                    let slot = self.value_slot(cg, n, et, true)
                    if is_aggregate(et) {
                        let dst = self.slot_addr(slot)
                        self.add(Inst.Copy(dst, self.unbox(cg, et, self.offset(base, off)), cg.size(et)))
                        self.retain(cg, et, dst)
                    } else {
                        let v = self.temp(et)
                        self.add_load(v, base, off)
                        self.add(Inst.Store(slot, v))
                        self.retain(cg, et, v)
                    }
                    self.declare(n, slot)
                    self.own(slot)
                    self.add(Inst.Bind(n, slot))
                },
                BindElem.BWild => {},
                BindElem.BTuple(es, l, c, sp) => { self.destructure(cg, es, self.offset(base, off), et) },
            }
            i = i + 1
        }
    }

    // An expression statement: its value, if any, isn't used (an owned one
    // is dropped with the statement's temporaries).
    // `return e`: the value with references of its own (into the result's
    // storage for an aggregate), then every temporary and owner dropped.
    fun ret_value(var self, cg: CodeGen, e: Expr) {
        let t = cg.type_of(e.id)
        if self.sret >= 0 {
            // built in the caller's storage when it can be
            self.into = self.sret
            let src = self.addr(cg, e)
            self.into = -1
            let dst = self.slot_addr(self.sret)
            if !self.is_placed(src) {
                let took = self.took(cg, t, src)
                self.add(Inst.Copy(dst, src, cg.size(t)))
                if !took { self.retain(cg, t, dst) }
            }
            self.drop_temps(0)
            self.drop_owners(0)
            self.exit_fn(dst, false)
            return
        }
        let v = self.expr(cg, e)
        self.retain_or_take(cg, t, v)
        if self.frame_fn {
            // in the frame before the scopes end, which may wait for their
            // children (no temporary lives across a suspension)
            if self.result >= 0 { self.add(Inst.Store(self.result, v)) }
            self.drop_temps(0)
            self.drop_owners(0)
            self.exit_fn(-1, false)
            return
        }
        self.drop_temps(0)
        self.drop_owners(0)
        self.exit_fn(v, false)
    }

    // `let name = await op` (`s`) in a frame function (D90). A call of an
    // async function or method runs on a frame of its own: `__new` makes it
    // with copies of the arguments, the call is made in place of this
    // function (`suspend` after it) and this one goes on when it ends, its
    // result moved out of its frame, which is freed. Any other call is made
    // here, and then the other tasks take a turn.
    fun await_let(var self, cg: CodeGen, s: Stmt, k: str, name: str, op: Expr) {
        // `await __yield()`: a turn for the others, nothing else (MYLA-228)
        match op.kind {
            ExprKind.Call(c, a, _) => {
                match c.kind {
                    ExprKind.Name(n) => {
                        if n == "__yield" {
                            self.leave_self()
                            self.yield_turn()
                            self.enter_self()
                            return
                        }
                        // `await __wait_socket(h, events)`: waiting for the
                        // socket, the others running (MYLA-346); with no
                        // tasks, the thread waits in `__sock_poll`
                        if n == "__wait_socket" {
                            let h = self.expr(cg, a[0])
                            let ev = self.expr(cg, a[1])
                            if !cg.frames {
                                self.poll_socket(cg, h, ev)
                                return
                            }
                            let h64 = self.temp(Type.TInt(64, true))
                            self.add(Inst.Cast(h64, Type.TInt(32, true), Type.TInt(64, true), h))
                            let ev64 = self.temp(Type.TInt(64, true))
                            self.add(Inst.Cast(ev64, Type.TInt(32, true), Type.TInt(64, true), ev))
                            self.leave_self()
                            let me = self.temp(Type.TPtr)
                            self.add(Inst.Frame(me))
                            self.add(Inst.Call(-1, "__wait_sock", [me, h64, ev64]))
                            let after = self.new_block()
                            self.finish(Term.Suspend(after))
                            self.start(after)
                            self.enter_self()
                            return
                        }
                        // `await __wait_readable(fd)`: waiting for input, the
                        // others running (D124); with no tasks, nothing (the
                        // read after it blocks)
                        if n == "__wait_readable" || n == "__wait_either" {
                            var fds: [int32] = []
                            for x in a {
                                let fd = self.expr(cg, x)
                                let f64 = self.temp(Type.TInt(64, true))
                                self.add(Inst.Cast(f64, Type.TInt(32, true), Type.TInt(64, true), fd))
                                fds.push(f64)
                            }
                            if !cg.frames { return }
                            self.leave_self()
                            let me = self.temp(Type.TPtr)
                            self.add(Inst.Frame(me))
                            var cargs = [me]
                            for f in fds { cargs.push(f) }
                            if n == "__wait_either" { self.add(Inst.Call(-1, "__wait_fd2", cargs)) } else { self.add(Inst.Call(-1, "__wait_fd", cargs)) }
                            let after = self.new_block()
                            self.finish(Term.Suspend(after))
                            self.start(after)
                            self.enter_self()
                            return
                        }
                        // `await __park(w)`: parked on a notifier until it is
                        // woken (MYLA-387); with no tasks, nobody can wake it
                        // (`park_alone`)
                        if n == "__park" {
                            let w = self.expr(cg, a[0])
                            if !cg.frames {
                                self.rt_call(cg, -1, "__park_alone", [w])
                                return
                            }
                            self.leave_self()
                            let me = self.temp(Type.TPtr)
                            self.add(Inst.Frame(me))
                            self.rt_call(cg, -1, "__park_frame", [me, w])
                            let after = self.new_block()
                            self.finish(Term.Suspend(after))
                            self.start(after)
                            self.enter_self()
                            return
                        }
                        // `await __sleep(ms)`: asleep, the others running
                        // (D124); with no tasks, the thread asleep
                        if n == "__sleep" {
                            let ms = self.expr(cg, a[0])
                            if !cg.frames {
                                let ns = self.temp(Type.TInt(64, true))
                                self.add(Inst.Cast(ns, Type.TInt(32, true), Type.TInt(64, true), ms))
                                let k = self.konst(Type.TInt(64, true), 1000000)
                                let t = self.temp(Type.TInt(64, true))
                                self.add(Inst.Bin(t, "*", Type.TInt(64, true), Type.TInt(64, true), ns, k, Pos { line: 0, col: 0 }))
                                self.rt_call(cg, -1, "__sleep_ns", [t])
                                return
                            }
                            self.leave_self()
                            self.sleep_turn(ms)
                            self.enter_self()
                            return
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        // an `async let`'s name: its child's result
        match op.kind {
            ExprKind.Name(n) => {
                let ts = self.lookup(n)
                let ti = self.task_of(ts)
                if ts >= 0 && ti >= 0 {
                    self.await_task(cg, k, name, self.tasks[ti])
                    return
                }
            },
            _ => {},
        }
        // a call through an async function value
        let via = self.frame_of_value(cg, op)
        if via >= 0 {
            let held = self.run_frame(cg, k, name, via, "__resume", cg.has_type(op.id), cg.type_of(op.id), false)
            return
        }
        var target = ""
        var argv: [Expr] = []
        match op.kind {
            ExprKind.Call(callee, args, _) => {
                match callee.kind {
                    ExprKind.Name(nm) => {
                        if self.lookup(nm) < 0 && !cg.called_as_value(callee) && cg.is_async_fn(nm) {
                            target = nm
                            argv = args
                        }
                    },
                    ExprKind.GetField(recv, field) => {
                        let mname = format("{}.{}", cg.type_key(cg.type_of(recv.id)), field)
                        if cg.is_async_fn(mname) {
                            target = mname
                            argv.push(recv)
                            for a in args { argv.push(a) }
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        if target == "" {
            if self.actor_call(cg, s, k, name, op) { return }
            // made here, its value bound as a `let`'s; then a turn for the others
            if cg.has_type(op.id) {
                self.stmt_body(cg, Stmt { id: s.id, line: s.line, col: s.col, sp: s.sp, kind: StmtKind.VarDecl(k, name, None, op) })
            } else {
                self.discard(cg, op)
            }
            self.leave_self()
            self.yield_turn()
            self.enter_self()
            return
        }
        let sig = cg.sig_of(target)
        let ct = self.call_target(cg, sig, argv, op)
        // a `var self` method of a struct: its final `self` goes back to the
        // receiver, a variable or a field or list element of one, its indices
        // computed once (MYLA-142); nothing else reaches the place meanwhile
        var back = false
        var in_actor = false
        if sig.has_decl && match sig.decl.receiver { Some(r) => r == "var self", None => false } && is_aggregate(ct.params[0]) {
            // or a place in this actor's state: the method works on a deep
            // copy, made while this method holds the actor, and its `self` is
            // written back once it holds it again (D99, MYLA-169)
            in_actor = self.actor_place(cg, argv[0])
            if !in_actor && !self.local_place(cg, argv[0]) {
                let d = self.unsupported("an awaited 'var self' method on that receiver")
                return
            }
            argv[0] = self.fixed_receiver(cg, argv[0], op.id)
            back = true
        }
        var vals: [int32] = []
        var i = 0
        while i < argv.len() && i < ct.params.len() {
            if !lowerable(cg, ct.params[i]) {
                let d = self.unsupported("a call with an argument of that type")
                return
            }
            if i == 0 && in_actor {
                // the method runs off the actor: a copy of its own, deep, so
                // it shares no counts with the actor's state (D92)
                let t0 = ct.params[0]
                let tmp = self.new_slot("__receiver", t0, cg.size(t0), -1, cg.owns_heap(t0))
                let dst = self.slot_addr(tmp)
                self.add(Inst.Copy(dst, self.addr(cg, argv[0]), cg.size(t0)))
                self.retain(cg, t0, dst)
                if cg.owns_heap(t0) { self.add(Inst.Deep(t0, dst)) }
                self.own_temp(tmp)
                vals.push(self.slot_addr(tmp))
            } else if is_aggregate(ct.params[i]) { vals.push(self.addr(cg, argv[i])) } else { vals.push(self.expr(cg, argv[i])) }
            i = i + 1
        }
        let fr = self.temp(Type.TPtr)
        self.add(Inst.Call(fr, ct.name + "__new", vals))
        var rt = Type.TBool
        var has = false
        var self_off = FRAME_RESULT
        match ct.ret {
            Some(r) => {
                rt = r
                has = true
                // after the result slot `lower_function` makes
                var rsize = 8
                if is_aggregate(r) { rsize = cg.size(r) }
                self_off = FRAME_RESULT + (rsize + 7) / 8 * 8
            },
            None => {},
        }
        let held = self.run_frame(cg, k, name, fr, ct.name, has, rt, back)
        if back {
            // the receiver's old value goes, the method's `self` moves in,
            // then the callee's frame (kept by `run_frame` for it) is freed
            let done = self.temp(Type.TPtr)
            self.add(Inst.Load(done, held))
            let t = ct.params[0]
            let local = match argv[0].kind {
                ExprKind.Name(n) => self.lookup(n)
                _ => -1
            }
            var dst = -1
            if local >= 0 && self.f.slots[local].owns {
                self.add(Inst.DropSlot(t, local))
                dst = self.slot_addr(local)
            } else {
                dst = self.place(cg, argv[0])
                if cg.owns_heap(t) { self.add(Inst.DropAt(t, dst)) }
            }
            self.add(Inst.Copy(dst, self.offset(done, self_off), cg.size(t)))
            self.add(Inst.Rt(-1, "__free", [done]))
        }
    }

    // Whether `e` is a local variable or a field of one, through structs
    // only: a place no other task or call reaches while this function waits
    // (an actor's field could change meanwhile, D89).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[false]
    fun local_place(var self, cg: CodeGen, e: Expr) -> bool {
        return match e.kind {
            ExprKind.Name(n) => self.lookup(n) >= 0,
            ExprKind.GetField(recv, f) => !is_actor_t(cg.type_of(recv.id)) && self.local_place(cg, recv),
            ExprKind.Index(base, idx) => is_list_t(cg.type_of(base.id)) && self.local_place(cg, base),
            _ => false,
        }
    }

    // Whether `e` is a field of this async actor method's `self`, or a field
    // or list element of one, through structs and lists (D99, MYLA-169).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[false]
    fun actor_place(self, cg: CodeGen, e: Expr) -> bool {
        return match e.kind {
            ExprKind.GetField(recv, f) => match recv.kind {
                ExprKind.Name(n) => self.shared_self(n),
                _ => !is_actor_t(cg.type_of(recv.id)) && self.actor_place(cg, recv),
            },
            ExprKind.Index(base, idx) => is_list_t(cg.type_of(base.id)) && self.actor_place(cg, base),
            _ => false,
        }
    }

    // The place `e` (`local_place`) with each index computed now into a slot
    // of its own, so that reading the receiver and writing it back after the
    // method name the same element.
    fun fixed_receiver(var self, cg: CodeGen, e: Expr, call: int32) -> Expr {
        return match e.kind {
            ExprKind.GetField(recv, f) => Expr { id: e.id, line: e.line, col: e.col, sp: e.sp, kind: ExprKind.GetField(self.fixed_receiver(cg, recv, call), f) },
            ExprKind.TupleIndex(recv, k) => Expr { id: e.id, line: e.line, col: e.col, sp: e.sp, kind: ExprKind.TupleIndex(self.fixed_receiver(cg, recv, call), k) },
            ExprKind.Index(base, idx) => {
                let b2 = self.fixed_receiver(cg, base, call)
                let nm = format("%index{}_{}", call, idx.id)
                let held = self.held_value(cg, idx, nm)
                let i2 = Expr { id: idx.id, line: idx.line, col: idx.col, sp: idx.sp, kind: ExprKind.Name(nm) }
                Expr { id: e.id, line: e.line, col: e.col, sp: e.sp, kind: ExprKind.Index(b2, i2) }
            },
            _ => e,
        }
    }

    // The parameter `name` (of type `t`) of an actor's method as a deep copy
    // of its own (D92): in place when its slot owns its value, else a new
    // owned slot copied from the borrowed one.
    fun deep_param(var self, cg: CodeGen, name: str, t: Type) {
        let s = self.lookup(name)
        if self.f.slots[s].owns {
            // an owned argument that isn't held inline (a string, list or
            // map passed owned, MYLA-127) is the cell itself in its slot, not
            // an address to read through: the slot's own address (H2)
            if self.f.slots[s].inline { self.add(Inst.Deep(t, self.slot_addr(s))) }
            else {
                let a = self.temp(Type.TPtr)
                self.add(Inst.Addr(a, s))
                self.add(Inst.Deep(t, a))
            }
            return
        }
        let c = self.value_slot(cg, name, t, true)
        if is_aggregate(t) {
            var src = -1
            if self.f.slots[s].inline { src = self.slot_addr(s) }
            else {
                src = self.temp(Type.TPtr)
                self.add(Inst.Load(src, s))
            }
            let dst = self.slot_addr(c)
            self.add(Inst.Copy(dst, src, cg.size(t)))
            self.retain(cg, t, dst)
        } else {
            let v = self.temp(t)
            self.add(Inst.Load(v, s))
            self.add(Inst.Store(c, v))
            self.retain(cg, t, v)
        }
        self.add(Inst.Deep(t, self.slot_addr(c)))
        self.declare_as(name, c, true)
        self.own(c)
        self.add(Inst.Bind(name, c))
    }

    // `let name = await recv.m(args)` of an actor's synchronous method (D92):
    // the receiver and the arguments into slots of their own while this
    // function still holds its own actor, which it leaves; the call made in
    // the receiver's actor, entered and left around it; then a turn for the
    // others, and its own actor entered again. False when `op` isn't one.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), stmt_of("x = x + 1"), "let", "b", expr_of("a.b[0]"))[false]
    fun actor_call(var self, cg: CodeGen, s: Stmt, k: str, name: str, op: Expr) -> bool {
        match op.kind {
            ExprKind.Call(callee, args, targs) => {
                match callee.kind {
                    ExprKind.GetField(recv, m) => {
                        let at = cg.type_of(recv.id)
                        if !is_actor_t(at) { return false }
                        let rs = self.held_value(cg, recv, format("%actor{}", op.id))
                        var args2: [Expr] = []
                        var i = 0
                        while i < args.len() {
                            let a = args[i]
                            let an = format("%arg{}_{}", op.id, i)
                            let held = self.held_value(cg, a, an)
                            args2.push(Expr { id: a.id, line: a.line, col: a.col, sp: a.sp, kind: ExprKind.Name(an) })
                            i = i + 1
                        }
                        let r2 = Expr { id: recv.id, line: recv.line, col: recv.col, sp: recv.sp, kind: ExprKind.Name(format("%actor{}", op.id)) }
                        let c2 = Expr { id: callee.id, line: callee.line, col: callee.col, sp: callee.sp, kind: ExprKind.GetField(r2, m) }
                        let op2 = Expr { id: op.id, line: op.line, col: op.col, sp: op.sp, kind: ExprKind.Call(c2, args2, targs) }
                        let off = actor_record_offset(cg, at)
                        self.leave_self()
                        self.enter_actor(rs, off)
                        if cg.has_type(op.id) {
                            self.stmt_body(cg, Stmt { id: s.id, line: s.line, col: s.col, sp: s.sp, kind: StmtKind.VarDecl(k, name, None, op2) })
                        } else {
                            self.discard(cg, op2)
                        }
                        self.leave_actor(rs, off)
                        self.yield_turn()
                        self.enter_self()
                        return true
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        return false
    }

    // `e`'s value in a new owned slot named `nm`, with references of its own.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), "%actor39")[0]
    fun held_value(var self, cg: CodeGen, e: Expr, nm: str) -> int32 {
        let t = cg.type_of(e.id)
        let slot = self.value_slot(cg, nm, t, true)
        if is_aggregate(t) {
            let src = self.addr(cg, e)
            let dst = self.slot_addr(slot)
            self.add(Inst.Copy(dst, src, cg.size(t)))
            self.retain(cg, t, dst)
        } else {
            let v = self.expr(cg, e)
            self.add(Inst.Store(slot, v))
            self.retain(cg, t, v)
        }
        self.declare_as(nm, slot, false)
        self.own(slot)
        return slot
    }

    // `e` computed now into a local of its own named `nm` (`held_value`), as
    // the name of that local, of `e`'s type; a literal as it is.
    fun held_operand(var self, cg: CodeGen, e: Expr, nm: str) -> Expr {
        let lit = match e.kind {
            ExprKind.IntLit(v, sfx, ch, big) => true,
            ExprKind.FloatLit(x, sfx) => true,
            ExprKind.StrLit(x) => true,
            ExprKind.BoolLit(b) => true,
            _ => false,
        }
        if lit { return e }
        let held = self.held_value(cg, e, nm)
        return Expr { id: e.id, line: e.line, col: e.col, sp: e.sp, kind: ExprKind.Name(nm) }
    }

    // A turn for the other tasks: this frame queued again (D90).
    fun yield_turn(var self) {
        let me = self.temp(Type.TPtr)
        self.add(Inst.Frame(me))
        self.add(Inst.Call(-1, "__yield", [me]))
        let after = self.new_block()
        self.finish(Term.Suspend(after))
        self.start(after)
    }

    // This frame asleep for the `ms` milliseconds in `ms` (D124): on the
    // executor's timers, resumed when they pass.
    fun sleep_turn(var self, ms: int32) {
        let me = self.temp(Type.TPtr)
        self.add(Inst.Frame(me))
        let m = self.temp(Type.TInt(64, true))
        self.add(Inst.Cast(m, Type.TInt(32, true), Type.TInt(64, true), ms))
        self.add(Inst.Call(-1, "__sleep", [me, m]))
        let after = self.new_block()
        self.finish(Term.Suspend(after))
        self.start(after)
    }

    // The address of the executor of the actor whose handle is in `slot`.
    fun actor_record(var self, slot: int32, off: int32) -> int32 {
        let h = self.temp(Type.TPtr)
        self.add(Inst.Load(h, slot))
        return self.offset(h, off)
    }

    // Into the actor in `slot` (D92): on at once when it is free, else after
    // the frames queued before this one, holding it.
    fun enter_actor(var self, slot: int32, off: int32) {
        let rec = self.actor_record(slot, off)
        let me = self.temp(Type.TPtr)
        self.add(Inst.Frame(me))
        self.add(Inst.Call(-1, "__actor_enter", [rec, me]))
        let inside = self.new_block()
        self.finish(Term.Suspend(inside))
        self.start(inside)
    }

    // Out of the actor in `slot`: the next frame waiting gets it.
    fun leave_actor(var self, slot: int32, off: int32) {
        self.add(Inst.Rt(-1, "__actor_leave", [self.actor_record(slot, off)]))
    }

    fun enter_self(var self) {
        if self.actor_self >= 0 { self.enter_actor(self.actor_self, self.actor_off) }
    }

    fun leave_self(var self) {
        if self.actor_self >= 0 { self.leave_actor(self.actor_self, self.actor_off) }
    }

    // The frame `fr` made for an awaited call: its caller this function, the
    // call `resume(fr)` made in place of it (`suspend` after it), and when it
    // ends its result (`has`, of type `rt`) moved into the variable `name`,
    // the frame freed unless the caller `keep`s it, in the slot returned.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "let", "%aw1", 1, "fetch", true, Type.TInt(32, true), false)[0]
    fun run_frame(var self, cg: CodeGen, k: str, name: str, fr: int32, resume: str, has: bool, rt: Type, keep: bool) -> int32 {
        let me = self.temp(Type.TPtr)
        self.add(Inst.Frame(me))
        self.add_store(fr, FRAME_CALLER, me)
        // the callee runs in this task
        let root = self.temp(Type.TPtr)
        self.add_load(root, me, FRAME_ROOT)
        self.add_store(fr, FRAME_ROOT, root)
        let held = self.new_slot("__callee", Type.TPtr, 8, -1, false)
        self.add(Inst.Store(held, fr))
        self.leave_self()
        self.add(Inst.Call(-1, resume, [fr]))
        let resumed = self.new_block()
        self.finish(Term.Suspend(resumed))
        self.start(resumed)
        self.enter_self()
        let done = self.temp(Type.TPtr)
        self.add(Inst.Load(done, held))
        if has {
            if !lowerable(cg, rt) {
                let d = self.unsupported("a call whose result has that type")
                return held
            }
            let slot = self.value_slot(cg, name, rt, true)
            // the callee's references move to the variable
            if is_aggregate(rt) { self.add(Inst.Copy(self.slot_addr(slot), self.offset(done, FRAME_RESULT), cg.size(rt))) }
            else {
                let v = self.temp(rt)
                self.add_load(v, done, FRAME_RESULT)
                self.add(Inst.Store(slot, v))
            }
            if !keep { self.add(Inst.Rt(-1, "__free", [done])) }
            self.declare_as(name, slot, k == "let")
            self.own(slot)
            self.add(Inst.Bind(name, slot))
        } else if !keep {
            self.add(Inst.Rt(-1, "__free", [done]))
        }
        return held
    }

    // The frame a call through an async function value makes (its code, the
    // async function's `__new`, takes the environment and the arguments),
    // or -1 when `op` is no such call.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[-1]
    fun frame_of_value(var self, cg: CodeGen, op: Expr) -> int32 {
        if !cg.frames { return -1 }
        match op.kind {
            ExprKind.Call(callee, args, _) => {
                var through_value = false
                match callee.kind {
                    ExprKind.Name(nm) => { through_value = self.lookup(nm) >= 0 || cg.called_as_value(callee) },
                    ExprKind.GetField(recv, field) => {
                        let mname = format("{}.{}", cg.type_key(cg.type_of(recv.id)), field)
                        through_value = !cg.has_func(mname)
                    },
                    _ => { through_value = true },
                }
                if !through_value { return -1 }
                let ft = self.place_type(cg, callee)
                if !is_async_t(ft) || !lowerable(cg, ft) { return -1 }
                let params = tfunc_params(ft)
                let fv = self.addr(cg, callee)
                var vals: [int32] = []
                var i = 0
                while i < args.len() && i < params.len() {
                    if is_aggregate(params[i]) { vals.push(self.addr(cg, args[i])) } else { vals.push(self.expr(cg, args[i])) }
                    i = i + 1
                }
                let fr = self.temp(Type.TPtr)
                self.add(Inst.CallInd(fr, fv, vals))
                return fr
            },
            _ => {},
        }
        return -1
    }

    // `async let name = init` (D89): a child task. The normalizer made
    // `init` a call of an async lambda holding copies of what it uses (anf.my,
    // `wrap_children`), which runs on a frame of its own, made now and queued
    // to run while this function goes on. Its frame, in a slot of its own, is
    // what `await name` and the end of the scope (`join_task`) read.
    fun async_let(var self, cg: CodeGen, name: str, init: Expr) {
        let has = cg.has_type(init.id)
        let rt = cg.type_of(init.id)
        // the lambda value released before the child is queued: the child
        // alone then holds its env (D92)
        self.begin_temps()
        let fr = self.frame_of_value(cg, init)
        if fr < 0 {
            let d = self.unsupported("an 'async let' not made a call of an async lambda")
            return
        }
        // a task of its own, this function's task its parent (D96: a request reaches its children)
        self.add_store(fr, FRAME_ROOT, fr)
        let me = self.temp(Type.TPtr)
        self.add(Inst.Frame(me))
        let parent = self.temp(Type.TPtr)
        self.add_load(parent, me, FRAME_ROOT)
        self.add_store(fr, FRAME_PARENT, parent)
        let fs = self.new_slot("__child", Type.TPtr, 8, -1, false)
        self.add(Inst.Store(fs, fr))
        self.end_temps()
        let fr2 = self.temp(Type.TPtr)
        self.add(Inst.Load(fr2, fs))
        self.add(Inst.Rt(-1, "__exec_push", [fr2]))
        let ts = self.new_slot("__task_" + name, Type.TPtr, 8, -1, false)
        self.add(Inst.Store(ts, fr2))
        self.declare_as(name, ts, true)
        self.tasks.push(TaskSlot { slot: ts, ty: rt, void: !has, owns: has && cg.owns_heap(rt), depth: self.owners.len() - 1, foreign: false, walk: boxed_drop_walk(cg, rt) })
    }

    // The child task whose frame is in the slot `ts`: its index in `tasks`,
    // or -1.
    #test(lower_on(), 24)[-1]
    fun task_of(self, ts: int32) -> int32 {
        var i = 0
        while i < self.tasks.len() {
            if self.tasks[i].slot == ts { return i }
            i = i + 1
        }
        return -1
    }

    // Until the child task in `ts` ends: this function waits, its frame in
    // the child's `task` word, which the child's end queues again.
    fun wait_task(var self, ts: int32) -> int32 {
        let check = self.new_block()
        self.finish(Term.Jmp(check))
        self.start(check)
        let fr = self.temp(Type.TPtr)
        self.add(Inst.Load(fr, ts))
        let st = self.temp(Type.TInt(64, false))
        // an acquire load: the child's result, written before its task word
        // changed (`task_end`'s exchange), is read only after it. A plain
        // load let aarch64 read the result first, a stale one (MYLA-267: a
        // sibling's clone crashed on arm64 hardware, t20)
        let at = self.offset(fr, FRAME_TASK)
        self.add(Inst.Intr(st, Intrinsic.LoadAcq64, [at]))
        // running (0) or a frame waiting already: wait; 1, 2 or 3: ended
        let running = self.temp(Type.TBool)
        self.add(Inst.Cmp(running, "==", Type.TInt(64, false), st, self.int_const(0)))
        let wait = self.new_block()
        let done = self.new_block()
        let ended = self.new_block()
        self.finish(Term.Br(running, wait, ended))
        self.start(ended)
        let is_done = self.temp(Type.TBool)
        self.add(Inst.Cmp(is_done, "<", Type.TInt(64, false), st, self.int_const(4)))
        self.finish(Term.Br(is_done, done, wait))
        self.start(wait)
        // parked on the child (or on at once if it has just ended), any
        // actor held left meanwhile
        self.leave_self()
        let me = self.temp(Type.TPtr)
        self.add(Inst.Frame(me))
        let fr2 = self.temp(Type.TPtr)
        self.add(Inst.Load(fr2, ts))
        self.add(Inst.Call(-1, "__wait", [fr2, me]))
        let back = self.new_block()
        self.finish(Term.Suspend(back))
        self.start(back)
        self.enter_self()
        self.finish(Term.Jmp(done))
        self.start(done)
        let out = self.temp(Type.TPtr)
        self.add(Inst.Load(out, ts))
        return out
    }

    // `let name = await t` of an `async let`'s name: its child's result, with
    // references of its own (the child keeps its own until the scope ends).
    fun await_task(var self, cg: CodeGen, k: str, name: str, t: TaskSlot) {
        let fr = self.wait_task(t.slot)
        if t.void { return }
        let rt = t.ty
        let slot = self.value_slot(cg, name, rt, true)
        if is_aggregate(rt) {
            let dst = self.slot_addr(slot)
            self.add(Inst.Copy(dst, self.offset(fr, FRAME_RESULT), cg.size(rt)))
            if t.foreign { self.add(Inst.CloneDeep(rt, dst)) } else { self.retain(cg, rt, dst) }
        } else {
            let v = self.temp(rt)
            self.add_load(v, fr, FRAME_RESULT)
            self.add(Inst.Store(slot, v))
            // a sibling's result, which the parent may read at the same time:
            // a deep clone, the original's counts untouched (MYLA-148)
            if t.foreign && cg.owns_heap(rt) { self.add(Inst.CloneDeep(rt, self.slot_addr(slot))) }
            else if !t.foreign { self.retain(cg, rt, v) }
        }
        self.declare_as(name, slot, k == "let")
        self.own(slot)
        self.add(Inst.Bind(name, slot))
    }

    // A scope's end for the child task `t`: once it ends, its result is
    // released and its frame freed (0 in its slot then: done already on
    // another way out).
    fun join_task(var self, t: TaskSlot) {
        let ts = t.slot
        let start = self.new_block()
        self.finish(Term.Jmp(start))
        self.start(start)
        let fr0 = self.temp(Type.TPtr)
        self.add(Inst.Load(fr0, ts))
        let gone = self.temp(Type.TBool)
        self.add(Inst.Cmp(gone, "==", Type.TPtr, fr0, self.konst(Type.TPtr, 0)))
        let live = self.new_block()
        let end = self.new_block()
        self.finish(Term.Br(gone, end, live))
        self.start(live)
        let fr = self.wait_task(ts)
        if t.owns {
            let at = self.offset(fr, FRAME_RESULT)
            if t.walk != "" {
                // a recursive enum in the frame is its cell's contents, not
                // a box (`drop T [p]` releases a member, H3)
                self.wants.push(Want { kind: 4, t: t.ty, clone: false })
                self.add(Inst.Rt(-1, t.walk, [at]))
            } else { self.add(Inst.DropAt(t.ty, at)) }
        }
        self.add(Inst.Rt(-1, "__free", [fr]))
        self.add(Inst.Store(ts, self.int_const(0)))
        self.finish(Term.Jmp(end))
        self.start(end)
    }

    // The function's end, returning the value in %v (-1: none, or an
    // aggregate already in its result's storage); `fall`: the body fell
    // through (`finish`), else a statement ended it (`leave`). A frame
    // function stores a scalar result in its frame and ends with
    // `__finish`, which resumes its caller or ends its task (D90).
    fun exit_fn(var self, v: int32, fall: bool) {
        if !self.frame_fn {
            var rv = v
            if self.deep_res {
                match self.f.ret {
                    Some(t) => {
                        if self.sret >= 0 { self.add(Inst.Deep(t, self.slot_addr(self.sret))) }
                        else if v >= 0 {
                            // through a slot of its own, which `deep` works on
                            let r = self.new_slot("__deep_result", t, 8, -1, false)
                            self.add(Inst.Store(r, v))
                            self.add(Inst.Deep(t, self.slot_addr(r)))
                            rv = self.temp(t)
                            self.add(Inst.Load(rv, r))
                        }
                    },
                    None => {},
                }
            }
            if fall { self.finish(Term.Ret(rv)) } else { self.leave(Term.Ret(rv)) }
            return
        }
        if v >= 0 && self.result >= 0 && self.sret < 0 { self.add(Inst.Store(self.result, v)) }
        if self.deep_res && self.result >= 0 { self.add(Inst.Deep(self.f.slots[self.result].ty, self.slot_addr(self.result))) }
        // the actor is left through the handle in `self`, so that handle,
        // possibly the actor's last reference, is dropped only afterwards
        // (the other owners are dropped before `exit_fn` is called)
        self.leave_self()
        if self.actor_self >= 0 { self.add(Inst.DropSlot(self.f.slots[self.actor_self].ty, self.actor_self)) }
        let fr = self.temp(Type.TPtr)
        self.add(Inst.Frame(fr))
        self.add(Inst.Call(-1, "__finish", [fr]))
        if fall { self.finish(Term.Become) } else { self.leave(Term.Become) }
    }

    // `become e` (D87): the call `e`, its arguments evaluated, then the
    // function's owners dropped and the call made in place of the function
    // (`tail_call`).
    fun become_call(var self, cg: CodeGen, e: Expr) {
        // an actor method's result is copied before it leaves (D92), which a
        // call in its place would skip: a `return` of the call instead
        if self.deep_res {
            self.ret_value(cg, e)
            return
        }
        match e.kind {
            ExprKind.Call(callee, args, _) => {
                self.tail = true
                self.tailed = false
                let v = self.call(cg, e, callee, args, -1)
                self.tail = false
                if self.tailed { return }
            },
            _ => {},
        }
        let d = self.unsupported("a 'become' of that call")
    }

    // A `become` at `e` of this instance passing `passed` argument words,
    // more on the stack than it received: the checker's error, naming the
    // instance's type arguments (MYLA-272). Nothing more is lowered.
    fun refuse_become(var self, cg: CodeGen, e: Expr, passed: int32) {
        var recv_stack = self.received - REG_ARG_WORDS
        if recv_stack < 0 { recv_stack = 0 }
        let msg = format("'become' passes {} argument words, {} of them on the stack, but '{}' received {} there", passed, passed - REG_ARG_WORDS, self.fn_name, recv_stack)
        var with = ""
        for sb in cg.subst {
            if with != "" { with = with + ", " }
            with = with + sb.name + " = " + type_name(sb.ty)
        }
        let note = format("in '{}' with {}: a value of a type parameter takes the words of its type", self.fn_name, with)
        self.refused.push(CheckErr { line: e.line, col: e.col, sp: e.sp, msg: msg, decl: e.id, notes: [Note { label: "note", msg: note, line: 0, col: 0, sp: no_span() }] })
        let d = self.unsupported("a refused 'become'")
    }

    // The call `c` ending the function by `become`: the owners dropped first,
    // since what the arguments need is theirs (owned, or kept by the caller's
    // caller: the checker sees to it), and the call jumped to.
    fun tail_call(var self, c: Inst) {
        self.drop_temps(0)
        self.drop_owners(0)
        self.add(c)
        self.leave(Term.Become)
        self.tailed = true
    }

    fun discard(var self, cg: CodeGen, e: Expr) {
        match e.kind {
            ExprKind.Await(x) => {
                if cg.frames {
                    let d = self.unsupported("an 'await' outside an async function's frame (in an async lambda)")
                    return
                }
                // without tasks, waiting for input or for a turn is nothing:
                // the read after it blocks (D124, as `await_let` says); its
                // arguments are evaluated. A socket's wait blocks in a poll
                if self.socket_wait_without_tasks(cg, x) { return }
                if waits_without_tasks(x) {
                    match x.kind {
                        ExprKind.Call(c, a, _) => { for arg in a { self.discard(cg, arg) } },
                        _ => {},
                    }
                    return
                }
                self.discard(cg, x)
                return
            },
            ExprKind.MatchE(scrut, arms) => {
                let v = self.match_expr(cg, e, scrut, arms, false)
                return
            },
            ExprKind.Call(callee, args, _) => {
                if !cg.ctor_info(e).ok {
                    let v = self.call(cg, e, callee, args, -1)
                    return
                }
            },
            _ => {},
        }
        if is_aggregate(cg.type_of(e.id)) {
            let p = self.addr(cg, e)
        } else {
            let v = self.expr(cg, e)
        }
    }

    // `target = value`: a local, or a field or element of one at any depth
    // (through a `var self` parameter's address too). The new value is taken
    // (retained) before the old one is released, which it may share.
    fun assign(var self, cg: CodeGen, target: Expr, value: Expr) {
        let t = self.place_type(cg, target)
        if !lowerable(cg, t) {
            let d = self.unsupported("an assignment of that type")
            return
        }
        match target.kind {
            ExprKind.Index(base, idx) => {
                if is_map_t(self.place_type(cg, base)) {
                    self.map_set(cg, base, idx, value)
                    return
                }
            },
            _ => {},
        }
        let local = match target.kind {
            ExprKind.Name(n) => self.lookup(n)
            _ => -1
        }
        match target.kind {
            ExprKind.Name(n) => {
                if local < 0 {
                    let d = self.unsupported("an assignment to that place")
                    return
                }
            },
            _ => {},
        }
        if local >= 0 && local != self.by_addr && (self.f.slots[local].owns || !is_aggregate(t)) {
            // a variable: nothing is evaluated between the value and the store
            if is_aggregate(t) {
                let src = self.addr(cg, value)
                if self.took(cg, t, src) {
                    // a new value, which can't share the old one
                    self.add(Inst.DropSlot(t, local))
                    self.add(Inst.Copy(self.slot_addr(local), src, cg.size(t)))
                    return
                }
                let staged = self.value_slot(cg, "__staged", t, false)
                let sp = self.slot_addr(staged)
                self.add(Inst.Copy(sp, src, cg.size(t)))
                self.retain(cg, t, sp)
                self.add(Inst.DropSlot(t, local))
                self.add(Inst.Copy(self.slot_addr(local), sp, cg.size(t)))
                return
            }
            let v = self.expr(cg, value)
            self.retain_or_take(cg, t, v)
            if self.f.slots[local].owns { self.add(Inst.DropSlot(t, local)) }
            self.add(Inst.Store(local, v))
            return
        }
        if local >= 0 && cg.is_boxed(t) {
            let d = self.unsupported("an assignment to a recursive enum through a parameter")
            return
        }
        // a member (or what a `var self` parameter points at): the value
        // first, then the place, which may still return early (`?`)
        let staged = self.stage(cg, t, value)
        let dst = self.place(cg, target)
        if cg.owns_heap(t) { self.add(Inst.DropAt(t, dst)) }
        self.store_staged(cg, t, dst, staged)
    }

    // The address of an assignable place: a local, a field, tuple element, list
    // element or map value of one at any depth, made unique on the way.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[0]
    fun place(var self, cg: CodeGen, e: Expr) -> int32 {
        // an index that may change or copy the place's variable: every
        // index on the path computed first, in order, then the path made
        // unique (H4)
        if !settled_path(e) { return self.place(cg, self.fixed_receiver(cg, e, e.id)) }
        match e.kind {
            ExprKind.Name(n) => {
                let slot = self.lookup(n)
                if slot >= 0 { return self.slot_addr(slot) }
            },
            ExprKind.GetField(tgt, field) => {
                // an actor's field: through its handle, shared (D89)
                if is_actor_t(self.place_type(cg, tgt)) {
                    let h = self.expr(cg, tgt)
                    return self.offset(h, cg.field_offset(self.place_type(cg, tgt), field))
                }
                let base = self.place(cg, tgt)
                return self.offset(base, cg.field_offset(self.place_type(cg, tgt), field))
            },
            ExprKind.TupleIndex(tgt, idx) => {
                let base = self.place(cg, tgt)
                return self.offset(base, cg.elem_offset(self.place_type(cg, tgt), idx as int32))
            },
            ExprKind.Index(base, idx) => {
                // the list made unique first (copy-on-write along the whole
                // path to the place), then the index, bounds-checked
                let lt = self.place_type(cg, base)
                if is_map_t(lt) {
                    // the map made unique first; trapping when the key is
                    // missing
                    let mh = self.place(cg, base)
                    let mc = self.temp(lt)
                    self.add(Inst.Cow(mc, lt, mh))
                    let k = self.key_operand(cg, lt, idx)
                    return self.map_value(cg, e, lt, mc, k)
                }
                if !is_list_t(lt) { return self.unsupported("an assignment to a byte") }
                let holder = self.place(cg, base)
                let cell = self.temp(Type.TPtr)
                self.add(Inst.Cow(cell, lt, holder))
                let i = self.index_of(cg, cell, idx)
                let d = self.temp(Type.TPtr)
                let size = cg.elem_size(list_elem(lt))
                self.add(Inst.Elem(d, cell, i, size, false, !self.in_bounds(base, idx), Pos { line: e.line, col: e.col }))
                self.mark_elem(d, size)
                return d
            },
            _ => {},
        }
        return self.unsupported("an assignment to that place")
    }

    fun if_stmt(var self, cg: CodeGen, c: Expr, then: Block, otherwise: Option<ElseTail>) {
        let then_b = self.new_block()
        let end = self.new_block()
        match otherwise {
            None => {
                self.branch(cg, c, then_b, end)
                self.start(then_b)
                self.block(cg, then)
                self.finish(Term.Jmp(end))
            },
            Some(et) => {
                let else_b = self.new_block()
                self.branch(cg, c, then_b, else_b)
                self.start(then_b)
                self.block(cg, then)
                self.finish(Term.Jmp(end))
                self.start(else_b)
                match et {
                    ElseTail.ElseBlock(b) => { self.block(cg, b) },
                    ElseTail.ElseIf(s2) => { self.stmt(cg, s2) },
                }
                self.finish(Term.Jmp(end))
            },
        }
        self.start(end)
    }

    // `for v in start..end { body }`: the variable and the end in slots, the
    // end evaluated once, the variable incremented (wrapping) after the body.
    fun for_range(var self, cg: CodeGen, vn: str, start: Option<Expr>, end: Option<Expr>, body: Block, iter: Option<Expr>) {
        match iter {
            Some(it) => {
                self.for_list(cg, vn, it, body)
                return
            },
            None => {},
        }
        let loop_t = match start {
            Some(e) => cg.type_of(e.id)
            None => Type.TInt(32, true)
        }
        let lv = self.new_slot(vn, loop_t, 8, -1, false)
        let fe = self.new_slot("__end", loop_t, 8, -1, false)
        // what is known of the variable for bounds checks (MYLA-251): it
        // only grows, from a start that isn't negative, and stays below
        // the end, which may be a length that can't change meanwhile
        var from_zero = false
        var below = ""
        match start {
            Some(e) => {
                from_zero = self.not_negative(e)
                let v = self.cond(cg, e)
                self.add(Inst.Store(lv, v))
            },
            None => {},
        }
        match end {
            Some(e) => {
                below = self.bound_key(cg, e)
                let v = self.cond(cg, e)
                self.add(Inst.Store(fe, v))
            },
            None => {},
        }
        // tested on the way in and after each step (MYLA-162: one jump a
        // turn, back to the body)
        let body_b = self.new_block()
        let cont = self.new_block()
        let done = self.new_block()
        self.range_test(lv, fe, loop_t, body_b, done)
        self.start(body_b)
        let depth = self.owners.len()
        self.open_scope()
        self.declare(vn, lv)
        self.add(Inst.Bind(vn, lv))
        if from_zero {
            self.nonneg.push(lv)
            if below != "" { self.below.push(LenFact { slot: lv, key: below }) }
        }
        self.loops.push(LoopTarget { cont: cont, brk: done, owners: depth, temps: self.temps.len() })
        for st in body.stmts { self.stmt(cg, st) }
        self.loops.pop()
        if from_zero {
            self.nonneg.pop()
            if below != "" { self.below.pop() }
        }
        self.close_scope()
        self.finish(Term.Jmp(cont))
        self.start(cont)
        let x = self.temp(loop_t)
        self.add(Inst.Load(x, lv))
        let one = self.konst(loop_t, 1)
        let y = self.temp(loop_t)
        self.add(Inst.Bin(y, "+", loop_t, loop_t, x, one, Pos { line: 0, col: 0 }))
        self.add(Inst.Store(lv, y))
        self.range_test(lv, fe, loop_t, body_b, done)
        self.start(done)
    }

    // The list or string `e` names, for bounds checks (MYLA-251), when its
    // length can't change while it is in scope: a fixed variable or a part
    // of one, or a variable the function never resizes or replaces
    // (`resized`); "" for any other.
    #test(lower_on(), expr_of("xs"))[""]
    fun len_key(self, e: Expr) -> str {
        return match e.kind {
            ExprKind.Name(n) => {
                let s = self.lookup(n)
                if s < 0 || self.shared_self(n) { return "" }
                if self.fixed_place(e) || (self.scanned && !list_has_str(self.resized, n)) { return format("{}", s) }
                ""
            },
            ExprKind.GetField(t, f) => {
                if !self.fixed_place(e) { return "" }
                let k = self.len_key(t)
                if k == "" { return "" }
                format("{}.{}", k, f)
            },
            ExprKind.TupleIndex(t, i) => {
                if !self.fixed_place(e) { return "" }
                let k = self.len_key(t)
                if k == "" { return "" }
                format("{}.{}", k, i)
            },
            _ => "",
        }
    }

    // `len_key` of the list or string whose length `e` is (`xs.len()`,
    // `len(xs)`); "" when it is no such length.
    fun len_call_key(self, cg: CodeGen, e: Expr) -> str {
        return match e.kind {
            ExprKind.Call(c, args, _) => {
                var of: Option<Expr> = None
                match c.kind {
                    ExprKind.GetField(t, f) => { if f == "len" && args.len() == 0 { of = Some(t) } },
                    ExprKind.Name(f) => { if f == "len" && args.len() == 1 && self.lookup("len") < 0 { of = Some(args[0]) } },
                    _ => {},
                }
                match of {
                    Some(x) => {
                        let t = cg.type_of(x.id)
                        if !is_list_t(t) && !is_tstr(t) { return "" }
                        // the builtin, not a method of the program's (D144)
                        if cg.has_func(format("{}.len", cg.type_key(t))) { return "" }
                        self.len_key(x)
                    },
                    None => "",
                }
            },
            _ => "",
        }
    }

    // `len_call_key` of a range's end, or of the length a `let` it names
    // holds.
    fun bound_key(self, cg: CodeGen, e: Expr) -> str {
        match e.kind {
            ExprKind.Name(n) => {
                let s = self.lookup(n)
                for f in self.len_lets { if f.slot == s { return f.key } }
                return ""
            },
            _ => {},
        }
        return self.len_call_key(cg, e)
    }

    // Whether `e`, a range's start, can't be negative: a constant that isn't,
    // the variable of an enclosing range from such a start, or one of them
    // plus 0 or 1 (a variable below its end, itself an integer, plus one
    // doesn't wrap).
    #test(lower_on(), expr_of("-n * 2"))[false]
    fun not_negative(self, e: Expr) -> bool {
        return match e.kind {
            ExprKind.IntLit(v, suffix, is_char, big) => v >= 0 && big == "",
            ExprKind.Name(n) => contains_int(self.nonneg, self.lookup(n)),
            ExprKind.Binary(op, l, r) => op == "+" && match r.kind {
                ExprKind.IntLit(v, suffix, is_char, big) => (v == 0 || v == 1) && big == "" && match l.kind {
                    ExprKind.Name(n) => contains_int(self.nonneg, self.lookup(n)),
                    _ => false,
                },
                _ => false,
            },
            _ => false,
        }
    }

    // Whether element `idx` of `base` is known to exist (MYLA-251): `idx` is
    // the variable of a range below the length of the list or string `base`
    // names.
    fun in_bounds(self, base: Expr, idx: Expr) -> bool {
        return match idx.kind {
            ExprKind.Name(n) => {
                let s = self.lookup(n)
                for f in self.below {
                    if f.slot == s { return f.key == self.len_key(base) }
                }
                false
            },
            _ => false,
        }
    }

    // A range loop's test, `lv < fe`, ending the block: on to `yes` or `no`.
    fun range_test(var self, lv: int32, fe: int32, loop_t: Type, yes: int32, no: int32) {
        let a = self.temp(loop_t)
        self.add(Inst.Load(a, lv))
        let b = self.temp(loop_t)
        self.add(Inst.Load(b, fe))
        let c = self.temp(Type.TBool)
        self.add(Inst.Cmp(c, "<", loop_t, a, b))
        self.finish(Term.Br(c, yes, no))
    }

    // `for v in xs { body }`: the loop holds a reference to the list (dropped
    // when it ends, or by a `return` from the body), walks it by index, and
    // `v` borrows each element in turn. Over a map, the list is a new one of
    // its keys.
    fun for_list(var self, cg: CodeGen, vn: str, it: Expr, body: Block) {
        let it_t = cg.type_of(it.id)
        if is_tstr(it_t) {
            self.for_str(cg, vn, it, body)
            return
        }
        if (!is_list_t(it_t) && !is_map_t(it_t)) || !lowerable(cg, it_t) {
            let d = self.unsupported("a for loop over that type")
            return
        }
        var lt = it_t
        if is_map_t(it_t) { lt = Type.TList(map_key(it_t)) }
        let et = list_elem(lt)
        let stride = cg.elem_size(et)
        let held = self.value_slot(cg, "__iterated", lt, true)
        self.begin_temps()
        let v = self.expr(cg, it)
        if is_map_t(it_t) {
            self.add(Inst.Store(held, self.map_keys(cg, it_t, v)))
        } else {
            self.add(Inst.Store(held, v))
            // a fixed iterable needs no snapshot of its own (MYLA-122)
            if self.fixed_place(it) { self.f.slots[held].owns = false } else { self.retain(cg, lt, v) }
        }
        self.end_temps()
        var loop_owners: [int32] = []
        self.owners.push(loop_owners)
        self.own(held)
        let idx = self.new_slot("__index", Type.TInt(64, false), 8, -1, false)
        let zero = self.konst(Type.TInt(64, false), 0)
        self.add(Inst.Store(idx, zero))
        let elem = self.value_slot(cg, vn, et, false)
        // tested on the way in and after each step (MYLA-162)
        let body_b = self.new_block()
        let cont = self.new_block()
        let done = self.new_block()
        self.list_test(idx, held, lt, body_b, done)
        self.start(body_b)
        let i = self.temp(Type.TInt(64, false))
        self.add(Inst.Load(i, idx))
        let cell = self.temp(lt)
        self.add(Inst.Load(cell, held))
        let p = self.temp(Type.TPtr)
        // below the length `list_test` compared it with, of a list nothing
        // resizes: the loop holds it (MYLA-251)
        self.add(Inst.Elem(p, cell, i, stride, false, false, Pos { line: 0, col: 0 }))
        self.mark_elem(p, stride)
        if is_aggregate(et) {
            let dst = self.slot_addr(elem)
            self.add(Inst.Copy(dst, self.unbox(cg, et, p), cg.size(et)))
        } else {
            let x = self.temp(et)
            self.add_load(x, p, 0)
            self.add(Inst.Store(elem, x))
        }
        let depth = self.owners.len()
        self.open_scope()
        self.declare_as(vn, elem, true)
        self.add(Inst.Bind(vn, elem))
        self.loops.push(LoopTarget { cont: cont, brk: done, owners: depth, temps: self.temps.len() })
        for st in body.stmts { self.stmt(cg, st) }
        self.loops.pop()
        self.close_scope()
        self.finish(Term.Jmp(cont))
        self.start(cont)
        let i2 = self.temp(Type.TInt(64, false))
        self.add(Inst.Load(i2, idx))
        let one = self.konst(Type.TInt(64, false), 1)
        let i3 = self.temp(Type.TInt(64, false))
        self.add(Inst.Bin(i3, "+", Type.TInt(64, false), Type.TInt(64, false), i2, one, Pos { line: 0, col: 0 }))
        self.add(Inst.Store(idx, i3))
        self.list_test(idx, held, lt, body_b, done)
        self.start(done)
        self.drop_owners(self.owners.len() - 1)
        self.owners.pop()
    }

    // `for c in s { body }` over a string's characters (MYLA-318): the loop
    // holds the string, as `for_list` a list, and walks its bytes, an ASCII
    // byte the character itself, any other decoded by std.rt's
    // `str_char_at` (U+FFFD for a byte that isn't UTF-8, as `s.chars()`),
    // without the list `s.chars()` would make. The index moves past the
    // character before the body runs, so `continue` goes to the test.
    fun for_str(var self, cg: CodeGen, vn: str, it: Expr, body: Block) {
        let st = Type.TStr
        let u64 = Type.TInt(64, false)
        let i64 = Type.TInt(64, true)
        let held = self.value_slot(cg, "__iterated", st, true)
        self.begin_temps()
        let v = self.expr(cg, it)
        self.add(Inst.Store(held, v))
        if self.fixed_place(it) { self.f.slots[held].owns = false } else { self.retain(cg, st, v) }
        self.end_temps()
        var loop_owners: [int32] = []
        self.owners.push(loop_owners)
        self.own(held)
        let idx = self.new_slot("__index", u64, 8, -1, false)
        self.add(Inst.Store(idx, self.konst(u64, 0)))
        let elem = self.value_slot(cg, vn, Type.TChar, false)
        let body_b = self.new_block()
        let ascii = self.new_block()
        let multi = self.new_block()
        let run = self.new_block()
        let cont = self.new_block()
        let done = self.new_block()
        self.list_test(idx, held, st, body_b, done)
        self.start(body_b)
        let i = self.temp(u64)
        self.add(Inst.Load(i, idx))
        let cell = self.temp(st)
        self.add(Inst.Load(cell, held))
        // below the length `list_test` compared it with
        let p = self.temp(Type.TPtr)
        self.add(Inst.Elem(p, cell, i, 1, true, false, Pos { line: 0, col: 0 }))
        let byte = self.temp(Type.TInt(8, false))
        self.add(Inst.Load8(byte, p))
        let is_ascii = self.temp(Type.TBool)
        self.add(Inst.Cmp(is_ascii, "<", Type.TInt(8, false), byte, self.konst(Type.TInt(8, false), 128)))
        self.finish(Term.Br(is_ascii, ascii, multi))
        self.start(ascii)
        let c1 = self.temp(Type.TChar)
        self.add(Inst.Cast(c1, Type.TInt(8, false), Type.TChar, byte))
        self.add(Inst.Store(elem, c1))
        let next1 = self.temp(u64)
        self.add(Inst.Bin(next1, "+", u64, u64, i, self.konst(u64, 1), Pos { line: 0, col: 0 }))
        self.add(Inst.Store(idx, next1))
        self.finish(Term.Jmp(run))
        self.start(multi)
        // `cp | len << 32`
        let r = self.temp(i64)
        self.add(Inst.Call(r, "std$rt$str_char_at", [cell, i]))
        let cp = self.temp(i64)
        self.add(Inst.Bin(cp, "&", i64, i64, r, self.konst(i64, 0xFFFFFFFF), Pos { line: 0, col: 0 }))
        let c2 = self.temp(Type.TChar)
        self.add(Inst.Cast(c2, i64, Type.TChar, cp))
        self.add(Inst.Store(elem, c2))
        let len = self.temp(i64)
        self.add(Inst.Bin(len, ">>", i64, i64, r, self.konst(i64, 32), Pos { line: 0, col: 0 }))
        let next2 = self.temp(u64)
        self.add(Inst.Bin(next2, "+", u64, u64, i, len, Pos { line: 0, col: 0 }))
        self.add(Inst.Store(idx, next2))
        self.finish(Term.Jmp(run))
        self.start(run)
        let depth = self.owners.len()
        self.open_scope()
        self.declare_as(vn, elem, true)
        self.add(Inst.Bind(vn, elem))
        self.loops.push(LoopTarget { cont: cont, brk: done, owners: depth, temps: self.temps.len() })
        for s in body.stmts { self.stmt(cg, s) }
        self.loops.pop()
        self.close_scope()
        self.finish(Term.Jmp(cont))
        self.start(cont)
        self.list_test(idx, held, st, body_b, done)
        self.start(done)
        self.drop_owners(self.owners.len() - 1)
        self.owners.pop()
    }

    // A list loop's test, the index in `idx` below the length of the list
    // `held` holds, ending the block: on to `yes` or `no`.
    fun list_test(var self, idx: int32, held: int32, lt: Type, yes: int32, no: int32) {
        let i = self.temp(Type.TInt(64, false))
        self.add(Inst.Load(i, idx))
        let cell = self.temp(lt)
        self.add(Inst.Load(cell, held))
        let n = self.temp(Type.TInt(64, false))
        self.add_load(n, cell, 0)
        let c = self.temp(Type.TBool)
        self.add(Inst.Cmp(c, "<", Type.TInt(64, false), i, n))
        self.finish(Term.Br(c, yes, no))
    }

    // --- scalar expressions -----------------------------------------------------

    // The temporary holding the value of the scalar expression `e` (for a
    // string, the cell pointer: borrowed, or owned by a temporary slot).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[0]
    fun expr(var self, cg: CodeGen, e: Expr) -> int32 {
        if self.err != "" { return 0 }
        let t = cg.type_of(e.id)
        match e.kind {
            ExprKind.IntLit(v, suf, isc, big) => { return self.konst(t, v) },
            ExprKind.FloatLit(lex, suf) => {
                var bits = f64_literal_bits(lex)
                match t {
                    Type.TFloat(w) => { if w == 32 { bits = f32_round_bits(bits) } },
                    _ => {},
                }
                return self.konst(t, bits as int64)
            },
            ExprKind.BoolLit(b) => {
                var one: int64 = 0
                if b { one = 1 }
                return self.konst(Type.TBool, one)
            },
            ExprKind.StrLit(text) => {
                // a static cell: no reference to own
                let d = self.temp(Type.TStr)
                self.add(Inst.Str(d, text))
                return d
            },
            ExprKind.Name(n) => { return self.name(cg, n, t) },
            ExprKind.Unary(op, x) => {
                if !is_scalar(t) { return self.unsupported("a unary operator on a value that isn't a scalar") }
                // a negative integer literal is a constant (an immediate
                // operand where it fits, MYLA-125); the backend wraps it
                match x.kind {
                    ExprKind.IntLit(v, suf, isc, big) => {
                        if op == "-" && match t { Type.TInt(w, sg) => true, _ => false } { return self.konst(t, 0 - v) }
                    },
                    _ => {},
                }
                let a = self.expr(cg, x)
                if self.checked && op == "-" { self.check_neg(t, a, Pos { line: e.line, col: e.col }) }
                let d = self.temp(t)
                self.add(Inst.Un(d, op, t, a))
                return d
            },
            ExprKind.Binary(op, l, r) => { return self.binary(cg, e, op, l, r) },
            ExprKind.Cast(x, ty) => {
                let src = cg.type_of(x.id)
                if !is_scalar(src) || !is_scalar(t) { return self.unsupported("a cast of a value that isn't a scalar") }
                let a = self.expr(cg, x)
                if char_cast_checked(src, t) { self.check_scalar(a, Pos { line: e.line, col: e.col }) }
                let d = self.temp(t)
                self.add(Inst.Cast(d, src, t, a))
                return d
            },
            ExprKind.Call(callee, args, _) => {
                let d = self.call(cg, e, callee, args, -1)
                if d < 0 { return self.unsupported("a call without a value used as one") }
                return d
            },
            ExprKind.GetField(tgt, field) => {
                if is_aggregate(t) { return self.unsupported("an aggregate field used as a scalar") }
                let base = self.field_base(cg, tgt)
                let d = self.temp(t)
                self.add_load(d, base, cg.field_offset(self.place_type(cg, tgt), field))
                return d
            },
            ExprKind.TupleIndex(tgt, idx) => {
                if is_aggregate(t) { return self.unsupported("an aggregate element used as a scalar") }
                let base = self.addr(cg, tgt)
                let d = self.temp(t)
                self.add_load(d, base, cg.elem_offset(self.place_type(cg, tgt), idx as int32))
                return d
            },
            ExprKind.MatchE(scrut, arms) => { return self.match_expr(cg, e, scrut, arms, true) },
            ExprKind.Index(base, idx) => {
                if is_slice_expr(idx) { return self.slice_expr(cg, e, base, idx) }
                let p = self.elem_read(cg, e, base, idx)
                if is_aggregate(t) { return self.unsupported("an aggregate element used as a scalar") }
                let d = self.temp(t)
                if is_tstr(self.place_type(cg, base)) { self.add(Inst.Load8(d, p)) } else { self.add_load(d, p, 0) }
                return d
            },
            ExprKind.ListLit(elems) => { return self.list_lit(cg, t, elems) },
            ExprKind.MapLit(entries) => { return self.map_lit(cg, t, entries) },
            ExprKind.StructLit(name, fields) => {
                if is_actor_t(t) { return self.actor_lit(cg, t, fields) }
            },
            // one task: the awaited call runs here (D91, MYLA-138)
            ExprKind.Await(x) => {
                if cg.frames { return self.unsupported("an 'await' outside an async function's frame (in an async lambda)") }
                if self.socket_wait_without_tasks(cg, x) { return -1 }
                if waits_without_tasks(x) {
                    match x.kind {
                        ExprKind.Call(c, a, _) => { for arg in a { self.discard(cg, arg) } },
                        _ => {},
                    }
                    return -1
                }
                return self.expr(cg, x)
            },
            ExprKind.Try(inner) => { return self.try_expr(cg, e, inner) },
            _ => {},
        }
        return self.unsupported("that kind of expression")
    }

    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "a", Type.TBool)[0]
    fun name(var self, cg: CodeGen, n: str, t: Type) -> int32 {
        let slot = self.lookup(n)
        if slot >= 0 {
            if is_aggregate(self.f.slots[slot].ty) { return self.unsupported("an aggregate used as a scalar") }
            return self.read_var(slot)
        }
        // a str const is its folded value, a static string (MYLA-84)
        match cg.const_strs.get(n) {
            Some(text) => {
                let d = self.temp(Type.TStr)
                self.add(Inst.Str(d, text))
                return d
            },
            None => {},
        }
        if !is_scalar(t) { return self.unsupported("a name that isn't a local") }
        // a scalar const is its expression, evaluated where it is used
        match cg.const_value_expr(n) {
            Some(ve) => { return self.expr(cg, ve) },
            None => {},
        }
        return self.unsupported("a function used as a value")
    }

    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), "*", expr_of("(a, 'c')"), expr_of("(a, 'c')"))[1]
    fun binary(var self, cg: CodeGen, e: Expr, op: str, l: Expr, r: Expr) -> int32 {
        if op == "&&" || op == "||" { return self.logical(cg, op, l, r) }
        let lt = cg.type_of(l.id)
        let rt = cg.type_of(e.id)
        if is_overloadable_op(op) && is_struct_or_enum_t(lt) && lowerable(cg, lt) {
            return self.overloaded_scalar(cg, op, l, r, lt)
        }
        if (op == "==" || op == "!=") && is_unit(lt) {
            // the unit type has one value (D138): equal, once both sides ran
            self.discard(cg, l)
            self.discard(cg, r)
            if op == "==" { return self.konst(Type.TBool, 1) }
            return self.konst(Type.TBool, 0)
        }
        if (op == "==" || op == "!=") && is_compound_eq_t(lt) {
            // a tuple's addresses or a list's cells, to its `__eq_<T>` (D163)
            var a = -1
            var b = -1
            if is_list_t(lt) {
                a = self.expr(cg, l)
                b = self.expr(cg, r)
            } else {
                a = self.addr(cg, l)
                b = self.addr(cg, r)
            }
            let eq = self.temp(Type.TBool)
            self.add(Inst.Call(eq, self.want_eq(lt), [a, b]))
            if op == "==" { return eq }
            let d = self.temp(Type.TBool)
            self.add(Inst.Un(d, "!", Type.TBool, eq))
            return d
        }
        if is_tstr(lt) {
            if op == "==" || op == "!=" {
                let a = self.expr(cg, l)
                let b = self.expr(cg, r)
                let eq = self.temp(Type.TBool)
                self.rt_call(cg, eq, "__str_eq", [a, b])
                if op == "==" { return eq }
                let d = self.temp(Type.TBool)
                self.add(Inst.Un(d, "!", Type.TBool, eq))
                return d
            }
            if op == "+" {
                let a = self.expr(cg, l)
                let b = self.expr(cg, r)
                let d = self.temp(Type.TStr)
                self.rt_call(cg, d, "__str_concat", [a, b])
                return self.owned_value(cg, d, Type.TStr)
            }
            if is_cmp(op) {
                // byte-wise, std.rt's `str_cmp` against 0 (MYLA-318)
                let a = self.expr(cg, l)
                let b = self.expr(cg, r)
                let i64 = Type.TInt(64, true)
                let c = self.temp(i64)
                self.add(Inst.Call(c, "std$rt$str_cmp", [a, b]))
                let d = self.temp(Type.TBool)
                self.add(Inst.Cmp(d, op, i64, c, self.konst(i64, 0)))
                return d
            }
            return self.unsupported("that operator on strings")
        }
        if is_char_type(lt) && (op == "+" || op == "-") { return self.char_arith(cg, e, op, l, r) }
        if !is_scalar(lt) || !is_scalar(rt) { return self.unsupported("an operator on values that aren't scalars") }
        let a = self.expr(cg, l)
        let b = self.expr(cg, r)
        // two constants (literals, `const`s): one, folded (MYLA-162); in a
        // checked build not if it overflows, which traps where it runs
        match self.folded(op, lt, rt, a, b, self.checked) {
            Some(v) => { return self.konst(rt, v) },
            None => {},
        }
        let pos = Pos { line: e.line, col: e.col }
        if self.checked {
            let c = self.checked_arith(op, lt, rt, a, b, pos)
            if c >= 0 { return c }
        }
        let d = self.temp(rt)
        if op == "==" || op == "!=" || is_cmp(op) {
            self.add(Inst.Cmp(d, op, lt, a, b))
        } else {
            self.add(Inst.Bin(d, op, lt, rt, a, b, pos))
        }
        return d
    }

    // `x.wrapping_add(y)`, `x.wrapping_sub(y)`, `x.wrapping_mul(y)`,
    // `x.wrapping_neg()` (D175): the plain operation, which wraps, never
    // checked for overflow; one instruction.
    fun wrapping(var self, cg: CodeGen, e: Expr, nm: str, args: [Expr]) -> int32 {
        let t = cg.type_of(e.id)
        let a = self.expr(cg, args[0])
        let d = self.temp(t)
        if nm == "wrapping_neg" {
            self.add(Inst.Un(d, "-", t, a))
            return d
        }
        let b = self.expr(cg, args[1])
        let op = if nm == "wrapping_add" { "+" } else if nm == "wrapping_sub" { "-" } else { "*" }
        match self.folded(op, t, t, a, b, false) {
            Some(v) => { return self.konst(t, v) },
            None => {},
        }
        self.add(Inst.Bin(d, op, t, t, a, b, Pos { line: e.line, col: e.col }))
        return d
    }

    // `a op b` on integers in a checked build (D175): `+`, `-` and `*` that
    // don't fit their type, and the signed minimum divided by -1, trap with
    // `integer overflow`; a shift whose count isn't below the width with
    // `shift amount out of range`. The result, or -1 for an operation that
    // checks nothing (built as in a plain build). Narrower than 64 bits, the
    // operation in 64 bits is exact and must equal its own value wrapped to
    // the type; at 64 bits the signs (`+`, `-`), an unsigned comparison or
    // std.rt's `mul_overflows_*` tell.
    fun checked_arith(var self, op: str, lt: Type, rt: Type, a: int32, b: int32, pos: Pos) -> int32 {
        let w = match lt { Type.TInt(n, sg) => n, _ => 0 }
        if w == 0 || !type_eq_ir(lt, rt) { return -1 }
        let signed = match lt { Type.TInt(n, sg) => sg, _ => false }
        let i64 = Type.TInt(64, true)
        let u64 = Type.TInt(64, false)
        if op == "<<" || op == ">>" {
            // the count as unsigned: a negative one is as far out of range
            let ok = self.temp(Type.TBool)
            self.add(Inst.Cmp(ok, "<", u64, b, self.konst(u64, w as int64)))
            self.add(Inst.Check(ok, "shift", pos))
            return -1
        }
        if op == "/" {
            if !signed { return -1 }
            // not (a == MIN and b == -1): (a ^ MIN) | (b ^ -1) isn't 0
            let x = self.temp(i64)
            self.add(Inst.Bin(x, "^", i64, i64, a, self.konst(i64, int_min(w)), pos))
            let y = self.temp(i64)
            self.add(Inst.Bin(y, "^", i64, i64, b, self.konst(i64, -1), pos))
            let z = self.temp(i64)
            self.add(Inst.Bin(z, "|", i64, i64, x, y, pos))
            let ok = self.temp(Type.TBool)
            self.add(Inst.Cmp(ok, "!=", i64, z, self.konst(i64, 0)))
            self.add(Inst.Check(ok, "overflow", pos))
            return -1
        }
        if op != "+" && op != "-" && op != "*" { return -1 }
        let ok = self.temp(Type.TBool)
        if w < 64 {
            let wide = self.temp(i64)
            self.add(Inst.Bin(wide, op, i64, i64, a, b, pos))
            let d = self.temp(rt)
            self.add(Inst.Cast(d, i64, rt, wide))
            self.add(Inst.Cmp(ok, "==", i64, d, wide))
            self.add(Inst.Check(ok, "overflow", pos))
            return d
        }
        let d = self.temp(rt)
        self.add(Inst.Bin(d, op, lt, rt, a, b, pos))
        if op == "*" {
            let over = self.temp(Type.TBool)
            self.add(Inst.Call(over, if signed { "std$rt$mul_overflows_i64" } else { "std$rt$mul_overflows_u64" }, [a, b]))
            self.add(Inst.Un(ok, "!", Type.TBool, over))
        } else if !signed {
            // unsigned: a sum below an operand wrapped, as does a difference
            // of a smaller minuend
            if op == "+" { self.add(Inst.Cmp(ok, ">=", u64, d, a)) } else { self.add(Inst.Cmp(ok, ">=", u64, a, b)) }
        } else {
            // signed: the result's sign against the operands' (Hacker's
            // Delight 2-13): `+` overflows when both differ from it, `-` when
            // the operands differ and the result differs from `a`
            let x = self.temp(i64)
            let y = self.temp(i64)
            if op == "+" {
                self.add(Inst.Bin(x, "^", i64, i64, a, d, pos))
                self.add(Inst.Bin(y, "^", i64, i64, b, d, pos))
            } else {
                self.add(Inst.Bin(x, "^", i64, i64, a, b, pos))
                self.add(Inst.Bin(y, "^", i64, i64, a, d, pos))
            }
            let m = self.temp(i64)
            self.add(Inst.Bin(m, "&", i64, i64, x, y, pos))
            self.add(Inst.Cmp(ok, ">=", i64, m, self.konst(i64, 0)))
        }
        self.add(Inst.Check(ok, "overflow", pos))
        return d
    }

    // `-a` in a checked build (D175): a trap for the signed minimum, and for
    // any unsigned number but 0, whose negation doesn't fit.
    fun check_neg(var self, t: Type, a: int32, pos: Pos) {
        let w = match t { Type.TInt(n, sg) => n, _ => 0 }
        if w == 0 { return }
        let signed = match t { Type.TInt(n, sg) => sg, _ => false }
        let i64 = Type.TInt(64, true)
        let ok = self.temp(Type.TBool)
        if signed { self.add(Inst.Cmp(ok, "!=", i64, a, self.konst(i64, int_min(w)))) }
        else { self.add(Inst.Cmp(ok, "==", i64, a, self.konst(i64, 0))) }
        self.add(Inst.Check(ok, "overflow", pos))
    }

    // The integer `a` (an `int32` or wider, sign-extended) a Unicode scalar
    // or a trap at `pos` (MYLA-177): at most 10FFFF, not a surrogate (D800
    // to DFFF).
    fun check_scalar(var self, a: int32, pos: Pos) {
        let u = Type.TInt(64, false)
        let in_range = self.temp(Type.TBool)
        self.add(Inst.Cmp(in_range, "<=", u, a, self.konst(u, 1114111)))
        self.add(Inst.Check(in_range, "char", pos))
        let off = self.temp(u)
        self.add(Inst.Bin(off, "-", u, u, a, self.konst(u, 55296), pos))
        let not_surrogate = self.temp(Type.TBool)
        self.add(Inst.Cmp(not_surrogate, ">=", u, off, self.konst(u, 2048)))
        self.add(Inst.Check(not_surrogate, "char", pos))
    }

    // `c - d` on two chars, the `int32` between their code points; `c + n`
    // and `c - n` with an `int32` `n`, the char that far from `c`, checked
    // as a cast to char is (MYLA-318).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), "-", expr_of("(a, 'c')"), expr_of("(a, 'c')"))[9]
    fun char_arith(var self, cg: CodeGen, e: Expr, op: str, l: Expr, r: Expr) -> int32 {
        let i32 = Type.TInt(32, true)
        let a = self.expr(cg, l)
        let b = self.expr(cg, r)
        let ai = self.temp(i32)
        self.add(Inst.Cast(ai, Type.TChar, i32, a))
        var bi = b
        let rt = cg.type_of(r.id)
        if is_char_type(rt) {
            bi = self.temp(i32)
            self.add(Inst.Cast(bi, Type.TChar, i32, b))
        }
        let pos = Pos { line: e.line, col: e.col }
        let v = self.temp(i32)
        self.add(Inst.Bin(v, op, i32, i32, ai, bi, pos))
        if is_char_type(rt) { return v }
        self.check_scalar(v, pos)
        let d = self.temp(Type.TChar)
        self.add(Inst.Cast(d, i32, Type.TChar, v))
        return d
    }

    // `a == b`, `a != b` and the orderings on a user type: its `eq` or `cmp`
    // method, called with both operands' addresses.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "<", expr_of("(a, 'c')"), expr_of("(a, 'c')"), Type.TStruct("Vec2", []))[3]
    fun overloaded_scalar(var self, cg: CodeGen, op: str, l: Expr, r: Expr, lt: Type) -> int32 {
        // the derived `eq` of an enum without payloads: equal tags (MYLA-133)
        if (op == "==" || op == "!=") && cg.tag_only_eq(lt) {
            let ta = self.temp(Type.TInt(64, true))
            self.add_load(ta, self.addr(cg, l), 0)
            let tb = self.temp(Type.TInt(64, true))
            self.add_load(tb, self.addr(cg, r), 0)
            let eq = self.temp(Type.TBool)
            self.add(Inst.Cmp(eq, op, Type.TInt(64, true), ta, tb))
            return eq
        }
        let key = cg.type_key(lt)
        var method = ""
        if op == "==" || op == "!=" { method = "eq" } else if is_cmp(op) { method = "cmp" } else { return self.unsupported("an arithmetic operator on a user type used as a scalar") }
        let name = format("{}.{}", key, method)
        let callee = self.method_instance(cg, name, [l, r])
        // by value when a `become` hands one over to it (D88; a derived `eq`
        // is the code generator's routine, which takes addresses)
        var byval = [false, false]
        if cg.has_func(name) && cg.has_byval(cg.sig_of(name)) {
            let msig = cg.sig_of(name)
            byval = [cg.byval_param(msig, 0, lt), cg.byval_param(msig, 1, lt)]
        }
        var vals: [int32] = []
        var k = 0
        for side in [l, r] {
            let p = self.addr(cg, side)
            if byval[k] { for w in self.value_words(cg, lt, p) { vals.push(w) } } else { vals.push(p) }
            k = k + 1
        }
        let res = self.temp(Type.TInt(64, true))
        self.add(Inst.Call(res, callee, vals))
        if op == "==" { return res }
        let d = self.temp(Type.TBool)
        if op == "!=" {
            self.add(Inst.Un(d, "!", Type.TBool, res))
            return d
        }
        let zero = self.konst(Type.TInt(64, true), 0)
        self.add(Inst.Cmp(d, op, Type.TInt(64, true), res, zero))
        return d
    }

    // `l && r` / `l || r`: `r` runs only when it decides the result; each
    // operand drops its own temporaries, since the right one may not run.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "&&", expr_of("(a, 'c')"), expr_of("(a, 'c')"))[0]
    fun logical(var self, cg: CodeGen, op: str, l: Expr, r: Expr) -> int32 {
        let d = self.temp(Type.TBool)
        let a = self.cond(cg, l)
        let rhs = self.new_block()
        let yes = self.new_block()
        let no = self.new_block()
        let end = self.new_block()
        if op == "&&" { self.finish(Term.Br(a, rhs, no)) } else { self.finish(Term.Br(a, yes, rhs)) }
        self.start(rhs)
        let b = self.cond(cg, r)
        self.finish(Term.Br(b, yes, no))
        self.start(yes)
        self.add(Inst.Const(d, Type.TBool, 1))
        self.finish(Term.Jmp(end))
        self.start(no)
        self.add(Inst.Const(d, Type.TBool, 0))
        self.finish(Term.Jmp(end))
        self.start(end)
        return d
    }

    // --- aggregate expressions --------------------------------------------------

    // A temporary holding the address of the aggregate value of `e`: where a
    // variable keeps it (borrowed), or a slot the value is built in (owned
    // by the statement when it holds heap values).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[0]
    fun addr(var self, cg: CodeGen, e: Expr) -> int32 {
        // the destination offered to this expression only, not to its parts
        let into = self.into
        self.into = -1
        if self.err != "" { return 0 }
        let t = cg.type_of(e.id)
        if !lowerable(cg, t) { return self.unsupported("an aggregate of that type") }
        let ci = cg.ctor_info(e)
        if ci.ok { return self.enum_ctor(cg, t, ci.enum_name, ci.variant, ci.args, into) }
        match e.kind {
            ExprKind.Name(n) => {
                let slot = self.lookup(n)
                if slot >= 0 { return self.slot_addr(slot) }
                if cg.has_func(n) { return self.fn_value(cg, e, n) }
                return self.unsupported("that name as a value")
            },
            ExprKind.Lambda(params, rt, body, asy) => { return self.lambda_value(cg, e, params, body) },
            ExprKind.GetField(tgt, field) => {
                let base = self.field_base(cg, tgt)
                return self.unbox(cg, t, self.offset(base, cg.field_offset(self.place_type(cg, tgt), field)))
            },
            ExprKind.Await(x) => {
                if cg.frames { return self.unsupported("an 'await' outside an async function's frame (in an async lambda)") }
                return self.addr(cg, x)
            },
            ExprKind.TupleIndex(tgt, idx) => {
                let base = self.addr(cg, tgt)
                return self.unbox(cg, t, self.offset(base, cg.elem_offset(self.place_type(cg, tgt), idx as int32)))
            },
            ExprKind.StructLit(name, fields) => {
                let slot = self.build_slot(cg, "__struct", t, into)
                let base = self.slot_addr(slot)
                for fi in fields { self.store_member(cg, fi.value, base, cg.field_offset(t, fi.name)) }
                self.built(slot, into, base)
                return base
            },
            ExprKind.TupleLit(elems) => {
                let slot = self.build_slot(cg, "__tuple", t, into)
                let base = self.slot_addr(slot)
                var i = 0
                for el in elems {
                    self.store_member(cg, el, base, cg.elem_offset(t, i))
                    i = i + 1
                }
                self.built(slot, into, base)
                return base
            },
            ExprKind.Call(callee, args, _) => {
                let d = self.call(cg, e, callee, args, into)
                if d >= 0 { return d }
                if !is_unit(t) { return self.unsupported("a call without a value used as one") }
                // a function without a result gives `()` (D140): no bytes
                let slot = self.build_slot(cg, "__tuple", t, into)
                let base = self.slot_addr(slot)
                self.built(slot, into, base)
                return base
            },
            ExprKind.Binary(op, l, r) => {
                let lt = cg.type_of(l.id)
                if op == ">>" && is_tfunc(lt) { return self.compose(cg, e, l, r) }
                if !is_overloadable_op(op) || !is_struct_or_enum_t(lt) { return self.unsupported("that operator on aggregates") }
                let pa = self.addr(cg, l)
                let pb = self.addr(cg, r)
                let slot = self.value_slot(cg, "__result", t, true)
                let res = self.slot_addr(slot)
                // a generic impl's operator: its instance for the operands'
                // type arguments (MYLA-367, M2)
                let callee = self.method_instance(cg, format("{}.{}", cg.type_key(lt), arith_method_cg(op)), [l, r])
                self.add(Inst.CallSret(callee, res, [pa, pb]))
                self.own_temp(slot)
                return res
            },
            ExprKind.MatchE(scrut, arms) => { return self.match_expr(cg, e, scrut, arms, true) },
            ExprKind.Index(base, idx) => { return self.unbox(cg, t, self.elem_read(cg, e, base, idx)) },
            ExprKind.Try(inner) => { return self.try_expr(cg, e, inner) },
            _ => {},
        }
        return self.unsupported("that kind of aggregate expression")
    }

    // The address the fields of `tgt`'s value are at: its own, or an actor's
    // cell, through its handle (D89).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[0]
    fun field_base(var self, cg: CodeGen, tgt: Expr) -> int32 {
        if is_actor_t(self.place_type(cg, tgt)) { return self.expr(cg, tgt) }
        return self.addr(cg, tgt)
    }

    // `A { … }` of an actor: a new cell holding the fields, each with its
    // own references; the statement owns the handle (D89).
    fun actor_lit(var self, cg: CodeGen, t: Type, fields: [FieldInit]) -> int32 {
        let off = actor_record_offset(cg, t)
        let size = self.int_const(off + ACTOR_RECORD)
        let p = self.temp(t)
        self.add(Inst.Rt(p, "__alloc", [size]))
        // its executor (D92), after the fields: free, no frame waiting
        var w = 0
        while w < ACTOR_RECORD {
            self.add_store(p, off + w, self.int_const(0))
            w = w + 8
        }
        for fi in fields { self.store_member(cg, fi.value, p, cg.field_offset(t, fi.name)) }
        return self.owned_value(cg, p, t)
    }

    // The address of the value of type `t` held by the member at `p`: `p`
    // itself, or for a recursive enum (a boxed member) the box's, borrowed.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TBool, 86)[86]
    fun unbox(var self, cg: CodeGen, t: Type, p: int32) -> int32 {
        if !cg.is_boxed(t) { return p }
        let q = self.temp(Type.TPtr)
        self.add_load(q, p, 0)
        return q
    }

    // A new box holding a copy of `value`, a recursive enum's, with references
    // of its own: the pointer a member of type `t` holds.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), Type.TEnum("List", []))[3]
    fun box(var self, cg: CodeGen, value: Expr, t: Type) -> int32 {
        let src = self.addr(cg, value)
        let took = self.took(cg, t, src)
        let size = self.int_const(cg.size(t))
        let p = self.temp(Type.TPtr)
        self.add(Inst.Rt(p, "__alloc", [size]))
        self.add(Inst.Copy(p, src, cg.size(t)))
        if !took { self.retain(cg, t, p) }
        return p
    }

    // An enum value built in a new slot: the variant's tag, then its payload.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TEnum("Color", []), "Color", "Red", [], -1)[0]
    fun enum_ctor(var self, cg: CodeGen, t: Type, enum_name: str, variant: str, args: [Expr], into: int32) -> int32 {
        let slot = self.build_slot(cg, "__enum", t, into)
        let base = self.slot_addr(slot)
        let tag = self.konst(Type.TInt(64, true), cg.variant_tag(enum_name, variant) as int64)
        self.add_store(base, 0, tag)
        var i = 0
        for a in args {
            self.store_member(cg, a, base, cg.variant_field_offset(t, variant, i))
            i = i + 1
        }
        // the slot holds a value even when the variant's payload owns nothing
        self.built(slot, into, base)
        return base
    }

    // Whether `v` is the address of a value built in its destination.
    #test(lower_on(), 24)[false]
    fun is_placed(self, v: int32) -> bool {
        return v >= 0 && v < self.placed.len() && self.placed[v]
    }

    // The slot an aggregate value is built in: `into`, the destination its
    // statement offers (a new variable's slot, or the function's result), or
    // a temporary of its own (MYLA-108: no copy from one to the other).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "a", Type.TBool, 86)[86]
    fun build_slot(var self, cg: CodeGen, name: str, t: Type, into: int32) -> int32 {
        if into >= 0 { return into }
        return self.value_slot(cg, name, t, true)
    }

    // The aggregate at `base`, in `slot`, is complete: a temporary of its own
    // is the statement's; built in `into`, its address says so (`placed`).
    fun built(var self, slot: int32, into: int32, base: int32) {
        self.mark_built(slot)
        if slot != into { self.own_temp(slot) } else { self.placed[base] = true }
    }

    // Store `value` as the member at `base + off`, with its own references.
    fun store_member(var self, cg: CodeGen, value: Expr, base: int32, off: int32) {
        let mt = cg.type_of(value.id)
        if cg.is_boxed(mt) {
            self.add_store(base, off, self.box(cg, value, mt))
        } else if is_aggregate(mt) {
            let src = self.addr(cg, value)
            let took = self.took(cg, mt, src)
            let dst = self.offset(base, off)
            self.add(Inst.Copy(dst, src, cg.size(mt)))
            if !took { self.retain(cg, mt, dst) }
        } else {
            let v = self.expr(cg, value)
            self.add_store(base, off, v)
            self.retain_or_take(cg, mt, v)
        }
    }

    // An aggregate slot whose members were stored one by one now holds its
    // value (for the verifier).
    fun mark_built(var self, slot: int32) {
        if self.f.slots[slot].owns { self.add(Inst.Init(slot)) }
    }

    // --- calls ------------------------------------------------------------------

    // A call: `print`, `len` of a string, a user function, or a method; the
    // temporary holding its scalar result or its aggregate result's address,
    // -1 without a result. A result that owns heap values is the statement's.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), expr_of("(a, 'c')"), [], 1)[0]
    fun call(var self, cg: CodeGen, e: Expr, callee: Expr, args: [Expr], into: int32) -> int32 {
        if self.err != "" { return -1 }
        // the calls in the arguments of one that `become` makes aren't its
        let tail = self.tail
        self.tail = false
        if args_have_hole(args) { return self.partial(cg, e, callee, args) }
        match callee.kind {
            ExprKind.Name(nm) => {
                // a local binding shadows a function or builtin of the same
                // name: the checker typed the callee as a value (MYLA-102,
                // MYLA-152)
                if cg.called_as_value(callee) { return self.indirect_call(cg, e, callee, args, tail) }
                if nm == "print" && args.len() == 1 { return self.print(cg, args[0]) }
                if nm == "len" && args.len() == 1 && is_cell_t(cg.type_of(args[0].id)) {
                    let s = self.expr(cg, args[0])
                    let d = self.temp(Type.TInt(32, true))
                    self.add_load(d, s, 0)
                    return d
                }
                if nm == "push" && args.len() == 2 && is_list_t(self.place_type(cg, args[0])) { return self.push_elem(cg, args[0], args[1]) }
                if nm == "pop" && args.len() == 1 && is_list_t(self.place_type(cg, args[0])) { return self.pop_elem(cg, e, args[0]) }
                if nm == "contains" && args.len() == 2 { return self.map_contains(cg, args[0], args[1]) }
                if nm == "remove" && args.len() == 2 { return self.map_remove(cg, args[0], args[1]) }
                if nm == "keys" && args.len() == 1 {
                    let m = self.expr(cg, args[0])
                    return self.owned_value(cg, self.map_keys(cg, cg.type_of(args[0].id), m), cg.type_of(e.id))
                }
                if nm == "chars" && args.len() == 1 {
                    let s = self.expr(cg, args[0])
                    let d = self.temp(cg.type_of(e.id))
                    self.rt_call(cg, d, "__str_chars", [s])
                    return self.owned_value(cg, d, cg.type_of(e.id))
                }
                if nm == "format" && args.len() >= 1 { return self.format_call(cg, args) }
                if nm == "StringBuilder" && args.len() == 0 { return self.sb_new(cg) }
                if nm == "StringBuilder" && args.len() == 1 { return self.sb_with_capacity(cg, args[0]) }
                if (nm == "append" && (args.len() == 2 || args.len() == 4)) || ((nm == "append_byte" || nm == "append_char") && args.len() == 2) { return self.sb_append(cg, e, nm, args) }
                if nm == "assert" || nm == "panic" || nm == "unreachable" { return self.intrinsic(cg, e, nm, args) }
                if nm == "build" && args.len() == 1 {
                    let c = self.expr(cg, args[0])
                    let d = self.temp(Type.TStr)
                    self.add(Inst.SbBuild(d, c))
                    return self.owned_value(cg, d, Type.TStr)
                }
                if is_wrapping_method(nm) { return self.wrapping(cg, e, nm, args) }
                if is_builtin_call_name(nm) { return self.io_call(cg, e, nm, args) }
                // `__cancel_after(a, ms)` (D124): the child's first frame on
                // the timers as a deadline
                if nm == "__cancel_after" && args.len() == 2 {
                    match args[0].kind {
                        ExprKind.Name(an) => {
                            let ts = self.lookup(an)
                            if ts >= 0 && self.task_of(ts) >= 0 {
                                let fr = self.temp(Type.TPtr)
                                self.add(Inst.Load(fr, ts))
                                let ms = self.expr(cg, args[1])
                                let m = self.temp(Type.TInt(64, true))
                                self.add(Inst.Cast(m, Type.TInt(32, true), Type.TInt(64, true), ms))
                                let d = self.temp(Type.TInt(64, true))
                                self.add(Inst.Rt(d, "__cancel_after", [fr, m]))
                                return d
                            }
                        },
                        _ => {},
                    }
                }
                // `task.cancel(a)` (D96): the child's first frame flagged
                if nm == "std$task$cancel" && args.len() == 1 {
                    match args[0].kind {
                        ExprKind.Name(an) => {
                            let ts = self.lookup(an)
                            if ts >= 0 && self.task_of(ts) >= 0 {
                                let fr = self.temp(Type.TPtr)
                                self.add(Inst.Load(fr, ts))
                                self.add(Inst.Rt(-1, "__task_cancel", [fr]))
                                return -1
                            }
                        },
                        _ => {},
                    }
                }
                if self.lookup(nm) >= 0 || cg.called_as_value(callee) || !cg.has_func(nm) { return self.indirect_call(cg, e, callee, args, tail) }
                return self.direct_call(cg, e, nm, args, into, tail)
            },
            ExprKind.GetField(recv, field) => {
                // `T.zero()`, `int.zero()`: the function of the type this
                // instance calls it on (D172)
                match cg.static_calls.get(e.id) {
                    Some(st) => {
                        let fname = format("{}.{}", cg.type_key(subst_type(st, cg.subst)), field)
                        if !cg.has_func(fname) { return self.unsupported("a call of a type's function it has no impl of") }
                        return self.direct_call(cg, e, fname, args, into, tail)
                    },
                    None => {},
                }
                let key = cg.type_key(cg.type_of(recv.id))
                let mname = format("{}.{}", key, field)
                // a builtin function called as a method of its first argument
                // (`xs.push(v)` is `push(xs, v)`, D103, MYLA-221)
                if !cg.has_func(mname) && builtin_method(cg.type_of(recv.id), field) {
                    var all: [Expr] = [recv]
                    for a in args { all.push(a) }
                    return self.call(cg, e, Expr { id: callee.id, line: callee.line, col: callee.col, sp: callee.sp, kind: ExprKind.Name(field) }, all, into)
                }
                if !cg.has_func(mname) {
                    if field == "eq" && args.len() == 1 && cg.derived_eq_routine(key) { return self.derived_eq(cg, mname, recv, args[0], tail) }
                    // a tuple's `hash` is the language's (D163)
                    let rt = cg.type_of(recv.id)
                    if field == "hash" && args.len() == 1 && (is_unit(rt) || is_compound_eq_t(rt)) && !is_list_t(rt) && !tail {
                        return self.tuple_hash(cg, rt, recv, args[0], into)
                    }
                    return self.indirect_call(cg, e, callee, args, tail)
                }
                var argv: [Expr] = [recv]
                for a in args { argv.push(a) }
                return self.direct_call(cg, e, mname, argv, into, tail)
            },
            _ => {},
        }
        return self.indirect_call(cg, e, callee, args, tail)
    }

    // `a.eq(b)` of a `#derive(Eq)` type: the code generator's routine, with
    // both operands' addresses (MYLA-132). It calls nothing that comes back,
    // so `become` makes it an ordinary call and returns its result.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "a", expr_of("(a, 'c')"), expr_of("(a, 'c')"), true)[2]
    fun derived_eq(var self, cg: CodeGen, name: str, a: Expr, b: Expr, tail: bool) -> int32 {
        let pa = self.addr(cg, a)
        let pb = self.addr(cg, b)
        let res = self.temp(Type.TBool)
        self.add(Inst.Call(res, name, [pa, pb]))
        if tail {
            self.drop_temps(0)
            self.drop_owners(0)
            self.exit_fn(res, false)
            self.tailed = true
        }
        return res
    }

    // A call through the function value `callee` (evaluated first): its
    // code called with its environment as the first word after the result's
    // address, the arguments as for `direct_call`; with `tail`, by `become`.
    fun indirect_call(var self, cg: CodeGen, e: Expr, callee: Expr, args: [Expr], tail: bool) -> int32 {
        let ft = self.place_type(cg, callee)
        if !is_tfunc(ft) || !lowerable(cg, ft) { return self.unsupported("a call through a value of that type") }
        let params = tfunc_params(ft)
        let fv = self.addr(cg, callee)
        var vals: [int32] = []
        var i = 0
        while i < args.len() && i < params.len() {
            // a later argument may write the variable this one is read from:
            // a copy taken now (MYLA-237)
            if later_writes(args, i) && (is_aggregate(params[i]) || cg.owns_heap(params[i])) { vals.push(self.stage(cg, params[i], args[i]).1) }
            else if is_aggregate(params[i]) { vals.push(self.addr(cg, args[i])) } else { vals.push(self.expr(cg, args[i])) }
            i = i + 1
        }
        if tail {
            // the result into the caller's storage, as this function's goes
            if self.sret >= 0 { self.tail_call(Inst.CallIndSret(fv, self.slot_addr(self.sret), vals)) }
            else { self.tail_call(Inst.CallInd(-1, fv, vals)) }
            return -1
        }
        match tfunc_ret(ft) {
            Some(rt) => {
                if is_aggregate(rt) {
                    let slot = self.value_slot(cg, "__result", rt, true)
                    let res = self.slot_addr(slot)
                    self.add(Inst.CallIndSret(fv, res, vals))
                    self.own_temp(slot)
                    return res
                }
                let d = self.temp(rt)
                self.add(Inst.CallInd(d, fv, vals))
                return self.owned_value(cg, d, rt)
            },
            None => {},
        }
        self.add(Inst.CallInd(-1, fv, vals))
        return -1
    }

    // --- function values -------------------------------------------------------

    // A slot for the function value of type `t` made here: (its address, its
    // environment cell of `size` bytes, whose first word is the release
    // function `drop`; -1 for none: a null environment), its code `code`.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true))), "myla_inc__fnval", -1, "")[(0, 0, -1)]
    fun fat_value(var self, cg: CodeGen, t: Type, code: str, size: int32, drop: str) -> (int32, int32, int32) {
        let slot = self.value_slot(cg, "__fn", t, true)
        let base = self.slot_addr(slot)
        let c = self.temp(Type.TPtr)
        self.add(Inst.Label(c, code))
        self.add_store(base, 0, c)
        if size < 0 {
            self.add_store(base, 8, self.int_const(0))
            return (slot, base, -1)
        }
        let env = self.temp(Type.TPtr)
        self.add(Inst.Rt(env, "__alloc", [self.int_const(size)]))
        // its first word: the record of its routines (MYLA-263)
        let d = self.temp(Type.TPtr)
        self.add(Inst.Label(d, env_record_of(drop)))
        self.add_store(env, 0, d)
        self.add_store(base, 8, env)
        return (slot, base, env)
    }

    // The function value's slot is complete: the statement owns it.
    fun made_value(var self, slot: int32) {
        self.mark_built(slot)
        self.own_temp(slot)
    }

    // A copy of `value` of type `t` stored into the environment `env` at
    // `off`, with references of its own.
    fun store_env(var self, cg: CodeGen, env: int32, off: int32, value: Expr, t: Type) {
        if is_aggregate(t) {
            let src = self.addr(cg, value)
            let took = self.took(cg, t, src)
            let dst = self.offset(env, off)
            self.add(Inst.Copy(dst, src, cg.size(t)))
            if !took { self.retain(cg, t, dst) }
        } else {
            let v = self.expr(cg, value)
            self.add_store(env, off, v)
            self.retain_or_take(cg, t, v)
        }
    }

    // A top-level function `n` as a value: its thunk (taking an environment
    // word it ignores) and a null environment.
    #test(lower_on(), codegen_on("fun main() { print(1 + 2) }"), expr_of("Some(n)"), "inc")[0]
    fun fn_value(var self, cg: CodeGen, e: Expr, n: str) -> int32 {
        if cg.sig_of(n).type_params.len() > 0 { return self.unsupported("a generic function as a value") }
        if !has_name(self.fnvals, n) { self.fnvals.push(n) }
        let made = self.fat_value(cg, cg.type_of(e.id), format("myla_{}__fnval", n), -1, "")
        self.made_value(made.0)
        return made.1
    }

    // A lambda: its body lifted into a function of its own (`lower_lambda`),
    // its captures copied into a new environment by value (D48).
    fun lambda_value(var self, cg: CodeGen, e: Expr, params: [Param], body: ExprOrBlock) -> int32 {
        let t = cg.type_of(e.id)
        if !lowerable(cg, t) { return self.unsupported("a lambda of that type") }
        let lifted = format("{}__lam{}", self.f.name, e.id)
        var bound: [str] = []
        for p in params { bound.push(p.name) }
        var caps: [Cap] = []
        var seen: [str] = []
        var size = 8                // word 0 of the env: its routines' record (MYLA-263)
        var owns = false
        for nm in cg.free_eb(body, bound) {
            let slot = self.lookup(nm)
            if slot >= 0 && !has_name(seen, nm) {
                seen.push(nm)
                let ct = self.var_type(slot)
                if !lowerable(cg, ct) { return self.unsupported("a capture of that type") }
                // a sibling child task, which this child may await (MYLA-148)
                let ti = self.task_of(slot)
                var tty = Type.TBool
                var tvoid = true
                if ti >= 0 {
                    tty = self.tasks[ti].ty
                    tvoid = self.tasks[ti].void
                }
                caps.push(Cap { name: nm, ty: ct, off: size, task: ti >= 0, task_ty: tty, task_void: tvoid })
                size = size + cg.size(ct)
                if cg.owns_heap(ct) { owns = true }
            }
        }
        self.lams.push(LamJob { lifted: lifted, params: params, ftype: t, body: body, caps: caps, subst: cg.subst, id: e.id, line: e.line, col: e.col })
        if caps.len() == 0 { size = -1 }
        var drop = "__free"
        if owns { drop = format("myla_{}_env_drop", lifted) }
        // an async lambda's code makes its frame (D90)
        var code = "myla_" + lifted
        if cg.frames && is_async_t(t) { code = code + "__new" }
        let made = self.fat_value(cg, t, code, size, drop)
        // a child task's captures: copied deeply, as they cross to its thread
        // (D92)
        let child = cg.frames && cg.norm.children.contains(e.id)
        for c in caps {
            let slot = self.lookup(c.name)
            if is_aggregate(c.ty) {
                let dst = self.offset(made.2, c.off)
                self.add(Inst.Copy(dst, self.slot_addr(slot), cg.size(c.ty)))
                self.retain(cg, c.ty, dst)
            } else {
                let v = self.read_var(slot)
                self.add_store(made.2, c.off, v)
                self.retain(cg, c.ty, v)
            }
            if child && cg.owns_heap(c.ty) && !is_actor_t(c.ty) { self.add(Inst.Deep(c.ty, self.offset(made.2, c.off))) }
        }
        self.made_value(made.0)
        return made.1
    }

    // `l >> r`: an environment holding both function values (retained), and
    // the runtime's `__compose_call`.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), expr_of("(a, 'c')"), expr_of("(a, 'c')"))[0]
    fun compose(var self, cg: CodeGen, e: Expr, l: Expr, r: Expr) -> int32 {
        let made = self.fat_value(cg, cg.type_of(e.id), "__compose_call", 40, "__compose_env_drop")
        self.store_env(cg, made.2, 8, l, cg.type_of(l.id))
        self.store_env(cg, made.2, 24, r, cg.type_of(r.id))
        self.made_value(made.0)
        return made.1
    }

    // `f(a, _, …)`: the filled arguments (and a method's receiver, or the
    // function value called) evaluated now into a new environment, and a
    // thunk filling the holes from its own parameters (D51, D60).
    fun partial(var self, cg: CodeGen, e: Expr, callee: Expr, given: [Expr]) -> int32 {
        var target = ""
        var args = given
        var fn_value = false
        match callee.kind {
            ExprKind.Name(n) => {
                if self.lookup(n) >= 0 { fn_value = true } else { target = n }
            },
            ExprKind.GetField(recv, field) => {
                let mname = format("{}.{}", cg.type_key(cg.type_of(recv.id)), field)
                if cg.has_func(mname) {
                    target = mname
                    args = [recv]
                    for a in given { args.push(a) }
                } else {
                    fn_value = true
                }
            },
            _ => { fn_value = true },
        }
        var params: [Type] = []
        var ret: Option<Type> = None
        let ft = self.place_type(cg, callee)
        if fn_value {
            params = tfunc_params(ft)
            ret = tfunc_ret(ft)
        } else {
            let sig = cg.sig_of(target)
            if sig.type_params.len() > 0 { return self.unsupported("a partial application of a generic function") }
            params = sig.params
            ret = sig.ret
        }
        let t = cg.type_of(e.id)
        if !lowerable(cg, t) { return self.unsupported("a partial application of that type") }
        var slots: [int32] = []
        var aggs: [bool] = []
        var fills: [Expr] = []
        var offs: [int32] = []
        var owned: [DropEntry] = []
        var size = 8               // word 0 of the env: its routines' record (MYLA-263)
        var fn_off = -1
        if fn_value {
            fn_off = size
            owned.push(DropEntry { off: size, ty: ft })
            size = size + 16
        }
        var i = 0
        while i < args.len() {
            let a = args[i]
            aggs.push(is_aggregate(params[i]))
            if is_hole_expr(a) {
                slots.push(-1)
            } else {
                slots.push(size)
                fills.push(a)
                offs.push(size)
                let at = cg.type_of(a.id)
                if !lowerable(cg, at) { return self.unsupported("a partial application with an argument of that type") }
                if cg.owns_heap(at) { owned.push(DropEntry { off: size, ty: at }) }
                size = size + cg.size(at)
            }
            i = i + 1
        }
        let lifted = format("{}__partial{}", self.f.name, e.id)
        var drop = "__free"
        if owned.len() > 0 { drop = format("myla_{}_env_drop", lifted) }
        let made = self.fat_value(cg, t, "myla_" + lifted, size, drop)
        if fn_value {
            let src = self.addr(cg, callee)
            let dst = self.offset(made.2, fn_off)
            self.add(Inst.Copy(dst, src, 16))
            self.retain(cg, ft, dst)
        }
        var k = 0
        while k < fills.len() {
            self.store_env(cg, made.2, offs[k], fills[k], cg.type_of(fills[k].id))
            k = k + 1
        }
        self.partials.push(PartialJob { lifted: lifted, target: target, fn_off: fn_off, slots: slots, aggs: aggs, sret: is_aggregate_opt(ret), owned: owned })
        self.made_value(made.0)
        return made.1
    }

    // A call of the user function `name` with the argument list `argv`
    // (for a method the receiver first): scalars by value, aggregates by
    // address, both borrowed; an aggregate result through storage of its own.
    // With `tail`, by `become`: the parameters it passes heap values to are
    // owned (`find_kept_params`).
    // The function a call of `name` with `argv` calls: a generic one's
    // instance for the call's explicit type arguments (D169), the types of
    // the arguments and of the call (which fixes what the arguments leave
    // open, MYLA-315), which the code
    // generator stamps out once this function is lowered, with its parameter
    // and result types.
    fun call_target(var self, cg: CodeGen, sig: FuncSig, argv: [Expr], call: Expr) -> CallTarget {
        if sig.type_params.len() == 0 { return CallTarget { name: sig.name, params: sig.params, ret: sig.ret } }
        let targs = cg.solve_targs(sig, argv, call.id, call_targs(call))
        self.f.instances.push(Instance { orig: sig.name, targs: targs })
        var sub: [Subst] = []
        var k = 0
        while k < sig.type_params.len() {
            sub.push(Subst { name: sig.type_params[k], ty: targs[k] })
            k = k + 1
        }
        var cp: [Type] = []
        for p in sig.params { cp.push(subst_type(p, sub)) }
        return CallTarget { name: mangle_fn(sig.name, targs), params: cp, ret: opt_subst_type(sig.ret, sub) }
    }

    #test(lower_on(), codegen_on("fun main() { print(1 + 2) }"), expr_of("Some(n)"), "list_sum", [], -1, false)[-1]
    fun direct_call(var self, cg: CodeGen, e: Expr, name: str, argv0: [Expr], into: int32, tail: bool) -> int32 {
        let sig = cg.sig_of(name)
        let ct = self.call_target(cg, sig, argv0, e)
        let target = ct.name
        let params = ct.params
        let ret = ct.ret
        for p in params {
            if !lowerable(cg, p) { return self.unsupported("a call with an argument of that type") }
        }
        var ret_t = Type.TBool
        var has_ret = false
        match ret {
            Some(rt) => {
                if !lowerable(cg, rt) { return self.unsupported("a call whose result has that type") }
                ret_t = rt
                has_ret = true
            },
            None => {},
        }
        // a method writing its receiver gets a copy of an argument read from
        // the same variable (passed by address or owning heap memory), taken
        // before the call (MYLA-123, MYLA-129): its writes would change or
        // release the argument's place otherwise
        var root = ""
        if sig.has_decl && match sig.decl.receiver { Some(r) => r == "var self", None => false } { root = place_root(argv0[0]) }
        // an argument that may change or copy the receiver's variable: the
        // indices of the receiver's place and every argument computed first,
        // in order, so that the place is reached after them (H4)
        var argv = argv0
        if root != "" && !tail && argv0.len() > 1 && !settled_operands(argv0[1:], root) {
            argv = [self.fixed_receiver(cg, argv0[0], e.id)]
            var j = 1
            while j < argv0.len() {
                argv.push(self.held_operand(cg, argv0[j], format("%arg{}_{}", e.id, j)))
                j = j + 1
            }
        }
        var vals: [int32] = []
        let owns = cg.owned_params(sig, params)
        let any_byval = cg.has_byval(sig)
        // a narrow list element passed as a built-in value's `var self`: the
        // cell holding it for the call, and the element's address it goes
        // back to after it
        var back: (int32, int32) = (-1, -1)
        var i = 0
        while i < argv.len() && i < params.len() {
            // an owned parameter gets a reference of its own: an owned
            // temporary's, or one retained for it (MYLA-127)
            let owned = i < owns.len() && owns[i]
            let byval = any_byval && cg.byval_param(sig, i, params[i])
            // nothing keeps a borrowed value alive once `become` has gone
            // (unless it is a parameter, or a part of one, that the caller
            // holds: it outlives the jump, MYLA-253)
            if tail && !owned && !byval && !(i == 0 && root != "") && (is_aggregate(params[i]) || cg.owns_heap(params[i])) && !self.caller_holds(argv[i]) { return self.unsupported("a 'become' passing a value to a borrowed parameter") }
            // a copy of its own, which the method's writes can't reach either
            if byval { for w in self.value_words(cg, params[i], self.addr(cg, argv[i])) { vals.push(w) } }
            // a built-in value's `var self`: its place's address (D144)
            else if i == 0 && recv_by_address(sig, 0, params[0]) {
                if root == "" || self.lookup(root) < 0 { return self.unsupported("a 'var self' method on that receiver") }
                // after a `become` only the receiver this function was given
                // outlives it
                if tail && self.lookup(root) != self.by_addr { return self.unsupported("a 'become' passing a place of this function as 'var self'") }
                let at = self.place(cg, argv[0])
                if self.width_at(at, 0) < 8 {
                    if tail { return self.unsupported("a 'become' with a list element narrower than a word as 'var self'") }
                    let cell = self.new_slot("__receiver", params[0], 8, -1, false)
                    let v = self.temp(params[0])
                    self.add_load(v, at, 0)
                    self.add(Inst.Store(cell, v))
                    back = (cell, at)
                    vals.push(self.slot_addr(cell))
                } else { vals.push(at) }
            }
            else if i > 0 && root != "" && place_root(argv[i]) == root && (is_aggregate(params[i]) || cg.owns_heap(params[i])) {
                let staged = self.stage(cg, params[i], argv[i])
                if owned { self.moved(staged.0) }
                vals.push(staged.1)
            }
            // a later argument may write the variable this one is read from:
            // a copy taken now, so the call gets the value it had (MYLA-237)
            else if !(i == 0 && root != "") && later_writes(argv, i) && (is_aggregate(params[i]) || cg.owns_heap(params[i])) {
                let staged = self.stage(cg, params[i], argv[i])
                if owned { self.moved(staged.0) }
                vals.push(staged.1)
            }
            // a method writing its receiver writes the place it names, each
            // list on the way made unshared first (MYLA-143): a copy of the
            // list must not see the write
            else if i == 0 && root != "" && is_aggregate(params[0]) && self.lookup(root) >= 0 { vals.push(self.place(cg, argv[0])) }
            else if is_aggregate(params[i]) { vals.push(self.addr(cg, argv[i])) }
            else {
                let v = self.expr(cg, argv[i])
                if owned { self.retain_or_take(cg, params[i], v) }
                vals.push(v)
            }
            i = i + 1
        }
        if tail {
            // the checker counts a value of a type parameter as one word; an
            // instance passing more on the stack than it received is refused
            // here, as the checker refuses the rest (D131, MYLA-272)
            var passed = vals.len() as int32
            if has_ret && is_aggregate(ret_t) { passed = passed + 1 }
            if self.received >= 0 && passed > REG_ARG_WORDS && passed > self.received {
                self.refuse_become(cg, e, passed)
                return -1
            }
            if has_ret && is_aggregate(ret_t) { self.tail_call(Inst.CallSret(target, self.slot_addr(self.sret), vals)) }
            else { self.tail_call(Inst.Call(-1, target, vals)) }
            return -1
        }
        if !has_ret {
            self.add(Inst.Call(-1, target, vals))
            self.write_back(back)
            return -1
        }
        if is_aggregate(ret_t) {
            if into >= 0 {
                // straight into the statement's destination
                let dst = self.slot_addr(into)
                self.add(Inst.CallSret(target, dst, vals))
                self.write_back(back)
                self.placed[dst] = true
                return dst
            }
            let slot = self.value_slot(cg, "__result", ret_t, true)
            let res = self.slot_addr(slot)
            self.add(Inst.CallSret(target, res, vals))
            self.write_back(back)
            self.own_temp(slot)
            return res
        }
        let d = self.temp(ret_t)
        self.add(Inst.Call(d, target, vals))
        self.write_back(back)
        return self.owned_value(cg, d, ret_t)
    }

    // --- lists ------------------------------------------------------------------

    // `[a, b, …]`: a new cell holding the elements, each with its own
    // references; the statement owns it from the start, its length counting
    // the elements stored so far, so a `?` failing in an element releases
    // the cell and those (MYLA-157).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TList(Type.TInt(32, true)), [])[1]
    fun list_lit(var self, cg: CodeGen, lt: Type, elems: [Expr]) -> int32 {
        if !lowerable(cg, lt) { return self.unsupported("a list of that element type") }
        let et = list_elem(lt)
        let stride = cg.elem_size(et)
        let n = elems.len()
        let size = self.konst(Type.TInt(64, true), (16 + n * stride) as int64)
        let cell = self.temp(lt)
        self.add(Inst.Rt(cell, "__alloc", [size]))
        let count = self.konst(Type.TInt(64, true), n as int64)
        let owned = cg.owns_heap(et)
        if owned { self.add_store(cell, 0, self.konst(Type.TInt(64, true), 0)) } else { self.add_store(cell, 0, count) }
        self.add_store(cell, 8, count)
        let v = self.owned_value(cg, cell, lt)
        var i = 0
        for el in elems {
            // an element narrower than a word: a scalar, stored at its size
            // an element without size (the unit type, an empty struct): runs, stores nothing
            if stride == 0 { self.discard(cg, el) }
            else if stride < 8 { self.add(Inst.StoreAt(cell, 16 + i * stride, self.expr(cg, el), stride)) }
            else { self.store_member(cg, el, cell, 16 + i * stride) }
            i = i + 1
            if owned { self.add_store(cell, 0, self.konst(Type.TInt(64, true), i as int64)) }
        }
        return v
    }

    // An index into the list or string cell `cell`: `^n` counted from its
    // end (D142), its length less `n`, which the bounds check then holds to
    // the list as any index.
    fun index_of(var self, cg: CodeGen, cell: int32, idx: Expr) -> int32 {
        match from_end_of(idx) {
            Some(n) => {
                let i64 = Type.TInt(64, true)
                let len = self.temp(i64)
                self.add(Inst.LoadAt(len, cell, 0, 8))
                let nv = self.expr(cg, n)
                let n64 = self.temp(i64)
                self.add(Inst.Cast(n64, cg.type_of(n.id), i64, nv))
                let d = self.temp(i64)
                self.add(Inst.Bin(d, "-", i64, i64, len, n64, Pos { line: idx.line, col: idx.col }))
                return d
            },
            None => {},
        }
        return self.expr(cg, idx)
    }

    // A slice of the list or string `base` (D142, D143): std.slice's
    // `take` or `take_str`, the step checked not to be 0 and a string's
    // slice to take whole characters, where the slice stands.
    fun slice_expr(var self, cg: CodeGen, e: Expr, base: Expr, idx: Expr) -> int32 {
        let bt = cg.type_of(base.id)
        let i64 = Type.TInt(64, true)
        let p = slice_parts(idx)
        let cell = self.expr(cg, base)
        var vals: [int32] = [cell]
        for b in [p.start, p.stop] {
            if is_hole_part(b) {
                vals.push(self.konst(i64, 0))
                vals.push(self.konst(Type.TBool, 0))
                vals.push(self.konst(Type.TBool, 0))
            } else {
                var v = b
                var from_end = false
                match from_end_of(b) {
                    Some(n) => {
                        v = n
                        from_end = true
                    },
                    None => {},
                }
                let x = self.expr(cg, v)
                let x64 = self.temp(i64)
                self.add(Inst.Cast(x64, cg.type_of(v.id), i64, x))
                // a plain negative bound is an error, as a negative index is
                // (D154); one counted from the end clamps
                if !from_end {
                    let ok = self.temp(Type.TBool)
                    self.add(Inst.Cmp(ok, ">=", i64, x64, self.konst(i64, 0)))
                    self.add(Inst.Check(ok, "index", Pos { line: e.line, col: e.col }))
                }
                vals.push(x64)
                vals.push(self.konst(Type.TBool, 1))
                vals.push(self.konst(Type.TBool, if from_end { 1 } else { 0 }))
            }
        }
        var step = self.konst(i64, 1)
        if !is_hole_part(p.step) {
            let sv = self.expr(cg, p.step)
            step = self.temp(i64)
            self.add(Inst.Cast(step, cg.type_of(p.step.id), i64, sv))
            let nz = self.temp(Type.TBool)
            self.add(Inst.Cmp(nz, "!=", i64, step, self.konst(i64, 0)))
            self.add(Inst.Check(nz, "step", Pos { line: e.line, col: e.col }))
        }
        vals.push(step)
        if is_tstr(bt) {
            if !cg.has_func("std$slice$str_whole") { return self.unsupported("a slice without std.slice") }
            let ok = self.temp(Type.TBool)
            self.add(Inst.Call(ok, "std$slice$str_whole", vals))
            self.add(Inst.Check(ok, "boundary", Pos { line: e.line, col: e.col }))
            return self.call_owning(cg, "std$slice$take_str", vals)
        }
        if !cg.has_func("std$slice$take") { return self.unsupported("a slice without std.slice") }
        let et = list_elem(bt)
        let name = mangle_fn("std$slice$take", [et])
        self.f.instances.push(Instance { orig: "std$slice$take", targs: [et] })
        let d = self.temp(bt)
        self.add(Inst.Call(d, name, vals))
        return self.owned_value(cg, d, bt)
    }

    // The address of element `idx` of the list or string `base` (bounds
    // checked at `e`), borrowed from it.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), expr_of("(a, 'c')"), expr_of("(a, 'c')"))[0]
    fun elem_read(var self, cg: CodeGen, e: Expr, base: Expr, idx: Expr) -> int32 {
        let bt = self.place_type(cg, base)
        if !is_list_t(bt) && !is_tstr(bt) && !is_map_t(bt) { return self.unsupported("indexing that type") }
        let cell = self.expr(cg, base)
        if is_map_t(bt) { return self.map_value(cg, e, bt, cell, self.key_operand(cg, bt, idx)) }
        let i = self.index_of(cg, cell, idx)
        var stride = 1
        if is_list_t(bt) { stride = cg.elem_size(list_elem(bt)) }
        let d = self.temp(Type.TPtr)
        self.add(Inst.Elem(d, cell, i, stride, is_tstr(bt), !self.in_bounds(base, idx), Pos { line: e.line, col: e.col }))
        if is_list_t(bt) { self.mark_elem(d, stride) }
        return d
    }

    // `push(holder, value)`: the value taken first (with its references), then
    // the list made unique, grown when full, and the value moved in.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), expr_of("(a, 'c')"))[-1]
    fun push_elem(var self, cg: CodeGen, holder: Expr, value: Expr) -> int32 {
        let lt = self.place_type(cg, holder)
        if !lowerable(cg, lt) { return self.unsupported("a list of that element type") }
        let et = list_elem(lt)
        let stride = cg.elem_size(et)
        let staged = self.stage(cg, et, value)
        let h = self.place(cg, holder)
        let cell = self.temp(lt)
        self.add(Inst.Cow(cell, lt, h))
        let slot_p = self.temp(Type.TPtr)
        self.add(Inst.Append(slot_p, h, cell, stride))
        self.mark_elem(slot_p, stride)
        self.store_staged(cg, et, slot_p, staged)
        return -1
    }

    // `pop(holder)`: the last element moved out of the (unique) list, with its
    // references; the statement owns it.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), expr_of("(a, 'c')"))[3]
    fun pop_elem(var self, cg: CodeGen, e: Expr, holder: Expr) -> int32 {
        let lt = self.place_type(cg, holder)
        if !lowerable(cg, lt) { return self.unsupported("a list of that element type") }
        let et = list_elem(lt)
        let h = self.place(cg, holder)
        let cell = self.temp(lt)
        self.add(Inst.Cow(cell, lt, h))
        let p = self.temp(Type.TPtr)
        let size = cg.elem_size(et)
        self.add(Inst.Pop(p, cell, size, Pos { line: e.line, col: e.col }))
        self.mark_elem(p, size)
        if cg.is_boxed(et) {
            // the list held a box: the value copied out with references of
            // its own, then the box released (MYLA-74)
            let slot = self.value_slot(cg, "__popped", et, true)
            let dst = self.slot_addr(slot)
            self.add(Inst.Copy(dst, self.unbox(cg, et, p), cg.size(et)))
            self.retain(cg, et, dst)
            self.add(Inst.DropAt(et, p))
            self.own_temp(slot)
            return dst
        }
        if is_aggregate(et) {
            let slot = self.value_slot(cg, "__popped", et, true)
            let dst = self.slot_addr(slot)
            self.add(Inst.Copy(dst, p, cg.size(et)))
            self.own_temp(slot)
            return dst
        }
        let d = self.temp(et)
        self.add_load(d, p, 0)
        return self.owned_value(cg, d, et)
    }

    // --- maps -------------------------------------------------------------------

    #test(lower_on(), 0)[0]
    fun int_const(var self, v: int32) -> int32 {
        return self.konst(Type.TInt(64, true), v as int64)
    }

    // The slot of `key` in the map `cell` of type `mt`, or 0 when it is missing.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TMap(Type.TStr, Type.TInt(32, true)), 32, 33)[1]
    fun map_lookup(var self, cg: CodeGen, mt: Type, cell: int32, key: int32) -> int32 {
        let size = self.int_const(cg.map_slot_size(mt))
        let d = self.temp(Type.TPtr)
        if cg.map_hashed(mt) {
            // a compound key, at its address (`key_operand`): its routines
            let kt = map_key(mt)
            let h = self.temp(Type.TInt(64, true))
            self.add(Inst.Call(h, self.want_key(9, kt), [key]))
            self.add(Inst.Call(d, self.want_key(11, kt), [cell, key, h, size]))
            return d
        }
        let is_str = self.int_const(cg.map_is_str(mt))
        self.rt_call(cg, d, "__map_lookup", [cell, key, size, is_str])
        return d
    }

    // The name of the routine of kind `kind` (`type_job_name`) for the map
    // key type `kt`, asked for.
    fun want_key(var self, kind: int32, kt: Type) -> str {
        self.wants.push(Want { kind: kind, t: kt, clone: false })
        return type_job_name(Want { kind: kind, t: kt, clone: false })
    }

    // The key `k` of the map type `mt` evaluated as the map operations take
    // it: an integer's, `char`'s, `bool`'s or string's value, else its
    // address (a list's cell in a word of its own); borrowed, its
    // temporaries the statement's.
    fun key_operand(var self, cg: CodeGen, mt: Type, k: Expr) -> int32 {
        if !cg.map_hashed(mt) { return self.expr(cg, k) }
        let kt = map_key(mt)
        if cg.is_boxed(kt) { return self.unsupported("a map keyed by a recursive enum") }
        if is_aggregate(kt) { return self.addr(cg, k) }
        let v = self.expr(cg, k)
        let slot = self.new_slot("__key", kt, 8, -1, false)
        self.add(Inst.Store(slot, v))
        return self.slot_addr(slot)
    }

    // The address of the value of `key` in the map `cell`, borrowed from it;
    // trapping at `e` when the key is missing.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"), Type.TMap(Type.TStr, Type.TInt(32, true)), 9, 10)[3]
    fun map_value(var self, cg: CodeGen, e: Expr, mt: Type, cell: int32, key: int32) -> int32 {
        let slot = self.map_lookup(cg, mt, cell, key)
        self.add(Inst.Check(slot, "key", Pos { line: e.line, col: e.col }))
        return self.offset(slot, cg.map_val_off(mt))
    }

    // A new list of the keys of the map `cell`, each with its reference; the
    // caller owns it.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TMap(Type.TStr, Type.TInt(32, true)), 115)[3]
    fun map_keys(var self, cg: CodeGen, mt: Type, cell: int32) -> int32 {
        let size = self.int_const(cg.map_slot_size(mt))
        if cg.map_hashed(mt) {
            let d = self.temp(Type.TList(map_key(mt)))
            self.add(Inst.Call(d, self.want_key(13, map_key(mt)), [cell, size]))
            return d
        }
        let stride = self.int_const(cg.elem_size(map_key(mt)))
        let is_str = self.int_const(cg.map_is_str(mt))
        let d = self.temp(Type.TList(map_key(mt)))
        self.rt_call(cg, d, "__map_keys", [cell, size, stride, is_str])
        return d
    }

    // The value `value` of a member's type `vt` taken, with references of its
    // own, before the container or place it goes to is evaluated: (the owning
    // slot holding it until it is moved in, or -1 when it owns nothing; its
    // temporary, or its staged copy's address for an aggregate). A `?` or
    // `return` in between drops it with the statement's temporaries.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TInt(32, true), expr_of("(a, 'c')"))[(-1, 0)]
    fun stage(var self, cg: CodeGen, vt: Type, value: Expr) -> (int32, int32) {
        let owns = cg.owns_heap(vt)
        if is_aggregate(vt) {
            let src = self.addr(cg, value)
            // an owned temporary is staged already: it moves in when stored
            if owns && self.holds(src) { return (self.holder[src], src) }
            let slot = self.value_slot(cg, "__staged", vt, owns)
            let staged = self.slot_addr(slot)
            self.add(Inst.Copy(staged, src, cg.size(vt)))
            self.retain(cg, vt, staged)
            if !owns { return (-1, staged) }
            self.own_temp(slot)
            return (slot, staged)
        }
        let v = self.expr(cg, value)
        if owns && self.holds(v) { return (self.holder[v], v) }
        self.retain(cg, vt, v)
        if !owns { return (-1, v) }
        let slot = self.value_slot(cg, "__staged", vt, true)
        self.add(Inst.Store(slot, v))
        self.own_temp(slot)
        return (slot, v)
    }

    // Set `key` in the (unique) map the 8 bytes at `holder` point at to the
    // staged value (see `stage`), releasing the value it replaces: room made
    // first, then the key's slot found or made (with a reference to a string
    // key).
    fun map_put(var self, cg: CodeGen, mt: Type, holder: int32, key: int32, staged: (int32, int32)) {
        let vt = map_val(mt)
        let size = self.int_const(cg.map_slot_size(mt))
        let slot = self.temp(Type.TPtr)
        let had = self.temp(Type.TBool)
        // std.rt's (MYLA-162): room made and the slot found in one call,
        // whose low bit says whether the key was there; a compound key's
        // through its `__mput_<K>`, which copies it in (MYLA-313)
        let i64 = Type.TInt(64, true)
        let r = self.temp(i64)
        if cg.map_hashed(mt) {
            self.add(Inst.Call(r, self.want_key(12, map_key(mt)), [holder, key, size]))
        } else {
            let is_str = self.int_const(cg.map_is_str(mt))
            self.add(Inst.Call(r, "std$rt$map_put_slot", [holder, key, size, is_str]))
        }
        let pos = Pos { line: 0, col: 0 }
        let masked = self.temp(i64)
        self.add(Inst.Bin(masked, "&", i64, i64, r, self.int_const(-2), pos))
        self.add(Inst.Mov(slot, masked))
        let bit = self.temp(i64)
        self.add(Inst.Bin(bit, "&", i64, i64, r, self.int_const(1), pos))
        self.add(Inst.Cmp(had, "!=", i64, bit, self.int_const(0)))
        let p = self.offset(slot, cg.map_val_off(mt))
        if cg.owns_heap(vt) {
            let drop_b = self.new_block()
            let join = self.new_block()
            self.finish(Term.Br(had, drop_b, join))
            self.start(drop_b)
            self.add(Inst.DropAt(vt, p))
            self.finish(Term.Jmp(join))
            self.start(join)
        }
        self.store_staged(cg, vt, p, staged)
    }

    // Move the value `stage` took into the member at `p`, which takes over its
    // references (a recursive enum's into a new box).
    fun store_staged(var self, cg: CodeGen, vt: Type, p: int32, staged: (int32, int32)) {
        if cg.is_boxed(vt) {
            let size = self.int_const(cg.size(vt))
            let b = self.temp(Type.TPtr)
            self.add(Inst.Rt(b, "__alloc", [size]))
            self.add(Inst.Copy(b, staged.1, cg.size(vt)))
            self.add_store(p, 0, b)
        } else if is_aggregate(vt) {
            self.add(Inst.Copy(p, staged.1, cg.size(vt)))
        } else {
            self.add_store(p, 0, staged.1)
        }
        self.moved(staged.0)
    }

    // The staged value in the owning `slot` (-1: none) was moved into its
    // place: no temporary scope drops it any more.
    fun moved(var self, slot: int32) {
        if slot < 0 { return }
        self.add(Inst.Moved(slot))
        var i = 0
        while i < self.temps.len() {
            var kept: [int32] = []
            for s in self.temps[i] {
                if s != slot { kept.push(s) }
            }
            self.temps[i] = kept
            i = i + 1
        }
    }

    // `[k: v, …]`: a new map, each key evaluated before its value; the
    // statement owns it.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), Type.TMap(Type.TChar, Type.TInt(32, true)), [])[5]
    fun map_lit(var self, cg: CodeGen, mt: Type, entries: [MapEntry]) -> int32 {
        if !lowerable(cg, mt) { return self.unsupported("a map of that type") }
        let eight = self.int_const(8)
        let size = self.int_const(cg.map_slot_size(mt))
        let cell = self.temp(mt)
        self.add(Inst.Rt(cell, "__map_new", [eight, size]))
        let slot = self.value_slot(cg, "__map", mt, true)
        self.add(Inst.Store(slot, cell))
        self.own_temp(slot)
        let h = self.slot_addr(slot)
        for en in entries {
            let k = self.key_operand(cg, mt, en.key)
            let staged = self.stage(cg, map_val(mt), en.value)
            self.map_put(cg, mt, h, k, staged)
        }
        let d = self.temp(mt)
        self.add(Inst.Load(d, slot))
        return d
    }

    // `m[k] = value`: the value taken first, then the map made unique, then
    // the key; a key that may change or copy the map computed before the
    // map is made unique, with the indices of its place (H4).
    fun map_set(var self, cg: CodeGen, base: Expr, idx: Expr, value: Expr) {
        let mt = self.place_type(cg, base)
        let staged = self.stage(cg, map_val(mt), value)
        var place = base
        var key = idx
        if !settled_operand(idx, place_root(base)) {
            place = self.fixed_receiver(cg, base, idx.id)
            key = self.held_operand(cg, idx, format("%key{}", idx.id))
        }
        let h = self.place(cg, place)
        let cell = self.temp(mt)
        self.add(Inst.Cow(cell, mt, h))
        let k = self.key_operand(cg, mt, key)
        self.map_put(cg, mt, h, k, staged)
    }

    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), expr_of("(a, 'c')"))[0]
    fun map_contains(var self, cg: CodeGen, m: Expr, k: Expr) -> int32 {
        let mt = self.place_type(cg, m)
        if !is_map_t(mt) { return self.unsupported("contains on that type") }
        let cell = self.expr(cg, m)
        let key = self.key_operand(cg, mt, k)
        let slot = self.map_lookup(cg, mt, cell, key)
        let d = self.temp(Type.TBool)
        self.add(Inst.Cmp(d, "!=", Type.TPtr, slot, self.konst(Type.TPtr, 0)))
        return d
    }

    // `remove(m, k)`: the map made unique (copies keep the entry), the
    // key's entry found; when there is one, it becomes a tombstone and its
    // key and value are released. Nothing else moves: its rank becomes a gap
    // in the order of insertion, which `__map_keys` skips, and the table is
    // compacted as it fills (std.rt's maps, MYLA-310).
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"), expr_of("(a, 'c')"))[0]
    fun map_remove(var self, cg: CodeGen, m: Expr, k: Expr) -> int32 {
        let mt = self.place_type(cg, m)
        if !is_map_t(mt) { return self.unsupported("remove on that type") }
        // a key that may change or copy the map: computed first (H4)
        var place = m
        var kx = k
        if !settled_operand(k, place_root(m)) {
            place = self.fixed_receiver(cg, m, k.id)
            kx = self.held_operand(cg, k, format("%key{}", k.id))
        }
        let h = self.place(cg, place)
        let cell = self.temp(mt)
        self.add(Inst.Cow(cell, mt, h))
        let key = self.key_operand(cg, mt, kx)
        let slot = self.map_lookup(cg, mt, cell, key)
        let i64 = Type.TInt(64, true)
        let found = self.temp(Type.TBool)
        self.add(Inst.Cmp(found, "!=", Type.TPtr, slot, self.konst(Type.TPtr, 0)))
        let yes = self.new_block()
        let done = self.new_block()
        self.finish(Term.Br(found, yes, done))
        self.start(yes)
        self.add(Inst.StoreAt(slot, 0, self.konst(i64, 2), 8))
        let n = self.temp(i64)
        self.add(Inst.LoadAt(n, cell, 0, 8))
        let n1 = self.temp(i64)
        self.add(Inst.Bin(n1, "-", i64, i64, n, self.konst(i64, 1), Pos { line: 0, col: 0 }))
        self.add(Inst.StoreAt(cell, 0, n1, 8))
        for kv in [(cg.map_key_off(mt), map_key(mt)), (cg.map_val_off(mt), map_val(mt))] {
            let ft = kv.1
            if cg.is_boxed(ft) || is_cell_t(ft) {
                let v = self.temp(ft)
                self.add(Inst.LoadAt(v, slot, kv.0, 8))
                self.add(Inst.DropVal(ft, v))
            } else if is_tfunc(ft) || cg.owns_heap(ft) {
                self.add(Inst.DropAt(ft, self.offset(slot, kv.0)))
            }
        }
        self.finish(Term.Jmp(done))
        self.start(done)
        return -1
    }

    // --- strings ----------------------------------------------------------------

    #test(lower_on(), codegen_on("enum E { A, B(int) }"))[1]
    fun sb_new(var self, cg: CodeGen) -> int32 {
        let size = self.int_const(16)
        let cell = self.temp(Type.TSB)
        self.add(Inst.Rt(cell, "__alloc", [size]))
        let zero = self.int_const(0)
        self.add_store(cell, 0, zero)
        self.add_store(cell, 8, zero)
        return self.owned_value(cg, cell, Type.TSB)
    }

    // `StringBuilder(n)` (MYLA-369): a builder with room for `n` bytes,
    // std.rt's `sb_with_capacity`; without std.rt an empty one.
    fun sb_with_capacity(var self, cg: CodeGen, n: Expr) -> int32 {
        let v = self.expr(cg, n)
        let f = myla_runtime_function("__sb_with_capacity")
        if !cg.has_func(f) || cg.owning.contains(f) { return self.sb_new(cg) }
        let cell = self.temp(Type.TSB)
        self.add(Inst.Call(cell, f, [v]))
        return self.owned_value(cg, cell, Type.TSB)
    }

    // `append(sb, s)`, `append(sb, s, start, end)` (the range checked),
    // `append_byte(sb, b)` and `append_char(sb, c)` (std.rt's, MYLA-390): the
    // builder made unique first, then the arguments; arguments that may
    // change or copy the builder computed before it, in order (H4).
    fun sb_append(var self, cg: CodeGen, e: Expr, nm: str, args0: [Expr]) -> int32 {
        var args = args0
        if !settled_operands(args0[1:], place_root(args0[0])) {
            args = [self.fixed_receiver(cg, args0[0], e.id)]
            var i = 1
            while i < args0.len() {
                args.push(self.held_operand(cg, args0[i], format("%arg{}_{}", e.id, i)))
                i = i + 1
            }
        }
        let h = self.place(cg, args[0])
        let cell = self.temp(Type.TSB)
        self.add(Inst.Cow(cell, Type.TSB, h))
        let v = self.expr(cg, args[1])
        if nm == "append_char" {
            if !cg.has_func("std$rt$sb_append_char") { return self.unsupported("append_char without std.rt") }
            self.add(Inst.Call(-1, "std$rt$sb_append_char", [h, v]))
        } else if nm == "append_byte" {
            // std.rt's where the program has it (MYLA-162)
            if cg.has_func("std$rt$sb_append_byte") && !cg.owning.contains("std$rt$sb_append_byte") { self.add(Inst.Call(-1, "std$rt$sb_append_byte", [h, v])) }
            else { self.add(Inst.SbAppendByte(h, v)) }
        } else if args.len() == 4 {
            let a = self.expr(cg, args[2])
            let b = self.expr(cg, args[3])
            self.add(Inst.SbAppendRange(h, v, a, b, Pos { line: e.line, col: e.col }))
        } else {
            // std.rt's `sb_append` where the program has it (MYLA-162)
            let f = myla_runtime_function("__sb_append")
            if cg.has_func(f) && !cg.owning.contains(f) { self.add(Inst.Call(-1, f, [h, v])) }
            else { self.add(Inst.SbAppend(h, v)) }
        }
        return -1
    }

    // `format(fmt, args…)` (and f-strings): the literal's pieces concatenated
    // with each argument's print form; every intermediate string is owned by
    // the statement.
    fun format_call(var self, cg: CodeGen, args: [Expr]) -> int32 {
        let fmt = match args[0].kind {
            ExprKind.StrLit(s) => s
            _ => ""
        }
        let segs = format_segments(fmt)
        let specs = format_specs(fmt)
        // the pieces, empty literal ones left out, joined at the end with
        // as few new strings as there are groups of four (MYLA-252)
        var parts: [int32] = []
        if segs[0] != "" || args.len() == 1 { parts.push(self.str_const(segs[0])) }
        var k = 1
        while k < args.len() {
            parts.push(self.render_spec(cg, args[k], specs[k - 1]))
            if segs[k] != "" { parts.push(self.str_const(segs[k])) }
            k = k + 1
        }
        return self.join_strs(cg, parts)
    }

    // A temporary holding the literal string `s`.
    fun str_const(var self, s: str) -> int32 {
        let t = self.temp(Type.TStr)
        self.add(Inst.Str(t, s))
        return t
    }

    // The strings `parts` (at least one) as one: each group of up to four
    // joined into a new string the statement owns (std.rt's `str_concat`,
    // `str_concat3`, `str_concat4`), until one is left.
    fun join_strs(var self, cg: CodeGen, parts: [int32]) -> int32 {
        var acc = parts
        while acc.len() > 1 {
            var next: [int32] = []
            var i = 0
            while i < acc.len() {
                var n = acc.len() - i
                if n > 4 { n = 4 }
                if n == 1 { next.push(acc[i]) }
                else if n == 2 {
                    let d = self.temp(Type.TStr)
                    self.rt_call(cg, d, "__str_concat", [acc[i], acc[i + 1]])
                    next.push(self.owned_value(cg, d, Type.TStr))
                } else {
                    var name = "std$rt$str_concat3"
                    if n == 4 { name = "std$rt$str_concat4" }
                    var group: [int32] = []
                    var j = 0
                    while j < n {
                        group.push(acc[i + j])
                        j = j + 1
                    }
                    next.push(self.call_owning(cg, name, group))
                }
                i = i + n
            }
            acc = next
        }
        return acc[0]
    }

    // One hole's text (D139): a value of a type with its own `format`
    // through it, the spec passed as it is; else the print form, formatted by
    // the spec with std.fmt (as the interpreter does), a new string the
    // statement owns.
    fun render_spec(var self, cg: CodeGen, arg: Expr, spec: str) -> int32 {
        let t = cg.type_of(arg.id)
        if is_struct_or_enum_t(t) { return self.user_format(cg, arg, t, spec) }
        if spec == "" { return self.render(cg, arg) }
        var name = "std$fmt$fmt_text"
        var vals: [int32] = []
        match t {
            Type.TInt(w, sg) => {
                name = "std$fmt$fmt_int"
                let v = self.expr(cg, arg)
                let v64 = self.temp(Type.TInt(64, true))
                self.add(Inst.Cast(v64, t, Type.TInt(64, true), v))
                vals = [v64, self.int_const(w), self.konst(Type.TBool, if sg { 1 } else { 0 })]
            },
            Type.TFloat(w) => {
                name = "std$fmt$fmt_float"
                let v = self.expr(cg, arg)
                var extra = 17
                if w == 32 { extra = 9 }
                let text = self.temp(Type.TStr)
                self.rt_call(cg, text, "__float_to_str", [v, self.int_const(extra)])
                let owned_text = self.owned_value(cg, text, Type.TStr)
                var v64 = v
                if w == 32 {
                    v64 = self.temp(Type.TFloat(64))
                    self.add(Inst.Cast(v64, t, Type.TFloat(64), v))
                }
                vals = [v64, owned_text]
            },
            _ => { vals = [self.render(cg, arg)] },
        }
        if !cg.has_func(name) { return self.unsupported("a format spec without std.fmt") }
        let sv = self.temp(Type.TStr)
        self.add(Inst.Str(sv, spec))
        vals.push(sv)
        return self.call_owning(cg, name, vals)
    }

    // `x.format(spec)` of a value of a type implementing `Format` (D139).
    fun user_format(var self, cg: CodeGen, arg: Expr, t: Type, spec: str) -> int32 {
        let name = format("{}.format", cg.type_key(t))
        if !cg.has_func(name) { return self.unsupported("format of a value without a 'format' method") }
        let sig = cg.sig_of(name)
        let p = self.addr(cg, arg)
        var vals: [int32] = []
        if cg.has_byval(sig) && cg.byval_param(sig, 0, t) { for w in self.value_words(cg, t, p) { vals.push(w) } } else { vals.push(p) }
        let sv = self.temp(Type.TStr)
        self.add(Inst.Str(sv, spec))
        vals.push(sv)
        return self.call_owning_as(cg, name, self.method_instance(cg, name, [arg]), vals)
    }

    // The function an operator or a format hole calls for the method `name`
    // of a user type (MYLA-367): the method itself, or, for a generic impl's,
    // its instance for the type arguments the operands' types give (as a
    // call's are solved), which is made then. Named by the type's key alone,
    // no instance was made and the program didn't link.
    fun method_instance(var self, cg: CodeGen, name: str, args: [Expr]) -> str {
        if !cg.has_func(name) { return name }
        let sig = cg.sig_of(name)
        if sig.type_params.len() == 0 { return name }
        let targs = cg.solve_targs(sig, args, -1, [])
        self.f.instances.push(Instance { orig: sig.name, targs: targs })
        return mangle_fn(sig.name, targs)
    }

    fun call_owning(var self, cg: CodeGen, name: str, vals: [int32]) -> int32 {
        return self.call_owning_as(cg, name, name, vals)
    }

    // A call of the function `name` with the argument words `vals` (each
    // one word, the receiver's address first for a method), each parameter
    // that keeps its argument given a reference of its own (MYLA-127); the
    // string it returns, owned by the statement; `callee` is the instance
    // called when `name` is generic.
    fun call_owning_as(var self, cg: CodeGen, name: str, callee: str, vals: [int32]) -> int32 {
        let sig = cg.sig_of(name)
        var params: [Type] = []
        var first = 0
        if sig.has_decl && match sig.decl.receiver { Some(r) => true, None => false } { first = 1 }
        for pt in sig.params { params.push(pt) }
        let owns = cg.owned_params(sig, params)
        var i = first
        while i < vals.len() {
            let pi = i - first
            if pi < owns.len() && owns[pi] { self.retain(cg, params[pi], vals[i]) }
            i = i + 1
        }
        let d = self.temp(Type.TStr)
        self.add(Inst.Call(d, callee, vals))
        return self.owned_value(cg, d, Type.TStr)
    }

    // The print form of a printable value as a string: a string itself
    // (borrowed), or a new one the statement owns.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[1]
    fun render(var self, cg: CodeGen, arg: Expr) -> int32 {
        let t = cg.type_of(arg.id)
        var helper = ""
        var extra = -1
        match t {
            Type.TStr => { return self.expr(cg, arg) },
            Type.TBool => { helper = "__bool_to_str" },
            Type.TInt(w, s) => {
                if s { helper = "__int_to_str" } else { helper = "__uint_to_str" }
            },
            Type.TFloat(w) => {
                helper = "__float_to_str"
                if w == 32 { extra = 9 } else { extra = 17 }
            },
            Type.TChar => { helper = "__char_to_str" },
            _ => { return self.unsupported("format of a value that isn't a scalar or a string") },
        }
        let v = self.expr(cg, arg)
        var rargs = [v]
        if extra >= 0 { rargs.push(self.int_const(extra)) }
        let d = self.temp(Type.TStr)
        self.rt_call(cg, d, helper, rargs)
        return self.owned_value(cg, d, Type.TStr)
    }

    // --- `?` -------------------------------------------------------------------

    // `inner?`: the success payload (a scalar's temporary or an aggregate's
    // address), borrowed from the operand; otherwise the failure's tag and
    // payload are copied into the function's result with references of their
    // own, and it returns as `return` does.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"))[0]
    fun try_expr(var self, cg: CodeGen, e: Expr, inner: Expr) -> int32 {
        let carrier = cg.type_of(inner.id)
        if !lowerable(cg, carrier) { return self.unsupported("`?` on a value of that type") }
        if self.sret < 0 { return self.unsupported("`?` in a function without a carrier result") }
        let en = enum_name_of(carrier)
        let c = self.addr(cg, inner)
        let tag = self.temp(Type.TInt(64, true))
        self.add_load(tag, c, 0)
        let ok_tag = self.konst(Type.TInt(64, true), cg.variant_tag(en, success_variant(en)) as int64)
        let is_ok = self.temp(Type.TBool)
        self.add(Inst.Cmp(is_ok, "==", Type.TInt(64, true), tag, ok_tag))
        let ok_b = self.new_block()
        let fail_b = self.new_block()
        self.finish(Term.Br(is_ok, ok_b, fail_b))
        self.start(fail_b)
        // the tag and the failure's payload only: the result can be smaller
        // than the operand (MYLA-80)
        var nbytes = 8
        for ft in cg.variant_payload(carrier, failure_variant(en)) { nbytes = nbytes + cg.stored_size(ft) }
        let dst = self.slot_addr(self.sret)
        self.add(Inst.Copy(dst, c, nbytes))
        self.retain(cg, self.f.slots[self.sret].ty, dst)
        self.drop_temps(0)
        self.drop_owners(0)
        self.exit_fn(dst, true)
        self.start(ok_b)
        let rt = cg.type_of(e.id)
        let off = cg.variant_field_offset(carrier, success_variant(en), 0)
        if is_aggregate(rt) { return self.unbox(cg, rt, self.offset(c, off)) }
        let d = self.temp(rt)
        self.add_load(d, c, off)
        return d
    }

    // --- the other builtins -----------------------------------------------------

    // `panic(msg)`, `unreachable()` and `assert(c)`, `assert(c, msg)`: the
    // runtime error at the call's position; the code after the first two is
    // unreachable.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "unreachable", [])[-1]
    fun intrinsic(var self, cg: CodeGen, e: Expr, nm: str, args: [Expr]) -> int32 {
        let at = Pos { line: e.line, col: e.col }
        if nm == "panic" {
            let m = self.expr(cg, args[0])
            self.leave(Term.Panic(m, at))
            return -1
        }
        let fail = self.temp(Type.TStr)
        if nm == "unreachable" {
            self.add(Inst.Str(fail, "reached unreachable code"))
            self.leave(Term.Panic(fail, at))
            return -1
        }
        let c = self.expr(cg, args[0])
        let bad = self.new_block()
        let ok = self.new_block()
        self.finish(Term.Br(c, ok, bad))
        self.start(bad)
        if args.len() == 2 {
            // the message is computed only here, so its temporaries are this
            // branch's alone (MYLA-355): the statement's end, on the passing
            // path, mustn't drop them; the program ends here, so nothing is
            let tc = self.temps.len()
            self.begin_temps()
            let m = self.expr(cg, args[1])
            while self.temps.len() > tc { let ts = self.temps.pop() }
            self.finish(Term.Panic(m, at))
        } else {
            self.add(Inst.Str(fail, "assertion failed"))
            self.finish(Term.Panic(fail, at))
        }
        self.start(ok)
        return -1
    }

    // The I/O intrinsics (`__write`, `__read_file`, …): runtime helpers taking
    // their arguments in the calling registers, or the runtime's variables; a
    // result that is a cell is a new reference.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "let", [])[0]
    fun io_call(var self, cg: CodeGen, e: Expr, nm: str, args: [Expr]) -> int32 {
        let t = cg.type_of(e.id)
        if nm == "__io_errno" || nm == "__run_stderr" {
            let d = self.temp(t)
            self.add(Inst.Global(d, nm + "_val", 8))
            return self.owned_value(cg, d, t)
        }
        // the test runner's environment, natively (D162): the harness of
        // `myla test --native` sets MYLA_TEST_DIR and MYLA_TEST_PROGRAM for
        // the case it runs
        if nm == "__test_dir" || nm == "__test_program" {
            let var_name = if nm == "__test_dir" { "MYLA_TEST_DIR" } else { "MYLA_TEST_PROGRAM" }
            let sv = self.temp(Type.TStr)
            self.add(Inst.Str(sv, var_name))
            let d = self.temp(t)
            self.rt_call(cg, d, "__getenv", [sv])
            return self.owned_value(cg, d, t)
        }
        if nm == "__run_exit_code" || nm == "__run_signal" || nm == "__run_errno" {
            var sym = nm + "_val"
            if nm == "__run_exit_code" { sym = "__run_exit_val" }
            let d = self.temp(t)
            self.add(Inst.Global(d, sym, 4))
            return d
        }
        // raw memory (MYLA-162's prototype): loads and stores of a width,
        // the allocator, a string's cell and back
        if is_raw_memory_primitive(nm) {
            // a runtime variable, by its name (MYLA-162)
            if nm == "__rt_addr" || nm == "__rt_get" || nm == "__rt_waddr" {
                let sym = match args[0].kind {
                    ExprKind.StrLit(x) => x,
                    _ => "",
                }
                let d = self.temp(t)
                if nm == "__rt_get" { self.add(Inst.Global(d, sym, 8)) }
                else if nm == "__rt_waddr" {
                    let w = self.expr(cg, args[1])
                    self.add(Inst.Intr(d, Intrinsic.RtWaddr(sym), [w]))
                } else { self.add(Inst.Intr(d, Intrinsic.RtAddr(sym), [])) }
                return d
            }
            // the out-of-memory error ends the block: nothing after it is
            // live across it
            if nm == "__trap_oom" {
                self.leave(Term.Trap("oom", Pos { line: e.line, col: e.col }))
                return -1
            }
            var vals: [int32] = []
            // a store of a value without calls: the value first, so the
            // address is computed right before the store, which can take it
            // as its addressing mode (MYLA-162)
            var lit_first = false
            if (nm == "__store8" || nm == "__store32" || nm == "__store64") && args.len() == 2 {
                lit_first = calls_nothing(args[1])
            }
            if lit_first {
                let v1 = self.expr(cg, args[1])
                vals.push(self.expr(cg, args[0]))
                vals.push(v1)
            } else {
                for a in args { vals.push(self.expr(cg, a)) }
            }
            if nm == "__load8" || nm == "__load32" || nm == "__load64" {
                let d = self.temp(t)
                var w = 8
                if nm == "__load8" { w = 1 }
                if nm == "__load32" { w = 4 }
                self.add(Inst.LoadAt(d, vals[0], 0, w))
                return d
            }
            if nm == "__store8" || nm == "__store32" || nm == "__store64" {
                var w = 8
                if nm == "__store8" { w = 1 }
                if nm == "__store32" { w = 4 }
                self.add(Inst.StoreAt(vals[0], 0, vals[1], w))
                return -1
            }
            // the runtime variables a primitive sets, stored into in place
            // (MYLA-263): what `__io_errno` reads, and a child's status and
            // stderr (the bytes with a reference of their own)
            if nm == "__set_io_errno" {
                self.store_rt_var("__io_errno_val", vals[0], 8)
                return -1
            }
            if nm == "__set_run_status" {
                self.store_rt_var("__run_exit_val", vals[0], 4)
                self.store_rt_var("__run_signal_val", vals[1], 4)
                self.store_rt_var("__run_errno_val", vals[2], 4)
                return -1
            }
            if nm == "__set_run_stderr" {
                self.add(Inst.Intr(-1, Intrinsic.RcInc, [vals[0]]))
                self.store_rt_var("__run_stderr_val", vals[0], 8)
                return -1
            }
            if nm == "__copy_bytes" || nm == "__free" || nm == "__pause" || nm == "__run_frame" || nm == "__store_rel64" {
                self.add(rt_inst(-1, nm, vals))
                return -1
            }
            let d = self.temp(t)
            if nm == "__alloc" || nm == "__equal_bytes" || nm == "__syscall" || nm == "__syscall5" || nm == "__rotl" || nm == "__bsr64" || nm == "__cas64" || nm == "__xchg64" || nm == "__fetch_add64" || nm == "__f64_round" || nm == "__load_acq64" || nm == "__call_code" { self.add(rt_inst(d, nm, vals)) } else if nm == "__argv" { self.add(Inst.Global(d, "__argv", 8)) } else if nm == "__environ" { self.add(Inst.Global(d, "__envp", 8)) } else { self.add(Inst.Mov(d, vals[0])) }
            if nm == "__str_of" || nm == "__list_of" { return self.owned_value(cg, d, t) }
            return d
        }
        // helpers without a result, then those with one
        let effects = ["__exit", "__write", "__write_bytes", "__write_file", "__mkdir", "__unlink", "__rmdir", "__rename", "__sleep_ns", "__kill", "__close"]
        let results = ["__clock_ns", "__disarm", "__spawn", "__run_with", "__spawn_with", "__reap", "__args", "__read_file", "__read", "__poll", "__getcwd", "__getenv", "__sqrt", "__f64_bits", "__f64_from_bits", "__list_dir", "__stat", "__run", "__task_cancelled", "__str_to_bytes", "__bytes_to_str", "__read_bytes"]
        var has_result = false
        var known = false
        for r in effects { if r == nm { known = true } }
        for r in results {
            if r == nm {
                known = true
                has_result = true
            }
        }
        if is_platform_primitive(nm) {
            known = true
            has_result = true
        }
        // a notifier's (MYLA-387); without tasks, `__notify` wakes nobody and
        // an awaited `__park` (a statement, not `await_let`'s) can't be woken
        if is_notify_primitive(nm) && (nm != "__park" || !cg.frames) {
            var vs: [int32] = []
            for a in args { vs.push(self.expr(cg, a)) }
            if nm == "__notify" || nm == "__park" {
                if cg.frames { self.rt_call(cg, -1, nm, vs) } else { self.rt_call(cg, -1, nm + "_alone", vs) }
                return -1
            }
            let d = self.temp(t)
            self.rt_call(cg, d, nm, vs)
            return d
        }
        if !known { return self.unsupported(format("the builtin {}", nm)) }
        // without tasks nothing is ever asked to stop (MYLA-263: no routine)
        if nm == "__task_cancelled" && !cg.frames { return self.konst(Type.TBool, 0) }
        var vals: [int32] = []
        for a in args { vals.push(self.expr(cg, a)) }
        if nm == "__exit" {
            self.add(Inst.Exit(vals[0]))
            return -1
        }
        if !has_result {
            self.rt_call(cg, -1, nm, vals)
            return -1
        }
        let d = self.temp(t)
        self.rt_call(cg, d, nm, vals)
        return self.owned_value(cg, d, t)
    }

    #test(lower_on(), codegen_on("enum E { A, B(int) }"), expr_of("(a, 'c')"))[-1]
    fun print(var self, cg: CodeGen, arg: Expr) -> int32 {
        let t = cg.type_of(arg.id)
        // a type with its own form: printed as `print(f"{x}")` (D159)
        if is_struct_or_enum_t(t) {
            let text = Expr { id: arg.id, line: arg.line, col: arg.col, sp: arg.sp, kind: ExprKind.StrLit("{}") }
            let s = self.format_call(cg, [text, arg])
            let f = myla_runtime_function("__print_str")
            if cg.has_func(f) && !cg.owning.contains(f) { self.add(Inst.Call(-1, f, [s])) }
            else { self.add(Inst.Print(Type.TStr, s)) }
            return -1
        }
        if !is_scalar(t) && !is_tstr(t) { return self.unsupported("print of a value that isn't a scalar or a string") }
        let v = self.expr(cg, arg)
        // std.rt's printing where the program has it, a float aside
        // (MYLA-162)
        var nm = ""
        match t {
            Type.TStr => { nm = "__print_str" },
            Type.TBool => { nm = "__print_bool" },
            Type.TChar => { nm = "__print_char" },
            Type.TInt(w, s) => { if s { nm = "__print_int" } else { nm = "__print_uint" } },
            _ => {},
        }
        let f = myla_runtime_function(nm)
        if nm != "" && cg.has_func(f) && !cg.owning.contains(f) { self.add(Inst.Call(-1, f, [v])) }
        else { self.add(Inst.Print(t, v)) }
        return -1
    }

    // --- match ------------------------------------------------------------------

    // `match scrut { arms }`: the scrutinee copied into a slot, each arm's
    // pattern tested against it in turn (its bindings copied out of it,
    // borrowing), the guard, the body; no arm matching traps. The copy holds
    // references of its own only when an arm may write the variable it came
    // from (MYLA-2). `want`: the match is a value, returned as a scalar's
    // temporary or an aggregate's address (else -1), owned by the statement.
    fun match_expr(var self, cg: CodeGen, e: Expr, scrut: Expr, arms: [MatchArm], want: bool) -> int32 {
        if self.err != "" { return 0 }
        let sst = cg.type_of(scrut.id)
        if !lowerable(cg, sst) { return self.unsupported("a match on a value of that type") }
        let rt = cg.type_of(e.id)
        var result = -1
        if want {
            if !lowerable(cg, rt) { return self.unsupported("a match whose value has that type") }
            result = self.value_slot(cg, "__match", rt, true)
        }
        let root_var = place_root(scrut)
        // the copy owns references of its own when an arm may write the
        // variable, or when other calls of the actor may (MYLA-168's t13)
        let owns_copy = root_var != "" && cg.owns_heap(sst) && (arms_may_write(arms, root_var) || self.shared_self(root_var))
        let root = self.value_slot(cg, "__scrutinee", sst, owns_copy)
        let base = self.slot_addr(root)
        if is_aggregate(sst) {
            let src = self.addr(cg, scrut)
            self.add(Inst.Copy(base, src, cg.size(sst)))
            if owns_copy { self.retain(cg, sst, base) }
        } else {
            let v = self.expr(cg, scrut)
            self.add(Inst.Store(root, v))
            if owns_copy { self.retain(cg, sst, v) }
        }
        // the copy is dropped after the match, or by an early exit from an arm
        var match_owners: [int32] = []
        self.owners.push(match_owners)
        self.own(root)
        let end = self.new_block()
        for arm in arms {
            if self.err != "" { return 0 }
            let fail = self.new_block()
            self.arm_binds = []
            self.pattern(cg, arm.pattern, base, 0, sst, fail)
            var names: [Local] = []
            self.scopes.push(names)
            var arm_owners: [int32] = []
            self.owners.push(arm_owners)
            self.enter_scope()
            self.add(Inst.Scope(true))
            for b in self.arm_binds {
                self.declare(b.name, b.slot)
                self.add(Inst.Bind(b.name, b.slot))
            }
            match arm.guard {
                Some(g) => {
                    let body_b = self.new_block()
                    self.branch(cg, g, body_b, fail)
                    self.start(body_b)
                },
                None => {},
            }
            self.arm_body(cg, arm.body, result, rt)
            self.leave(Term.Jmp(end))
            self.scopes.pop()
            self.owners.pop()
            let id = self.scope_ids.pop()
            self.add(Inst.Scope(false))
            self.finish(Term.Jmp(fail))
            self.start(fail)
        }
        self.finish(Term.Trap("match", Pos { line: e.line, col: e.col }))
        self.start(end)
        self.drop_owners(self.owners.len() - 1)
        self.owners.pop()
        if result < 0 { return -1 }
        // every arm that reaches here stored the value
        self.own_temp(result)
        if is_aggregate(rt) { return self.slot_addr(result) }
        let d = self.temp(rt)
        self.add(Inst.Load(d, result))
        return d
    }

    // An arm's body; with a result slot, the value of its expression, or of a
    // block's last expression statement, is stored there with its own
    // references. An expression body drops its temporaries right after.
    fun arm_body(var self, cg: CodeGen, body: ExprOrBlock, result: int32, rt: Type) {
        match body {
            ExprOrBlock.EB_Expr(ex) => {
                self.add(Inst.Loc(Pos { line: ex.line, col: ex.col }))
                self.begin_temps()
                if result >= 0 && !diverges(ex) { self.store_result(cg, ex, result, rt) } else { self.discard(cg, ex) }
                self.end_temps()
            },
            ExprOrBlock.EB_Block(b) => {
                self.open_scope()
                let n = b.stmts.len()
                var i = 0
                while i < n {
                    let s = b.stmts[i]
                    var last_value = false
                    if i == n - 1 && result >= 0 {
                        match s.kind {
                            StmtKind.ExprStmt(ex) => {
                                last_value = !diverges(ex)
                            },
                            _ => {},
                        }
                    }
                    if last_value {
                        match s.kind {
                            StmtKind.ExprStmt(ex) => {
                                self.begin_temps()
                                self.store_result(cg, ex, result, rt)
                                self.end_temps()
                            },
                            _ => {},
                        }
                    }
                    if !last_value { self.stmt(cg, s) }
                    i = i + 1
                }
                self.close_scope()
            },
        }
    }

    fun store_result(var self, cg: CodeGen, ex: Expr, result: int32, rt: Type) {
        if is_aggregate(rt) {
            let src = self.addr(cg, ex)
            let took = self.took(cg, rt, src)
            let dst = self.slot_addr(result)
            self.add(Inst.Copy(dst, src, cg.size(rt)))
            if !took { self.retain(cg, rt, dst) }
        } else {
            let v = self.expr(cg, ex)
            let took = self.took(cg, rt, v)
            self.add(Inst.Store(result, v))
            if !took { self.retain(cg, rt, v) }
        }
    }

    // Test pattern `p` against the value of type `t` at `base + off`, jumping
    // to `fail` when it doesn't match; bindings are copied into slots of their
    // own, borrowing (one per name and arm, shared by the alternatives of `|`).
    fun pattern(var self, cg: CodeGen, p: Pattern, base: int32, off: int32, t: Type, fail: int32) {
        if self.err != "" { return }
        match p.kind {
            PatternKind.PWild => {},
            PatternKind.PBind(n) => {
                if cg.is_nullary_variant(n) {
                    self.check_tag(cg, base, off, cg.variant_tag(enum_name_of(t), n), fail)
                    return
                }
                let slot = self.arm_slot(cg, n, t)
                if is_aggregate(t) {
                    let src = self.offset(base, off)
                    let dst = self.slot_addr(slot)
                    self.add(Inst.Copy(dst, src, cg.size(t)))
                } else {
                    let v = self.temp(t)
                    self.add_load(v, base, off)
                    self.add(Inst.Store(slot, v))
                }
            },
            PatternKind.PLit(lit) => {
                let v = self.temp(t)
                self.add_load(v, base, off)
                if is_tstr(t) {
                    let c = self.expr(cg, lit)
                    let eq = self.temp(Type.TBool)
                    self.rt_call(cg, eq, "__str_eq", [v, c])
                    let next = self.new_block()
                    self.finish(Term.Br(eq, next, fail))
                    self.start(next)
                    return
                }
                // the 64-bit images are compared (`cmpq`), as the Python
                // backend does
                let c = self.expr(cg, lit)
                self.branch_equal(v, c, fail)
            },
            PatternKind.PEnum(en, variant, elems, hp) => {
                self.check_tag(cg, base, off, cg.variant_tag(enum_name_of(t), variant), fail)
                let payload = cg.variant_payload(t, variant)
                var i = 0
                for sub in elems {
                    self.member_pattern(cg, sub, base, off + cg.variant_field_offset(t, variant, i), payload[i], fail)
                    i = i + 1
                }
            },
            PatternKind.PTuple(elems) => {
                let ets = tuple_elems(t)
                var i = 0
                for sub in elems {
                    self.member_pattern(cg, sub, base, off + cg.elem_offset(t, i), ets[i], fail)
                    i = i + 1
                }
            },
            PatternKind.PStruct(name, fps) => {
                for fp in fps {
                    self.member_pattern(cg, fp.pattern, base, off + cg.field_offset(t, fp.name), cg.struct_field_type_t(t, fp.name), fail)
                }
            },
            PatternKind.POr(alts) => {
                let matched = self.new_block()
                let n = alts.len()
                var i = 0
                while i < n - 1 {
                    let next_alt = self.new_block()
                    self.pattern(cg, alts[i], base, off, t, next_alt)
                    self.finish(Term.Jmp(matched))
                    self.start(next_alt)
                    i = i + 1
                }
                self.pattern(cg, alts[n - 1], base, off, t, fail)
                self.finish(Term.Jmp(matched))
                self.start(matched)
            },
        }
    }

    // The sub-pattern `sub` of the member of type `t` at `base + off`; a
    // recursive enum's member is a box, which it borrows from.
    fun member_pattern(var self, cg: CodeGen, sub: Pattern, base: int32, off: int32, t: Type, fail: int32) {
        let wild = match sub.kind {
            PatternKind.PWild => true
            _ => false
        }
        if cg.is_boxed(t) && !wild {
            let q = self.temp(Type.TPtr)
            self.add_load(q, base, off)
            self.pattern(cg, sub, q, 0, t, fail)
            return
        }
        self.pattern(cg, sub, base, off, t, fail)
    }

    fun check_tag(var self, cg: CodeGen, base: int32, off: int32, tag: int32, fail: int32) {
        let v = self.temp(Type.TInt(64, true))
        self.add_load(v, base, off)
        let c = self.konst(Type.TInt(64, true), tag as int64)
        self.branch_equal(v, c, fail)
    }

    // Continue when `a == b` (64-bit images), else jump to `fail`.
    fun branch_equal(var self, a: int32, b: int32, fail: int32) {
        let eq = self.temp(Type.TBool)
        self.add(Inst.Cmp(eq, "==", Type.TInt(64, true), a, b))
        let next = self.new_block()
        self.finish(Term.Br(eq, next, fail))
        self.start(next)
    }

    // The slot of the binding `n` in the current arm (made the first time); it
    // borrows from the scrutinee's copy.
    #test(lower_on(), codegen_on("enum E { A, B(int) }"), "a", Type.TBool)[0]
    fun arm_slot(var self, cg: CodeGen, n: str, t: Type) -> int32 {
        for b in self.arm_binds {
            if b.name == n { return b.slot }
        }
        let slot = self.value_slot(cg, n, t, false)
        self.arm_binds.push(Local { name: n, slot: slot, fixed: false })
        return slot
    }
}

// Whether `e` is a call that never returns (`panic`, `unreachable`): an
// arm ending in one has no value to store.
#test(expr_of("-n * 2"))[false]
fun diverges(e: Expr) -> bool {
    return match e.kind {
        ExprKind.Call(callee, args, _) => match callee.kind {
            ExprKind.Name(nm) => nm == "panic" || nm == "unreachable"
            _ => false
        }
        _ => false
    }
}

// Whether `as char` from `src` needs a check (MYLA-177): from any integer but
// a `uint8`, all of whose values are Unicode scalars.
#test(Type.TInt(32, true), Type.TChar)[true]
#test(Type.TChar, Type.TInt(32, true))[false]
#test(Type.TChar, Type.TInt(32, false))[false]
fun char_cast_checked(src: Type, t: Type) -> bool {
    match t { Type.TChar => {}, _ => { return false } }
    return match src {
        Type.TInt(w, signed) => signed || w > 8,
        _ => false,
    }
}

// The function of the runtime written in Myla (`std.rt`) that does what the
// assembly routine `name` does, or "" (MYLA-162: the routines move one by
// one).
#test("__str_concat")["std$rt$str_concat"]
#test("__alloc")[""]
pub fun myla_runtime_function(name: str) -> str {
    if name == "__str_concat" { return "std$rt$str_concat" }
    if name == "__str_eq" { return "std$rt$str_eq" }
    if name == "__stat" || name == "__mkdir" || name == "__unlink" || name == "__rmdir" || name == "__rename" || name == "__getcwd" || name == "__read_file" || name == "__write_file" || name == "__list_dir" || name == "__getenv" || name == "__run" || name == "__read" || name == "__poll" || name == "__args" || name == "__int_to_str" || name == "__uint_to_str" || name == "__str_chars" || name == "__map_lookup" || name == "__sb_append" || name == "__print_str" || name == "__print_int" || name == "__print_uint" || name == "__print_bool" || name == "__print_char" || name == "__write" || name == "__map_keys" || name == "__bool_to_str" || name == "__char_to_str" || name == "__clock_ns" || name == "__sleep_ns" || name == "__disarm" || name == "__spawn" || name == "__run_with" || name == "__spawn_with" || name == "__reap" || name == "__kill" || name == "__close" || name == "__str_to_bytes" || name == "__bytes_to_str" || name == "__read_bytes" || name == "__write_bytes" || name == "__sb_with_capacity" || is_platform_primitive(name) {
        // `__stat` -> `std$rt$stat`
        var sb = StringBuilder()
        sb.append(name, 2, name.len())
        return "std$rt$" + sb.build()
    }
    // a notifier's (MYLA-387), a wait's park with or without tasks
    if is_notify_primitive(name) || name == "__notify_alone" || name == "__park_frame" || name == "__park_alone" {
        var sb = StringBuilder()
        sb.append(name, 2, name.len())
        return "std$rt$" + sb.build()
    }
    return ""
}

// `a` and `b`, the same integer type (width and sign).
#test(Type.TInt(64, true), Type.TInt(64, true))[true]
#test(Type.TInt(64, true), Type.TInt(64, false))[false]
fun type_eq_ir(a: Type, b: Type) -> bool {
    return match a {
        Type.TInt(w, s) => match b { Type.TInt(w2, s2) => w == w2 && s == s2, _ => false },
        _ => false,
    }
}

// `v` wrapped into the integer type `t` (two's complement), as the
// arithmetic at run time wraps it.
#test(4294967296, Type.TInt(32, true))[0]
#test(255, Type.TInt(8, true))[-1]
#test(-1, Type.TInt(8, false))[255]
#test(-1, Type.TInt(64, false))[-1]
fun wrap_ir(v: int64, t: Type) -> int64 {
    return match t {
        Type.TInt(w, signed) => {
            if w >= 64 { return v }
            let m = v & (((1 as int64) << (w as int64)) - 1)
            if signed && ((m >> ((w - 1) as int64)) & 1) == 1 { return m - ((1 as int64) << (w as int64)) }
            m
        },
        _ => v,
    }
}

// Whether the function named `mangled` gets a checked build's overflow
// checks (D175): all but the runtime's, std.rt's and std.platform's, whose
// arithmetic on addresses, sizes and hashes the interpreter does natively
// too (its primitives are native code, built plain), as it would in a
// library built for release.
#test("main")[true]
#test("std$list$sum")[true]
#test("std$rt$map_lookup")[false]
#test("std$platform_aarch64$write")[false]
fun checked_code(mangled: str) -> bool {
    for prefix in ["std$rt$", "std$platform$", "std$platform_aarch64$", "std$platform_wasm$"] {
        if mangled.len() >= prefix.len() && mangled[:prefix.len()] == prefix { return false }
    }
    return true
}

// Whether evaluating `e` calls nothing and changes nothing (a literal, a
// name, operators on such), so it may be evaluated before its neighbours.
fun calls_nothing(e: Expr) -> bool {
    return match e.kind {
        ExprKind.IntLit(n, sfx, ch, big) => true,
        ExprKind.BoolLit(b) => true,
        ExprKind.Name(name) => true,
        ExprKind.Binary(op, l, r) => calls_nothing(l) && calls_nothing(r),
        ExprKind.Unary(op, x) => calls_nothing(x),
        ExprKind.Cast(x, t) => calls_nothing(x),
        _ => false,
    }
}

// --- the per-type routines as IR (MYLA-162) -------------------------------------
//
// Functions the code generator makes for a type rather than for source:
// built here as IR, so every backend emits them as it emits any function.

// An empty lowering of the routine `name` with result type `ret`, its entry
// block started.
fun routine(name: str, ret: Option<Type>) -> Lower {
    var lw = Lower { f: IrFunc { name: name, ret: ret, slots: [], temps: [], blocks: [], order: [], instances: [], frame: false, scope_parent: [-1] }, cur: 0, scopes: [[]], scope_ids: [0], owners: [[]], temps: [], loops: [], sret: -1, arm_binds: [], err: "", lams: [], partials: [], fnvals: [], holder: [], into: -1, placed: [], tail: false, tailed: false, frame_fn: false, result: -1, tasks: [], actor_self: -1, actor_off: 0, deep_res: false, narrow: [:], wants: [], defers: [], received: -1, refused: [], fn_name: "", by_addr: -1, by_addr_t: Type.TBool, resized: [], scanned: false, below: [], len_lets: [], nonneg: [], checked: false }
    let entry = lw.new_block()
    lw.start(entry)
    return lw
}

// `#derive(Eq)`'s `T.eq(self, other) -> bool` for the struct or enum `name`:
// the two values' addresses; field by field, or the tags and then the
// payload of the variant both have, each component compared as `==` does (a
// struct or enum by its own `eq`, a boxed one's cell passed, a string's
// bytes, a float as a float: NaN unequal, 0.0 and -0.0 equal).
pub fun derived_eq_ir(cg: CodeGen, name: str, is_enum: bool) -> Routine {
    var lw = routine(name + ".eq", Some(Type.TBool))
    let sa = lw.new_slot("self", Type.TPtr, 8, 0, false)
    let sb = lw.new_slot("other", Type.TPtr, 8, 1, false)
    let a = lw.temp(Type.TPtr)
    lw.add(Inst.Load(a, sa))
    let b = lw.temp(Type.TPtr)
    lw.add(Inst.Load(b, sb))
    let unequal = lw.new_block()
    if is_enum {
        let i64 = Type.TInt(64, true)
        let ta = lw.temp(i64)
        lw.add(Inst.LoadAt(ta, a, 0, 8))
        let tb = lw.temp(i64)
        lw.add(Inst.LoadAt(tb, b, 0, 8))
        let same = lw.temp(Type.TBool)
        lw.add(Inst.Cmp(same, "==", i64, ta, tb))
        let tags_same = lw.new_block()
        lw.finish(Term.Br(same, tags_same, unequal))
        lw.start(tags_same)
        let et = Type.TEnum(name, [])
        var i = 0
        for v in cg.enum_info(name).variants {
            if v.payload.len() > 0 {
                let is_v = lw.temp(Type.TBool)
                lw.add(Inst.Cmp(is_v, "==", i64, ta, lw.konst(i64, i as int64)))
                let this_v = lw.new_block()
                let next_v = lw.new_block()
                lw.finish(Term.Br(is_v, this_v, next_v))
                lw.start(this_v)
                var j = 0
                for pt in v.payload {
                    lw.eq_component(cg, a, b, cg.variant_field_offset(et, v.name, j), pt, unequal)
                    j = j + 1
                }
                lw.finish(Term.Jmp(next_v))
                lw.start(next_v)
            }
            i = i + 1
        }
    } else {
        var off = 0
        for fl in cg.struct_info(name).fields {
            lw.eq_component(cg, a, b, off, fl.ty, unequal)
            off = off + cg.stored_size(fl.ty)
        }
    }
    lw.finish(Term.Ret(lw.konst(Type.TBool, 1)))
    lw.start(unequal)
    lw.finish(Term.Ret(lw.konst(Type.TBool, 0)))
    return Routine { f: lw.f, wants: lw.wants }
}

// `__eq_<T>(a, b) -> bool`, `==` on the tuple or list type `t` (D163,
// MYLA-313): a tuple's elements in turn, at the two tuples' addresses; a
// list's lengths and then its elements, of the two lists' cells (the same
// cell is equal at once). Each element compared as `==` compares it.
pub fun compound_eq_ir(cg: CodeGen, t: Type, name: str) -> Routine {
    var lw = routine(name, Some(Type.TBool))
    // a list's cells are numbers here, to step through
    var pt = Type.TPtr
    if is_list_t(t) { pt = Type.TInt(64, true) }
    let sa = lw.new_slot("a", pt, 8, 0, false)
    let sb = lw.new_slot("b", pt, 8, 1, false)
    let unequal = lw.new_block()
    if is_list_t(t) {
        let et = list_elem(t)
        let i64 = Type.TInt(64, true)
        let pos = Pos { line: 0, col: 0 }
        let equal = lw.new_block()
        // one cell is equal to itself only where the elements' `==` is
        // built in and reflexive (M3): a NaN isn't, nor need a struct's `eq`
        if reflexive_eq(et) {
            let same = lw.temp(Type.TBool)
            lw.add(Inst.Cmp(same, "==", i64, lw.read_cell(sa), lw.read_cell(sb)))
            let differ = lw.new_block()
            lw.finish(Term.Br(same, equal, differ))
            lw.start(differ)
        }
        let na = lw.temp(i64)
        lw.add(Inst.LoadAt(na, lw.read_cell(sa), 0, 8))
        let nb = lw.temp(i64)
        lw.add(Inst.LoadAt(nb, lw.read_cell(sb), 0, 8))
        let lens = lw.temp(Type.TBool)
        lw.add(Inst.Cmp(lens, "==", i64, na, nb))
        let walk = lw.new_block()
        lw.finish(Term.Br(lens, walk, unequal))
        lw.start(walk)
        let si = lw.new_slot("i", i64, 8, -1, false)
        let sn = lw.new_slot("n", i64, 8, -1, false)
        lw.add(Inst.Store(si, lw.int_const(0)))
        lw.add(Inst.Store(sn, na))
        let body = lw.new_block()
        lw.count_test(si, sn, body, equal)
        lw.start(body)
        // the elements' addresses: cell + 16 + i * stride
        let stride = cg.elem_size(et)
        let i = lw.temp(i64)
        lw.add(Inst.Load(i, si))
        let scaled = lw.temp(i64)
        lw.add(Inst.Bin(scaled, "*", i64, i64, i, lw.int_const(stride), pos))
        let pa = lw.temp(i64)
        lw.add(Inst.Bin(pa, "+", i64, i64, lw.read_cell(sa), scaled, pos))
        let pb = lw.temp(i64)
        lw.add(Inst.Bin(pb, "+", i64, i64, lw.read_cell(sb), scaled, pos))
        lw.eq_member(cg, pa, pb, 16, et, unequal, stride)
        let i2 = lw.temp(i64)
        lw.add(Inst.Load(i2, si))
        let i3 = lw.temp(i64)
        lw.add(Inst.Bin(i3, "+", i64, i64, i2, lw.int_const(1), pos))
        lw.add(Inst.Store(si, i3))
        lw.count_test(si, sn, body, equal)
        lw.start(equal)
    } else {
        var off = 0
        for et in tuple_elems(t) {
            lw.eq_member(cg, lw.read_ptr(sa), lw.read_ptr(sb), off, et, unequal, 8)
            off = off + cg.stored_size(et)
        }
    }
    lw.finish(Term.Ret(lw.konst(Type.TBool, 1)))
    lw.start(unequal)
    lw.finish(Term.Ret(lw.konst(Type.TBool, 0)))
    return Routine { f: lw.f, wants: lw.wants }
}

// Whether `t`'s `==` is built in and reflexive, every value equal to itself:
// integers, `char`, `bool`, strings, the unit, and lists and tuples of such;
// not a float (NaN), nor a struct or enum, whose `eq` is a method a program
// may write (or derive over floats).
#test(Type.TList(Type.TTuple([Type.TStr, Type.TInt(8, false)])))[true]
#test(Type.TList(Type.TFloat(64)))[false]
#test(Type.TStruct("P", []))[false]
fun reflexive_eq(t: Type) -> bool {
    return match t {
        Type.TInt(w, sg) => true,
        Type.TChar => true,
        Type.TBool => true,
        Type.TStr => true,
        Type.TList(e) => reflexive_eq(e),
        Type.TTuple(es) => {
            var ok = true
            for e in es { ok = ok && reflexive_eq(e) }
            ok
        },
        _ => false,
    }
}

// `__thash_<T>(t, state) -> uint64`, a tuple's `hash` (D163, MYLA-313): the
// tuple at its address given, element by element, to its element type's
// `hash`, from the hasher whose state is `state`; the state it ends with.
pub fun tuple_hash_ir(cg: CodeGen, t: Type, name: str) -> Routine {
    let u64 = Type.TInt(64, false)
    var lw = routine(name, Some(u64))
    let sp = lw.new_slot("t", Type.TPtr, 8, 0, false)
    let ss = lw.new_slot("state", u64, 8, 1, false)
    var off = 0
    for et in tuple_elems(t) {
        let st = lw.temp(u64)
        lw.add(Inst.Load(st, ss))
        let next = lw.hash_member(cg, lw.read_ptr(sp), off, et, st)
        lw.add(Inst.Store(ss, next))
        off = off + cg.stored_size(et)
    }
    let r = lw.temp(u64)
    lw.add(Inst.Load(r, ss))
    lw.finish(Term.Ret(r))
    return Routine { f: lw.f, wants: lw.wants }
}

impl Lower {
    // The state of the hasher whose state is `state` once it was given the
    // member of type `ft` at `off` in the value at `p` through `ft`'s `hash`
    // (a tuple's through its `__thash_<T>`, a list's through its impl's
    // instance; a scalar by value, an aggregate by address).
    fun hash_member(var self, cg: CodeGen, p: int32, off: int32, ft: Type, state: int32) -> int32 {
        let u64 = Type.TInt(64, false)
        if is_unit(ft) { return state }
        if is_compound_eq_t(ft) && !is_list_t(ft) {
            let r = self.temp(u64)
            self.wants.push(Want { kind: 8, t: ft, clone: false })
            self.add(Inst.Call(r, type_job_name(Want { kind: 8, t: ft, clone: false }), [self.offset(p, off), state]))
            return r
        }
        let hasher = Type.TStruct("Hasher", [])
        let hs = self.new_slot("__hasher", hasher, 8, -1, false)
        self.add_store(self.slot_addr(hs), 0, state)
        let rs = self.new_slot("__hashed", hasher, 8, -1, false)
        var recv = -1
        if is_struct_or_enum_t(ft) && !cg.is_boxed(ft) {
            recv = self.offset(p, off)
        } else {
            recv = self.temp(ft)
            self.add(Inst.LoadAt(recv, p, off, 8))
        }
        var name = ""
        if is_list_t(ft) {
            name = mangle_fn("__list.hash", [list_elem(ft)])
            self.f.instances.push(Instance { orig: "__list.hash", targs: [list_elem(ft)] })
        } else {
            name = self.type_method(cg, ft, "hash")
        }
        self.add(Inst.CallSret(name, self.slot_addr(rs), [recv, self.slot_addr(hs)]))
        let r = self.temp(u64)
        self.add(Inst.LoadAt(r, self.slot_addr(rs), 0, 8))
        return r
    }

    // `t.hash(h)` of a tuple `t` (D163): its `__thash_<T>` from `h`'s state,
    // the hasher it ends with built in `into` or a slot of its own.
    fun tuple_hash(var self, cg: CodeGen, t: Type, recv: Expr, h: Expr, into: int32) -> int32 {
        let u64 = Type.TInt(64, false)
        let pt = self.addr(cg, recv)
        let ph = self.addr(cg, h)
        let st = self.temp(u64)
        self.add(Inst.LoadAt(st, ph, 0, 8))
        var r = st
        if !is_unit(t) {
            r = self.temp(u64)
            self.wants.push(Want { kind: 8, t: t, clone: false })
            self.add(Inst.Call(r, type_job_name(Want { kind: 8, t: t, clone: false }), [pt, st]))
        }
        let slot = self.build_slot(cg, "__hasher", Type.TStruct("Hasher", []), into)
        let base = self.slot_addr(slot)
        self.add_store(base, 0, r)
        self.built(slot, into, base)
        return base
    }
}

// --- the routines of a compound map key (D163, MYLA-313) ------------------------
//
// A map whose key isn't an integer, `char`, `bool` or `str` (`map_hashed`)
// reaches its slots through these, built per key type `K` as IR and called
// with the key's address; std.rt's `map_find_h`, `map_slot_h` and
// `map_keys_h` do the rest without them, as the slot keeps the key's hash.

const PHI_IR: int64 = -7046029254386353131   // 2^64 / the golden ratio, as std.rt's

// `__khash_<K>(p) -> int64`: the hash of the key at `p` by its words, as
// `==` sees them: an integer's, `char`'s or `bool`'s value, a string's
// std.rt `str_hash`, a tuple's and a derived `Hash`'s members in turn (an
// enum's tag first), a list's length then its elements; a type with its own
// `impl Hash` through its `hash`. Equal keys give equal hashes as long as a
// written `hash` keeps D163's promise.
pub fun key_hash_ir(cg: CodeGen, kt: Type, name: str) -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine(name, Some(i64))
    let sp = lw.new_slot("p", i64, 8, 0, false)
    let sh = lw.new_slot("h", i64, 8, -1, false)
    lw.add(Inst.Store(sh, lw.konst(i64, PHI_IR)))
    if is_list_t(kt) {
        // the cell, its length, then each element at its width
        let et = list_elem(kt)
        let cell = lw.temp(i64)
        lw.add(Inst.LoadAt(cell, lw.read_cell(sp), 0, 8))
        let sc = lw.new_slot("cell", i64, 8, -1, false)
        lw.add(Inst.Store(sc, cell))
        let n = lw.temp(i64)
        lw.add(Inst.LoadAt(n, lw.read_cell(sc), 0, 8))
        lw.mix_word(sh, n)
        let si = lw.new_slot("i", i64, 8, -1, false)
        let sn = lw.new_slot("n", i64, 8, -1, false)
        lw.add(Inst.Store(si, lw.int_const(0)))
        lw.add(Inst.Store(sn, n))
        let body = lw.new_block()
        let done = lw.new_block()
        lw.count_test(si, sn, body, done)
        lw.start(body)
        let stride = cg.elem_size(et)
        let at = lw.entry_at(sc, si, stride)
        lw.hash_key_member(cg, at, 16, et, sh, stride)
        let i2 = lw.temp(i64)
        lw.add(Inst.Load(i2, si))
        let i3 = lw.temp(i64)
        lw.add(Inst.Bin(i3, "+", i64, i64, i2, lw.int_const(1), Pos { line: 0, col: 0 }))
        lw.add(Inst.Store(si, i3))
        lw.count_test(si, sn, body, done)
        lw.start(done)
    } else {
        lw.hash_key_member(cg, lw.read_cell(sp), 0, kt, sh, 8)
    }
    // the high half folded into the low one, which picks the slot
    let h = lw.read_cell(sh)
    let u64 = Type.TInt(64, false)
    let hi = lw.temp(i64)
    lw.add(Inst.Bin(hi, ">>", u64, u64, h, lw.int_const(32), Pos { line: 0, col: 0 }))
    let r = lw.temp(i64)
    lw.add(Inst.Bin(r, "^", i64, i64, lw.read_cell(sh), hi, Pos { line: 0, col: 0 }))
    lw.finish(Term.Ret(r))
    return Routine { f: lw.f, wants: lw.wants }
}

impl Lower {
    // The word `w` mixed into the hash in the slot `sh`: xor, a multiply by
    // 2^64/phi, the top bits folded down.
    fun mix_word(var self, sh: int32, w: int32) {
        let i64 = Type.TInt(64, true)
        let u64 = Type.TInt(64, false)
        let pos = Pos { line: 0, col: 0 }
        let x = self.temp(i64)
        self.add(Inst.Bin(x, "^", i64, i64, self.read_cell(sh), w, pos))
        let m = self.temp(i64)
        self.add(Inst.Bin(m, "*", i64, i64, x, self.konst(i64, PHI_IR), pos))
        let top = self.temp(i64)
        self.add(Inst.Bin(top, ">>", u64, u64, m, self.int_const(29), pos))
        let f = self.temp(i64)
        self.add(Inst.Bin(f, "^", i64, i64, m, top, pos))
        self.add(Inst.Store(sh, f))
    }

    // The member of type `ft` at `off` from the address `p` mixed into the
    // hash in `sh` (see `key_hash_ir`); a scalar `width` bytes wide (a packed
    // list's element).
    fun hash_key_member(var self, cg: CodeGen, p: int32, off: int32, ft: Type, sh: int32, width: int32) {
        let i64 = Type.TInt(64, true)
        if is_unit(ft) { return }
        if is_tstr(ft) {
            let c = self.temp(i64)
            self.add(Inst.LoadAt(c, p, off, 8))
            let h = self.temp(i64)
            self.add(Inst.Call(h, "std$rt$str_hash", [c]))
            self.mix_word(sh, h)
            return
        }
        if is_list_t(ft) {
            // its own routine, from the word holding its cell
            let at = self.temp(i64)
            self.add(Inst.Bin(at, "+", i64, i64, p, self.int_const(off), Pos { line: 0, col: 0 }))
            let h = self.temp(i64)
            self.add(Inst.Call(h, self.want_key(9, ft), [at]))
            self.mix_word(sh, h)
            return
        }
        match ft {
            Type.TTuple(es) => {
                var cur = off
                for et in es {
                    self.hash_key_member(cg, p, cur, et, sh, 8)
                    cur = cur + cg.stored_size(et)
                }
                return
            },
            Type.TStruct(n, a) => {
                if cg.derives_hash(n) {
                    let info = cg.struct_info(n)
                    // a generic type's fields of its arguments (MYLA-379)
                    let sub = cg.type_subst(info.type_params, a)
                    var cur = off
                    for f in info.fields {
                        let fty = subst_type(f.ty, sub)
                        self.hash_key_member(cg, p, cur, fty, sh, 8)
                        cur = cur + cg.stored_size(fty)
                    }
                } else {
                    self.hash_written(cg, p, off, ft, sh)
                }
                return
            },
            Type.TEnum(n, a) => {
                if cg.derives_hash(n) && !cg.is_boxed(ft) {
                    let tag = self.temp(i64)
                    self.add(Inst.LoadAt(tag, p, off, 8))
                    self.mix_word(sh, tag)
                    let et = ft
                    let done = self.new_block()
                    var idx = 0
                    for v in cg.enum_info(n).variants {
                        if v.payload.len() > 0 {
                            let is_v = self.temp(Type.TBool)
                            let tg = self.temp(i64)
                            self.add(Inst.LoadAt(tg, p, off, 8))
                            self.add(Inst.Cmp(is_v, "==", i64, tg, self.konst(i64, idx as int64)))
                            let this_v = self.new_block()
                            let next_v = self.new_block()
                            self.finish(Term.Br(is_v, this_v, next_v))
                            self.start(this_v)
                            var j = 0
                            for pt in cg.variant_payload(et, v.name) {
                                self.hash_key_member(cg, p, off + cg.variant_field_offset(et, v.name, j), pt, sh, 8)
                                j = j + 1
                            }
                            self.finish(Term.Jmp(done))
                            self.start(next_v)
                        }
                        idx = idx + 1
                    }
                    self.finish(Term.Jmp(done))
                    self.start(done)
                } else {
                    self.hash_written(cg, p, off, ft, sh)
                }
                return
            },
            _ => {},
        }
        // an integer, `char` or `bool`: its value
        let w = self.temp(i64)
        if width < 8 {
            let x = self.temp(ft)
            self.add(Inst.LoadAt(x, p, off, width))
            self.add(Inst.Cast(w, ft, i64, x))
        } else {
            self.add(Inst.LoadAt(w, p, off, 8))
        }
        self.mix_word(sh, w)
    }

    // A struct's or enum's own `hash` (an `impl Hash` written for it) of the
    // value at `p + off`, from a hasher of state 0, its state mixed in.
    fun hash_written(var self, cg: CodeGen, p: int32, off: int32, ft: Type, sh: int32) {
        let i64 = Type.TInt(64, true)
        let hasher = Type.TStruct("Hasher", [])
        let hs = self.new_slot("__hasher", hasher, 8, -1, false)
        self.add_store(self.slot_addr(hs), 0, self.int_const(0))
        let rs = self.new_slot("__hashed", hasher, 8, -1, false)
        var recv = -1
        if cg.is_boxed(ft) {
            recv = self.temp(Type.TPtr)
            self.add(Inst.LoadAt(recv, p, off, 8))
        } else {
            let at = self.temp(i64)
            self.add(Inst.Bin(at, "+", i64, i64, p, self.int_const(off), Pos { line: 0, col: 0 }))
            recv = self.temp(Type.TPtr)
            self.add(Inst.Mov(recv, at))
        }
        self.add(Inst.CallSret(self.type_method(cg, ft, "hash"), self.slot_addr(rs), [recv, self.slot_addr(hs)]))
        let st = self.temp(i64)
        self.add(Inst.LoadAt(st, self.slot_addr(rs), 0, 8))
        self.mix_word(sh, st)
    }
}

// `__keq_<K>(a, b) -> bool`: the keys at `a` and `b` compared as `==`
// compares them.
pub fun key_eq_ir(cg: CodeGen, kt: Type, name: str) -> Routine {
    var lw = routine(name, Some(Type.TBool))
    let sa = lw.new_slot("a", Type.TPtr, 8, 0, false)
    let sb = lw.new_slot("b", Type.TPtr, 8, 1, false)
    let unequal = lw.new_block()
    lw.eq_member(cg, lw.read_ptr(sa), lw.read_ptr(sb), 0, kt, unequal, 8)
    lw.finish(Term.Ret(lw.konst(Type.TBool, 1)))
    lw.start(unequal)
    lw.finish(Term.Ret(lw.konst(Type.TBool, 0)))
    return Routine { f: lw.f, wants: lw.wants }
}

// `__mfind_<K>(cell, key, h, slot_size) -> slot`: the slot of the key at
// `key`, whose hash is `h`, in the map `cell`, or 0: each slot of that hash
// on its probe (std.rt's `map_find_h`) compared with it.
pub fun map_find_ir(cg: CodeGen, kt: Type, name: str) -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine(name, Some(i64))
    let sc = lw.new_slot("cell", i64, 8, 0, false)
    let sk = lw.new_slot("key", Type.TPtr, 8, 1, false)
    let sh = lw.new_slot("h", i64, 8, 2, false)
    let ss = lw.new_slot("slot_size", i64, 8, 3, false)
    let sl = lw.new_slot("slot", i64, 8, -1, false)
    let first = lw.temp(i64)
    lw.add(Inst.Call(first, "std$rt$map_find_h", [lw.read_cell(sc), lw.read_cell(sh), lw.read_cell(ss), lw.int_const(0)]))
    lw.add(Inst.Store(sl, first))
    let test = lw.new_block()
    lw.finish(Term.Jmp(test))
    lw.start(test)
    let none = lw.temp(Type.TBool)
    lw.add(Inst.Cmp(none, "==", i64, lw.read_cell(sl), lw.int_const(0)))
    let missing = lw.new_block()
    let compare = lw.new_block()
    lw.finish(Term.Br(none, missing, compare))
    lw.start(compare)
    let at = lw.temp(i64)
    lw.add(Inst.Bin(at, "+", i64, i64, lw.read_cell(sl), lw.int_const(16), Pos { line: 0, col: 0 }))
    let pa = lw.temp(Type.TPtr)
    lw.add(Inst.Mov(pa, at))
    let eq = lw.temp(Type.TBool)
    lw.add(Inst.Call(eq, lw.want_key(10, kt), [pa, lw.read_ptr(sk)]))
    let found = lw.new_block()
    let next = lw.new_block()
    lw.finish(Term.Br(eq, found, next))
    lw.start(found)
    lw.finish(Term.Ret(lw.read_cell(sl)))
    lw.start(next)
    let after = lw.temp(i64)
    lw.add(Inst.Call(after, "std$rt$map_find_h", [lw.read_cell(sc), lw.read_cell(sh), lw.read_cell(ss), lw.read_cell(sl)]))
    lw.add(Inst.Store(sl, after))
    lw.finish(Term.Jmp(test))
    lw.start(missing)
    lw.finish(Term.Ret(lw.int_const(0)))
    return Routine { f: lw.f, wants: lw.wants }
}

// `__mput_<K>(holder, key, slot_size) -> slot`: the slot of the key at `key`
// in the (unique) map the 8 bytes at `holder` point at, plus 1 when it was
// there; else a new one (std.rt's `map_slot_h`, which makes room), the key's
// words copied in with references of their own.
pub fun map_put_ir(cg: CodeGen, kt: Type, name: str) -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine(name, Some(i64))
    let so = lw.new_slot("holder", i64, 8, 0, false)
    let sk = lw.new_slot("key", Type.TPtr, 8, 1, false)
    let ss = lw.new_slot("slot_size", i64, 8, 2, false)
    let sh = lw.new_slot("h", i64, 8, -1, false)
    let h = lw.temp(i64)
    lw.add(Inst.Call(h, lw.want_key(9, kt), [lw.read_ptr(sk)]))
    lw.add(Inst.Store(sh, h))
    let cell = lw.temp(i64)
    lw.add(Inst.LoadAt(cell, lw.read_cell(so), 0, 8))
    let slot = lw.temp(i64)
    lw.add(Inst.Call(slot, lw.want_key(11, kt), [cell, lw.read_ptr(sk), lw.read_cell(sh), lw.read_cell(ss)]))
    let had = lw.temp(Type.TBool)
    lw.add(Inst.Cmp(had, "!=", i64, slot, lw.int_const(0)))
    let was = lw.new_block()
    let make = lw.new_block()
    lw.finish(Term.Br(had, was, make))
    lw.start(was)
    let tagged = lw.temp(i64)
    lw.add(Inst.Bin(tagged, "+", i64, i64, slot, lw.int_const(1), Pos { line: 0, col: 0 }))
    lw.finish(Term.Ret(tagged))
    lw.start(make)
    let made = lw.temp(i64)
    lw.add(Inst.Call(made, "std$rt$map_slot_h", [lw.read_cell(so), lw.read_cell(sh), lw.read_cell(ss)]))
    let sm = lw.new_slot("made", i64, 8, -1, false)
    lw.add(Inst.Store(sm, made))
    let ks = cg.stored_size(kt)
    if ks > 0 {
        let at = lw.temp(i64)
        lw.add(Inst.Bin(at, "+", i64, i64, lw.read_cell(sm), lw.int_const(16), Pos { line: 0, col: 0 }))
        let dst = lw.temp(Type.TPtr)
        lw.add(Inst.Mov(dst, at))
        lw.add(Inst.Copy(dst, lw.read_ptr(sk), ks))
        lw.entry_member(cg, lw.read_cell(sm), 16, kt, true)
    }
    lw.finish(Term.Ret(lw.read_cell(sm)))
    return Routine { f: lw.f, wants: lw.wants }
}

// `__mkeys_<K>(cell, slot_size) -> list`: the keys of the map `cell` in the
// order of insertion (std.rt's `map_keys_h`), each with references of its
// own.
pub fun map_keys_ir(cg: CodeGen, kt: Type, name: str) -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine(name, Some(i64))
    let sc = lw.new_slot("cell", i64, 8, 0, false)
    let ss = lw.new_slot("slot_size", i64, 8, 1, false)
    let sl = lw.new_slot("list", i64, 8, -1, false)
    let ks = cg.stored_size(kt)
    let list = lw.temp(i64)
    lw.add(Inst.Call(list, "std$rt$map_keys_h", [lw.read_cell(sc), lw.read_cell(ss), lw.int_const(ks)]))
    lw.add(Inst.Store(sl, list))
    if cg.owns_heap(kt) { lw.each_entry(cg, sl, 0, ks, false, kt, Type.TBool, true) }
    lw.finish(Term.Ret(lw.read_cell(sl)))
    return Routine { f: lw.f, wants: lw.wants }
}

// Whether `==` on `t` is a `__eq_<T>` routine's: a tuple (not the unit type)
// or a list (D163).
#test(Type.TTuple([Type.TInt(32, true)]))[true]
#test(Type.TList(Type.TStr))[true]
#test(Type.TTuple([]))[false]
#test(Type.TStr)[false]
pub fun is_compound_eq_t(t: Type) -> bool {
    return match t {
        Type.TTuple(es) => es.len() > 0,
        Type.TList(e) => true,
        _ => false,
    }
}

impl Lower {
    // The component of type `ft` at `off` in the values at `a` and `b`
    // compared, on in a new block when equal, to `unequal` when not.
    fun eq_component(var self, cg: CodeGen, a: int32, b: int32, off: int32, ft: Type, unequal: int32) {
        self.eq_member(cg, a, b, off, ft, unequal, 8)
    }

    // `eq_component` of a member `width` bytes wide when it is a scalar (a
    // packed list's element is narrower than 8, D120): a tuple or list
    // through its `__eq_<T>`, the unit type always equal.
    fun eq_member(var self, cg: CodeGen, a: int32, b: int32, off: int32, ft: Type, unequal: int32, width: int32) {
        if is_unit(ft) { return }
        let eq = self.temp(Type.TBool)
        if is_compound_eq_t(ft) {
            var pa = -1
            var pb = -1
            if is_list_t(ft) {
                pa = self.temp(Type.TPtr)
                self.add(Inst.LoadAt(pa, a, off, 8))
                pb = self.temp(Type.TPtr)
                self.add(Inst.LoadAt(pb, b, off, 8))
            } else {
                pa = self.offset(a, off)
                pb = self.offset(b, off)
            }
            self.add(Inst.Call(eq, self.want_eq(ft), [pa, pb]))
        } else if width < 8 && !is_tstr(ft) && !is_struct_or_enum_t(ft) {
            // a packed element, read as its own type
            let xa = self.temp(ft)
            self.add(Inst.LoadAt(xa, a, off, width))
            let xb = self.temp(ft)
            self.add(Inst.LoadAt(xb, b, off, width))
            self.add(Inst.Cmp(eq, "==", ft, xa, xb))
        } else if is_struct_or_enum_t(ft) {
            var pa = -1
            var pb = -1
            if cg.is_boxed(ft) {
                pa = self.temp(Type.TPtr)
                self.add(Inst.LoadAt(pa, a, off, 8))
                pb = self.temp(Type.TPtr)
                self.add(Inst.LoadAt(pb, b, off, 8))
            } else {
                pa = self.offset(a, off)
                pb = self.offset(b, off)
            }
            self.add(Inst.Call(eq, self.type_method(cg, ft, "eq"), [pa, pb]))
        } else if is_tstr(ft) {
            let ka = self.temp(Type.TStr)
            self.add(Inst.LoadAt(ka, a, off, 8))
            let kb = self.temp(Type.TStr)
            self.add(Inst.LoadAt(kb, b, off, 8))
            self.rt_call(cg, eq, "__str_eq", [ka, kb])
        } else if is_tfloat_ir(ft) {
            let f64 = Type.TFloat(64)
            let xa = self.temp(f64)
            self.add(Inst.LoadAt(xa, a, off, 8))
            let xb = self.temp(f64)
            self.add(Inst.LoadAt(xb, b, off, 8))
            self.add(Inst.Cmp(eq, "==", f64, xa, xb))
        } else {
            let i64 = Type.TInt(64, true)
            let xa = self.temp(i64)
            self.add(Inst.LoadAt(xa, a, off, 8))
            let xb = self.temp(i64)
            self.add(Inst.LoadAt(xb, b, off, 8))
            self.add(Inst.Cmp(eq, "==", i64, xa, xb))
        }
        let next = self.new_block()
        self.finish(Term.Br(eq, next, unequal))
        self.start(next)
    }
}

impl Lower {
    // The name a routine calls the struct or enum `t`'s method `m` by: a
    // generic impl's instance for `t`'s arguments, queued (MYLA-379), or the
    // method itself.
    fun type_method(var self, cg: CodeGen, t: Type, m: str) -> str {
        let (name, targs) = cg.type_method(t, m)
        if targs.len() == 0 { return name }
        self.f.instances.push(Instance { orig: name, targs: targs })
        return mangle_fn(name, targs)
    }

    // The name of `__eq_<T>`, `==` on the tuple or list type `t`, asked
    // for (MYLA-313).
    fun want_eq(var self, t: Type) -> str {
        self.wants.push(Want { kind: 7, t: t, clone: false })
        return type_job_name(Want { kind: 7, t: t, clone: false })
    }
}

// Whether `t` is a float type.
#test(Type.TFloat(32))[true]
#test(Type.TInt(64, true))[false]
fun is_tfloat_ir(t: Type) -> bool {
    return match t {
        Type.TFloat(w) => true,
        _ => false,
    }
}

// `__walkd_<T>` / `__walkr_<T>` (`retain`): release or retain every heap value
// the inline value of type `t` at the address given holds, member by member
// (an enum's by the variant its tag names); a cell or a boxed value is a
// leaf (its count bumped, or its drop routine called), an inline aggregate
// is walked in its turn.
pub fun walk_ir(cg: CodeGen, t: Type, retain: bool, name: str) -> IrFunc {
    var lw = routine(name, None)
    // (the slot read afresh at each use: it lives in a register across the
    // calls, each read that register)
    let sp = lw.new_slot("p", Type.TPtr, 8, 0, false)
    lw.walk_body(cg, sp, t, retain)
    lw.finish(Term.Ret(-1))
    return lw.f
}

impl Lower {
    // A walk over the value of type `t` at the address the slot `sp` holds
    // (see `walk_ir`), on in the block it ends at.
    fun walk_body(var self, cg: CodeGen, sp: int32, t: Type, retain: bool) {
        match t {
            Type.TStruct(n, a) => {
                let info = cg.struct_info(n)
                let sub = cg.type_subst(info.type_params, a)
                var cur = 0
                for f in info.fields {
                    let ft = subst_type(f.ty, sub)
                    self.walk_member(cg, self.read_ptr(sp), cur, ft, retain)
                    cur = cur + cg.stored_size(ft)
                }
            },
            Type.TTuple(es) => {
                var cur = 0
                for et in es {
                    self.walk_member(cg, self.read_ptr(sp), cur, et, retain)
                    cur = cur + cg.stored_size(et)
                }
            },
            Type.TEnum(n, a) => {
                let info = cg.enum_info(n)
                let sub = cg.type_subst(info.type_params, a)
                let i64 = Type.TInt(64, true)
                let tag = self.temp(i64)
                self.add(Inst.LoadAt(tag, self.read_ptr(sp), 0, 8))
                let done = self.new_block()
                var idx = 0
                for v in info.variants {
                    if cg.variant_owns(v, sub) {
                        let is_v = self.temp(Type.TBool)
                        self.add(Inst.Cmp(is_v, "==", i64, tag, self.konst(i64, idx as int64)))
                        let this_v = self.new_block()
                        let next_v = self.new_block()
                        self.finish(Term.Br(is_v, this_v, next_v))
                        self.start(this_v)
                        var cur = 8
                        for ft0 in v.payload {
                            let ft = subst_type(ft0, sub)
                            self.walk_member(cg, self.read_ptr(sp), cur, ft, retain)
                            cur = cur + cg.stored_size(ft)
                        }
                        self.finish(Term.Jmp(done))
                        self.start(next_v)
                    }
                    idx = idx + 1
                }
                self.finish(Term.Jmp(done))
                self.start(done)
            },
            _ => {},
        }
    }
}

impl Lower {
    // The pointer the slot `sp` holds, read into a new temporary.
    fun read_ptr(var self, sp: int32) -> int32 {
        let t = self.temp(Type.TPtr)
        self.add(Inst.Load(t, sp))
        return t
    }

    // A walk's action on the member of type `ft` at `off` in the value at `p`.
    fun walk_member(var self, cg: CodeGen, p: int32, off: int32, ft: Type, retain: bool) {
        if cg.is_boxed(ft) || is_cell_t(ft) {
            let v = self.temp(ft)
            self.add(Inst.LoadAt(v, p, off, 8))
            if retain { self.add(Inst.RetainVal(ft, v)) } else { self.add(Inst.DropVal(ft, v)) }
        } else if is_tfunc(ft) || cg.owns_heap(ft) {
            if retain { self.add(Inst.Retain(ft, self.offset(p, off))) } else { self.add(Inst.DropAt(ft, self.offset(p, off))) }
        }
    }
}

// A drop routine's entry: the cell's count down by one (`atomic`: an
// actor's, which threads share, D92); at 0, its slow path `slow` in place of
// it (a tail call), else nothing more. Its fast path makes no call, so it
// sets up no frame.
pub fun drop_entry_ir(name: str, slow: str, atomic: bool) -> IrFunc {
    var lw = routine(name, None)
    let sp = lw.new_slot("cell", Type.TInt(64, true), 8, 0, false)
    let zero = lw.temp(Type.TBool)
    var dec = Intrinsic.RcDec
    if atomic { dec = Intrinsic.RcDecAtomic }
    lw.add(Inst.Intr(zero, dec, [lw.read_cell(sp)]))
    let gone = lw.new_block()
    let kept = lw.new_block()
    lw.finish(Term.Br(zero, gone, kept))
    lw.start(gone)
    lw.add(Inst.Call(-1, slow, [lw.read_cell(sp)]))
    lw.finish(Term.Become)
    lw.start(kept)
    lw.finish(Term.Ret(-1))
    return lw.f
}

// A boxed enum's (`walk`: its release walk) or an actor's (`actor`, its
// fields as a struct's) cell whose count reached 0: what it holds released,
// then the cell freed (`free`: std.rt's, or "" for the runtime's `__free`;
// `kind`: `drop_guard`'s).
pub fun dropb_slow_ir(cg: CodeGen, t: Type, walk: str, name: str, free: str, kind: int32) -> IrFunc {
    var lw = routine(name, None)
    let sp = lw.new_slot("cell", Type.TInt(64, true), 8, 0, false)
    let guarded = lw.drop_guard(sp, kind)
    if walk != "" {
        // the enum's release walk in place, no call to it
        lw.walk_body(cg, sp, t, false)
    } else {
        lw.add(Inst.DropAt(t, lw.read_cell(sp)))
    }
    lw.drop_guard_end(sp, free, guarded)
    return lw.f
}

// A list's cell (elements of type `et`) whose count reached 0: each element
// released, then the cell freed (`kind`: `drop_guard`'s).
pub fun list_drop_slow_ir(cg: CodeGen, et: Type, name: str, free: str, kind: int32) -> IrFunc {
    var lw = routine(name, None)
    let sp = lw.new_slot("cell", Type.TInt(64, true), 8, 0, false)
    let guarded = lw.drop_guard(sp, kind)
    if cg.owns_heap(et) || cg.is_boxed(et) {
        let stride = cg.stored_size(et)
        let i64 = Type.TInt(64, true)
        let si = lw.new_slot("i", i64, 8, -1, false)
        let sn = lw.new_slot("n", i64, 8, -1, false)
        lw.add(Inst.Store(si, lw.int_const(0)))
        let n = lw.temp(i64)
        lw.add(Inst.LoadAt(n, lw.read_cell(sp), 0, 8))
        lw.add(Inst.Store(sn, n))
        let body = lw.new_block()
        let done = lw.new_block()
        lw.count_test(si, sn, body, done)
        lw.start(body)
        // the element's address: cell + 16 + i * stride
        let i = lw.temp(i64)
        lw.add(Inst.Load(i, si))
        let scaled = lw.temp(i64)
        lw.add(Inst.Bin(scaled, "*", i64, i64, i, lw.int_const(stride), Pos { line: 0, col: 0 }))
        let at = lw.temp(i64)
        lw.add(Inst.Bin(at, "+", i64, i64, lw.read_cell(sp), scaled, Pos { line: 0, col: 0 }))
        lw.drop_member(cg, at, 16, et)
        let i2 = lw.temp(i64)
        lw.add(Inst.Load(i2, si))
        let i3 = lw.temp(i64)
        lw.add(Inst.Bin(i3, "+", i64, i64, i2, lw.int_const(1), Pos { line: 0, col: 0 }))
        lw.add(Inst.Store(si, i3))
        lw.count_test(si, sn, body, done)
        lw.start(done)
    }
    lw.drop_guard_end(sp, free, guarded)
    return lw.f
}

// A map's cell (`mt`) whose count reached 0: each occupied slot's key and
// value released, then the cell freed (`kind`: `drop_guard`'s).
pub fun map_drop_slow_ir(cg: CodeGen, mt: Type, name: str, free: str, kind: int32) -> IrFunc {
    var lw = routine(name, None)
    let sp = lw.new_slot("cell", Type.TInt(64, true), 8, 0, false)
    let guarded = lw.drop_guard(sp, kind)
    let kt = map_key(mt)
    let vt = map_val(mt)
    if cg.owns_heap(kt) || cg.owns_heap(vt) {
        let ss = cg.map_slot_size(mt)
        let i64 = Type.TInt(64, true)
        let si = lw.new_slot("i", i64, 8, -1, false)
        let sn = lw.new_slot("n", i64, 8, -1, false)
        lw.add(Inst.Store(si, lw.int_const(0)))
        let n = lw.temp(i64)
        lw.add(Inst.LoadAt(n, lw.read_cell(sp), 8, 8))
        lw.add(Inst.Store(sn, n))
        let body = lw.new_block()
        let next = lw.new_block()
        let done = lw.new_block()
        lw.count_test(si, sn, body, done)
        lw.start(body)
        let i = lw.temp(i64)
        lw.add(Inst.Load(i, si))
        let scaled = lw.temp(i64)
        lw.add(Inst.Bin(scaled, "*", i64, i64, i, lw.int_const(ss), Pos { line: 0, col: 0 }))
        let at = lw.temp(i64)
        lw.add(Inst.Bin(at, "+", i64, i64, lw.read_cell(sp), scaled, Pos { line: 0, col: 0 }))
        let state = lw.temp(i64)
        lw.add(Inst.LoadAt(state, at, 16, 8))
        let full = lw.temp(Type.TBool)
        lw.add(Inst.Cmp(full, "==", i64, state, lw.int_const(1)))
        let occupied = lw.new_block()
        lw.finish(Term.Br(full, occupied, next))
        lw.start(occupied)
        if cg.owns_heap(kt) { lw.drop_member(cg, at, 16 + cg.map_key_off(mt), kt) }
        if cg.owns_heap(vt) {
            // (the slot's address again: a key's drop is a call)
            let i4 = lw.temp(i64)
            lw.add(Inst.Load(i4, si))
            let sc4 = lw.temp(i64)
            lw.add(Inst.Bin(sc4, "*", i64, i64, i4, lw.int_const(ss), Pos { line: 0, col: 0 }))
            let at4 = lw.temp(i64)
            lw.add(Inst.Bin(at4, "+", i64, i64, lw.read_cell(sp), sc4, Pos { line: 0, col: 0 }))
            lw.drop_member(cg, at4, 16 + cg.map_val_off(mt), vt)
        }
        lw.finish(Term.Jmp(next))
        lw.start(next)
        let i2 = lw.temp(i64)
        lw.add(Inst.Load(i2, si))
        let i3 = lw.temp(i64)
        lw.add(Inst.Bin(i3, "+", i64, i64, i2, lw.int_const(1), Pos { line: 0, col: 0 }))
        lw.add(Inst.Store(si, i3))
        lw.count_test(si, sn, body, done)
        lw.start(done)
    }
    lw.drop_guard_end(sp, free, guarded)
    return lw.f
}

// How many guarded releases may run inside one another on a worker before
// the next cell is deferred (MYLA-389): a few frames each, so a few hundred
// frames at most, however deep the value.
const DROP_DEPTH: int32 = 64

// `__drop_drain` (MYLA-389): this worker's deferred cells released, the
// last deferred first, each by its kind's release routine (the table
// `__drop_routines` lists), with the depth 1, so a routine it calls defers
// again past DROP_DEPTH but never drains itself; until none is left.
pub fun drop_drain_ir() -> IrFunc {
    var lw = routine("__drop_drain", None)
    let i64 = Type.TInt(64, true)
    let u64 = Type.TInt(64, false)
    let sc = lw.new_slot("cell", i64, 8, -1, false)
    let look = lw.new_block()
    let one = lw.new_block()
    let done = lw.new_block()
    lw.finish(Term.Jmp(look))
    lw.start(look)
    let head = lw.temp(i64)
    lw.add(Inst.Intr(head, Intrinsic.RtAddr("__drop_defer"), []))
    let c = lw.temp(i64)
    lw.add(Inst.LoadAt(c, head, 0, 8))
    lw.add(Inst.Store(sc, c))
    let empty = lw.temp(Type.TBool)
    lw.add(Inst.Cmp(empty, "==", i64, c, lw.int_const(0)))
    lw.finish(Term.Br(empty, done, one))
    lw.start(one)
    let word = lw.temp(i64)
    lw.add(Inst.LoadAt(word, lw.read_cell(sc), -8, 8))
    // (a logical shift: an address may use the word's top bit)
    let next = lw.temp(i64)
    lw.add(Inst.Bin(next, ">>", u64, u64, word, lw.int_const(16), Pos { line: 0, col: 0 }))
    lw.store_rt_var("__drop_defer", next, 8)
    let kind = lw.temp(i64)
    lw.add(Inst.Bin(kind, "&", i64, i64, word, lw.int_const(65535), Pos { line: 0, col: 0 }))
    // its count word as a dead cell's: 0
    lw.add(Inst.StoreAt(lw.read_cell(sc), -8, lw.int_const(0), 8))
    lw.store_rt_var("__drop_depth", lw.int_const(1), 8)
    let table = lw.temp(i64)
    lw.add(Inst.Intr(table, Intrinsic.RtAddr("__drop_routines"), []))
    let off = lw.temp(i64)
    lw.add(Inst.Bin(off, "<<", i64, i64, kind, lw.int_const(3), Pos { line: 0, col: 0 }))
    let entry = lw.temp(i64)
    lw.add(Inst.Bin(entry, "+", i64, i64, table, off, Pos { line: 0, col: 0 }))
    let code = lw.temp(i64)
    lw.add(Inst.LoadAt(code, entry, 0, 8))
    let r = lw.temp(i64)
    lw.add(Inst.Intr(r, Intrinsic.CallCode, [code, lw.read_cell(sc)]))
    lw.store_rt_var("__drop_depth", lw.int_const(0), 8)
    lw.finish(Term.Jmp(look))
    lw.start(done)
    lw.finish(Term.Ret(-1))
    return lw.f
}

impl Lower {
    // The cell the slot `sp` holds (as an integer), read into a new temporary.
    fun read_cell(var self, sp: int32) -> int32 {
        let t = self.temp(Type.TInt(64, true))
        self.add(Inst.Load(t, sp))
        return t
    }

    // The block ended with `i < n` (both slots): on to `yes` or `no`.
    fun count_test(var self, si: int32, sn: int32, yes: int32, no: int32) {
        let i64 = Type.TInt(64, true)
        let i = self.temp(i64)
        self.add(Inst.Load(i, si))
        let n = self.temp(i64)
        self.add(Inst.Load(n, sn))
        let c = self.temp(Type.TBool)
        self.add(Inst.Cmp(c, "<", i64, i, n))
        self.finish(Term.Br(c, yes, no))
    }

    // The member of type `ft` at `off` from the address `at` released (a
    // cell's or boxed value's drop routine, or what an inline value holds).
    fun drop_member(var self, cg: CodeGen, at: int32, off: int32, ft: Type) {
        if cg.is_boxed(ft) || is_cell_t(ft) {
            let v = self.temp(ft)
            self.add(Inst.LoadAt(v, at, off, 8))
            self.add(Inst.DropVal(ft, v))
        } else if is_tfunc(ft) || cg.owns_heap(ft) {
            let p = self.temp(Type.TInt(64, true))
            self.add(Inst.Bin(p, "+", Type.TInt(64, true), Type.TInt(64, true), at, self.int_const(off), Pos { line: 0, col: 0 }))
            self.add(Inst.DropAt(ft, p))
        }
    }

    // A release routine's guard (MYLA-389), for a cell whose type can hold
    // cells of its own type without bound (`CodeGen.drop_reenters`; `kind`
    // its place in `__drop_routines`, else -1 for no guard): past DROP_DEPTH
    // releases inside one another on this worker, the cell goes on the
    // worker's deferred cells (`__drop_defer`, linked through their count
    // words, now unused, as `next << 16 | kind`) and the routine returns;
    // else the depth (`__drop_depth`) is one more until `drop_guard_end`.
    // So a value nested a million deep is released in a bounded stack, on
    // every target. Whether it guards.
    fun drop_guard(var self, sp: int32, kind: int32) -> bool {
        if kind < 0 { return false }
        let i64 = Type.TInt(64, true)
        let at = self.temp(i64)
        self.add(Inst.Intr(at, Intrinsic.RtAddr("__drop_depth"), []))
        let d = self.temp(i64)
        self.add(Inst.LoadAt(d, at, 0, 8))
        let deep = self.temp(Type.TBool)
        self.add(Inst.Cmp(deep, ">=", i64, d, self.int_const(DROP_DEPTH)))
        let later = self.new_block()
        let now = self.new_block()
        self.finish(Term.Br(deep, later, now))
        self.start(later)
        let head = self.temp(i64)
        self.add(Inst.Intr(head, Intrinsic.RtAddr("__drop_defer"), []))
        let next = self.temp(i64)
        self.add(Inst.LoadAt(next, head, 0, 8))
        let up = self.temp(i64)
        self.add(Inst.Bin(up, "<<", i64, i64, next, self.int_const(16), Pos { line: 0, col: 0 }))
        let word = self.temp(i64)
        self.add(Inst.Bin(word, "|", i64, i64, up, self.int_const(kind), Pos { line: 0, col: 0 }))
        self.add(Inst.StoreAt(self.read_cell(sp), -8, word, 8))
        self.add(Inst.StoreAt(head, 0, self.read_cell(sp), 8))
        self.finish(Term.Ret(-1))
        self.start(now)
        self.depth_by(1)
        return true
    }

    // `__drop_depth` plus `n`; the new depth.
    fun depth_by(var self, n: int32) -> int32 {
        let i64 = Type.TInt(64, true)
        let at = self.temp(i64)
        self.add(Inst.Intr(at, Intrinsic.RtAddr("__drop_depth"), []))
        let d = self.temp(i64)
        self.add(Inst.LoadAt(d, at, 0, 8))
        let d1 = self.temp(i64)
        self.add(Inst.Bin(d1, "+", i64, i64, d, self.int_const(n), Pos { line: 0, col: 0 }))
        self.add(Inst.StoreAt(at, 0, d1, 8))
        return d1
    }

    // A release routine's end, the cell freed (a tail call); with a guard
    // (`guarded`), the depth one less first, and when cells were deferred
    // and the depth is back at 0, they are released (`__drop_drain`). (The
    // deferred cells are looked at first: there are rarely any.)
    fun drop_guard_end(var self, sp: int32, free: str, guarded: bool) {
        if guarded {
            let i64 = Type.TInt(64, true)
            let d0 = self.depth_by(-1)
            let head = self.temp(i64)
            self.add(Inst.Intr(head, Intrinsic.RtAddr("__drop_defer"), []))
            let first = self.temp(i64)
            self.add(Inst.LoadAt(first, head, 0, 8))
            let some = self.temp(Type.TBool)
            self.add(Inst.Cmp(some, "!=", i64, first, self.int_const(0)))
            let look = self.new_block()
            let drain = self.new_block()
            let done = self.new_block()
            self.finish(Term.Br(some, look, done))
            self.start(look)
            let at = self.temp(i64)
            self.add(Inst.Intr(at, Intrinsic.RtAddr("__drop_depth"), []))
            let d = self.temp(i64)
            self.add(Inst.LoadAt(d, at, 0, 8))
            let top = self.temp(Type.TBool)
            self.add(Inst.Cmp(top, "==", i64, d, self.int_const(0)))
            self.finish(Term.Br(top, drain, done))
            self.start(drain)
            self.add(Inst.Call(-1, "__drop_drain", []))
            self.finish(Term.Jmp(done))
            self.start(done)
        }
        self.free_cell(sp, free)
    }

    // The cell in the slot `sp` freed in place of the routine (std.rt's
    // `free`, a tail call), or by the runtime's `__free` (`free` "").
    fun free_cell(var self, sp: int32, free: str) {
        if free != "" {
            self.add(Inst.Call(-1, free, [self.read_cell(sp)]))
            self.finish(Term.Become)
        } else {
            self.add(Inst.Rt(-1, "__free", [self.read_cell(sp)]))
            self.finish(Term.Ret(-1))
        }
    }
}

// A copy-on-write clone (`__clone_list_<E>`, `__clone_map_<K>_<V>`,
// `__sb_clone`; `t` the list's, map's or builder's type): the shared cell
// given copied into a new one (count 1), each element or occupied slot it
// now shares retained, the original's count down by one (the caller saw it
// above 1); the copy returned.
pub fun clone_ir(cg: CodeGen, t: Type, name: str) -> IrFunc {
    let i64 = Type.TInt(64, true)
    var lw = routine(name, Some(i64))
    let sp = lw.new_slot("cell", i64, 8, 0, false)
    let sc = lw.new_slot("copy", i64, 8, -1, false)
    let size = lw.temp(i64)
    lw.add(Inst.LoadAt(size, lw.read_cell(sp), -16, 8))
    let c = lw.temp(i64)
    lw.add(Inst.Rt(c, "__alloc", [size]))
    lw.add(Inst.Store(sc, c))
    let size2 = lw.temp(i64)
    lw.add(Inst.LoadAt(size2, lw.read_cell(sp), -16, 8))
    lw.add(Inst.Rt(-1, "__copy_bytes", [lw.read_cell(sc), lw.read_cell(sp), size2]))
    match t {
        Type.TList(et) => {
            if cg.owns_heap(et) || cg.is_boxed(et) {
                lw.each_entry(cg, sc, 0, cg.elem_size(et), false, et, Type.TBool, true)
            }
        },
        Type.TMap(kt, vt) => {
            if cg.owns_heap(kt) || cg.owns_heap(vt) {
                lw.each_entry(cg, sc, 8, cg.map_slot_size(t), true, kt, vt, true)
            }
        },
        _ => {},
    }
    lw.add(Inst.Intr(-1, Intrinsic.RcDec, [lw.read_cell(sp)]))
    lw.finish(Term.Ret(lw.read_cell(sc)))
    return lw.f
}

impl Lower {
    // Over the entries of the list or map cell in the slot `sc` (`count_at`:
    // the word holding how many, its length or its capacity; `stride` bytes
    // an entry): a list's element of type `a` retained (`retain`) or
    // released, or a map's occupied slot's key `a` and value `b`.
    fun each_entry(var self, cg: CodeGen, sc: int32, count_at: int32, stride: int32, is_map: bool, a: Type, b: Type, retain: bool) {
        let i64 = Type.TInt(64, true)
        let si = self.new_slot("i", i64, 8, -1, false)
        let sn = self.new_slot("n", i64, 8, -1, false)
        self.add(Inst.Store(si, self.int_const(0)))
        let n = self.temp(i64)
        self.add(Inst.LoadAt(n, self.read_cell(sc), count_at, 8))
        self.add(Inst.Store(sn, n))
        let body = self.new_block()
        let next = self.new_block()
        let done = self.new_block()
        self.count_test(si, sn, body, done)
        self.start(body)
        if is_map {
            let state = self.temp(i64)
            self.add(Inst.LoadAt(state, self.entry_at(sc, si, stride), 16, 8))
            let full = self.temp(Type.TBool)
            self.add(Inst.Cmp(full, "==", i64, state, self.int_const(1)))
            let occupied = self.new_block()
            self.finish(Term.Br(full, occupied, next))
            self.start(occupied)
            if cg.owns_heap(a) { self.entry_member(cg, self.entry_at(sc, si, stride), 16 + cg.map_key_off(Type.TMap(a, b)), a, retain) }
            if cg.owns_heap(b) { self.entry_member(cg, self.entry_at(sc, si, stride), 16 + cg.map_val_off(Type.TMap(a, b)), b, retain) }
        } else {
            self.entry_member(cg, self.entry_at(sc, si, stride), 16, a, retain)
        }
        self.finish(Term.Jmp(next))
        self.start(next)
        let i2 = self.temp(i64)
        self.add(Inst.Load(i2, si))
        let i3 = self.temp(i64)
        self.add(Inst.Bin(i3, "+", i64, i64, i2, self.int_const(1), Pos { line: 0, col: 0 }))
        self.add(Inst.Store(si, i3))
        self.count_test(si, sn, body, done)
        self.start(done)
    }

    // The cell in `sc` plus the index in `si` times `stride`.
    fun entry_at(var self, sc: int32, si: int32, stride: int32) -> int32 {
        let i64 = Type.TInt(64, true)
        let i = self.temp(i64)
        self.add(Inst.Load(i, si))
        let scaled = self.temp(i64)
        self.add(Inst.Bin(scaled, "*", i64, i64, i, self.int_const(stride), Pos { line: 0, col: 0 }))
        let at = self.temp(i64)
        self.add(Inst.Bin(at, "+", i64, i64, self.read_cell(sc), scaled, Pos { line: 0, col: 0 }))
        return at
    }

    // The member of type `ft` at `off` from `at` retained or released.
    fun entry_member(var self, cg: CodeGen, at: int32, off: int32, ft: Type, retain: bool) {
        if !retain {
            self.drop_member(cg, at, off, ft)
            return
        }
        if cg.is_boxed(ft) || is_cell_t(ft) {
            let v = self.temp(ft)
            self.add(Inst.LoadAt(v, at, off, 8))
            self.add(Inst.RetainVal(ft, v))
        } else if is_tfunc(ft) || cg.owns_heap(ft) {
            let p = self.temp(Type.TInt(64, true))
            self.add(Inst.Bin(p, "+", Type.TInt(64, true), Type.TInt(64, true), at, self.int_const(off), Pos { line: 0, col: 0 }))
            self.add(Inst.Retain(ft, p))
        }
    }
}

// The deep walk (`__deepw_<T>`, or `inline`: `__deepi_<E>`, a boxed enum's
// cell contents; a boxed enum's value is those contents either way) of the
// value at the address given: each member made a deep
// copy of its own (`clone`: a clone of it; D92). An actor handle stays
// shared, a clone taking a reference of its own.
pub fun deep_walk_ir(cg: CodeGen, t: Type, clone: bool, inline: bool, name: str) -> Routine {
    var lw = routine(name, None)
    let sp = lw.new_slot("p", Type.TInt(64, true), 8, 0, false)
    match t {
        Type.TStruct(n, a) => {
            let info = cg.struct_info(n)
            let sub = cg.type_subst(info.type_params, a)
            var cur = 0
            for f in info.fields {
                let ft = subst_type(f.ty, sub)
                lw.deep_member(cg, sp, cur, ft, clone)
                cur = cur + cg.stored_size(ft)
            }
        },
        Type.TTuple(es) => {
            var cur = 0
            for et in es {
                lw.deep_member(cg, sp, cur, et, clone)
                cur = cur + cg.stored_size(et)
            }
        },
        Type.TEnum(n, a) => {
            // a boxed enum held in a slot, a frame or an environment is its
            // cell's contents, inline, as `__walkr_` reads it: the same walk
            // as a cell's (H3); only a member of one is the box's address
            let info = cg.enum_info(n)
            let sub = cg.type_subst(info.type_params, a)
            let i64 = Type.TInt(64, true)
            let tag = lw.temp(i64)
            lw.add(Inst.LoadAt(tag, lw.read_cell(sp), 0, 8))
            let done = lw.new_block()
            var idx = 0
            for v in info.variants {
                if cg.variant_owns(v, sub) {
                    let is_v = lw.temp(Type.TBool)
                    lw.add(Inst.Cmp(is_v, "==", i64, tag, lw.konst(i64, idx as int64)))
                    let this_v = lw.new_block()
                    let next_v = lw.new_block()
                    lw.finish(Term.Br(is_v, this_v, next_v))
                    lw.start(this_v)
                    var cur = 8
                    for ft0 in v.payload {
                        let ft = subst_type(ft0, sub)
                        lw.deep_member(cg, sp, cur, ft, clone)
                        cur = cur + cg.stored_size(ft)
                    }
                    lw.finish(Term.Jmp(done))
                    lw.start(next_v)
                }
                idx = idx + 1
            }
            lw.finish(Term.Jmp(done))
            lw.start(done)
        },
        _ => { lw.deep_member(cg, sp, 0, t, clone) },
    }
    lw.finish(Term.Ret(-1))
    return Routine { f: lw.f, wants: lw.wants }
}

// The deep copy of a cell of type `t` (`__deep_list_<E>`, `__deep_map_`,
// `__deepb_<E>`, `__deep_sb`; the cell given, one reference, consumed): the
// same cell when it was the only reference, else a copy (its members
// retained, the original's count down); then each member a deep copy of its
// own. `clone`: a copy word for word, then each member cloned; the cell
// given only read.
pub fun deep_cell_ir(cg: CodeGen, t: Type, clone: bool, name: str) -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine(name, Some(i64))
    let sp = lw.new_slot("cell", i64, 8, 0, false)
    let sc = lw.new_slot("unique", i64, 8, -1, false)
    lw.add(Inst.Store(sc, lw.read_cell(sp)))
    let deepen = lw.new_block()
    if clone {
        lw.copy_cell(sp, sc)
        lw.finish(Term.Jmp(deepen))
    } else {
        let rc = lw.temp(i64)
        lw.add(Inst.LoadAt(rc, lw.read_cell(sp), -8, 8))
        let only = lw.temp(Type.TBool)
        lw.add(Inst.Cmp(only, "==", i64, rc, lw.int_const(1)))
        let shared = lw.new_block()
        lw.finish(Term.Br(only, deepen, shared))
        lw.start(shared)
        match t {
            Type.TList(e) => { lw.clone_call(cg, t, sp, sc) },
            Type.TMap(k, v) => { lw.clone_call(cg, t, sp, sc) },
            _ => {
                if is_sb_t(t) {
                    lw.clone_call(cg, t, sp, sc)
                } else {
                    // a boxed enum: a copy of the box, what it holds retained
                    lw.copy_cell(sp, sc)
                    lw.add(Inst.Retain(t, lw.read_cell(sc)))
                    lw.add(Inst.Intr(-1, Intrinsic.RcDec, [lw.read_cell(sp)]))
                }
            },
        }
        lw.finish(Term.Jmp(deepen))
    }
    lw.start(deepen)
    match t {
        Type.TList(e) => {
            if cg.owns_heap(e) || cg.is_boxed(e) { lw.deep_entries(cg, sc, 0, cg.stored_size(e), false, e, Type.TBool, clone) }
        },
        Type.TMap(k, v) => {
            if cg.owns_heap(k) || cg.owns_heap(v) { lw.deep_entries(cg, sc, 8, cg.map_slot_size(t), true, k, v, clone) }
        },
        _ => {
            if !is_sb_t(t) {
                lw.wants.push(Want { kind: 2, t: t, clone: clone })
                lw.add(Inst.Rt(-1, cg.deep_walk_label(t, clone, true), [lw.read_cell(sc)]))
            }
        },
    }
    lw.finish(Term.Ret(lw.read_cell(sc)))
    return Routine { f: lw.f, wants: lw.wants }
}

impl Lower {
    // A copy of the cell in `sp` (as large as allocated) into `sc`.
    fun copy_cell(var self, sp: int32, sc: int32) {
        let i64 = Type.TInt(64, true)
        let size = self.temp(i64)
        self.add(Inst.LoadAt(size, self.read_cell(sp), -16, 8))
        let c = self.temp(i64)
        self.add(Inst.Rt(c, "__alloc", [size]))
        self.add(Inst.Store(sc, c))
        let size2 = self.temp(i64)
        self.add(Inst.LoadAt(size2, self.read_cell(sp), -16, 8))
        self.add(Inst.Rt(-1, "__copy_bytes", [self.read_cell(sc), self.read_cell(sp), size2]))
    }

    // The copy-on-write clone of the cell in `sp` (type `t`) into `sc`.
    fun clone_call(var self, cg: CodeGen, t: Type, sp: int32, sc: int32) {
        self.wants.push(Want { kind: 3, t: t, clone: false })
        let c = self.temp(Type.TInt(64, true))
        self.add(Inst.Rt(c, cg.clone_call_name(t), [self.read_cell(sp)]))
        self.add(Inst.Store(sc, c))
    }

    // Each list element or occupied map slot of the cell in `sc` made deep
    // (see `each_entry`).
    fun deep_entries(var self, cg: CodeGen, sc: int32, count_at: int32, stride: int32, is_map: bool, a: Type, b: Type, clone: bool) {
        let i64 = Type.TInt(64, true)
        let si = self.new_slot("i", i64, 8, -1, false)
        let sn = self.new_slot("n", i64, 8, -1, false)
        let se = self.new_slot("entry", i64, 8, -1, false)
        self.add(Inst.Store(si, self.int_const(0)))
        let n = self.temp(i64)
        self.add(Inst.LoadAt(n, self.read_cell(sc), count_at, 8))
        self.add(Inst.Store(sn, n))
        let body = self.new_block()
        let next = self.new_block()
        let done = self.new_block()
        self.count_test(si, sn, body, done)
        self.start(body)
        self.add(Inst.Store(se, self.entry_at(sc, si, stride)))
        if is_map {
            let state = self.temp(i64)
            self.add(Inst.LoadAt(state, self.read_cell(se), 16, 8))
            let full = self.temp(Type.TBool)
            self.add(Inst.Cmp(full, "==", i64, state, self.int_const(1)))
            let occupied = self.new_block()
            self.finish(Term.Br(full, occupied, next))
            self.start(occupied)
            if cg.owns_heap(a) { self.deep_member(cg, se, 16 + cg.map_key_off(Type.TMap(a, b)), a, clone) }
            if cg.owns_heap(b) { self.deep_member(cg, se, 16 + cg.map_val_off(Type.TMap(a, b)), b, clone) }
        } else {
            self.deep_member(cg, se, 16, a, clone)
        }
        self.finish(Term.Jmp(next))
        self.start(next)
        let i2 = self.temp(i64)
        self.add(Inst.Load(i2, si))
        let i3 = self.temp(i64)
        self.add(Inst.Bin(i3, "+", i64, i64, i2, self.int_const(1), Pos { line: 0, col: 0 }))
        self.add(Inst.Store(si, i3))
        self.count_test(si, sn, body, done)
        self.start(done)
    }

    // The member of type `ft` at `off` from the address in the slot `sp` made
    // a deep copy (`clone`: a clone) of its own, stored back.
    fun deep_member(var self, cg: CodeGen, sp: int32, off: int32, ft: Type, clone: bool) {
        let i64 = Type.TInt(64, true)
        if is_actor_t(ft) {
            if clone {
                let v = self.temp(ft)
                self.add(Inst.LoadAt(v, self.read_cell(sp), off, 8))
                self.add(Inst.RetainVal(ft, v))
            }
            return
        }
        if cg.is_boxed(ft) || is_cell_t(ft) {
            let v = self.temp(i64)
            self.add(Inst.LoadAt(v, self.read_cell(sp), off, 8))
            let r = self.temp(i64)
            if !is_str_t(ft) { self.wants.push(Want { kind: 0, t: ft, clone: clone }) }
            // (a routine is called by the name its alias gives it)
            self.add(Inst.Rt(r, cg.deep_cell_label(ft, clone), [v]))
            self.add(Inst.StoreAt(self.read_cell(sp), off, r, 8))
        } else if is_tfunc(ft) {
            let env = self.temp(i64)
            self.add(Inst.LoadAt(env, self.read_cell(sp), off + 8, 8))
            let r = self.temp(i64)
            var nm = "__deep_env"
            if clone { nm = "__dclone_env" }
            self.add(Inst.Rt(r, nm, [env]))
            self.add(Inst.StoreAt(self.read_cell(sp), off + 8, r, 8))
        } else if cg.owns_heap(ft) {
            self.wants.push(Want { kind: 1, t: ft, clone: clone })
            let p = self.temp(i64)
            self.add(Inst.Bin(p, "+", i64, i64, self.read_cell(sp), self.int_const(off), Pos { line: 0, col: 0 }))
            self.add(Inst.Rt(-1, cg.deep_walk_label(ft, clone, false), [p]))
        }
    }
}

// `myla_<lifted>_env_drop`: a lambda's or partial application's environment
// released at its count's end (`__func_drop`): each capture it owns (`owned`,
// held inline: a boxed enum as its value) released, then the cell freed.
pub fun env_drop_ir(cg: CodeGen, lifted: str, owned: [DropEntry], free: str) -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine(lifted + "_env_drop", None)
    let sp = lw.new_slot("env", i64, 8, 0, false)
    for d in owned {
        if is_cell_t(d.ty) {
            let v = lw.temp(d.ty)
            lw.add(Inst.LoadAt(v, lw.read_cell(sp), d.off, 8))
            lw.add(Inst.DropVal(d.ty, v))
        } else if is_tfunc(d.ty) {
            let e = lw.temp(i64)
            lw.add(Inst.LoadAt(e, lw.read_cell(sp), d.off + 8, 8))
            lw.add(Inst.Rt(-1, "__func_drop", [e]))
        } else if cg.owns_heap(d.ty) {
            let p = lw.temp(i64)
            lw.add(Inst.Bin(p, "+", i64, i64, lw.read_cell(sp), lw.int_const(d.off), Pos { line: 0, col: 0 }))
            if cg.is_boxed(d.ty) {
                lw.wants.push(Want { kind: 4, t: d.ty, clone: false })
                lw.add(Inst.Rt(-1, cg.walk_label(d.ty, false), [p]))
            } else {
                lw.add(Inst.DropAt(d.ty, p))
            }
        }
    }
    lw.free_cell(sp, free)
    return Routine { f: lw.f, wants: lw.wants }
}

// `__compose_call(x)` (`l >> r`'s code): its environment holds the two
// function values, a at 8 and b at 24; b(a(x)), b in its place (MYLA-130),
// as IR for every target (MYLA-263).
pub fun compose_ir() -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine("__compose_call", Some(i64))
    let xs = lw.new_slot("x", i64, 8, 0, false)
    let es = lw.new_slot("__env", Type.TPtr, 8, ENV_WORD, false)
    let env = lw.read_cell(es)
    let x = lw.read_cell(xs)
    let a = lw.temp(i64)
    lw.add(Inst.Bin(a, "+", i64, i64, env, lw.int_const(8), Pos { line: 0, col: 0 }))
    let ax = lw.temp(i64)
    lw.add(Inst.CallInd(ax, a, [x]))
    let b = lw.temp(i64)
    lw.add(Inst.Bin(b, "+", i64, i64, env, lw.int_const(24), Pos { line: 0, col: 0 }))
    lw.add(Inst.CallInd(-1, b, [ax]))
    lw.finish(Term.Become)
    return Routine { f: lw.f, wants: lw.wants }
}

// The record of the routines of an environment whose drop function is
// `drop` (MYLA-263): its first word points at it, `[drop, clone, deep]` (the
// clone and the deep copy with tasks, D92, else 0), the same on every
// target. An environment owning nothing shares one (`__free`, and a plain
// cell's copies).
#test("__free")["__env_plain_routines"]
#test("myla_main__lam1_env_drop")["myla_main__lam1_env_routines"]
#test("__compose_env_drop")["myla___compose_env_routines"]
pub fun env_record_of(drop: str) -> str {
    if drop == "__free" { return "__env_plain_routines" }
    if drop == "__compose_env_drop" { return "myla___compose_env_routines" }
    var sb = StringBuilder()
    sb.append(drop, 0, drop.len() - 5)
    return sb.build() + "_routines"
}

// Whether `x`, awaited, is a wait (`__wait_readable`, `__wait_either`) or a
// turn for the others (`__yield`), which a program without tasks doesn't do.
fun waits_without_tasks(x: Expr) -> bool {
    return match x.kind {
        ExprKind.Call(c, a, _) => match c.kind {
            ExprKind.Name(n) => n == "__wait_readable" || n == "__wait_either" || n == "__yield"
            _ => false
        }
        _ => false
    }
}

// `rt name(args)`, or the intrinsic the primitive `name` is (MYLA-264).
#test(1, "__cas64", [2, 3, 4])[Inst.Intr(1, Intrinsic.Cas64, [2, 3, 4])]
#test(1, "__alloc", [2])[Inst.Rt(1, "__alloc", [2])]
fun rt_inst(d: int32, name: str, args: [int32]) -> Inst {
    return match primitive_intrinsic(name) {
        Some(op) => Inst.Intr(d, op, args)
        None => Inst.Rt(d, name, args)
    }
}

// The most words a frame constructor zeroes one store each; a frame with
// more blank words is zeroed by `std.rt.zero_words`.
const FRAME_ZERO_STORES: int32 = 24

// The places of the words not `written`.
#test([true, false, true, false])[[1, 3]]
#test([true])[[]]
fun blank_words(written: [bool]) -> [int32] {
    var out: [int32] = []
    var w = 0
    while w < written.len() {
        if !written[w] { out.push(w) }
        w = w + 1
    }
    return out
}

// `myla_<f>__new(args…)` for the frame function `f` (D90), as IR for every
// target (MYLA-263): a new heap frame (its header, then the slots, zeroed),
// the resume function `f` at its start, each argument copied into its
// parameter's slot with references of its own (an aggregate from the
// address passed; a lambda's environment, held until its captures are
// copied, from `ENV_WORD`); the frame returned.
pub fun frame_new_ir(cg: CodeGen, f: IrFunc, mangled: str) -> Routine {
    let i64 = Type.TInt(64, true)
    let size = frame_size(f)
    let soff = slots_at(f, 0, [])
    var lw = routine(mangled + "__new", Some(i64))
    // its parameters: the words the frame function's take
    var params: [int32] = []
    var i = 0
    while i < f.slots.len() {
        let s = f.slots[i]
        if s.word >= 0 || s.word == ENV_WORD {
            var t = i64
            if s.word == ENV_WORD { t = Type.TPtr }
            params.push(lw.new_slot(s.name, t, 8, s.word, false))
        } else {
            params.push(-1)
        }
        i = i + 1
    }
    let frame = lw.temp(i64)
    lw.add(Inst.Rt(frame, "__alloc", [lw.int_const(size)]))
    // zeroed, but for the words written next (the code and the parameters):
    // a store each in a small frame, a loop in a large one
    var written: [bool] = [true]
    while written.len() < size / 8 { written.push(false) }
    i = 0
    while i < f.slots.len() {
        if params[i] >= 0 {
            var w = 0
            while w < f.slots[i].size / 8 {
                written[soff[i] / 8 + w] = true
                w = w + 1
            }
        }
        i = i + 1
    }
    let blank = blank_words(written)
    if blank.len() > FRAME_ZERO_STORES {
        lw.add(Inst.Call(-1, "std$rt$zero_words", [frame, lw.int_const(size)]))
    } else if blank.len() > 0 {
        let zero = lw.int_const(0)
        for w in blank { lw.add(Inst.StoreAt(frame, w * 8, zero, 8)) }
    }
    let code = lw.temp(i64)
    lw.add(Inst.Label(code, "myla_" + mangled))
    lw.add(Inst.StoreAt(frame, 0, code, 8))
    i = 0
    while i < f.slots.len() {
        let s = f.slots[i]
        if params[i] >= 0 {
            let v = lw.read_cell(params[i])
            if (is_aggregate(s.ty) && s.word >= 0) || cg.owns_heap(s.ty) {
                let at = lw.temp(i64)
                lw.add(Inst.Bin(at, "+", i64, i64, frame, lw.int_const(soff[i]), Pos { line: 0, col: 0 }))
                if is_aggregate(s.ty) && s.word >= 0 {
                    lw.add(Inst.Copy(at, v, s.size))
                } else {
                    lw.add(Inst.StoreAt(at, 0, v, 8))
                }
                if cg.owns_heap(s.ty) { lw.add(Inst.Retain(s.ty, at)) }
            } else {
                lw.add(Inst.StoreAt(frame, soff[i], v, 8))
            }
            if s.word == ENV_WORD { lw.add(Inst.Rt(-1, "__func_retain", [v])) }
        }
        i = i + 1
    }
    lw.finish(Term.Ret(frame))
    return Routine { f: lw.f, wants: lw.wants }
}

// A partial application's function, `myla_<lifted>` (D51, D60), as IR for
// every target (MYLA-263): its parameters the holes (the result's address
// first for an aggregate result), an aggregate as its address; its
// environment (`ENV_WORD`) holds the arguments given (`job.slots`: each
// argument's offset in it, -1 for a hole; `job.aggs`: an aggregate, passed
// by its address there), or the function value called (`job.fn_off`). The
// target called with all of them: a parameter it takes by value (D88)
// gets a copy of its own (its words, what they own retained), one it takes
// owned a reference of its own (MYLA-127). In its place (`become`) when the
// words fit where they came (no more than six, or than it got), so a
// `become` through one keeps the stack flat (MYLA-130); else a call.
pub fun partial_ir(cg: CodeGen, job: PartialJob) -> Routine {
    let i64 = Type.TInt(64, true)
    let n = job.slots.len()
    var first = 0
    if job.sret { first = 1 }
    var holes = 0
    for sl in job.slots {
        if sl < 0 { holes = holes + 1 }
    }
    let named = job.fn_off < 0
    var tsig = cg.funcs[0]
    if named { tsig = cg.sig_of(job.target) }
    var ret_t: Option<Type> = Some(i64)
    if job.sret { ret_t = None }
    var lw = routine(job.lifted, ret_t)
    // the words it is called with
    var sret = -1
    if job.sret { sret = lw.new_slot("__sret", i64, 8, 0, false) }
    var hole_slots: [int32] = []
    var h = 0
    while h < holes {
        hole_slots.push(lw.new_slot(format("__hole{}", h), i64, 8, first + h, false))
        h = h + 1
    }
    let env_slot = lw.new_slot("__env", Type.TPtr, 8, ENV_WORD, false)
    // read once, when something comes from it
    var env = -1
    var from_env = !named
    for sl in job.slots {
        if sl >= 0 { from_env = true }
    }
    if from_env { env = lw.read_cell(env_slot) }
    var words: [int32] = []
    if job.sret { words.push(lw.read_cell(sret)) }
    var hi = 0
    var pos = 0
    while pos < n {
        var v = -1
        if job.slots[pos] < 0 {
            v = lw.read_cell(hole_slots[hi])
            hi = hi + 1
        } else if job.aggs[pos] {
            v = lw.temp(i64)
            lw.add(Inst.Bin(v, "+", i64, i64, env, lw.int_const(job.slots[pos]), Pos { line: 0, col: 0 }))
        } else {
            v = lw.temp(i64)
            lw.add(Inst.LoadAt(v, env, job.slots[pos], 8))
        }
        let typed = named && pos < tsig.params.len()
        if typed && cg.byval_param(tsig, pos, tsig.params[pos]) {
            let t = tsig.params[pos]
            lw.add(Inst.Retain(t, v))
            var k = 0
            while k < cg.word_size(t) / 8 {
                let w = lw.temp(i64)
                lw.add(Inst.LoadAt(w, v, 8 * k, 8))
                words.push(w)
                k = k + 1
            }
        } else {
            if typed && cg.owned_param(tsig, pos, tsig.params[pos]) { lw.add(Inst.RetainVal(tsig.params[pos], v)) }
            words.push(v)
        }
        pos = pos + 1
    }
    let in_words = first + holes
    let jumps = words.len() <= 6 || words.len() <= in_words
    // the function value called: its two words in the environment
    var fv = -1
    if !named {
        fv = lw.temp(i64)
        lw.add(Inst.Bin(fv, "+", i64, i64, env, lw.int_const(job.fn_off), Pos { line: 0, col: 0 }))
    }
    var args: [int32] = []
    var k = first
    while k < words.len() {
        args.push(words[k])
        k = k + 1
    }
    if job.sret {
        let r = words[0]
        if named { lw.add(Inst.CallSret(job.target, r, args)) } else { lw.add(Inst.CallIndSret(fv, r, args)) }
        if jumps { lw.finish(Term.Become) } else { lw.finish(Term.Ret(-1)) }
    } else {
        var d = -1
        if !jumps { d = lw.temp(i64) }
        if named { lw.add(Inst.Call(d, job.target, args)) } else { lw.add(Inst.CallInd(d, fv, args)) }
        if jumps { lw.finish(Term.Become) } else { lw.finish(Term.Ret(d)) }
    }
    return Routine { f: lw.f, wants: lw.wants }
}

// `myla_<f>__fnval` of the async function `f`, which has `words` argument
// words: its value makes its frame (D90), so the adapter is a `become` of
// `myla_<f>__new` with the words it got; `__new` takes the references of
// its own. The environment (wasm32's last word, D130) goes unused.
pub fun async_fnval_ir(f: str, words: int32) -> Routine {
    let i64 = Type.TInt(64, true)
    var lw = routine(f + "__fnval", Some(i64))
    var ws: [int32] = []
    var k = 0
    while k < words {
        ws.push(lw.read_cell(lw.new_slot(format("__w{}", k), i64, 8, k, false)))
        k = k + 1
    }
    let env = lw.new_slot("__env", Type.TPtr, 8, ENV_WORD, false)
    lw.add(Inst.Call(-1, f + "__new", ws))
    lw.finish(Term.Become)
    return Routine { f: lw.f, wants: lw.wants }
}

// `myla_<lifted>_env_deep` (`__deep_env`, D92): the environment made unshared
// deeply, the same cell when it was the only reference, else a copy (its
// captures retained, the original's count down), each capture a deep copy
// of its own; `clone` (`_env_clone`, `__dclone_env`): a copy, each capture
// cloned. The cell returned.
pub fun env_deep_ir(cg: CodeGen, lifted: str, owned: [DropEntry], clone: bool) -> Routine {
    let i64 = Type.TInt(64, true)
    var suffix = "_env_deep"
    if clone { suffix = "_env_clone" }
    var lw = routine(lifted + suffix, Some(i64))
    let sp = lw.new_slot("env", i64, 8, 0, false)
    let sc = lw.new_slot("unique", i64, 8, -1, false)
    lw.add(Inst.Store(sc, lw.read_cell(sp)))
    let deepen = lw.new_block()
    if clone {
        lw.copy_cell(sp, sc)
        lw.finish(Term.Jmp(deepen))
    } else {
        let rc = lw.temp(i64)
        lw.add(Inst.LoadAt(rc, lw.read_cell(sp), -8, 8))
        let only = lw.temp(Type.TBool)
        lw.add(Inst.Cmp(only, "==", i64, rc, lw.int_const(1)))
        let shared = lw.new_block()
        lw.finish(Term.Br(only, deepen, shared))
        lw.start(shared)
        lw.copy_cell(sp, sc)
        for d in owned {
            let p = lw.temp(i64)
            lw.add(Inst.Bin(p, "+", i64, i64, lw.read_cell(sc), lw.int_const(d.off), Pos { line: 0, col: 0 }))
            lw.add(Inst.Retain(d.ty, p))
        }
        lw.add(Inst.Intr(-1, Intrinsic.RcDec, [lw.read_cell(sp)]))
        lw.finish(Term.Jmp(deepen))
    }
    lw.start(deepen)
    for d in owned { lw.deep_member(cg, sc, d.off, d.ty, clone) }
    lw.finish(Term.Ret(lw.read_cell(sc)))
    return Routine { f: lw.f, wants: lw.wants }
}

// `acc` with every variable the block may resize or replace (MYLA-251):
// one assigned whole, the receiver of a method other than `len`, the first
// argument of a builtin that changes it (`push`, `pop`, `remove`, ...).
// An element written (`xs[i] = v`, `xs[i].x += 1`) doesn't count: the
// length stays. By name, so a variable shadowing another counts for both;
// lambdas can't change what they capture (D93), but their bodies count too.
#test(block_of("{ xs[i] = 1\n n = xs.len() }"), [])[["n"]]
#test(block_of("{ xs.push(1)\n ys = []\n zs[0].push(2)\n push(ws, 3) }"), [])[["xs", "ys", "ws"]]
fun resized_in_block(b: Block, acc: [str]) -> [str] {
    var out = acc
    for st in b.stmts { out = resized_in_stmt(st, out) }
    return out
}

fun resized_in_stmt(st: Stmt, acc: [str]) -> [str] {
    var out = acc
    match st.kind {
        StmtKind.ExprStmt(e) => { out = resized_in_expr(e, out) },
        StmtKind.VarDecl(k, n, ty, init) => { out = resized_in_expr(init, out) },
        StmtKind.DestructDecl(k, bs, ty, init) => { out = resized_in_expr(init, out) },
        StmtKind.Assign(target, value) => { out = resized_in_expr(value, resized_in_target(target, out)) },
        StmtKind.ReturnS(ov, tail) => { match ov { Some(e) => { out = resized_in_expr(e, out) }, None => {} } },
        StmtKind.IfS(c, then, otherwise) => {
            out = resized_in_block(then, resized_in_expr(c, out))
            match otherwise {
                Some(ElseTail.ElseBlock(eb)) => { out = resized_in_block(eb, out) },
                Some(ElseTail.ElseIf(es)) => { out = resized_in_stmt(es, out) },
                None => {},
            }
        },
        StmtKind.WhileS(c, body) => { out = resized_in_block(body, resized_in_expr(c, out)) },
        StmtKind.ForS(v, start, end, body, iter) => {
            match start { Some(e) => { out = resized_in_expr(e, out) }, None => {} }
            match end { Some(e) => { out = resized_in_expr(e, out) }, None => {} }
            match iter { Some(e) => { out = resized_in_expr(e, out) }, None => {} }
            out = resized_in_block(body, out)
        },
        StmtKind.DeferS(body) => { out = resized_in_block(body, out) },
        _ => {},
    }
    return out
}

// An assignment's target: a variable assigned whole counts, one whose
// element or field is assigned doesn't.
fun resized_in_target(t: Expr, acc: [str]) -> [str] {
    var out = acc
    match t.kind {
        ExprKind.Name(n) => { out.push(n) },
        ExprKind.TupleLit(es) => { for x in es { out = resized_in_target(x, out) } },
        _ => { out = resized_in_part(t, out) },
    }
    return out
}

// A part of a variable an assignment writes to (or the element a method
// changes): its variable isn't resized, the indexes it is reached by are
// read.
fun resized_in_part(t: Expr, acc: [str]) -> [str] {
    var out = acc
    match t.kind {
        ExprKind.Name(n) => {},
        ExprKind.Index(b, i) => { out = resized_in_expr(i, resized_in_part(b, out)) },
        ExprKind.GetField(b, f) => { out = resized_in_part(b, out) },
        ExprKind.TupleIndex(b, i) => { out = resized_in_part(b, out) },
        _ => { out = resized_in_expr(t, out) },
    }
    return out
}

fun resized_in_expr(e: Expr, acc: [str]) -> [str] {
    var out = acc
    match e.kind {
        ExprKind.Call(c, args, _) => {
            match c.kind {
                ExprKind.GetField(recv, m) => {
                    match recv.kind {
                        ExprKind.Name(n) => { if m != "len" { out.push(n) } },
                        _ => { out = resized_in_part(recv, out) },
                    }
                },
                ExprKind.Name(f) => {
                    if is_mutating_builtin(f) && args.len() > 0 {
                        match args[0].kind {
                            ExprKind.Name(n) => { out.push(n) },
                            _ => {},
                        }
                    }
                },
                _ => { out = resized_in_expr(c, out) },
            }
            for a in args { out = resized_in_expr(a, out) }
        },
        ExprKind.Unary(op, x) => { out = resized_in_expr(x, out) },
        ExprKind.Await(x) => { out = resized_in_expr(x, out) },
        ExprKind.Binary(op, l, r) => { out = resized_in_expr(r, resized_in_expr(l, out)) },
        ExprKind.GetField(t, f) => { out = resized_in_expr(t, out) },
        ExprKind.StructLit(n, fields) => { for fi in fields { out = resized_in_expr(fi.value, out) } },
        ExprKind.TupleLit(es) => { for x in es { out = resized_in_expr(x, out) } },
        ExprKind.ListLit(es) => { for x in es { out = resized_in_expr(x, out) } },
        ExprKind.MapLit(entries) => {
            for en in entries { out = resized_in_expr(en.value, resized_in_expr(en.key, out)) }
        },
        ExprKind.TupleIndex(t, i) => { out = resized_in_expr(t, out) },
        ExprKind.Index(t, i) => { out = resized_in_expr(i, resized_in_expr(t, out)) },
        ExprKind.MatchE(sc, arms) => {
            out = resized_in_expr(sc, out)
            for arm in arms {
                match arm.guard { Some(g) => { out = resized_in_expr(g, out) }, None => {} }
                out = resized_in_body(arm.body, out)
            }
        },
        ExprKind.Try(x) => { out = resized_in_expr(x, out) },
        ExprKind.Cast(x, ty) => { out = resized_in_expr(x, out) },
        ExprKind.Lambda(ps, rt, body, asy) => { out = resized_in_body(body, out) },
        _ => {},
    }
    return out
}

fun resized_in_body(b: ExprOrBlock, acc: [str]) -> [str] {
    return match b {
        ExprOrBlock.EB_Expr(x) => resized_in_expr(x, acc),
        ExprOrBlock.EB_Block(blk) => resized_in_block(blk, acc),
    }
}
