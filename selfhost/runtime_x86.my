// runtime_x86.my -- the runtime's x86-64 Linux assembly (MYLA-162, D108).
//
// What of the runtime is still hand-written for this target: the program's
// start (`_start`: the stack limit, the alternate signal stack and the
// stack-overflow handler, the main thread's state block, the workers and
// their rings), the traps and the panic, the system-call and memory
// primitives (`__syscall`, `__syscall5`, `__copy_bytes`, `__equal_bytes`,
// `__str_eq`), the executor's control transfers (starting worker threads,
// the jumps into frames, `__exec_run`), the deep copies of a function
// value's environment (`__deep_env`, `__dclone_env`), composition
// (`__compose_call`), std.math's and the float runtime's primitives. The
// rest of the runtime is std.rt and std.platform, compiled through the IR;
// another target gives this module again.

from .checker import Type
from .codegen import CodeGen, DropEntry, ends_colon, EXEC_CAP, tls_offset, TLS_SIZE, trap_labels
from .lower import drop_entry_ir

impl CodeGen {
    fun emit_runtime_prelude(var self, entry_name: str) {
        self.raw("\t.global _start")
        self.raw("_start:")
        // the main thread's stack may grow to 120 MiB (MYLA-182): Linux grows
        // it up to the soft RLIMIT_STACK, read at each growth, and keeps at
        // least 128 MiB free below it; deep recursion (the self-hosted
        // interpreter takes some 9 KB of stack per interpreted call) then
        // runs where 8 MiB would end in a segfault. prlimit64(0,
        // RLIMIT_STACK), raised to min(120 MiB, the hard limit) when lower
        self.raw("\tsubq $16, %rsp")
        self.raw("\tmovq $302, %rax")
        self.raw("\txorl %edi, %edi")
        self.raw("\tmovl $3, %esi")
        self.raw("\txorl %edx, %edx")
        self.raw("\tmovq %rsp, %r10")
        self.raw("\tsyscall")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjnz .Lstk_done")
        self.raw("\tmovq $125829120, %rcx")
        self.raw("\tcmpq %rcx, (%rsp)")
        self.raw("\tjae .Lstk_done")
        self.raw("\tcmpq %rcx, 8(%rsp)")
        self.raw("\tjae .Lstk_set")
        self.raw("\tmovq 8(%rsp), %rcx")
        self.raw(".Lstk_set:")
        self.raw("\tmovq %rcx, (%rsp)")
        self.raw("\tmovq $302, %rax")
        self.raw("\txorl %edi, %edi")
        self.raw("\tmovl $3, %esi")
        self.raw("\tmovq %rsp, %rdx")
        self.raw("\txorl %r10d, %r10d")
        self.raw("\tsyscall")
        self.raw(".Lstk_done:")
        self.raw("\taddq $16, %rsp")
        // SIGSEGV on an alternate stack (MYLA-182): a fault next to the stack
        // pointer is the main stack running out (past its 120 MiB), reported as
        // `runtime error: stack overflow`; any other fault gets the default action
        // back and happens again. mmap(64 KiB), sigaltstack, rt_sigaction(SIGSEGV,
        // SA_SIGINFO | SA_ONSTACK | SA_RESTORER)
        self.raw("	movq $9, %rax")
        self.raw("	xorl %edi, %edi")
        self.raw("	movl $65536, %esi")
        self.raw("	movl $3, %edx")
        self.raw("	movl $34, %r10d")
        self.raw("	movq $-1, %r8")
        self.raw("	xorl %r9d, %r9d")
        self.raw("	syscall")
        self.raw("	cmpq $-4096, %rax")
        self.raw("	ja .Lsov_done")
        self.raw("	subq $32, %rsp")
        self.raw("	movq %rax, (%rsp)")
        self.raw("	movq $0, 8(%rsp)")
        self.raw("	movq $65536, 16(%rsp)")
        self.raw("	movq $131, %rax")
        self.raw("	movq %rsp, %rdi")
        self.raw("	xorl %esi, %esi")
        self.raw("	syscall")
        self.raw("	leaq __on_segv(%rip), %rax")
        self.raw("	movq %rax, (%rsp)")
        self.raw("	movq $201326596, 8(%rsp)")
        self.raw("	leaq __sig_restorer(%rip), %rax")
        self.raw("	movq %rax, 16(%rsp)")
        self.raw("	movq $0, 24(%rsp)")
        self.raw("	movq $13, %rax")
        self.raw("	movl $11, %edi")
        self.raw("	movq %rsp, %rsi")
        self.raw("	xorl %edx, %edx")
        self.raw("	movl $8, %r10d")
        self.raw("	syscall")
        self.raw("	addq $32, %rsp")
        self.raw(".Lsov_done:")
        if self.frames {
            // the main thread's state block, worker 0's: arch_prctl(
            // ARCH_SET_FS, block), its first word its own address
            self.raw("\tleaq __tls_blocks(%rip), %rsi")
            self.raw("\tmovq %rsi, (%rsi)")
            self.raw("\tmovq $4098, %rdi")
            self.raw("\tmovq $158, %rax")
            self.raw("\tsyscall")
        }
        self.raw("\tmovq (%rsp), %rax")
        self.raw("\tmovq %rax, __argc(%rip)")
        self.raw("\tleaq 8(%rsp), %rcx")
        self.raw("\tmovq %rcx, __argv(%rip)")
        self.raw("\tleaq 16(%rsp,%rax,8), %rcx")
        self.raw("\tmovq %rcx, __envp(%rip)")
        if self.frames {
            // as many workers as `__workers_count` says (it reads the
            // environment); the heap is mapped as they allocate (std.rt,
            // D106)
            self.raw("\tcall __sched_init")
            self.raw("\tcall __workers_count")
            self.raw("\tmovl %eax, __exec_workers(%rip)")
            // their rings of ready frames, EXEC_CAP frames each, reserved
            // for these workers only (D106)
            self.raw("\tmovl %eax, %esi")
            self.raw(format("\timulq ${}, %rsi", 8 * EXEC_CAP))
            self.raw("\tmovq $9, %rax")
            self.raw("\txorq %rdi, %rdi")
            self.raw("\tmovq $3, %rdx")
            self.raw("\tmovq $16418, %r10")
            self.raw("\tmovq $-1, %r8")
            self.raw("\txorq %r9, %r9")
            self.raw("\tsyscall")
            self.raw("\tcmpq $-4096, %rax")
            self.raw("\tja __trap_oom")
            self.raw("\tmovq %rax, __wq_rings(%rip)")
        }
        // with tasks, the other workers (D92)
        if self.frames { self.raw("\tcall __start_workers") }
        if self.frames && self.sig_of(entry_name).decl.is_async {
            // the entry's task: its frame queued, the executor run (D90)
            self.raw(format("\tcall myla_{}__new", entry_name))
            self.raw("\tmovq %rax, __exec_main(%rip)")
            self.raw("\tmovq %rax, 40(%rax)")
            self.raw("\tmovq %rax, %rdi")
            self.raw("\tcall __exec_push")
            self.raw("\tcall __exec_run")
        } else {
            self.raw(format("\tcall myla_{}", entry_name))
        }
        // exit_group: every thread ends (D89 (3))
        self.raw("\tmovq $231, %rax")
        self.raw("\txorq %rdi, %rdi")
        self.raw("\tsyscall")
        self.raw("")
        if self.frames {
            self.emit_executor()
            self.emit_deep_runtime()
        } else {
            // no task but the first: nothing is ever cancelled (D96)
            self.raw("__task_cancelled:")
            self.raw("\txorl %eax, %eax")
            self.raw("\tret")
            self.raw("")
        }
        // Runtime errors: `runtime error: <message>` on stderr, then exit(1)
        // (MYLA-17); the message is the interpreter's, without the values. The
        // caller passes the position record in %rsi; out of memory has none.
        for label in trap_labels() {
            self.raw(format("{}:", label))
            if label == "__trap_oom" { self.raw("\txorl %esi, %esi") }
            self.raw(format("\tleaq .Lmsg{}(%rip), %rdi", label))
            self.raw("\tjmp __panic")
        }
        self.raw("")
        // __on_segv(sig, siginfo, ucontext), on the alternate stack: the fault
        // address (siginfo + 16) within 64 KiB below or 1 MiB above the interrupted
        // %rsp (ucontext + 160) is a stack overflow (MYLA-182), reported once:
        // a worker overflowing after another sleeps until its exit ends the
        // process (MYLA-172)
        self.raw("__on_segv:")
        self.raw("	movq 16(%rsi), %rax")
        self.raw("	movq 160(%rdx), %rcx")
        self.raw("	movq %rcx, %r8")
        self.raw("	subq $65536, %r8")
        self.raw("	cmpq %r8, %rax")
        self.raw("	jb .Lsegv_other")
        self.raw("	movq %rcx, %r8")
        self.raw("	addq $1048576, %r8")
        self.raw("	cmpq %r8, %rax")
        self.raw("	ja .Lsegv_other")
        self.raw("	movl $1, %eax")
        self.raw("	xchgl %eax, __segv_once(%rip)")
        self.raw("	testl %eax, %eax")
        self.raw("	jz .Lsegv_report")
        self.raw(".Lsegv_sleep:")
        self.raw("	movq $34, %rax")
        self.raw("	syscall")
        self.raw("	jmp .Lsegv_sleep")
        self.raw(".Lsegv_report:")
        self.raw("	movq $1, %rax")
        self.raw("	movl $2, %edi")
        self.raw("	leaq .Lmsg_sov(%rip), %rsi")
        self.raw("	movl $30, %edx")
        self.raw("	syscall")
        self.raw("	movq $231, %rax")
        self.raw("	movl $1, %edi")
        self.raw("	syscall")
        self.raw(".Lsegv_other:")
        self.raw("	subq $32, %rsp")
        self.raw("	movq $0, (%rsp)")
        self.raw("	movq $0, 8(%rsp)")
        self.raw("	movq $0, 16(%rsp)")
        self.raw("	movq $0, 24(%rsp)")
        self.raw("	movq $13, %rax")
        self.raw("	movl $11, %edi")
        self.raw("	movq %rsp, %rsi")
        self.raw("	xorl %edx, %edx")
        self.raw("	movl $8, %r10d")
        self.raw("	syscall")
        self.raw("	addq $32, %rsp")
        self.raw("	ret")
        self.raw("__sig_restorer:")
        self.raw("	movq $15, %rax")
        self.raw("	syscall")
        self.raw(".Lmsg_sov:")
        self.raw("	.ascii \"runtime error: stack overflow\\n\"")
        self.raw("")
        // __panic: %rdi -> the message, %rsi -> the position record or 0;
        // reported by std.rt (`panic_report`: `runtime error: <message>`,
        // then `  --> file:line:col`, MYLA-65)
        self.raw("__panic:")
        if self.frames {
            // held for the parent when a task other than the entry's fails
            // (`__task_fail` goes back to the executor then)
            self.raw("\tpushq %rsi")
            self.raw("\tpushq %rdi")
            self.raw("\tmovq %rsi, %rdx")
            self.raw("\tmovq %rdi, %rsi")
            self.raw("\tmovq $2, %rdi")
            self.raw("\tcall __task_fail")
            self.raw("\tpopq %rdi")
            self.raw("\tpopq %rsi")
            self.raw("\tjmp __panic_report_tasks")
        } else {
            self.raw("\tjmp __panic_report")
        }
        self.raw("")
        // __str_eq: the same string, or equal lengths and bytes, compared
        // eight at a time (MYLA-133); %rax = 1 or 0, clobbers %rcx %rdi %rsi
        self.raw("__str_eq:")
        self.raw("\tcmpq %rdi, %rsi")
        self.raw("\tje .Lse_eq")
        self.raw("\tmovq (%rdi), %rcx")
        self.raw("\tcmpq (%rsi), %rcx")
        self.raw("\tjne .Lse_ne")
        self.raw("\tleaq 8(%rdi), %rdi")
        self.raw("\tleaq 8(%rsi), %rsi")
        self.raw(".Lse_words:")
        self.raw("\tcmpq $8, %rcx")
        self.raw("\tjb .Lse_bytes")
        self.raw("\tmovq (%rdi), %rax")
        self.raw("\tcmpq (%rsi), %rax")
        self.raw("\tjne .Lse_ne")
        self.raw("\taddq $8, %rdi")
        self.raw("\taddq $8, %rsi")
        self.raw("\tsubq $8, %rcx")
        self.raw("\tjmp .Lse_words")
        self.raw(".Lse_bytes:")
        self.raw("\ttestq %rcx, %rcx")
        self.raw("\tjz .Lse_eq")
        self.raw("\tmovb (%rdi), %al")
        self.raw("\tcmpb (%rsi), %al")
        self.raw("\tjne .Lse_ne")
        self.raw("\tincq %rdi")
        self.raw("\tincq %rsi")
        self.raw("\tdecq %rcx")
        self.raw("\tjmp .Lse_bytes")
        self.raw(".Lse_eq:")
        self.raw("\tmovq $1, %rax")
        self.raw("\tret")
        self.raw(".Lse_ne:")
        self.raw("\txorq %rax, %rax")
        self.raw("\tret")
        self.raw("")
        // __syscall(n, a, b, c): Linux's platform layer for the runtime written
        // in Myla (MYLA-162): the call's number and three arguments moved
        // into the kernel's registers; the result, a negative errno on a
        // failure
        self.raw("__syscall:")
        self.raw("\tmovq %rdi, %rax")
        self.raw("\tmovq %rsi, %rdi")
        self.raw("\tmovq %rdx, %rsi")
        self.raw("\tmovq %rcx, %rdx")
        self.raw("\txorl %r10d, %r10d")
        self.raw("\tsyscall")
        self.raw("\tret")
        self.raw("")
        // __syscall5(n, a, b, c, d, e): one with five arguments, the sixth 0
        // (mmap's offset)
        self.raw("__syscall5:")
        self.raw("\tmovq %rdi, %rax")
        self.raw("\tmovq %rsi, %rdi")
        self.raw("\tmovq %rdx, %rsi")
        self.raw("\tmovq %rcx, %rdx")
        self.raw("\tmovq %r8, %r10")
        self.raw("\tmovq %r9, %r8")
        self.raw("\txorl %r9d, %r9d")
        self.raw("\tsyscall")
        self.raw("\tret")
        self.raw("")
        // __set_io_errno(e): the errno the I/O primitives report (a worker's
        // own with tasks)
        self.raw("__set_io_errno:")
        self.raw(format("\tmovq %rdi, {}", self.tv("__io_errno_val")))
        self.raw("\tret")
        self.raw("")
        // __set_run_status(exit, signal, errno), __set_run_stderr(bytes): what
        // the `__run_*` primitives give after `std.rt`'s `run`; the stderr
        // list's reference is the variable's, which `__run_stderr` hands over
        self.raw("__set_run_status:")
        self.raw(format("\tmovl %edi, {}", self.tv("__run_exit_val")))
        self.raw(format("\tmovl %esi, {}", self.tv("__run_signal_val")))
        self.raw(format("\tmovl %edx, {}", self.tv("__run_errno_val")))
        self.raw("\tret")
        self.raw("")
        self.raw("__set_run_stderr:")
        self.raw("\tincq -8(%rdi)")
        self.raw(format("\tmovq %rdi, {}", self.tv("__run_stderr_val")))
        self.raw("\tret")
        self.raw("")
        // __argv(): the program's arguments as the kernel gave them
        self.raw("__argv_of:")
        self.raw("\tmovq __argv(%rip), %rax")
        self.raw("\tret")
        self.raw("")
        // __environ(): the environment the process started with
        self.raw("__environ:")
        self.raw("\tmovq __envp(%rip), %rax")
        self.raw("\tret")
        self.raw("")
        // __copy_bytes(dst, src, n): a bulk copy for the runtime written in
        // Myla (MYLA-162's prototype)
        self.raw("__copy_bytes:")
        self.raw("\tmovq %rdx, %rcx")
        self.emit_byte_copy(true)
        self.raw("\tret")
        self.raw("")
        // __equal_bytes(p, q, n): whether n bytes at p and q are equal, eight
        // at a time (MYLA-162's bulk comparison)
        self.raw("__equal_bytes:")
        self.raw("\tcmpq $8, %rdx")
        self.raw("\tjb .Leb_tail")
        self.raw(".Leb_words:")
        self.raw("\tmovq (%rdi), %rax")
        self.raw("\tcmpq (%rsi), %rax")
        self.raw("\tjne .Leb_no")
        self.raw("\taddq $8, %rdi")
        self.raw("\taddq $8, %rsi")
        self.raw("\tsubq $8, %rdx")
        self.raw("\tcmpq $8, %rdx")
        self.raw("\tjae .Leb_words")
        self.raw(".Leb_tail:")
        self.raw("\ttestq %rdx, %rdx")
        self.raw("\tjz .Leb_yes")
        self.raw(".Leb_bytes:")
        self.raw("\tmovzbl (%rdi), %eax")
        self.raw("\tcmpb (%rsi), %al")
        self.raw("\tjne .Leb_no")
        self.raw("\tincq %rdi")
        self.raw("\tincq %rsi")
        self.raw("\tdecq %rdx")
        self.raw("\tjnz .Leb_bytes")
        self.raw(".Leb_yes:")
        self.raw("\tmovl $1, %eax")
        self.raw("\tret")
        self.raw(".Leb_no:")
        self.raw("\txorl %eax, %eax")
        self.raw("\tret")
        self.raw("")
        // __str_drop: rdi = str cell. Decrement; free at zero (a str owns nothing
        // else); static cells never reach zero. Built as IR with std.rt's
        // allocator (MYLA-162).
        self.emit_routine(drop_entry_ir("__str_drop", self.rt_alloc_names().1, false), -1, 0, 0)
        self.raw("\t.set __str_drop, myla___str_drop")
        // the executor's routines and the allocator in std.rt (MYLA-162):
        // the names the rest of the runtime calls stand for its functions
        for p in self.rt_exec() {
            self.raw(format("\t.set {}, myla_{}", p.0, p.1))
        }
        self.raw("\t.set __print_str, myla_std$rt$print_str")
        let names = self.rt_alloc_names()
        self.raw(format("\t.set __alloc, myla_{}", names.0))
        self.raw(format("\t.set __free, myla_{}", names.1))
        self.raw("")
        self.raw("__func_retain:")
        self.raw("\ttestq %rdi, %rdi")
        self.raw("\tjz .Lfret_done")
        self.raw("\tincq -8(%rdi)")
        self.raw(".Lfret_done:")
        self.raw("\tret")
        self.raw("")
        // at refcount zero, tail-call the env's drop function (word 0): it
        // releases what the env owns and frees the cell
        self.raw("__func_drop:")
        self.raw("\ttestq %rdi, %rdi")
        self.raw("\tjz .Lfdrop_done")
        self.raw("\tdecq -8(%rdi)")
        self.raw("\tjnz .Lfdrop_done")
        self.raw("\tmovq (%rdi), %rax")
        self.raw("\tjmp *%rax")
        self.raw(".Lfdrop_done:")
        self.raw("\tret")
        self.raw("")
        self.emit_compose_runtime()
        self.emit_math_runtime()
        self.emit_derived_eq()
    }

    // The ready frames: each worker has a ring of its own (`emit_executor`
    // below); `__exec_push` (%rdi: a frame) queues one, `__exec_run` resumes
    // frames until none is left anywhere (each frame function takes its
    // frame in %rdi, D119). `myla___resume`
    // goes on with the frame in %rdi, through its resume function;
    // `myla___finish`, at a frame function's end, resumes the frame's caller
    // in place of it, or ends its task and returns to the executor.
    // `__exec_cur` is the frame the executor resumed last: until control
    // comes back, what runs is that frame's task, whose first frame is at the
    // end of the chain of callers (word 8); `__exec_task` is that first
    // frame (the one resumed may end meanwhile). `__exec_main` is the entry's.
    //
    // A task's first frame says in its `task` word (24) how the task is:
    // 0 running, the frame waiting for it, or 1 done; the frame is never
    // resumed again then. A failure doesn't end a task this way: it ends
    // the program (D97, `__task_fail`).
    fun emit_executor(var self) {
        // Each worker has a queue of ready frames (D92, MYLA-140): a ring of
        // its own (EXEC_CAP frames, at `__wq_rings` + its index * 8 MiB) and a
        // record `[lock][head][tail]` (a cache line of `__wq`; the counters
        // run either way, the ring index is the counter masked). A worker
        // pushes onto its own queue's tail and takes its newest frame (depth
        // first: a task's children before its siblings'), else steals the
        // oldest frame of the next queue that has one (the biggest piece of
        // a tree of tasks); a frame yielding a turn goes to the oldest end,
        // behind the others (D110: depth-first, with one worker the order of
        // the self-hosted interpreter). MYLA_SCHED changes it
        // (`__sched_init`): `fifo` takes the oldest (a yield goes to the
        // newest end); `seed:N` queues each push at the end a generator
        // seeded with N picks (a yield still behind the others).
        // `__exec_seq` counts pushes, the word sleeping workers wait on
        // (futex); `__exec_idle` counts the workers with nothing to run
        // (spinning a while, then asleep), `__exec_sleepers` those asleep.
        //
        // (the queues in std.rt: `exec_push` and the others, MYLA-162)
        // __exec_run: a worker's loop (std.rt's `exec_run`, MYLA-162), its
        // stack recorded; a task failed (`__task_fail`): the loop again from
        // its start, on that stack, no frame running
        self.raw("__exec_run:")
        self.raw(format("\tmovq %rsp, {}", self.tv("__exec_sp")))
        self.raw("\tcall __exec_loop")
        self.raw(".Lexec_failed:")
        self.raw(format("\tmovq {}, %rsp", self.tv("__exec_sp")))
        self.raw("\txorl %eax, %eax")
        self.raw(format("\txchgq %rax, {}", self.tv("__exec_cur")))
        self.raw("\tcall __exec_loop")
        self.raw("")
        // the runtime's entry points a frame function tail-calls take the
        // frame in %rdi (D119)
        self.raw("myla___resume:")
        self.raw("\tjmp *(%rdi)")
        self.raw("")
        self.raw("myla___finish:")
        self.raw("\tmovq %rdi, %rax")
        self.raw("\tmovq 8(%rax), %rdi")
        self.raw("\ttestq %rdi, %rdi")
        self.raw("\tjz .Lfinish_task")
        self.raw("\tjmp *(%rdi)")
        // a task's first frame: its task ends; the frame waiting for it, in
        // its `task` word, goes on, and the word says done (1)
        self.raw(".Lfinish_task:")
        // the entry's task: the program ends (its children have ended)
        self.raw("\tcmpq __exec_main(%rip), %rax")
        self.raw("\tje .Lfinish_program")
        // (std.rt's `task_end`: its deadline off the timers, D124, then
        // the waiters)
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tjmp __task_end")
        self.raw(".Lfinish_program:")
        self.raw("\tmovq $231, %rax")
        self.raw("\txorq %rdi, %rdi")
        self.raw("\tsyscall")
        self.raw("")
        // __task_fail: a panic (%rdi 2, %rsi the message, %rdx the position)
        // or an `exit` (%rdi 3, %rsi the code) in a task ends the program
        // (D97): the first failure claims it, every other worker drops its
        // frames from then on, and this returns (%rax 0) for the caller to
        // report the failure at once, wait until no other worker runs a frame
        // (`__failed_wait`) and end the program (MYLA-170: a sibling looping
        // without a suspension point delays the end, not the report). A later
        // failure is not reported: its worker goes back to the executor.
        // With no task running it returns at once.
        self.raw("__task_fail:")
        self.raw(format("\tmovq {}, %rax", self.tv("__exec_cur")))
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjz .Ltf_now")
        self.raw("\tmovq $1, %rcx")
        self.raw("\txorl %eax, %eax")
        self.raw("\tlock cmpxchgq %rcx, __exec_failing(%rip)")
        self.raw("\tjne .Lexec_failed")
        self.raw(".Ltf_now:")
        self.raw("\txorl %eax, %eax")
        self.raw("\tret")
        self.raw("")
        // __start_workers: the workers besides the main thread (worker 0),
        // as many as `__exec_workers` says (`_start` set it); each a thread
        // (clone: the address space, files, signal handlers and thread group
        // shared, CLONE_SETTLS) with its state block and an 8 MiB stack with
        // a guard page at its bottom (MYLA-172), running `__exec_run`
        self.raw("__start_workers:")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tmovq $1, %rbx")
        self.raw(".Lsw_next:")
        self.raw("\tcmpl __exec_workers(%rip), %ebx")
        self.raw("\tjae .Lsw_done")
        self.raw("\tmovq %rbx, %r12")
        self.raw(format("\timulq ${}, %r12", TLS_SIZE))
        self.raw("\tleaq __tls_blocks(%rip), %rax")
        self.raw("\taddq %rax, %r12")
        self.raw("\tmovq %r12, (%r12)")
        self.raw(format("\tmovq %rbx, {}(%r12)", tls_offset("__worker_id")))
        self.raw("\tmovq $9, %rax")
        self.raw("\txorq %rdi, %rdi")
        self.raw("\tmovq $8388608, %rsi")
        self.raw("\tmovq $3, %rdx")
        self.raw("\tmovq $147490, %r10")
        self.raw("\tmovq $-1, %r8")
        self.raw("\txorq %r9, %r9")
        self.raw("\tsyscall")
        self.raw("\tcmpq $-4096, %rax")
        self.raw("\tja .Lsw_short")
        // the stack's lowest page faults: mprotect(base, 4096, PROT_NONE)
        self.raw("\tmovq %rax, %r13")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tmovq $4096, %rsi")
        self.raw("\txorq %rdx, %rdx")
        self.raw("\tmovq $10, %rax")
        self.raw("\tsyscall")
        self.raw("\tmovq %r13, %rax")
        self.raw("\tleaq 8388608(%rax), %rsi")
        self.raw("\tmovq $855808, %rdi")
        self.raw("\txorq %rdx, %rdx")
        self.raw("\txorq %r10, %r10")
        self.raw("\tmovq %r12, %r8")
        self.raw("\tmovq $56, %rax")
        self.raw("\tsyscall")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjz .Lsw_child")
        self.raw("\tjs .Lsw_short")
        self.raw("\tincq %rbx")
        self.raw("\tjmp .Lsw_next")
        // the new thread, on its stack: an alternate signal stack of its own
        // (a thread made with CLONE_VM has none), so `__on_segv` reports its
        // stack's overflow as the main thread's (MYLA-172): mmap(64 KiB),
        // sigaltstack
        self.raw(".Lsw_child:")
        self.raw("\tmovq $9, %rax")
        self.raw("\txorl %edi, %edi")
        self.raw("\tmovl $65536, %esi")
        self.raw("\tmovl $3, %edx")
        self.raw("\tmovl $34, %r10d")
        self.raw("\tmovq $-1, %r8")
        self.raw("\txorl %r9d, %r9d")
        self.raw("\tsyscall")
        self.raw("\tcmpq $-4096, %rax")
        self.raw("\tja .Lsw_run")
        self.raw("\tsubq $32, %rsp")
        self.raw("\tmovq %rax, (%rsp)")
        self.raw("\tmovq $0, 8(%rsp)")
        self.raw("\tmovq $65536, 16(%rsp)")
        self.raw("\tmovq $131, %rax")
        self.raw("\tmovq %rsp, %rdi")
        self.raw("\txorl %esi, %esi")
        self.raw("\tsyscall")
        self.raw("\taddq $32, %rsp")
        self.raw(".Lsw_run:")
        // (its chunks mapped as it allocates, std.rt)
        self.raw("\tjmp __exec_run")
        // no more threads to be had: the workers made so far
        self.raw(".Lsw_short:")
        self.raw("\tmovl %ebx, __exec_workers(%rip)")
        self.raw(".Lsw_done:")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tret")
        self.raw("")
        // myla___yield(frame): a turn for the others, the frame queued again
        // (its resume point stored before this tail call, D92)
        self.raw("myla___yield:")
        self.raw("\tjmp __exec_yield_push")
        self.raw("")
        // the entry points that may go on with the frame at once (D90):
        // std.rt decides (`task_wait`, `actor_enter`: the frame to resume, or
        // 0 for the worker to return to the executor), the jump into the
        // frame is the platform's (MYLA-162)
        for ep in [("myla___wait", "__task_wait"), ("myla___actor_enter", "__actor_enter_rt")] {
            self.raw(ep.0 + ":")
            self.raw("\tcall " + ep.1)
            self.raw("\ttestq %rax, %rax")
            self.raw("\tjz " + ".L" + ep.0 + "_park")
            self.raw("\tmovq %rax, %rdi")
            self.raw("\tjmp *(%rax)")
            self.raw(".L" + ep.0 + "_park:")
            self.raw("\tret")
            self.raw("")
        }
        // __task_exit: `exit` (%edi the code) when tasks take turns
        self.raw("__task_exit:")
        self.raw("\tpushq %rdi")
        self.raw("\tmovslq %edi, %rsi")
        self.raw("\tmovq $3, %rdi")
        self.raw("\tcall __task_fail")
        self.raw("\tcall __failed_wait")
        self.raw("\tpopq %rdi")
        self.raw("\tmovq $231, %rax")
        self.raw("\tsyscall")
        self.raw("")
    }

    // `__deep_env` and `__dclone_env`, the deep copies of a function value's
    // environment every program with tasks may need (D92, MYLA-148); the
    // strings' and a plain cell's are std.rt's (`rt_exec`, MYLA-162).
    fun emit_deep_runtime(var self) {
        // none; owning nothing (`__free` its drop): as a string, itself when
        // unshared, else a copy; else the deep copy just before its drop
        // function
        self.raw("__deep_env:")
        self.raw("\ttestq %rdi, %rdi")
        self.raw("\tjz .Lde_none")
        self.raw("\tmovq (%rdi), %rax")
        self.raw("\tleaq __free(%rip), %rcx")
        self.raw("\tcmpq %rcx, %rax")
        self.raw("\tje __deep_str")
        self.raw("\tjmp *-8(%rax)")
        self.raw(".Lde_none:")
        self.raw("\txorl %eax, %eax")
        self.raw("\tret")
        self.raw("")
        // its clone, only reading the original: owning nothing, a copy; else
        // the clone two words before its drop function
        self.raw("__dclone_env:")
        self.raw("\ttestq %rdi, %rdi")
        self.raw("\tjz .Ldce_none")
        self.raw("\tmovq (%rdi), %rax")
        self.raw("\tleaq __free(%rip), %rcx")
        self.raw("\tcmpq %rcx, %rax")
        self.raw("\tje __dclone_cell")
        self.raw("\tjmp *-16(%rax)")
        self.raw(".Ldce_none:")
        self.raw("\txorl %eax, %eax")
        self.raw("\tret")
        self.raw("")
    }

    // std.math's primitives (MYLA-248). A float64 travels as its bits in a
    // general-purpose register: `__sqrt` rdi = x -> rax = the correctly
    // rounded square root (sqrtsd); `__f64_bits` and `__f64_from_bits` are the
    // bits themselves.
    fun emit_math_runtime(var self) {
        self.raw("__sqrt:")
        self.raw("\tmovq %rdi, %xmm0")
        self.raw("\tsqrtsd %xmm0, %xmm0")
        self.raw("\tmovq %xmm0, %rax")
        self.raw("\tret")
        self.raw("__f64_bits:")
        self.raw("__f64_from_bits:")
        self.raw("\tmovq %rdi, %rax")
        self.raw("\tret")
        self.raw("")
    }

    // __compose_call(x), its env in %r10: the env holds two fat values a
    // (env[8]) and b (env[24]); computes b(a(x)) for scalar x/result via the
    // closure calling convention (D119), b by a jump in place of it.
    // __compose_env_drop releases both and frees the env.
    fun emit_compose_runtime(var self) {
        self.raw("__compose_call:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tmovq %r10, %rbx")
        self.raw("\tmovq 16(%rbx), %r10")
        self.raw("\tcall *8(%rbx)")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tmovq 32(%rbx), %r10")
        self.raw("\tmovq 24(%rbx), %rcx")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tjmp *%rcx")
        self.raw("")
        self.emit_compose_env_drop()
    }

    // __compose_env_drop and its env's routines as IR (MYLA-162): those of
    // an environment that owns two function values
    fun emit_compose_env_drop(var self) {
        let fv = Type.TFunc([Type.TInt(64, true)], Some(Type.TInt(64, true)))
        let owned = [DropEntry { off: 8, ty: fv }, DropEntry { off: 24, ty: fv }]
        self.emit_env_drop("__compose", owned)
        self.raw("\t.set __compose_env_drop, myla___compose_env_drop")
    }

    // __fmod: emitted once, after the functions, when the program uses
    // floats (`__float_to_str` is std.rt's, MYLA-162).
    fun fmod_text(self) -> str {
        return "\n__fmod:\n\tsubq $16, %rsp\n\tmovsd %xmm1, (%rsp)\n\tmovsd %xmm0, 8(%rsp)\n\tfldl (%rsp)\n\tfldl 8(%rsp)\n.Lfm_loop:\n\tfprem\n\tfnstsw %ax\n\ttestb $0x04, %ah\n\tjnz .Lfm_loop\n\tfstpl 8(%rsp)\n\tfstp %st(0)\n\tmovsd 8(%rsp), %xmm0\n\taddq $16, %rsp\n\tret"
    }

