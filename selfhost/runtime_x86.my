    // %rcx bytes from (%rsi) to (%rdi), leaving both past the bytes and
    // clobbering %rax and %rcx: 8 at a time, then the tail, with `rep movsb`
    // only for a long copy, where it is fast. Its start costs tens of cycles,
    // which made short strings slower than C (MYLA-252). `raw` for the
    // runtime prelude.
    fun emit_byte_copy(var self, raw: bool) {
        let rep = self.label()
        let words = self.label()
        let bytes = self.label()
        let done = self.label()
        let lines = ["cmpq $512, %rcx", format("jae {}", rep),
            format("{}:", words), "cmpq $8, %rcx", format("jb {}", bytes), "movq (%rsi), %rax", "movq %rax, (%rdi)",
            "addq $8, %rsi", "addq $8, %rdi", "subq $8, %rcx", format("jmp {}", words),
            format("{}:", bytes), "testq %rcx, %rcx", format("jz {}", done), "movb (%rsi), %al", "movb %al, (%rdi)",
            "incq %rsi", "incq %rdi", "decq %rcx", format("jmp {}", bytes),
            format("{}:", rep), "cld", "rep movsb", format("{}:", done)]
        for line in lines {
            if raw {
                if ends_colon(line) { self.raw(line) } else { self.raw("\t" + line) }
            } else {
                self.emit(line)
            }
        }
    }
}
