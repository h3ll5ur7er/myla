// driver.my -- what the `myla` commands do with one entry file: load, link and
// type-check it, interpret it or run its tests, compile it to a binary. Shared
// by the file commands (main.my) and the project commands (project_cmd.my,
// MYLA-94).
//
// `build` type-checks and generates x86-64 assembly (with `debug`, DWARF debug
// information for gdb: line tables and variables, MYLA-71, MYLA-66), writes it
// to `<out>.s`, then shells out to the system assembler and linker (`as`/`ld`,
// found on PATH, D147) to produce the executable
// `<out>`, and removes the intermediate files.

from std.process import run, Output, ExitStatus, SpawnError
from std.io import write, eprintln
from std.fs import write_to_file, remove_file
from std.platform import TARGET
from .loader import load_program_opts, LoadOptions, for_target, file_of, Loaded, type_errors, warning_reports, in_stdlib, target_platform_file, normalize, is_std_module, std_tree_root
from .stdroot import EMBEDDED_ROOT
from .diag import render, Report
from .checker import build_checker_lazy, Checker, CheckErr
from .codegen import new_codegen
from .dwarf import read_gdb_script
from .interp import new_interp, RtError, TestRun, TestOptions, sched_from_env, time_from_env
from .harness import harness_source, Harness, runner_case
from std.test import cut_run, case_outcome, case_lines, record_head
from std.process import command, env
from std.time import now_ns
from std.fs import make_dir_all, remove_dir_all, exists, read_to_string, current_dir
from .parser import expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of  // AST values for #test cases (MYLA-184)

// Decode a captured `[uint8]` buffer (e.g. a child's stderr) as UTF-8 text.
#test([])[""]
#test([0, 1])["\0\u{1}"]
pub fun decode(bytes: [uint8]) -> str {
    var sb = StringBuilder()
    for b in bytes { sb.append_byte(b) }
    return sb.build()
}

// A checked program, and the linked one (for the files of its node ids).
pub struct Checked { checker: Checker, prog: Loaded }

// Load, link and type-check the program rooted at `file`, as `opts` says.
// Errors are carried as the diagnostic text to print: every error, then a
// summary line when there are several (MYLA-65, D80).
pub fun load_and_check(entry: str, given: LoadOptions) -> Result<Checked, str> {
    let (file, opts) = own_library(entry, given)
    let prog = match load_program_opts(file, opts) {
        Ok(p) => p,
        Err(r) => { return Err(render(r)) },
    }
    // a file of the standard library may use its primitives (D152)
    return match build_checker_lazy(prog.decls, prog.next_id, in_stdlib(file, opts.stdlib_root), prog.std_impls, prog.bodies) {
        Ok(c) => {
            // its warnings, before the program is run or built (D95)
            for r in warning_reports(prog, c.warnings) { eprintln(render(r) + "\n") }
            Ok(Checked { checker: c, prog: prog })
        },
        Err(errs) => Err(render(type_errors(prog, errs))),
    }
}

// Type-check `file`, then generate its assembly for `target` (`debug`: with DWARF
// debug information, MYLA-71, MYLA-66; `checked`: integer overflow traps,
// D175).
fun compile_asm(entry: str, given: LoadOptions, debug: bool, checked: bool, target: str) -> Result<str, str> {
    let (file, opts) = own_library(entry, given)
    var native = for_target(opts, target)
    native.runtime = true
    let ch = load_and_check(file, native)?
    var g = new_codegen(ch.checker)
    if target != "x86_64-linux" && debug { return Err(format("myla: -g is not supported for {} yet", target)) }
    if target == "aarch64-linux" { g.a64 = true }
    if target == "wasm32-wasi" { g.wasm = true }
    g.checked = checked
    g.set_sources(ch.prog.spans, ch.prog.next_id)
    if debug { g.enable_debug_info(read_gdb_script(opts.stdlib_root)) }
    let asm = g.generate()
    if g.refused.len() > 0 { return Err(render(type_errors(ch.prog, g.refused))) }
    return Ok(asm)
}

// The entry file and `opts` it is loaded with: with the library the tools
// carry, a module of a copy of the standard library on disk (the
// repository's `lib/std/x.my`) is loaded with that copy, as `--stdlib`
// would name it, so that it and what it imports are one copy each (a
// relative `.json` and an imported module's `std.json` were two); written
// absolute where the root can't be written as the file is (`yaml.my` in
// `lib/std`).
fun own_library(file: str, opts: LoadOptions) -> (str, LoadOptions) {
    var o = opts
    if opts.stdlib_root != EMBEDDED_ROOT {
        // a module of the root named, written another way (`lib/std/x.my`
        // with `--stdlib $PWD/lib`): both absolute, for the same reason
        if opts.stdlib_root == "" || !is_std_module(file, opts.stdlib_root) { return (file, opts) }
        if written_under(file, opts.stdlib_root) { return (file, opts) }
        o.stdlib_root = absolute(opts.stdlib_root)
        return (absolute(file), o)
    }
    if !is_std_module(file, EMBEDDED_ROOT) { return (file, opts) }
    o.stdlib_root = std_tree_root(file)
    if o.stdlib_root != "" { return (file, o) }
    let whole = absolute(file)
    o.stdlib_root = std_tree_root(whole)
    if o.stdlib_root == "" { return (file, opts) }
    return (whole, o)
}

// Whether `file` is written as a path under `root`, both relative or both
// absolute, as the loader's paths of the root's modules are.
#test("lib/std/x.my", "lib")[true]
#test("./lib/std/x.my", "lib/")[true]
#test("std/x.my", ".")[true]
#test("lib/std/x.my", "/w/lib")[false]
#test("/w/lib/std/x.my", "lib")[false]
#test("lib2/std/x.my", "lib")[false]
fun written_under(file: str, root: str) -> bool {
    let f = normalize(file)
    let r = normalize(root)
    if r == "." { return f[0] != '/' }
    return f.len() > r.len() && f[0:r.len() + 1] == r + "/"
}

// Inspect a finished child's status; return true on failure (nonzero exit or a
// terminating signal), echoing its stderr and `label`.
#test(Output { stdout: [], stderr: [], status: ExitStatus.Exited(0) }, "myla: linker failed")[false]
#test(Output { stdout: [], stderr: [], status: ExitStatus.Exited(0) }, "myla: assembler failed")[false]
fun step_failed(out: Output, label: str) -> bool {
    match out.status {
        ExitStatus.Exited(code) => {
            if code != 0 {
                eprintln(label)
                write(2, decode(out.stderr))
                return true
            }
            return false
        },
        ExitStatus.Signaled(sig) => {
            eprintln(label)
            return true
        },
    }
    return false
}

// `myla test <file> [--only <text>] [--list]`: run (or list) the file's
// own #test cases, printing the report; the exit status.
pub fun cmd_test(file: str, opts: LoadOptions, sel: TestOptions) -> int32 {
    match load_and_check(file, opts) {
        Ok(ch) => {
            var it = new_interp(ch.checker, [file])
            return it.run_tests(sel)
        },
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    return 0
}

// `myla test <file> --native [--target <t>]`: the file's own cases run
// natively through a harness (harness.my, D162, MYLA-307), the report the
// interpreter's; the exit status.
pub fun cmd_test_native(file: str, opts: LoadOptions, sel: TestOptions, target: str) -> int32 {
    let r = match native_tests(file, opts, sel, target) {
        Ok(r) => r,
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    if r.total == 0 {
        if sel.only != "" {
            write(1, format("no #test cases match '{}'.\n", sel.only))
            return 1
        }
        write(1, "no #test cases found.\n")
        return 0
    }
    for line in r.report { write(1, line) }
    write(1, format("\n{}/{} passed.\n", r.passed, r.total))
    if r.passed == r.total { return 0 }
    return 1
}

// The `#test` cases declared in `file` itself run natively for `target`:
// the harness built in a scratch directory and run (through the emulator
// MYLA_EMULATOR names, or qemu-aarch64, for another target), its report
// read back. A harness that ends before its summary (no child processes
// there: a failure ended the run) reports the case it stopped at with the
// error, and the rest as not run. On wasm32, where the harness can start
// no process, the runs are this process's (`resumed_tests`, MYLA-370).
pub fun native_tests(given_file: str, given: LoadOptions, sel: TestOptions, target: str) -> Result<TestRun, str> {
    let (file, opts) = own_library(given_file, given)
    if hosts_platform(file, opts.stdlib_root, target) {
        return Err(format("myla: {} is std.platform for {}; for {} it is {}/std/{}, whose cases run there", file, TARGET, target, opts.stdlib_root, target_platform_file(target)))
    }
    // the runtime is every native program's, a harness's too, which can't
    // hold it a second time (MYLA-547)
    if opts.stdlib_root != "" && opts.stdlib_root != EMBEDDED_ROOT && absolute(file) == absolute(opts.stdlib_root + "/std/rt.my") {
        return Err(format("myla: {} is std.rt, the runtime of every native program, whose own cases run interpreted only ('myla test {}')", given_file, given_file))
    }
    let ch = load_and_check(file, opts)?
    let text = match read_to_string(file) {
        Ok(t) => t,
        Err(e) => { return Err("myla: cannot read " + file) },
    }
    let h = match harness_source(text, ch.checker, ch.prog.decls, sel.only) {
        Some(h) => h,
        None => { return Ok(TestRun { report: [], passed: 0, total: 0 }) },
    }
    var base = match env("TMPDIR") { Some(d) => d, None => "" }
    if base == "" { base = "/tmp" }
    let dir = format("{}/myla-test-{}", base, now_ns())
    match make_dir_all(dir) {
        Ok(()) => {},
        Err(e) => { return Err("myla: cannot create " + dir) },
    }
    let out = dir + "/harness"
    var nopts = opts
    // the target's own platform module is its `std.platform`, which the
    // harness imports too (through std.test): built as that module, with
    // the harness in it, it is loaded once (MYLA-397), the harness keyed
    // where `for_target` reads the module, however the file and the root
    // are written (S3)
    let entry = harness_entry(file, opts.stdlib_root, target)
    if entry != file { nopts.overrides[opts.stdlib_root + "/std/" + target_platform_file(target)] = h.source }
    else { nopts.overrides[file] = h.source }
    // built checked: overflow traps under `myla test`, natively too (D175)
    if cmd_build(entry, out, nopts, false, true, target) != 0 {
        // the harness kept, for a look at the code added to the file
        let kept = write_to_file(out + ".my", h.source)
        return Err(format("myla: the test harness of {} didn't build: its errors above are at positions past the file's end, in the code added to it (kept at {}.my)", file, out))
    }
    var argv = emulator(target)
    argv.push(out)
    var rest: [str] = []
    var i = 1
    while i < argv.len() {
        rest.push(argv[i])
        i = i + 1
    }
    if target == "wasm32-wasi" {
        let r = resumed_tests(h, argv[0], rest, sel.program, dir)
        let gone = remove_dir_all(dir)
        return r
    }
    var emu = ""
    if argv.len() > 1 { emu = join_words(emulator(target)) }
    let ran = command(argv[0]).args(rest).env("MYLA_TEST_PROGRAM", sel.program).env("MYLA_TEST_EMULATOR", emu).stdin("").output()
    let gone = remove_dir_all(dir)
    let o = match ran {
        Ok(o) => o,
        Err(e) => { return Err(format("myla: cannot run the test harness with '{}'", argv[0])) },
    }
    let err = decode(o.stderr)
    let code = match o.status { ExitStatus.Exited(c) => c, ExitStatus.Signaled(s) => -s }
    // what the cases wrote on stderr, which the harness passed on, as the
    // interpreter's `myla test` lets it through
    write(2, err)
    return Ok(harness_report(h, decode(o.stdout), err, code))
}

// The file a harness of `file`'s cases is built from for `target`: the
// standard library's `std/platform.my` when `file` is the target's own
// platform module (`for_target` gives that path `file`'s text, the harness
// here), else `file` (MYLA-397).
#test("lib/std/platform_wasm.my", "lib", "wasm32-wasi")["lib/std/platform.my"]
#test("lib/./std/platform_aarch64.my", "lib", "aarch64-linux")["lib/std/platform.my"]
#test("lib/std/platform_wasm.my", "lib", "aarch64-linux")["lib/std/platform_wasm.my"]
#test("lib/std/platform.my", "lib", "x86_64-linux")["lib/std/platform.my"]
#test("lib/std/platform_wasm.my", "", "wasm32-wasi")["lib/std/platform_wasm.my"]
#test("tests/platform_wasm.my", "lib", "wasm32-wasi")["tests/platform_wasm.my"]
fun harness_entry(file: str, stdlib_root: str, target: str) -> str {
    let own = target_platform_file(target)
    if own == "" || stdlib_root == "" { return file }
    if absolute(file) != absolute(stdlib_root + "/std/" + own) { return file }
    return stdlib_root + "/std/platform.my"
}

// Whether `file` is the host's own platform module, `std/platform.my`,
// tested for a target with one of its own, which takes that module's place
// there (`for_target`).
#test("lib/std/platform.my", "lib", "wasm32-wasi")[true]
#test("lib/./std/platform.my", "lib/", "aarch64-linux")[true]
#test("lib/std/platform.my", "lib", "x86_64-linux")[false]
#test("lib/std/platform_wasm.my", "lib", "wasm32-wasi")[false]
fun hosts_platform(file: str, stdlib_root: str, target: str) -> bool {
    if target_platform_file(target) == "" || stdlib_root == "" { return false }
    return absolute(file) == absolute(stdlib_root + "/std/platform.my")
}

// `p` normalized, from the current directory if it is relative.
fun absolute(p: str) -> str {
    if p.len() > 0 && p[0] == '/' { return normalize(p) }
    return match current_dir() {
        Ok(d) => normalize(d + "/" + p),
        Err(e) => normalize(p),
    }
}

// The cases of the harness `h` run by `exe` with the arguments `lead`
// (the emulator's and the harness's path) where the harness can start no
// process (wasm32, MYLA-370): a run `--from <k>` runs the cases from `k` on
// in the harness, between markers, until one ends it (a runtime error, an
// `exit`) or all have run; what each case printed and how it ended give its
// report as a child's would (`std.test`'s `cut_run`), and the next run
// starts after the case that ended the last. A run per case that ends it,
// and one more: each run's cases share its scratch directory (MYLA_TEST_DIR,
// under `dir`), removed when the run ends.
fun resumed_tests(h: Harness, exe: str, lead: [str], program: str, dir: str) -> Result<TestRun, str> {
    var lines: [str] = []
    var passed = 0
    var k = 0
    // the runs' records are framed with a nonce of this run's (D191)
    let nonce = format("{}", now_ns())
    let head = record_head(nonce)
    while k < h.cases.len() {
        var argv = lead
        argv.push("--from")
        argv.push(format("{}", k))
        argv.push(nonce)
        let root = format("{}/run{}", dir, k)
        let ran = command(exe).args(argv).env("MYLA_TEST_PROGRAM", program).env("MYLA_TEST_DIR", root).stdin("").output()
        if exists(root) { let gone = remove_dir_all(root) }
        let o = match ran {
            Ok(o) => o,
            Err(e) => { return Err(format("myla: cannot run the test harness with '{}'", exe)) },
        }
        let code = match o.status { ExitStatus.Exited(c) => c, ExitStatus.Signaled(s) => -s }
        let runs = cut_run(decode(o.stdout), decode(o.stderr), code, head)
        if runs.len() == 0 {
            // the harness ended before its first case: that case failed so
            let (verdict, shown, rest) = case_outcome(runner_case(h.cases[k]), "", decode(o.stderr), code, head)
            write(2, rest)
            let why = match verdict { Some(d) => d, None => format("the harness ended with status {} before the case", code) }
            for l in case_lines(runner_case(h.cases[k]), Some(why), []) { lines.push(l) }
            k = k + 1
            continue
        }
        // what a case wrote on stderr itself is passed on, as a child's is
        for run in runs {
            if k >= h.cases.len() { break }
            let c = runner_case(h.cases[k])
            let (verdict, shown, rest) = case_outcome(c, run.0, run.1, run.2, head)
            write(2, rest)
            match verdict { None => { passed = passed + 1 }, Some(d) => {} }
            for l in case_lines(c, verdict, shown) { lines.push(l) }
            k = k + 1
        }
    }
    return Ok(TestRun { report: lines, passed: passed, total: h.cases.len() })
}

// The command the harness runs under: none for this machine's target, else
// MYLA_EMULATOR's words, else qemu-aarch64 for aarch64 Linux.
#test("x86_64-linux")[[]]
pub fun emulator(target: str) -> [str] {
    if target == TARGET { return [] }
    match env("MYLA_EMULATOR") {
        Some(words) => { if words != "" { return split_words(words) } },
        None => {},
    }
    if target == "aarch64-linux" { return ["qemu-aarch64"] }
    return []
}

#test(["node", "run.mjs"])["node run.mjs"]
fun join_words(words: [str]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < words.len() {
        if i > 0 { sb.append(" ") }
        sb.append(words[i])
        i = i + 1
    }
    return sb.build()
}

#test("node run.mjs")[["node", "run.mjs"]]
#test("qemu-aarch64")[["qemu-aarch64"]]
fun split_words(text: str) -> [str] {
    var out: [str] = []
    var word = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == ' ' {
            let w = word.build()
            if w.len() > 0 { out.push(w) }
            word = StringBuilder()
        } else {
            word.append_byte(text[i])
        }
        i = i + 1
    }
    let w = word.build()
    if w.len() > 0 { out.push(w) }
    return out
}

// The harness's report from what it printed: its lines, and the summary's
// counts; when it ended without one (status `code`, its stderr `err`), the
// case it stopped at failed with the runtime error on stderr, the rest
// weren't run.
pub fun harness_report(h: Harness, stdout: str, err: str, code: int32) -> TestRun {
    var lines: [str] = []
    var passed = 0
    var ended = false
    for l in report_lines(stdout) {
        if ended { continue }
        if l == "" { ended = true
            continue }
        if starts_with_pass(l) { passed = passed + 1 }
        lines.push(l + "\n")
    }
    let total = h.cases.len()
    if ended { return TestRun { report: lines, passed: passed, total: total } }
    // the run stopped: which case, and why
    var ran = 0
    for l in lines { if !is_shown_line(l) { ran = ran + 1 } }
    if ran < total {
        var why = format("the harness ended with status {}", code)
        for l in report_lines(err) {
            if l.len() > 15 && l[0:15] == "runtime error: " { why = l
                break }
        }
        lines.push(format("FAIL  {}: {}\n", h.cases[ran].name, why))
        var k = ran + 1
        while k < total {
            lines.push(format("FAIL  {}: not run (an earlier failure ended the run)\n", h.cases[k].name))
            k = k + 1
        }
    }
    return TestRun { report: lines, passed: passed, total: total }
}

#test("PASS  f #1")[true]
#test("FAIL  f #1: x")[false]
fun starts_with_pass(l: str) -> bool {
    return l.len() >= 6 && l[0:6] == "PASS  "
}

#test("      | out")[true]
#test("PASS  f")[false]
fun is_shown_line(l: str) -> bool {
    return l.len() >= 6 && l[0:6] == "      "
}

#test("a\nb\n")[["a", "b"]]
fun report_lines(text: str) -> [str] {
    var out: [str] = []
    var line = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == '\n' {
            out.push(line.build())
            line = StringBuilder()
        } else {
            line.append_byte(text[i])
        }
        i = i + 1
    }
    let rest = line.build()
    if rest.len() > 0 { out.push(rest) }
    return out
}

// `myla run <file> [args]`: interpret the program with argv
// `[file, args...]`; the exit status.
pub fun cmd_interp(file: str, opts: LoadOptions, prog_args: [str]) -> int32 {
    match load_and_check(file, opts) {
        Ok(ch) => {
            var argv = [file]
            for a in prog_args { argv.push(a) }
            var it = new_interp(ch.checker, argv)
            // a task's failure is reported when it happens, before the
            // other tasks stop (D97, MYLA-170)
            let prog = ch.prog
            it.on_failure = (r: RtError) => report_runtime_error(r, prog)
            it.schedule(sched_from_env())
            it.time_mode(time_from_env())
            let code = it.run()
            if !it.fail_reported {
                match it.rt_err {
                    Some(r) => { let shown = report_runtime_error(r, ch.prog) },
                    None => {},
                }
            }
            return code
        },
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    return 0
}

// The `#test` cases declared in `file` itself (not in the modules it links),
// run as `myla test` does in a project (MYLA-94); Err: the diagnostic.
pub fun own_tests(file: str, opts: LoadOptions, sel: TestOptions) -> Result<TestRun, str> {
    let ch = load_and_check(file, opts)?
    var it = new_interp(ch.checker, [file])
    return Ok(it.run_test_cases(sel))
}

// `myla build <file> -o <out>`: compile to a native binary at `out`.
// Whether the file `path` was removed.
fun removed(path: str) -> bool {
    return match remove_file(path) {
        Ok(()) => true
        Err(e) => false
    }
}

// The assembler's and the linker's command lines for `target` (the
// assembly `asm`, the object `obj`, the program `out`) on a host whose own
// target is `host` (the toolchain's, `std.platform.TARGET`): the host's GNU
// `as` and `ld` for its own Linux target, as the bootstrap uses them; clang
// and lld for another Linux target (MYLA-163) and for wasm32-wasi (a module
// for a WASI host such as tools/wasm/run.mjs, MYLA-158; MYLA-276).
#test("x86_64-linux", "x86_64-linux", "a.s", "a.o", "a")[(["as", "--64", "-o", "a.o", "a.s"], ["ld", "-o", "a", "a.o"])]
#test("aarch64-linux", "aarch64-linux", "a.s", "a.o", "a")[(["as", "-o", "a.o", "a.s"], ["ld", "-o", "a", "a.o"])]
#test("aarch64-linux", "x86_64-linux", "a.s", "a.o", "a")[(["clang", "--target=aarch64-linux-gnu", "-c", "-o", "a.o", "a.s"], ["ld.lld", "-static", "-o", "a", "a.o"])]
#test("x86_64-linux", "aarch64-linux", "a.s", "a.o", "a")[(["clang", "--target=x86_64-linux-gnu", "-c", "-o", "a.o", "a.s"], ["ld.lld", "-static", "-o", "a", "a.o"])]
pub fun build_commands(target: str, host: str, asm: str, obj: str, out: str) -> ([str], [str]) {
    if target == "wasm32-wasi" {
        // the stack below the data, so running out of it can't overwrite
        // the data (MYLA-261)
        return (["clang", "--target=wasm32-wasi", "-mtail-call", "-mbulk-memory", "-mnontrapping-fptoint", "-msign-ext", "-c", "-o", obj, asm],
                ["wasm-ld", "--stack-first", "-z", "stack-size=8388608", "-o", out, obj])
    }
    if target == host {
        if target == "x86_64-linux" {
            return (["as", "--64", "-o", obj, asm], ["ld", "-o", out, obj])
        }
        return (["as", "-o", obj, asm], ["ld", "-o", out, obj])
    }
    let triple = if target == "aarch64-linux" { "aarch64-linux-gnu" } else { "x86_64-linux-gnu" }
    return (["clang", "--target=" + triple, "-c", "-o", obj, asm], ["ld.lld", "-static", "-o", out, obj])
}

// What a failed step says: that its tool is missing when it isn't on PATH,
// and what building for `target` needs.
#test("clang", "aarch64-linux", "x86_64-linux")["myla: 'clang' was not found: building for aarch64-linux here needs clang and ld.lld"]
#test("as", "x86_64-linux", "x86_64-linux")["myla: 'as' was not found: building for x86_64-linux here needs GNU as and ld (binutils)"]
pub fun missing_tool(tool: str, target: str, host: str) -> str {
    var needs = "clang and ld.lld"
    if target == "wasm32-wasi" { needs = "clang and wasm-ld" } else if target == host { needs = "GNU as and ld (binutils)" }
    return format("myla: '{}' was not found: building for {} here needs {}", tool, target, needs)
}

// Run one step of a build: false when it worked; a missing tool named.
fun build_step(argv: [str], label: str, target: str) -> bool {
    var failed = true
    var rest: [str] = []
    var i = 1
    while i < argv.len() {
        rest.push(argv[i])
        i += 1
    }
    match run(argv[0], rest) {
        Ok(out) => { failed = step_failed(out, label) },
        Err(SpawnError.NotFound) => { eprintln(missing_tool(argv[0], target, TARGET)) },
        Err(e) => { eprintln(label) },
    }
    return failed
}

// `target`: x86_64-linux, aarch64-linux or wasm32-wasi; its tools are
// `build_commands`'. `checked`: integer overflow traps (`--checked`, D175).
pub fun cmd_build(file: str, output: str, opts: LoadOptions, debug: bool, checked: bool, target: str) -> int32 {
    let asm = match compile_asm(file, opts, debug, checked, target) {
        Ok(a) => a,
        Err(e) => {
            eprintln(e)
            return 1
        },
    }
    let asm_path = output + ".s"
    let obj_path = output + ".o"
    match write_to_file(asm_path, asm) {
        Ok(()) => {},
        Err(e) => {
            eprintln("myla: cannot write assembly to " + asm_path)
            return 1
        },
    }
    let tools = build_commands(target, TARGET, asm_path, obj_path, output)
    if build_step(tools.0, "myla: assembler failed", target) {
        return 1
    }
    if build_step(tools.1, "myla: linker failed", target) {
        return 1
    }
    // the assembly and object file were only steps (MYLA-35)
    if !removed(asm_path) || !removed(obj_path) {
        eprintln("myla: cannot remove the intermediate files")
        return 1
    }
    return 0
}

// A runtime error on stderr, as the Python CLI prints it, in the file of its
// expression; true.
fun report_runtime_error(r: RtError, prog: Loaded) -> bool {
    eprintln(render(Report { kind: "runtime error", msg: r.msg, path: file_of(prog, r.node), line: r.line, col: r.col, sp: r.sp, more: [], notes: [] }))
    return true
}
