from std.process import exit
from std.io import eprintln
from .lexer import lex
from .parser import parse_ids
from .checker import build_checker_decls

fun main() {
    let p = parse_ids(lex("fun main() { let x = 1 }"), 0)
    match build_checker_decls(p.program.decls, p.next_id) {
        Ok(c) => {
            eprintln("[p] ok")
            exit(0)
        },
        Err(e) => {
            eprintln(format("[p] err at {}:{}", e.line, e.col))
            exit(1)
        },
    }
}
