}

#test([1], 2)[[1, 2]]
#test([1, 2], 2)[[1, 2]]
fun with_int(xs: [int32], x: int32) -> [int32] {
    var out = xs
    if !contains_int(out, x) { out.push(x) }
    return out
}

#test([3, 5], 5)[true]
#test([3], 4)[false]
pub fun contains_int(xs: [int32], x: int32) -> bool {
    for y in xs {
        if y == x { return true }
    }
    return false
}

// The receiver of a `EnumName.Variant` callee, or a dummy expr otherwise.
fun callee_target(callee: Expr) -> Expr {
    return match callee.kind { ExprKind.GetField(tgt, field) => tgt, _ => callee }
}

#test(expr_of("-n * 2"))[""]
fun getfield_name(callee: Expr) -> str {
    return match callee.kind { ExprKind.GetField(tgt, field) => field, _ => "" }
}

#test("Result")["Ok"]
#test("Option")["Some"]
pub fun success_variant(enum_name: str) -> str {
    if enum_name == "Option" { return "Some" }
    return "Ok"
}

#test("Result")["Err"]
#test("Option")["None"]
pub fun failure_variant(enum_name: str) -> str {
    if enum_name == "Option" { return "None" }
    return "Err"
}

// -- monomorphization helpers --------------------------------------------

#test(32, true)["int32"]
fun int_type_name_cg(w: int32, signed: bool) -> str {
    if signed { return format("int{}", w) }
    return format("uint{}", w)
}

#test("id", [Type.TStr])["id__4.str"]
#test("Box.get", [Type.TInt(32, true)])["Box.get__4.i32"]
#test("swap", [Type.TInt(32, true), Type.TInt(32, true)])["swap__4.i324.i32"]
pub fun mangle_fn(name: str, args: [Type]) -> str {
    return format("{}__{}", name, join_tokens(args))
}

// Mangled names are injective (MYLA-9): every type argument's token is
// prefixed with its length, and a built-in token starts with `.`, which no
// identifier contains, while a user type's token is its name. So
// `Pair<A_B, C>` is `Pair__3A_B1C` and `Pair<A, B_C>` is `Pair__1A3B_C`.
#test([Type.TStr])["4.str"]
#test([Type.TStruct("Vec2", [])])["4Vec2"]
#test([Type.TInt(32, true), Type.TInt(32, true)])["4.i324.i32"]
fun join_tokens(xs: [Type]) -> str {
    var s = ""
    for x in xs { s = s + lp(mono_token(x)) }
    return s
}

// `tok` prefixed with its length, so a run of tokens reads back one way.
#test(".f64")["4.f64"]
#test(".char")["5.char"]
#test(".F4.i32R4.i32")["13.F4.i32R4.i32"]
fun lp(tok: str) -> str {
    return format("{}{}", tok.len(), tok)
}

// The name of the routine a `Want` of kind 7 or more asks for (MYLA-313):
// 7 `__eq_<T>`, the equality of a tuple or list type; 8 `__thash_<T>`, a
// tuple's `hash`; for a map key type `T` with routines of its own
// (`map_hashed`), 9 `__khash_<T>` its hash, 10 `__keq_<T>` its equality,
// 11 `__mfind_<T>` its slot, 12 `__mput_<T>` its slot made, 13 `__mkeys_<T>`
// the keys of a map.
#test(Want { kind: 7, t: Type.TTuple([Type.TInt(32, true), Type.TStr]), clone: false })["__eq_.T4.i324.str"]
#test(Want { kind: 8, t: Type.TTuple([Type.TChar]), clone: false })["__thash_.T5.char"]
pub fun type_job_name(w: Want) -> str {
    if w.kind == 8 { return "__thash_" + mono_token(w.t) }
    if w.kind == 9 { return "__khash_" + mono_token(w.t) }
    if w.kind == 10 { return "__keq_" + mono_token(w.t) }
    if w.kind == 11 { return "__mfind_" + mono_token(w.t) }
    if w.kind == 12 { return "__mput_" + mono_token(w.t) }
    if w.kind == 13 { return "__mkeys_" + mono_token(w.t) }
    return "__eq_" + mono_token(w.t)
}

// An IR function `name` with nothing in it yet.
fun empty_ir(name: str) -> IrFunc {
    return IrFunc { name: name, ret: None, slots: [], temps: [], blocks: [], order: [], instances: [], frame: false, scope_parent: [-1] }
}

// The suffix naming a map type's helpers.
#test(Type.TChar, Type.TInt(32, true))["5.char4.i32"]
fun map_token(k: Type, v: Type) -> str {
    return lp(mono_token(k)) + lp(mono_token(v))
}

#test(32, true)[".i32"]
fun int_token(w: int32, s: bool) -> str {
    if s { return format(".i{}", w) }
    return format(".u{}", w)
}

#test("List", [])["List"]
#test("Account", [])["Account"]
#test("Result", [Type.TInt(32, true), Type.TStr])["Result__4.i324.str"]
fun agg_token(n: str, args: [Type]) -> str {
    if args.len() == 0 { return n }
    return format("{}__{}", n, join_tokens(args))
}

// A stable identifier fragment for a concrete type (used in mangled names).
#test(Type.TStr)[".str"]
#test(Type.TList(Type.TFloat(64)))[".L4.f64"]
#test(Type.TList(Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true)))))[".L13.F4.i32R4.i32"]
fun mono_token(t: Type) -> str {
    return match t {
        Type.TInt(w, s) => int_token(w, s),
        Type.TBool => ".bool",
        Type.TStr => ".str",
        Type.TChar => ".char",
        Type.TFloat(w) => format(".f{}", w),
        Type.TSB => ".sb",
        Type.TStruct(n, a) => agg_token(n, a),
        Type.TActor(n, a) => agg_token(n, a),
        Type.TEnum(n, a) => agg_token(n, a),
        Type.TTuple(es) => ".T" + join_tokens(es),
        Type.TList(e) => ".L" + lp(mono_token(e)),
        Type.TMap(k, v) => ".M" + map_token(k, v),
        Type.TFunc(ps, r) => ".F" + join_tokens(ps) + "R" + lp(ret_token(r)),
        Type.TAsync(f) => mono_token(f),
        Type.TParam(n) => n,
        _ => ".X",
    }
}

#test(Some(Type.TInt(32, true)))[".i32"]
fun ret_token(r: Option<Type>) -> str {
    return match r { Some(t) => mono_token(t), None => ".void" }
}

// The component types of a composite type, in a canonical order, so two types
// of the same shape line up positionally for unification.
#test(Type.TInt(32, true))[[]]
#test(Type.TList(Type.TStruct("Vec2", [])))[[Type.TStruct("Vec2", [])]]
#test(Type.TTuple([Type.TInt(32, true), Type.TInt(32, true)]))[[Type.TInt(32, true), Type.TInt(32, true)]]
fun parts_of(t: Type) -> [Type] {
    return match t {
        Type.TTuple(es) => es,
        Type.TStruct(n, a) => a,
        Type.TActor(n, a) => a,
        Type.TEnum(n, a) => a,
        Type.TList(e) => [e],
        Type.TMap(k, v) => [k, v],
        Type.TFunc(ps, r) => func_parts(ps, r),
        Type.TAsync(f) => parts_of(f),
        _ => [],
    }
}

#test([Type.TParam("T")], Some(Type.TParam("T")))[[Type.TParam("T"), Type.TParam("T")]]
#test([Type.TInt(32, true)], Some(Type.TInt(32, true)))[[Type.TInt(32, true), Type.TInt(32, true)]]
fun func_parts(ps: [Type], r: Option<Type>) -> [Type] {
    var out: [Type] = []
    for p in ps { out.push(p) }
    match r { Some(rt) => { out.push(rt) }, None => {} }
    return out
}

// Solve type-parameter bindings by structurally unifying a declared (possibly
// type-parametric) type against a concrete type.
#test(Type.TInt(32, true), Type.TInt(32, true))[[]]
#test(Type.TParam("T"), Type.TInt(32, true))[[Subst { name: "T", ty: Type.TInt(32, true) }]]
#test(Type.TTuple([Type.TParam("T"), Type.TParam("T")]), Type.TTuple([Type.TInt(32, true), Type.TInt(32, true)]))[[Subst { name: "T", ty: Type.TInt(32, true) }, Subst { name: "T", ty: Type.TInt(32, true) }]]
fun unify_into(declared: Type, concrete: Type) -> [Subst] {
    var out: [Subst] = []
    match declared {
        Type.TParam(n) => { out.push(Subst { name: n, ty: concrete }) },
        _ => {
            let ds = parts_of(declared)
            let cs = parts_of(concrete)
            var i = 0
            while i < ds.len() && i < cs.len() {
                for b in unify_into(ds[i], cs[i]) { out.push(b) }
                i = i + 1
            }
        },
    }
    return out
}

#test([], "a")[false]
#test([], "b")[false]
#test(["a"], "a")[true]
pub fun list_has_str(xs: [str], target: str) -> bool {
    for x in xs { if x == target { return true } }
    return false
}

// Return a fresh list with `s` appended (non-mutating: callers pass it down a
// recursion as a cycle-breaking "seen" set without disturbing the caller's).
#test([], "Box")[["Box"]]
#test([], "Money")[["Money"]]
#test(["Pixel"], "Vec2")[["Pixel", "Vec2"]]
fun push_str_copy(xs: [str], s: str) -> [str] {
    var out: [str] = []
    for x in xs { out.push(x) }
    out.push(s)
    return out
}

#test(Type.TStr)[true]
#test(Type.TChar)[false]
#test(Type.TFloat(32))[false]
pub fun is_tstr(t: Type) -> bool {
    return match t { Type.TStr => true, _ => false }
}

#test(Type.TChar)[true]
#test(Type.TFloat(64))[false]
#test(Type.TInt(8, true))[false]
fun is_tchar(t: Type) -> bool {
    return match t { Type.TChar => true, _ => false }
}

#test(Type.TChar)[false]
#test(Type.TFloat(64))[true]
#test(Type.TInt(8, true))[false]
fun is_tfloat(t: Type) -> bool {
    return match t { Type.TFloat(w) => true, _ => false }
}

#test(Type.TFloat(32))[true]
#test(Type.TFloat(64))[false]
pub fun is_tfloat32(t: Type) -> bool {
    return match t { Type.TFloat(w) => w == 32, _ => false }
}

// The runtime-error entries and their messages (MYLA-17), as in the Python
// backend (`_TRAPS`). `__panic` prints them after `runtime error: `.
#test()[["__trap_index", "__trap_key", "__trap_pop", "__trap_div", "__trap_mod", "__trap_match", "__trap_oom", "__trap_char", "__trap_step", "__trap_boundary"]]
pub fun trap_labels() -> [str] {
    return ["__trap_index", "__trap_key", "__trap_pop", "__trap_div", "__trap_mod", "__trap_match", "__trap_oom", "__trap_char", "__trap_step", "__trap_boundary"]
}

#test()[["index out of bounds", "map key not found", "pop from an empty list", "division by zero", "modulo by zero", "no match arm matched", "out of memory", "invalid char", "slice step is zero", "a slice bound inside a character"]]
fun trap_messages() -> [str] {
    return ["index out of bounds", "map key not found", "pop from an empty list", "division by zero", "modulo by zero", "no match arm matched", "out of memory", "invalid char", "slice step is zero", "a slice bound inside a character"]
}

// The DW_ATE encoding of a scalar type (MYLA-66).
#test(Type.TInt(32, true))[5]
#test(Type.TInt(8, false))[7]
#test(Type.TBool)[2]
#test(Type.TChar)[16]
#test(Type.TFloat(32))[4]
fun ate_of(t: Type) -> int32 {
    return match t {
        Type.TInt(w, signed) => match signed { true => ATE_SIGNED, false => ATE_UNSIGNED },
        Type.TBool => ATE_BOOLEAN,
        Type.TChar => ATE_UTF,
        _ => ATE_FLOAT,
    }
}

// Whether `name` is the compiler's own (`__…`), not shown to gdb.
#test("__tmp")[true]
#test("x")[false]
#test("_")[false]
pub fun is_internal_name(name: str) -> bool {
    // the compiler's names (`__…`) and the async normalizer's (`%aw1`, …)
    if name.len() >= 1 && name[0] == '%' { return true }
    return name.len() >= 2 && name[0] == '_' && name[1] == '_'
}

// The conditional jump that skips a trap call, for each jump to a trap.
#test("jae")["jb"]
#test("jz")["jnz"]
#test("jl")["jge"]
#test("jg")["jle"]
fun skip_trap(jump: str) -> str {
    if jump == "jae" { return "jb" }
    if jump == "jz" { return "jnz" }
    if jump == "jl" { return "jge" }
    return "jle"
}

// The bits of the double 2^k (-2^k when `neg`), as a signed immediate.
#test(31, false)[4746794007248502784]
#test(31, true)[-4476578029606273024]
fun pow2_bits(k: int32, neg: bool) -> int64 {
    let bits = ((1023 + k) as int64) << 52
    if neg { return bits | (1i64 << 63) }
    return bits
}

#test(Type.TChar)[false]
#test(Type.TInt(32, true))[true]
#test(Type.TInt(64, true))[true]
pub fun int_signed(t: Type) -> bool {
    return match t { Type.TInt(w, s) => s, _ => false }
}

#test(Type.TInt(8, false))[8]
#test(Type.TInt(32, true))[32]
pub fun int_width_cg(t: Type) -> int32 {
    return match t { Type.TInt(w, s) => w, _ => 64 }
}

// Whether the integer operator `op` takes its second operand as an
// immediate or from memory (`emit_int_op`); the others want it in %rcx.
#test("&")[true]
#test("*")[true]
#test("%")[false]
pub fun takes_operand(op: str) -> bool {
    return op == "+" || op == "-" || op == "*" || op == "&" || op == "|" || op == "^" || op == "==" || op == "!=" || is_cmp(op)
}

#test("$2")[true]
#test("$4")[true]
#test("%r9")[false]
fun starts_with_dollar(s: str) -> bool { return s.len() > 0 && s[0] == '$' }

// Myla's calling convention on x86-64 (D119, System V): the first six
// argument words in %rdi, %rsi, %rdx, %rcx, %r8 and %r9, the rest on the
// stack, which the caller pops; a function value's environment in %r10.
pub const REG_WORDS: int32 = 6

// The register of argument word `w` (below `REG_WORDS`).
#test(0)["rdi"]
#test(5)["r9"]
pub fun arg_reg(w: int32) -> str {
    let regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
    return regs[w]
}

// Where argument word `w` is once the prologue has stored the argument
// registers below the frame base: below it for a word that came in a
// register, above the return address for one that came on the stack.
#test(0)["-16(%rbp)"]
#test(5)["-56(%rbp)"]
#test(6)["16(%rbp)"]
pub fun spilled_word(w: int32) -> str {
    if w < REG_WORDS { return format("{}(%rbp)", -16 - 8 * w) }
    return format("{}(%rbp)", 16 + 8 * (w - REG_WORDS))
}

// The operand `v` (an immediate or a 64-bit register) for a `width`-byte
// access: a register's low part.
#test("%rax", 1)["%al"]
#test("%rdi", 2)["%di"]
#test("%r9", 4)["%r9d"]
#test("$7", 1)["$7"]
pub fun narrow_operand(v: str, width: int32) -> str {
    let wide = ["%rax", "%rbx", "%rcx", "%rdx", "%rsi", "%rdi"]
    let bytes = ["%al", "%bl", "%cl", "%dl", "%sil", "%dil"]
    let words = ["%ax", "%bx", "%cx", "%dx", "%si", "%di"]
    let dwords = ["%eax", "%ebx", "%ecx", "%edx", "%esi", "%edi"]
    var k = 0
    while k < wide.len() {
        if v == wide[k] {
            if width == 1 { return bytes[k] }
            if width == 2 { return words[k] }
            return dwords[k]
        }
        k = k + 1
    }
    let numbered = ["%r8", "%r9", "%r10", "%r11", "%r12", "%r13", "%r14", "%r15"]
    for r in numbered {
        if v == r {
            if width == 1 { return r + "b" }
            if width == 2 { return r + "w" }
            return r + "d"
        }
    }
    return v
}

// Whether the held-back store `s` is a move from %rax into a register
// (`movq %rax, %r12`), not into a frame cell.
#test("movq %rax, %r12")[true]
#test("movq %rax, -8(%rbp)")[false]
fun is_reg_move(s: str) -> bool {
    return s.len() > 12 && text_at(s, 0, "movq %rax, %") && !has_text(s, "(")
}

// The destination register of such a move.
#test("movq %rax, %rbx")["%rbx"]
fun reg_of_move(s: str) -> str {
    var sb = StringBuilder()
    sb.append(s, 11, s.len())
    return sb.build()
}

// The load `line` (`movq X, %rax` or `leaq X, %rax`, X not reading %rax)
// with `reg` as its destination instead; "" when it isn't one (MYLA-125).
// A narrower load into a general register too: `movl`, `movzbl` and
// `movzwl` into %eax take the register's 32-bit name, the sign-extending
// ones into %rax its own (MYLA-263: a byte compared with a byte).
#test("\tmovq 8(%rbx), %rax", "%r12")["\tmovq 8(%rbx), %r12"]
#test("\tleaq .L3(%rip), %rax", "%rbx")["\tleaq .L3(%rip), %rbx"]
#test("\tmovq %rcx, %rax", "%r12")["\tmovq %rcx, %r12"]
#test("\tmovq 8(%rax), %rax", "%r12")[""]
#test("\tmovslq %eax, %rax", "%r12")[""]
#test("\tmovq %rax, %rcx", "%r12")[""]
#test("\tmovzbl (%r9,%r8,1), %eax", "%rdi")["\tmovzbl (%r9,%r8,1), %edi"]
#test("\tmovl 8(%rbx), %eax", "%r12")["\tmovl 8(%rbx), %r12d"]
#test("\tmovsbq 8(%rbx), %rax", "%rsi")["\tmovsbq 8(%rbx), %rsi"]
#test("\tmovzbl (%rax), %eax", "%rdi")[""]
#test("\tmovzbl (%rbx), %eax", "%xmm1")[""]
#test("\tmovsbq 8(%rbx), %rax", "%xmm1")[""]
#test("\tmovzbl (%rbx), %rax", "%rdi")[""]
pub fun fold_load(line: str, reg: str) -> str {
    return retarget_load(line, reg, true)
}

// The same for the one reader of the loaded value (`load_temp`), which
// takes it in `reg`: a source reading %rax is fine, as nothing reads the
// value from %rax after it (MYLA-162).
#test("\tmovq 8(%rax), %rax", "%rdi")["\tmovq 8(%rax), %rdi"]
#test("\tmovzbl (%rax), %eax", "%rdi")["\tmovzbl (%rax), %edi"]
#test("\tmovslq %eax, %rax", "%r12")["\tmovslq %eax, %r12"]
#test("\tmovq %rax, %rcx", "%r12")[""]
pub fun fold_load_for_reader(line: str, reg: str) -> str {
    return retarget_load(line, reg, false)
}

// `fold_load` (`own_src`: the source must not read %rax) and
// `fold_load_for_reader`.
fun retarget_load(line: str, reg: str, own_src: bool) -> str {
    let full = text_at(line, 0, "\tmovq ") || text_at(line, 0, "\tleaq ")
    let sext = text_at(line, 0, "\tmovslq ") || text_at(line, 0, "\tmovswq ") || text_at(line, 0, "\tmovsbq ")
    let zext = text_at(line, 0, "\tmovl ") || text_at(line, 0, "\tmovzbl ") || text_at(line, 0, "\tmovzwl ")
    if !full && !sext && !zext { return "" }
    var head = 8
    if full || text_at(line, 0, "\tmovl ") { head = 6 }
    // into %rax, or into %eax for a zero-extending load
    if line.len() < head + 6 { return "" }
    if zext && !text_at(line, line.len() - 6, ", %eax") { return "" }
    if !zext && !text_at(line, line.len() - 6, ", %rax") { return "" }
    var dst = reg
    if !full {
        // only a general register takes these
        let r32 = reg32(reg)
        if r32 == "" { return "" }
        if zext { dst = r32 }
    }
    if own_src {
        var src = StringBuilder()
        src.append(line, head, line.len() - 6)
        let x = src.build()
        if has_text(x, "%rax") || has_text(x, "%eax") || has_text(x, "%ax") || has_text(x, "%al") { return "" }
    }
    var out = StringBuilder()
    out.append(line, 0, line.len() - 4)
    out.append(dst)
    return out.build()
}

// Whether `a` and `b` are the same integer type: an operation's result
// kept in its operands' type.
#test(Type.TInt(32, true), Type.TInt(32, true))[true]
#test(Type.TInt(32, true), Type.TInt(64, true))[false]
#test(Type.TBool, Type.TBool)[false]
pub fun same_int(a: Type, b: Type) -> bool {
    return match a {
        Type.TInt(w, s) => match b {
            Type.TInt(w2, s2) => w == w2 && s == s2,
            _ => false,
        },
        _ => false,
    }
}

// Whether `prev`, a register's re-extension (`movslq %r11d, %r11`), is
// moot because `line`, the instruction after it, writes that register's
// low 32 bits (clearing the rest) without reading memory through it: the
// low bits of its result don't depend on the upper half of what it reads
// (MYLA-251: `(y + n - 1) % n` re-extended `y + n` before taking 1 away).
#test("\tmovslq %r11d, %r11", "leal -1(%r11), %r11d")[true]
#test("\tmovslq %eax, %rax", "addl $1, %eax")[true]
#test("\tmovslq %r11d, %r11", "movl $0, %r11d")[true]
#test("\tmovslq %r11d, %r11", "negl %r11d")[true]
#test("\tmovslq %r11d, %r11", "leal -1(%r11), %r10d")[false]
#test("\tmovslq %r11d, %r11", "movl (%r11), %r11d")[false]
#test("\tmovslq %r11d, %r11", "cmpl $1, %r11d")[false]
#test("\tmovslq %r11d, %r11", "leal -1(%r11), %r11")[false]
#test("\tmovl %r11d, %r11d", "leal -1(%r11), %r11d")[false]
#test("\tmovslq %r11d, %r11", "addl %r10d, %r11d")[true]
#test("\tmovslq %r11d, %r11", "sarl $1, %r11d")[false]
#test("\tmovslq %eax, %r12", "addl $1, %eax")[false]
#test("\tmovslq %r11d, %r10", "leal -1(%r11), %r11d")[false]
pub fun extension_overwritten(prev: str, line: str) -> bool {
    if !text_at(prev, 0, "\tmovslq %") { return false }
    var at = 8
    while at < prev.len() && prev[at] != ',' as uint8 { at = at + 1 }
    if at >= prev.len() { return false }
    var r = StringBuilder()
    r.append(prev, 8, at)
    let r32 = r.build()
    // into the same register (a folded load may have moved it elsewhere)
    if !text_at(prev, at, ", " + reg64(r32)) || prev.len() != at + 2 + reg64(r32).len() { return false }
    var m = 0
    while m < line.len() && line[m] != ' ' as uint8 { m = m + 1 }
    var mb = StringBuilder()
    mb.append(line, 0, m)
    let op = mb.build()
    // one operand: the register itself
    if op == "negl" || op == "notl" { return line == op + " " + r32 }
    if !(op == "leal" || op == "addl" || op == "subl" || op == "imull" || op == "andl" || op == "orl" || op == "xorl" || op == "shll" || op == "movl") { return false }
    if !text_at(line, line.len() - r32.len() - 2, ", " + r32) { return false }
    // a memory operand reads the register's whole value
    return op == "leal" || !has_text(line, "(")
}

// The 64-bit name of the general register `r32` names the low half of.
#test("%eax")["%rax"]
#test("%r11d")["%r11"]
fun reg64(r32: str) -> str {
    var sb = StringBuilder()
    if text_at(r32, 0, "%e") {
        sb.append("%r")
        sb.append(r32, 2, r32.len())
    } else { sb.append(r32, 0, r32.len() - 1) }
    return sb.build()
}

// The 32-bit name of the general register `reg`; "" for another.
#test("%rdi")["%edi"]
#test("%rbx")["%ebx"]
#test("%r12")["%r12d"]
#test("%xmm1")[""]
#test("%rsp")[""]
fun reg32(reg: str) -> str {
    if reg == "%rbx" || reg == "%rcx" || reg == "%rdx" || reg == "%rsi" || reg == "%rdi" {
        var sb = StringBuilder()
        sb.append("%e")
        sb.append(reg, 2, reg.len())
        return sb.build()
    }
    if reg == "%r8" || reg == "%r9" || reg == "%r10" || reg == "%r11" || reg == "%r12" || reg == "%r13" || reg == "%r14" || reg == "%r15" { return reg + "d" }
    return ""
}

// Whether `s` holds `t` at byte `at`.
#test("abcd", 1, "bc")[true]
#test("abcd", 3, "de")[false]
pub fun text_at(s: str, at: int32, t: str) -> bool {
    if at < 0 || at + t.len() > s.len() { return false }
    var i = 0
    while i < t.len() {
        if s[at + i] != t[i] { return false }
        i = i + 1
    }
    return true
}

// Whether `t` occurs in `s`.
#test("8(%rax)", "%rax")[true]
#test("8(%rbx)", "%rax")[false]
pub fun has_text(s: str, t: str) -> bool {
    var i = 0
    while i + t.len() <= s.len() {
        if text_at(s, i, t) { return true }
        i = i + 1
    }
    return false
}

#test("<")[true]
#test(">")[true]
#test("%")[false]
pub fun is_cmp(op: str) -> bool {
    return op == "<" || op == "<=" || op == ">" || op == ">="
}

#test("<", true)["setl"]
#test("<=", false)["setbe"]
#test(">=", false)["setae"]
pub fun cmp_set(op: str, signed: bool) -> str {
    if op == "<" {
        if signed { return "setl" }
        return "setb"
    }
    if op == "<=" {
        if signed { return "setle" }
        return "setbe"
    }
    if op == ">" {
        if signed { return "setg" }
        return "seta"
    }
    if signed { return "setge" }
    return "setae"
}

// `s` as the body of an assembler string literal (a `.file` path).
#test("examples/maps.my")["examples/maps.my"]
#test("examples/floats.my")["examples/floats.my"]
#test("examples/closures.my")["examples/closures.my"]
fun asm_string(s: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < s.len() {
        let c = s[i]
        if c == '\\' || c == '"' { sb.append_byte('\\') }
        sb.append_byte(c)
        i = i + 1
    }
    return sb.build()
}
