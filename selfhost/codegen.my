}

// An async function type as its function type: with one task, an async
// function runs as an ordinary one (D91, MYLA-138).
#test(Type.TAsync(Type.TFunc([], None)))[Type.TFunc([], None)]
#test(Type.TAsync(Type.TFunc([], Some(Type.TInt(32, true)))))[Type.TFunc([], Some(Type.TInt(32, true)))]
#test(Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true))))[Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true)))]
pub fun unasync(t: Type) -> Type {
    return match t { Type.TAsync(f) => f, _ => t }
}

