    // __char_to_str: rdi = Unicode scalar -> rax = its UTF-8 text as a str.
    fun char_to_str_text(self) -> [str] {
        return [
            "\n__char_to_str:\n\tpushq %rbp\n\tmovq %rsp, %rbp\n\tsubq $16, %rsp\n\tmovq %rdi, %rax\n\tcmpq $0x80, %rax\n\tjae .Lc2s_2\n\tmovb %al, -8(%rbp)\n\tmovq $1, %r8\n\tjmp .Lc2s_emit\n.Lc2s_2:\n\tcmpq $0x800, %rax\n\tjae .Lc2s_3\n\tmovq %rax, %rcx\n\tshrq $6, %rcx\n\torq $0xC0, %rcx\n\tmovb %cl, -8(%rbp)\n\tmovq %rax, %rcx\n\tandq $0x3F, %rcx\n\torq $0x80, %rcx\n\tmovb %cl, -7(%rbp)\n\tmovq $2, %r8\n\tjmp .Lc2s_emit\n.Lc2s_3:\n\tcmpq $0x10000, %rax\n\tjae .Lc2s_4\n\tmovq %rax, %rcx\n\tshrq $12, %rcx\n\torq $0xE0, %rcx\n\tmovb %cl, -8(%rbp)\n\tmovq %rax, %rcx\n\tshrq $6, %rcx\n\tandq $0x3F, %rcx\n\torq $0x80, %rcx\n\tmovb %cl, -7(%rbp)\n\tmovq %rax, %rcx\n\tandq $0x3F, %rcx\n\torq $0x80, %rcx\n\tmovb %cl, -6(%rbp)",
            "\tmovq $3, %r8\n\tjmp .Lc2s_emit\n.Lc2s_4:\n\tmovq %rax, %rcx\n\tshrq $18, %rcx\n\tandq $0x07, %rcx\n\torq $0xF0, %rcx\n\tmovb %cl, -8(%rbp)\n\tmovq %rax, %rcx\n\tshrq $12, %rcx\n\tandq $0x3F, %rcx\n\torq $0x80, %rcx\n\tmovb %cl, -7(%rbp)\n\tmovq %rax, %rcx\n\tshrq $6, %rcx\n\tandq $0x3F, %rcx\n\torq $0x80, %rcx\n\tmovb %cl, -6(%rbp)\n\tmovq %rax, %rcx\n\tandq $0x3F, %rcx\n\torq $0x80, %rcx\n\tmovb %cl, -5(%rbp)\n\tmovq $4, %r8\n.Lc2s_emit:\n\tleaq 8(%r8), %rdi\n\tpushq %r8\n\tcall __alloc\n\tpopq %r8\n\tmovq %r8, (%rax)\n\tleaq 8(%rax), %rdi\n\tleaq -8(%rbp), %rsi\n\tmovq %r8, %rcx\n\tcld\n\tpushq %rax\n\trep movsb\n\tpopq %rax\n\tleave\n\tret\n",
        ]
    }

    // -- END generated runtime

    // Synthesize `{T}.eq(self, other) -> bool` for each `#derive(Eq)` type:
    // structural equality, field-by-field / tag-and-payload, recursing through
    // each component's own `eq` (user or derived).
    fun emit_derived_eq(var self) {
        for d in self.decls {
            match d.kind {
                DeclKind.StructDecl(name, fields, attrs, tps, isp) => {
                    if len(tps) == 0 && attrs_have_derive_eq(attrs) { self.emit_struct_eq(name) }
                },
                DeclKind.EnumDecl(name, variants, attrs, tps, isp) => {
                    if len(tps) == 0 && attrs_have_derive_eq(attrs) { self.emit_enum_eq(name) }
                },
                _ => {},
            }
        }
    }

    fun emit_struct_eq(var self, name: str) {
        let lne = self.label()
        let lend = self.label()
        self.emit(format("myla_{}.eq:", name))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        var off = 0
        for f in self.struct_info(name).fields {
            self.emit_eq_component(off, f.ty, lne)
            off = off + self.stored_size(f.ty)
        }
        self.emit("movq $1, %rax")
        self.emit(format("jmp {}", lend))
        self.emit(format("{}:", lne))
        self.emit("movq $0, %rax")
        self.emit(format("{}:", lend))
        self.emit("popq %rbp")
        self.emit("ret")
    }

    fun emit_enum_eq(var self, name: str) {
        let lne = self.label()
        let lend = self.label()
        self.emit(format("myla_{}.eq:", name))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        self.emit("movq 16(%rbp), %rax")
        self.emit("movq 0(%rax), %rax")
        self.emit("movq 24(%rbp), %rcx")
        self.emit("movq 0(%rcx), %rcx")
        self.emit("cmpq %rcx, %rax")
        self.emit(format("jne {}", lne))
        var i = 0
        for v in self.enum_info(name).variants {
            if len(v.payload) > 0 {
                let lskip = self.label()
                self.emit("movq 16(%rbp), %rax")
                self.emit("movq 0(%rax), %rax")
                self.emit(format("cmpq ${}, %rax", i))
                self.emit(format("jne {}", lskip))
                var j = 0
                for pt in v.payload {
                    self.emit_eq_component(self.variant_field_offset(Type.TEnum(name, []), v.name, j), pt, lne)
                    j = j + 1
                }
                self.emit(format("{}:", lskip))
            }
            i = i + 1
        }
        self.emit("movq $1, %rax")
        self.emit(format("jmp {}", lend))
        self.emit(format("{}:", lne))
        self.emit("movq $0, %rax")
        self.emit(format("{}:", lend))
        self.emit("popq %rbp")
        self.emit("ret")
    }

    // Compare the component of type `ft` at byte offset `off` in the two cells
    // pointed to by 16(%rbp) (self) and 24(%rbp) (other); jump to `lne` if unequal.
    // A boxed (recursive) enum component holds a pointer to its value, which is
    // what `eq` takes (MYLA-23); any other aggregate is passed by its address.
    fun emit_eq_component(var self, off: int32, ft: Type, lne: str) {
        if is_struct_or_enum_t(ft) {
            var load = "leaq"
            if self.is_boxed(ft) { load = "movq" }
            self.emit("movq 24(%rbp), %rax")
            self.emit(format("{} {}(%rax), %rax", load, off))
            self.emit("pushq %rax")
            self.emit("movq 16(%rbp), %rax")
            self.emit(format("{} {}(%rax), %rax", load, off))
            self.emit("pushq %rax")
            self.emit(format("call myla_{}.eq", self.type_key(ft)))
            self.emit("addq $16, %rsp")
            self.emit("testq %rax, %rax")
            self.emit(format("jz {}", lne))
        } else if is_tstr(ft) {
            self.emit("movq 16(%rbp), %rax")
            self.emit(format("movq {}(%rax), %rdi", off))
            self.emit("movq 24(%rbp), %rax")
            self.emit(format("movq {}(%rax), %rsi", off))
            self.emit("call __str_eq")
            self.emit("testq %rax, %rax")
            self.emit(format("jz {}", lne))
        } else if is_tfloat(ft) {
            // as `==` does: NaN is unequal to everything, 0.0 equals -0.0 (MYLA-13)
            self.uses_float = true
            self.emit("movq 16(%rbp), %rax")
            self.emit(format("movq {}(%rax), %xmm0", off))
            self.emit("movq 24(%rbp), %rax")
            self.emit(format("movq {}(%rax), %xmm1", off))
            self.emit("ucomisd %xmm1, %xmm0")
            self.emit(format("jne {}", lne))
            self.emit(format("jp {}", lne))
        } else {
            self.emit("movq 16(%rbp), %rax")
            self.emit(format("movq {}(%rax), %rax", off))
            self.emit("movq 24(%rbp), %rcx")
            self.emit(format("movq {}(%rcx), %rcx", off))
            self.emit("cmpq %rcx, %rax")
            self.emit(format("jne {}", lne))
        }
    }

    // char support: UTF-8 encode for printing, UTF-8 decode for `chars`.
    fun emit_char_runtime(var self) {
        // __print_char: rdi = Unicode scalar -> write its UTF-8 bytes + newline.
        self.raw("__print_char:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tsubq $16, %rsp")
        self.raw("\tmovq %rdi, %rax")
        self.raw("\tleaq -16(%rbp), %rsi")
        self.raw("\tcmpq $0x80, %rax")
        self.raw("\tjb .Lpc1")
        self.raw("\tcmpq $0x800, %rax")
        self.raw("\tjb .Lpc2")
        self.raw("\tcmpq $0x10000, %rax")
        self.raw("\tjb .Lpc3")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tshrq $18, %rcx")
        self.raw("\torq $0xF0, %rcx")
        self.raw("\tmovb %cl, (%rsi)")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tshrq $12, %rcx")
        self.raw("\tandq $0x3F, %rcx")
        self.raw("\torq $0x80, %rcx")
        self.raw("\tmovb %cl, 1(%rsi)")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tshrq $6, %rcx")
        self.raw("\tandq $0x3F, %rcx")
        self.raw("\torq $0x80, %rcx")
        self.raw("\tmovb %cl, 2(%rsi)")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tandq $0x3F, %rcx")
        self.raw("\torq $0x80, %rcx")
        self.raw("\tmovb %cl, 3(%rsi)")
        self.raw("\tmovq $4, %rdx")
        self.raw("\tjmp .Lpc_write")
        self.raw(".Lpc3:")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tshrq $12, %rcx")
        self.raw("\torq $0xE0, %rcx")
        self.raw("\tmovb %cl, (%rsi)")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tshrq $6, %rcx")
        self.raw("\tandq $0x3F, %rcx")
        self.raw("\torq $0x80, %rcx")
        self.raw("\tmovb %cl, 1(%rsi)")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tandq $0x3F, %rcx")
        self.raw("\torq $0x80, %rcx")
        self.raw("\tmovb %cl, 2(%rsi)")
        self.raw("\tmovq $3, %rdx")
        self.raw("\tjmp .Lpc_write")
        self.raw(".Lpc2:")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tshrq $6, %rcx")
        self.raw("\torq $0xC0, %rcx")
        self.raw("\tmovb %cl, (%rsi)")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tandq $0x3F, %rcx")
        self.raw("\torq $0x80, %rcx")
        self.raw("\tmovb %cl, 1(%rsi)")
        self.raw("\tmovq $2, %rdx")
        self.raw("\tjmp .Lpc_write")
        self.raw(".Lpc1:")
        self.raw("\tmovb %al, (%rsi)")
        self.raw("\tmovq $1, %rdx")
        self.raw(".Lpc_write:")
        self.raw("\tmovq $1, %rdi")
        self.raw("\tcall __write_all")
        self.raw("\tcall __print_nl")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
        // __str_chars: rdi = str cell -> rax = [char] list: the scalar of each
        // well-formed UTF-8 sequence, and U+FFFD for each byte that isn't part of
        // one (a str read from a file needn't be UTF-8, MYLA-12).
        self.raw("__str_chars:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tpushq %r15")
        self.raw("\tsubq $8, %rsp")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq (%rbx), %r12")
        self.raw("\tleaq 8(%rbx), %r13")
        self.raw("\tmovq %r12, %rax")
        self.raw("\tshlq $3, %rax")
        self.raw("\taddq $16, %rax")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tcall __alloc")
        self.raw("\tmovq %rax, %r14")
        self.raw("\txorq %r15, %r15")
        self.raw("\tmovq $0, -48(%rbp)")
        self.raw(".Lsc_loop:")
        self.raw("\tcmpq %r12, %r15")
        self.raw("\tjae .Lsc_done")
        self.raw("\tmovzbq (%r13,%r15), %rax")
        self.raw("\tcmpq $0x80, %rax")
        self.raw("\tjb .Lsc_1")
        // a lead byte: rdx = the sequence length, rcx = its payload bits, r8 =
        // the least scalar of that length (shorter is overlong)
        self.raw("\tcmpq $0xC2, %rax")
        self.raw("\tjb .Lsc_bad")
        self.raw("\tcmpq $0xE0, %rax")
        self.raw("\tjb .Lsc_lead2")
        self.raw("\tcmpq $0xF0, %rax")
        self.raw("\tjb .Lsc_lead3")
        self.raw("\tcmpq $0xF5, %rax")
        self.raw("\tjae .Lsc_bad")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tandq $0x07, %rcx")
        self.raw("\tmovq $4, %rdx")
        self.raw("\tmovq $0x10000, %r8")
        self.raw("\tjmp .Lsc_seq")
        self.raw(".Lsc_lead3:")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tandq $0x0F, %rcx")
        self.raw("\tmovq $3, %rdx")
        self.raw("\tmovq $0x800, %r8")
        self.raw("\tjmp .Lsc_seq")
        self.raw(".Lsc_lead2:")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tandq $0x1F, %rcx")
        self.raw("\tmovq $2, %rdx")
        self.raw("\tmovq $0x80, %r8")
        self.raw(".Lsc_seq:")
        self.raw("\tleaq (%r15,%rdx), %r9")
        self.raw("\tcmpq %r12, %r9")
        self.raw("\tja .Lsc_bad")
        self.raw("\tleaq (%r13,%r15), %r11")
        self.raw("\tmovq $1, %r10")
        self.raw(".Lsc_cont:")
        self.raw("\tmovzbq (%r11,%r10), %rax")
        self.raw("\tmovq %rax, %rsi")
        self.raw("\tandq $0xC0, %rsi")
        self.raw("\tcmpq $0x80, %rsi")
        self.raw("\tjne .Lsc_bad")
        self.raw("\tshlq $6, %rcx")
        self.raw("\tandq $0x3F, %rax")
        self.raw("\torq %rax, %rcx")
        self.raw("\tincq %r10")
        self.raw("\tcmpq %rdx, %r10")
        self.raw("\tjb .Lsc_cont")
        self.raw("\tcmpq %r8, %rcx")
        self.raw("\tjb .Lsc_bad")
        self.raw("\tcmpq $0x10FFFF, %rcx")
        self.raw("\tja .Lsc_bad")
        self.raw("\tmovq %rcx, %rax")
        self.raw("\tandq $-2048, %rax")
        self.raw("\tcmpq $0xD800, %rax")
        self.raw("\tje .Lsc_bad")
        self.raw("\tmovq %r9, %r15")
        self.raw("\tjmp .Lsc_store")
        // U+FFFD for a byte that isn't part of a well-formed sequence
        self.raw(".Lsc_bad:")
        self.raw("\tmovq $0xFFFD, %rcx")
        self.raw("\tincq %r15")
        self.raw("\tjmp .Lsc_store")
        self.raw(".Lsc_1:")
        self.raw("\tmovq %rax, %rcx")
        self.raw("\tincq %r15")
        self.raw(".Lsc_store:")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\tleaq 16(%r14,%rax,8), %rdx")
        self.raw("\tmovq %rcx, (%rdx)")
        self.raw("\tincq %rax")
        self.raw("\tmovq %rax, -48(%rbp)")
        self.raw("\tjmp .Lsc_loop")
        self.raw(".Lsc_done:")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\tmovq %rax, (%r14)")
        self.raw("\tmovq %r12, 8(%r14)")
        self.raw("\tmovq %r14, %rax")
        self.raw("\taddq $8, %rsp")
        self.raw("\tpopq %r15")
        self.raw("\tpopq %r14")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
    }

    // Map cell: [count:8][cap:8][slot0..]; slot = [state:8][key:8][value…] where
    // state 0=empty, 1=occupied, 2=tombstone. Open addressing, linear probing,
    // FNV-1a hashing. cap is a power of two. Copy-on-write clones are per type
    // (`__clone_map_*`, emit_map_clone_helper) and retain the values they share.
    fun emit_map_runtime(var self) {
        // __map_hash: rsi=key (value or str cell), rcx=is_str -> rax=hash.
        self.raw("__map_hash:")
        self.raw("\tmovabsq $-3750763034362895579, %rax")
        self.raw("\tmovabsq $1099511628211, %r8")
        self.raw("\ttestq %rcx, %rcx")
        self.raw("\tjnz .Lhash_str")
        self.raw("\tmovq %rsi, %r9")
        self.raw("\tmovq $8, %rcx")
        self.raw(".Lhash_int_loop:")
        self.raw("\ttestq %rcx, %rcx")
        self.raw("\tjz .Lhash_done")
        self.raw("\tmovzbq %r9b, %r10")
        self.raw("\txorq %r10, %rax")
        self.raw("\timulq %r8, %rax")
        self.raw("\tshrq $8, %r9")
        self.raw("\tdecq %rcx")
        self.raw("\tjmp .Lhash_int_loop")
        self.raw(".Lhash_str:")
        self.raw("\tmovq (%rsi), %rcx")
        self.raw("\tleaq 8(%rsi), %r9")
        self.raw(".Lhash_str_loop:")
        self.raw("\ttestq %rcx, %rcx")
        self.raw("\tjz .Lhash_done")
        self.raw("\tmovzbq (%r9), %r10")
        self.raw("\txorq %r10, %rax")
        self.raw("\timulq %r8, %rax")
        self.raw("\tincq %r9")
        self.raw("\tdecq %rcx")
        self.raw("\tjmp .Lhash_str_loop")
        self.raw(".Lhash_done:")
        self.raw("\tret")
        self.raw("")
        // __key_eq: rdi=slot key, rsi=key, rcx=is_str -> rax=1/0.
        self.raw("__key_eq:")
        self.raw("\ttestq %rcx, %rcx")
        self.raw("\tjnz .Lkeq_str")
        self.raw("\txorq %rax, %rax")
        self.raw("\tcmpq %rsi, %rdi")
        self.raw("\tsete %al")
        self.raw("\tret")
        self.raw(".Lkeq_str:")
        self.raw("\tjmp __str_eq")
        self.raw("")
        // __map_new: rdi=cap, rsi=slot_size -> rax=zeroed cell.
        self.raw("__map_new:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r12")
        self.raw("\tmovq %rbx, %rax")
        self.raw("\timulq %r12, %rax")
        self.raw("\taddq $16, %rax")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tcall __alloc")
        self.raw("\tmovq %rax, %r13")
        self.raw("\tmovq $0, (%r13)")
        self.raw("\tmovq %rbx, 8(%r13)")
        self.raw("\tleaq 16(%r13), %rdi")
        self.raw("\tmovq %rbx, %rcx")
        self.raw("\timulq %r12, %rcx")
        self.raw("\txorq %rax, %rax")
        self.raw("\tcld")
        self.raw("\trep stosb")
        self.raw("\tmovq %r13, %rax")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
        // __map_lookup: rdi=cell, rsi=key, rdx=slot_size, rcx=is_str
        //   -> rax = occupied matching slot, or 0.
        self.raw("__map_lookup:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tsubq $16, %rsp")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r12")
        self.raw("\tmovq %rdx, %r13")
        self.raw("\tmovq %rcx, %r14")
        self.raw("\tmovq %r12, %rsi")
        self.raw("\tmovq %r14, %rcx")
        self.raw("\tcall __map_hash")
        self.raw("\tmovq 8(%rbx), %rcx")
        self.raw("\tdecq %rcx")
        self.raw("\tandq %rcx, %rax")
        self.raw("\tmovq %rax, -40(%rbp)")
        self.raw(".Llk_loop:")
        self.raw("\tmovq -40(%rbp), %rax")
        self.raw("\tmovq %rax, %r9")
        self.raw("\timulq %r13, %r9")
        self.raw("\tleaq 16(%rbx,%r9), %r8")
        self.raw("\tmovq (%r8), %rcx")
        self.raw("\ttestq %rcx, %rcx")
        self.raw("\tjz .Llk_none")
        self.raw("\tcmpq $2, %rcx")
        self.raw("\tje .Llk_next")
        self.raw("\tmovq %r8, -48(%rbp)")
        self.raw("\tmovq 8(%r8), %rdi")
        self.raw("\tmovq %r12, %rsi")
        self.raw("\tmovq %r14, %rcx")
        self.raw("\tcall __key_eq")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjz .Llk_next")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\tjmp .Llk_done")
        self.raw(".Llk_next:")
        self.raw("\tmovq -40(%rbp), %rax")
        self.raw("\tincq %rax")
        self.raw("\tmovq 8(%rbx), %rcx")
        self.raw("\tdecq %rcx")
        self.raw("\tandq %rcx, %rax")
        self.raw("\tmovq %rax, -40(%rbp)")
        self.raw("\tjmp .Llk_loop")
        self.raw(".Llk_none:")
        self.raw("\txorq %rax, %rax")
        self.raw(".Llk_done:")
        self.raw("\taddq $16, %rsp")
        self.raw("\tpopq %r14")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
        // __map_set_slot: rdi=cell, rsi=key, rdx=slot_size, rcx=is_str -> rax=slot,
        // rdx=1 when the key was already there (its value is being replaced).
        // Returns an existing match, else claims an empty/tombstone slot (sets
        // state+key, bumps count, retains a str key: MYLA-18). Assumes room
        // exists (caller reserved).
        self.raw("__map_set_slot:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tsubq $32, %rsp")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r12")
        self.raw("\tmovq %rdx, %r13")
        self.raw("\tmovq %rcx, %r14")
        self.raw("\tmovq %r12, %rsi")
        self.raw("\tmovq %r14, %rcx")
        self.raw("\tcall __map_hash")
        self.raw("\tmovq 8(%rbx), %rcx")
        self.raw("\tdecq %rcx")
        self.raw("\tandq %rcx, %rax")
        self.raw("\tmovq %rax, -40(%rbp)")
        self.raw("\tmovq $0, -48(%rbp)")
        self.raw(".Lss_loop:")
        self.raw("\tmovq -40(%rbp), %rax")
        self.raw("\tmovq %rax, %r9")
        self.raw("\timulq %r13, %r9")
        self.raw("\tleaq 16(%rbx,%r9), %r8")
        self.raw("\tmovq (%r8), %rcx")
        self.raw("\ttestq %rcx, %rcx")
        self.raw("\tjz .Lss_empty")
        self.raw("\tcmpq $2, %rcx")
        self.raw("\tje .Lss_tomb")
        self.raw("\tmovq %r8, -56(%rbp)")
        self.raw("\tmovq 8(%r8), %rdi")
        self.raw("\tmovq %r12, %rsi")
        self.raw("\tmovq %r14, %rcx")
        self.raw("\tcall __key_eq")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjz .Lss_next")
        self.raw("\tmovq -56(%rbp), %rax")
        self.raw("\tmovq $1, %rdx")             // the key was there: its value is replaced
        self.raw("\tjmp .Lss_done")
        self.raw(".Lss_tomb:")
        self.raw("\tcmpq $0, -48(%rbp)")
        self.raw("\tjne .Lss_next")
        self.raw("\tmovq %r8, -48(%rbp)")
        self.raw(".Lss_next:")
        self.raw("\tmovq -40(%rbp), %rax")
        self.raw("\tincq %rax")
        self.raw("\tmovq 8(%rbx), %rcx")
        self.raw("\tdecq %rcx")
        self.raw("\tandq %rcx, %rax")
        self.raw("\tmovq %rax, -40(%rbp)")
        self.raw("\tjmp .Lss_loop")
        self.raw(".Lss_empty:")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjnz .Lss_claim")
        self.raw("\tmovq %r8, %rax")
        self.raw(".Lss_claim:")
        self.raw("\txorq %rdx, %rdx")           // a new key
        self.raw("\tmovq $1, (%rax)")
        self.raw("\tmovq %r12, 8(%rax)")
        self.raw("\tincq (%rbx)")
        self.raw("\ttestq %r14, %r14")
        self.raw("\tjz .Lss_done")
        self.raw("\tincq -8(%r12)")             // the map holds a reference
        self.raw(".Lss_done:")
        self.raw("\taddq $32, %rsp")
        self.raw("\tpopq %r14")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
        // __map_grow: rdi=cell, rsi=slot_size, rcx=is_str -> rax=doubled, rehashed cell.
        self.raw("__map_grow:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tpushq %r15")
        self.raw("\tsubq $24, %rsp")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r13")
        self.raw("\tmovq %rcx, %r14")
        self.raw("\tmovq 8(%rbx), %rax")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjnz .Lmg_dbl")
        self.raw("\tmovq $8, %r12")
        self.raw("\tjmp .Lmg_new")
        self.raw(".Lmg_dbl:")
        self.raw("\tmovq %rax, %r12")
        self.raw("\tshlq $1, %r12")
        self.raw(".Lmg_new:")
        self.raw("\tmovq %r12, %rdi")
        self.raw("\tmovq %r13, %rsi")
        self.raw("\tcall __map_new")
        self.raw("\tmovq %rax, %r15")
        self.raw("\tmovq $0, -48(%rbp)")
        self.raw(".Lmg_loop:")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\tcmpq 8(%rbx), %rax")
        self.raw("\tjae .Lmg_done")
        self.raw("\tmovq %rax, %r9")
        self.raw("\timulq %r13, %r9")
        self.raw("\tleaq 16(%rbx,%r9), %r8")
        self.raw("\tmovq (%r8), %rcx")
        self.raw("\tcmpq $1, %rcx")
        self.raw("\tjne .Lmg_skip")
        self.raw("\tmovq %r15, %rdi")
        self.raw("\tmovq 8(%r8), %rsi")
        self.raw("\tmovq %r13, %rdx")
        self.raw("\tmovq %r14, %rcx")
        self.raw("\tmovq %r8, -56(%rbp)")
        self.raw("\tcall __map_set_slot")
        self.raw("\tmovq -56(%rbp), %r8")
        self.raw("\ttestq %r14, %r14")
        self.raw("\tjz .Lmg_moved")
        self.raw("\tmovq 8(%r8), %rcx")
        self.raw("\tdecq -8(%rcx)")             // the key moved: the new cell holds one
        self.raw(".Lmg_moved:")
        self.raw("\tleaq 16(%rax), %rdi")
        self.raw("\tleaq 16(%r8), %rsi")
        self.raw("\tmovq %r13, %rcx")
        self.raw("\tsubq $16, %rcx")
        self.raw("\tcld")
        self.raw("\trep movsb")
        self.raw(".Lmg_skip:")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\tincq %rax")
        self.raw("\tmovq %rax, -48(%rbp)")
        self.raw("\tjmp .Lmg_loop")
        self.raw(".Lmg_done:")
        // Free the old (unique) cell, then return the rehashed one.
        self.raw("\tmovq %rbx, %rdi")
        self.raw("\tcall __free")
        self.raw("\tmovq %r15, %rax")
        self.raw("\taddq $24, %rsp")
        self.raw("\tpopq %r15")
        self.raw("\tpopq %r14")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
        // __map_rebuild: rdi=cell, rsi=slot_size, rcx=is_str -> rax = a cell of
        // the same capacity without tombstones, so a probe always ends at an
        // empty slot (`remove` rebuilds, like the Python backend's, MYLA-18).
        // Same frame as __map_grow, whose body it shares.
        self.raw("__map_rebuild:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tpushq %r15")
        self.raw("\tsubq $24, %rsp")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r13")
        self.raw("\tmovq %rcx, %r14")
        self.raw("\tmovq 8(%rbx), %r12")
        self.raw("\tjmp .Lmg_new")
        self.raw("")
        // __map_reserve: rdi=&holder, rsi=slot_size, rcx=is_str. Grows (writing
        // the new cell back through the holder) when empty or above 0.75 load.
        self.raw("__map_reserve:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r12")
        self.raw("\tmovq %rcx, %r13")
        self.raw("\tmovq (%rbx), %rdi")
        self.raw("\tmovq 8(%rdi), %rax")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjz .Lmr_grow")
        self.raw("\tmovq (%rdi), %rcx")
        self.raw("\tincq %rcx")
        self.raw("\timulq $4, %rcx")
        self.raw("\tmovq %rax, %rdx")
        self.raw("\timulq $3, %rdx")
        self.raw("\tcmpq %rdx, %rcx")
        self.raw("\tjb .Lmr_done")
        self.raw(".Lmr_grow:")
        self.raw("\tmovq (%rbx), %rdi")
        self.raw("\tmovq %r12, %rsi")
        self.raw("\tmovq %r13, %rcx")
        self.raw("\tcall __map_grow")
        self.raw("\tmovq %rax, (%rbx)")
        self.raw(".Lmr_done:")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
        // __map_keys: rdi=cell, rsi=slot_size, rdx=key_stride, rcx=is_str -> rax=[K]
        // list cell, which holds a reference to each str key (MYLA-18).
        self.raw("__map_keys:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tpushq %r15")
        self.raw("\tsubq $24, %rsp")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r13")
        self.raw("\tmovq %rdx, %r14")
        self.raw("\tmovq %rcx, -64(%rbp)")
        self.raw("\tmovq (%rbx), %rax")
        self.raw("\tmovq %rax, %r12")
        self.raw("\timulq %r14, %rax")
        self.raw("\taddq $16, %rax")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tcall __alloc")
        self.raw("\tmovq %rax, %r15")
        self.raw("\tmovq %r12, (%r15)")
        self.raw("\tmovq %r12, 8(%r15)")
        self.raw("\tmovq $0, -48(%rbp)")
        self.raw("\tmovq $0, -56(%rbp)")
        self.raw(".Lmk_loop:")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\tcmpq 8(%rbx), %rax")
        self.raw("\tjae .Lmk_done")
        self.raw("\tmovq %rax, %r9")
        self.raw("\timulq %r13, %r9")
        self.raw("\tleaq 16(%rbx,%r9), %r8")
        self.raw("\tmovq (%r8), %rcx")
        self.raw("\tcmpq $1, %rcx")
        self.raw("\tjne .Lmk_skip")
        self.raw("\tmovq 8(%r8), %rcx")
        self.raw("\tcmpq $0, -64(%rbp)")
        self.raw("\tje .Lmk_noinc")
        self.raw("\tincq -8(%rcx)")
        self.raw(".Lmk_noinc:")
        self.raw("\tmovq -56(%rbp), %rax")
        self.raw("\tmovq %rax, %r9")
        self.raw("\timulq %r14, %r9")
        self.raw("\tleaq 16(%r15,%r9), %r10")
        self.raw("\tmovq %rcx, (%r10)")
        self.raw("\tincq %rax")
        self.raw("\tmovq %rax, -56(%rbp)")
        self.raw(".Lmk_skip:")
        self.raw("\tmovq -48(%rbp), %rax")
        self.raw("\tincq %rax")
        self.raw("\tmovq %rax, -48(%rbp)")
        self.raw("\tjmp .Lmk_loop")
        self.raw(".Lmk_done:")
        self.raw("\tmovq %r15, %rax")
        self.raw("\taddq $24, %rsp")
        self.raw("\tpopq %r15")
        self.raw("\tpopq %r14")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
    }

    // StringBuilder cell: [len:8][cap:8][bytes…] (cap is a byte capacity).
    fun emit_sb_runtime(var self) {
        // __sb_append_bytes: rdi=&holder, rsi=src bytes, rdx=count. Grows/reallocs
        // the builder (writing the new pointer back through the holder) and copies.
        self.raw("__sb_append_bytes:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tpushq %r15")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r12")
        self.raw("\tmovq %rdx, %r13")
        self.raw("\tmovq (%rbx), %r14")
        self.raw("\tmovq (%r14), %r15")
        self.raw("\tleaq (%r15,%r13), %rax")
        self.raw("\tcmpq 8(%r14), %rax")
        self.raw("\tjbe .Lsba_fit")
        // Grow geometrically (new cap = max(newlen, 2*oldcap)) so building a
        // large buffer line-by-line stays O(n) rather than O(n^2) realloc churn,
        // which would otherwise exhaust the heap arena.
        self.raw("\tmovq 8(%r14), %rdx")
        self.raw("\taddq %rdx, %rdx")
        self.raw("\tcmpq %rax, %rdx")
        self.raw("\tjae .Lsba_capa")
        self.raw("\tmovq %rax, %rdx")
        self.raw(".Lsba_capa:")
        self.raw("\tleaq 16(%rdx), %rdi")
        self.raw("\tcall __alloc")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tmovq %r14, %rsi")
        self.raw("\tleaq 16(%r15), %rcx")
        self.raw("\tpushq %rax")
        self.raw("\tcld")
        self.raw("\trep movsb")
        self.raw("\tpopq %rax")
        // Recompute new cap (r14 still references the old cell) and store it.
        self.raw("\tmovq 8(%r14), %rdx")
        self.raw("\taddq %rdx, %rdx")
        self.raw("\tleaq (%r15,%r13), %rcx")
        self.raw("\tcmpq %rcx, %rdx")
        self.raw("\tjae .Lsba_capb")
        self.raw("\tmovq %rcx, %rdx")
        self.raw(".Lsba_capb:")
        self.raw("\tmovq %rdx, 8(%rax)")
        // Free the old (unique) builder cell before publishing the new one.
        self.raw("\tpushq %rax")
        self.raw("\tmovq %r14, %rdi")
        self.raw("\tcall __free")
        self.raw("\tpopq %rax")
        self.raw("\tmovq %rax, %r14")
        self.raw("\tmovq %r14, (%rbx)")
        self.raw(".Lsba_fit:")
        self.raw("\tleaq 16(%r14), %rdi")
        self.raw("\taddq %r15, %rdi")
        self.raw("\tmovq %r12, %rsi")
        self.raw("\tmovq %r13, %rcx")
        self.raw("\tcld")
        self.raw("\trep movsb")
        self.raw("\tleaq (%r15,%r13), %rax")
        self.raw("\tmovq %rax, (%r14)")
        self.raw("\tpopq %r15")
        self.raw("\tpopq %r14")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
    }

    // -- reference-counting helpers (drop / copy-on-write clone) ----------

    // Emit every per-type drop/clone routine reached during code generation.
    // Drop helpers recurse (dropping a list element re-registers its own drop),
    // so we drain `need_drop` as a worklist whose length may grow mid-loop.
    fun emit_drop_helpers(var self) {
        if self.need_sb { self.emit_sb_rc_helpers() }
        var i = 0
        while i < len(self.need_drop) {
            let t = self.need_drop[i]
            i = i + 1
            let tok = mono_token(t)
            if list_has_str(self.drop_emitted, tok) { continue }
            push(self.drop_emitted, tok)
            match t {
                Type.TList(e) => { self.emit_list_drop_helper(t) },
                Type.TMap(k, v) => { self.emit_map_drop_helper(t) },
                Type.TEnum(n, a) => { self.emit_dropb_helper(t) },
                _ => {},
            }
        }
        var j = 0
        while j < len(self.need_clone) {
            let t = self.need_clone[j]
            j = j + 1
            let tok = mono_token(t)
            if list_has_str(self.clone_emitted, tok) { continue }
            push(self.clone_emitted, tok)
            match t {
                Type.TList(e) => { self.emit_list_clone_helper(t) },
                Type.TMap(k, v) => { self.emit_map_clone_helper(t) },
                _ => {},
            }
        }
    }

    // `__drop_list_<elem>`: %rdi = list cell. Decrement the refcount; at zero,
    // drop each of the `len` elements that own heap, then free the cell.
    fun emit_list_drop_helper(var self, t: Type) {
        let et = list_elem(t)
        let stride = self.stored_size(et)
        self.emit(format("__drop_list_{}:", mono_token(et)))
        self.emit("decq -8(%rdi)")
        let keep = self.label()
        self.emit(format("jnz {}", keep))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        self.emit("pushq %rbx")
        self.emit("pushq %r12")
        self.emit("pushq %r13")
        self.emit("pushq %r14")
        self.emit("movq %rdi, %rbx")
        if self.owns_heap(et) {
            self.emit("movq (%rbx), %r12")
            self.emit("xorq %r13, %r13")
            let loop = self.label()
            let done = self.label()
            self.emit(format("{}:", loop))
            self.emit("cmpq %r12, %r13")
            self.emit(format("jge {}", done))
            self.emit("movq %r13, %rax")
            self.emit(format("imulq ${}, %rax", stride))
            self.emit("leaq 16(%rbx,%rax), %r14")
            self.walk_member("r14", 0, et, false)
            self.emit("incq %r13")
            self.emit(format("jmp {}", loop))
            self.emit(format("{}:", done))
        }
        self.emit("movq %rbx, %rdi")
        self.emit("popq %r14")
        self.emit("popq %r13")
        self.emit("popq %r12")
        self.emit("popq %rbx")
        self.emit("leave")
        self.emit("jmp __free")
        self.emit(format("{}:", keep))
        self.emit("ret")
        self.emit("")
    }

    // `__clone_list_<elem>`: %rdi = shared cell. Allocate an independent copy
    // (rc=1), retain each element it now shares, decrement the original, and
    // return the copy in %rax (the copy-on-write clone, D38).
    fun emit_list_clone_helper(var self, t: Type) {
        let et = list_elem(t)
        let stride = self.stored_size(et)
        self.emit(format("__clone_list_{}:", mono_token(et)))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        self.emit("pushq %rbx")
        self.emit("pushq %r12")
        self.emit("pushq %r13")
        self.emit("pushq %r14")
        self.emit("movq %rdi, %rbx")
        self.emit("movq -16(%rbx), %r12")
        self.emit("movq %r12, %rdi")
        self.emit("call __alloc")
        self.emit("movq %rax, %r13")
        self.emit("movq %rbx, %rsi")
        self.emit("movq %r13, %rdi")
        self.emit("movq %r12, %rcx")
        self.emit("cld")
        self.emit("rep movsb")
        if self.owns_heap(et) {
            self.emit("movq (%r13), %r12")
            self.emit("xorq %r14, %r14")
            let loop = self.label()
            let done = self.label()
            self.emit(format("{}:", loop))
            self.emit("cmpq %r12, %r14")
            self.emit(format("jge {}", done))
            self.emit("movq %r14, %rax")
            self.emit(format("imulq ${}, %rax", stride))
            self.emit("leaq 16(%r13,%rax), %rcx")
            self.walk_member("rcx", 0, et, true)
            self.emit("incq %r14")
            self.emit(format("jmp {}", loop))
            self.emit(format("{}:", done))
        }
        self.emit("decq -8(%rbx)")
        self.emit("movq %r13, %rax")
        self.emit("popq %r14")
        self.emit("popq %r13")
        self.emit("popq %r12")
        self.emit("popq %rbx")
        self.emit("leave")
        self.emit("ret")
        self.emit("")
    }

    // `__drop_map_<k>_<v>`: %rdi = map cell. Decrement the refcount; at zero,
    // drop each occupied slot's owning key/value, then free the cell.
    fun emit_map_drop_helper(var self, t: Type) {
        let kt = map_key(t)
        let vt = map_val(t)
        let ss = self.map_slot_size(t)
        self.emit(format("__drop_map_{}:", map_token(kt, vt)))
        self.emit("decq -8(%rdi)")
        let keep = self.label()
        self.emit(format("jnz {}", keep))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        self.emit("pushq %rbx")
        self.emit("pushq %r12")
        self.emit("pushq %r13")
        self.emit("pushq %r14")
        self.emit("movq %rdi, %rbx")
        if self.owns_heap(kt) || self.owns_heap(vt) {
            self.emit("movq 8(%rbx), %r12")
            self.emit("xorq %r13, %r13")
            let loop = self.label()
            let done = self.label()
            self.emit(format("{}:", loop))
            self.emit("cmpq %r12, %r13")
            self.emit(format("jge {}", done))
            self.emit("movq %r13, %rax")
            self.emit(format("imulq ${}, %rax", ss))
            self.emit("leaq 16(%rbx,%rax), %r14")
            self.emit("movq (%r14), %rax")
            self.emit("cmpq $1, %rax")
            let cont = self.label()
            self.emit(format("jne {}", cont))
            if self.owns_heap(kt) { self.walk_member("r14", 8, kt, false) }
            if self.owns_heap(vt) { self.walk_member("r14", 16, vt, false) }
            self.emit(format("{}:", cont))
            self.emit("incq %r13")
            self.emit(format("jmp {}", loop))
            self.emit(format("{}:", done))
        }
        self.emit("movq %rbx, %rdi")
        self.emit("popq %r14")
        self.emit("popq %r13")
        self.emit("popq %r12")
        self.emit("popq %rbx")
        self.emit("leave")
        self.emit("jmp __free")
        self.emit(format("{}:", keep))
        self.emit("ret")
        self.emit("")
    }

    // `__clone_map_<k>_<v>`: %rdi = shared map cell -> rax = independent copy
    // (rc=1); retain each occupied slot's owning key/value; original decremented.
    fun emit_map_clone_helper(var self, t: Type) {
        let kt = map_key(t)
        let vt = map_val(t)
        let ss = self.map_slot_size(t)
        self.emit(format("__clone_map_{}:", map_token(kt, vt)))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        self.emit("pushq %rbx")
        self.emit("pushq %r12")
        self.emit("pushq %r13")
        self.emit("pushq %r14")
        self.emit("movq %rdi, %rbx")
        self.emit("movq -16(%rbx), %r12")
        self.emit("movq %r12, %rdi")
        self.emit("call __alloc")
        self.emit("movq %rax, %r13")
        self.emit("movq %rbx, %rsi")
        self.emit("movq %r13, %rdi")
        self.emit("movq %r12, %rcx")
        self.emit("cld")
        self.emit("rep movsb")
        if self.owns_heap(kt) || self.owns_heap(vt) {
            self.emit("movq 8(%r13), %r12")
            self.emit("xorq %r14, %r14")
            let loop = self.label()
            let done = self.label()
            self.emit(format("{}:", loop))
            self.emit("cmpq %r12, %r14")
            self.emit(format("jge {}", done))
            self.emit("movq %r14, %rax")
            self.emit(format("imulq ${}, %rax", ss))
            self.emit("leaq 16(%r13,%rax), %rcx")
            self.emit("movq (%rcx), %rax")
            self.emit("cmpq $1, %rax")
            let cont = self.label()
            self.emit(format("jne {}", cont))
            if self.owns_heap(kt) { self.walk_member("rcx", 8, kt, true) }
            if self.owns_heap(vt) { self.walk_member("rcx", 16, vt, true) }
            self.emit(format("{}:", cont))
            self.emit("incq %r14")
            self.emit(format("jmp {}", loop))
            self.emit(format("{}:", done))
        }
        self.emit("decq -8(%rbx)")
        self.emit("movq %r13, %rax")
        self.emit("popq %r14")
        self.emit("popq %r13")
        self.emit("popq %r12")
        self.emit("popq %rbx")
        self.emit("leave")
        self.emit("ret")
        self.emit("")
    }

    // `__dropb_<E>`: %rdi = boxed-enum cell. Decrement; at zero, drop the
    // children the inline value owns, then free the cell.
    fun emit_dropb_helper(var self, t: Type) {
        self.emit(format("__dropb_{}:", mono_token(t)))
        self.emit("decq -8(%rdi)")
        let keep = self.label()
        self.emit(format("jnz {}", keep))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        self.emit("pushq %rbx")
        self.emit("movq %rdi, %rbx")
        self.owned_walk("rbx", 0, t, false)
        self.emit("movq %rbx, %rdi")
        self.emit("popq %rbx")
        self.emit("leave")
        self.emit("jmp __free")
        self.emit(format("{}:", keep))
        self.emit("ret")
        self.emit("")
    }

    // Builder reference-counting helpers (bytes are scalars: drop just frees).
    fun emit_sb_rc_helpers(var self) {
        self.emit("__sb_drop:")
        self.emit("decq -8(%rdi)")
        let keep = self.label()
        self.emit(format("jnz {}", keep))
        self.emit("jmp __free")
        self.emit(format("{}:", keep))
        self.emit("ret")
        self.emit("")
        self.emit("__sb_clone:")
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        self.emit("pushq %rbx")
        self.emit("pushq %r12")
        self.emit("movq %rdi, %rbx")
        self.emit("movq -16(%rbx), %r12")
        self.emit("movq %r12, %rdi")
        self.emit("call __alloc")
        self.emit("pushq %rax")
        self.emit("movq %rbx, %rsi")
        self.emit("movq %rax, %rdi")
        self.emit("movq %r12, %rcx")
        self.emit("cld")
        self.emit("rep movsb")
        self.emit("popq %rax")
        self.emit("decq -8(%rbx)")
        self.emit("popq %r12")
        self.emit("popq %rbx")
        self.emit("leave")
        self.emit("ret")
        self.emit("")
    }

    // List cell layout: [len:8][cap:8][elem0..]. The value pointer points at the
    // length word. Strides are passed in (per element type) so one routine serves
    // every list. Copy-on-write clones are per element type (`__clone_list_*`,
    // emit_list_clone_helper): they retain the elements they share (D38).
    fun emit_list_runtime(var self) {
        // __list_grow: rdi=full cell (len==cap), rsi=stride -> rax=larger cell.
        self.raw("__list_grow:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tmovq %rdi, %rbx")
        self.raw("\tmovq %rsi, %r12")
        self.raw("\tmovq 8(%rbx), %r13")
        self.raw("\ttestq %r13, %r13")
        self.raw("\tjnz .Lgrow_dbl")
        self.raw("\tmovq $4, %r14")
        self.raw("\tjmp .Lgrow_alloc")
        self.raw(".Lgrow_dbl:")
        self.raw("\tmovq %r13, %r14")
        self.raw("\tshlq $1, %r14")
        self.raw(".Lgrow_alloc:")
        self.raw("\tmovq %r14, %rax")
        self.raw("\timulq %r12, %rax")
        self.raw("\taddq $16, %rax")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tcall __alloc")
        self.raw("\tpushq %rax")
        self.raw("\tmovq %rax, %rdi")
        self.raw("\tmovq %rbx, %rsi")
        self.raw("\tmovq %r13, %rcx")
        self.raw("\timulq %r12, %rcx")
        self.raw("\taddq $16, %rcx")
        self.raw("\tcld")
        self.raw("\trep movsb")
        self.raw("\tpopq %rax")
        self.raw("\tmovq %r14, 8(%rax)")
        // The caller made the cell unique (rc==1) before growing, so the old
        // buffer is now garbage: free it to keep arena usage bounded.
        self.raw("\tpushq %rax")
        self.raw("\tmovq %rbx, %rdi")
        self.raw("\tcall __free")
        self.raw("\tpopq %rax")
        self.raw("\tpopq %r14")
        self.raw("\tpopq %r13")
        self.raw("\tpopq %r12")
        self.raw("\tpopq %rbx")
        self.raw("\tleave")
        self.raw("\tret")
        self.raw("")
    }
}

// -- free helpers ---------------------------------------------------------

fun ends_colon(s: str) -> bool {
    let n = len(s)
    return n > 0 && s[n - 1] == 58
}

fun byte_list(s: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < len(s) {
        if i > 0 { append(sb, ", ") }
        append(sb, format("{}", s[i]))
        i = i + 1
    }
    return build(sb)
}

fun join_lines(xs: [str]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < len(xs) {
        if i > 0 { append(sb, "\n") }
        append(sb, xs[i])
        i = i + 1
    }
    return build(sb)
}

pub fun is_aggregate(t: Type) -> bool {
    return match t {
        Type.TStruct(n, a) => true,
        Type.TTuple(es) => true,
        Type.TEnum(n, a) => true,
        Type.TFunc(ps, r) => true,
        _ => false,
    }
}

pub fun is_aggregate_opt(ot: Option<Type>) -> bool {
    return match ot { Some(t) => is_aggregate(t), None => false }
}

pub fun tuple_elems(t: Type) -> [Type] {
    return match t { Type.TTuple(es) => es, _ => [] }
}

pub fun list_elem(t: Type) -> Type {
    return match t { Type.TList(e) => e, _ => Type.TInt(32, true) }
}

// Split a `format` template into literal segments (one more than the number of
// `{}` holes). `{{`/`}}` collapse to single literal braces.
pub fun format_segments(s: str) -> [str] {
    var segs: [str] = []
    var cur = ""
    let n = len(s)
    var i = 0
    while i < n {
        let c = s[i]
        if c == '{' {
            if i + 1 < n && s[i + 1] == '{' { cur = cur + "{"
            i = i + 2
            continue }
            push(segs, cur)
            cur = ""
            i = i + 2
            continue
        }
        if c == '}' {
            if i + 1 < n && s[i + 1] == '}' { cur = cur + "}"
            i = i + 2
            continue }
            i = i + 1
            continue
        }
        cur = cur + str_byte(s, i)
        i = i + 1
    }
    push(segs, cur)
    return segs
}

// The single-byte substring at index `i` (build a 1-char string).
fun str_byte(s: str, i: int32) -> str {
    var sb = StringBuilder()
    append_byte(sb, s[i])
    return build(sb)
}

pub fun map_key(t: Type) -> Type {
    return match t { Type.TMap(k, v) => k, _ => Type.TStr }
}

pub fun map_val(t: Type) -> Type {
    return match t { Type.TMap(k, v) => v, _ => Type.TInt(32, true) }
}

pub fun is_list_t(t: Type) -> bool { return match t { Type.TList(e) => true, _ => false } }
pub fun is_map_t(t: Type) -> bool { return match t { Type.TMap(k, v) => true, _ => false } }
pub fun is_str_t(t: Type) -> bool { return match t { Type.TStr => true, _ => false } }
fun is_sb_t(t: Type) -> bool { return match t { Type.TSB => true, _ => false } }

// A heap cell whose pointer is the value: retained and dropped as one pointer.
pub fun is_cell_t(t: Type) -> bool { return is_list_t(t) || is_map_t(t) || is_sb_t(t) || is_str_t(t) }

// A `str` cell in the data section: the heap's `[size][refcount]` header, then
// `[len][bytes]` at `label`; its count never reaches zero (MYLA-18, the Python
// backend's `_static_str` and STATIC_RC).
fun static_str(label: str, text: str) -> [str] {
    var out = ["\t.balign 8", format("\t.quad {}", 8 + len(text)), "\t.quad 4611686018427387904",
               format("{}:", label), format("\t.quad {}", len(text))]
    if len(text) > 0 { push(out, "\t.byte " + byte_list(text)) }
    return out
}

// The variable a place (`x`, `x.f`, `x[i].g`) starts from, or "" when `e` is
// not a place.
pub fun place_root(e: Expr) -> str {
    return match e.kind {
        ExprKind.Name(n) => n,
        ExprKind.GetField(t, f) => place_root(t),
        ExprKind.TupleIndex(t, i) => place_root(t),
        ExprKind.Index(t, i) => place_root(t),
        _ => "",
    }
}

fun is_mutating_builtin(n: str) -> bool {
    return n == "push" || n == "pop" || n == "remove" || n == "append" || n == "append_byte"
}

// Whether running an arm (guard and body) may write to variable `name`,
// conservatively: an assignment to or into it, a mutating builtin on it, or a
// method call on it (the method may take `var self`). Myla has no references
// and closures capture by value, so nothing else can.
pub fun arms_may_write(arms: [MatchArm], name: str) -> bool {
    for arm in arms {
        match arm.guard { Some(g) => { if may_write_expr(g, name) { return true } }, None => {} }
        if may_write_body(arm.body, name) { return true }
    }
    return false
}

fun may_write_body(b: ExprOrBlock, name: str) -> bool {
    return match b {
        ExprOrBlock.EB_Expr(e) => may_write_expr(e, name),
        ExprOrBlock.EB_Block(blk) => may_write_block(blk, name),
    }
}

fun may_write_block(b: Block, name: str) -> bool {
    for st in b.stmts { if may_write_stmt(st, name) { return true } }
    return false
}

fun may_write_opt(oe: Option<Expr>, name: str) -> bool {
    return match oe { Some(e) => may_write_expr(e, name), None => false }
}

fun may_write_exprs(es: [Expr], name: str) -> bool {
    for e in es { if may_write_expr(e, name) { return true } }
    return false
}

fun may_write_stmt(st: Stmt, name: str) -> bool {
    match st.kind {
        StmtKind.VarDecl(k, n, ty, init) => { return may_write_expr(init, name) },
        StmtKind.DestructDecl(k, bs, ty, init) => { return may_write_expr(init, name) },
        StmtKind.Assign(target, value) => {
            return place_root(target) == name || may_write_expr(target, name) || may_write_expr(value, name)
        },
        StmtKind.IfS(c, then, otherwise) => {
            if may_write_expr(c, name) || may_write_block(then, name) { return true }
            return match otherwise {
                Some(ElseTail.ElseBlock(b)) => may_write_block(b, name),
                Some(ElseTail.ElseIf(s)) => may_write_stmt(s, name),
                _ => false,
            }
        },
        StmtKind.WhileS(c, body) => { return may_write_expr(c, name) || may_write_block(body, name) },
        StmtKind.ForS(v, start, end, body, iter) => {
            return may_write_opt(start, name) || may_write_opt(end, name) || may_write_opt(iter, name) || may_write_block(body, name)
        },
        StmtKind.ReturnS(ov) => { return may_write_opt(ov, name) },
        StmtKind.ExprStmt(e) => { return may_write_expr(e, name) },
        _ => {},
    }
    return false
}

fun may_write_expr(e: Expr, name: str) -> bool {
    match e.kind {
        ExprKind.Unary(op, x) => { return may_write_expr(x, name) },
        ExprKind.Binary(op, l, r) => { return may_write_expr(l, name) || may_write_expr(r, name) },
        ExprKind.Call(c, args) => {
            let writes = match c.kind {
                ExprKind.GetField(recv, m) => place_root(recv) == name,
                ExprKind.Name(f) => is_mutating_builtin(f) && len(args) > 0 && place_root(args[0]) == name,
                _ => false,
            }
            return writes || may_write_expr(c, name) || may_write_exprs(args, name)
        },
        ExprKind.GetField(t, f) => { return may_write_expr(t, name) },
        ExprKind.StructLit(n, fields) => {
            for fi in fields { if may_write_expr(fi.value, name) { return true } }
        },
        ExprKind.TupleLit(es) => { return may_write_exprs(es, name) },
        ExprKind.TupleIndex(t, i) => { return may_write_expr(t, name) },
        ExprKind.ListLit(es) => { return may_write_exprs(es, name) },
        ExprKind.MapLit(entries) => {
            for en in entries { if may_write_expr(en.key, name) || may_write_expr(en.value, name) { return true } }
        },
        ExprKind.Index(t, i) => { return may_write_expr(t, name) || may_write_expr(i, name) },
        ExprKind.MatchE(s, arms) => { return may_write_expr(s, name) || arms_may_write(arms, name) },
        ExprKind.Try(x) => { return may_write_expr(x, name) },
        ExprKind.Cast(x, ty) => { return may_write_expr(x, name) },
        ExprKind.Lambda(ps, rt, body) => { return may_write_body(body, name) },
        _ => {},
    }
    return false
}

fun struct_name_of(t: Type) -> str {
    return match t { Type.TStruct(n, a) => n, _ => "" }
}

fun type_args_of(t: Type) -> [Type] {
    return match t {
        Type.TStruct(n, a) => a,
        Type.TEnum(n, a) => a,
        _ => [],
    }
}

pub fun is_struct_or_enum_t(t: Type) -> bool {
    return match t { Type.TStruct(n, a) => true, Type.TEnum(n, a) => true, _ => false }
}

pub fun is_tfunc(t: Type) -> bool {
    return match t { Type.TFunc(p, r) => true, _ => false }
}

pub fun is_hole_expr(e: Expr) -> bool {
    return match e.kind { ExprKind.Hole => true, _ => false }
}

pub fun args_have_hole(args: [Expr]) -> bool {
    for a in args { if is_hole_expr(a) { return true } }
    return false
}

fun bind_elem_names(be: BindElem) -> [str] {
    var out: [str] = []
    match be {
        BindElem.BName(n, l, c, sp) => { push(out, n) },
        BindElem.BWild => {},
        BindElem.BTuple(es, l, c, sp) => { for e in es { for n in bind_elem_names(e) { push(out, n) } } },
    }
    return out
}

fun pattern_names(p: Pattern) -> [str] {
    var out: [str] = []
    match p.kind {
        PatternKind.PBind(n) => { push(out, n) },
        PatternKind.PEnum(en, v, elems, hp) => { for el in elems { for n in pattern_names(el) { push(out, n) } } },
        PatternKind.PTuple(elems) => { for el in elems { for n in pattern_names(el) { push(out, n) } } },
        PatternKind.PStruct(nm, fields) => { for f in fields { for n in pattern_names(f.pattern) { push(out, n) } } },
        PatternKind.POr(elems) => { for el in elems { for n in pattern_names(el) { push(out, n) } } },
        _ => {},
    }
    return out
}

fun empty_str_list() -> [str] {
    var e: [str] = []
    return e
}

pub fun tfunc_params(t: Type) -> [Type] {
    match t { Type.TFunc(p, r) => { return p }, _ => {} }
    var empty: [Type] = []
    return empty
}

pub fun tfunc_ret(t: Type) -> Option<Type> {
    match t { Type.TFunc(p, r) => { return r }, _ => {} }
    return None
}

// Names that are builtins, not calls of a function or function value.
pub fun is_builtin_call_name(nm: str) -> bool {
    if nm == "print" || nm == "assert" || nm == "panic" || nm == "unreachable" { return true }
    if nm == "len" || nm == "push" || nm == "pop" || nm == "chars" || nm == "format" { return true }
    if nm == "StringBuilder" || nm == "append" || nm == "append_byte" || nm == "build" { return true }
    if nm == "contains" || nm == "remove" || nm == "keys" { return true }
    if nm == "__write" || nm == "__exit" || nm == "__args" || nm == "__read_file" || nm == "__io_errno" { return true }
    if nm == "__write_file" || nm == "__run" || nm == "__run_stderr" || nm == "__run_exit_code" || nm == "__read" || nm == "__poll" { return true }
    if nm == "__run_signal" || nm == "__run_errno" { return true }
    if nm == "__list_dir" || nm == "__mkdir" || nm == "__stat" || nm == "__getcwd" { return true }
    return false
}

fun attrs_have_derive_eq(attrs: [Attribute]) -> bool {
    for a in attrs {
        if a.name == "derive" {
            for arg in a.args {
                match arg.kind { ExprKind.Name(n) => { if n == "Eq" { return true } }, _ => {} }
            }
        }
    }
    return false
}

pub fun is_overloadable_op(op: str) -> bool {
    if op == "==" || op == "!=" { return true }
    if is_cmp(op) { return true }
    return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
}

pub fun arith_method_cg(op: str) -> str {
    if op == "+" { return "add" }
    if op == "-" { return "sub" }
    if op == "*" { return "mul" }
    if op == "/" { return "div" }
    return "rem"
}

pub fun enum_name_of(t: Type) -> str {
    return match t { Type.TEnum(n, a) => n, _ => "" }
}

fun expr_name(e: Expr) -> str {
    return match e.kind { ExprKind.Name(n) => n, _ => "" }
}

// The receiver of a `EnumName.Variant` callee, or a dummy expr otherwise.
fun callee_target(callee: Expr) -> Expr {
    return match callee.kind { ExprKind.GetField(tgt, field) => tgt, _ => callee }
}

fun getfield_name(callee: Expr) -> str {
    return match callee.kind { ExprKind.GetField(tgt, field) => field, _ => "" }
}

pub fun success_variant(enum_name: str) -> str {
    if enum_name == "Option" { return "Some" }
    return "Ok"
}

pub fun failure_variant(enum_name: str) -> str {
    if enum_name == "Option" { return "None" }
    return "Err"
}

// -- monomorphization helpers --------------------------------------------

fun worklist_has(wl: [MonoFn], mangled: str) -> bool {
    for m in wl { if m.mangled == mangled { return true } }
    return false
}

fun int_type_name_cg(w: int32, signed: bool) -> str {
    if signed { return format("int{}", w) }
    return format("uint{}", w)
}

pub fun mangle_fn(name: str, args: [Type]) -> str {
    return format("{}__{}", name, join_tokens(args))
}

// Mangled names are injective (MYLA-9): every type argument's token is
// prefixed with its length, and a built-in token starts with `.`, which no
// identifier contains, while a user type's token is its name. So
// `Pair<A_B, C>` is `Pair__3A_B1C` and `Pair<A, B_C>` is `Pair__1A3B_C`.
fun join_tokens(xs: [Type]) -> str {
    var s = ""
    for x in xs { s = s + lp(mono_token(x)) }
    return s
}

// `tok` prefixed with its length, so a run of tokens reads back one way.
fun lp(tok: str) -> str {
    return format("{}{}", len(tok), tok)
}

// The suffix naming a map type's helpers.
fun map_token(k: Type, v: Type) -> str {
    return lp(mono_token(k)) + lp(mono_token(v))
}

fun int_token(w: int32, s: bool) -> str {
    if s { return format(".i{}", w) }
    return format(".u{}", w)
}

fun agg_token(n: str, args: [Type]) -> str {
    if len(args) == 0 { return n }
    return format("{}__{}", n, join_tokens(args))
}

// A stable identifier fragment for a concrete type (used in mangled names).
fun mono_token(t: Type) -> str {
    return match t {
        Type.TInt(w, s) => int_token(w, s),
        Type.TBool => ".bool",
        Type.TStr => ".str",
        Type.TChar => ".char",
        Type.TFloat(w) => format(".f{}", w),
        Type.TSB => ".sb",
        Type.TStruct(n, a) => agg_token(n, a),
        Type.TEnum(n, a) => agg_token(n, a),
        Type.TTuple(es) => ".T" + join_tokens(es),
        Type.TList(e) => ".L" + lp(mono_token(e)),
        Type.TMap(k, v) => ".M" + map_token(k, v),
        Type.TFunc(ps, r) => ".F" + join_tokens(ps) + "R" + lp(ret_token(r)),
        Type.TParam(n) => n,
        _ => ".X",
    }
}

fun ret_token(r: Option<Type>) -> str {
    return match r { Some(t) => mono_token(t), None => ".void" }
}

// The component types of a composite type, in a canonical order, so two types
// of the same shape line up positionally for unification.
fun parts_of(t: Type) -> [Type] {
    return match t {
        Type.TTuple(es) => es,
        Type.TStruct(n, a) => a,
        Type.TEnum(n, a) => a,
        Type.TList(e) => [e],
        Type.TMap(k, v) => [k, v],
        Type.TFunc(ps, r) => func_parts(ps, r),
        _ => [],
    }
}

fun func_parts(ps: [Type], r: Option<Type>) -> [Type] {
    var out: [Type] = []
    for p in ps { push(out, p) }
    match r { Some(rt) => { push(out, rt) }, None => {} }
    return out
}

// Solve type-parameter bindings by structurally unifying a declared (possibly
// type-parametric) type against a concrete type.
fun unify_into(declared: Type, concrete: Type) -> [Subst] {
    var out: [Subst] = []
    match declared {
        Type.TParam(n) => { push(out, Subst { name: n, ty: concrete }) },
        _ => {
            let ds = parts_of(declared)
            let cs = parts_of(concrete)
            var i = 0
            while i < len(ds) && i < len(cs) {
                for b in unify_into(ds[i], cs[i]) { push(out, b) }
                i = i + 1
            }
        },
    }
    return out
}

fun drop_last<T>(xs: [T]) -> [T] {
    var out: [T] = []
    var i = 0
    while i < len(xs) - 1 {
        push(out, xs[i])
        i = i + 1
    }
    return out
}

fun list_has_str(xs: [str], target: str) -> bool {
    for x in xs { if x == target { return true } }
    return false
}

// Return a fresh list with `s` appended (non-mutating: callers pass it down a
// recursion as a cycle-breaking "seen" set without disturbing the caller's).
fun push_str_copy(xs: [str], s: str) -> [str] {
    var out: [str] = []
    for x in xs { push(out, x) }
    push(out, s)
    return out
}

pub fun is_tstr(t: Type) -> bool {
    return match t { Type.TStr => true, _ => false }
}

fun is_tchar(t: Type) -> bool {
    return match t { Type.TChar => true, _ => false }
}

fun is_tfloat(t: Type) -> bool {
    return match t { Type.TFloat(w) => true, _ => false }
}

fun is_tfloat32(t: Type) -> bool {
    return match t { Type.TFloat(w) => w == 32, _ => false }
}

// The runtime-error entries and their messages (MYLA-17), as in the Python
// backend (`_TRAPS`). `__panic` prints them after `runtime error: `.
fun trap_labels() -> [str] {
    return ["__trap_index", "__trap_key", "__trap_pop", "__trap_div", "__trap_mod", "__trap_match", "__trap_oom"]
}

fun trap_messages() -> [str] {
    return ["index out of bounds", "map key not found", "pop from an empty list", "division by zero", "modulo by zero", "no match arm matched", "out of memory"]
}

// The DW_ATE encoding of a scalar type (MYLA-66).
#test(Type.TInt(32, true))[5]
#test(Type.TInt(8, false))[7]
#test(Type.TBool)[2]
#test(Type.TChar)[16]
#test(Type.TFloat(32))[4]
fun ate_of(t: Type) -> int32 {
    return match t {
        Type.TInt(w, signed) => match signed { true => ATE_SIGNED, false => ATE_UNSIGNED },
        Type.TBool => ATE_BOOLEAN,
        Type.TChar => ATE_UTF,
        _ => ATE_FLOAT,
    }
}

// Whether `name` is the compiler's own (`__…`), not shown to gdb.
#test("__tmp")[true]
#test("x")[false]
#test("_")[false]
pub fun is_internal_name(name: str) -> bool {
    return len(name) >= 2 && name[0] == '_' && name[1] == '_'
}

// The conditional jump that skips a trap call, for each jump to a trap.
#test("jae")["jb"]
#test("jz")["jnz"]
#test("jl")["jge"]
#test("jg")["jle"]
fun skip_trap(jump: str) -> str {
    if jump == "jae" { return "jb" }
    if jump == "jz" { return "jnz" }
    if jump == "jl" { return "jge" }
    return "jle"
}

// The bits of the double 2^k (-2^k when `neg`), as a signed immediate.
fun pow2_bits(k: int32, neg: bool) -> int64 {
    let bits = ((1023 + k) as int64) << 52
    if neg { return bits | (1i64 << 63) }
    return bits
}

fun int_signed(t: Type) -> bool {
    return match t { Type.TInt(w, s) => s, _ => false }
}

fun int_width_cg(t: Type) -> int32 {
    return match t { Type.TInt(w, s) => w, _ => 64 }
}

pub fun is_cmp(op: str) -> bool {
    return op == "<" || op == "<=" || op == ">" || op == ">="
}

pub fun cmp_set(op: str, signed: bool) -> str {
    if op == "<" {
        if signed { return "setl" }
        return "setb"
    }
    if op == "<=" {
        if signed { return "setle" }
        return "setbe"
    }
    if op == ">" {
        if signed { return "setg" }
        return "seta"
    }
    if signed { return "setge" }
    return "setae"
}

// `s` as the body of an assembler string literal (a `.file` path).
fun asm_string(s: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < len(s) {
        let c = s[i]
        if c == '\\' || c == '"' { append_byte(sb, '\\') }
        append_byte(sb, c)
        i = i + 1
    }
    return build(sb)
}
