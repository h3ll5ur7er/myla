// codegen.my -- x86-64 code generator, written in Myla (self-hosting v0.9).
//
// Mirrors src/myla/compiler/codegen_x86.py: turns a type-checked program into
// GAS/AT&T assembly text. The build driver (a thin host wrapper, see §4 of
// docs/self-hosting.md) runs `as`/`ld` over the emitted assembly. This is the
// v0.9 milestone, ported incrementally and differentially tested against the
// Python backend (same stdout/exit for every example).
//
// Slice C0: the emitter, label/string interning, the freestanding runtime
// prelude, simple frame layout, and scalar `_eval`/calls/`print` -- enough to
// build and run a `hello`-class program through `as`/`ld` with parity.

from .ast import Expr, ExprKind, Stmt, StmtKind, Block, Decl, DeclKind, FunData, Param, ExprOrBlock, ElseTail, TypeExpr, MatchArm, Pattern, PatternKind, FieldPat, FieldInit, MapEntry, Attribute, BindElem
from .checker import Checker, Type, FuncSig, StructInfo, EnumInfo, FieldT, VariantT, Subst, subst_type, subst_get, opt_subst_type

// A name binding in scope: a parameter or local at a fixed rbp offset.
// `capoff` is the byte offset within the closure env for a "capture" binding.
pub struct CgBinding { name: str, kind: str, offset: int32, ty: Type, capoff: int32 }

// A by-value captured variable in a closure environment cell.
pub struct Cap { name: str, ty: Type, off: int32 }

// A lifted lambda body to emit as a top-level function (monomorphized per stamp).
pub struct LamJob { lifted: str, params: [Param], ftype: Type, body: ExprOrBlock, caps: [Cap], subst: [Subst] }

// A partial-application thunk to emit: `slots[i]` is the env byte offset of a
// filled argument, or -1 for a hole (filled from the thunk's own parameters).
pub struct PartialJob { lifted: str, target: str, slots: [int32] }

// Continue/break target labels for the innermost loop. `depth` is the
// drop-scope index of the loop body, so break/continue can release the heap
// owners they jump past.
pub struct LoopLab { cont: str, brk: str, depth: int32 }

// An owning local/temp at `off(%rbp)` to release when its scope unwinds.
pub struct DropEntry { off: int32, ty: Type }

// A leaf binding produced by destructuring a tuple pattern.
pub struct DLeaf { name: str, off: int32, ty: Type }

// Resolved enum-constructor info for an expression (`Shape.Circle(2)`, `None`).
pub struct CtorInfo { ok: bool, enum_name: str, variant: str, args: [Expr] }

// A pending generic-function instantiation to stamp out (monomorphization, D13).
pub struct MonoFn { orig: str, mangled: str, subst: [Subst] }

pub struct CodeGen {
    decls: [Decl],
    resolved: [int32: Type],
    structs: [StructInfo],
    enums: [EnumInfo],
    recursive_enums: [str],
    funcs: [FuncSig],
    text: [str],
    rodata: [str],
    label_n: int32,
    str_n: int32,
    str_texts: [str],
    str_labels: [str],
    locals: [int32: int32],
    for_lv: [int32: int32],
    for_end: [int32: int32],
    destruct_base: [int32: int32],
    destruct_leaves: [int32: [int32]],
    match_scrut: [int32: int32],
    match_res: [int32: int32],
    match_bind: [str: int32],
    try_res: [int32: int32],
    unbox: [int32: int32],
    for_elem: [int32: int32],
    ind_code: [int32: int32],
    ind_env: [int32: int32],
    subst: [Subst],
    fn_worklist: [MonoFn],
    fn_done: [str],
    lam_jobs: [LamJob],
    lam_done: [str],
    partial_jobs: [PartialJob],
    fnval_set: [str],
    cur_mangled: str,
    scopes: [[CgBinding]],
    drop_scopes: [[DropEntry]],
    loops: [LoopLab],
    cursor: int32,
    epilogue: str,
    struct_ret: bool,
    ret_type: Option<Type>,
    // Reference-counting helper worklists: concrete owning types whose per-type
    // drop/clone routines must be emitted (deduped by mangled token).
    need_drop: [Type],
    drop_emitted: [str],
    need_clone: [Type],
    clone_emitted: [str],
    need_sb: bool,
}

pub fun new_codegen(c: Checker) -> CodeGen {
    return CodeGen {
        decls: c.decls,
        resolved: c.resolved,
        structs: c.structs,
        enums: c.enums,
        recursive_enums: c.recursive_enums,
        funcs: c.functions,
        text: [], rodata: [],
        label_n: 0, str_n: 0,
        str_texts: [], str_labels: [],
        locals: [:], for_lv: [:], for_end: [:],
        destruct_base: [:], destruct_leaves: [:],
        match_scrut: [:], match_res: [:], match_bind: [:], try_res: [:], unbox: [:],
        for_elem: [:], ind_code: [:], ind_env: [:],
        subst: [], fn_worklist: [], fn_done: [],
        lam_jobs: [], lam_done: [], partial_jobs: [], fnval_set: [],
        cur_mangled: "",
        scopes: [], drop_scopes: [], loops: [],
        cursor: 0,
        epilogue: "", struct_ret: false, ret_type: None,
        need_drop: [], drop_emitted: [], need_clone: [], clone_emitted: [],
        need_sb: false,
    }
}

impl CodeGen {
    // -- emit helpers -----------------------------------------------------

    // Append a generated instruction (tab-indented) or a label (flush-left).
    fun emit(var self, line: str) {
        if line == "" {
            push(self.text, "")
        } else if ends_colon(line) {
            push(self.text, line)
        } else {
            push(self.text, "\t" + line)
        }
    }

    // Append a pre-formatted runtime-prelude line verbatim.
    fun raw(var self, line: str) { push(self.text, line) }

    fun label(var self) -> str {
        self.label_n = self.label_n + 1
        return format(".L{}", self.label_n)
    }

    fun str_index(self, text: str) -> int32 {
        var i = 0
        while i < len(self.str_texts) {
            if self.str_texts[i] == text { return i }
            i = i + 1
        }
        return -1
    }

    // Intern a string literal, emitting a length-prefixed `str` cell in rodata.
    fun string_label(var self, text: str) -> str {
        let existing = self.str_index(text)
        if existing >= 0 { return self.str_labels[existing] }
        let lab = format(".Lstr{}", self.str_n)
        self.str_n = self.str_n + 1
        push(self.str_texts, text)
        push(self.str_labels, lab)
        push(self.rodata, format("{}:", lab))
        let n = len(text)
        push(self.rodata, format("\t.quad {}", n))
        if n > 0 { push(self.rodata, "\t.byte " + byte_list(text)) }
        return lab
    }

    // -- lookups ----------------------------------------------------------

    fun sig_of(self, name: str) -> FuncSig {
        for f in self.funcs { if f.name == name { return f } }
        return self.funcs[0]
    }

    fun has_func(self, name: str) -> bool {
        for f in self.funcs { if f.name == name { return true } }
        return false
    }

    // The method-table key for a receiver type (mirrors Checker.type_key).
    fun type_key(self, t: Type) -> str {
        return match t {
            Type.TStruct(n, a) => n,
            Type.TEnum(n, a) => n,
            Type.TInt(w, s) => int_type_name_cg(w, s),
            Type.TBool => "bool",
            Type.TStr => "str",
            Type.TSB => "StringBuilder",
            Type.TChar => "char",
            _ => "",
        }
    }

    // The resolved type of a node, with the active generic substitution applied
    // (identity outside a specialized generic body).
    fun type_of(self, id: int32) -> Type {
        match get(self.resolved, id) { Some(t) => { return subst_type(t, self.subst) }, None => {} }
        return Type.TInt(32, true)
    }

    fun local_of(self, id: int32) -> int32 {
        match get(self.locals, id) { Some(o) => { return o }, None => {} }
        return 0
    }

    // The type of a place expression. The checker leaves lvalue targets untyped,
    // so derive them from bindings / container structure instead of `resolved`.
    fun place_type(self, e: Expr) -> Type {
        match e.kind {
            ExprKind.Name(n) => {
                if self.has_binding(n) { return self.lookup(n).ty }
            },
            ExprKind.Index(b, i) => {
                let bt = self.place_type(b)
                if is_map_t(bt) { return map_val(bt) }
                return list_elem(bt)
            },
            ExprKind.GetField(t, f) => {
                return self.struct_field_type_t(self.place_type(t), f)
            },
            ExprKind.TupleIndex(t, i) => {
                let es = tuple_elems(self.place_type(t))
                let ix = i as int32
                if ix < len(es) { return es[ix] }
            },
            _ => {},
        }
        return self.type_of(e.id)
    }

    fun bind(var self, name: str, kind: str, offset: int32, ty: Type) {
        let top = len(self.scopes) - 1
        push(self.scopes[top], CgBinding { name: name, kind: kind, offset: offset, ty: ty, capoff: 0 })
    }

    fun lookup(self, name: str) -> CgBinding {
        var i = len(self.scopes) - 1
        while i >= 0 {
            var j = len(self.scopes[i]) - 1
            while j >= 0 {
                if self.scopes[i][j].name == name { return self.scopes[i][j] }
                j = j - 1
            }
            i = i - 1
        }
        return CgBinding { name: name, kind: "local", offset: 0, ty: Type.TInt(32, true), capoff: 0 }
    }

    // -- ownership scopes & drop sites ------------------------------------

    fun open_scope(var self) {
        push(self.scopes, [])
        push(self.drop_scopes, [])
    }

    // Drop the owning locals declared in the innermost scope (reverse order),
    // then pop both the binding and drop scopes.
    fun close_scope(var self) {
        let top = self.drop_scopes[len(self.drop_scopes) - 1]
        var i = len(top) - 1
        while i >= 0 {
            self.drop_value("rbp", top[i].off, top[i].ty)
            i = i - 1
        }
        self.drop_scopes = drop_last(self.drop_scopes)
        self.scopes = drop_last(self.scopes)
    }

    // Record an owning local at `off(%rbp)` so it is released when its scope ends.
    fun register_owner(var self, off: int32, t: Type) {
        if self.owns_heap(t) {
            let top = len(self.drop_scopes) - 1
            push(self.drop_scopes[top], DropEntry { off: off, ty: t })
        }
    }

    // Drop every owning local currently in scope (for an early `return`).
    fun emit_return_drops(var self) {
        var s = len(self.drop_scopes) - 1
        while s >= 0 {
            let sc = self.drop_scopes[s]
            var i = len(sc) - 1
            while i >= 0 {
                self.drop_value("rbp", sc[i].off, sc[i].ty)
                i = i - 1
            }
            s = s - 1
        }
    }

    // Drop owners from the innermost scope down to (and including) `depth`, for a
    // `break`/`continue` that jumps past them.
    fun emit_loop_exit_drops(var self, depth: int32) {
        var s = len(self.drop_scopes) - 1
        while s >= depth {
            let sc = self.drop_scopes[s]
            var i = len(sc) - 1
            while i >= 0 {
                self.drop_value("rbp", sc[i].off, sc[i].ty)
                i = i - 1
            }
            s = s - 1
        }
    }

    // Drop the owning aggregate temporaries produced while evaluating `e` (values
    // that live in a frame temp slot and must be released once the statement that
    // produced them finishes). Does not descend into `match` arm bodies.
    fun drop_expr_temps(var self, e: Expr) {
        let temps = self.collect_expr_temps(e)
        for d in temps { self.drop_value("rbp", d.off, d.ty) }
    }

    fun drop_opt_temps(var self, oe: Option<Expr>) {
        match oe { Some(e) => { self.drop_expr_temps(e) }, None => {} }
    }

    fun collect_expr_temps(var self, e: Expr) -> [DropEntry] {
        var out: [DropEntry] = []
        let t = self.type_of(e.id)
        match get(self.locals, e.id) {
            Some(off) => { if self.owns_heap(t) { push(out, DropEntry { off: off, ty: t }) } },
            None => {},
        }
        match e.kind {
            ExprKind.Unary(op, x) => { for d in self.collect_expr_temps(x) { push(out, d) } },
            ExprKind.Cast(x, ty) => { for d in self.collect_expr_temps(x) { push(out, d) } },
            ExprKind.Binary(op, a, b) => {
                for d in self.collect_expr_temps(a) { push(out, d) }
                for d in self.collect_expr_temps(b) { push(out, d) }
            },
            ExprKind.Call(callee, args) => {
                if self.call_is_indirect(callee) {
                    for d in self.collect_expr_temps(callee) { push(out, d) }
                }
                for a in args { for d in self.collect_expr_temps(a) { push(out, d) } }
            },
            ExprKind.GetField(tgt, field) => {
                if !self.ctor_info(e).ok {
                    for d in self.collect_expr_temps(tgt) { push(out, d) }
                }
            },
            ExprKind.TupleIndex(tgt, ix) => { for d in self.collect_expr_temps(tgt) { push(out, d) } },
            ExprKind.Index(tgt, ix) => {
                for d in self.collect_expr_temps(tgt) { push(out, d) }
                for d in self.collect_expr_temps(ix) { push(out, d) }
            },
            ExprKind.ListLit(elems) => {
                for x in elems { for d in self.collect_expr_temps(x) { push(out, d) } }
            },
            ExprKind.MapLit(entries) => {
                for en in entries {
                    for d in self.collect_expr_temps(en.key) { push(out, d) }
                    for d in self.collect_expr_temps(en.value) { push(out, d) }
                }
            },
            ExprKind.StructLit(name, fields) => {
                for f in fields { for d in self.collect_expr_temps(f.value) { push(out, d) } }
            },
            ExprKind.TupleLit(elems) => {
                for x in elems { for d in self.collect_expr_temps(x) { push(out, d) } }
            },
            ExprKind.MatchE(scrut, arms) => { for d in self.collect_expr_temps(scrut) { push(out, d) } },
            _ => {},
        }
        return out
    }

    // -- type layout ------------------------------------------------------

    fun struct_info(self, name: str) -> StructInfo {
        for s in self.structs { if s.name == name { return s } }
        return self.structs[0]
    }

    fun enum_info(self, name: str) -> EnumInfo {
        for e in self.enums { if e.name == name { return e } }
        return self.enums[0]
    }

    fun is_boxed(self, t: Type) -> bool {
        return match t {
            Type.TEnum(n, a) => list_has_str(self.recursive_enums, n),
            _ => false,
        }
    }

    fun stored_size(self, t: Type) -> int32 {
        if self.is_boxed(t) { return 8 }
        return self.size(t)
    }

    // -- reference-counting predicates / naming ---------------------------

    // True if an inline value of `t` (transitively) holds a refcounted heap
    // pointer (a boxed enum, list, map, builder, or closure env), i.e. it
    // participates in reference counting and must be retained/dropped on
    // copy/release. Strings and scalars are immortal arena blobs.
    fun owns_heap(self, t: Type) -> bool {
        return self.owns_heap_seen(t, [])
    }

    fun owns_heap_seen(self, t: Type, seen: [str]) -> bool {
        if self.is_boxed(t) { return true }
        match t {
            Type.TList(e) => { return true },
            Type.TMap(k, v) => { return true },
            Type.TSB => { return true },
            Type.TFunc(ps, r) => { return true },
            Type.TStruct(n, a) => {
                if list_has_str(seen, n) { return false }
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                for f in info.fields {
                    if self.owns_heap_seen(subst_type(f.ty, sub), push_str_copy(seen, n)) { return true }
                }
                return false
            },
            Type.TEnum(n, a) => {
                if list_has_str(seen, n) { return false }
                let info = self.enum_info(n)
                let sub = self.type_subst(info.type_params, a)
                for v in info.variants {
                    for ft in v.payload {
                        if self.owns_heap_seen(subst_type(ft, sub), push_str_copy(seen, n)) { return true }
                    }
                }
                return false
            },
            Type.TTuple(es) => {
                for e in es {
                    if self.owns_heap_seen(e, seen) { return true }
                }
                return false
            },
            _ => {},
        }
        return false
    }

    fun owns_heap_opt(self, ot: Option<Type>) -> bool {
        return match ot { Some(t) => self.owns_heap(t), None => false }
    }

    // The drop routine for a heap-pointer leaf of type `t`.
    fun drop_call_name(self, t: Type) -> str {
        return match t {
            Type.TList(e) => "__drop_list_" + mono_token(e),
            Type.TMap(k, v) => format("__drop_map_{}_{}", mono_token(k), mono_token(v)),
            Type.TSB => "__sb_drop",
            _ => "__dropb_" + mono_token(t),
        }
    }

    // Retain a heap-pointer leaf at `off(base)`: bump its refcount (closures use
    // the null-safe env helper). Sharing is shallow — children are untouched.
    fun inc_box(var self, ptr_off: int32, base: str, t: Type) {
        if is_tfunc(t) {
            self.emit(format("movq {}(%{}), %rdi", ptr_off, base))
            self.emit("call __func_retain")
            return
        }
        self.emit(format("movq {}(%{}), %rax", ptr_off, base))
        self.emit("incq -8(%rax)")
    }

    // Release a heap-pointer leaf at `off(base)` via its type-specific routine.
    fun drop_box(var self, ptr_off: int32, base: str, t: Type) {
        if is_tfunc(t) {
            self.emit(format("movq {}(%{}), %rdi", ptr_off, base))
            self.emit("call __func_drop")
            return
        }
        self.register_drop(t)
        self.emit(format("movq {}(%{}), %rdi", ptr_off, base))
        self.emit("call " + self.drop_call_name(t))
    }

    // Record that `t`'s per-type drop routine must be emitted (a list/map/boxed
    // enum). Builders share one routine; deduped by mangled token.
    fun register_drop(var self, t: Type) {
        if is_sb_t(t) {
            self.need_sb = true
            return
        }
        let tok = mono_token(t)
        if list_has_str(self.drop_emitted, tok) { return }
        for p in self.need_drop { if mono_token(p) == tok { return } }
        push(self.need_drop, t)
    }

    // Record that `t`'s copy-on-write clone routine must be emitted.
    fun register_clone(var self, t: Type) {
        if is_sb_t(t) {
            self.need_sb = true
            return
        }
        let tok = mono_token(t)
        if list_has_str(self.clone_emitted, tok) { return }
        for p in self.need_clone { if mono_token(p) == tok { return } }
        push(self.need_clone, t)
    }

    // The clone routine for a list/map/builder cow site.
    fun clone_call_name(self, t: Type) -> str {
        return match t {
            Type.TList(e) => "__clone_list_" + mono_token(e),
            Type.TMap(k, v) => format("__clone_map_{}_{}", mono_token(k), mono_token(v)),
            Type.TSB => "__sb_clone",
            _ => "__sb_clone",
        }
    }

    fun variant_owns(self, v: VariantT, sub: [Subst]) -> bool {
        for ft0 in v.payload {
            let ft = subst_type(ft0, sub)
            if self.is_boxed(ft) || self.owns_heap(ft) { return true }
        }
        return false
    }

    // Walk the heap-pointer leaves an inline value of `t` at `off(base)` directly
    // owns, retaining (incq) or releasing (drop) each. Inline sub-aggregates
    // recurse; boxed/list/map/builder members are leaves the action follows.
    fun owned_walk(var self, base: str, off: int32, t: Type, retain: bool) {
        match t {
            Type.TStruct(n, a) => {
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                var cur = off
                for f in info.fields {
                    let ft = subst_type(f.ty, sub)
                    self.walk_member(base, cur, ft, retain)
                    cur = cur + self.stored_size(ft)
                }
            },
            Type.TTuple(es) => {
                var cur = off
                for et in es {
                    self.walk_member(base, cur, et, retain)
                    cur = cur + self.stored_size(et)
                }
            },
            Type.TEnum(n, a) => {
                let info = self.enum_info(n)
                let sub = self.type_subst(info.type_params, a)
                let done = self.label()
                self.emit(format("movq {}(%{}), %rax", off, base))
                var idx = 0
                for v in info.variants {
                    if self.variant_owns(v, sub) {
                        let nxt = self.label()
                        self.emit(format("cmpq ${}, %rax", idx))
                        self.emit(format("jne {}", nxt))
                        var cur = off + 8
                        for ft0 in v.payload {
                            let ft = subst_type(ft0, sub)
                            self.walk_member(base, cur, ft, retain)
                            cur = cur + self.stored_size(ft)
                        }
                        self.emit(format("jmp {}", done))
                        self.emit(format("{}:", nxt))
                    }
                    idx = idx + 1
                }
                self.emit(format("{}:", done))
            },
            _ => {},
        }
    }

    // Apply the retain/drop action to a single member of type `ft` at `off(base)`:
    // heap-pointer leaves trigger the action directly; inline aggregates recurse.
    fun walk_member(var self, base: str, off: int32, ft: Type, retain: bool) {
        if self.is_boxed(ft) || is_list_t(ft) || is_map_t(ft) || is_sb_t(ft) {
            if retain { self.inc_box(off, base, ft) } else { self.drop_box(off, base, ft) }
        } else if is_tfunc(ft) {
            if retain { self.inc_box(off + 8, base, ft) } else { self.drop_box(off + 8, base, ft) }
        } else if self.owns_heap(ft) {
            self.owned_walk(base, off, ft, retain)
        }
    }

    // Retain every heap reference an inline value of `t` at `off(base)` brings in
    // (the slot becomes a new co-owner).
    fun retain(var self, base: str, off: int32, t: Type) {
        if is_list_t(t) || is_map_t(t) || is_sb_t(t) { self.inc_box(off, base, t) }
        else if is_tfunc(t) { self.inc_box(off + 8, base, t) }
        else if self.owns_heap(t) { self.owned_walk(base, off, t, true) }
    }

    // Release every heap reference an inline value of `t` at `off(base)` holds.
    fun drop_value(var self, base: str, off: int32, t: Type) {
        if is_list_t(t) || is_map_t(t) || is_sb_t(t) { self.drop_box(off, base, t) }
        else if is_tfunc(t) { self.drop_box(off + 8, base, t) }
        else if self.owns_heap(t) { self.owned_walk(base, off, t, false) }
    }

    // A struct/enum is laid out per its concrete type arguments: generic type
    // parameters are substituted so a generic container instantiated with an
    // inline aggregate (e.g. `Option<TypeExpr>`) reserves the real payload size,
    // not a single 8-byte slot. Mirrors the oracle's monomorphized layout.
    fun type_subst(self, type_params: [str], args: [Type]) -> [Subst] {
        var sub: [Subst] = []
        var i = 0
        while i < len(type_params) && i < len(args) {
            push(sub, Subst { name: type_params[i], ty: args[i] })
            i = i + 1
        }
        return sub
    }

    fun size(self, t: Type) -> int32 {
        return match t {
            Type.TStruct(n, a) => self.struct_size(n, a),
            Type.TTuple(es) => self.tuple_size(es),
            Type.TEnum(n, a) => 8 + self.enum_payload_size(n, a),
            Type.TFunc(ps, r) => 16,
            _ => 8,
        }
    }

    fun struct_size(self, name: str, args: [Type]) -> int32 {
        let info = self.struct_info(name)
        let sub = self.type_subst(info.type_params, args)
        var total = 0
        for f in info.fields { total = total + self.stored_size(subst_type(f.ty, sub)) }
        return total
    }

    fun tuple_size(self, es: [Type]) -> int32 {
        var total = 0
        for e in es { total = total + self.stored_size(e) }
        return total
    }

    fun enum_payload_size(self, name: str, args: [Type]) -> int32 {
        let info = self.enum_info(name)
        let sub = self.type_subst(info.type_params, args)
        var maxp = 0
        for v in info.variants {
            var s = 0
            for ft in v.payload { s = s + self.stored_size(subst_type(ft, sub)) }
            if s > maxp { maxp = s }
        }
        return maxp
    }

    fun field_offset(self, st: Type, field: str) -> int32 {
        let name = struct_name_of(st)
        let info = self.struct_info(name)
        let sub = self.type_subst(info.type_params, type_args_of(st))
        var off = 0
        for f in info.fields {
            if f.name == field { return off }
            off = off + self.stored_size(subst_type(f.ty, sub))
        }
        return off
    }

    fun elem_offset(self, t: Type, index: int32) -> int32 {
        var off = 0
        var i = 0
        for e in tuple_elems(t) {
            if i == index { return off }
            off = off + self.stored_size(e)
            i = i + 1
        }
        return off
    }

    // -- enum layout ------------------------------------------------------

    fun variant_tag(self, enum_name: str, variant: str) -> int32 {
        var i = 0
        for v in self.enum_info(enum_name).variants {
            if v.name == variant { return i }
            i = i + 1
        }
        return 0
    }

    // Declared payload types of `variant` (generic type parameters unsubstituted).
    fun variant_payload_decl(self, enum_name: str, variant: str) -> [Type] {
        for v in self.enum_info(enum_name).variants {
            if v.name == variant { return v.payload }
        }
        return []
    }

    // Payload types of `variant` with the enum value `et`'s concrete type
    // arguments substituted in (so payloads carrying a type parameter resolve to
    // their instantiated type, matching this value's layout).
    fun variant_payload(self, et: Type, variant: str) -> [Type] {
        let name = enum_name_of(et)
        let info = self.enum_info(name)
        let sub = self.type_subst(info.type_params, type_args_of(et))
        var out: [Type] = []
        for ft in self.variant_payload_decl(name, variant) { push(out, subst_type(ft, sub)) }
        return out
    }

    fun variant_field_offset(self, et: Type, variant: str, index: int32) -> int32 {
        var off = 8
        let payload = self.variant_payload(et, variant)
        var i = 0
        while i < index {
            off = off + self.stored_size(payload[i])
            i = i + 1
        }
        return off
    }

    fun is_enum_name(self, n: str) -> bool {
        for d in self.decls {
            match d.kind {
                DeclKind.EnumDecl(en, variants, attrs, tps, isp) => { if en == n { return true } },
                _ => {},
            }
        }
        return false
    }

    fun is_nullary_variant(self, n: str) -> bool {
        for ei in self.enums {
            for v in ei.variants { if v.name == n && len(v.payload) == 0 { return true } }
        }
        return false
    }

    fun is_variant_name(self, n: str) -> bool {
        for ei in self.enums {
            for v in ei.variants { if v.name == n { return true } }
        }
        return false
    }

    fun has_function(self, n: str) -> bool {
        for f in self.funcs { if f.name == n { return true } }
        return false
    }

    // Whether a call through `callee` resolves indirectly (a function value)
    // rather than to a builtin, a user function, or a method.
    fun call_is_indirect(self, callee: Expr) -> bool {
        match callee.kind {
            ExprKind.Name(nm) => { return !is_builtin_call_name(nm) && !self.has_function(nm) },
            ExprKind.GetField(recv, field) => {
                return !self.has_func(format("{}.{}", self.type_key(self.type_of(recv.id)), field))
            },
            _ => {},
        }
        return true
    }

    // Classify an expression as an enum constructor (if it is one).
    fun ctor_info(self, e: Expr) -> CtorInfo {
        let enm = enum_name_of(self.type_of(e.id))
        match e.kind {
            ExprKind.GetField(tgt, field) => {
                let tn = expr_name(tgt)
                if tn != "" && self.is_enum_name(tn) {
                    return CtorInfo { ok: true, enum_name: enm, variant: field, args: [] }
                }
            },
            ExprKind.Name(n) => {
                if self.is_nullary_variant(n) && enm != "" {
                    return CtorInfo { ok: true, enum_name: enm, variant: n, args: [] }
                }
            },
            ExprKind.Call(callee, args) => {
                let qn = expr_name(callee_target(callee))
                let cfield = getfield_name(callee)
                if cfield != "" && qn != "" && self.is_enum_name(qn) {
                    return CtorInfo { ok: true, enum_name: enm, variant: cfield, args: args }
                }
                let un = expr_name(callee)
                if un != "" && !self.has_function(un) && self.is_variant_name(un) && enm != "" {
                    return CtorInfo { ok: true, enum_name: enm, variant: un, args: args }
                }
            },
            _ => {},
        }
        return CtorInfo { ok: false, enum_name: "", variant: "", args: [] }
    }

    // -- top-level --------------------------------------------------------

    fun generate(var self) -> str {
        let en = self.entry_name()
        self.emit_runtime_prelude(en)
        // Seed the worklist with every non-generic function (each keeps its name);
        // generic functions are stamped on demand from reached call sites (D13).
        for f in self.funcs {
            if f.has_decl && len(f.type_params) == 0 {
                let m = self.request_fn(f.name, [])
            }
        }
        while len(self.fn_worklist) > 0 || len(self.lam_jobs) > 0 {
            if len(self.fn_worklist) > 0 {
                let job = self.fn_worklist[len(self.fn_worklist) - 1]
                self.fn_worklist = drop_last(self.fn_worklist)
                if list_has_str(self.fn_done, job.mangled) { continue }
                push(self.fn_done, job.mangled)
                self.subst = job.subst
                self.gen_function(self.sig_of(job.orig).decl, job.mangled)
                self.subst = []
            } else {
                let lj = self.lam_jobs[len(self.lam_jobs) - 1]
                self.lam_jobs = drop_last(self.lam_jobs)
                if list_has_str(self.lam_done, lj.lifted) { continue }
                push(self.lam_done, lj.lifted)
                self.gen_lambda_function(lj)
            }
        }
        for pj in self.partial_jobs { self.gen_partial_function(pj) }
        for n in self.fnval_set { self.emit_fnval_thunk(n) }
        self.emit_drop_helpers()
        return self.assemble_source()
    }

    // Register an instantiation (or non-generic function) and return its emitted
    // (mangled) name, enqueueing it for stamping the first time it is seen.
    fun request_fn(var self, orig: str, targs: [Type]) -> str {
        let sig = self.sig_of(orig)
        if len(sig.type_params) == 0 {
            if !list_has_str(self.fn_done, orig) && !worklist_has(self.fn_worklist, orig) {
                push(self.fn_worklist, MonoFn { orig: orig, mangled: orig, subst: [] })
            }
            return orig
        }
        let mangled = mangle_fn(orig, targs)
        if !list_has_str(self.fn_done, mangled) && !worklist_has(self.fn_worklist, mangled) {
            var sub: [Subst] = []
            var i = 0
            while i < len(sig.type_params) {
                push(sub, Subst { name: sig.type_params[i], ty: targs[i] })
                i = i + 1
            }
            push(self.fn_worklist, MonoFn { orig: orig, mangled: mangled, subst: sub })
        }
        return mangled
    }

    // Solve a generic callee's type arguments (in declaration order) by unifying
    // its declared parameter types against the concrete argument types.
    fun solve_targs(self, sig: FuncSig, args: [Expr]) -> [Type] {
        var sub: [Subst] = []
        var i = 0
        while i < len(sig.params) && i < len(args) {
            for b in unify_into(sig.params[i], self.type_of(args[i].id)) { push(sub, b) }
            i = i + 1
        }
        var out: [Type] = []
        for tp in sig.type_params {
            match subst_get(sub, tp) { Some(t) => { push(out, t) }, None => { push(out, Type.TInt(32, true)) } }
        }
        return out
    }

    fun entry_name(self) -> str {
        for d in self.decls {
            match d.kind {
                DeclKind.FunDecl(fd) => {
                    for a in fd.attributes { if a.name == "main" { return fd.name } }
                },
                _ => {},
            }
        }
        return "main"
    }

    fun assemble_source(var self) -> str {
        var out: [str] = []
        push(out, "\t.text")
        for line in self.text { push(out, line) }
        push(out, "")
        push(out, "\t.section .rodata")
        push(out, ".Lbool_true:\n\t.ascii \"true\"")
        push(out, ".Lbool_false:\n\t.ascii \"false\"")
        push(out, ".Lstr_true:\n\t.quad 4\n\t.ascii \"true\"")
        push(out, ".Lstr_false:\n\t.quad 5\n\t.ascii \"false\"")
        push(out, ".Lstr_minus:\n\t.quad 1\n\t.ascii \"-\"")
        for line in self.rodata { push(out, line) }
        push(out, "")
        push(out, "\t.bss")
        push(out, "\t.align 8")
        push(out, "__heap_ptr:")
        push(out, "\t.skip 8")
        push(out, "__heap_end:")
        push(out, "\t.skip 8")
        push(out, "__free_buckets:")
        push(out, "\t.skip 4616")
        push(out, "__argc:")
        push(out, "\t.skip 8")
        push(out, "__argv:")
        push(out, "\t.skip 8")
        push(out, "__envp:")
        push(out, "\t.skip 8")
        push(out, "__io_errno_val:")
        push(out, "\t.skip 8")
        push(out, "__run_stderr_val:")
        push(out, "\t.skip 8")
        push(out, "__run_exit_val:")
        push(out, "\t.skip 8")
        push(out, "__run_signal_val:")
        push(out, "\t.skip 8")
        push(out, "__run_errno_val:")
        push(out, "\t.skip 8")
        push(out, "")
        push(out, "\t.section .note.GNU-stack,\"\",@progbits")
        push(out, "")
        return join_lines(out)
    }

    // -- functions --------------------------------------------------------

    fun gen_function(var self, fd: FunData, mangled: str) {
        let sig = self.sig_of(fd.name)
        self.locals = [:]
        self.for_lv = [:]
        self.for_end = [:]
        self.destruct_base = [:]
        self.destruct_leaves = [:]
        self.match_scrut = [:]
        self.match_res = [:]
        self.match_bind = [:]
        self.try_res = [:]
        self.unbox = [:]
        self.for_elem = [:]
        self.ind_code = [:]
        self.ind_env = [:]
        self.cur_mangled = mangled
        self.scopes = []
        self.loops = []
        self.cursor = 0
        let ret = opt_subst_type(sig.ret, self.subst)
        self.struct_ret = is_aggregate_opt(ret)
        self.ret_type = ret

        let frame = self.layout_frame(fd)
        self.epilogue = format(".Lret_{}", mangled)

        self.emit(format("myla_{}:", mangled))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        if frame > 0 { self.emit(format("subq ${}, %rsp", frame)) }

        self.open_scope()
        var param_base = 0
        if self.struct_ret { param_base = 1 }
        var i = 0
        while i < len(fd.params) {
            let offset = 16 + 8 * (param_base + i)
            self.bind(fd.params[i].name, "param", offset, subst_type(sig.params[i], self.subst))
            i = i + 1
        }

        match fd.body { Some(b) => { self.gen_block(b) }, None => {} }

        self.emit(format("{}:", self.epilogue))
        self.emit("leave")
        self.emit("ret")
        self.emit("")
        self.close_scope()
    }

    // Assign every local/temp a unique stack slot; return the frame size.
    fun layout_frame(var self, fd: FunData) -> int32 {
        match fd.body {
            Some(b) => { for s in b.stmts { self.visit_stmt(s) } },
            None => {},
        }
        return band(self.cursor + 15, bnot(15))
    }

    fun alloc(var self, id: int32, size: int32) {
        self.cursor = self.cursor + size
        self.locals[id] = -self.cursor
    }

    fun visit_stmt(var self, s: Stmt) {
        match s.kind {
            StmtKind.VarDecl(k, name, ty, init) => {
                self.visit_expr(init)
                self.alloc(s.id, self.size(self.type_of(init.id)))
            },
            StmtKind.DestructDecl(k, binding, ty, init) => {
                self.visit_expr(init)
                self.cursor = self.cursor + 8
                self.destruct_base[s.id] = -self.cursor
                var slots: [int32] = []
                for lf in self.collect_leaves(binding, self.type_of(init.id)) {
                    self.cursor = self.cursor + self.size(lf.ty)
                    push(slots, -self.cursor)
                }
                self.destruct_leaves[s.id] = slots
            },
            StmtKind.ReturnS(ov) => { self.visit_opt_expr(ov) },
            StmtKind.ExprStmt(e) => { self.visit_expr(e) },
            StmtKind.Assign(target, value) => {
                self.visit_expr(target)
                self.visit_expr(value)
            },
            StmtKind.IfS(cond, then, otherwise) => {
                self.visit_expr(cond)
                self.visit_block_stmts(then)
                self.visit_else(otherwise)
            },
            StmtKind.WhileS(cond, body) => {
                self.visit_expr(cond)
                self.visit_block_stmts(body)
            },
            StmtKind.ForS(vn, start, end, body, iter) => {
                self.visit_opt_expr(start)
                self.visit_opt_expr(end)
                self.visit_opt_expr(iter)
                self.cursor = self.cursor + 8
                self.for_lv[s.id] = -self.cursor
                self.cursor = self.cursor + 8
                self.for_end[s.id] = -self.cursor
                match iter {
                    Some(it) => {
                        let itt = self.type_of(it.id)
                        let elem_t = match itt { Type.TMap(k, v) => k, _ => list_elem(itt) }
                        self.cursor = self.cursor + self.size(elem_t)
                        self.for_elem[s.id] = -self.cursor
                    },
                    None => {},
                }
                self.visit_block_stmts(body)
            },
            _ => {},
        }
    }

    fun visit_block_stmts(var self, b: Block) {
        for st in b.stmts { self.visit_stmt(st) }
    }

    fun visit_else(var self, ot: Option<ElseTail>) {
        match ot {
            Some(et) => { self.visit_else_tail(et) },
            None => {},
        }
    }

    fun visit_else_tail(var self, et: ElseTail) {
        match et {
            ElseTail.ElseBlock(b) => { self.visit_block_stmts(b) },
            ElseTail.ElseIf(s2) => { self.visit_stmt(s2) },
        }
    }

    fun visit_opt_expr(var self, ov: Option<Expr>) {
        match ov { Some(e) => { self.visit_expr(e) }, None => {} }
    }

    fun visit_expr(var self, e: Expr) {
        let ci = self.ctor_info(e)
        if ci.ok {
            for a in ci.args { self.visit_expr(a) }
            self.alloc(e.id, self.size(self.type_of(e.id)))
            return
        }
        match e.kind {
            ExprKind.Unary(op, x) => { self.visit_expr(x) },
            ExprKind.Cast(x, ty) => { self.visit_expr(x) },
            ExprKind.Binary(op, l, r) => {
                self.visit_expr(l)
                self.visit_expr(r)
                let bt = self.type_of(e.id)
                if op == ">>" && is_tfunc(bt) {
                    self.alloc(e.id, 16)
                } else if is_overloadable_op(op) && is_struct_or_enum_t(self.type_of(l.id)) && is_aggregate(bt) {
                    self.alloc(e.id, self.size(bt))
                }
            },
            ExprKind.Call(c, args) => {
                let indirect = self.call_is_indirect(c)
                match c.kind {
                    ExprKind.GetField(rc, fld) => { self.visit_expr(c) },
                    ExprKind.Name(nm) => { if indirect { self.visit_expr(c) } },
                    _ => { self.visit_expr(c) },
                }
                for a in args { self.visit_expr(a) }
                let rt = self.type_of(e.id)
                if is_aggregate(rt) || self.owns_heap(rt) { self.alloc(e.id, self.size(rt)) }
                if indirect {
                    self.cursor = self.cursor + 8
                    self.ind_code[e.id] = -self.cursor
                    self.cursor = self.cursor + 8
                    self.ind_env[e.id] = -self.cursor
                }
            },
            ExprKind.Name(n) => {
                if self.has_function(n) && is_tfunc(self.type_of(e.id)) { self.alloc(e.id, 16) }
            },
            ExprKind.Lambda(params, ret, body) => { self.alloc(e.id, 16) },
            ExprKind.GetField(tgt, field) => { self.visit_expr(tgt) },
            ExprKind.TupleIndex(tgt, idx) => { self.visit_expr(tgt) },
            ExprKind.Index(base, idx) => {
                self.visit_expr(base)
                self.visit_expr(idx)
            },
            ExprKind.ListLit(elems) => {
                for el in elems { self.visit_expr(el) }
                self.alloc(e.id, 8)
            },
            ExprKind.MapLit(entries) => {
                for en in entries {
                    self.visit_expr(en.key)
                    self.visit_expr(en.value)
                }
                self.alloc(e.id, 8)
            },
            ExprKind.StructLit(name, fields) => {
                for fi in fields { self.visit_expr(fi.value) }
                self.alloc(e.id, self.size(self.type_of(e.id)))
            },
            ExprKind.TupleLit(elems) => {
                for el in elems { self.visit_expr(el) }
                self.alloc(e.id, self.size(self.type_of(e.id)))
            },
            ExprKind.MatchE(scrut, arms) => {
                self.visit_expr(scrut)
                self.cursor = self.cursor + self.size(self.type_of(scrut.id))
                self.match_scrut[e.id] = -self.cursor
                self.cursor = self.cursor + self.size(self.type_of(e.id))
                self.match_res[e.id] = -self.cursor
                for arm in arms {
                    for b in self.pattern_binds(arm.pattern, self.type_of(scrut.id)) {
                        self.cursor = self.cursor + self.size(b.ty)
                        self.match_bind[format("{}:{}", arm.pattern.id, b.name)] = -self.cursor
                    }
                    self.visit_pattern_unbox(arm.pattern, self.type_of(scrut.id))
                    match arm.guard { Some(g) => { self.visit_expr(g) }, None => {} }
                    self.visit_arm_body(arm.body)
                }
            },
            ExprKind.Try(inner) => {
                self.visit_expr(inner)
                self.cursor = self.cursor + self.size(self.type_of(e.id))
                self.try_res[e.id] = -self.cursor
            },
            _ => {},
        }
    }

    fun visit_arm_body(var self, body: ExprOrBlock) {
        match body {
            ExprOrBlock.EB_Expr(ex) => { self.visit_expr(ex) },
            ExprOrBlock.EB_Block(b) => { for s in b.stmts { self.visit_stmt(s) } },
        }
    }

    // -- statements -------------------------------------------------------

    fun gen_block(var self, b: Block) {
        self.open_scope()
        for s in b.stmts { self.gen_stmt(s) }
        self.close_scope()
    }

    fun gen_stmt(var self, s: Stmt) {
        match s.kind {
            StmtKind.ExprStmt(e) => {
                if is_aggregate(self.type_of(e.id)) { self.addr_of_aggregate(e) } else { self.eval(e) }
                self.drop_expr_temps(e)
            },
            StmtKind.VarDecl(k, name, ty, init) => {
                let off = self.local_of(s.id)
                let t = self.type_of(init.id)
                if is_aggregate(t) {
                    self.addr_of_aggregate(init)
                    self.emit("movq %rax, %rsi")
                    self.emit(format("leaq {}(%rbp), %rdi", off))
                    self.emit_copy(self.size(t))
                    self.retain("rbp", off, t)
                } else {
                    self.eval(init)
                    self.emit(format("movq %rax, {}(%rbp)", off))
                    if self.owns_heap(t) { self.retain("rbp", off, t) }
                }
                self.bind(name, "local", off, t)
                self.register_owner(off, t)
                self.drop_expr_temps(init)
            },
            StmtKind.DestructDecl(k, binding, ty, init) => { self.gen_destruct(s, binding, init) },
            StmtKind.ReturnS(ov) => {
                match ov {
                    Some(e) => {
                        if self.struct_ret {
                            self.addr_of_aggregate(e)
                            self.emit("movq %rax, %rsi")
                            self.emit("movq 16(%rbp), %rdi")
                            self.emit_copy(self.size(self.type_of(e.id)))
                            match self.ret_type {
                                Some(rt) => {
                                    if self.owns_heap(rt) {
                                        self.emit("movq 16(%rbp), %r8")
                                        self.retain("r8", 0, rt)
                                    }
                                },
                                None => {},
                            }
                            self.drop_expr_temps(e)
                            self.emit_return_drops()
                            self.emit("movq 16(%rbp), %rax")
                        } else {
                            self.eval(e)
                            self.emit("pushq %rax")
                            match self.ret_type {
                                Some(rt) => { if self.owns_heap(rt) { self.emit("incq -8(%rax)") } },
                                None => {},
                            }
                            self.drop_expr_temps(e)
                            self.emit_return_drops()
                            self.emit("popq %rax")
                        }
                    },
                    None => { self.emit_return_drops() },
                }
                self.emit(format("jmp {}", self.epilogue))
            },
            StmtKind.Assign(target, value) => { self.gen_assign(target, value) },
            StmtKind.IfS(cond, then, otherwise) => { self.gen_if(cond, then, otherwise) },
            StmtKind.WhileS(cond, body) => { self.gen_while(cond, body) },
            StmtKind.ForS(vn, start, end, body, iter) => { self.gen_for(s, vn, start, end, body, iter) },
            StmtKind.BreakS => {
                let lp = self.loops[len(self.loops) - 1]
                self.emit_loop_exit_drops(lp.depth)
                self.emit(format("jmp {}", lp.brk))
            },
            StmtKind.ContinueS => {
                let lp = self.loops[len(self.loops) - 1]
                self.emit_loop_exit_drops(lp.depth)
                self.emit(format("jmp {}", lp.cont))
            },
        }
    }

    // Assignment to an lvalue (`name`, `agg.field`, `tuple.N`), scalar or aggregate.
    // The checker leaves lvalue targets untyped, so key on the value's type (they
    // are equal by the assignment's type rule).
    fun gen_assign(var self, target: Expr, value: Expr) {
        let t = self.place_type(target)
        let is_name = match target.kind { ExprKind.Name(n) => true, _ => false }
        match target.kind {
            ExprKind.Index(base, idx) => {
                if is_map_t(self.place_type(base)) { self.gen_map_set(base, idx, value)
                return }
                let et = list_elem(self.place_type(base))
                self.mut_elem_addr(target, base, idx)   // &elem (CoW) -> rax
                self.emit("pushq %rax")
                self.store_into_elem(value, et, true)
                self.drop_expr_temps(value)
                return
            },
            _ => {},
        }
        if self.is_boxed(t) && !is_name {
            // assigning into a boxed member: drop the old cell, store a fresh one
            self.box_value(value, t)
            self.emit("pushq %rax")
            self.addr_of_lvalue(target)
            self.emit("movq %rax, %rcx")
            self.emit("movq (%rcx), %rsi")
            self.emit("popq %rax")
            self.emit("movq %rax, (%rcx)")
            self.emit("movq %rsi, %rdi")
            self.register_drop(t)
            self.emit("call " + self.drop_call_name(t))
            self.drop_expr_temps(value)
        } else if is_aggregate(t) && self.owns_heap(t) {
            if is_name {
                let b = self.lookup(match target.kind { ExprKind.Name(n) => n, _ => "" })
                self.addr_of_aggregate(value)
                self.emit("pushq %rax")
                self.drop_value("rbp", b.offset, t)
                self.emit("popq %rsi")
                self.emit(format("leaq {}(%rbp), %rdi", b.offset))
                self.emit_copy(self.size(t))
                self.retain("rbp", b.offset, t)
                self.drop_expr_temps(value)
            } else {
                // A reference-counted aggregate into a member/element place: same
                // drop-old / copy-new / retain-new dance as the simple-variable
                // case, but the slot address is computed (not rbp-relative). Hold
                // it in callee-saved %rbx so it survives the drop/retain helper
                // calls; the new value is built first (it may read the old one).
                self.addr_of_aggregate(value)
                self.emit("pushq %rax")
                self.addr_of_lvalue(target)
                self.emit("pushq %rbx")
                self.emit("movq %rax, %rbx")
                self.drop_value("rbx", 0, t)
                self.emit("movq 8(%rsp), %rsi")
                self.emit("movq %rbx, %rdi")
                self.emit_copy(self.size(t))
                self.retain("rbx", 0, t)
                self.emit("popq %rbx")
                self.emit("addq $8, %rsp")
                self.drop_expr_temps(value)
            }
        } else if is_aggregate(t) {
            self.addr_of_aggregate(value)
            self.emit("movq %rax, %rsi")
            self.addr_of_lvalue(target)
            self.emit("movq %rax, %rdi")
            self.emit_copy(self.size(t))
            self.drop_expr_temps(value)
        } else if self.owns_heap(t) {
            if is_name {
                let b = self.lookup(match target.kind { ExprKind.Name(n) => n, _ => "" })
                self.eval(value)
                self.emit("pushq %rax")
                self.emit("incq -8(%rax)")
                self.drop_value("rbp", b.offset, t)
                self.emit("popq %rax")
                self.emit(format("movq %rax, {}(%rbp)", b.offset))
            } else {
                self.eval(value)
                self.emit("pushq %rax")
                self.emit("incq -8(%rax)")
                self.addr_of_lvalue(target)
                self.emit("pushq %rax")
                self.emit("movq %rax, %rcx")
                self.drop_box(0, "rcx", t)
                self.emit("popq %rcx")
                self.emit("popq %rax")
                self.emit("movq %rax, (%rcx)")
            }
            self.drop_expr_temps(value)
        } else {
            self.eval(value)
            self.emit("pushq %rax")
            self.addr_of_lvalue(target)
            self.emit("popq %rcx")
            self.emit("movq %rcx, (%rax)")
            self.drop_expr_temps(value)
        }
    }

    fun gen_destruct(var self, s: Stmt, binding: [BindElem], init: Expr) {
        self.addr_of_aggregate(init)
        let base_slot = self.destruct_base[s.id]
        self.emit(format("movq %rax, {}(%rbp)", base_slot))
        let leaves = self.collect_leaves(binding, self.type_of(init.id))
        let slots = self.destruct_leaves[s.id]
        var i = 0
        for lf in leaves {
            let leaf_off = slots[i]
            self.emit(format("movq {}(%rbp), %rsi", base_slot))
            if lf.off != 0 { self.emit(format("addq ${}, %rsi", lf.off)) }
            if is_aggregate(lf.ty) {
                self.emit(format("leaq {}(%rbp), %rdi", leaf_off))
                self.emit_copy(self.size(lf.ty))
            } else {
                self.emit("movq (%rsi), %rax")
                self.emit(format("movq %rax, {}(%rbp)", leaf_off))
            }
            self.bind(lf.name, "local", leaf_off, lf.ty)
            i = i + 1
        }
    }

    fun collect_leaves(self, elems: [BindElem], t: Type) -> [DLeaf] {
        var out: [DLeaf] = []
        let ets = tuple_elems(t)
        var off = 0
        var i = 0
        for be in elems {
            let et = ets[i]
            match be {
                BindElem.BName(n) => { push(out, DLeaf { name: n, off: off, ty: et }) },
                BindElem.BWild => {},
                BindElem.BTuple(sub) => {
                    for lf in self.collect_leaves(sub, et) {
                        push(out, DLeaf { name: lf.name, off: off + lf.off, ty: lf.ty })
                    }
                },
            }
            off = off + self.stored_size(et)
            i = i + 1
        }
        return out
    }

    fun gen_if(var self, cond: Expr, then: Block, otherwise: Option<ElseTail>) {
        let end = self.label()
        self.eval(cond)
        self.emit("testq %rax, %rax")
        match otherwise {
            None => {
                self.emit(format("jz {}", end))
                self.gen_block(then)
                self.emit(format("{}:", end))
            },
            Some(et) => {
                let els = self.label()
                self.emit(format("jz {}", els))
                self.gen_block(then)
                self.emit(format("jmp {}", end))
                self.emit(format("{}:", els))
                match et {
                    ElseTail.ElseBlock(b) => { self.gen_block(b) },
                    ElseTail.ElseIf(s2) => { self.gen_stmt(s2) },
                }
                self.emit(format("{}:", end))
            },
        }
    }

    fun gen_while(var self, cond: Expr, body: Block) {
        let start = self.label()
        let end = self.label()
        self.emit(format("{}:", start))
        self.eval(cond)
        self.emit("testq %rax, %rax")
        self.emit(format("jz {}", end))
        push(self.loops, LoopLab { cont: start, brk: end, depth: len(self.drop_scopes) })
        self.gen_block(body)
        self.loops = drop_last(self.loops)
        self.emit(format("jmp {}", start))
        self.emit(format("{}:", end))
    }

    fun gen_for(var self, s: Stmt, vn: str, start: Option<Expr>, end: Option<Expr>, body: Block, iter: Option<Expr>) {
        match iter {
            Some(it) => { self.gen_for_in(s, vn, it, body)
            return },
            None => {},
        }
        let loop_t = match start { Some(e) => self.type_of(e.id), None => Type.TInt(32, true) }
        let lv = self.get_or_zero(self.for_lv, s.id)
        let fe = self.get_or_zero(self.for_end, s.id)
        match start { Some(e) => { self.eval(e) }, None => {} }
        self.emit(format("movq %rax, {}(%rbp)", lv))
        match end { Some(e) => { self.eval(e) }, None => {} }
        self.emit(format("movq %rax, {}(%rbp)", fe))

        let lstart = self.label()
        let lcont = self.label()
        let lend = self.label()
        self.emit(format("{}:", lstart))
        self.emit(format("movq {}(%rbp), %rax", lv))
        self.emit(format("movq {}(%rbp), %rcx", fe))
        self.emit("cmpq %rcx, %rax")
        if int_signed(loop_t) { self.emit(format("jge {}", lend)) }
        else { self.emit(format("jae {}", lend)) }

        self.open_scope()
        self.bind(vn, "local", lv, loop_t)
        push(self.loops, LoopLab { cont: lcont, brk: lend, depth: len(self.drop_scopes) - 1 })
        for st in body.stmts { self.gen_stmt(st) }
        self.loops = drop_last(self.loops)
        self.close_scope()

        self.emit(format("{}:", lcont))
        self.emit(format("movq {}(%rbp), %rax", lv))
        self.emit("addq $1, %rax")
        self.wrap(loop_t)
        self.emit(format("movq %rax, {}(%rbp)", lv))
        self.emit(format("jmp {}", lstart))
        self.emit(format("{}:", lend))
    }

    fun gen_for_in(var self, s: Stmt, vn: str, it: Expr, body: Block) {
        let itt = self.type_of(it.id)
        if is_map_t(itt) { self.gen_for_in_map(s, vn, it, body)
        return }
        let et = list_elem(itt)
        let stride = self.elem_stride(et)
        let idx = self.get_or_zero(self.for_lv, s.id)
        let iptr = self.get_or_zero(self.for_end, s.id)
        let elem_slot = self.get_or_zero(self.for_elem, s.id)
        self.eval(it)
        self.emit(format("movq %rax, {}(%rbp)", iptr))
        self.retain("rbp", iptr, itt)             // hold a reference for the loop
        self.drop_expr_temps(it)
        self.emit(format("movq $0, {}(%rbp)", idx))
        let lstart = self.label()
        let lcont = self.label()
        let lend = self.label()
        self.emit(format("{}:", lstart))
        self.emit(format("movq {}(%rbp), %rax", idx))
        self.emit(format("movq {}(%rbp), %rcx", iptr))
        self.emit("movq (%rcx), %rdx")
        self.emit("cmpq %rdx, %rax")
        self.emit(format("jae {}", lend))
        self.emit("leaq 16(%rcx), %rcx")
        if stride == 8 { self.emit("leaq (%rcx,%rax,8), %rcx") }
        else {
            self.emit(format("imulq ${}, %rax", stride))
            self.emit("addq %rax, %rcx")
        }
        if is_aggregate(et) {
            // The loop slot holds the inline value. For boxed element types the
            // list stores a pointer to the heap box, so dereference it first to
            // copy the inline payload (a borrow: the list keeps ownership).
            if self.is_boxed(et) { self.emit("movq (%rcx), %rsi") }
            else { self.emit("movq %rcx, %rsi") }
            self.emit(format("leaq {}(%rbp), %rdi", elem_slot))
            self.emit_copy(self.size(et))
        } else {
            self.emit("movq (%rcx), %rax")
            self.emit(format("movq %rax, {}(%rbp)", elem_slot))
        }
        // The loop variable borrows the element (the list keeps ownership), so it
        // is neither retained nor registered for dropping.
        self.open_scope()
        self.bind(vn, "local", elem_slot, et)
        push(self.loops, LoopLab { cont: lcont, brk: lend, depth: len(self.drop_scopes) - 1 })
        for st in body.stmts { self.gen_stmt(st) }
        self.loops = drop_last(self.loops)
        self.close_scope()
        self.emit(format("{}:", lcont))
        self.emit(format("movq {}(%rbp), %rax", idx))
        self.emit("addq $1, %rax")
        self.emit(format("movq %rax, {}(%rbp)", idx))
        self.emit(format("jmp {}", lstart))
        self.emit(format("{}:", lend))
        self.drop_value("rbp", iptr, itt)         // release the loop reference
    }

    fun gen_for_in_map(var self, s: Stmt, vn: str, it: Expr, body: Block) {
        let mt = self.type_of(it.id)
        let kt = map_key(mt)
        let stride = self.stored_size(kt)
        let idx = self.get_or_zero(self.for_lv, s.id)
        let iptr = self.get_or_zero(self.for_end, s.id)
        let elem_slot = self.get_or_zero(self.for_elem, s.id)
        self.eval(it)
        self.emit("movq %rax, %rdi")
        self.emit(format("movq ${}, %rsi", self.map_slot_size(mt)))
        self.emit(format("movq ${}, %rdx", stride))
        self.emit("call __map_keys")
        self.emit(format("movq %rax, {}(%rbp)", iptr))
        self.drop_expr_temps(it)                   // release a temp map (keys copied out)
        self.emit(format("movq $0, {}(%rbp)", idx))
        let lstart = self.label()
        let lcont = self.label()
        let lend = self.label()
        self.emit(format("{}:", lstart))
        self.emit(format("movq {}(%rbp), %rax", idx))
        self.emit(format("movq {}(%rbp), %rcx", iptr))
        self.emit("movq (%rcx), %rdx")
        self.emit("cmpq %rdx, %rax")
        self.emit(format("jae {}", lend))
        self.emit("leaq 16(%rcx), %rcx")
        if stride == 8 { self.emit("leaq (%rcx,%rax,8), %rcx") }
        else {
            self.emit(format("imulq ${}, %rax", stride))
            self.emit("addq %rax, %rcx")
        }
        self.emit("movq (%rcx), %rax")
        self.emit(format("movq %rax, {}(%rbp)", elem_slot))
        self.open_scope()
        self.bind(vn, "local", elem_slot, kt)
        push(self.loops, LoopLab { cont: lcont, brk: lend, depth: len(self.drop_scopes) - 1 })
        for st in body.stmts { self.gen_stmt(st) }
        self.loops = drop_last(self.loops)
        self.close_scope()
        self.emit(format("{}:", lcont))
        self.emit(format("movq {}(%rbp), %rax", idx))
        self.emit("addq $1, %rax")
        self.emit(format("movq %rax, {}(%rbp)", idx))
        self.emit(format("jmp {}", lstart))
        self.emit(format("{}:", lend))
        self.drop_value("rbp", iptr, Type.TList(kt))   // free the keys list
    }

    fun get_or_zero(self, m: [int32: int32], id: int32) -> int32 {
        match get(m, id) { Some(o) => { return o }, None => {} }
        return 0
    }

    // -- expressions ------------------------------------------------------

    fun eval(var self, e: Expr) {
        match e.kind {
            ExprKind.IntLit(v, suf, isc) => {
                self.emit(format("movabsq ${}, %rax", v))
                if !isc { self.wrap(self.type_of(e.id)) }
            },
            ExprKind.BoolLit(b) => {
                var one = 0
                if b { one = 1 }
                self.emit(format("movq ${}, %rax", one))
            },
            ExprKind.StrLit(s) => {
                let lab = self.string_label(s)
                self.emit(format("leaq {}(%rip), %rax", lab))
            },
            ExprKind.Name(n) => { self.eval_name(n) },
            ExprKind.Unary(op, x) => { self.eval_unary(e, op, x) },
            ExprKind.Binary(op, l, r) => { self.eval_binary(e, op, l, r) },
            ExprKind.Cast(x, ty) => { self.gen_cast(e, x) },
            ExprKind.Call(c, args) => {
                self.gen_call(e, c, args)
                let rt = self.type_of(e.id)
                // A list/map/builder result: stash the escaped pointer in its
                // temp slot so the temp-drop machinery releases it if unconsumed.
                if self.owns_heap(rt) && !is_aggregate(rt) {
                    self.emit(format("movq %rax, {}(%rbp)", self.local_of(e.id)))
                }
            },
            ExprKind.GetField(tgt, field) => {
                self.addr_of_aggregate(tgt)
                let foff = self.field_offset(self.place_type(tgt), field)
                self.emit(format("movq {}(%rax), %rax", foff))
            },
            ExprKind.TupleIndex(tgt, idx) => {
                self.addr_of_aggregate(tgt)
                let foff = self.elem_offset(self.place_type(tgt), idx as int32)
                self.emit(format("movq {}(%rax), %rax", foff))
            },
            ExprKind.Index(base, idx) => { self.gen_index_read(e, base, idx) },
            ExprKind.Lambda(params, ret, body) => {
                self.gen_lambda_value(e, params, body)
                self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            },
            ExprKind.ListLit(elems) => { self.gen_list_lit(e, elems) },
            ExprKind.MapLit(entries) => { self.gen_map_lit(e, entries) },
            ExprKind.MatchE(scrut, arms) => {
                self.gen_match(e, scrut, arms)
                self.emit(format("movq {}(%rbp), %rax", self.match_res[e.id]))
            },
            ExprKind.Try(inner) => {
                self.gen_try(e, inner)
                self.emit(format("movq {}(%rbp), %rax", self.try_res[e.id]))
            },
            _ => {},
        }
    }

    fun eval_name(var self, n: str) {
        if self.has_binding(n) {
            self.emit_name_scalar(self.lookup(n))
            return
        }
        match self.const_value_expr(n) { Some(ve) => { self.eval(ve) }, None => {} }
    }

    fun has_binding(self, name: str) -> bool {
        var i = len(self.scopes) - 1
        while i >= 0 {
            var j = 0
            while j < len(self.scopes[i]) {
                if self.scopes[i][j].name == name { return true }
                j = j + 1
            }
            i = i - 1
        }
        return false
    }

    fun const_value_expr(self, name: str) -> Option<Expr> {
        for d in self.decls {
            match d.kind {
                DeclKind.ConstDecl(cn, ty, value, attrs, isp) => {
                    if cn == name { return Some(value) }
                },
                _ => {},
            }
        }
        return None
    }

    fun eval_unary(var self, e: Expr, op: str, x: Expr) {
        self.eval(x)
        if op == "-" {
            self.emit("negq %rax")
            self.wrap(self.type_of(e.id))
        } else if op == "~" {
            self.emit("notq %rax")
            self.wrap(self.type_of(e.id))
        } else {
            self.emit("testq %rax, %rax")
            self.emit("sete %al")
            self.emit("movzbq %al, %rax")
        }
    }

    fun eval_binary(var self, e: Expr, op: str, l: Expr, r: Expr) {
        if op == "&&" || op == "||" {
            self.eval_logical(op, l, r)
            return
        }
        if op == ">>" && is_tfunc(self.type_of(e.id)) {
            self.gen_compose(e, l, r)
            return
        }
        let lt = self.type_of(l.id)
        if is_overloadable_op(op) && is_struct_or_enum_t(lt) {
            self.gen_overloaded_binary(e, op, l, r, lt)
            return
        }
        if (op == "==" || op == "!=") && is_tstr(lt) {
            self.eval(r)
            self.emit("pushq %rax")
            self.eval(l)
            self.emit("movq %rax, %rdi")
            self.emit("popq %rsi")
            self.emit("call __str_eq")
            if op == "!=" {
                self.emit("testq %rax, %rax")
                self.emit("sete %al")
                self.emit("movzbq %al, %rax")
            }
            return
        }
        if op == "+" && is_tstr(lt) {
            self.eval(r)
            self.emit("pushq %rax")
            self.eval(l)
            self.emit("movq %rax, %rdi")
            self.emit("popq %rsi")
            self.emit("call __str_concat")
            return
        }
        self.eval(r)
        self.emit("pushq %rax")
        self.eval(l)
        self.emit("popq %rcx")
        let rt = self.type_of(e.id)
        if op == "+" {
            self.emit("addq %rcx, %rax")
            self.wrap(rt)
        } else if op == "-" {
            self.emit("subq %rcx, %rax")
            self.wrap(rt)
        } else if op == "*" {
            self.emit("imulq %rcx, %rax")
            self.wrap(rt)
        } else if op == "/" || op == "%" {
            self.emit("testq %rcx, %rcx")
            self.emit("jz __trap")
            if int_signed(lt) {
                self.emit("cqo")
                self.emit("idivq %rcx")
            } else {
                self.emit("xorq %rdx, %rdx")
                self.emit("divq %rcx")
            }
            if op == "%" { self.emit("movq %rdx, %rax") }
            self.wrap(rt)
        } else if is_cmp(op) {
            self.emit("cmpq %rcx, %rax")
            self.emit(format("{} %al", cmp_set(op, int_signed(lt))))
            self.emit("movzbq %al, %rax")
        } else if op == "==" || op == "!=" {
            self.emit("cmpq %rcx, %rax")
            if op == "==" { self.emit("sete %al") } else { self.emit("setne %al") }
            self.emit("movzbq %al, %rax")
        } else if op == "&" {
            self.emit("andq %rcx, %rax")
            self.wrap(rt)
        } else if op == "|" {
            self.emit("orq %rcx, %rax")
            self.wrap(rt)
        } else if op == "^" {
            self.emit("xorq %rcx, %rax")
            self.wrap(rt)
        } else if op == "<<" || op == ">>" {
            self.emit(format("andq ${}, %rcx", int_width_cg(rt) - 1))
            if op == "<<" {
                self.emit("shlq %cl, %rax")
            } else if int_signed(lt) {
                self.emit("sarq %cl, %rax")
            } else {
                self.emit("shrq %cl, %rax")
            }
            self.wrap(rt)
        }
    }

    // `a OP b` on a user type desugars to the corresponding trait method:
    // arithmetic -> add/sub/..., `==`/`!=` -> Eq.eq, ordering -> Ord.cmp.
    fun gen_overloaded_binary(var self, e: Expr, op: str, l: Expr, r: Expr, lt: Type) {
        let key = self.type_key(lt)
        if op == "==" || op == "!=" {
            self.gen_scalar_method2(key, "eq", l, r)
            if op == "!=" {
                self.emit("testq %rax, %rax")
                self.emit("sete %al")
                self.emit("movzbq %al, %rax")
            }
            return
        }
        if is_cmp(op) {
            self.gen_scalar_method2(key, "cmp", l, r)
            self.emit("cmpq $0, %rax")
            self.emit(format("{} %al", cmp_set(op, true)))
            self.emit("movzbq %al, %rax")
            return
        }
        // arithmetic: returns Self (an aggregate); use the sret call path.
        self.gen_callsig(e, self.sig_of(format("{}.{}", key, arith_method_cg(op))), [l, r])
    }

    // Call a 2-arg method returning a scalar (Eq.eq -> bool, Ord.cmp -> int),
    // leaving the result in %rax. Both operands are aggregates passed by address.
    fun gen_scalar_method2(var self, key: str, name: str, l: Expr, r: Expr) {
        self.addr_of_aggregate(r)
        self.emit("pushq %rax")
        self.addr_of_aggregate(l)
        self.emit("pushq %rax")
        self.emit(format("call myla_{}.{}", key, name))
        self.emit("addq $16, %rsp")
    }

    fun eval_logical(var self, op: str, l: Expr, r: Expr) {
        let short = self.label()
        let end = self.label()
        if op == "&&" {
            self.eval(l)
            self.emit("testq %rax, %rax")
            self.emit(format("jz {}", short))
            self.eval(r)
            self.emit("testq %rax, %rax")
            self.emit(format("jz {}", short))
            self.emit("movq $1, %rax")
            self.emit(format("jmp {}", end))
            self.emit(format("{}:", short))
            self.emit("xorq %rax, %rax")
            self.emit(format("{}:", end))
        } else {
            self.eval(l)
            self.emit("testq %rax, %rax")
            self.emit(format("jnz {}", short))
            self.eval(r)
            self.emit("testq %rax, %rax")
            self.emit(format("jnz {}", short))
            self.emit("xorq %rax, %rax")
            self.emit(format("jmp {}", end))
            self.emit(format("{}:", short))
            self.emit("movq $1, %rax")
            self.emit(format("{}:", end))
        }
    }

    fun gen_cast(var self, e: Expr, x: Expr) {
        let src = self.type_of(x.id)
        let tgt = self.type_of(e.id)
        self.eval(x)
        if is_tchar(tgt) { return }
        if is_tchar(src) {
            self.wrap(tgt)
            return
        }
        self.wrap(tgt)
    }

    fun wrap(var self, t: Type) {
        match t {
            Type.TInt(w, s) => {
                if w != 64 {
                    if s {
                        let shift = 64 - w
                        self.emit(format("shlq ${}, %rax", shift))
                        self.emit(format("sarq ${}, %rax", shift))
                    } else if w == 32 {
                        self.emit("movl %eax, %eax")
                    } else {
                        self.emit(format("andq ${}, %rax", (1 << w) - 1))
                    }
                }
            },
            _ => {},
        }
    }

    // -- aggregates (structs / tuples) ------------------------------------

    fun emit_copy(var self, size: int32) {
        self.emit(format("movq ${}, %rcx", size / 8))
        self.emit("cld")
        self.emit("rep movsq")
    }

    // Leave the base address of an aggregate value in %rax.
    fun addr_of_aggregate(var self, e: Expr) {
        let ci = self.ctor_info(e)
        if ci.ok {
            self.gen_enum_ctor(e, ci.enum_name, ci.variant, ci.args)
            self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            return
        }
        match e.kind {
            ExprKind.Name(n) => {
                if !self.has_binding(n) && self.has_function(n) {
                    self.materialize_fnval(n, self.local_of(e.id))
                    self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
                } else {
                    self.emit_name_addr(self.lookup(n))
                }
            },
            ExprKind.GetField(tgt, field) => {
                self.addr_of_aggregate(tgt)
                let foff = self.field_offset(self.place_type(tgt), field)
                // A boxed (recursive-enum) member holds a heap pointer: load it so
                // %rax is the address of the inline value, not of the slot.
                if self.is_boxed(self.type_of(e.id)) { self.emit(format("movq {}(%rax), %rax", foff)) }
                else if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.TupleIndex(tgt, idx) => {
                self.addr_of_aggregate(tgt)
                let foff = self.elem_offset(self.place_type(tgt), idx as int32)
                if self.is_boxed(self.type_of(e.id)) { self.emit(format("movq {}(%rax), %rax", foff)) }
                else if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.Index(base, idx) => {
                self.gen_index_addr(base, idx)
                if self.is_boxed(self.type_of(e.id)) { self.emit("movq (%rax), %rax") }
            },
            ExprKind.Lambda(params, ret, body) => {
                self.gen_lambda_value(e, params, body)
                self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            },
            ExprKind.StructLit(name, fields) => {
                self.gen_struct_lit(e, name, fields)
                self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            },
            ExprKind.TupleLit(elems) => {
                self.gen_tuple_lit(e, elems)
                self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            },
            ExprKind.Call(c, args) => {
                self.gen_call(e, c, args)
                self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            },
            ExprKind.Binary(op, l, r) => {
                self.eval_binary(e, op, l, r)
                self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            },
            ExprKind.MatchE(scrut, arms) => {
                self.gen_match(e, scrut, arms)
                self.emit(format("leaq {}(%rbp), %rax", self.match_res[e.id]))
            },
            ExprKind.Try(inner) => {
                self.gen_try(e, inner)
                self.emit(format("leaq {}(%rbp), %rax", self.try_res[e.id]))
            },
            _ => {},
        }
    }

    // Leave the address of a scalar lvalue (`name` or `agg.field`) in %rax.
    fun addr_of_lvalue(var self, e: Expr) {
        match e.kind {
            ExprKind.Name(n) => {
                let b = self.lookup(n)
                self.emit(format("leaq {}(%rbp), %rax", b.offset))
            },
            ExprKind.GetField(tgt, field) => {
                self.addr_of_aggregate(tgt)
                let foff = self.field_offset(self.place_type(tgt), field)
                if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.TupleIndex(tgt, idx) => {
                self.addr_of_aggregate(tgt)
                let foff = self.elem_offset(self.place_type(tgt), idx as int32)
                if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.Index(base, idx) => { self.gen_index_addr(base, idx) },
            _ => {},
        }
    }

    fun gen_struct_lit(var self, e: Expr, name: str, fields: [FieldInit]) {
        let base = self.local_of(e.id)
        for fi in fields {
            let foff = self.field_offset(self.type_of(e.id), fi.name)
            self.store_member(fi.value, base + foff, self.type_of(fi.value.id))
        }
    }

    fun gen_tuple_lit(var self, e: Expr, elems: [Expr]) {
        let base = self.local_of(e.id)
        let t = self.type_of(e.id)
        var i = 0
        for elem in elems {
            self.store_member(elem, base + self.elem_offset(t, i), self.type_of(elem.id))
            i = i + 1
        }
    }

    // Store `value` into an aggregate member at `slot_off(%rbp)`. A boxed
    // (recursive-enum) member holds a heap pointer; other aggregates are inline.
    fun store_member(var self, value: Expr, slot_off: int32, mt: Type) {
        if self.is_boxed(mt) {
            self.box_value(value, mt)
            self.emit(format("movq %rax, {}(%rbp)", slot_off))
        } else if is_aggregate(mt) {
            self.addr_of_aggregate(value)
            self.emit("movq %rax, %rsi")
            self.emit(format("leaq {}(%rbp), %rdi", slot_off))
            self.emit_copy(self.size(mt))
            self.retain("rbp", slot_off, mt)
        } else {
            self.eval(value)
            self.emit(format("movq %rax, {}(%rbp)", slot_off))
            if self.owns_heap(mt) { self.retain("rbp", slot_off, mt) }
        }
    }

    // Store `value` into a standalone destination at `off(%rbp)` (a local/result/
    // binding): aggregates are copied inline (even boxed enums — only *members*
    // are stored as pointers).
    fun store_value(var self, value: Expr, off: int32, t: Type) {
        if is_aggregate(t) {
            self.addr_of_aggregate(value)
            self.emit("movq %rax, %rsi")
            self.emit(format("leaq {}(%rbp), %rdi", off))
            self.emit_copy(self.size(t))
            self.retain("rbp", off, t)
        } else {
            self.eval(value)
            self.emit(format("movq %rax, {}(%rbp)", off))
            if self.owns_heap(t) { self.retain("rbp", off, t) }
        }
    }

    // Heap-allocate a copy of `value`'s inline aggregate and leave the pointer in
    // %rax (a boxed/recursive-enum edge). No reclamation: cells live for the run.
    fun box_value(var self, value: Expr, t: Type) {
        self.addr_of_aggregate(value)
        self.emit("pushq %rax")
        self.emit(format("movq ${}, %rdi", self.size(t)))
        self.emit("call __alloc")
        self.emit("popq %rsi")
        self.emit("pushq %rax")
        self.emit("movq %rax, %rdi")
        self.emit_copy(self.size(t))
        self.emit("popq %rax")
        // The fresh cell becomes a new owner of any heap pointers it copied in.
        if self.owns_heap(t) {
            self.emit("pushq %rax")
            self.emit("movq %rax, %r8")
            self.owned_walk("r8", 0, t, true)
            self.emit("popq %rax")
        }
    }

    // -- lists ------------------------------------------------------------

    // Per-element byte stride: scalars/strings/lists/maps are 8; inline
    // aggregates (struct/tuple) use their stored size.
    fun elem_stride(self, et: Type) -> int32 {
        return self.stored_size(et)
    }

    // Evaluate `e` into %rax, cloning when it is a list/map *place* (value
    // semantics: moving an owned aggregate into a new location copies it, D38).
    fun eval_owned(var self, e: Expr) {
        self.eval(e)
        let t = self.type_of(e.id)
        if is_place(e) && (is_list_t(t) || is_map_t(t) || is_sb_t(t)) { self.clone_in_rax(t) }
    }

    // Clone the list/map/builder cell currently in %rax (shallow), copy in %rax.
    fun clone_in_rax(var self, t: Type) {
        self.emit("movq %rax, %rdi")
        if is_list_t(t) {
            self.emit(format("movq ${}, %rsi", self.elem_stride(list_elem(t))))
            self.emit("call __list_clone")
        } else if is_sb_t(t) {
            self.emit("movq $1, %rsi")
            self.emit("call __list_clone")
        } else {
            self.emit(format("movq ${}, %rsi", self.map_slot_size(t)))
            self.emit("call __list_clone")
        }
    }

    fun gen_list_lit(var self, e: Expr, elems: [Expr]) {
        let lt = self.type_of(e.id)
        let et = list_elem(lt)
        let stride = self.elem_stride(et)
        let n = len(elems)
        self.emit(format("movq ${}, %rdi", 16 + n * stride))
        self.emit("call __alloc")
        let slot = self.local_of(e.id)
        self.emit(format("movq %rax, {}(%rbp)", slot))
        self.emit(format("movq ${}, (%rax)", n))
        self.emit(format("movq ${}, 8(%rax)", n))
        var i = 0
        for elem in elems {
            self.store_elem_slot(elem, slot, 16 + i * stride, et)
            i = i + 1
        }
        self.emit(format("movq {}(%rbp), %rax", slot))
    }

    // Store `value` into a heap element at `off` past the cell pointer held in
    // `slot(%rbp)`. Scalars/strings/lists are moved (cloned if a place); inline
    // aggregates are copied byte-for-byte.
    fun store_elem_slot(var self, value: Expr, slot: int32, off: int32, et: Type) {
        if self.is_boxed(et) {
            self.box_value(value, et)
            self.emit(format("movq {}(%rbp), %rcx", slot))
            self.emit(format("movq %rax, {}(%rcx)", off))
        } else if is_aggregate(et) {
            self.addr_of_aggregate(value)
            self.emit("movq %rax, %rsi")
            self.emit(format("movq {}(%rbp), %rdi", slot))
            if off != 0 { self.emit(format("addq ${}, %rdi", off)) }
            self.emit_copy(self.size(et))
            self.emit(format("movq {}(%rbp), %r8", slot))
            self.retain("r8", off, et)
        } else {
            self.eval(value)
            self.emit(format("movq {}(%rbp), %rcx", slot))
            self.emit(format("movq %rax, {}(%rcx)", off))
            if self.owns_heap(et) {
                self.emit(format("movq {}(%rbp), %r8", slot))
                self.retain("r8", off, et)
            }
        }
    }

    // Leave the address of element `base[idx]` in %rax (list or string).
    fun gen_elem_addr(var self, base: Expr, idx: Expr) {
        let bt = self.place_type(base)
        self.eval(base)
        self.emit("pushq %rax")
        self.eval(idx)
        self.emit("movq %rax, %rcx")
        self.emit("popq %rax")
        self.emit("movq (%rax), %rdx")
        self.emit("cmpq %rdx, %rcx")
        self.emit("jae __trap")
        if is_str_t(bt) {
            self.emit("leaq 8(%rax), %rax")
            self.emit("addq %rcx, %rax")
        } else {
            let stride = self.elem_stride(list_elem(bt))
            self.emit("leaq 16(%rax), %rax")
            if stride == 8 {
                self.emit("leaq (%rax,%rcx,8), %rax")
            } else {
                self.emit(format("imulq ${}, %rcx", stride))
                self.emit("addq %rcx, %rax")
            }
        }
    }

    // Address of an indexed lvalue/aggregate element (list/str/map).
    fun gen_index_addr(var self, base: Expr, idx: Expr) {
        if is_map_t(self.place_type(base)) { self.gen_map_value_addr(base, idx) }
        else { self.gen_elem_addr(base, idx) }
    }

    fun gen_index_read(var self, e: Expr, base: Expr, idx: Expr) {
        let bt = self.place_type(base)
        if is_map_t(bt) { self.gen_map_get(base, idx)
        return }
        self.gen_elem_addr(base, idx)
        if is_str_t(bt) { self.emit("movzbl (%rax), %eax") }
        else { self.emit("movq (%rax), %rax") }
    }

    fun gen_len(var self, arg: Expr) {
        self.eval(arg)
        self.emit("movq (%rax), %rax")
    }

    // Address where a list-holder's pointer lives (so push/pop can write back a
    // reallocated buffer): a local/param slot, a nested list element, or a map slot.
    fun mut_holder_addr(var self, e: Expr) {
        match e.kind {
            ExprKind.Name(n) => {
                let b = self.lookup(n)
                self.emit(format("leaq {}(%rbp), %rax", b.offset))
            },
            ExprKind.Index(base, idx) => { self.gen_index_addr(base, idx) },
            ExprKind.GetField(tgt, field) => { self.addr_of_lvalue(e) },
            ExprKind.TupleIndex(tgt, idx) => { self.addr_of_lvalue(e) },
            _ => {},
        }
    }

    // -- copy-on-write mutation addressing --------------------------------

    // In: %rax = address of the slot holding a list/map/builder pointer. Ensure
    // the cell is uniquely owned (clone it if refcount > 1, storing the clone
    // back). Out: %rax = the now-unique cell pointer.
    fun cow_unique(var self, t: Type) {
        self.register_clone(t)
        self.emit("movq %rax, %rcx")
        self.emit("movq (%rcx), %rdi")
        let skip = self.label()
        self.emit("cmpq $1, -8(%rdi)")
        self.emit(format("jbe {}", skip))
        self.emit("pushq %rcx")
        self.emit("call " + self.clone_call_name(t))
        self.emit("popq %rcx")
        self.emit("movq %rax, (%rcx)")
        self.emit("movq %rax, %rdi")
        self.emit(format("{}:", skip))
        self.emit("movq %rdi, %rax")
    }

    // Leave the uniquely-owned cell pointer of list/map lvalue `e` in %rax,
    // cloning shared cells along the path so the write is private (D38).
    fun mut_container_cell(var self, e: Expr) {
        self.mut_addr_of_list_holder(e)
        self.cow_unique(self.place_type(e))
    }

    // Leave in %rax the address of the slot that holds list/map lvalue `e`'s
    // cell pointer (so a CoW clone can be written back).
    fun mut_addr_of_list_holder(var self, e: Expr) {
        match e.kind {
            ExprKind.Name(n) => {
                let b = self.lookup(n)
                if b.kind == "capture" {
                    self.emit(format("movq {}(%rbp), %rax", b.offset))
                    if b.capoff != 0 { self.emit(format("addq ${}, %rax", b.capoff)) }
                } else {
                    self.emit(format("leaq {}(%rbp), %rax", b.offset))
                }
            },
            ExprKind.GetField(tgt, field) => {
                self.mut_addr_of_struct(tgt)
                let foff = self.field_offset(self.place_type(tgt), field)
                if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.TupleIndex(tgt, idx) => {
                self.mut_addr_of_struct(tgt)
                let foff = self.elem_offset(self.place_type(tgt), idx as int32)
                if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.Index(base, idx) => { self.mut_index_addr(e, base, idx) },
            _ => {},
        }
    }

    // Leave the address of inline-struct lvalue `e` in %rax (CoW-ing any
    // list/map cell on the path).
    fun mut_addr_of_struct(var self, e: Expr) {
        match e.kind {
            ExprKind.Name(n) => {
                let b = self.lookup(n)
                if b.kind == "local" {
                    self.emit(format("leaq {}(%rbp), %rax", b.offset))
                } else if b.kind == "capture" {
                    self.emit(format("movq {}(%rbp), %rax", b.offset))
                    if b.capoff != 0 { self.emit(format("addq ${}, %rax", b.capoff)) }
                } else {
                    self.emit(format("movq {}(%rbp), %rax", b.offset))
                }
            },
            ExprKind.GetField(tgt, field) => {
                self.mut_addr_of_struct(tgt)
                let foff = self.field_offset(self.place_type(tgt), field)
                if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.TupleIndex(tgt, idx) => {
                self.mut_addr_of_struct(tgt)
                let foff = self.elem_offset(self.place_type(tgt), idx as int32)
                if foff != 0 { self.emit(format("addq ${}, %rax", foff)) }
            },
            ExprKind.Index(base, idx) => { self.mut_index_addr(e, base, idx) },
            _ => {},
        }
    }

    // Address of a mutable indexed lvalue `base[idx]` (list element or map value),
    // CoW-ing the container first.
    fun mut_index_addr(var self, e: Expr, base: Expr, idx: Expr) {
        if is_map_t(self.place_type(base)) { self.mut_map_value_addr(e, base, idx) }
        else { self.mut_elem_addr(e, base, idx) }
    }

    // Address of mutable list element `base[idx]` in %rax (CoW container,
    // bounds-checked).
    fun mut_elem_addr(var self, e: Expr, base: Expr, idx: Expr) {
        // `e` is an lvalue Index target, which the checker leaves untyped, so the
        // element stride must come from the container's element type (via
        // place_type), not `type_of(e.id)` which falls back to a scalar.
        let stride = self.stored_size(list_elem(self.place_type(base)))
        self.mut_container_cell(base)
        self.emit("pushq %rax")
        self.eval(idx)
        self.emit("popq %rcx")
        self.emit("movq (%rcx), %rdx")
        self.emit("cmpq %rdx, %rax")
        self.emit("jae __trap")
        self.emit(format("imulq ${}, %rax", stride))
        self.emit("leaq 16(%rcx,%rax), %rax")
    }

    // Address of mutable map value for `base[idx]` in %rax (CoW container);
    // traps when the key is absent.
    fun mut_map_value_addr(var self, e: Expr, base: Expr, idx: Expr) {
        let mt = self.place_type(base)
        self.mut_container_cell(base)
        self.emit("pushq %rax")
        self.eval(idx)
        self.emit("movq %rax, %rsi")
        self.emit("popq %rdi")
        self.emit(format("movq ${}, %rdx", self.map_slot_size(mt)))
        self.emit(format("movq ${}, %rcx", self.map_is_str(mt)))
        self.emit("call __map_lookup")
        self.emit("testq %rax, %rax")
        self.emit("jz __trap")
        self.emit("addq $16, %rax")
    }

    // Store `value` into the element whose address is on the stack top
    // (consumed), taking ownership of heap references it brings in and, when
    // `drop_old`, releasing whatever the slot held before.
    fun store_into_elem(var self, value: Expr, et: Type, drop_old: bool) {
        if self.is_boxed(et) {
            self.box_value(value, et)
            self.emit("popq %rcx")
            if drop_old {
                self.emit("pushq %rax")
                self.emit("pushq %rcx")
                self.emit("movq (%rcx), %rdi")
                self.emit("call " + self.drop_call_name(et))
                self.emit("popq %rcx")
                self.emit("popq %rax")
            }
            self.emit("movq %rax, (%rcx)")
        } else if is_aggregate(et) {
            self.addr_of_aggregate(value)
            self.emit("popq %rcx")
            self.emit("pushq %rcx")
            if drop_old {
                self.emit("pushq %rax")
                self.walk_member("rcx", 0, et, false)
                self.emit("popq %rax")
            }
            self.emit("movq %rax, %rsi")
            self.emit("movq (%rsp), %rdi")
            self.emit_copy(self.size(et))
            self.emit("popq %rcx")
            self.retain("rcx", 0, et)
        } else if self.owns_heap(et) {
            self.eval(value)
            self.emit("popq %rcx")
            self.emit("incq -8(%rax)")
            if drop_old {
                self.emit("pushq %rax")
                self.emit("pushq %rcx")
                self.emit("movq (%rcx), %rdi")
                self.register_drop(et)
                self.emit("call " + self.drop_call_name(et))
                self.emit("popq %rcx")
                self.emit("popq %rax")
            }
            self.emit("movq %rax, (%rcx)")
        } else {
            self.eval(value)
            self.emit("popq %rcx")
            self.emit("movq %rax, (%rcx)")
        }
    }

    fun gen_push(var self, holder: Expr, value: Expr) {
        let lt = self.place_type(holder)
        let et = list_elem(lt)
        let stride = self.elem_stride(et)
        self.mut_addr_of_list_holder(holder)   // &holder -> rax
        self.emit("pushq %rax")                // save &holder
        self.cow_unique(lt)                    // unique cell -> rax
        let have = self.label()
        self.emit("movq (%rax), %rdx")         // len
        self.emit("movq 8(%rax), %rcx")        // cap
        self.emit("cmpq %rcx, %rdx")
        self.emit(format("jb {}", have))       // len < cap: room to append
        self.emit("movq %rax, %rdi")
        self.emit(format("movq ${}, %rsi", stride))
        self.emit("call __list_grow")
        self.emit("movq (%rsp), %rcx")         // &holder
        self.emit("movq %rax, (%rcx)")         // publish the grown cell
        self.emit(format("{}:", have))
        self.emit("movq (%rax), %rdx")         // current length (append index)
        self.emit("leaq 1(%rdx), %rcx")
        self.emit("movq %rcx, (%rax)")         // length += 1
        self.emit(format("imulq ${}, %rdx", stride))
        self.emit("leaq 16(%rax,%rdx), %rax")  // &elem (fresh slot)
        self.emit("addq $8, %rsp")             // discard saved &holder
        self.emit("pushq %rax")
        self.store_into_elem(value, et, false)
        // The value temp (if any) is released by the enclosing statement's
        // drop_expr_temps; dropping it here too would double-free.
    }

    fun gen_pop(var self, e: Expr, holder: Expr) {
        let et = self.type_of(e.id)
        let stride = self.elem_stride(et)
        self.mut_container_cell(holder)        // unique cell -> rax
        self.emit("movq (%rax), %rcx")         // len
        self.emit("testq %rcx, %rcx")
        self.emit("jz __trap")
        self.emit("decq %rcx")
        self.emit("movq %rcx, (%rax)")         // len -= 1
        self.emit(format("imulq ${}, %rcx", stride))
        self.emit("leaq 16(%rax,%rcx), %rdx")  // &elem (removed last element)
        if is_aggregate(et) && !self.is_boxed(et) {
            let slot = self.local_of(e.id)
            self.emit("movq %rdx, %rsi")
            self.emit(format("leaq {}(%rbp), %rdi", slot))
            self.emit_copy(self.size(et))
        } else {
            self.emit("movq (%rdx), %rax")     // scalar / list pointer (transferred)
        }
    }

    // -- maps / strings / chars (filled in later C4 sub-slices) -----------

    fun map_slot_size(self, mt: Type) -> int32 { return 16 + self.stored_size(map_val(mt)) }
    fun map_is_str(self, mt: Type) -> int32 {
        if is_str_t(map_key(mt)) { return 1 }
        return 0
    }

    fun gen_map_lit(var self, e: Expr, entries: [MapEntry]) {
        let mt = self.type_of(e.id)
        let slot = self.local_of(e.id)
        self.emit("movq $8, %rdi")
        self.emit(format("movq ${}, %rsi", self.map_slot_size(mt)))
        self.emit("call __map_new")
        self.emit(format("movq %rax, {}(%rbp)", slot))
        for en in entries {
            self.emit(format("leaq {}(%rbp), %rax", slot))
            self.emit_map_put(en.key, en.value, mt)
        }
        self.emit(format("movq {}(%rbp), %rax", slot))
    }

    // Insert/overwrite (key -> value); precondition: %rax = &holder (a location
    // holding the map cell pointer). Leaves the stack as found.
    fun emit_map_put(var self, key: Expr, value: Expr, mt: Type) {
        let vt = map_val(mt)
        let slot_size = self.map_slot_size(mt)
        let is_str = self.map_is_str(mt)
        self.emit("pushq %rax")
        self.emit("movq %rax, %rdi")
        self.emit(format("movq ${}, %rsi", slot_size))
        self.emit(format("movq ${}, %rcx", is_str))
        self.emit("call __map_reserve")
        self.eval(key)
        self.emit("pushq %rax")
        self.emit("movq 8(%rsp), %rdi")
        self.emit("movq (%rdi), %rdi")
        self.emit("movq (%rsp), %rsi")
        self.emit(format("movq ${}, %rdx", slot_size))
        self.emit(format("movq ${}, %rcx", is_str))
        self.emit("call __map_set_slot")
        self.emit("addq $16, %rax")
        self.emit("pushq %rax")
        if is_aggregate(vt) && !self.is_boxed(vt) {
            self.addr_of_aggregate(value)
            self.emit("movq %rax, %rsi")
            self.emit("popq %rdi")
            self.emit("pushq %rdi")
            self.emit_copy(self.size(vt))
            self.emit("popq %rcx")
            self.retain("rcx", 0, vt)
        } else if self.is_boxed(vt) {
            self.box_value(value, vt)
            self.emit("popq %rcx")
            self.emit("movq %rax, (%rcx)")
        } else {
            self.eval(value)
            self.emit("popq %rcx")
            self.emit("movq %rax, (%rcx)")
            if self.owns_heap(vt) { self.emit("incq -8(%rax)") }
        }
        self.emit("addq $16, %rsp")
    }

    fun gen_map_set(var self, base: Expr, idx: Expr, value: Expr) {
        let mt = self.place_type(base)
        self.mut_addr_of_list_holder(base)   // &holder -> rax
        self.emit("pushq %rax")
        self.cow_unique(mt)                  // unique cell, written back to holder
        self.emit("popq %rax")               // &holder
        self.emit_map_put(idx, value, mt)
        self.drop_expr_temps(idx)
        self.drop_expr_temps(value)
    }

    // Leave the address of map value `base[idx]` in %rax; trap if the key is absent.
    fun gen_map_value_addr(var self, base: Expr, idx: Expr) {
        let mt = self.place_type(base)
        self.eval(base)
        self.emit("pushq %rax")
        self.eval(idx)
        self.emit("movq %rax, %rsi")
        self.emit("popq %rdi")
        self.emit(format("movq ${}, %rdx", self.map_slot_size(mt)))
        self.emit(format("movq ${}, %rcx", self.map_is_str(mt)))
        self.emit("call __map_lookup")
        self.emit("testq %rax, %rax")
        self.emit("jz __trap")
        self.emit("addq $16, %rax")
    }

    fun gen_map_get(var self, base: Expr, idx: Expr) {
        self.gen_map_value_addr(base, idx)
        self.emit("movq (%rax), %rax")
    }

    fun gen_map_contains(var self, m: Expr, k: Expr) {
        let mt = self.place_type(m)
        self.eval(m)
        self.emit("pushq %rax")
        self.eval(k)
        self.emit("movq %rax, %rsi")
        self.emit("popq %rdi")
        self.emit(format("movq ${}, %rdx", self.map_slot_size(mt)))
        self.emit(format("movq ${}, %rcx", self.map_is_str(mt)))
        self.emit("call __map_lookup")
        self.emit("testq %rax, %rax")
        self.emit("setne %al")
        self.emit("movzbl %al, %eax")
    }

    fun gen_map_remove(var self, m: Expr, k: Expr) {
        let mt = self.place_type(m)
        self.eval(m)
        self.emit("pushq %rax")
        self.eval(k)
        self.emit("movq %rax, %rsi")
        self.emit("movq (%rsp), %rdi")
        self.emit(format("movq ${}, %rdx", self.map_slot_size(mt)))
        self.emit(format("movq ${}, %rcx", self.map_is_str(mt)))
        self.emit("call __map_lookup")
        self.emit("popq %rcx")
        let done = self.label()
        self.emit("testq %rax, %rax")
        self.emit(format("jz {}", done))
        self.emit("movq $2, (%rax)")
        self.emit("decq (%rcx)")
        self.emit(format("{}:", done))
    }

    fun gen_map_keys(var self, e: Expr, m: Expr) {
        let mt = self.place_type(m)
        self.eval(m)
        self.emit("movq %rax, %rdi")
        self.emit(format("movq ${}, %rsi", self.map_slot_size(mt)))
        self.emit(format("movq ${}, %rdx", self.stored_size(map_key(mt))))
        self.emit("call __map_keys")
    }
    fun gen_chars(var self, s: Expr) {
        self.eval(s)
        self.emit("movq %rax, %rdi")
        self.emit("call __str_chars")
    }

    // -- strings: format + StringBuilder ----------------------------------

    // `format(fmt, args…)`: fmt is a literal; concatenate its segments with each
    // argument rendered by its print form. Result string cell in %rax.
    fun gen_format(var self, e: Expr, args: [Expr]) {
        let fmt = match args[0].kind { ExprKind.StrLit(s) => s, _ => "" }
        let segs = format_segments(fmt)
        let s0 = self.string_label(segs[0])
        self.emit(format("leaq {}(%rip), %rax", s0))
        var k = 1
        while k < len(args) {
            self.emit("pushq %rax")
            self.render_arg(args[k])
            self.emit("movq %rax, %rsi")
            self.emit("popq %rdi")
            self.emit("call __str_concat")
            self.emit("pushq %rax")
            let sl = self.string_label(segs[k])
            self.emit(format("leaq {}(%rip), %rsi", sl))
            self.emit("popq %rdi")
            self.emit("call __str_concat")
            k = k + 1
        }
    }

    // Render a printable value as a fresh str cell in %rax.
    fun render_arg(var self, arg: Expr) {
        let at = self.type_of(arg.id)
        self.eval(arg)
        match at {
            Type.TStr => {},
            Type.TBool => {
                self.emit("movq %rax, %rdi")
                self.emit("call __bool_to_str")
            },
            Type.TInt(w, s) => {
                self.emit("movq %rax, %rdi")
                if s { self.emit("call __int_to_str") }
                else { self.emit("call __uint_to_str") }
            },
            _ => {},
        }
    }

    fun gen_sb_new(var self, e: Expr) {
        self.emit("movq $16, %rdi")
        self.emit("call __alloc")
        self.emit("movq $0, (%rax)")
        self.emit("movq $0, 8(%rax)")
    }

    fun gen_sb_append(var self, sb: Expr, s: Expr) {
        self.mut_addr_of_list_holder(sb)   // &holder -> rax
        self.emit("pushq %rax")
        self.cow_unique(Type.TSB)          // unique cell, written back to holder
        self.eval(s)
        self.emit("movq %rax, %rsi")
        self.emit("movq (%rsi), %rdx")
        self.emit("addq $8, %rsi")
        self.emit("popq %rdi")             // &holder
        self.emit("call __sb_append_bytes")
    }

    fun gen_sb_append_byte(var self, sb: Expr, b: Expr) {
        self.mut_addr_of_list_holder(sb)   // &holder -> rax
        self.emit("pushq %rax")
        self.cow_unique(Type.TSB)          // unique cell, written back to holder
        self.eval(b)
        self.emit("pushq %rax")
        self.emit("movq %rsp, %rsi")
        self.emit("movq $1, %rdx")
        self.emit("movq 8(%rsp), %rdi")    // &holder
        self.emit("call __sb_append_bytes")
        self.emit("addq $16, %rsp")
    }

    fun gen_sb_build(var self, sb: Expr) {
        self.eval(sb)
        self.emit("pushq %rax")
        self.emit("movq (%rax), %rdx")
        self.emit("leaq 8(%rdx), %rdi")
        self.emit("call __alloc")
        self.emit("popq %rsi")
        self.emit("movq (%rsi), %rdx")
        self.emit("movq %rdx, (%rax)")
        self.emit("pushq %rax")
        self.emit("leaq 8(%rax), %rdi")
        self.emit("leaq 16(%rsi), %rsi")
        self.emit("movq %rdx, %rcx")
        self.emit("cld")
        self.emit("rep movsb")
        self.emit("popq %rax")
    }

    fun struct_field_type(self, name: str, field: str) -> Type {
        for f in self.struct_info(name).fields {
            if f.name == field { return f.ty }
        }
        return Type.TInt(32, true)
    }

    // Field type with the struct value `st`'s concrete type arguments substituted.
    fun struct_field_type_t(self, st: Type, field: str) -> Type {
        let name = struct_name_of(st)
        let info = self.struct_info(name)
        let sub = self.type_subst(info.type_params, type_args_of(st))
        return subst_type(self.struct_field_type(name, field), sub)
    }

    // -- enum construction ------------------------------------------------

    fun gen_enum_ctor(var self, e: Expr, enum_name: str, variant: str, args: [Expr]) {
        let base = self.local_of(e.id)
        self.emit(format("movq ${}, {}(%rbp)", self.variant_tag(enum_name, variant), base))
        var i = 0
        for arg in args {
            let slot = base + self.variant_field_offset(self.type_of(e.id), variant, i)
            self.store_member(arg, slot, self.type_of(arg.id))
            i = i + 1
        }
    }

    // -- match ------------------------------------------------------------

    fun gen_match(var self, e: Expr, scrut: Expr, arms: [MatchArm]) {
        let sst = self.type_of(scrut.id)
        let root = self.match_scrut[e.id]
        if is_aggregate(sst) {
            self.addr_of_aggregate(scrut)
            self.emit("movq %rax, %rsi")
            self.emit(format("leaq {}(%rbp), %rdi", root))
            self.emit_copy(self.size(sst))
        } else {
            self.eval(scrut)
            self.emit(format("movq %rax, {}(%rbp)", root))
        }
        let result_off = self.match_res[e.id]
        let result_type = self.type_of(e.id)
        let end = self.label()
        for arm in arms {
            let arm_fail = self.label()
            self.match_pat(arm.pattern, root, sst, arm.pattern.id, arm_fail)
            // Bindings and the scrutinee copy borrow from the scrutinee (which
            // outlives the match), so the arm scope owns nothing of its own.
            push(self.scopes, self.arm_scope(arm, sst))
            push(self.drop_scopes, [])
            match arm.guard {
                Some(g) => {
                    self.eval(g)
                    self.emit("testq %rax, %rax")
                    self.emit(format("jz {}", arm_fail))
                },
                None => {},
            }
            self.gen_arm_body(arm.body, result_off, result_type)
            self.emit(format("jmp {}", end))
            self.drop_scopes = drop_last(self.drop_scopes)
            self.scopes = drop_last(self.scopes)
            self.emit(format("{}:", arm_fail))
        }
        self.emit("jmp __trap")
        self.emit(format("{}:", end))
    }

    fun arm_scope(self, arm: MatchArm, sst: Type) -> [CgBinding] {
        var sc: [CgBinding] = []
        for b in self.pattern_binds(arm.pattern, sst) {
            let slot = self.match_bind[format("{}:{}", arm.pattern.id, b.name)]
            push(sc, CgBinding { name: b.name, kind: "local", offset: slot, ty: b.ty, capoff: 0 })
        }
        return sc
    }

    // The bindings a pattern introduces, paired with their (concrete) types,
    // in a deterministic pre-order shared by layout and codegen.
    fun pattern_binds(self, p: Pattern, t: Type) -> [DLeaf] {
        var out: [DLeaf] = []
        match p.kind {
            PatternKind.PWild => {},
            PatternKind.PBind(n) => {
                if !self.is_nullary_variant(n) { push(out, DLeaf { name: n, off: 0, ty: t }) }
            },
            PatternKind.PLit(l) => {},
            PatternKind.PEnum(en, variant, elems, hp) => {
                let payload = self.variant_payload(t, variant)
                var i = 0
                for sub in elems {
                    for b in self.pattern_binds(sub, payload[i]) { push(out, b) }
                    i = i + 1
                }
            },
            PatternKind.PTuple(elems) => {
                let ets = tuple_elems(t)
                var i = 0
                for sub in elems {
                    for b in self.pattern_binds(sub, ets[i]) { push(out, b) }
                    i = i + 1
                }
            },
            PatternKind.PStruct(name, fps) => {
                for fp in fps {
                    for b in self.pattern_binds(fp.pattern, self.struct_field_type_t(t, fp.name)) { push(out, b) }
                }
            },
            PatternKind.POr(alts) => {
                if len(alts) > 0 { for b in self.pattern_binds(alts[0], t) { push(out, b) } }
            },
        }
        return out
    }

    fun match_pat(var self, p: Pattern, disp: int32, t: Type, armkey: int32, fail: str) {
        match p.kind {
            PatternKind.PWild => {},
            PatternKind.PBind(n) => {
                if self.is_nullary_variant(n) {
                    let tag = self.variant_tag(enum_name_of(t), n)
                    self.emit(format("movq {}(%rbp), %rax", disp))
                    self.emit(format("cmpq ${}, %rax", tag))
                    self.emit(format("jne {}", fail))
                } else {
                    let slot = self.match_bind[format("{}:{}", armkey, n)]
                    if is_aggregate(t) {
                        self.emit(format("leaq {}(%rbp), %rsi", disp))
                        self.emit(format("leaq {}(%rbp), %rdi", slot))
                        self.emit_copy(self.size(t))
                    } else {
                        self.emit(format("movq {}(%rbp), %rax", disp))
                        self.emit(format("movq %rax, {}(%rbp)", slot))
                    }
                }
            },
            PatternKind.PLit(lit) => { self.match_literal(lit, disp, t, fail) },
            PatternKind.PEnum(en, variant, elems, hp) => {
                let enm = enum_name_of(t)
                let tag = self.variant_tag(enm, variant)
                self.emit(format("movq {}(%rbp), %rax", disp))
                self.emit(format("cmpq ${}, %rax", tag))
                self.emit(format("jne {}", fail))
                let payload = self.variant_payload(t, variant)
                var i = 0
                for sub in elems {
                    let ft = payload[i]
                    let foff = self.variant_field_offset(t, variant, i)
                    self.match_pat(sub, self.member_disp(sub, disp + foff, ft), ft, armkey, fail)
                    i = i + 1
                }
            },
            PatternKind.PTuple(elems) => {
                var i = 0
                for sub in elems {
                    let et = tuple_elems(t)[i]
                    let doff = disp + self.elem_offset(t, i)
                    self.match_pat(sub, self.member_disp(sub, doff, et), et, armkey, fail)
                    i = i + 1
                }
            },
            PatternKind.PStruct(name, fps) => {
                for fp in fps {
                    let ft = self.struct_field_type_t(t, fp.name)
                    let foff = self.field_offset(t, fp.name)
                    self.match_pat(fp.pattern, self.member_disp(fp.pattern, disp + foff, ft), ft, armkey, fail)
                }
            },
            PatternKind.POr(alts) => {
                let matched = self.label()
                let n = len(alts)
                var i = 0
                while i < n - 1 {
                    let next_alt = self.label()
                    self.match_pat(alts[i], disp, t, armkey, next_alt)
                    self.emit(format("jmp {}", matched))
                    self.emit(format("{}:", next_alt))
                    i = i + 1
                }
                self.match_pat(alts[n - 1], disp, t, armkey, fail)
                self.emit(format("{}:", matched))
            },
        }
    }

    // Displacement of the value a sub-pattern matches against. A boxed member is
    // a pointer, so unbox it (deref + copy) into a per-pattern temp.
    fun member_disp(var self, sub: Pattern, slot_disp: int32, ft: Type) -> int32 {
        if !self.is_boxed(ft) || is_pwild(sub) { return slot_disp }
        let utmp = self.unbox[sub.id]
        self.emit(format("movq {}(%rbp), %rsi", slot_disp))
        self.emit(format("leaq {}(%rbp), %rdi", utmp))
        self.emit_copy(self.size(ft))
        return utmp
    }

    fun visit_pattern_unbox(var self, p: Pattern, t: Type) {
        match p.kind {
            PatternKind.PEnum(en, variant, elems, hp) => {
                let payload = self.variant_payload(t, variant)
                var i = 0
                for sub in elems {
                    self.alloc_unbox(sub, payload[i])
                    self.visit_pattern_unbox(sub, payload[i])
                    i = i + 1
                }
            },
            PatternKind.PTuple(elems) => {
                let ets = tuple_elems(t)
                var i = 0
                for sub in elems {
                    self.alloc_unbox(sub, ets[i])
                    self.visit_pattern_unbox(sub, ets[i])
                    i = i + 1
                }
            },
            PatternKind.PStruct(name, fps) => {
                for fp in fps {
                    let ft = self.struct_field_type_t(t, fp.name)
                    self.alloc_unbox(fp.pattern, ft)
                    self.visit_pattern_unbox(fp.pattern, ft)
                }
            },
            PatternKind.POr(alts) => { for alt in alts { self.visit_pattern_unbox(alt, t) } },
            _ => {},
        }
    }

    fun alloc_unbox(var self, sub: Pattern, ft: Type) {
        if self.is_boxed(ft) && !is_pwild(sub) {
            self.cursor = self.cursor + self.size(ft)
            self.unbox[sub.id] = -self.cursor
        }
    }

    fun match_literal(var self, lit: Expr, disp: int32, t: Type, fail: str) {
        if is_tstr(t) {
            match lit.kind {
                ExprKind.StrLit(s) => {
                    let label = self.string_label(s)
                    self.emit(format("movq {}(%rbp), %rdi", disp))
                    self.emit(format("leaq {}(%rip), %rsi", label))
                    self.emit("call __str_eq")
                    self.emit("testq %rax, %rax")
                    self.emit(format("jz {}", fail))
                },
                _ => {},
            }
        } else {
            self.eval(lit)
            self.emit("movq %rax, %rcx")
            self.emit(format("movq {}(%rbp), %rax", disp))
            self.emit("cmpq %rcx, %rax")
            self.emit(format("jne {}", fail))
        }
    }

    fun gen_arm_body(var self, body: ExprOrBlock, result_off: int32, result_type: Type) {
        match body {
            ExprOrBlock.EB_Block(b) => {
                self.open_scope()
                let n = len(b.stmts)
                var i = 0
                while i < n {
                    let s = b.stmts[i]
                    if i == n - 1 {
                        match s.kind {
                            StmtKind.ExprStmt(ex) => {
                                self.store_value(ex, result_off, result_type)
                                self.drop_expr_temps(ex)
                            },
                            _ => { self.gen_stmt(s) },
                        }
                    } else {
                        self.gen_stmt(s)
                    }
                    i = i + 1
                }
                self.close_scope()
            },
            ExprOrBlock.EB_Expr(ex) => {
                self.store_value(ex, result_off, result_type)
                self.drop_expr_temps(ex)
            },
        }
    }

    // -- the `?` operator -------------------------------------------------

    fun gen_try(var self, e: Expr, inner: Expr) {
        self.addr_of_aggregate(inner)
        self.emit("movq %rax, %r10")
        let carrier = self.type_of(inner.id)
        let en = enum_name_of(carrier)
        let ok_tag = self.variant_tag(en, success_variant(en))
        let propagate = self.label()
        let cont = self.label()
        self.emit("movq (%r10), %rax")
        self.emit(format("cmpq ${}, %rax", ok_tag))
        self.emit(format("jne {}", propagate))
        let rt = self.type_of(e.id)
        let off = self.try_res[e.id]
        if self.is_boxed(rt) {
            // A boxed (recursive-enum) success payload is stored as a heap
            // pointer in the carrier; deref it to copy the inline value out.
            self.emit("movq 8(%r10), %rsi")
            self.emit(format("leaq {}(%rbp), %rdi", off))
            self.emit_copy(self.size(rt))
        } else if is_aggregate(rt) {
            self.emit("leaq 8(%r10), %rsi")
            self.emit(format("leaq {}(%rbp), %rdi", off))
            self.emit_copy(self.size(rt))
        } else {
            self.emit("movq 8(%r10), %rax")
            self.emit(format("movq %rax, {}(%rbp)", off))
        }
        self.emit(format("jmp {}", cont))
        self.emit(format("{}:", propagate))
        self.emit("movq %r10, %rsi")
        self.emit("movq 16(%rbp), %rdi")
        self.emit_copy(self.size(carrier))
        self.emit("movq 16(%rbp), %rax")
        self.emit(format("jmp {}", self.epilogue))
        self.emit(format("{}:", cont))
    }

    fun gen_call(var self, e: Expr, callee: Expr, args: [Expr]) {
        if args_have_hole(args) {
            self.gen_partial(e, callee, args)
            return
        }
        match callee.kind {
            ExprKind.Name(nm) => {
                if nm == "print" { self.gen_print(args[0]) }
                else if nm == "assert" || nm == "panic" || nm == "unreachable" { self.gen_intrinsic(nm, args) }
                else if nm == "len" { self.gen_len(args[0]) }
                else if nm == "push" { self.gen_push(args[0], args[1]) }
                else if nm == "pop" { self.gen_pop(e, args[0]) }
                else if nm == "chars" { self.gen_chars(args[0]) }
                else if nm == "format" { self.gen_format(e, args) }
                else if nm == "StringBuilder" { self.gen_sb_new(e) }
                else if nm == "append" { self.gen_sb_append(args[0], args[1]) }
                else if nm == "append_byte" { self.gen_sb_append_byte(args[0], args[1]) }
                else if nm == "build" { self.gen_sb_build(args[0]) }
                else if nm == "contains" { self.gen_map_contains(args[0], args[1]) }
                else if nm == "remove" { self.gen_map_remove(args[0], args[1]) }
                else if nm == "keys" { self.gen_map_keys(e, args[0]) }
                else if nm == "__write" { self.gen_io_write(args) }
                else if nm == "__exit" { self.gen_io_exit(args) }
                else if nm == "__args" { self.emit("call __args") }
                else if nm == "__read_file" { self.gen_io_read_file(args) }
                else if nm == "__io_errno" { self.emit("movq __io_errno_val(%rip), %rax") }
                else if nm == "__write_file" { self.gen_io_write_file(args) }
                else if nm == "__run" { self.gen_io_run(args) }
                else if nm == "__run_stderr" { self.emit("movq __run_stderr_val(%rip), %rax") }
                else if nm == "__run_exit_code" { self.emit("movslq __run_exit_val(%rip), %rax") }
                else if nm == "__run_signal" { self.emit("movslq __run_signal_val(%rip), %rax") }
                else if nm == "__run_errno" { self.emit("movslq __run_errno_val(%rip), %rax") }
                else if self.has_func(nm) { self.gen_user_call(e, nm, args) }
                else { self.gen_indirect_call(e, callee, args) }
            },
            ExprKind.GetField(recv, field) => { self.gen_method_or_closure_call(e, callee, recv, field, args) },
            _ => { self.gen_indirect_call(e, callee, args) },
        }
    }

    // `__write(fd, s)`: rdi = fd, rsi = str cell -> write(2) the bytes.
    fun gen_io_write(var self, args: [Expr]) {
        self.eval(args[1])
        self.emit("pushq %rax")
        self.eval(args[0])
        self.emit("movl %eax, %edi")
        self.emit("popq %rsi")
        self.emit("call __write")
    }

    // `__exit(code)`: the low 8 bits of `code` become the process status.
    fun gen_io_exit(var self, args: [Expr]) {
        self.eval(args[0])
        self.emit("movl %eax, %edi")
        self.emit("movq $60, %rax")
        self.emit("syscall")
    }

    // `__read_file(path)`: rdi = path str cell -> rax = contents str cell.
    fun gen_io_read_file(var self, args: [Expr]) {
        self.eval(args[0])
        self.emit("movq %rax, %rdi")
        self.emit("call __read_file")
    }

    // `__write_file(path, contents)`: rdi = path str cell, rsi = contents str
    // cell -> void (errno in __io_errno_val).
    fun gen_io_write_file(var self, args: [Expr]) {
        self.eval(args[1])
        self.emit("pushq %rax")
        self.eval(args[0])
        self.emit("movq %rax, %rdi")
        self.emit("popq %rsi")
        self.emit("call __write_file")
    }

    // `__run(program, argv)`: rdi = program str cell, rsi = argv [str] list cell
    // -> rax = the child's stdout [uint8] cell (results in __run_*_val globals).
    fun gen_io_run(var self, args: [Expr]) {
        self.eval(args[1])
        self.emit("pushq %rax")
        self.eval(args[0])
        self.emit("movq %rax, %rdi")
        self.emit("popq %rsi")
        self.emit("call __run")
    }

    fun ind_code_of(self, id: int32) -> int32 {
        match get(self.ind_code, id) { Some(o) => { return o }, None => {} }
        return 0
    }
    fun ind_env_of(self, id: int32) -> int32 {
        match get(self.ind_env, id) { Some(o) => { return o }, None => {} }
        return 0
    }

    // Call a function value `f(args)`: load `(code_ptr, env_ptr)` from the fat
    // value and call `code_ptr(env_ptr, args…)` (env first, then sret/args).
    fun gen_indirect_call(var self, e: Expr, callee: Expr, args: [Expr]) {
        let ft = self.place_type(callee)
        let params = tfunc_params(ft)
        let struct_ret = is_aggregate_opt(tfunc_ret(ft))
        let code_off = self.ind_code_of(e.id)
        let env_off = self.ind_env_of(e.id)
        self.addr_of_aggregate(callee)
        self.emit("movq (%rax), %rcx")
        self.emit(format("movq %rcx, {}(%rbp)", code_off))
        self.emit("movq 8(%rax), %rcx")
        self.emit(format("movq %rcx, {}(%rbp)", env_off))
        var i = len(args) - 1
        while i >= 0 {
            if is_aggregate(params[i]) { self.addr_of_aggregate(args[i]) }
            else { self.eval(args[i]) }
            self.emit("pushq %rax")
            i = i - 1
        }
        self.emit(format("movq {}(%rbp), %rax", env_off))
        self.emit("pushq %rax")
        if struct_ret {
            self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            self.emit("pushq %rax")
        }
        self.emit(format("call *{}(%rbp)", code_off))
        var n = len(args) + 1
        if struct_ret { n = n + 1 }
        self.emit(format("addq ${}, %rsp", 8 * n))
    }

    // `a >> b` composes two function values into `(x) => b(a(x))`: an env holds
    // the two fat values and `__compose_call` chains the (scalar) calls.
    fun gen_compose(var self, e: Expr, l: Expr, r: Expr) {
        let off = self.local_of(e.id)
        self.emit("movq $32, %rdi")
        self.emit("call __alloc")
        self.emit(format("movq %rax, {}(%rbp)", off + 8))
        self.addr_of_aggregate(l)
        self.emit("movq %rax, %rsi")
        self.emit(format("movq {}(%rbp), %rdi", off + 8))
        self.emit_copy(16)
        self.addr_of_aggregate(r)
        self.emit("movq %rax, %rsi")
        self.emit(format("movq {}(%rbp), %rdi", off + 8))
        self.emit("addq $16, %rdi")
        self.emit_copy(16)
        // The env co-owns both composed function values; retain their envs so a
        // nested compose/closure temp isn't freed while still referenced.
        self.emit(format("movq {}(%rbp), %r8", off + 8))
        self.retain("r8", 0, self.type_of(l.id))
        self.retain("r8", 16, self.type_of(r.id))
        self.emit("leaq __compose_call(%rip), %rax")
        self.emit(format("movq %rax, {}(%rbp)", off))
    }

    // `f(a, _, …)` partial application: capture the filled (scalar) arguments in
    // an env and emit a thunk that fills the holes from its own parameters.
    fun gen_partial(var self, e: Expr, callee: Expr, args: [Expr]) {
        let off = self.local_of(e.id)
        var slots: [int32] = []
        var fillexprs: [Expr] = []
        var filloffs: [int32] = []
        var envsz = 0
        for a in args {
            if is_hole_expr(a) {
                push(slots, -1)
            } else {
                push(slots, envsz)
                push(fillexprs, a)
                push(filloffs, envsz)
                envsz = envsz + 8
            }
        }
        var asz = envsz
        if asz == 0 { asz = 8 }
        self.emit(format("movq ${}, %rdi", asz))
        self.emit("call __alloc")
        self.emit(format("movq %rax, {}(%rbp)", off + 8))
        var k = 0
        while k < len(fillexprs) {
            self.eval(fillexprs[k])
            self.emit(format("movq {}(%rbp), %rcx", off + 8))
            self.emit(format("movq %rax, {}(%rcx)", filloffs[k]))
            k = k + 1
        }
        let nm = expr_name(callee)
        let lifted = format("{}__partial{}", self.cur_mangled, e.id)
        push(self.partial_jobs, PartialJob { lifted: lifted, target: nm, slots: slots })
        self.emit(format("leaq myla_{}(%rip), %rax", lifted))
        self.emit(format("movq %rax, {}(%rbp)", off))
    }

    // Emit a partial-application thunk: reconstruct the full (scalar) argument
    // list from the env (filled) and its own params (holes), then call the target.
    fun gen_partial_function(var self, job: PartialJob) {
        let n = len(job.slots)
        self.emit(format("myla_{}:", job.lifted))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        var pos = n - 1
        while pos >= 0 {
            if job.slots[pos] < 0 {
                var hidx = 0
                var j = 0
                while j < pos {
                    if job.slots[j] < 0 { hidx = hidx + 1 }
                    j = j + 1
                }
                self.emit(format("movq {}(%rbp), %rax", 24 + 8 * hidx))
            } else {
                self.emit("movq 16(%rbp), %rcx")
                self.emit(format("movq {}(%rcx), %rax", job.slots[pos]))
            }
            self.emit("pushq %rax")
            pos = pos - 1
        }
        self.emit(format("call myla_{}", job.target))
        if n > 0 { self.emit(format("addq ${}, %rsp", 8 * n)) }
        self.emit("leave")
        self.emit("ret")
        self.emit("")
    }

    // Materialize a top-level `fun` as a fat value `(thunk, null env)`.
    fun materialize_fnval(var self, n: str, off: int32) {
        if !list_has_str(self.fnval_set, n) { push(self.fnval_set, n) }
        self.emit(format("leaq myla_{}__fnval(%rip), %rax", n))
        self.emit(format("movq %rax, {}(%rbp)", off))
        self.emit(format("movq $0, {}(%rbp)", off + 8))
    }

    // Materialize a lambda's `(code_ptr, env_ptr)` fat value into its temp slot,
    // and queue the lifted body for emission under the current substitution.
    fun gen_lambda_value(var self, e: Expr, params: [Param], body: ExprOrBlock) {
        let off = self.local_of(e.id)
        let caps = self.lambda_captures(params, body)
        let lifted = format("{}__lam{}", self.cur_mangled, e.id)
        push(self.lam_jobs, LamJob { lifted: lifted, params: params, ftype: self.type_of(e.id), body: body, caps: caps, subst: self.subst })
        let code = format("myla_{}", lifted)
        if len(caps) == 0 {
            self.emit(format("leaq {}(%rip), %rax", code))
            self.emit(format("movq %rax, {}(%rbp)", off))
            self.emit(format("movq $0, {}(%rbp)", off + 8))
            return
        }
        var envsz = 0
        for c in caps { envsz = envsz + self.stored_size(c.ty) }
        self.emit(format("movq ${}, %rdi", envsz))
        self.emit("call __alloc")
        self.emit(format("movq %rax, {}(%rbp)", off + 8))
        self.emit(format("leaq {}(%rip), %rcx", code))
        self.emit(format("movq %rcx, {}(%rbp)", off))
        for c in caps { self.store_capture(c, off) }
    }

    // Copy an enclosing variable into the env cell at its capture offset.
    fun store_capture(var self, c: Cap, fat_off: int32) {
        let b = self.lookup(c.name)
        if is_aggregate(c.ty) {
            self.emit_name_addr(b)
            self.emit("movq %rax, %rsi")
            self.emit(format("movq {}(%rbp), %rdi", fat_off + 8))
            if c.off != 0 { self.emit(format("addq ${}, %rdi", c.off)) }
            self.emit_copy(self.size(c.ty))
        } else {
            self.emit_name_scalar(b)
            self.emit(format("movq {}(%rbp), %rcx", fat_off + 8))
            self.emit(format("movq %rax, {}(%rcx)", c.off))
        }
    }

    // Leave the address of the value bound by `b` (local/param/capture) in %rax.
    fun emit_name_addr(var self, b: CgBinding) {
        if b.kind == "capture" {
            self.emit(format("movq {}(%rbp), %rax", b.offset))
            if b.capoff != 0 { self.emit(format("addq ${}, %rax", b.capoff)) }
        } else if b.kind == "local" {
            self.emit(format("leaq {}(%rbp), %rax", b.offset))
        } else {
            self.emit(format("movq {}(%rbp), %rax", b.offset))
        }
    }

    // Load the scalar value bound by `b` into %rax.
    fun emit_name_scalar(var self, b: CgBinding) {
        if b.kind == "capture" {
            self.emit(format("movq {}(%rbp), %rcx", b.offset))
            self.emit(format("movq {}(%rcx), %rax", b.capoff))
        } else {
            self.emit(format("movq {}(%rbp), %rax", b.offset))
        }
    }

    // Emit a lambda's lifted top-level function: a hidden env pointer precedes
    // the declared params; captured variables are read through it.
    fun gen_lambda_function(var self, job: LamJob) {
        self.locals = [:]
        self.for_lv = [:]
        self.for_end = [:]
        self.destruct_base = [:]
        self.destruct_leaves = [:]
        self.match_scrut = [:]
        self.match_res = [:]
        self.match_bind = [:]
        self.try_res = [:]
        self.unbox = [:]
        self.for_elem = [:]
        self.ind_code = [:]
        self.ind_env = [:]
        self.cur_mangled = job.lifted
        self.subst = job.subst
        self.scopes = []
        self.drop_scopes = []
        self.loops = []
        self.cursor = 0
        let ret = tfunc_ret(job.ftype)
        self.struct_ret = is_aggregate_opt(ret)
        self.ret_type = ret

        self.cursor = 0
        match job.body {
            ExprOrBlock.EB_Block(b) => { for s in b.stmts { self.visit_stmt(s) } },
            ExprOrBlock.EB_Expr(ex) => { self.visit_expr(ex) },
        }
        let frame = band(self.cursor + 15, bnot(15))
        self.epilogue = format(".Lret_{}", job.lifted)

        self.emit(format("myla_{}:", job.lifted))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        if frame > 0 { self.emit(format("subq ${}, %rsp", frame)) }

        self.open_scope()
        var param_base = 0
        if self.struct_ret { param_base = 1 }
        let env_off = 16 + 8 * param_base
        let ptypes = tfunc_params(job.ftype)
        var i = 0
        while i < len(job.params) {
            let offset = 16 + 8 * (param_base + 1 + i)
            self.bind(job.params[i].name, "param", offset, ptypes[i])
            i = i + 1
        }
        let top = len(self.scopes) - 1
        for c in job.caps {
            push(self.scopes[top], CgBinding { name: c.name, kind: "capture", offset: env_off, ty: c.ty, capoff: c.off })
        }

        match job.body {
            ExprOrBlock.EB_Block(b) => { self.gen_block(b) },
            ExprOrBlock.EB_Expr(ex) => {
                if self.struct_ret {
                    self.addr_of_aggregate(ex)
                    self.emit("movq %rax, %rsi")
                    self.emit("movq 16(%rbp), %rdi")
                    self.emit_copy(self.size(self.type_of(ex.id)))
                    match ret {
                        Some(rt) => {
                            if self.owns_heap(rt) {
                                self.emit("movq 16(%rbp), %r8")
                                self.retain("r8", 0, rt)
                            }
                        },
                        None => {},
                    }
                    self.drop_expr_temps(ex)
                    self.emit_return_drops()
                    self.emit("movq 16(%rbp), %rax")
                } else {
                    self.eval(ex)
                    self.emit("pushq %rax")
                    if self.owns_heap_opt(ret) { self.emit("incq -8(%rax)") }
                    self.drop_expr_temps(ex)
                    self.emit_return_drops()
                    self.emit("popq %rax")
                }
            },
        }

        self.emit(format("{}:", self.epilogue))
        self.emit("leave")
        self.emit("ret")
        self.emit("")
        self.close_scope()
        self.subst = []
    }

    // `myla_<fn>__fnval(env, args…)`: adapter so a plain `fun` can be called
    // through the closure convention; drops the env and forwards to `myla_<fn>`.
    fun emit_fnval_thunk(var self, n: str) {
        let sig = self.sig_of(n)
        let struct_ret = is_aggregate_opt(sig.ret)
        let nargs = len(sig.params)
        var base = 1
        if struct_ret { base = 2 }
        let arg0_off = 16 + 8 * base
        self.emit(format("myla_{}__fnval:", n))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        var i = nargs - 1
        while i >= 0 {
            self.emit(format("movq {}(%rbp), %rax", arg0_off + 8 * i))
            self.emit("pushq %rax")
            i = i - 1
        }
        if struct_ret {
            self.emit("movq 16(%rbp), %rax")
            self.emit("pushq %rax")
        }
        self.emit(format("call myla_{}", n))
        var cleanup = 8 * nargs
        if struct_ret { cleanup = cleanup + 8 }
        if cleanup > 0 { self.emit(format("addq ${}, %rsp", cleanup)) }
        self.emit("leave")
        self.emit("ret")
        self.emit("")
    }

    // Free outer variables captured by value into a lambda's environment cell.
    fun lambda_captures(self, params: [Param], body: ExprOrBlock) -> [Cap] {
        var bound: [str] = []
        for p in params { push(bound, p.name) }
        let frees = self.free_eb(body, bound)
        var caps: [Cap] = []
        var seen: [str] = []
        var off = 0
        for nm in frees {
            if list_has_str(seen, nm) { continue }
            if !self.has_binding(nm) { continue }
            push(seen, nm)
            let b = self.lookup(nm)
            push(caps, Cap { name: nm, ty: b.ty, off: off })
            off = off + self.stored_size(b.ty)
        }
        return caps
    }

    fun free_eb(self, body: ExprOrBlock, bound: [str]) -> [str] {
        return match body {
            ExprOrBlock.EB_Expr(ex) => self.free_expr(ex, bound),
            ExprOrBlock.EB_Block(b) => self.free_block(b, bound),
        }
    }

    fun free_block(self, b: Block, bound: [str]) -> [str] {
        var out: [str] = []
        var bnd = bound
        for s in b.stmts {
            match s.kind {
                StmtKind.VarDecl(k, name, ty, init) => {
                    for v in self.free_expr(init, bnd) { push(out, v) }
                    push(bnd, name)
                },
                StmtKind.DestructDecl(k, binding, ty, init) => {
                    for v in self.free_expr(init, bnd) { push(out, v) }
                    for nm in bind_names(binding) { push(bnd, nm) }
                },
                StmtKind.Assign(target, value) => {
                    for v in self.free_expr(target, bnd) { push(out, v) }
                    for v in self.free_expr(value, bnd) { push(out, v) }
                },
                StmtKind.IfS(cond, then, otherwise) => {
                    for v in self.free_expr(cond, bnd) { push(out, v) }
                    for v in self.free_block(then, bnd) { push(out, v) }
                    for v in self.free_opt_else(otherwise, bnd) { push(out, v) }
                },
                StmtKind.WhileS(cond, body) => {
                    for v in self.free_expr(cond, bnd) { push(out, v) }
                    for v in self.free_block(body, bnd) { push(out, v) }
                },
                StmtKind.ForS(vn, start, end, body, iter) => {
                    for v in self.free_opt(start, bnd) { push(out, v) }
                    for v in self.free_opt(end, bnd) { push(out, v) }
                    for v in self.free_opt(iter, bnd) { push(out, v) }
                    var b2 = bnd
                    push(b2, vn)
                    for v in self.free_block(body, b2) { push(out, v) }
                },
                StmtKind.ReturnS(ov) => { for v in self.free_opt(ov, bnd) { push(out, v) } },
                StmtKind.ExprStmt(e) => { for v in self.free_expr(e, bnd) { push(out, v) } },
                _ => {},
            }
        }
        return out
    }

    fun free_opt_else(self, oe: Option<ElseTail>, bound: [str]) -> [str] {
        return match oe {
            Some(et) => self.free_else(et, bound),
            None => empty_str_list(),
        }
    }

    fun free_else(self, et: ElseTail, bound: [str]) -> [str] {
        return match et {
            ElseTail.ElseBlock(b) => self.free_block(b, bound),
            ElseTail.ElseIf(s) => self.free_block(Block { line: 0, col: 0, stmts: [s] }, bound),
        }
    }

    fun free_opt(self, oe: Option<Expr>, bound: [str]) -> [str] {
        return match oe {
            Some(e) => self.free_expr(e, bound),
            None => empty_str_list(),
        }
    }

    fun free_expr(self, e: Expr, bound: [str]) -> [str] {
        var out: [str] = []
        match e.kind {
            ExprKind.Name(n) => { if !list_has_str(bound, n) { push(out, n) } },
            ExprKind.Unary(op, x) => { for v in self.free_expr(x, bound) { push(out, v) } },
            ExprKind.Binary(op, l, r) => {
                for v in self.free_expr(l, bound) { push(out, v) }
                for v in self.free_expr(r, bound) { push(out, v) }
            },
            ExprKind.Call(c, args) => {
                for v in self.free_expr(c, bound) { push(out, v) }
                for a in args { for v in self.free_expr(a, bound) { push(out, v) } }
            },
            ExprKind.GetField(t, f) => { for v in self.free_expr(t, bound) { push(out, v) } },
            ExprKind.TupleIndex(t, i) => { for v in self.free_expr(t, bound) { push(out, v) } },
            ExprKind.Index(b, i) => {
                for v in self.free_expr(b, bound) { push(out, v) }
                for v in self.free_expr(i, bound) { push(out, v) }
            },
            ExprKind.Cast(x, ty) => { for v in self.free_expr(x, bound) { push(out, v) } },
            ExprKind.Try(x) => { for v in self.free_expr(x, bound) { push(out, v) } },
            ExprKind.StructLit(n, fields) => {
                for fi in fields { for v in self.free_expr(fi.value, bound) { push(out, v) } }
            },
            ExprKind.TupleLit(elems) => {
                for el in elems { for v in self.free_expr(el, bound) { push(out, v) } }
            },
            ExprKind.ListLit(elems) => {
                for el in elems { for v in self.free_expr(el, bound) { push(out, v) } }
            },
            ExprKind.MapLit(entries) => {
                for en in entries {
                    for v in self.free_expr(en.key, bound) { push(out, v) }
                    for v in self.free_expr(en.value, bound) { push(out, v) }
                }
            },
            ExprKind.Lambda(params, ret, body) => {
                var b2 = bound
                for p in params { push(b2, p.name) }
                for v in self.free_eb(body, b2) { push(out, v) }
            },
            ExprKind.MatchE(scrut, arms) => {
                for v in self.free_expr(scrut, bound) { push(out, v) }
                for arm in arms {
                    var b2 = bound
                    for nm in pattern_names(arm.pattern) { push(b2, nm) }
                    for v in self.free_opt(arm.guard, b2) { push(out, v) }
                    for v in self.free_eb(arm.body, b2) { push(out, v) }
                }
            },
            _ => {},
        }
        return out
    }

    // `assert`/`panic`/`unreachable`: write a message to stderr and exit(1).
    fun gen_intrinsic(var self, nm: str, args: [Expr]) {
        if nm == "panic" {
            self.eval(args[0])
            self.emit("movq %rax, %rdi")
            self.emit("call __panic")
            return
        }
        if nm == "unreachable" {
            let lab = self.string_label("reached unreachable code")
            self.emit(format("leaq {}(%rip), %rdi", lab))
            self.emit("call __panic")
            return
        }
        let ok = self.label()
        self.eval(args[0])
        self.emit("testq %rax, %rax")
        self.emit(format("jnz {}", ok))
        if len(args) == 2 {
            self.eval(args[1])
            self.emit("movq %rax, %rdi")
        } else {
            let lab = self.string_label("assertion failed")
            self.emit(format("leaq {}(%rip), %rdi", lab))
        }
        self.emit("call __panic")
        self.emit(format("{}:", ok))
    }

    fun gen_user_call(var self, e: Expr, nm: str, args: [Expr]) {
        self.gen_callsig(e, self.sig_of(nm), args)
    }

    // Emit a direct call to `sig` with the already-aligned argument list `argv`
    // (for a method the receiver is argv[0], matching sig.params[0] = self).
    fun gen_callsig(var self, e: Expr, sig: FuncSig, argv: [Expr]) {
        var target = sig.name
        // Decide the calling convention (aggregate-by-ref / sret) from the
        // *concrete* parameter and return types, substituting any type params.
        var params = sig.params
        var ret = sig.ret
        if len(sig.type_params) > 0 {
            let targs = self.solve_targs(sig, argv)
            target = self.request_fn(sig.name, targs)
            var sub: [Subst] = []
            var k = 0
            while k < len(sig.type_params) {
                push(sub, Subst { name: sig.type_params[k], ty: targs[k] })
                k = k + 1
            }
            var cp: [Type] = []
            for p in sig.params { push(cp, subst_type(p, sub)) }
            params = cp
            ret = opt_subst_type(sig.ret, sub)
        }
        let struct_ret = is_aggregate_opt(ret)
        var i = len(argv) - 1
        while i >= 0 {
            if is_aggregate(params[i]) { self.addr_of_aggregate(argv[i]) }
            else { self.eval(argv[i]) }
            self.emit("pushq %rax")
            i = i - 1
        }
        if struct_ret {
            self.emit(format("leaq {}(%rbp), %rax", self.local_of(e.id)))
            self.emit("pushq %rax")
        }
        self.emit(format("call myla_{}", target))
        var n = len(argv)
        if struct_ret { n = n + 1 }
        if n > 0 { self.emit(format("addq ${}, %rsp", 8 * n)) }
    }

    // `recv.field(args)` — a method call when `field` names a method of the
    // receiver's type, otherwise an indirect call through a function-valued field.
    fun gen_method_or_closure_call(var self, e: Expr, callee: Expr, recv: Expr, field: str, args: [Expr]) {
        let mname = format("{}.{}", self.type_key(self.type_of(recv.id)), field)
        if self.has_func(mname) {
            var argv: [Expr] = [recv]
            for a in args { push(argv, a) }
            self.gen_callsig(e, self.sig_of(mname), argv)
        } else {
            self.gen_indirect_call(e, callee, args)
        }
    }

    fun gen_print(var self, arg: Expr) {
        self.eval(arg)
        self.emit("movq %rax, %rdi")
        match self.type_of(arg.id) {
            Type.TBool => { self.emit("call __print_bool") },
            Type.TStr => { self.emit("call __print_str") },
            Type.TChar => { self.emit("call __print_char") },
            Type.TInt(w, s) => {
                if s { self.emit("call __print_int") }
                else { self.emit("call __print_uint") }
            },
            _ => {},
        }
    }

    // -- runtime prelude (_start + print/heap helpers) --------------------

