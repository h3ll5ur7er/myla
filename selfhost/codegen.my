// The normalizer of async bodies for frame functions (anf.my): a `match` with
// an `await` in an arm stays a value; an `async let` starts an async lambda.
#test()[Norm { next: 2000000000, resolved: [:], out: [], temps: 0, value_matches: true, wrap_children: true, children: [:] }]
fun compiler_norm() -> Norm {
    var n = new_norm(2000000000)
    n.value_matches = true
    n.wrap_children = true
    return n
}

// The ready-frame ring's size (D90): a power of two.
pub const EXEC_CAP: int32 = 1048576

// The generator of MYLA_SCHED=seed:N (D110): x * SCHED_MUL + SCHED_ADD,
// wrapping (Knuth's MMIX constants), the same in the interpreter
// (`Interp.ready`).
const SCHED_MUL: int64 = 6364136223846793005
const SCHED_ADD: int64 = 1442695040888963407

// A thread's block of runtime state in a program with tasks (D92), which
// `%fs` points at: its own address first (for `tls_addr`), then each
// variable's word, then the free lists (4616 bytes).
#test("__exec_sp")[32]
#test("__remote_free")[96]
#test("__exec_task")[104]
#test("__run_stderr_val")[48]
pub fun tls_offset(sym: str) -> int32 {
    if sym == "__heap_ptr" { return 8 }
    if sym == "__heap_end" { return 16 }
    if sym == "__exec_cur" { return 24 }
    if sym == "__exec_sp" { return 32 }
    if sym == "__io_errno_val" { return 40 }
    if sym == "__run_stderr_val" { return 48 }
    if sym == "__run_exit_val" { return 56 }
    if sym == "__run_signal_val" { return 64 }
    if sym == "__run_errno_val" { return 72 }
    if sym == "__drop_depth" { return 80 }
    if sym == "__worker_id" { return 88 }
    if sym == "__remote_free" { return 96 }
    if sym == "__exec_task" { return 104 }
    if sym == "__drop_defer" { return 112 }
    if sym == "__free_buckets" { return 128 }
    return 0
}

pub const TLS_SIZE: int32 = 4800

// The most workers a program runs (D92); each has a 4 GiB arena of the heap
// region, so a cell's address tells whose heap it is.
const MAX_WORKERS: int32 = 32

