}

// Split a `format` template into literal segments (one more than the number of
// `{}` holes). `{{`/`}}` collapse to single literal braces.
#test("{}€")[["", "€"]]
#test("{} scored {}")[["", " scored ", ""]]
#test("This is not the error you are looking for. It is {}")[["This is not the error you are looking for. It is ", ""]]
pub fun format_segments(s: str) -> [str] {
    var segs: [str] = []
    var cur = ""
    let n = s.len()
    var i = 0
    while i < n {
        let c = s[i]
        if c == '{' {
            if i + 1 < n && s[i + 1] == '{' { cur = cur + "{"
            i = i + 2
            continue }
            segs.push(cur)
            cur = ""
            // past the hole and its spec, if any (D139)
            while i < n && s[i] != '}' { i = i + 1 }
            i = i + 1
            continue
        }
        if c == '}' {
            if i + 1 < n && s[i + 1] == '}' { cur = cur + "}"
            i = i + 2
            continue }
            i = i + 1
            continue
        }
        cur = cur + str_byte(s, i)
        i = i + 1
    }
    segs.push(cur)
    return segs
}

// The single-byte substring at index `i` (build a 1-char string).
#test("{}: {}", 2)[":"]
#test("{}:{}:{}: there is no error, this is just a test", 16)["i"]
#test("This is not the error you are looking for. It is {}", 38)["f"]
fun str_byte(s: str, i: int32) -> str {
    var sb = StringBuilder()
    sb.append_byte(s[i])
    return sb.build()
}

