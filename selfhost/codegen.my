fun bind_elem_names(be: BindElem) -> [str] {
    var out: [str] = []
    match be {
        BindElem.BName(n, l, c, sp) => { out.push(n) },
        BindElem.BWild => {},
        BindElem.BTuple(es, l, c, sp) => { for e in es { for n in bind_elem_names(e) { out.push(n) } } },
    }
    return out
}

#test(pattern_of("3"))[[]]
fun pattern_names(p: Pattern) -> [str] {
    var out: [str] = []
    match p.kind {
        PatternKind.PBind(n) => { out.push(n) },
        PatternKind.PEnum(en, v, elems, hp) => { for el in elems { for n in pattern_names(el) { out.push(n) } } },
        PatternKind.PTuple(elems) => { for el in elems { for n in pattern_names(el) { out.push(n) } } },
        PatternKind.PStruct(nm, fields) => { for f in fields { for n in pattern_names(f.pattern) { out.push(n) } } },
        PatternKind.POr(elems) => { for el in elems { for n in pattern_names(el) { out.push(n) } } },
        _ => {},
    }
    return out
}

