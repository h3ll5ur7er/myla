        self.raw("\tmovq $7, %rax")
        self.raw("\tmovq %rsp, %rdi")
        self.raw("\tmovq $1, %rsi")
        self.raw("\tmovq 8(%rsp), %rdx")
        self.raw("\tsyscall")
        self.raw("\tcmpq $-4, %rax")
        self.raw("\tje .Lpl_retry")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjs .Lpl_err")
        self.raw("\tjz .Lpl_done")
        self.raw("\tmovq $1, %rax")
