    // `__poll`: rdi = fd, rsi = timeout in ms (negative: none) -> rax = 1 when
    // a read of fd won't block (input, its end, or an error), 0 when the time
    // ran out, -1 when poll(7) failed, which sets `__io_errno_val` (0
    // otherwise); retried on EINTR. Backs `std.io`'s `Reader.ready` (MYLA-80).
    fun emit_poll_runtime(var self) {
        self.raw("__poll:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tsubq $16, %rsp")
        self.raw("\tmovq $0, __io_errno_val(%rip)")
        self.raw("\tmovl %edi, (%rsp)")
