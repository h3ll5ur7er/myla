// codegen.my -- x86-64 code generator, written in Myla (self-hosting v0.9).
//
// Mirrors src/myla/compiler/codegen_x86.py: turns a type-checked program into
// GAS/AT&T assembly text. The build driver (a thin host wrapper, see
// docs/Architecture/Self-hosted-compiler.md) runs `as`/`ld` over the emitted assembly. This is the
// v0.9 milestone, ported incrementally and differentially tested against the
// Python backend (same stdout/exit for every example).
//
// Slice C0: the emitter, label/string interning, the freestanding runtime
// prelude, simple frame layout, and scalar `_eval`/calls/`print` -- enough to
// build and run a `hello`-class program through `as`/`ld` with parity.

from .ast import Expr, ExprKind, Stmt, StmtKind, Block, Decl, DeclKind, FunData, Param, ExprOrBlock, ElseTail, TypeExpr, MatchArm, Pattern, PatternKind, FieldPat, FieldInit, MapEntry, Attribute, BindElem, bind_elems, names_in_expr, names_in_block
from .tokens import no_span
from std.num import f64_literal_bits, f32_round_bits
from std.fs import current_dir
from .loader import Span
from .checker import CheckErr, Checker, Type, is_builtin_value, is_raw_memory_primitive, is_platform_primitive, FuncSig, StructInfo, EnumInfo, FieldT, VariantT, Subst, subst_type, subst_get, opt_subst_type, CV, type_name, checker_on, ImplArgs, impl_trait_args
from .checker import is_notify_primitive
from .ir import render_func, verify, moves, IrFunc, Inst
from .ssa import SsaStats, no_ssa_stats
from .inline import inlinable, inline_calls, same_module, may_inline, merge_blocks
from .hoist import hoist_cows
from .ranges import widen_counters
from .anf import Norm, new_norm
from .lower import async_fnval_ir, lower_function, lower_lambda, blocked_types, Lowered, myla_runtime_function, derived_eq_ir, compound_eq_ir, tuple_hash_ir, key_hash_ir, key_eq_ir, map_find_ir, map_put_ir, map_keys_ir, walk_ir, drop_entry_ir, dropb_slow_ir, list_drop_slow_ir, map_drop_slow_ir, drop_drain_ir, clone_ir, deep_walk_ir, deep_cell_ir, Routine, Want, env_drop_ir, env_deep_ir, partial_ir, frame_new_ir
import .ir_x86 as ir_x86
import .ownership as ownership
import .runtime_x86 as runtime_x86
import .ir_a64 as ir_a64
import .runtime_a64 as runtime_a64
import .ir_wasm as ir_wasm
import .runtime_wasm as runtime_wasm
from .dwarf import uleb, sleb, bytes_line, exprloc, str_pieces, dw_string, dw_ref, abbrev_section, gdb_scripts_section, AB_CU, AB_BASE, AB_SUBPROGRAM, AB_TYPED_SUBPROGRAM, AB_PARAM, AB_VAR, AB_BLOCK, AB_PTR, AB_VOIDPTR, AB_STRUCT, AB_MEMBER, AB_ARRAY, AB_SUBRANGE, AB_VARIANT_PART, AB_VARIANT, AB_TAG, OP_FBREG, OP_BREG15, OP_DEREF, OP_PLUS_UCONST, OP_STACK_VALUE, OP_PUSH_OBJECT_ADDRESS, OP_LIT0, OP_MINUS, OP_REG6, OP_GNU_DEREF_TYPE, OP_GNU_CONVERT, ATE_BOOLEAN, ATE_FLOAT, ATE_SIGNED, ATE_UNSIGNED, ATE_UTF, LANG_RUST
from .parser import expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of  // AST values for #test cases (MYLA-184)

// A name binding in scope: a parameter or local at a fixed rbp offset.
// `capoff` is the byte offset within the closure env for a "capture" binding.
pub struct CgBinding { name: str, kind: str, offset: int32, ty: Type, capoff: int32 }

// A by-value captured variable in a closure environment cell.
// `task`: the capture is a sibling child task's frame, which a child task
// awaits (MYLA-148), its result's type `task_ty` (`task_void`: none).
pub struct Cap { name: str, ty: Type, off: int32, task: bool, task_ty: Type, task_void: bool }

// A Myla scope for the debug information: the label its lexical blocks end
// at, and how many it opened (MYLA-66).
pub struct DbgScope { end: str, blocks: int32 }

// A type DIE still to emit (MYLA-66): its label, what it describes (`kind`:
// base, byte, ptr, voidptr, slice, array, cell or agg), the Myla type, the
// label it points at, and two numbers (a base type's size; an array's stride
// and header).
pub struct DbgType { label: str, kind: str, ty: Type, target: str, n: int32, m: int32 }

// A lifted lambda body to emit as a top-level function (monomorphized per stamp).
pub struct LamJob { lifted: str, params: [Param], ftype: Type, body: ExprOrBlock, caps: [Cap], subst: [Subst], id: int32, line: int32, col: int32 }

// A partial-application thunk to emit: `slots[i]` is the env byte offset of a
// filled argument, or -1 for a hole (filled from the thunk's own parameters);
// `aggs[i]` says the argument is an aggregate (passed by address), `sret` that
// the target returns one (through a caller-provided pointer). The target is the
// function `target`, or (`fn_off` >= 0) the function value stored in the env
// at that offset.
pub struct PartialJob { lifted: str, target: str, fn_off: int32, slots: [int32], aggs: [bool], sret: bool, owned: [DropEntry] }

// A value of type `ty` at `off` in a function value's environment, which the
// environment's release function drops.
pub struct DropEntry { off: int32, ty: Type }

// Resolved enum-constructor info for an expression (`Shape.Circle(2)`, `None`).
pub struct CtorInfo { ok: bool, enum_name: str, variant: str, args: [Expr] }

// A pending generic-function instantiation to stamp out (monomorphization, D13).
pub struct MonoFn { orig: str, mangled: str, subst: [Subst] }

pub struct CodeGen {
    decls: [Decl],
    const_strs: [str: str],          // a str const's folded value (MYLA-84)
    resolved: [int32: Type],
    structs: [StructInfo],
    enums: [EnumInfo],
    recursive_enums: [str],
    funcs: [FuncSig],
    impl_args: [str: ImplArgs],     // a generic trait's impls' arguments, which a bound fixes a type parameter by (D171)
    // the calls of functions without `self`, by id, with the type each is
    // called on, and each such function's impl target (D172)
    static_calls: [int32: Type],
    static_selfs: [str: Type],
    text: [str],
    rodata: [str],
    strdata: [str],                 // static `str` cells (static_str)
    label_n: int32,
    str_n: int32,
    str_texts: [str],
    str_labels: [str],
    subst: [Subst],
    fn_worklist: [MonoFn],
    fn_seen: [str: bool],            // queued or emitted, by mangled name
    lam_jobs: [LamJob],
    lam_seen: [str: bool],
    partial_jobs: [PartialJob],
    fnval_set: [str],
    uses_float: bool,
    epilogue: str,
    ret_type: Option<Type>,
    // Reference-counting helper worklists: concrete owning types whose per-type
    // drop/clone routines must be emitted (deduped by mangled token).
    need_drop: [Type],
    // the routines on values of a type that call functions (MYLA-313: the
    // equality of a tuple or list, a map key's hash and equality), still to
    // be emitted, and the names of those queued; drained with the functions
    type_jobs: [Want],
    type_jobs_seen: [str: bool],
    drop_emitted: [str],
    // the release routines that defer past a depth (MYLA-389), by kind:
    // `__drop_routines`, which `__drop_drain` calls through
    drop_kinds: [str],
    need_clone: [Type],
    clone_emitted: [str],
    // aggregates whose retain or release walk is a helper of its own
    // (`walk_helper`), and whether each is the retain walk; emitted by name
    need_walk: [Type],
    // D92: the types whose deep walk (`__deepw_<T>`) and the cell types whose
    // deep copy (`deep_cell_name`) are still to be emitted
    need_deep: [Type],
    deep_inline: [bool],
    deep_clone: [bool],
    need_deepc: [Type],
    deepc_clone: [bool],
    walk_retain: [bool],
    walk_emitted: [str],
    // the drop, clone and walk helpers asked for so far, by kind and type
    // token ("drop.L4.str"): one lookup instead of comparing the token of
    // every queued type (MYLA-124)
    helper_seen: [str: bool],
    need_sb: bool,
    // The loader's module spans (which node ids belong to which file; ids from
    // `prelude_id` on are the prelude's, with no source), for runtime-error
    // positions and debug information.
    line_spans: [Span],
    prelude_id: int32,
    // Runtime-error positions (MYLA-65, MYLA-66): the file of the function
    // being generated, the record label of each position ("file:line:col"),
    // and the records, `[file str][line:4][col:4]`, for .rodata.
    cur_path: str,
    pos_labels: [str: str],
    posdata: [str],
    // DWARF line tables (`-g`, MYLA-71): whether to emit them, the `.file`
    // paths in number order, the number of the file of the function being
    // generated (0: none), and the last `.loc` emitted.
    debug: bool,
    line_files: [str],
    cur_file: int32,
    last_loc: str,
    // Variables and types (`-g`, MYLA-66): whether the function being
    // generated gets them, the subprograms' DIEs, each type DIE's label by key
    // and the type DIEs to emit, the open scopes, the function's end label,
    // where the last lexical block opened, and a label counter.
    dbg_fn: bool,
    dbg_lines: [str],
    dbg_types: [str: str],
    dbg_pending: [DbgType],
    dbg_scopes: [DbgScope],
    dbg_fn_end: str,
    dbg_mark: str,
    dbg_n: int32,
    dbg_script: str,
    // The IR (MYLA-103, D79), which every function goes through: whether
    // the functions' IR text is kept (`--emit-ir`), and the text; the structs
    // and enums the lowering can't take (`blocked_types`), worked out before
    // the first function.
    // Lookup tables (MYLA-119): the index of each function, struct and enum
    // by name (the first of a name), the enums' names, the variants' names
    // and those without a payload, and each interned string's index.
    func_ix: [str: int32],
    struct_ix: [str: int32],
    enum_ix: [str: int32],
    enum_names: [str: bool],
    variant_names: [str: bool],
    nullary_names: [str: bool],
    str_ix: [str: int32],
    keep_ir: bool,
    // a float is made text somewhere (`__float_to_str` called)
    wants_ftoa: bool,
    // the small leaf functions copied into their callers (`inline.my`):
    // their names and lowered bodies, and the names found not to be;
    // `inlining` off with `--no-inline` (and under -g: each function stays
    // one for the debugger)
    inlining: bool,
    inl_names: [str],
    inl_bodies: [IrFunc],
    inl_no: [str: bool],
    // D123's prototype: the scalar slots promoted before each function is
    // emitted (`--ssa`), and what that did
    ssa: bool,
    ssa_stats: SsaStats,
    // what the program can't be built for, which the lowering found once it
    // knew an instance's types (MYLA-272): reported as type errors, and
    // nothing more is emitted
    refused: [CheckErr],
    ir_texts: [str],
    ir_blocked: [str],
    ir_ready: bool,
    // the store of the temporary in %rax, held back until the next line
    // (`store_temp`, MYLA-108; "" for none), and how often each temporary of
    // the function being emitted is read
    pend_store: str,
    pend_temp: int32,
    // the line of `text` that is a register's re-extension (`movslq %eax,
    // %rax`), or -1: one the next instruction may make moot (MYLA-251)
    ext_at: int32,
    temp_uses: [int32],
    // per temporary, how to recompute it where it is read instead of keeping
    // it in a slot (`remat_texts`; "" for a temporary kept in its slot)
    temp_remat: [str],
    // per float constant recomputed where it is read, its bits, which an
    // %xmm register takes from the constant pool, or as 0 by `xorpd`
    // (`float_const_into`, MYLA-249); and the pool's labels, by bits
    temp_fconst: [int32: int64],
    fconst_labels: [int64: str],
    // per temporary read from a variable where it is used, the variable's
    // operand (`-24(%rbp)`), else ""
    temp_src: [str],
    temp_imm: [str],                // MYLA-120: a constant temporary as an immediate operand, "" when not
    temp_frame: [int32],            // MYLA-120: a slot address's offset from %rbp, 0 when not
    temp_mem: [str],                // MYLA-162: the runtime variable whose address (`__rt_addr`) only loads and stores read, "" when not
    // per temporary, its frame offset (`alloc_temps`; temporaries whose lives
    // don't overlap share one)
    temp_off: [int32],
    // MYLA-121: per temporary and per slot, the callee-saved register it
    // lives in ("rbx", "r12", …; "" for none), and the registers the function
    // saves in the prologue
    temp_reg: [str],
    slot_reg: [str],
    saved_regs: [str],
    // D90: whether the function being generated is an async function's frame
    // function, whose slots are in the heap frame %r15 holds (else at %rbp);
    // its resume points (the block of each state, from 1)
    in_frame: bool,
    resume_blocks: [int32],
    // D91: whether async functions run on frames, the tasks taking turns
    // (the program has an `async let`, or `--async-frames`), and the
    // normalizer of their bodies (anf.my), which adds the types of the nodes
    // it makes to `resolved`
    frames: bool,
    norm: Norm,
    save_base: int32,               // MYLA-126: the saved registers' cells start below it
    arg_words: int32,               // D119: the argument words the function received on the stack
    frameless: bool,                // MYLA-162: the function being emitted sets up no frame
    // MYLA-127: per function (by its signature's name), which parameters its
    // body keeps as a whole value (`keeps`); such a parameter of a scalar
    // type that owns heap memory is passed owned (`owned_param`)
    kept_params: [str: [bool]],
    keeping: [str: bool],           // MYLA-127: the names (a method's after the dot) of functions keeping a parameter
    scan_kept: [str],               // MYLA-127: while scanning a body, the names it keeps
    scan_args: [ScanArg],           // MYLA-127: the calls found by the scan
    owning: [str: bool],            // MYLA-127: the functions with an owned parameter
    no_owned: [bool],
    // MYLA-128, D87: per function, the parameters a `become` hands a heap
    // value over to (owned), and those it passes on to a function value
    // (borrowed), as the checker found them
    handed: [str: [int32]],
    passed_on: [str: [int32]],
    tag_enums: [str: bool],         // MYLA-133: the enums whose `==` compares tags only
    a64: bool,                      // MYLA-163: the target is aarch64 Linux (`ir_a64.my`), else x86-64
    // MYLA-158: the target is wasm32 on WASI (`ir_wasm.my`); each function's
    // words, and those its calls pass (-1: two different counts)
    wasm: bool,
    wasm_arity: [str: int32],
    wasm_calls: [str: int32],
    env_records: [str],             // MYLA-263: the environments whose routines records the data holds (`env_record_of`)
}

// A code generator for `src` (checked alone, `checker_on`), the receiver of
// `#test` cases of the code generator's methods (MYLA-184).
pub fun codegen_on(src: str) -> CodeGen {
    return new_codegen(checker_on(src))
}

pub fun new_codegen(c: Checker) -> CodeGen {
    var handed: [str: [int32]] = [:]
    for k in c.handovers.keys() {
        let h = c.handovers[k]
        handed[h.func] = with_int(int_list(handed.get(h.func)), h.index)
    }
    var passed_on: [str: [int32]] = [:]
    for p in c.passed_on { passed_on[p.func] = with_int(int_list(passed_on.get(p.func)), p.index) }
    var const_strs: [str: str] = [:]
    for n in c.const_values.keys() {
        match c.const_values[n] {
            CV.CVStr(t) => { const_strs[n] = t },
            _ => {},
        }
    }
    var func_ix: [str: int32] = [:]
    var i = 0
    while i < c.functions.len() {
        if !func_ix.contains(c.functions[i].name) { func_ix[c.functions[i].name] = i }
        i = i + 1
    }
    var struct_ix: [str: int32] = [:]
    i = 0
    while i < c.structs.len() {
        if !struct_ix.contains(c.structs[i].name) { struct_ix[c.structs[i].name] = i }
        i = i + 1
    }
    var enum_ix: [str: int32] = [:]
    var variant_names: [str: bool] = [:]
    var nullary_names: [str: bool] = [:]
    i = 0
    while i < c.enums.len() {
        if !enum_ix.contains(c.enums[i].name) { enum_ix[c.enums[i].name] = i }
        for v in c.enums[i].variants {
            variant_names[v.name] = true
            if v.payload.len() == 0 { nullary_names[v.name] = true }
        }
        i = i + 1
    }
    var enum_names: [str: bool] = [:]
    for d in c.decls {
        match d.kind {
            DeclKind.EnumDecl(en, variants, attrs, tps, isp) => { enum_names[en] = true },
            _ => {},
        }
    }
    return CodeGen {
        func_ix: func_ix, struct_ix: struct_ix, enum_ix: enum_ix, enum_names: enum_names,
        variant_names: variant_names, nullary_names: nullary_names, str_ix: [:],
        decls: c.decls,
        const_strs: const_strs,
        resolved: c.resolved,
        structs: c.structs,
        enums: c.enums,
        recursive_enums: c.recursive_enums,
        funcs: c.functions,
        impl_args: c.impl_args,
        static_calls: c.static_calls, static_selfs: c.static_selfs,
        text: [], rodata: [], strdata: [],
        label_n: 0, str_n: 0,
        str_texts: [], str_labels: [],
        subst: [], fn_worklist: [], fn_seen: [:],
        lam_jobs: [], lam_seen: [:], partial_jobs: [], fnval_set: [],
        uses_float: false,
        epilogue: "", ret_type: None,
        need_drop: [], type_jobs: [], type_jobs_seen: [:], drop_emitted: [], drop_kinds: [], need_clone: [], clone_emitted: [],
        need_walk: [], need_deep: [], deep_inline: [], deep_clone: [], need_deepc: [], deepc_clone: [], walk_retain: [], walk_emitted: [], helper_seen: [:],
        need_sb: false,
        line_spans: [], prelude_id: 0,
        cur_path: "<input>", pos_labels: [:], posdata: [],
        debug: false, line_files: [], cur_file: 0, last_loc: "",
        dbg_fn: false, dbg_lines: [], dbg_types: [:], dbg_pending: [], dbg_scopes: [],
        dbg_fn_end: "", dbg_mark: "", dbg_n: 0, dbg_script: "",
        keep_ir: false, wants_ftoa: false, inlining: true, inl_names: [], inl_bodies: [], inl_no: [:], ssa: false, ssa_stats: no_ssa_stats(), refused: [], ir_texts: [], ir_blocked: [], ir_ready: false,
        pend_store: "", pend_temp: -1, ext_at: -1, temp_uses: [], temp_remat: [], temp_fconst: [:], fconst_labels: [:], temp_src: [], temp_imm: [], temp_frame: [], temp_mem: [], temp_off: [],
        temp_reg: [], slot_reg: [], saved_regs: [], in_frame: false, resume_blocks: [], frames: c.task_line > 0, norm: compiler_norm(), save_base: 0, arg_words: 0, frameless: false, kept_params: [:], keeping: [:], scan_kept: [], scan_args: [], owning: [:], no_owned: [], handed: handed, passed_on: passed_on, tag_enums: [:], a64: false, wasm: false, wasm_arity: [:], wasm_calls: [:], env_records: [],
    }
}

impl CodeGen {
    // The files of the program: `spans` is the loader's `Loaded.spans`, node
    // ids from `next_id` on are the prelude's. Runtime errors name them.
    fun set_sources(var self, spans: [Span], next_id: int32) {
        self.line_spans = spans
        self.prelude_id = next_id
    }

    // Emit DWARF debug information (`-g`): line tables (MYLA-71), variables
    // and types (MYLA-66), and embed the pretty-printers `gdb_script` (the
    // text of `debug/myla_gdb.py`, `dwarf.read_gdb_script`; "" for none, D82).
    fun enable_debug_info(var self, gdb_script: str) {
        self.debug = true
        self.dbg_script = gdb_script
    }

    // Keep each function's IR text (`ir_text`, for `--emit-ir`).
    fun keep_ir_text(var self) {
        self.keep_ir = true
    }

    // The IR of every function, as text.
    #test(codegen_on("[int]"))[""]
    fun ir_text(self) -> str {
        var sb = StringBuilder()
        for t in self.ir_texts { sb.append(t) }
        return sb.build()
    }

    // The path of the file node `id` is in, as the loader names it (the entry
    // file as given, the self-hosted CLI's diagnostics name the same), or
    // `<input>` without one.
    #test(codegen_on("[int]"), 16)["<input>"]
    fun path_of(self, id: int32) -> str {
        if self.line_spans.len() == 0 || id < 0 || id >= self.prelude_id { return "<input>" }
        var path = self.line_spans[0].path
        for sp in self.line_spans { if sp.first_id <= id { path = sp.path } }
        return path
    }

    // -- runtime-error positions (MYLA-65, MYLA-66) ------------------------

    // Load the address of the record of position `line:col` in the current
    // function's file into `reg` (0 without a position): `[file str:8]
    // [line:4][col:4]`, one per distinct position, which `__panic` prints as
    // `  --> file:line:col`.
    fun load_position(var self, line: int32, col: int32, reg: str) {
        if line <= 0 {
            self.emit(format("movq $0, %{}", reg))
            return
        }
        self.emit(format("leaq {}(%rip), %{}", self.position_label(line, col), reg))
    }

    // The label of the record of position `line:col` in the current file,
    // made the first time (shared by the backends).
    fun position_label(var self, line: int32, col: int32) -> str {
        let key = format("{}:{}:{}", self.cur_path, line, col)
        var lab = ""
        match self.pos_labels.get(key) {
            Some(l) => { lab = l },
            None => {
                lab = format(".Lpos{}", self.pos_labels.len())
                self.pos_labels[key] = lab
                let file = self.string_label(self.cur_path)
                self.posdata.push("\t.balign 8")
                self.posdata.push(format("{}:", lab))
                self.posdata.push(format("\t.quad {}", file))
                self.posdata.push(format("\t.long {}, {}", line, col))
            },
        }
        return lab
    }

    // Take the runtime-error entry `trap` when `jump` (`jae`, `jz`, ..., or
    // `jmp`) would jump, reporting position `line:col` (the interpreter's for
    // the same error). The call leaves a return address for gdb's backtrace.
    fun trap(var self, jump: str, trap: str, line: int32, col: int32) {
        var skip = ""
        if jump != "jmp" {
            skip = self.label()
            self.emit(format("{} {}", skip_trap(jump), skip))
        }
        self.load_position(line, col, "rsi")
        self.emit(format("call {}", trap))
        if skip != "" { self.emit(format("{}:", skip)) }
    }

    // -- debug information: variables and types (`-g`, MYLA-66) ----------
    //
    // As src/myla/compiler/dwarf.py: a subprogram per function with its
    // parameters and captures, its locals in lexical blocks (one opens where a
    // binding starts and ends with the Myla scope), and the types they use.

    #test(codegen_on("[int]"), "b")[".Ldb1"]
    fun dbg_label(var self, kind: str) -> str {
        self.dbg_n = self.dbg_n + 1
        return format(".Ld{}{}", kind, self.dbg_n)
    }

    fun dbg_line(var self, line: str) { self.dbg_lines.push(line) }

    // Open the subprogram of the function at label `symbol`, if the function
    // has a line table; it returns `self.ret_type`.
    fun dbg_begin_function(var self, symbol: str) {
        self.dbg_fn = self.cur_file != 0
        if !self.dbg_fn { return }
        self.dbg_fn_end = self.dbg_label("f")
        self.dbg_scopes = []
        let ty = self.dbg_return_type(self.ret_type)
        if ty == "" {
            self.dbg_line(format("\t.uleb128 {}", AB_SUBPROGRAM))
        } else {
            self.dbg_line(format("\t.uleb128 {}", AB_TYPED_SUBPROGRAM))
        }
        self.dbg_line(dw_string(symbol))
        self.dbg_line(format("\t.quad {}", symbol))
        self.dbg_line(format("\t.quad {} - {}", self.dbg_fn_end, symbol))
        self.dbg_line("\t.uleb128 1")
        self.dbg_line(format("\t.byte {}", OP_REG6))
        if ty != "" { self.dbg_line(dw_ref(ty)) }
    }

    // The type `finish` reads a function's result as, from `%rax` ("": none
    // it can read). An aggregate comes back through the hidden pointer `%rax`
    // returns; a float in `%rax`, where gdb would read `%xmm0`.
    #test(codegen_on("[int]"), None)[""]
    fun dbg_return_type(var self, ret: Option<Type>) -> str {
        let t = match ret {
            Some(t) => t,
            None => { return "" },
        }
        match t {
            Type.TFloat(w) => { return "" },
            _ => {},
        }
        if is_aggregate(t) { return self.dbg_pointer(self.dbg_aggregate(t)) }
        return self.dbg_element(t)
    }

    // Close the subprogram; its end label goes after the function's code.
    fun dbg_end_function(var self) {
        if !self.dbg_fn { return }
        self.emit(format("{}:", self.dbg_fn_end))
        self.dbg_line("\t.byte 0")
        self.dbg_fn = false
    }

    fun dbg_push_scope(var self) {
        if self.dbg_fn { self.dbg_scopes.push(DbgScope { end: self.dbg_label("e"), blocks: 0 }) }
    }

    fun dbg_pop_scope(var self) {
        if !self.dbg_fn { return }
        let top = self.dbg_scopes.pop()
        if top.blocks > 0 {
            self.emit(format("{}:", top.end))
            var i = 0
            while i < top.blocks {
                self.dbg_line("\t.byte 0")
                i = i + 1
            }
        }
    }

    // Describe binding `b` for gdb. A parameter or a capture (`whole`) is
    // visible in the whole function; another binding from here to the end of
    // its scope, in a lexical block that starts at a label emitted now.
    fun dbg_variable(var self, b: CgBinding, whole: bool, param: bool) {
        if !self.dbg_fn || is_internal_name(b.name) { return }
        if !whole {
            let si = self.dbg_scopes.len() - 1
            let end = self.dbg_scopes[si].end
            if format("{}:{}", end, self.text.len()) != self.dbg_mark {
                let start = self.dbg_label("b")
                self.emit(format("{}:", start))
                self.dbg_line(format("\t.uleb128 {}", AB_BLOCK))
                self.dbg_line(format("\t.quad {}", start))
                self.dbg_line(format("\t.quad {} - {}", end, start))
                self.dbg_scopes[si].blocks = self.dbg_scopes[si].blocks + 1
                self.dbg_mark = format("{}:{}", end, self.text.len())
            }
        }
        // the address of the value
        var addr: [int32] = [OP_FBREG]
        if b.kind == "frame" {
            // in a frame function's heap frame, whose address %r15 holds
            // (D90, MYLA-141; it came in %rdi, D119)
            addr = [OP_BREG15]
        }
        for x in sleb(b.offset) { addr.push(x) }
        if b.kind == "capture" {
            addr.push(OP_DEREF)
            if b.capoff != 0 {
                addr.push(OP_PLUS_UCONST)
                for x in uleb(b.capoff) { addr.push(x) }
            }
        } else if b.kind == "param" && is_aggregate(b.ty) {
            addr.push(OP_DEREF)               // passed (or borrowed) by address
        }
        var ty = ""
        var loc: [str] = []
        match b.ty {
            Type.TStr => {
                ty = self.dbg_slice()
                loc = exprloc(str_pieces(addr, 8))
            },
            Type.TSB => {
                ty = self.dbg_slice()
                loc = exprloc(str_pieces(addr, 16))
            },
            Type.TList(e) => {
                ty = self.dbg_items(e)
                addr.push(OP_DEREF)
                addr.push(OP_PLUS_UCONST)
                addr.push(16)
                loc = exprloc(addr)
            },
            Type.TFloat(w) => {
                if w == 32 {
                    ty = self.dbg_base(b.ty, 4)
                    loc = self.dbg_convert(addr, ty)
                } else {
                    ty = self.dbg_base(b.ty, 8)
                    loc = exprloc(addr)
                }
            },
            Type.TEnum(n, a) => {
                ty = self.dbg_aggregate(b.ty)  // a variable holds even a boxed enum inline
                loc = exprloc(addr)
            },
            _ => {
                ty = self.dbg_element(b.ty)
                loc = exprloc(addr)
            },
        }
        var tag = AB_VAR
        if param { tag = AB_PARAM }
        self.dbg_line(format("\t.uleb128 {}", tag))
        self.dbg_line(dw_string(b.name))
        self.dbg_line(dw_ref(ty))
        for l in loc { self.dbg_line(l) }
    }

    // The location of a float32 variable: the double it is kept as, converted
    // to the type `f32`.
    #test(codegen_on("[int]"), [145, 104], ".Ldty0")[["\t.uleb128 .Ldx2 - .Ldx1", ".Ldx1:", "\t.byte 145, 104", "\t.byte 246, 8", "\t.uleb128 .Ldty0 - .Ldebug_info0", "\t.byte 247", "\t.uleb128 .Ldty0 - .Ldebug_info0", "\t.byte 159", ".Ldx2:"]]
    fun dbg_convert(var self, addr: [int32], f32: str) -> [str] {
        let f64 = self.dbg_base(Type.TFloat(64), 8)
        let start = self.dbg_label("x")
        let end = self.dbg_label("x")
        var out = [format("\t.uleb128 {} - {}", end, start), format("{}:", start), bytes_line(addr)]
        out.push(format("\t.byte {}, 8", OP_GNU_DEREF_TYPE))
        out.push(format("\t.uleb128 {} - .Ldebug_info0", f64))
        out.push(format("\t.byte {}", OP_GNU_CONVERT))
        out.push(format("\t.uleb128 {} - .Ldebug_info0", f32))
        out.push(format("\t.byte {}", OP_STACK_VALUE))
        out.push(format("{}:", end))
        return out
    }

    // The label of the type DIE `key` names, registered the first time.
    #test(codegen_on("[int]"), "byte", "byte", Type.TBool, "", 0, 0)[".Ldty0"]
    fun dbg_type(var self, key: str, kind: str, ty: Type, target: str, n: int32, m: int32) -> str {
        match self.dbg_types.get(key) {
            Some(l) => { return l },
            None => {},
        }
        let label = format(".Ldty{}", self.dbg_types.len())
        self.dbg_types[key] = label
        self.dbg_pending.push(DbgType { label: label, kind: kind, ty: ty, target: target, n: n, m: m })
        return label
    }

    // A scalar's base type, `size` bytes wide.
    #test(codegen_on("[int]"), Type.TFloat(32), 4)[".Ldty0"]
    fun dbg_base(var self, t: Type, size: int32) -> str {
        return self.dbg_type(format("base:{}:{}", type_name(t), size), "base", t, "", size, 0)
    }

    // A string's byte, shown with its character.
    #test(codegen_on("[int]"))[".Ldty0"]
    fun dbg_byte(var self) -> str { return self.dbg_type("byte", "byte", Type.TBool, "", 0, 0) }

    #test(codegen_on("[int]"), ".Ldty0")[".Ldty0"]
    fun dbg_pointer(var self, target: str) -> str {
        return self.dbg_type(format("ptr:{}", target), "ptr", Type.TBool, target, 0, 0)
    }

    #test(codegen_on("[int]"))[".Ldty0"]
    fun dbg_void_pointer(var self) -> str { return self.dbg_type("voidptr", "voidptr", Type.TBool, "", 0, 0) }

    // A Rust `&str`, which gdb prints as a string literal.
    #test(codegen_on("[int]"))[".Ldty0"]
    fun dbg_slice(var self) -> str { return self.dbg_type("slice", "slice", Type.TBool, "", 0, 0) }

    // An array of `elem`s `stride` bytes apart, as many as the 8 bytes
    // `header` bytes before the first say (a cell's length).
    #test(codegen_on("[int]"), ".Ldty6", 1, 8)[".Ldty0"]
    fun dbg_array(var self, elem: str, stride: int32, header: int32) -> str {
        return self.dbg_type(format("array:{}:{}:{}", elem, stride, header), "array", Type.TBool, elem, stride, header)
    }

    // The elements of a list of `e`s, at its cell + 16.
    #test(codegen_on("[int]"), Type.TFloat(64))[".Ldty1"]
    fun dbg_items(var self, e: Type) -> str {
        // an element narrower than a word is described at its size (D120)
        let size = self.elem_size(e)
        var elem = self.dbg_element(e)
        if size < 8 { elem = self.dbg_base(e, size) }
        return self.dbg_array(elem, size, 16)
    }

    // The heap cell of a `str`, list, builder or map, for a pointer to it.
    #test(codegen_on("[int]"), Type.TStr)[".Ldty0"]
    fun dbg_cell(var self, t: Type) -> str {
        return self.dbg_type(format("cell:{}", type_name(t)), "cell", t, "", 0, 0)
    }

    #test(codegen_on("[int]"), Type.TEnum("Color", []))[".Ldty0"]
    fun dbg_aggregate(var self, t: Type) -> str {
        return self.dbg_type(format("agg:{}", type_name(t)), "agg", t, "", 0, 0)
    }

    // The type of a value inside an aggregate or a list (or of a scalar
    // variable): types of a fixed size only.
    #test(codegen_on("[int]"), Type.TStr)[".Ldty1"]
    fun dbg_element(var self, t: Type) -> str {
        match t {
            Type.TInt(w, sg) => {
                // a signed integer is its whole sign-extended slot, so that `set
                // var` writes a canonical value (an unsigned one's upper bytes stay 0)
                if sg { return self.dbg_base(t, 8) }
                return self.dbg_base(t, w / 8)
            },
            Type.TBool => { return self.dbg_base(t, 1) },
            Type.TChar => { return self.dbg_base(t, 4) },
            Type.TFloat(w) => { return self.dbg_base(t, 8) },   // a float32 is kept as a double
            // an address of the IR's own (D121), shown as its number
            Type.TPtr => { return self.dbg_base(Type.TInt(64, false), 8) },
            Type.TStr => {},
            Type.TSB => {},
            Type.TList(e) => {},
            Type.TMap(k, v) => {},
            _ => {
                let agg = self.dbg_aggregate(t)
                if self.is_boxed(t) { return self.dbg_pointer(agg) }
                return agg
            },
        }
        let cell = self.dbg_cell(t)
        return self.dbg_pointer(cell)
    }

    // A structure type's lines: `members` of `types` at `offs`.
    #test(codegen_on("[int]"), "Point", 16, ["x", "y"], [".Ldty1", ".Ldty1"], [0, 8])[["\t.uleb128 9", "\t.string \"Point\"", "\t.uleb128 16", "\t.uleb128 10", "\t.string \"x\"", "\t.long .Ldty1 - .Ldebug_info0", "\t.uleb128 0", "\t.uleb128 10", "\t.string \"y\"", "\t.long .Ldty1 - .Ldebug_info0", "\t.uleb128 8", "\t.byte 0"]]
    fun dbg_struct_lines(self, name: str, size: int32, members: [str], types: [str], offs: [int32]) -> [str] {
        var out = [format("\t.uleb128 {}", AB_STRUCT), dw_string(name), format("\t.uleb128 {}", size)]
        var i = 0
        while i < members.len() {
            out.push(format("\t.uleb128 {}", AB_MEMBER))
            out.push(dw_string(members[i]))
            out.push(dw_ref(types[i]))
            out.push(format("\t.uleb128 {}", offs[i]))
            i = i + 1
        }
        out.push("\t.byte 0")
        return out
    }

    // The lines of the type DIE `p` describes.
    #test(codegen_on("[int]"), DbgType { label: ".Ldty1", kind: "ptr", ty: Type.TBool, target: ".Ldty0", n: 0, m: 0 })[["\t.uleb128 7", "\t.byte 8", "\t.long .Ldty0 - .Ldebug_info0"]]
    fun dbg_build(var self, p: DbgType) -> [str] {
        let i64 = Type.TInt(64, true)
        if p.kind == "base" {
            return [format("\t.uleb128 {}", AB_BASE), dw_string(type_name(p.ty)), format("\t.byte {}", ate_of(p.ty)), format("\t.byte {}", p.n)]
        }
        if p.kind == "byte" {
            return [format("\t.uleb128 {}", AB_BASE), dw_string("uint8"), format("\t.byte {}", ATE_UTF), "\t.byte 1"]
        }
        if p.kind == "ptr" { return [format("\t.uleb128 {}", AB_PTR), "\t.byte 8", dw_ref(p.target)] }
        if p.kind == "voidptr" { return [format("\t.uleb128 {}", AB_VOIDPTR), "\t.byte 8"] }
        if p.kind == "slice" {
            let byte = self.dbg_byte()
            let data = self.dbg_pointer(byte)
            let length = self.dbg_base(i64, 8)
            return self.dbg_struct_lines("&str", 16, ["data_ptr", "length"], [data, length], [0, 8])
        }
        if p.kind == "array" {
            var out = [format("\t.uleb128 {}", AB_ARRAY), dw_ref(p.target), format("\t.uleb128 {}", p.n), format("\t.uleb128 {}", AB_SUBRANGE)]
            for l in exprloc([OP_PUSH_OBJECT_ADDRESS, OP_LIT0 + p.m, OP_MINUS, OP_DEREF]) { out.push(l) }
            out.push("\t.byte 0")
            return out
        }
        if p.kind == "cell" { return self.dbg_cell_lines(p.ty) }
        if p.kind == "slot" { return self.dbg_slot_lines(p.ty, p.n) }
        return self.dbg_aggregate_lines(p.ty)
    }

    #test(codegen_on("[int]"), Type.TStr)[["\t.uleb128 9", "\t.string \"str\"", "\t.uleb128 8", "\t.uleb128 10", "\t.string \"len\"", "\t.long .Ldty0 - .Ldebug_info0", "\t.uleb128 0", "\t.uleb128 10", "\t.string \"bytes\"", "\t.long .Ldty2 - .Ldebug_info0", "\t.uleb128 8", "\t.byte 0"]]
    fun dbg_cell_lines(var self, t: Type) -> [str] {
        let len_t = self.dbg_base(Type.TInt(64, true), 8)
        match t {
            Type.TStr => {
                let byte = self.dbg_byte()
                let bytes = self.dbg_array(byte, 1, 8)
                return self.dbg_struct_lines("str", 8, ["len", "bytes"], [len_t, bytes], [0, 8])
            },
            Type.TSB => {
                let byte = self.dbg_byte()
                let bytes = self.dbg_array(byte, 1, 16)
                return self.dbg_struct_lines("StringBuilder", 16, ["len", "cap", "bytes"], [len_t, len_t, bytes], [0, 8, 16])
            },
            Type.TList(e) => {
                let items = self.dbg_items(e)
                return self.dbg_struct_lines(type_name(t), 16, ["len", "cap", "items"], [len_t, len_t, items], [0, 8, 16])
            },
            Type.TMap(k, v) => {
                // the slots, as many as the capacity
                let stride = self.map_slot_size(t)
                let slot = self.dbg_type(format("slot:{}", type_name(t)), "slot", t, "", stride, 0)
                let slots = self.dbg_array(slot, stride, 8)
                return self.dbg_struct_lines(type_name(t), 16, ["len", "cap", "slots"], [len_t, len_t, slots], [0, 8, 16])
            },
            _ => {},
        }
        return self.dbg_struct_lines(type_name(t), 16, ["len", "cap"], [len_t, len_t], [0, 8])
    }

    // A map slot of map type `t`, `size` bytes: `[state:8][key:8][value][order:8]`
    // (state 1: occupied; order: the place in the order of insertion, D105).
    #test(codegen_on("enum E { A, B(int) }"), Type.TMap(Type.TStr, Type.TInt(32, true)), 32)[["\t.uleb128 9", "\t.string \"slot\"", "\t.uleb128 32", "\t.uleb128 10", "\t.string \"state\"", "\t.long .Ldty0 - .Ldebug_info0", "\t.uleb128 0", "\t.uleb128 10", "\t.string \"key\"", "\t.long .Ldty2 - .Ldebug_info0", "\t.uleb128 8", "\t.uleb128 10", "\t.string \"value\"", "\t.long .Ldty3 - .Ldebug_info0", "\t.uleb128 16", "\t.uleb128 10", "\t.string \"order\"", "\t.long .Ldty0 - .Ldebug_info0", "\t.uleb128 24", "\t.byte 0"]]
    fun dbg_slot_lines(var self, t: Type, size: int32) -> [str] {
        match t {
            Type.TMap(k, v) => {
                let state = self.dbg_base(Type.TInt(64, false), 8)
                let key = self.dbg_element(k)
                let value = self.dbg_element(v)
                if self.map_hashed(t) {
                    // a compound key's slot keeps its hash (MYLA-313)
                    return self.dbg_struct_lines("slot", size, ["state", "hash", "key", "value", "order"], [state, state, key, value, state], [0, 8, 16, self.map_val_off(t), size - 8])
                }
                return self.dbg_struct_lines("slot", size, ["state", "key", "value", "order"], [state, key, value, state], [0, 8, 16, size - 8])
            },
            _ => {},
        }
        return []
    }

    #test(codegen_on("struct P { x: int, y: int }"), Type.TStruct("Adder", []))[["\t.uleb128 9", "\t.string \"Adder\"", "\t.uleb128 16", "\t.uleb128 10", "\t.string \"x\"", "\t.long .Ldty0 - .Ldebug_info0", "\t.uleb128 0", "\t.uleb128 10", "\t.string \"y\"", "\t.long .Ldty0 - .Ldebug_info0", "\t.uleb128 8", "\t.byte 0"]]
    fun dbg_aggregate_lines(var self, t: Type) -> [str] {
        let name = type_name(t)
        let size = self.size(t)
        var members: [str] = []
        var types: [str] = []
        var offs: [int32] = []
        var off = 0
        match t {
            Type.TStruct(n, a) => {
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                for f in info.fields {
                    let ft = subst_type(f.ty, sub)
                    members.push(f.name)
                    types.push(self.dbg_element(ft))
                    offs.push(off)
                    off = off + self.stored_size(ft)
                }
            },
            Type.TTuple(es) => {
                var i = 0
                for et in es {
                    members.push(format("__{}", i))
                    types.push(self.dbg_element(et))
                    offs.push(off)
                    off = off + self.stored_size(et)
                    i = i + 1
                }
            },
            Type.TAsync(f) => { return self.dbg_aggregate_lines(f) },
            Type.TFunc(ps, r) => {
                // `fn…`: a name starting with `(` would make gdb take it for a tuple
                let vp = self.dbg_void_pointer()
                return self.dbg_struct_lines("fn" + name, 16, ["code_ptr", "env_ptr"], [vp, vp], [0, 8])
            },
            Type.TEnum(n, a) => { return self.dbg_enum_lines(t, n, name, size) },
            _ => {},
        }
        return self.dbg_struct_lines(name, size, members, types, offs)
    }

    // An enum as Rust describes one: a variant part whose discriminant is the
    // tag, a variant per tag value holding a struct of the payload (fields
    // `__0`, `__1`, ... at their offsets in the whole value).
    fun dbg_enum_lines(var self, t: Type, n: str, name: str, size: int32) -> [str] {
        let variants = self.enum_info(n).variants
        let tag = self.dbg_label("g")
        let tag_t = self.dbg_base(Type.TInt(64, false), 8)
        var out = [format("\t.uleb128 {}", AB_STRUCT), dw_string(name), format("\t.uleb128 {}", size)]
        out.push(format("\t.uleb128 {}", AB_VARIANT_PART))
        out.push(dw_ref(tag))
        out.push(format("{}:", tag))
        out.push(format("\t.uleb128 {}", AB_TAG))
        out.push(dw_string("<tag>"))
        out.push(dw_ref(tag_t))
        out.push("\t.uleb128 0")
        var labels: [str] = []
        for v in variants { labels.push(self.dbg_label("v")) }
        var i = 0
        for v in variants {
            out.push(format("\t.uleb128 {}", AB_VARIANT))
            out.push(format("\t.uleb128 {}", i))
            out.push(format("\t.uleb128 {}", AB_MEMBER))
            out.push(dw_string(v.name))
            out.push(dw_ref(labels[i]))
            out.push("\t.uleb128 0")
            out.push("\t.byte 0")
            i = i + 1
        }
        out.push("\t.byte 0")                  // end of the variant part
        i = 0
        for v in variants {
            out.push(format("{}:", labels[i]))
            out.push(format("\t.uleb128 {}", AB_STRUCT))
            out.push(dw_string(v.name))
            out.push(format("\t.uleb128 {}", size))
            var off = 8
            var j = 0
            for ft in self.variant_payload(t, v.name) {
                let ty = self.dbg_element(ft)
                out.push(format("\t.uleb128 {}", AB_MEMBER))
                out.push(dw_string(format("__{}", j)))
                out.push(dw_ref(ty))
                out.push(format("\t.uleb128 {}", off))
                off = off + self.stored_size(ft)
                j = j + 1
            }
            out.push("\t.byte 0")
            i = i + 1
        }
        out.push("\t.byte 0")
        return out
    }

    // `.debug_abbrev`, `.debug_info`, and the start of `.debug_line` (the
    // assembler appends the line table it builds from `.loc` there). The
    // compile directory is the working directory, as in the Python backend
    // (`.` if it can't be read).
    fun dbg_sections(var self) -> [str] {
        var types: [str] = []
        var i = 0
        while i < self.dbg_pending.len() {
            let p = self.dbg_pending[i]
            types.push(format("{}:", p.label))
            for l in self.dbg_build(p) { types.push(l) }
            i = i + 1
        }
        var out = abbrev_section()
        for l in ["\t.section .debug_info,\"\",@progbits", ".Ldebug_info0:", "\t.long .Ldebug_info_end - .Ldebug_info_start", ".Ldebug_info_start:", "\t.value 4", "\t.long .Ldebug_abbrev0", "\t.byte 8"] { out.push(l) }
        out.push(format("\t.uleb128 {}", AB_CU))
        out.push(dw_string("myla (self-hosted)"))
        out.push(format("\t.value {}", LANG_RUST))
        out.push(dw_string(self.line_files[0]))
        let comp_dir = match current_dir() {
            Ok(d) => d
            Err(e) => "."
        }
        out.push(dw_string(comp_dir))
        for l in ["\t.quad .Ltext0", "\t.quad .Letext0 - .Ltext0", "\t.long .Ldebug_line0"] { out.push(l) }
        for l in self.dbg_lines { out.push(l) }
        for l in types { out.push(l) }
        for l in ["\t.byte 0", ".Ldebug_info_end:"] { out.push(l) }
        if self.dbg_script != "" { for l in gdb_scripts_section(self.dbg_script) { out.push(l) } }
        for l in ["\t.section .debug_line,\"\",@progbits", ".Ldebug_line0:"] { out.push(l) }
        return out
    }

    // -- debug line tables (MYLA-71) --------------------------------------

    // The `.file` number of the module node `id` is in, registered on first
    // use; 0 when line tables are off or the node is the prelude's.
    #test(codegen_on("[int]"), 16)[0]
    fun file_number(var self, id: int32) -> int32 {
        if !self.debug || self.line_spans.len() == 0 || id < 0 || id >= self.prelude_id { return 0 }
        let path = self.path_of(id)
        var i = 0
        while i < self.line_files.len() {
            if self.line_files[i] == path { return i + 1 }
            i = i + 1
        }
        self.line_files.push(path)
        return self.line_files.len()
    }

    // Attribute the code that follows to source position `line:col`.
    fun emit_loc(var self, line: int32, col: int32) {
        if self.cur_file == 0 || line <= 0 { return }
        let loc = format(".loc {} {} {}", self.cur_file, line, col)
        if loc != self.last_loc {
            self.emit(loc)
            self.last_loc = loc
        }
    }

    // Mark the code that follows as having no source line (line 0), so code
    // emitted after a function isn't attributed to it.
    fun end_loc(var self) {
        if self.cur_file != 0 { self.emit(format(".loc {} 0 0", self.cur_file)) }
        self.cur_file = 0
        self.last_loc = ""
    }

    // -- emit helpers -----------------------------------------------------

    // Append a generated instruction (tab-indented) or a label (flush-left).
    fun emit(var self, line: str) {
        if self.pend_store != "" { self.flush_temp() }
        if line == "" {
            self.text.push("")
        } else if ends_colon(line) {
            self.text.push(line)
        } else {
            // a register's re-extension that this instruction makes moot
            // (MYLA-251)
            let n = self.text.len()
            if self.ext_at >= 0 && self.ext_at == n - 1 && extension_overwritten(self.text[n - 1], line) { let gone = self.text.pop() }
            self.ext_at = -1
            if line.len() > 10 && line[4] == 'l' as uint8 && line[3] == 's' as uint8 && text_at(line, 0, "movslq %") { self.ext_at = self.text.len() }
            self.text.push("\t" + line)
        }
    }

    // Append a pre-formatted runtime-prelude line verbatim.
    fun raw(var self, line: str) {
        if self.pend_store != "" { self.flush_temp() }
        self.text.push(line)
    }

    // Emit the held-back store of a temporary (see `store_temp`). A value
    // loaded into %rax for a temporary that lives in a register is loaded
    // straight into it instead (MYLA-125); `flush_temp_in_rax` keeps it in
    // %rax as well, for a reader that takes it from there.
    fun flush_temp(var self) {
        let n = self.text.len()
        if n > 0 && is_reg_move(self.pend_store) {
            let folded = fold_load(self.text[n - 1], reg_of_move(self.pend_store))
            if folded != "" {
                self.text[n - 1] = folded
                self.pend_store = ""
                self.pend_temp = -1
                return
            }
        }
        self.flush_temp_in_rax()
    }

    fun flush_temp_in_rax(var self) {
        self.text.push("\t" + self.pend_store)
        self.pend_store = ""
        self.pend_temp = -1
    }

    #test(codegen_on("[int]"))[".L1"]
    fun label(var self) -> str {
        self.label_n = self.label_n + 1
        return format(".L{}", self.label_n)
    }

    #test(codegen_on("[int]"), "héλ")[-1]
    fun str_index(self, text: str) -> int32 {
        return match self.str_ix.get(text) {
            Some(i) => i
            None => -1
        }
    }

    // Intern a string literal, emitting a static `str` cell (MYLA-18).
    #test(codegen_on("[int]"), "héλ")[".Lstr0"]
    fun string_label(var self, text: str) -> str {
        let existing = self.str_index(text)
        if existing >= 0 { return self.str_labels[existing] }
        let lab = format(".Lstr{}", self.str_n)
        self.str_n = self.str_n + 1
        self.str_ix[text] = self.str_texts.len()
        self.str_texts.push(text)
        self.str_labels.push(lab)
        for line in static_str(lab, text) { self.strdata.push(line) }
        return lab
    }

    // -- lookups ----------------------------------------------------------

    fun sig_of(self, name: str) -> FuncSig {
        return match self.func_ix.get(name) {
            Some(i) => self.funcs[i]
            None => self.funcs[0]
        }
    }

    #test(codegen_on("[int]"), "add")[false]
    fun has_func(self, name: str) -> bool {
        return self.func_ix.contains(name)
    }

    // -- owned parameters (MYLA-127, D86) ----------------------------------

    // Which parameters of each function with a body its body keeps as a
    // whole value, worked out once before any function is lowered.
    // A parameter is passed owned where that pays: the body keeps it, and
    // the calls give it a new value (a call's result, a concatenation, a
    // list or map literal: an owned temporary, handed over; or a variable
    // passed right in a `return`, its last use, which moves it) more often
    // than another variable's (retained for it). One walk over every body
    // (`scan_*`) finds the names each keeps and the calls' arguments. A
    // parameter a `become` hands a heap value over to is owned (nothing
    // would keep the value alive); one a `become` passes on to a function
    // value isn't (the function value only borrows it; D87).
    fun find_kept_params(var self) {
        for sig in self.funcs {
            if !sig.has_decl { continue }
            self.scan_kept = []
            match sig.decl.body {
                Some(b) => { self.scan_block(b) },
                None => {},
            }
            var flags: [bool] = []
            var any = false
            for p in sig.decl.params {
                let k = p.name != "self" && list_has_str(self.scan_kept, p.name)
                flags.push(k)
                if k { any = true }
            }
            self.kept_params[sig.name] = flags
            if any { self.keeping[method_part(sig.name)] = true }
        }
        // the arguments passed to the functions that keep one, counted by
        // the name a call uses (methods of one name on different types vote
        // together: no receiver's type to look up)
        var score: [str: [int32]] = [:]
        for u in self.scan_args {
            if !self.keeping.contains(u.callee) { continue }
            var first = 0
            if u.recv >= 0 { first = 1 }
            var ss = match score.get(u.callee) {
                Some(xs) => xs,
                None => {
                    var zeros: [int32] = []
                    zeros
                },
            }
            while ss.len() < first + u.fresh.len() { ss.push(0) }
            var i = 0
            while i < u.fresh.len() {
                if u.fresh[i] { ss[first + i] = ss[first + i] + 1 } else { ss[first + i] = ss[first + i] - 1 }
                i = i + 1
            }
            score[u.callee] = ss
        }
        self.scan_args = []
        for sig in self.funcs {
            if !sig.has_decl { continue }
            let kept = match self.kept_params.get(sig.name) {
                Some(fl) => fl,
                None => {
                    var no: [bool] = []
                    no
                },
            }
            let ss = match score.get(method_part(sig.name)) {
                Some(xs) => xs,
                None => {
                    var zeros: [int32] = []
                    zeros
                },
            }
            let handed = int_list(self.handed.get(sig.name))
            let passed = int_list(self.passed_on.get(sig.name))
            var flags: [bool] = []
            var any = false
            var i = 0
            while i < kept.len() {
                let k = ((kept[i] && i < ss.len() && ss[i] > 0) || contains_int(handed, i)) && !contains_int(passed, i)
                flags.push(k)
                if k { any = true }
                i = i + 1
            }
            self.kept_params[sig.name] = flags
            if any { self.owning[sig.name] = true }
        }
    }

    fun scan_block(var self, b: Block) {
        for st in b.stmts { self.scan_stmt(st) }
    }

    fun scan_stmt(var self, st: Stmt) {
        match st.kind {
            StmtKind.ExprStmt(e) => { self.scan_expr(e, false) },
            StmtKind.VarDecl(k, n, ty, init) => {
                if k == "var" { self.keep_name(init) }
                self.scan_expr(init, false)
            },
            StmtKind.DestructDecl(k, bs, ty, init) => { self.scan_expr(init, false) },
            StmtKind.Assign(target, value) => {
                self.keep_name(value)
                self.scan_expr(target, false)
                self.scan_expr(value, false)
            },
            StmtKind.ReturnS(ov, tail) => {
                match ov {
                    Some(e) => {
                        self.keep_name(e)
                        self.scan_expr(e, true)
                    },
                    None => {},
                }
            },
            StmtKind.IfS(c, then, otherwise) => {
                self.scan_expr(c, false)
                self.scan_block(then)
                match otherwise {
                    Some(ElseTail.ElseBlock(eb)) => { self.scan_block(eb) },
                    Some(ElseTail.ElseIf(es)) => { self.scan_stmt(es) },
                    None => {},
                }
            },
            StmtKind.WhileS(c, body) => {
                self.scan_expr(c, false)
                self.scan_block(body)
            },
            StmtKind.ForS(v, start, end, body, iter) => {
                match start { Some(e) => { self.scan_expr(e, false) }, None => {} }
                match end { Some(e) => { self.scan_expr(e, false) }, None => {} }
                match iter { Some(e) => { self.scan_expr(e, false) }, None => {} }
                self.scan_block(body)
            },
            StmtKind.DeferS(body) => { self.scan_block(body) },
            _ => {},
        }
    }

    // `scan_kept` gets the name `e` is, when it is a variable.
    fun keep_name(var self, e: Expr) {
        match e.kind {
            ExprKind.Name(n) => { self.scan_kept.push(n) },
            _ => {},
        }
    }

    // The expression's kept names and call arguments; `in_return`: it is
    // returned, so a variable a call in it passes is its last use.
    fun scan_expr(var self, e: Expr, in_return: bool) {
        match e.kind {
            ExprKind.Call(callee, args, _) => {
                // a constructor's payload, or the value `push` appends, is
                // kept; the call's arguments are counted
                var stores = false
                var callee_name = ""
                var recv = -1
                match callee.kind {
                    ExprKind.Name(f) => {
                        stores = f == "push" || f == "Some" || f == "Ok" || f == "Err"
                        callee_name = f
                    },
                    ExprKind.GetField(t, f) => {
                        let enum_ctor = match t.kind {
                            ExprKind.Name(q) => self.is_enum_name(q),
                            _ => false,
                        }
                        // (a type's function without `self` has no receiver, D172)
                        let on_type = self.static_calls.contains(e.id)
                        if enum_ctor && !on_type { stores = true } else {
                            callee_name = f
                            if !on_type { recv = t.id }
                        }
                    },
                    _ => {},
                }
                var fresh: [bool] = []
                for a in args {
                    if stores { self.keep_name(a) }
                    if callee_name != "" { fresh.push(is_new_value(a) || (in_return && is_name_expr(a))) }
                    self.scan_expr(a, false)
                }
                if callee_name != "" { self.scan_args.push(ScanArg { callee: callee_name, recv: recv, fresh: fresh }) }
                self.scan_expr(callee, false)
            },
            ExprKind.Unary(op, x) => { self.scan_expr(x, false) },
            ExprKind.Await(x) => { self.scan_expr(x, false) },
            ExprKind.Binary(op, l, r) => {
                self.scan_expr(l, false)
                self.scan_expr(r, false)
            },
            ExprKind.GetField(t, f) => { self.scan_expr(t, false) },
            ExprKind.StructLit(n, fields) => {
                for fi in fields {
                    self.keep_name(fi.value)
                    self.scan_expr(fi.value, false)
                }
            },
            ExprKind.TupleLit(es) => {
                for x in es {
                    self.keep_name(x)
                    self.scan_expr(x, false)
                }
            },
            ExprKind.ListLit(es) => {
                for x in es {
                    self.keep_name(x)
                    self.scan_expr(x, false)
                }
            },
            ExprKind.MapLit(entries) => {
                for en in entries {
                    self.keep_name(en.key)
                    self.keep_name(en.value)
                    self.scan_expr(en.key, false)
                    self.scan_expr(en.value, false)
                }
            },
            ExprKind.TupleIndex(t, i) => { self.scan_expr(t, false) },
            ExprKind.Index(t, i) => {
                self.scan_expr(t, false)
                self.scan_expr(i, false)
            },
            ExprKind.MatchE(sc, arms) => {
                self.scan_expr(sc, false)
                for arm in arms {
                    match arm.guard { Some(g) => { self.scan_expr(g, false) }, None => {} }
                    match arm.body {
                        ExprOrBlock.EB_Expr(x) => { self.scan_expr(x, false) },
                        ExprOrBlock.EB_Block(blk) => { self.scan_block(blk) },
                    }
                }
            },
            ExprKind.Try(x) => { self.scan_expr(x, false) },
            ExprKind.Cast(x, ty) => { self.scan_expr(x, false) },
            // a lambda captures what it reads
            ExprKind.Lambda(ps, rt, body, asy) => {
                let names = match body {
                    ExprOrBlock.EB_Expr(x) => names_in_expr(x, []),
                    ExprOrBlock.EB_Block(blk) => names_in_block(blk, []),
                }
                for n in names { self.scan_kept.push(n) }
            },
            _ => {},
        }
    }

    // Whether the function `sig`'s parameter `i`, of type `t` (its type
    // arguments substituted), is passed owned: its body keeps it, and it is
    // a scalar that owns heap memory (a string, list, map or builder).
    fun owned_param(self, sig: FuncSig, i: int32, t: Type) -> bool {
        if is_aggregate(t) || !self.owns_heap(t) || recv_by_address(sig, i, t) { return false }
        return match self.kept_params.get(sig.name) {
            Some(flags) => i < flags.len() && flags[i],
            None => false,
        }
    }

    // Whether the function `sig`'s parameter `i`, of type `t`, is passed by
    // value: a struct, tuple or enum a `become` hands over to it (D88), its
    // words in the argument words.
    fun byval_param(self, sig: FuncSig, i: int32, t: Type) -> bool {
        return self.handed.len() > 0 && is_aggregate(t) && contains_int(int_list(self.handed.get(sig.name)), i)
    }

    // Whether `myla_<key>.eq` is the routine `emit_derived_eq` writes for a
    // `#derive(Eq)` struct or enum (called with both operands' addresses).
    #test(codegen_on("enum E { A, B(int) }"), "a")[false]
    fun derived_eq_routine(self, key: str) -> bool {
        for d in self.decls {
            match d.kind {
                DeclKind.StructDecl(name, fields, attrs, tps, isp, act) => { if name == key { return tps.len() == 0 && attrs_have_derive_eq(attrs) } },
                DeclKind.EnumDecl(name, variants, attrs, tps, isp) => { if name == key { return tps.len() == 0 && attrs_have_derive_eq(attrs) } },
                _ => {},
            }
        }
        return false
    }

    // Whether the struct or enum `key` derives `Hash` (D163): a map key of it
    // is hashed by its members, not through its `hash` (MYLA-313).
    #test(codegen_on("#derive(Eq, Hash)\nstruct P { x: int }"), "P")[true]
    #test(codegen_on("struct P { x: int }"), "P")[false]
    fun derives_hash(self, key: str) -> bool {
        for d in self.decls {
            match d.kind {
                DeclKind.StructDecl(name, fields, attrs, tps, isp, act) => { if name == key { return attrs_derive(attrs, "Hash") } },
                DeclKind.EnumDecl(name, variants, attrs, tps, isp) => { if name == key { return attrs_derive(attrs, "Hash") } },
                _ => {},
            }
        }
        return false
    }

    // Whether `==` on `t` compares tags only: an enum without payloads whose
    // `eq` is derived (MYLA-133; `find_tag_enums`).
    #test(codegen_on("[int]"), Type.TEnum("Color", []))[false]
    fun tag_only_eq(self, t: Type) -> bool {
        return match t {
            Type.TEnum(n, a) => self.tag_enums.contains(n),
            _ => false,
        }
    }

    fun find_tag_enums(var self) {
        for d in self.decls {
            match d.kind {
                DeclKind.EnumDecl(name, variants, attrs, tps, isp) => {
                    if tps.len() == 0 && attrs_have_derive_eq(attrs) {
                        var payloads = false
                        for v in self.enum_info(name).variants {
                            if v.payload.len() > 0 { payloads = true }
                        }
                        if !payloads { self.tag_enums[name] = true }
                    }
                },
                _ => {},
            }
        }
    }

    // Whether some parameter of `sig` is passed by value (most have none).
    fun has_byval(self, sig: FuncSig) -> bool {
        return self.handed.len() > 0 && self.handed.contains(sig.name)
    }

    // The bytes of argument words a value of type `t` takes by value.
    #test(codegen_on("enum E { A, B(int) }"), Type.TBool)[8]
    fun word_size(self, t: Type) -> int32 {
        let size = (self.size(t) + 7) / 8 * 8
        if size < 8 { return 8 }
        return size
    }

    // `owned_param` for each of the parameters `params` of `sig`; none for a
    // function without owned parameters (most).
    fun owned_params(self, sig: FuncSig, params: [Type]) -> [bool] {
        if !self.owning.contains(sig.name) { return self.no_owned }
        var out: [bool] = []
        let flags = match self.kept_params.get(sig.name) {
            Some(fl) => fl,
            None => {
                var no: [bool] = []
                no
            },
        }
        var i = 0
        while i < params.len() {
            out.push(i < flags.len() && flags[i] && !is_aggregate(params[i]) && self.owns_heap(params[i]) && !recv_by_address(sig, i, params[i]))
            i = i + 1
        }
        return out
    }

    // The method-table key for a receiver type (mirrors Checker.type_key).
    #test(codegen_on("[int]"), Type.TInt(32, true))["int32"]
    fun type_key(self, t: Type) -> str {
        return match t {
            Type.TStruct(n, a) => n,
            Type.TActor(n, a) => n,
            Type.TEnum(n, a) => n,
            Type.TInt(w, s) => int_type_name_cg(w, s),
            Type.TBool => "bool",
            Type.TStr => "str",
            Type.TSB => "StringBuilder",
            Type.TChar => "char",
            // as the checker keys them (MYLA-221)
            Type.TFloat(w) => format("float{}", w),
            Type.TList(e) => "__list",
            Type.TMap(k, v) => "__map",
            _ => "",
        }
    }

    // The resolved type of a node, with the active generic substitution applied
    // (identity outside a specialized generic body).
    #test(codegen_on("[int]"), 23)[Type.TInt(32, true)]
    fun type_of(self, id: int32) -> Type {
        match self.resolved.get(id) { Some(t) => { return subst_type(t, self.subst) }, None => {} }
        return Type.TInt(32, true)
    }

    // -- type layout ------------------------------------------------------

    fun struct_info(self, name: str) -> StructInfo {
        return match self.struct_ix.get(name) {
            Some(i) => self.structs[i]
            None => self.structs[0]
        }
    }

    fun enum_info(self, name: str) -> EnumInfo {
        return match self.enum_ix.get(name) {
            Some(i) => self.enums[i]
            None => self.enums[0]
        }
    }

    #test(codegen_on("[int]"), Type.TStr)[false]
    fun is_boxed(self, t: Type) -> bool {
        return match t {
            Type.TEnum(n, a) => list_has_str(self.recursive_enums, n),
            _ => false,
        }
    }

    // The size of an element of a list of `t`s: a scalar at its natural
    // size (D120, MYLA-247: a `bool` 1 byte, an integer or float its width,
    // a `char` 4), anything else as stored in an aggregate.
    #test(codegen_on("[int]"), Type.TBool)[1]
    #test(codegen_on("[int]"), Type.TInt(16, true))[2]
    #test(codegen_on("[int]"), Type.TChar)[4]
    #test(codegen_on("[int]"), Type.TStr)[8]
    fun elem_size(self, t: Type) -> int32 {
        return match t {
            Type.TBool => 1,
            Type.TInt(w, sg) => w / 8,
            Type.TChar => 4,
            Type.TFloat(w) => w / 8,
            _ => self.stored_size(t),
        }
    }

    #test(codegen_on("[int]"), Type.TStr)[8]
    fun stored_size(self, t: Type) -> int32 {
        if self.is_boxed(t) { return 8 }
        return self.size(t)
    }

    // -- reference-counting predicates / naming ---------------------------

    // True if an inline value of `t` (transitively) holds a refcounted heap
    // pointer (a boxed enum, list, map, builder, or closure env), i.e. it
    // participates in reference counting and must be retained/dropped on
    // copy/release. Strings and scalars are immortal arena blobs.
    #test(codegen_on("[int]"), Type.TStr)[true]
    fun owns_heap(self, t: Type) -> bool {
        return self.owns_heap_seen(t, [])
    }

    #test(codegen_on("[int]"), Type.TStr, [])[true]
    fun owns_heap_seen(self, t: Type, seen: [str]) -> bool {
        if self.is_boxed(t) { return true }
        match t {
            Type.TList(e) => { return true },
            Type.TMap(k, v) => { return true },
            Type.TSB => { return true },
            Type.TStr => { return true },
            Type.TFunc(ps, r) => { return true },
            Type.TAsync(f) => { return true },
            Type.TActor(n, a) => { return true },
            Type.TStruct(n, a) => {
                if list_has_str(seen, n) { return false }
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                for f in info.fields {
                    if self.owns_heap_seen(subst_type(f.ty, sub), push_str_copy(seen, n)) { return true }
                }
                return false
            },
            Type.TEnum(n, a) => {
                if list_has_str(seen, n) { return false }
                let info = self.enum_info(n)
                let sub = self.type_subst(info.type_params, a)
                for v in info.variants {
                    for ft in v.payload {
                        if self.owns_heap_seen(subst_type(ft, sub), push_str_copy(seen, n)) { return true }
                    }
                }
                return false
            },
            Type.TTuple(es) => {
                for e in es {
                    if self.owns_heap_seen(e, seen) { return true }
                }
                return false
            },
            _ => {},
        }
        return false
    }

    // The drop routine for a heap-pointer leaf of type `t`.
    #test(codegen_on("[int]"), Type.TStr)["__str_drop"]
    fun drop_call_name(self, t: Type) -> str {
        return match t {
            Type.TList(e) => "__drop_list_" + mono_token(e),
            Type.TMap(k, v) => "__drop_map_" + map_token(k, v),
            Type.TSB => "__sb_drop",
            Type.TStr => "__str_drop",
            _ => "__dropb_" + mono_token(t),
        }
    }

    // Retain a heap-pointer leaf at `off(base)`: bump its refcount (closures use
    // the null-safe env helper). Sharing is shallow — children are untouched.
    fun inc_box(var self, ptr_off: int32, base: str, t: Type) {
        if is_tfunc(t) {
            self.emit(format("movq {}(%{}), %rdi", ptr_off, base))
            self.emit("call __func_retain")
            return
        }
        self.emit(format("movq {}(%{}), %rax", ptr_off, base))
        // an actor handle may be shared between threads (D92)
        if self.frames && is_actor_t(t) { self.emit("lock incq -8(%rax)") } else { self.emit("incq -8(%rax)") }
    }

    // Release a heap-pointer leaf at `off(base)` via its type-specific routine.
    fun drop_box(var self, ptr_off: int32, base: str, t: Type) {
        if is_tfunc(t) {
            self.emit(format("movq {}(%{}), %rdi", ptr_off, base))
            self.emit("call __func_drop")
            return
        }
        self.register_drop(t)
        self.emit(format("movq {}(%{}), %rdi", ptr_off, base))
        self.emit("call " + self.drop_call_name(t))
    }

    // Record that `t`'s per-type drop routine must be emitted (a list/map/boxed
    // enum). Builders share one routine; deduped by mangled token.
    fun register_drop(var self, t: Type) {
        if is_sb_t(t) {
            self.need_sb = true
            return
        }
        if is_str_t(t) { return }                // `__str_drop` is always there
        let key = "drop" + mono_token(t)
        if self.helper_seen.contains(key) { return }
        self.helper_seen[key] = true
        self.need_drop.push(t)
    }

    // Whether the list or map type `t` holds nothing that owns heap values
    // (its clone and drop are the builder's, MYLA-162).
    fun holds_nothing(self, t: Type) -> bool {
        return match t {
            Type.TList(e) => !self.owns_heap(e) && !self.is_boxed(e),
            Type.TMap(k, v) => !self.owns_heap(k) && !self.owns_heap(v) && !self.is_boxed(v),
            _ => false,
        }
    }

    // Record that `t`'s copy-on-write clone routine must be emitted.
    fun register_clone(var self, t: Type) {
        if is_sb_t(t) {
            self.need_sb = true
            return
        }
        let key = "clone" + mono_token(t)
        if self.helper_seen.contains(key) { return }
        self.helper_seen[key] = true
        self.need_clone.push(t)
    }

    // The clone routine for a list/map/builder cow site.
    #test(codegen_on("[int]"), Type.TSB)["__sb_clone"]
    fun clone_call_name(self, t: Type) -> str {
        return match t {
            Type.TList(e) => "__clone_list_" + mono_token(e),
            Type.TMap(k, v) => "__clone_map_" + map_token(k, v),
            Type.TSB => "__sb_clone",
            _ => "__sb_clone",
        }
    }

    #test(codegen_on("[int]"), VariantT { name: "Nil", payload: [] }, [])[false]
    fun variant_owns(self, v: VariantT, sub: [Subst]) -> bool {
        for ft0 in v.payload {
            let ft = subst_type(ft0, sub)
            if self.is_boxed(ft) || self.owns_heap(ft) { return true }
        }
        return false
    }

    // Walk the heap-pointer leaves an inline value of `t` at `off(base)` directly
    // owns, retaining (incq) or releasing (drop) each. Inline sub-aggregates
    // recurse; boxed/list/map/builder members are leaves the action follows.
    // An enum, or a struct or tuple with more than one member to walk, is
    // walked by a helper of its own, called with the value's address in %rdi
    // (MYLA-108: inlined at every drop, these walks were a third of the
    // compiler's code).
    fun owned_walk(var self, base: str, off: int32, t: Type, retain: bool) {
        if self.walk_helper(t) {
            let name = self.register_walk(t, retain)
            self.emit(format("leaq {}(%{}), %rdi", off, base))
            self.emit("call " + name)
            return
        }
        self.owned_walk_inline(base, off, t, retain)
    }

    // Whether `t`'s walk goes through a helper: an enum, or a struct or tuple
    // with more than one member owning heap values.
    #test(codegen_on("[int]"), Type.TEnum("List", []))[true]
    fun walk_helper(self, t: Type) -> bool {
        var members: [Type] = []
        match t {
            Type.TEnum(n, a) => { return true },
            Type.TStruct(n, a) => {
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                for f in info.fields { members.push(subst_type(f.ty, sub)) }
            },
            Type.TTuple(es) => { members = es },
            _ => {},
        }
        var owning = 0
        for m in members {
            if self.is_boxed(m) || self.owns_heap(m) { owning = owning + 1 }
        }
        return owning > 1
    }

    // The name of `t`'s retain or release walk helper, to be emitted.
    #test(codegen_on("[int]"), Type.TEnum("List", []), true)["__walkr_List"]
    fun register_walk(var self, t: Type, retain: bool) -> str {
        let tok = mono_token(t)
        var name = "__walkd_" + tok
        if retain { name = "__walkr_" + tok }
        if self.helper_seen.contains(name) { return name }
        self.helper_seen[name] = true
        self.need_walk.push(t)
        self.walk_retain.push(retain)
        return name
    }

    // `owned_walk` itself, emitted here.
    fun owned_walk_inline(var self, base: str, off: int32, t: Type, retain: bool) {
        match t {
            Type.TStruct(n, a) => {
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                var cur = off
                for f in info.fields {
                    let ft = subst_type(f.ty, sub)
                    self.walk_member(base, cur, ft, retain)
                    cur = cur + self.stored_size(ft)
                }
            },
            Type.TTuple(es) => {
                var cur = off
                for et in es {
                    self.walk_member(base, cur, et, retain)
                    cur = cur + self.stored_size(et)
                }
            },
            Type.TEnum(n, a) => {
                let info = self.enum_info(n)
                let sub = self.type_subst(info.type_params, a)
                let done = self.label()
                self.emit(format("movq {}(%{}), %rax", off, base))
                var idx = 0
                for v in info.variants {
                    if self.variant_owns(v, sub) {
                        let nxt = self.label()
                        self.emit(format("cmpq ${}, %rax", idx))
                        self.emit(format("jne {}", nxt))
                        var cur = off + 8
                        for ft0 in v.payload {
                            let ft = subst_type(ft0, sub)
                            self.walk_member(base, cur, ft, retain)
                            cur = cur + self.stored_size(ft)
                        }
                        self.emit(format("jmp {}", done))
                        self.emit(format("{}:", nxt))
                    }
                    idx = idx + 1
                }
                self.emit(format("{}:", done))
            },
            _ => {},
        }
    }

    // Apply the retain/drop action to a single member of type `ft` at `off(base)`:
    // heap-pointer leaves trigger the action directly; inline aggregates recurse.
    fun walk_member(var self, base: str, off: int32, ft: Type, retain: bool) {
        if self.is_boxed(ft) || is_cell_t(ft) {
            if retain { self.inc_box(off, base, ft) } else { self.drop_box(off, base, ft) }
        } else if is_tfunc(ft) {
            if retain { self.inc_box(off + 8, base, ft) } else { self.drop_box(off + 8, base, ft) }
        } else if self.owns_heap(ft) {
            self.owned_walk(base, off, ft, retain)
        }
    }

    // Retain every heap reference an inline value of `t` at `off(base)` brings in
    // (the slot becomes a new co-owner).
    fun retain(var self, base: str, off: int32, t: Type) {
        if is_cell_t(t) { self.inc_box(off, base, t) }
        else if is_tfunc(t) { self.inc_box(off + 8, base, t) }
        else if self.owns_heap(t) { self.owned_walk(base, off, t, true) }
    }

    // A struct/enum is laid out per its concrete type arguments: generic type
    // parameters are substituted so a generic container instantiated with an
    // inline aggregate (e.g. `Option<TypeExpr>`) reserves the real payload size,
    // not a single 8-byte slot. Mirrors the oracle's monomorphized layout.
    #test(codegen_on("[int]"), [], [])[[]]
    fun type_subst(self, type_params: [str], args: [Type]) -> [Subst] {
        var sub: [Subst] = []
        var i = 0
        while i < type_params.len() && i < args.len() {
            sub.push(Subst { name: type_params[i], ty: args[i] })
            i = i + 1
        }
        return sub
    }

    #test(codegen_on("[int]"), Type.TStr)[8]
    fun size(self, t: Type) -> int32 {
        return match t {
            Type.TStruct(n, a) => self.struct_size(n, a),
            Type.TTuple(es) => self.tuple_size(es),
            Type.TEnum(n, a) => 8 + self.enum_payload_size(n, a),
            Type.TFunc(ps, r) => 16,
            Type.TAsync(f) => 16,
            _ => 8,
        }
    }

    #test(codegen_on("struct P { x: int, y: int }"), "Name", [])[16]
    fun struct_size(self, name: str, args: [Type]) -> int32 {
        let info = self.struct_info(name)
        let sub = self.type_subst(info.type_params, args)
        var total = 0
        for f in info.fields { total = total + self.stored_size(subst_type(f.ty, sub)) }
        return total
    }

    #test(codegen_on("[int]"), [Type.TInt(32, true)])[8]
    fun tuple_size(self, es: [Type]) -> int32 {
        var total = 0
        for e in es { total = total + self.stored_size(e) }
        return total
    }

    #test(codegen_on("enum E { A, B(int) }"), "Color", [])[8]
    fun enum_payload_size(self, name: str, args: [Type]) -> int32 {
        let info = self.enum_info(name)
        let sub = self.type_subst(info.type_params, args)
        var maxp = 0
        for v in info.variants {
            var s = 0
            for ft in v.payload { s = s + self.stored_size(subst_type(ft, sub)) }
            if s > maxp { maxp = s }
        }
        return maxp
    }

    #test(codegen_on("struct P { x: int, y: int }"), Type.TStruct("Point", []), "x")[0]
    fun field_offset(self, st: Type, field: str) -> int32 {
        let name = struct_name_of(st)
        let info = self.struct_info(name)
        let sub = self.type_subst(info.type_params, type_args_of(st))
        var off = 0
        for f in info.fields {
            if f.name == field { return off }
            off = off + self.stored_size(subst_type(f.ty, sub))
        }
        return off
    }

    #test(codegen_on("[int]"), Type.TTuple([Type.TInt(32, true)]), 0)[0]
    fun elem_offset(self, t: Type, index: int32) -> int32 {
        var off = 0
        var i = 0
        for e in tuple_elems(t) {
            if i == index { return off }
            off = off + self.stored_size(e)
            i = i + 1
        }
        return off
    }

    // -- enum layout ------------------------------------------------------

    #test(codegen_on("enum E { A, B(int) }"), "Color", "Red")[0]
    fun variant_tag(self, enum_name: str, variant: str) -> int32 {
        var i = 0
        for v in self.enum_info(enum_name).variants {
            if v.name == variant { return i }
            i = i + 1
        }
        return 0
    }

    // Declared payload types of `variant` (generic type parameters unsubstituted).
    #test(codegen_on("enum E { A, B(int) }"), "List", "Cons")[[]]
    fun variant_payload_decl(self, enum_name: str, variant: str) -> [Type] {
        for v in self.enum_info(enum_name).variants {
            if v.name == variant { return v.payload }
        }
        return []
    }

    // Payload types of `variant` with the enum value `et`'s concrete type
    // arguments substituted in (so payloads carrying a type parameter resolve to
    // their instantiated type, matching this value's layout).
    #test(codegen_on("enum E { A, B(int) }"), Type.TEnum("Shape", []), "Rect")[[]]
    fun variant_payload(self, et: Type, variant: str) -> [Type] {
        let name = enum_name_of(et)
        let info = self.enum_info(name)
        let sub = self.type_subst(info.type_params, type_args_of(et))
        var out: [Type] = []
        for ft in self.variant_payload_decl(name, variant) { out.push(subst_type(ft, sub)) }
        return out
    }

    #test(codegen_on("enum E { A, B(int) }"), Type.TEnum("Shape", []), "Rect", 0)[8]
    fun variant_field_offset(self, et: Type, variant: str, index: int32) -> int32 {
        var off = 8
        let payload = self.variant_payload(et, variant)
        var i = 0
        while i < index {
            off = off + self.stored_size(payload[i])
            i = i + 1
        }
        return off
    }

    #test(codegen_on("[int]"), "a")[false]
    fun is_enum_name(self, n: str) -> bool {
        return self.enum_names.contains(n)
    }

    #test(codegen_on("[int]"), "a")[false]
    fun is_nullary_variant(self, n: str) -> bool {
        return self.nullary_names.contains(n)
    }

    #test(codegen_on("[int]"), "Ok")[false]
    fun is_variant_name(self, n: str) -> bool {
        return self.variant_names.contains(n)
    }

    #test(codegen_on("[int]"), "push")[false]
    fun has_function(self, n: str) -> bool {
        return self.func_ix.contains(n)
    }

    // Whether the checker typed `callee` as a value, which it does only for an
    // indirect call: a local binding shadows a function of the same name
    // (MYLA-102), so `f(x)` with a local `f` calls the local.
    #test(codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[false]
    fun called_as_value(self, callee: Expr) -> bool {
        return self.resolved.contains(callee.id)
    }

    // Classify an expression as an enum constructor (if it is one).
    #test(codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[CtorInfo { ok: false, enum_name: "", variant: "", args: [] }]
    fun ctor_info(self, e: Expr) -> CtorInfo {
        let enm = enum_name_of(self.type_of(e.id))
        match e.kind {
            ExprKind.GetField(tgt, field) => {
                let tn = expr_name(tgt)
                if tn != "" && self.is_enum_name(tn) {
                    return CtorInfo { ok: true, enum_name: enm, variant: field, args: [] }
                }
            },
            ExprKind.Name(n) => {
                if self.is_nullary_variant(n) && enm != "" {
                    return CtorInfo { ok: true, enum_name: enm, variant: n, args: [] }
                }
            },
            ExprKind.Call(callee, args, _) => {
                let qn = expr_name(callee_target(callee))
                let cfield = getfield_name(callee)
                // (an enum's function without `self` isn't a variant, D172)
                if cfield != "" && qn != "" && self.is_enum_name(qn) && !self.static_calls.contains(e.id) {
                    return CtorInfo { ok: true, enum_name: enm, variant: cfield, args: args }
                }
                let un = expr_name(callee)
                if un != "" && !self.has_function(un) && self.is_variant_name(un) && enm != "" {
                    return CtorInfo { ok: true, enum_name: enm, variant: un, args: args }
                }
            },
            _ => {},
        }
        return CtorInfo { ok: false, enum_name: "", variant: "", args: [] }
    }

    // -- top-level --------------------------------------------------------

    // std.rt's allocator functions, without tasks or with them.
    fun rt_alloc_names(self) -> (str, str) {
        if self.frames { return ("std$rt$alloc_tasks", "std$rt$free_tasks") }
        return ("std$rt$alloc", "std$rt$free")
    }

    // The runtime routines std.rt has that the code generator calls by name
    // (MYLA-162): a list's growth, and with tasks the executor's; each the
    // name the rest of the runtime calls and the function standing for it.
    fun rt_exec(self) -> [(str, str)] {
        // every program's (`__map_lookup`: `remove`'s too)
        var out = [("__panic_report", "std$rt$panic_report"), ("__list_grow", "std$rt$list_grow"), ("__sb_append_bytes", "std$rt$sb_append_bytes"), ("__map_new", "std$rt$map_new"), ("__map_lookup", "std$rt$map_lookup"), ("__equal_bytes", "std$rt$equal_bytes"), ("__func_retain", "std$rt$func_retain"), ("__func_drop", "std$rt$func_drop")]
        if self.frames {
            for p in [("__sched_init", "std$rt$sched_init"), ("__workers_count", "std$rt$workers_count"), ("__task_cancel", "std$rt$task_cancel"), ("__task_cancelled", "std$rt$task_cancelled"), ("__failed_wait", "std$rt$failed_wait"), ("__wait_stopped", "std$rt$wait_stopped"), ("__exec_push", "std$rt$exec_push"), ("__exec_yield_push", "std$rt$exec_yield_push"), ("__exec_find", "std$rt$exec_find"), ("__exec_peek", "std$rt$exec_peek"), ("__wake_waiters", "std$rt$wake_waiters"), ("__actor_leave", "std$rt$actor_leave"), ("__task_wait", "std$rt$task_wait"), ("__actor_enter_rt", "std$rt$actor_enter"), ("__exec_loop", "std$rt$exec_run"), ("__deep_str", "std$rt$deep_str"), ("__dclone_str", "std$rt$dclone_str"), ("__dclone_cell", "std$rt$dclone_cell"), ("__deep_env", "std$rt$deep_env"), ("__dclone_env", "std$rt$dclone_env"), ("__panic_report_tasks", "std$rt$panic_report_tasks"), ("myla___sleep", "std$rt$sleep_frame"), ("__cancel_after", "std$rt$cancel_after"), ("__task_end", "std$rt$task_end"), ("myla___wait_fd", "std$rt$wait_fd"), ("myla___wait_fd2", "std$rt$wait_fd2"), ("myla___wait_sock", "std$rt$wait_sock")] { out.push(p) }
        }
        return out
    }

    fun generate(var self) -> str {
        let en = self.entry_name()
        if self.wasm { self.emit_runtime_prelude_wasm(en) } else if self.a64 { self.emit_runtime_prelude_a64(en) } else { self.emit_runtime_prelude(en) }
        // Start from the entry point: every function is emitted once a function
        // emitted calls it, makes it a value or applies it partially (MYLA-108;
        // `take_ir`); generic ones stamped out per instance (D13).
        self.find_kept_params()
        self.find_tag_enums()
        let m = self.request_fn(en, [])
        let names = self.rt_alloc_names()
        let a = self.request_fn(names.0, [])
        let fr = self.request_fn(names.1, [])
        for p in self.rt_exec() {
            let r = self.request_fn(p.1, [])
        }
        // printing a float goes through `__print_str` (`print_and_drop_str`)
        let ps = self.request_fn("std$rt$print_str", [])
        var draining = true
        while draining {
            while self.fn_worklist.len() > 0 || self.lam_jobs.len() > 0 || self.type_jobs.len() > 0 {
                if self.fn_worklist.len() > 0 {
                    let job = self.fn_worklist.pop()
                    self.subst = job.subst
                    self.gen_any_function(self.sig_of(job.orig).decl, job.mangled)
                    self.subst = []
                } else if self.type_jobs.len() > 0 {
                    // a routine that may call functions, which join the
                    // worklist (MYLA-313)
                    self.emit_type_job(self.type_jobs.pop())
                } else {
                    let lj = self.lam_jobs.pop()
                    if self.lam_seen.contains(lj.lifted) { continue }
                    self.lam_seen[lj.lifted] = true
                    self.gen_any_lambda(lj)
                }
            }
            // a float made text: std.rt's formatting, known only once the
            // functions are emitted (MYLA-162)
            draining = false
            if self.wants_ftoa && !self.fn_seen.contains("std$rt$float_to_str") {
                let ff = self.request_fn("std$rt$float_to_str", [])
                draining = true
            }
        }
        for pj in self.partial_jobs {
            self.emit_partial(pj)
        }
        for n in self.fnval_set {
            if self.wasm { self.emit_fnval_thunk_wasm(n) } else if self.a64 { self.emit_fnval_thunk_a64(n) } else { self.emit_fnval_thunk(n) }
        }
        self.emit_drop_helpers()
        if self.uses_float && !self.a64 && !self.wasm { self.raw(self.fmod_text()) }
        if self.fn_seen.contains("std$rt$float_to_str") { self.raw("\t.set __float_to_str, myla_std$rt$float_to_str") }
        // nothing to assemble for a refused program (MYLA-272)
        if self.refused.len() > 0 { return "" }
        if self.wasm { return self.wasm_module(self.assemble_source()) }
        return self.assemble_source()
    }

    // Register an instantiation (or non-generic function) and return its emitted
    // (mangled) name, enqueueing it for stamping the first time it is seen.
    #test(codegen_on("fun main() { print(1 + 2) }"), "add", [])["add"]
    fun request_fn(var self, orig: str, targs: [Type]) -> str {
        let sig = self.sig_of(orig)
        if sig.type_params.len() == 0 {
            if !self.fn_seen.contains(orig) {
                self.fn_seen[orig] = true
                self.fn_worklist.push(MonoFn { orig: orig, mangled: orig, subst: [] })
            }
            return orig
        }
        let mangled = mangle_fn(orig, targs)
        if !self.fn_seen.contains(mangled) {
            self.fn_seen[mangled] = true
            var sub: [Subst] = []
            var i = 0
            while i < sig.type_params.len() {
                sub.push(Subst { name: sig.type_params[i], ty: targs[i] })
                i = i + 1
            }
            self.fn_worklist.push(MonoFn { orig: orig, mangled: mangled, subst: sub })
        }
        return mangled
    }

    // Solve a generic callee's type arguments (in declaration order) by unifying
    // its declared parameter types against the concrete argument types, then
    // its result type against the type of the call `call_id`, which gives
    // those the checker took from the call's expected type (MYLA-315).
    fun solve_targs(self, sig: FuncSig, args: [Expr], call_id: int32, explicit: [TypeExpr]) -> [Type] {
        var sub: [Subst] = []
        // the explicit type arguments name the last type parameters, a
        // method's own (D169); the checker kept their types with their nodes
        let base = sig.type_params.len() - explicit.len()
        var k = 0
        while k < explicit.len() && base >= 0 {
            if self.has_type(explicit[k].id) { sub.push(Subst { name: sig.type_params[base + k], ty: self.type_of(explicit[k].id) }) }
            k += 1
        }
        // a function without `self` of a generic impl, `T.zero()` (D172):
        // the type it is called on gives the impl's type parameters
        match self.static_calls.get(call_id) {
            Some(st) => {
                match self.static_selfs.get(sig.name) {
                    Some(pat) => { for b in unify_into(pat, subst_type(st, self.subst)) { sub.push(b) } },
                    None => {},
                }
            },
            None => {},
        }
        var i = 0
        while i < sig.params.len() && i < args.len() {
            for b in unify_into(sig.params[i], self.type_of(args[i].id)) { sub.push(b) }
            i = i + 1
        }
        match sig.ret {
            Some(rt) => { if self.has_type(call_id) { for b in unify_into(rt, self.type_of(call_id)) { sub.push(b) } } },
            None => {},
        }
        // a type parameter only a bound names, `T` of `I: Iterator<T>`, by
        // `I`'s one impl of the trait (D55, D171), as the checker solved it
        for b in sig.bounds {
            match subst_get(sub, b.tp) {
                Some(t) => {
                    var j = 0
                    while j < b.traits.len() {
                        if b.args[j].len() > 0 {
                            match impl_trait_args(self.impl_args, self.type_key(t), b.traits[j], t) {
                                Some(have) => {
                                    var k = 0
                                    while k < have.len() && k < b.args[j].len() {
                                        for x in unify_into(b.args[j][k], have[k]) { sub.push(x) }
                                        k += 1
                                    }
                                },
                                None => {},
                            }
                        }
                        j += 1
                    }
                },
                None => {},
            }
        }
        var out: [Type] = []
        for tp in sig.type_params {
            match subst_get(sub, tp) { Some(t) => { out.push(t) }, None => { out.push(Type.TInt(32, true)) } }
        }
        return out
    }

    #test(codegen_on("[int]"))["main"]
    fun entry_name(self) -> str {
        for d in self.decls {
            match d.kind {
                DeclKind.FunDecl(fd) => {
                    for a in fd.attributes { if a.name == "main" { return fd.name } }
                },
                _ => {},
            }
        }
        return "main"
    }

    fun assemble_source(var self) -> str {
        var out: [str] = []
        out.push("\t.text")
        var fi = 0
        while fi < self.line_files.len() {
            out.push(format("\t.file {} \"{}\"", fi + 1, asm_string(self.line_files[fi])))
            fi = fi + 1
        }
        if self.line_files.len() > 0 { out.push(".Ltext0:") }     // the compile unit's code (MYLA-66)
        for line in self.text { out.push(line) }
        if self.line_files.len() > 0 { out.push(".Letext0:") }
        out.push("")
        out.push("\t.section .rodata")
        out.push(".Lbool_true:\n\t.ascii \"true\"")
        out.push(".Lbool_false:\n\t.ascii \"false\"")
        let messages = trap_messages()
        var ti = 0
        for label in trap_labels() {
            let text = messages[ti]
            out.push(format(".Lmsg{}:\n\t.quad {}\n\t.ascii \"{}\"", label, text.len(), text))
            ti = ti + 1
        }
        for line in self.posdata { out.push(line) }
        for line in self.rodata { out.push(line) }
        if self.uses_float { for chunk in self.float_rodata_text() { out.push(chunk) } }
        out.push("")
        // `str` values that live in the binary (literals, the renderers'
        // constants): cells with a count that never reaches zero (MYLA-18)
        out.push("\t.data")
        var statics = ["true", "false", "-"]
        var slabels = [".Lstr_true", ".Lstr_false", ".Lstr_minus"]
        if self.uses_float {
            for t in ["nan", "inf", "-inf", "0", "-0"] { statics.push(t) }
            for l in [".Lstr_nan", ".Lstr_inf", ".Lstr_ninf", ".Lstr_fzero", ".Lstr_fnzero"] { slabels.push(l) }
        }
        var si = 0
        while si < statics.len() {
            for line in static_str(slabels[si], statics[si]) { out.push(line) }
            si = si + 1
        }
        for line in self.strdata { out.push(line) }
        // each environment's routines, which its first word points at:
        // its drop function, its clone and its deep copy (with tasks, D92;
        // else 0), on every target (`env_record_of`, MYLA-263); one shared
        // by the environments owning nothing
        out.push("\t.balign 8")
        // (std.rt's functions by their own names: wasm has no aliases)
        out.push("__env_plain_routines:")
        out.push(format("\t.quad myla_{}", self.rt_alloc_names().1))
        if self.frames {
            out.push("\t.quad myla_std$rt$dclone_cell")
            out.push("\t.quad myla_std$rt$deep_str")
        } else {
            out.push("\t.quad 0")
            out.push("\t.quad 0")
        }
        // the release routines `__drop_drain` calls, by kind (MYLA-389)
        if self.drop_kinds.len() > 0 {
            out.push("__drop_routines:")
            for k in self.drop_kinds { out.push(format("\t.quad myla_{}", k)) }
        }
        for l in self.env_records {
            out.push(format("myla_{}_env_routines:", l))
            out.push(format("\t.quad myla_{}_env_drop", l))
            if self.frames {
                out.push(format("\t.quad myla_{}_env_clone", l))
                out.push(format("\t.quad myla_{}_env_deep", l))
            } else {
                out.push("\t.quad 0")
                out.push("\t.quad 0")
            }
        }
        out.push("")
        out.push("\t.bss")
        out.push("\t.balign 8")
        out.push("__heap_ptr:")
        out.push("\t.skip 8")
        out.push("__heap_end:")
        out.push("\t.skip 8")
        out.push("__free_buckets:")
        out.push("\t.skip 4616")
        out.push("__argc:")
        out.push("\t.skip 8")
        out.push("__argv:")
        out.push("\t.skip 8")
        out.push("__envp:")
        out.push("\t.skip 8")
        out.push("__io_errno_val:")
        out.push("\t.skip 8")
        out.push("__run_stderr_val:")
        out.push("\t.skip 8")
        out.push("__run_exit_val:")
        out.push("\t.skip 8")
        out.push("__run_signal_val:")
        out.push("\t.skip 8")
        out.push("__run_errno_val:")
        out.push("\t.skip 8")
        // how many guarded releases run inside one another, and the cells
        // deferred past DROP_DEPTH (MYLA-389, `drop_guard`)
        out.push("__drop_depth:")
        out.push("\t.skip 8")
        out.push("__drop_defer:")
        out.push("\t.skip 8")
        // 1 once a stack overflow is being reported (`__on_segv`)
        out.push("__segv_once:")
        out.push("\t.skip 8")
        // the self-pipe of caught signals (std.platform's `signal_listen`,
        // MYLA-350): its write end, which `__on_signal` writes to, its read
        // end plus one, how many listen, a lock, SIGINT's and SIGTERM's
        // handlers from before
        out.push("__sig_pipe:")
        out.push("\t.skip 48")
        // a runtime error's line and column as digits (std.rt's
        // `write_err_num`)
        out.push("__panic_buf:")
        out.push("\t.skip 32")
        // the poller's events and words (std.platform, D124)
        out.push("__poll_buf:")
        out.push("\t.skip 128")
        // the timers (std.rt's `sleep_frame`, D124): their heap's cell, its
        // count, its lock, the order they were set in; the poller and
        // whether a worker waits in it; how many times a worker left
        // `exec_idle` (MYLA-275); the big cells freed where memory isn't
        // given back (std.rt's `free_big`, D157)
        for v in ["__timers", "__timer_count", "__timer_lock", "__timer_seq", "__exec_poller", "__exec_polling", "__watches", "__watch_count", "__exec_waking", "__exec_gen", "__big_free"] {
            out.push(v + ":")
            out.push("\t.skip 8")
        }
        // a timer entry being swapped (std.rt's `timer_sift`, the lock held)
        out.push("__timer_tmp:")
        out.push("\t.skip 32")
        // the waiters parked on notifiers (std.rt's `park_frame`, MYLA-387),
        // and the claim on the stuck report (`exec_stuck`)
        out.push("__parked:")
        out.push("\t.skip 16")
        if self.frames {
            // each worker's queue: `[lock][head][tail]`, a cache line each
            out.push("\t.balign 64")
            out.push("__wq:")
            out.push(format("\t.skip {}", 64 * MAX_WORKERS))
            out.push("__wq_rings:")
            out.push("\t.skip 8")
            out.push("__tls_blocks:")
            out.push(format("\t.skip {}", TLS_SIZE * MAX_WORKERS))
            // the CPUs this process may run on (`workers_count`)
            out.push("__cpu_mask:")
            out.push("\t.skip 128")
            // the order ready frames run in (`__sched_init`, D110): 0 the
            // newest first, 1 the oldest, 2 one chosen by the generator
            // `__exec_rng` (MYLA_SCHED=seed:N)
            for g in ["__exec_seq", "__exec_idle", "__exec_sleepers", "__exec_workers", "__exec_sched", "__exec_rng"] {
                out.push(g + ":")
                out.push("\t.skip 8")
            }
            out.push("__exec_main:")
            out.push("\t.skip 8")
            // 1 once a task has failed: the program ends (D97)
            out.push("__exec_failing:")
            out.push("\t.skip 8")
        }
        if self.wasm {
            // WASI's calls (std.platform's blocks, MYLA-158) and the
            // environment of the function value being called
            for v in [("__wasi_args", 128), ("__wasi_buf", 64), ("__wasi_stat", 64), ("__wasi_cookies", 512), ("__wasi_subs", 1584), ("__wasi_events", 1056), ("__wasi_watch", 520), ("__wasi_ready", 264)] {
                out.push(v.0 + ":")
                out.push(format("\t.skip {}", v.1))
            }
        }
        out.push("")
        if self.line_files.len() > 0 { for l in self.dbg_sections() { out.push(l) } }
        out.push("\t.section .note.GNU-stack,\"\",@progbits")
        out.push("")
        return join_lines(out)
    }

    // -- deep copies (D92, MYLA-137) -----------------------------------------

    // The name of `t`'s deep walk (`__deepw_<T>`: %rdi = the address of a T,
    // whose heap values it replaces by deep copies, releasing the originals),
    // to be emitted. `clone` (MYLA-148): `__dclonew_<T>`, the T at %rdi a
    // word-for-word copy of a value others hold, whose heap values it
    // replaces by deep copies, only reading the originals.
    #test(codegen_on("enum E { A, B(int) }"), Type.TBool, true)["__dclonew_.bool"]
    fun register_deep(var self, t: Type, clone: bool) -> str {
        var name = "__deepw_" + mono_token(t)
        if clone { name = "__dclonew_" + mono_token(t) }
        if !self.helper_seen.contains(name) {
            self.helper_seen[name] = true
            self.need_deep.push(t)
            self.deep_inline.push(false)
            self.deep_clone.push(clone)
        }
        return name
    }

    // The routine making a cell of type `t` (%rdi, one reference, consumed)
    // unshared, deeply: %rax = the same cell when it was the only reference,
    // else a copy; either way every heap value in it is a deep copy of its own.
    // `clone`: %rax = a deep copy of the cell at %rdi, which is only read.
    #test(codegen_on("enum E { A, B(int) }"), Type.TBool, true)["__dcloneb_.bool"]
    fun deep_cell_name(var self, t: Type, clone: bool) -> str {
        if is_str_t(t) { return self.deep_cell_label(t, clone) }
        let name = self.deep_cell_label(t, clone)
        if !self.helper_seen.contains(name) {
            self.helper_seen[name] = true
            self.need_deepc.push(t)
            self.deepc_clone.push(clone)
        }
        return name
    }

    // The name of the deep copy routine of a cell of type `t` (no request).
    fun deep_cell_label(self, t: Type, clone: bool) -> str {
        var pre = "__deep"
        if clone { pre = "__dclone" }
        if is_str_t(t) { return pre + "_str" }
        return match t {
            Type.TList(e) => pre + "_list_" + mono_token(e),
            Type.TMap(k, v) => pre + "_map_" + map_token(k, v),
            _ => if is_sb_t(t) { pre + "_sb" } else { pre + "b_" + mono_token(t) },
        }
    }

    // The name of `t`'s release (or `retain`) walk (no request).
    fun walk_label(self, t: Type, retain: bool) -> str {
        if retain { return "__walkr_" + mono_token(t) }
        return "__walkd_" + mono_token(t)
    }

    // The name of the deep walk of an inline `t` (`inline`: of a boxed
    // enum's cell contents) (no request).
    fun deep_walk_label(self, t: Type, clone: bool, inline: bool) -> str {
        var pre = "__deep"
        if clone { pre = "__dclone" }
        if inline { return pre + "i_" + mono_token(t) }
        return pre + "w_" + mono_token(t)
    }

    // One member of type `ft` at `off(base)` (`base` callee-saved) made a
    // deep copy of its own; an actor handle stays shared (a clone takes a
    // reference of its own to it, atomically).
    fun deep_member(var self, base: str, off: int32, ft: Type, clone: bool) {
        if is_actor_t(ft) {
            if clone {
                self.emit(format("movq {}(%{}), %rax", off, base))
                self.emit("lock incq -8(%rax)")
            }
            return
        }
        if self.is_boxed(ft) || is_cell_t(ft) {
            let name = self.deep_cell_name(ft, clone)
            self.emit(format("movq {}(%{}), %rdi", off, base))
            self.emit("call " + name)
            self.emit(format("movq %rax, {}(%{})", off, base))
        } else if is_tfunc(ft) {
            self.emit(format("movq {}(%{}), %rdi", off + 8, base))
            if clone { self.emit("call __dclone_env") } else { self.emit("call __deep_env") }
            self.emit(format("movq %rax, {}(%{})", off + 8, base))
        } else if self.owns_heap(ft) {
            self.emit(format("leaq {}(%{}), %rdi", off, base))
            self.emit("call " + self.register_deep(ft, clone))
        }
    }

    // The deep walk of a boxed enum's inline value (its cell's contents).
    #test(codegen_on("enum E { A, B(int) }"), Type.TBool, true)["__dclonei_.bool"]
    fun register_deep_inline(var self, t: Type, clone: bool) -> str {
        var name = "__deepi_" + mono_token(t)
        if clone { name = "__dclonei_" + mono_token(t) }
        if !self.helper_seen.contains(name) {
            self.helper_seen[name] = true
            self.need_deep.push(t)
            self.deep_inline.push(true)
            self.deep_clone.push(clone)
        }
        return name
    }

    // -- thread state (D92, MYLA-137) ---------------------------------------

    // The operand of the runtime variable `sym`, which is a thread's own in a
    // program with tasks: in the block `%fs` holds (`tls_offset`), else at
    // its symbol.
    #test(codegen_on("[int]"), "__heap_end")["__heap_end(%rip)"]
    fun tv(self, sym: str) -> str {
        // (a process-wide one, like `__exec_workers`, next to %rip with tasks
        // too: MYLA-162)
        if !self.frames || tls_offset(sym) == 0 { return sym + "(%rip)" }
        return format("%fs:{}", tls_offset(sym))
    }

    // -- the executor (D90, D92, MYLA-140: workers and their queues) --------

    // -- functions --------------------------------------------------------

    // A function: lowered to the IR, checked and emitted (D79, MYLA-107).
    fun gen_any_function(var self, fd: FunData, mangled: str) {
        if !self.ir_ready {
            self.ir_blocked = blocked_types(self)
            self.ir_ready = true
        }
        var body_fd = fd
        if self.frames && fd.is_async { body_fd = self.normalized_fn(fd) }
        self.emit_ir(self.take_ir(lower_function(self, body_fd, mangled), mangled), body_fd, mangled)
    }

    // `fd` with its body normalized for its frame function: each `await` in
    // a `let` of its own (D90); the new nodes' types join `resolved`.
    fun normalized_fn(var self, fd: FunData) -> FunData {
        match fd.body {
            Some(b) => {
                self.norm.resolved = self.resolved
                self.resolved = [:]
                let nb = self.norm.block(b)
                self.resolved = self.norm.resolved
                self.norm.resolved = [:]
                return FunData { line: fd.line, col: fd.col, sp: fd.sp, name: fd.name, params: fd.params, ret_type: fd.ret_type, body: Some(nb), attributes: fd.attributes, type_params: fd.type_params, receiver: fd.receiver, is_pub: fd.is_pub, is_async: fd.is_async }
            },
            None => {},
        }
        return fd
    }

    // Whether `name` is an async function or method that runs on a frame.
    #test(codegen_on("[int]"), "inc")[false]
    fun is_async_fn(self, name: str) -> bool {
        if !self.frames || !self.has_func(name) { return false }
        let sig = self.sig_of(name)
        return sig.has_decl && sig.decl.is_async
    }

    // Whether node `id` has a type: an expression with a value.
    #test(codegen_on("[int]"), 112)[false]
    fun has_type(self, id: int32) -> bool {
        return self.resolved.contains(id)
    }

    // A lambda's body (MYLA-106), under the substitution of the function
    // that made it; then its environment's release function.
    fun gen_any_lambda(var self, job0: LamJob) {
        self.subst = job0.subst
        var job = job0
        // an async lambda runs on a frame, its body normalized (D90)
        if self.frames && is_async_t(job.ftype) {
            self.norm.resolved = self.resolved
            self.resolved = [:]
            match job.body {
                ExprOrBlock.EB_Block(b) => { job.body = ExprOrBlock.EB_Block(self.norm.block(b)) },
                ExprOrBlock.EB_Expr(ex) => { job.body = ExprOrBlock.EB_Block(self.norm.returning(ex, false)) },
            }
            self.resolved = self.norm.resolved
            self.norm.resolved = [:]
        }
        let f = self.take_ir(lower_lambda(self, job), job.lifted)
        self.emit_ir_at(f, job.id, job.line, job.col, job.lifted)
        var owned: [DropEntry] = []
        for c in job.caps { if self.owns_heap(c.ty) { owned.push(DropEntry { off: c.off, ty: c.ty }) } }
        if owned.len() > 0 { self.emit_env_drop(job.lifted, owned) }
        self.subst = []
    }

    // The lowering's result, accepted by the ownership verifier (MYLA-105),
    // with what it needs queued: generic instances, and the lambdas, partial
    // applications and function values it makes (MYLA-106). A function that
    // can't be lowered or doesn't verify is a compiler bug.
    fun take_ir(var self, lowered: Result<Lowered, str>, mangled: str) -> IrFunc {
        let l = match lowered {
            Ok(x) => x
            Err(why) => { panic(format("internal error: {} can't be lowered to the IR: {}", mangled, why)) }
        }
        if l.refused.len() > 0 {
            for r in l.refused { self.refused.push(r) }
            return l.f
        }
        // a last use moves (MYLA-127), checked by the verifier with the rest;
        // calls to small leaf functions replaced by their bodies
        var f = moves(l.f)
        if !f.frame && self.inlining && !self.debug {
            let n = f.blocks.len()
            f = self.inline_small(f)
            // the copies' blocks joined to their neighbours
            if f.blocks.len() != n { f = merge_blocks(f) }
        }
        // a loop's copy-on-write checks made before it (MYLA-251)
        if !self.debug { f = hoist_cows(f) }
        // a counting loop's step without the int32 re-extension (MYLA-251)
        f = widen_counters(f)
        let problem = verify(f)
        // with `--ssa`, the text shows each function after promotion instead
        if self.keep_ir && !self.ssa { self.ir_texts.push(render_func(f)) }
        if problem != "" { panic(format("internal error: {}: IR verifier: {}", mangled, problem)) }
        for inst in l.f.instances { let m = self.request_fn(inst.orig, inst.targs) }
        for b in f.blocks {
            for inst in b.insts {
                match inst {
                    Inst.Call(d, name, args) => { self.request_plain(name) },
                    Inst.CallSret(name, r, args) => { self.request_plain(name) },
                    _ => {},
                }
            }
        }
        // the routines on its values it calls (MYLA-313)
        for w in l.wants {
            if w.kind >= 7 { self.request_wants([w]) }
        }
        for lj in l.lams { self.lam_jobs.push(lj) }
        for pj in l.partials {
            self.partial_jobs.push(pj)
            if pj.target != "" { self.request_plain(pj.target) }
        }
        for n in l.fnvals {
            if !list_has_str(self.fnval_set, n) { self.fnval_set.push(n) }
            self.request_plain(n)
        }
        return f
    }

    // `f` with its calls to small leaf functions of its own module replaced
    // by their bodies (`inline.my`, MYLA-162).
    fun inline_small(var self, f: IrFunc) -> IrFunc {
        var names: [str] = []
        var bodies: [IrFunc] = []
        for b in f.blocks {
            for i in b.insts {
                match i {
                    Inst.Call(d, name, args) => {
                        if name != f.name && same_module(name, f.name) && !list_has_str(names, name) {
                            match self.inline_body(name) {
                                Some(body) => {
                                    names.push(name)
                                    bodies.push(body)
                                },
                                None => {},
                            }
                        }
                    },
                    _ => {},
                }
            }
        }
        if names.len() == 0 {
            return f
        }
        return inline_calls(f, names, bodies)
    }

    // The lowered body of the function `name` when it may be copied into its
    // callers (non-generic, not async, `inlinable`), lowered once.
    fun inline_body(var self, name: str) -> Option<IrFunc> {
        if self.inl_no.contains(name) {
            return None
        }
        var c = 0
        while c < self.inl_names.len() {
            if self.inl_names[c] == name {
                return Some(self.inl_bodies[c])
            }
            c += 1
        }
        if self.has_func(name) && self.inline_candidate(self.sig_of(name)) {
            let saved = self.subst
            self.subst = []
            let lowered = lower_function(self, self.sig_of(name).decl, name)
            self.subst = saved
            match lowered {
                Ok(l) => {
                    let body = moves(l.f)
                    if l.lams.len() == 0 && l.partials.len() == 0 && l.fnvals.len() == 0 && inlinable(body) {
                        self.inl_names.push(name)
                        self.inl_bodies.push(body)
                        return Some(body)
                    }
                },
                Err(why) => {},
            }
        }
        self.inl_no[name] = true
        return None
    }

    // Whether the function of `sig` is worth lowering to see if it is
    // inlinable: non-generic, not async, not a method, short, scalars only.
    fun inline_candidate(self, sig: FuncSig) -> bool {
        let fd = sig.decl
        let method = match fd.receiver { Some(r) => true, None => false }
        return sig.type_params.len() == 0 && !fd.is_async && !method && may_inline(sig.params, sig.ret, fd.sp.eline - fd.sp.sline)
    }

    // Queue the non-generic function `name` (a generic instance is named by
    // its mangled name, and queued from `IrFunc.instances`).
    fun request_plain(var self, name: str) {
        if self.has_func(name) && self.sig_of(name).type_params.len() == 0 { let m = self.request_fn(name, []) }
        // an async function's `__new` (D90): the function itself, whose
        // frame function emits it
        let n = name.len()
        if n > 5 && name[n - 5] == '_' && name[n - 4] == '_' && name[n - 3] == 'n' && name[n - 2] == 'e' && name[n - 1] == 'w' {
            var sb = StringBuilder()
            sb.append(name, 0, n - 5)
            let base = sb.build()
            if self.has_func(base) && self.sig_of(base).type_params.len() == 0 { let m = self.request_fn(base, []) }
        }
    }

    // -- expressions ------------------------------------------------------

    #test(codegen_on("[int]"), "H")[None]
    fun const_value_expr(self, name: str) -> Option<Expr> {
        for d in self.decls {
            match d.kind {
                DeclKind.ConstDecl(cn, ty, value, attrs, isp) => {
                    if cn == name { return Some(value) }
                },
                _ => {},
            }
        }
        return None
    }

    // `op` (`-`, `~` or `!`) on the value in %rax, whose result has type `t`
    // (shared with the IR backend, MYLA-103).
    fun emit_unary(var self, op: str, t: Type) {
        if op == "-" && is_tfloat(t) {
            self.uses_float = true
            self.emit("movabsq $-9223372036854775808, %rcx")   // the sign bit
            self.emit("xorq %rcx, %rax")
        } else if op == "-" {
            self.emit("negq %rax")
            self.wrap(t)
        } else if op == "~" {
            self.emit("notq %rax")
            self.wrap(t)
        } else {
            self.emit("testq %rax, %rax")
            self.emit("sete %al")
            self.emit("movzbq %al, %rax")
        }
    }

    // The integer operation `op` on %rax (left, of type `lt`) and %rcx (right),
    // its result (of type `rt`) in %rax; `/` and `%` trap at line:col on a zero
    // divisor (shared with the IR backend, MYLA-103).
    // `op` on %rax and `src`, the second operand: %rcx, or for the operators
    // `takes_operand` names an immediate or a memory operand (MYLA-120).
    fun emit_int_op(var self, op: str, lt: Type, rt: Type, line: int32, col: int32, src: str) {
        if op == "+" {
            self.emit(format("addq {}, %rax", src))
            self.wrap(rt)
        } else if op == "-" {
            self.emit(format("subq {}, %rax", src))
            self.wrap(rt)
        } else if op == "*" {
            if starts_with_dollar(src) { self.emit(format("imulq {}, %rax, %rax", src)) } else { self.emit(format("imulq {}, %rax", src)) }
            self.wrap(rt)
        } else if (op == "/" || op == "%") && starts_with_dollar(src) {
            // a constant divisor, in %rcx too, that is neither 0 nor -1
            // (MYLA-125)
            if int_signed(lt) {
                self.emit("cqo")
                self.emit("idivq %rcx")
            } else {
                self.emit("xorq %rdx, %rdx")
                self.emit("divq %rcx")
            }
            if op == "%" { self.emit("movq %rdx, %rax") }
            // neither 0 nor -1: the quotient or remainder is in range
            if !same_int(lt, rt) { self.wrap(rt) }
        } else if op == "/" || op == "%" {
            self.emit("testq %rcx, %rcx")
            if op == "/" { self.trap("jz", "__trap_div", line, col) } else { self.trap("jz", "__trap_mod", line, col) }
            if int_signed(lt) {
                // x / -1 is -x and x % -1 is 0; idivq would trap on the
                // minimum (its quotient overflows), the language wraps (MYLA-5)
                let divide = self.label()
                let done = self.label()
                self.emit("cmpq $-1, %rcx")
                self.emit(format("jne {}", divide))
                if op == "/" { self.emit("negq %rax") } else { self.emit("xorl %eax, %eax") }
                self.emit(format("jmp {}", done))
                self.emit(format("{}:", divide))
                self.emit("cqo")
                self.emit("idivq %rcx")
                if op == "%" { self.emit("movq %rdx, %rax") }
                self.emit(format("{}:", done))
            } else {
                self.emit("xorq %rdx, %rdx")
                self.emit("divq %rcx")
                if op == "%" { self.emit("movq %rdx, %rax") }
            }
            // only the minimum's quotient by -1 leaves the range (MYLA-251):
            // a remainder is smaller than the divisor, an unsigned
            // quotient than the dividend
            if (op == "/" && int_signed(lt)) || !same_int(lt, rt) { self.wrap(rt) }
        } else if is_cmp(op) {
            self.emit(format("cmpq {}, %rax", src))
            self.emit(format("{} %al", cmp_set(op, int_signed(lt))))
            self.emit("movzbq %al, %rax")
        } else if op == "==" || op == "!=" {
            self.emit(format("cmpq {}, %rax", src))
            if op == "==" { self.emit("sete %al") } else { self.emit("setne %al") }
            self.emit("movzbq %al, %rax")
        } else if op == "&" {
            // bitwise on extended values gives an extended value (MYLA-251)
            self.emit(format("andq {}, %rax", src))
            if !same_int(lt, rt) { self.wrap(rt) }
        } else if op == "|" {
            self.emit(format("orq {}, %rax", src))
            if !same_int(lt, rt) { self.wrap(rt) }
        } else if op == "^" {
            self.emit(format("xorq {}, %rax", src))
            if !same_int(lt, rt) { self.wrap(rt) }
        } else if op == "<<" || op == ">>" {
            self.emit(format("andq ${}, %rcx", int_width_cg(rt) - 1))
            if op == "<<" {
                self.emit("shlq %cl, %rax")
            } else if int_signed(lt) {
                self.emit("sarq %cl, %rax")
            } else {
                self.emit("shrq %cl, %rax")
            }
            // a right shift of an extended value is one
            if op == "<<" || !same_int(lt, rt) { self.wrap(rt) }
        }
    }

    // The value in %rax, of type `src`, `as tgt` (shared with the IR backend,
    // MYLA-103).
    fun emit_cast(var self, src: Type, tgt: Type) {
        if is_tchar(tgt) { return }
        if is_tchar(src) {
            self.wrap(tgt)
            return
        }
        if is_tfloat(tgt) {
            self.uses_float = true
            if is_tfloat(src) {
                // the runtime image is already f64; only narrowing changes it
                self.emit("movq %rax, %xmm0")
                self.round_xmm0(tgt)
                self.emit("movq %xmm0, %rax")
                return
            }
            let is_u64 = match src { Type.TInt(w, sg) => w == 64 && !sg, _ => false }
            if is_u64 {
                // uint64 with the high bit set can't go through the signed
                // cvtsi2sd: halve with round-to-odd, convert, double
                let direct = self.label()
                let done = self.label()
                self.emit("testq %rax, %rax")
                self.emit(format("jns {}", direct))
                self.emit("movq %rax, %rcx")
                self.emit("shrq $1, %rcx")
                self.emit("andq $1, %rax")
                self.emit("orq %rax, %rcx")
                self.emit("cvtsi2sdq %rcx, %xmm0")
                self.emit("addsd %xmm0, %xmm0")
                self.emit(format("jmp {}", done))
                self.emit(format("{}:", direct))
                self.emit("cvtsi2sdq %rax, %xmm0")
                self.emit(format("{}:", done))
            } else {
                self.emit("cvtsi2sdq %rax, %xmm0")
            }
            self.round_xmm0(tgt)
            self.emit("movq %xmm0, %rax")
            return
        }
        if is_tfloat(src) {
            self.float_to_int(tgt)
            return
        }
        // a register holds a value extended from its type's width, so
        // widening an unsigned one, or a signed one to a signed type, keeps
        // it as it is (MYLA-162)
        let widens = match src {
            Type.TInt(w1, s1) => match tgt {
                Type.TInt(w2, s2) => w1 < w2 && (!s1 || s2),
                _ => false,
            },
            _ => false,
        }
        if widens { return }
        self.wrap(tgt)
    }

    // The float in %rax `as t`: truncate toward zero, clamp to the range of
    // `t`, NaN gives 0 (D59). cvttsd2si alone returns 2^63 for anything
    // outside the int64 range.
    fun float_to_int(var self, t: Type) {
        self.uses_float = true
        let w = int_width_cg(t)
        let signed = int_signed(t)
        var top = w                                  // the clamp bounds: high + 1 = 2^top
        var low: int64 = 0
        var low_bits: int64 = 0
        if signed {
            top = w - 1
            low = -(1i64 << (top as int64))
            low_bits = pow2_bits(top, true)
        }
        var high: int64 = -1                         // all ones for uint64
        if top < 64 { high = (1i64 << (top as int64)) - 1 }
        let done = self.label()
        self.emit("movq %rax, %xmm0")
        self.emit("xorl %eax, %eax")
        self.emit("ucomisd %xmm0, %xmm0")
        self.emit(format("jp {}", done))             // NaN -> 0
        self.emit(format("movabsq ${}, %rcx", pow2_bits(top, false)))
        self.emit("movq %rcx, %xmm1")
        self.emit(format("movabsq ${}, %rax", high))
        self.emit("ucomisd %xmm1, %xmm0")
        self.emit(format("jae {}", done))            // x >= high + 1 -> high
        self.emit(format("movabsq ${}, %rcx", low_bits))
        self.emit("movq %rcx, %xmm1")
        self.emit(format("movabsq ${}, %rax", low))
        self.emit("ucomisd %xmm1, %xmm0")
        self.emit(format("jbe {}", done))            // x <= low -> low
        if w == 64 && !signed {
            // 2^63 <= x < 2^64: convert x - 2^63, then set the top bit
            let small = self.label()
            self.emit(format("movabsq ${}, %rcx", pow2_bits(63, false)))
            self.emit("movq %rcx, %xmm1")
            self.emit("ucomisd %xmm1, %xmm0")
            self.emit(format("jb {}", small))
            self.emit("subsd %xmm1, %xmm0")
            self.emit("cvttsd2si %xmm0, %rax")
            self.emit("btcq $63, %rax")
            self.emit(format("jmp {}", done))
            self.emit(format("{}:", small))
        }
        self.emit("cvttsd2si %xmm0, %rax")
        self.emit(format("{}:", done))
    }

    // Narrow %xmm0 to single precision when `t` is float32 (round to nearest),
    // then widen it back to the f64 image floats are carried as.
    fun round_xmm0(var self, t: Type) {
        if is_tfloat32(t) {
            self.emit("cvtsd2ss %xmm0, %xmm0")
            self.emit("cvtss2sd %xmm0, %xmm0")
        }
    }

    // The float operation `op` on the f64 images in %rax and %rcx, the result
    // (of type `t` for arithmetic, 0/1 for a comparison) in %rax (shared with
    // the IR backend, MYLA-103).
    fun emit_float_op(var self, op: str, t: Type) {
        self.uses_float = true
        self.emit("movq %rax, %xmm0")
        self.emit("movq %rcx, %xmm1")
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            if op == "+" { self.emit("addsd %xmm1, %xmm0") }
            else if op == "-" { self.emit("subsd %xmm1, %xmm0") }
            else if op == "*" { self.emit("mulsd %xmm1, %xmm0") }
            else if op == "/" { self.emit("divsd %xmm1, %xmm0") }
            else { self.emit("call __fmod") }
            self.round_xmm0(t)
            self.emit("movq %xmm0, %rax")
            return
        }
        // comparison -> 0/1; NaN compares unordered (only != is true)
        self.emit("ucomisd %xmm1, %xmm0")
        self.emit_float_cmp_result(op)
    }

    // The flags of a `ucomisd` as the 0/1 of the comparison `op` in %rax;
    // NaN compares unordered (only != is true).
    fun emit_float_cmp_result(var self, op: str) {
        if op == ">" { self.emit("seta %al") }
        else if op == ">=" { self.emit("setae %al") }
        else if op == "!=" {
            self.emit("setne %al")
            self.emit("setp %cl")
            self.emit("orb %cl, %al")
        } else {
            if op == "<" { self.emit("setb %al") }
            else if op == "<=" { self.emit("setbe %al") }
            else { self.emit("sete %al") }
            self.emit("setnp %cl")
            self.emit("andb %cl, %al")
        }
        self.emit("movzbq %al, %rax")
    }

    fun wrap(var self, t: Type) {
        match t {
            Type.TInt(w, s) => {
                // sign- or zero-extended from the low w bits, in one instruction (MYLA-120)
                if w == 32 {
                    if s { self.emit("movslq %eax, %rax") } else { self.emit("movl %eax, %eax") }
                } else if w == 16 {
                    if s { self.emit("movswq %ax, %rax") } else { self.emit("movzwl %ax, %eax") }
                } else if w == 8 {
                    if s { self.emit("movsbq %al, %rax") } else { self.emit("movzbl %al, %eax") }
                }
            },
            _ => {},
        }
    }

    // -- aggregates (structs / tuples) ------------------------------------

    // `size` bytes from (%rsi) to (%rdi), through %rcx (clobbers %rcx, %rsi
    // and %rdi). Up to 8 words as moves: `rep movsq` starts slowly (tens of
    // cycles even for three words), which made matching on a small enum six
    // times slower than C (MYLA-242).
    fun emit_copy(var self, size: int32) {
        let words = size / 8
        if words <= 8 {
            for i in 0..words {
                self.emit(format("movq {}(%rsi), %rcx", i * 8))
                self.emit(format("movq %rcx, {}(%rdi)", i * 8))
            }
            return
        }
        self.emit(format("movq ${}, %rcx", words))
        self.emit("cld")
        self.emit("rep movsq")
    }

    // -- lists ------------------------------------------------------------

    // The address of element %rcx of the list (or string, `is_str`) cell in
    // %rax, trapping at line:col when it is out of bounds (shared with the IR
    // backend, MYLA-105).
    fun emit_elem_addr(var self, is_str: bool, stride: int32, line: int32, col: int32) {
        self.emit_elem_check(line, col)
        self.emit(format("leaq {}, %rax", self.elem_operand(is_str, stride)))
    }

    // The memory operand of the element %rcx of the list or string %rax
    // (bounds-checked already); for a stride that isn't a scale, %rcx is
    // multiplied first (MYLA-120).
    #test(codegen_on("[int]"), true, 1)["8(%rax,%rcx)"]
    fun elem_operand(var self, is_str: bool, stride: int32) -> str {
        if is_str { return "8(%rax,%rcx)" }
        if stride == 1 || stride == 2 || stride == 4 || stride == 8 { return format("16(%rax,%rcx,{})", stride) }
        self.emit(format("imulq ${}, %rcx", stride))
        return "16(%rax,%rcx)"
    }

    // The bounds check of element %rcx of the list or string %rax.
    fun emit_elem_check(var self, line: int32, col: int32) {
        self.emit("movq (%rax), %rdx")
        self.emit("cmpq %rdx, %rcx")
        self.trap("jae", "__trap_index", line, col)
    }

    // -- copy-on-write mutation addressing --------------------------------

    // In: %rax = address of the slot holding a list/map/builder pointer. Ensure
    // the cell is uniquely owned (clone it if refcount > 1, storing the clone
    // back). Out: %rax = the now-unique cell pointer.
    fun cow_unique(var self, t: Type) {
        self.emit("movq %rax, %rcx")
        self.register_clone(t)
        self.cow_unique_at_rcx(self.clone_call_name(t))
    }

    // `cow_unique` with the holder's address already in %rcx (MYLA-251),
    // `clone` the cell type's clone routine (requested already).
    fun cow_unique_at_rcx(var self, clone: str) {
        self.emit("movq (%rcx), %rdi")
        let skip = self.label()
        self.emit("cmpq $1, -8(%rdi)")
        self.emit(format("jbe {}", skip))
        self.emit("pushq %rcx")
        self.emit("call " + clone)
        self.emit("popq %rcx")
        self.emit("movq %rax, (%rcx)")
        self.emit("movq %rax, %rdi")
        self.emit(format("{}:", skip))
        self.emit("movq %rdi, %rax")
    }

    // Stores into containers evaluate the value first and only then touch the
    // container, as the interpreter does (MYLA-4): the value may return early
    // (`?`) or change the same container (`push(xs, pop(xs))`), and neither may
    // see a half-made slot. The new value is also taken before the old one is
    // released, so `xs[i] = xs[i]` is safe.

    // -- maps / strings / chars -------------------------------------------

    #test(codegen_on("[int]"), Type.TMap(Type.TStr, Type.TInt(32, true)))[32]
    // `[state:8][key:8][value][rank:8]`: the rank is the key's place in the
    // order of insertion, 0 … count - 1 (D105, MYLA-179)
    fun map_slot_size(self, mt: Type) -> int32 {
        if self.map_hashed(mt) { return 24 + self.map_key_size(mt) + self.stored_size(map_val(mt)) }
        return 24 + self.stored_size(map_val(mt))
    }

    // Whether the keys of the map type `mt` have routines of their own (D163,
    // MYLA-313): any key but an integer, `char`, `bool` or `str`, which keep
    // std.rt's `map_lookup` and `map_put_slot`. Such a slot is
    // `[state:8][hash:8][key][value][rank:8]`, its key's words in it as a
    // value's are, its hash kept so that a compaction needs no routine.
    #test(codegen_on("[int]"), Type.TMap(Type.TStr, Type.TInt(32, true)))[false]
    #test(codegen_on("[int]"), Type.TMap(Type.TTuple([Type.TInt(32, true), Type.TInt(32, true)]), Type.TInt(32, true)))[true]
    fun map_hashed(self, mt: Type) -> bool {
        return match map_key(mt) {
            Type.TInt(w, sg) => false,
            Type.TChar => false,
            Type.TBool => false,
            Type.TStr => false,
            _ => true,
        }
    }

    // The bytes of a key of the map type `mt` in its slot.
    #test(codegen_on("[int]"), Type.TMap(Type.TTuple([Type.TInt(32, true), Type.TStr]), Type.TBool))[16]
    fun map_key_size(self, mt: Type) -> int32 {
        if !self.map_hashed(mt) { return 8 }
        return self.stored_size(map_key(mt))
    }

    // Where a slot of the map type `mt` holds its key and its value.
    #test(codegen_on("[int]"), Type.TMap(Type.TStr, Type.TBool))[8]
    fun map_key_off(self, mt: Type) -> int32 {
        if self.map_hashed(mt) { return 16 }
        return 8
    }

    #test(codegen_on("[int]"), Type.TMap(Type.TTuple([Type.TInt(32, true), Type.TStr]), Type.TBool))[32]
    fun map_val_off(self, mt: Type) -> int32 {
        if self.map_hashed(mt) { return 16 + self.map_key_size(mt) }
        return 16
    }
    #test(codegen_on("[int]"), Type.TMap(Type.TStr, Type.TInt(32, true)))[1]
    fun map_is_str(self, mt: Type) -> int32 {
        if is_str_t(map_key(mt)) { return 1 }
        return 0
    }

    // -- strings: format + StringBuilder ----------------------------------

    // Print the fresh `str` in %rax, then release it.
    fun print_and_drop_str(var self) {
        self.emit("pushq %rax")
        self.emit("movq %rax, %rdi")
        self.emit("call __print_str")
        self.emit("popq %rdi")
        self.emit("call __str_drop")
    }

    // The bytes str[start..end] for `__sb_append_bytes`: the string in %rsi,
    // start in %rdx and end in %rcx (sign-extended) become the address in %rsi
    // and the count in %rdx, trapping at `line:col` unless 0 <= start <= end
    // <= len (shared with the IR backend, MYLA-105).
    fun emit_sb_range(var self, line: int32, col: int32) {
        let bad = self.label()
        let good = self.label()
        self.emit("testq %rdx, %rdx")
        self.emit(format("jl {}", bad))
        self.emit("cmpq %rdx, %rcx")
        self.emit(format("jl {}", bad))
        self.emit("cmpq (%rsi), %rcx")
        self.emit(format("jle {}", good))
        self.emit(format("{}:", bad))
        self.trap("jmp", "__trap_index", line, col)
        self.emit(format("{}:", good))
        self.emit("leaq 8(%rsi,%rdx), %rsi")   // &bytes[start]
        self.emit("subq %rdx, %rcx")
        self.emit("movq %rcx, %rdx")       // count
    }

    // A new string of the bytes of the builder in %rax, in %rax (shared with
    // the IR backend, MYLA-105).
    fun emit_sb_build(var self) {
        self.emit("pushq %rax")
        self.emit("movq (%rax), %rdx")
        self.emit("leaq 8(%rdx), %rdi")
        self.emit("call __alloc")
        self.emit("popq %rsi")
        self.emit("movq (%rsi), %rdx")
        self.emit("movq %rdx, (%rax)")
        self.emit("pushq %rax")
        self.emit("leaq 8(%rax), %rdi")
        self.emit("leaq 16(%rsi), %rsi")
        self.emit("movq %rdx, %rcx")
        self.emit("cld")
        self.emit("rep movsb")
        self.emit("popq %rax")
    }

    #test(codegen_on("struct P { x: int, y: int }"), "Box", "v")[Type.TInt(32, true)]
    fun struct_field_type(self, name: str, field: str) -> Type {
        for f in self.struct_info(name).fields {
            if f.name == field { return f.ty }
        }
        return Type.TInt(32, true)
    }

    // Field type with the struct value `st`'s concrete type arguments substituted.
    #test(codegen_on("struct P { x: int, y: int }"), Type.TStruct("Box", []), "v")[Type.TInt(32, true)]
    fun struct_field_type_t(self, st: Type, field: str) -> Type {
        let name = struct_name_of(st)
        let info = self.struct_info(name)
        let sub = self.type_subst(info.type_params, type_args_of(st))
        return subst_type(self.struct_field_type(name, field), sub)
    }

    // `myla_<fn>__fnval`, the adapter that calls the plain `fun` `n` as a
    // function value (MYLA-126): a partial application with every argument a
    // hole (`partial_ir`, MYLA-263), so a parameter passed owned gets a
    // reference of its own and one passed by value (D88) a copy, on every
    // target.
    fun emit_fnval_adapter(var self, n: str) {
        let sig = self.sig_of(n)
        var slots: [int32] = []
        var aggs: [bool] = []
        for p in sig.params {
            slots.push(-1)
            aggs.push(false)
        }
        self.emit_partial(PartialJob { lifted: n + "__fnval", target: n, fn_off: -1, slots: slots, aggs: aggs, sret: is_aggregate_opt(sig.ret), owned: [] })
    }

    // An async function's adapter, `myla_<f>__fnval`: its value makes its
    // frame (D90), a `become` of its `__new` with the words it got, built as
    // IR on every target (MYLA-263). Its call gives the frame, one word,
    // whatever its result type (wasm32's adapter counted a result's address
    // for an aggregate one, which `__new` doesn't take).
    fun emit_async_fnval(var self, n: str) {
        let r = async_fnval_ir(n, self.sig_of(n).params.len() as int32)
        self.emit_routine(r.f, -1, 0, 0)
    }

    // An async function's frame constructor, `myla_<f>__new`, built as IR and
    // translated like any function on every target (`frame_new_ir`,
    // MYLA-263).
    fun emit_frame_new_ir(var self, f: IrFunc, mangled: str) {
        let r = frame_new_ir(self, f, mangled)
        self.emit_routine(r.f, -1, 0, 0)
        self.request_wants(r.wants)
    }

    // A partial application's function, built as IR and translated like any
    // function on every target (`partial_ir`, MYLA-263), then its
    // environment's drop.
    fun emit_partial(var self, job: PartialJob) {
        let r = partial_ir(self, job)
        self.emit_routine(r.f, -1, 0, 0)
        self.request_wants(r.wants)
        if job.owned.len() > 0 { self.emit_env_drop(job.lifted, job.owned) }
    }

    // `myla_<lifted>_env_drop(%rdi = env)`: release the env's owned values, then
    // tail-call __free on the cell (reached through __func_drop at refcount 0).
    fun emit_env_drop(var self, lifted: str, owned: [DropEntry]) {
        // built as IR with std.rt's allocator (MYLA-162); with tasks, the
        // env's deep copy and clone too, which `__deep_env` and
        // `__dclone_env` find in its record (D92, MYLA-263)
        if self.frames {
            self.emit_env_routine(env_deep_ir(self, lifted, owned, false))
            self.emit_env_routine(env_deep_ir(self, lifted, owned, true))
        }
        self.env_records.push(lifted)
        self.emit_env_routine(env_drop_ir(self, lifted, owned, self.rt_alloc_names().1))
    }

    // `myla_<fn>__fnval`: the adapter that lets a plain `fun` be called as a
    // function value (MYLA-126). Both take the same argument words, so it
    // only gives a parameter passed owned a reference of its own (its caller
    // lends it, MYLA-127) and jumps to `myla_<fn>`; the environment in %r10
    // goes unused (D119).
    fun emit_fnval_thunk(var self, n: str) {
        if self.is_async_fn(n) {
            self.emit_async_fnval(n)
            return
        }
        self.emit_fnval_adapter(n)
    }

    fun free_eb(self, body: ExprOrBlock, bound: [str]) -> [str] {
        return match body {
            ExprOrBlock.EB_Expr(ex) => self.free_expr(ex, bound),
            ExprOrBlock.EB_Block(b) => self.free_block(b, bound),
        }
    }

    #test(codegen_on("fun main() { print(1 + 2) }"), block_of("{ }"), [])[[]]
    fun free_block(self, b: Block, bound: [str]) -> [str] {
        var out: [str] = []
        var bnd = bound
        for s in b.stmts {
            match s.kind {
                StmtKind.VarDecl(k, name, ty, init) => {
                    for v in self.free_expr(init, bnd) { out.push(v) }
                    bnd.push(name)
                },
                StmtKind.DestructDecl(k, binding, ty, init) => {
                    for v in self.free_expr(init, bnd) { out.push(v) }
                    for nm in bind_elem_names(binding) { bnd.push(nm) }
                },
                StmtKind.Assign(target, value) => {
                    for v in self.free_expr(target, bnd) { out.push(v) }
                    for v in self.free_expr(value, bnd) { out.push(v) }
                },
                StmtKind.IfS(cond, then, otherwise) => {
                    for v in self.free_expr(cond, bnd) { out.push(v) }
                    for v in self.free_block(then, bnd) { out.push(v) }
                    for v in self.free_opt_else(otherwise, bnd) { out.push(v) }
                },
                StmtKind.WhileS(cond, body) => {
                    for v in self.free_expr(cond, bnd) { out.push(v) }
                    for v in self.free_block(body, bnd) { out.push(v) }
                },
                StmtKind.ForS(vn, start, end, body, iter) => {
                    for v in self.free_opt(start, bnd) { out.push(v) }
                    for v in self.free_opt(end, bnd) { out.push(v) }
                    for v in self.free_opt(iter, bnd) { out.push(v) }
                    var b2 = bnd
                    b2.push(vn)
                    for v in self.free_block(body, b2) { out.push(v) }
                },
                StmtKind.ReturnS(ov, tail) => { for v in self.free_opt(ov, bnd) { out.push(v) } },
                StmtKind.ExprStmt(e) => { for v in self.free_expr(e, bnd) { out.push(v) } },
                StmtKind.DeferS(body) => { for v in self.free_block(body, bnd) { out.push(v) } },
                _ => {},
            }
        }
        return out
    }

    #test(codegen_on("enum E { A, B(int) }"), None, [])[[]]
    fun free_opt_else(self, oe: Option<ElseTail>, bound: [str]) -> [str] {
        return match oe {
            Some(et) => self.free_else(et, bound),
            None => empty_str_list(),
        }
    }

    fun free_else(self, et: ElseTail, bound: [str]) -> [str] {
        return match et {
            ElseTail.ElseBlock(b) => self.free_block(b, bound),
            ElseTail.ElseIf(s) => self.free_block(Block { line: 0, col: 0, sp: no_span(), stmts: [s] }, bound),
        }
    }

    fun free_opt(self, oe: Option<Expr>, bound: [str]) -> [str] {
        return match oe {
            Some(e) => self.free_expr(e, bound),
            None => empty_str_list(),
        }
    }

    #test(codegen_on("enum E { A, B(int) }"), expr_of("a.b[0]"), [])[["a"]]
    fun free_expr(self, e: Expr, bound: [str]) -> [str] {
        var out: [str] = []
        match e.kind {
            ExprKind.Name(n) => { if !list_has_str(bound, n) { out.push(n) } },
            ExprKind.Unary(op, x) => { for v in self.free_expr(x, bound) { out.push(v) } },
            ExprKind.Await(x) => { for v in self.free_expr(x, bound) { out.push(v) } },
            ExprKind.Binary(op, l, r) => {
                for v in self.free_expr(l, bound) { out.push(v) }
                for v in self.free_expr(r, bound) { out.push(v) }
            },
            ExprKind.Call(c, args, _) => {
                for v in self.free_expr(c, bound) { out.push(v) }
                for a in args { for v in self.free_expr(a, bound) { out.push(v) } }
            },
            ExprKind.GetField(t, f) => { for v in self.free_expr(t, bound) { out.push(v) } },
            ExprKind.TupleIndex(t, i) => { for v in self.free_expr(t, bound) { out.push(v) } },
            ExprKind.Index(b, i) => {
                for v in self.free_expr(b, bound) { out.push(v) }
                for v in self.free_expr(i, bound) { out.push(v) }
            },
            ExprKind.Cast(x, ty) => { for v in self.free_expr(x, bound) { out.push(v) } },
            ExprKind.Try(x) => { for v in self.free_expr(x, bound) { out.push(v) } },
            ExprKind.StructLit(n, fields) => {
                for fi in fields { for v in self.free_expr(fi.value, bound) { out.push(v) } }
            },
            ExprKind.TupleLit(elems) => {
                for el in elems { for v in self.free_expr(el, bound) { out.push(v) } }
            },
            ExprKind.ListLit(elems) => {
                for el in elems { for v in self.free_expr(el, bound) { out.push(v) } }
            },
            ExprKind.MapLit(entries) => {
                for en in entries {
                    for v in self.free_expr(en.key, bound) { out.push(v) }
                    for v in self.free_expr(en.value, bound) { out.push(v) }
                }
            },
            ExprKind.Lambda(params, ret, body, asy) => {
                var b2 = bound
                for p in params { b2.push(p.name) }
                for v in self.free_eb(body, b2) { out.push(v) }
            },
            ExprKind.MatchE(scrut, arms) => {
                for v in self.free_expr(scrut, bound) { out.push(v) }
                for arm in arms {
                    var b2 = bound
                    for nm in pattern_names(arm.pattern) { b2.push(nm) }
                    for v in self.free_opt(arm.guard, b2) { out.push(v) }
                    for v in self.free_eb(arm.body, b2) { out.push(v) }
                }
            },
            _ => {},
        }
        return out
    }

    // Print the scalar in %rax, of type `t`, as `print` does
    // (shared with the IR backend, MYLA-103).
    fun emit_print(var self, t: Type) {
        self.emit("movq %rax, %rdi")
        match t {
            Type.TBool => { self.emit("call __print_bool") },
            Type.TStr => { self.emit("call __print_str") },
            Type.TChar => { self.emit("call __print_char") },
            Type.TInt(w, s) => {
                if s { self.emit("call __print_int") }
                else { self.emit("call __print_uint") }
            },
            Type.TFloat(w) => {
                self.float_to_str(w)
                self.print_and_drop_str()
            },
            _ => {},
        }
    }

    // %rdi = a float's f64 image -> %rax = its text: 9 significant digits for
    // a float32, 17 for a float64, as the interpreter prints it.
    fun float_to_str(var self, width: int32) {
        self.uses_float = true
        var digits = 17
        if width == 32 { digits = 9 }
        self.emit(format("movq ${}, %rsi", digits))
        self.wants_ftoa = true
        self.emit("call __float_to_str")
    }

    // -- runtime prelude (_start + print/heap helpers) --------------------

    // -- the float runtime (first rendered from the retired Python backend's)

    // -- end of the float runtime

    // `{T}.eq(self, other) -> bool` for each `#derive(Eq)` type, built as IR
    // (`derived_eq_ir`, MYLA-162): structural equality, field by field or tag
    // and payload, through each component's own `eq` (written or derived).
    fun emit_derived_eq(var self) {
        for d in self.decls {
            match d.kind {
                DeclKind.StructDecl(name, fields, attrs, tps, isp, act) => {
                    if tps.len() == 0 && attrs_have_derive_eq(attrs) {
                        let r = derived_eq_ir(self, name, false)
                        self.emit_routine(r.f, d.id, d.line, d.col)
                        self.request_wants(r.wants)
                    }
                },
                DeclKind.EnumDecl(name, variants, attrs, tps, isp) => {
                    if tps.len() == 0 && attrs_have_derive_eq(attrs) {
                        let r = derived_eq_ir(self, name, true)
                        self.emit_routine(r.f, d.id, d.line, d.col)
                        self.request_wants(r.wants)
                    }
                },
                _ => {},
            }
        }
    }

    // A routine `type_jobs` holds (see `type_job_name`), built as IR and
    // emitted, what it calls requested (MYLA-313).
    fun emit_type_job(var self, w: Want) {
        let name = type_job_name(w)
        var r = Routine { f: empty_ir(name), wants: [] }
        if w.kind == 7 { r = compound_eq_ir(self, w.t, name) }
        if w.kind == 8 { r = tuple_hash_ir(self, w.t, name) }
        if w.kind == 9 { r = key_hash_ir(self, w.t, name) }
        if w.kind == 10 { r = key_eq_ir(self, w.t, name) }
        if w.kind == 11 { r = map_find_ir(self, w.t, name) }
        if w.kind == 12 { r = map_put_ir(self, w.t, name) }
        if w.kind == 13 { r = map_keys_ir(self, w.t, name) }
        self.emit_routine(r.f, -1, 0, 0)
        self.request_wants(r.wants)
    }

    // An environment's routine built as IR (`myla_<lifted>_env_…`, the label
    // its callers use), the routines it calls requested.
    fun emit_env_routine(var self, r: Routine) {
        self.emit_routine(r.f, -1, 0, 0)
        self.request_wants(r.wants)
    }

    // A routine built as IR, under the name its callers call (an alias of
    // `myla_<name>`), the routines it calls requested.
    fun emit_wanting(var self, r: Routine) {
        self.emit_routine(r.f, -1, 0, 0)
        self.raw(format("\t.set {}, myla_{}", r.f.name, r.f.name))
        self.request_wants(r.wants)
    }

    // The routines a routine built as IR calls (see `Want`), requested.
    fun request_wants(var self, wants: [Want]) {
        for w in wants {
            if w.kind == 0 { let n0 = self.deep_cell_name(w.t, w.clone) }
            if w.kind == 1 { let n1 = self.register_deep(w.t, w.clone) }
            if w.kind == 2 { let n2 = self.register_deep_inline(w.t, w.clone) }
            if w.kind == 3 { self.register_clone(w.t) }
            if w.kind == 4 { let n4 = self.register_walk(w.t, false) }
            if w.kind == 5 { let n5 = self.register_walk(w.t, true) }
            if w.kind == 6 { self.register_drop(w.t) }
            if w.kind >= 7 {
                // drained with the functions, as it may call some
                let n = type_job_name(w)
                if !self.type_jobs_seen.contains(n) {
                    self.type_jobs_seen[n] = true
                    self.type_jobs.push(w)
                }
            }
        }
    }

    // A routine built as IR for a type (MYLA-162), emitted as a function
    // (`myla_<its name>`) where the type `decl_id` is declared: checked,
    // its small leaf callees inlined, the functions it calls requested.
    fun emit_routine(var self, f: IrFunc, decl_id: int32, line: int32, col: int32) {
        let g = self.take_ir(Ok(Lowered { f: f, lams: [], partials: [], fnvals: [], refused: [], wants: [] }), f.name)
        self.emit_ir_at(g, decl_id, line, col, f.name)
    }

    // -- the cells the runtime and the generated code share (std.rt reads
    // them too) ------------------------------------------------------------
    //
    // List cell layout: [len:8][cap:8][elem0..]. The value pointer points at the
    // length word. Strides are passed in (per element type) so one routine serves
    // every list. Copy-on-write clones are per element type (`__clone_list_*`,
    // `clone_ir`): they retain the elements they share (D38).
    //
    // Map cell: [count:8][cap:8][slot0..][next rank:8]; slot = [state:8][key:8][value…][rank:8]
    // where state 0=empty, 1=occupied, 2=tombstone, and rank is the key's place
    // in the order of insertion (D105, MYLA-179): a new key takes the next rank,
    // a removal leaves a tombstone and a gap in the ranks, and a compaction as the
    // table fills renumbers them 0 … count - 1 (MYLA-310; std.rt's maps). Open
    // addressing, linear probing, multiplicative hashing. cap is a power of two.
    // Copy-on-write clones are per type (`__clone_map_*`, `clone_ir`), copy the
    // whole cell and retain the values they share.
    //
    // StringBuilder cell: [len:8][cap:8][bytes…] (cap is a byte capacity).

    // -- reference-counting helpers (drop / copy-on-write clone) ----------

    // Emit every per-type drop/clone routine reached during code generation.
    // Drop helpers recurse (dropping a list element re-registers its own drop),
    // so we drain `need_drop` as a worklist whose length may grow mid-loop.
    fun emit_drop_helpers(var self) {
        // each helper may ask for others: until none is left
        var i = 0
        var j = 0
        var k = 0
        var dk = 0
        var dc = 0
        while i < self.need_drop.len() || j < self.need_clone.len() || k < self.need_walk.len() || dk < self.need_deep.len() || dc < self.need_deepc.len() {
            while i < self.need_drop.len() {
                let t = self.need_drop[i]
                i = i + 1
                let tok = mono_token(t)
                if list_has_str(self.drop_emitted, tok) { continue }
                self.drop_emitted.push(tok)
                // built as IR (MYLA-162): an entry counting down, and the
                // rest when the count reaches 0
                var free = ""
                free = self.rt_alloc_names().1
                let name = self.drop_call_name(t)
                // a list or map whose entries own nothing: the builder's drop
                if free != "" && self.holds_nothing(t) {
                    self.need_sb = true
                    self.raw(format("\t.set {}, myla___sb_drop", name))
                    continue
                }
                let slow = name + "_slow"
                var atomic = false
                // a type that can nest itself without bound: its release
                // defers past a depth, a kind of `__drop_drain`'s (MYLA-389)
                var kind = -1
                if self.drop_reenters(t) {
                    kind = self.drop_kinds.len() as int32
                    self.drop_kinds.push(slow)
                }
                match t {
                    Type.TList(e) => { self.emit_routine(list_drop_slow_ir(self, e, slow, free, kind), -1, 0, 0) },
                    Type.TMap(k2, v) => { self.emit_routine(map_drop_slow_ir(self, t, slow, free, kind), -1, 0, 0) },
                    Type.TEnum(n, a) => {
                        self.emit_routine(dropb_slow_ir(self, t, "inline", slow, free, kind), -1, 0, 0)
                    },
                    // an actor's cell: its fields, as a struct's (same token)
                    Type.TActor(n, a) => {
                        atomic = self.frames
                        self.emit_routine(dropb_slow_ir(self, Type.TStruct(n, a), "", slow, free, kind), -1, 0, 0)
                    },
                    _ => {},
                }
                self.emit_routine(drop_entry_ir(name, slow, atomic), -1, 0, 0)
                self.raw(format("\t.set {}, myla_{}", name, name))
            }
            while j < self.need_clone.len() {
                let t = self.need_clone[j]
                j = j + 1
                let tok = mono_token(t)
                if list_has_str(self.clone_emitted, tok) { continue }
                self.clone_emitted.push(tok)
                // built as IR (MYLA-162); a list or map whose entries own
                // nothing: the builder's clone
                let name = self.clone_call_name(t)
                if self.holds_nothing(t) {
                    self.need_sb = true
                    self.raw(format("\t.set {}, myla___sb_clone", name))
                    continue
                }
                self.emit_routine(clone_ir(self, t, name), -1, 0, 0)
                self.raw(format("\t.set {}, myla_{}", name, name))
            }
            while dk < self.need_deep.len() {
                let t = self.need_deep[dk]
                let inl = self.deep_inline[dk]
                let cl = self.deep_clone[dk]
                dk = dk + 1
                // built as IR (MYLA-162)
                self.emit_wanting(deep_walk_ir(self, t, cl, inl, self.deep_walk_label(t, cl, inl)))
            }
            while dc < self.need_deepc.len() {
                let t = self.need_deepc[dc]
                let cl = self.deepc_clone[dc]
                dc = dc + 1
                self.emit_wanting(deep_cell_ir(self, t, cl, self.deep_cell_label(t, cl)))
            }
            while k < self.need_walk.len() {
                let t = self.need_walk[k]
                let retain = self.walk_retain[k]
                k = k + 1
                var name = "__walkd_" + mono_token(t)
                if retain { name = "__walkr_" + mono_token(t) }
                if list_has_str(self.walk_emitted, name) { continue }
                self.walk_emitted.push(name)
                // built as IR (MYLA-162), under the alias its callers call
                self.emit_routine(walk_ir(self, t, retain, name), -1, 0, 0)
                self.raw(format("\t.set {}, myla_{}", name, name))
            }
        }
        if self.need_sb { self.emit_sb_rc_helpers() }
        if self.drop_kinds.len() > 0 { self.emit_routine(drop_drain_ir(), -1, 0, 0) }
    }

    // Whether releasing a cell of `t` (a list, map, boxed enum or actor) can
    // release another cell of `t` inside it (MYLA-389): `t` reaches itself
    // through what it owns, so a value can nest it as deep as it likes.
    #test(codegen_on("[int]"), Type.TList(Type.TInt(32, true)))[false]
    #test(codegen_on("struct B { kids: [B] }"), Type.TList(Type.TStruct("B", [])))[true]
    fun drop_reenters(self, t: Type) -> bool {
        let tok = mono_token(t)
        for m in self.cell_members(t) {
            if self.reaches_cell(m, tok, []) { return true }
        }
        return false
    }

    // What a cell of `t` holds: a list's element, a map's key and value, a
    // boxed enum's payloads, an actor's fields.
    #test(codegen_on("[int]"), Type.TMap(Type.TStr, Type.TBool))[[Type.TStr, Type.TBool]]
    #test(codegen_on("[int]"), Type.TStr)[[]]
    fun cell_members(self, t: Type) -> [Type] {
        var out: [Type] = []
        match t {
            Type.TList(e) => { out.push(e) },
            Type.TMap(k, v) => {
                out.push(k)
                out.push(v)
            },
            Type.TEnum(n, a) => {
                let info = self.enum_info(n)
                let sub = self.type_subst(info.type_params, a)
                for v in info.variants { for ft in v.payload { out.push(subst_type(ft, sub)) } }
            },
            Type.TActor(n, a) => {
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                for f in info.fields { out.push(subst_type(f.ty, sub)) }
            },
            _ => {},
        }
        return out
    }

    // Whether a value of `t` holds, inline or through cells, a cell whose
    // type's token is `tok` (`seen`: the cells' tokens already looked into).
    #test(codegen_on("[int]"), Type.TTuple([Type.TStr, Type.TList(Type.TBool)]), ".L5.bool", [])[true]
    #test(codegen_on("[int]"), Type.TList(Type.TStr), ".L5.bool", [])[false]
    fun reaches_cell(self, t: Type, tok: str, seen: [str]) -> bool {
        let cell = self.is_boxed(t) || match t { Type.TList(e) => true, Type.TMap(k, v) => true, Type.TActor(n, a) => true, _ => false }
        if cell {
            let mine = mono_token(t)
            if mine == tok { return true }
            if list_has_str(seen, mine) { return false }
            for m in self.cell_members(t) {
                if self.reaches_cell(m, tok, push_str_copy(seen, mine)) { return true }
            }
            return false
        }
        match t {
            Type.TStruct(n, a) => {
                let info = self.struct_info(n)
                let sub = self.type_subst(info.type_params, a)
                for f in info.fields {
                    if self.reaches_cell(subst_type(f.ty, sub), tok, seen) { return true }
                }
            },
            Type.TEnum(n, a) => {
                for m in self.cell_members(t) {
                    if self.reaches_cell(m, tok, seen) { return true }
                }
            },
            Type.TTuple(es) => {
                for e in es {
                    if self.reaches_cell(e, tok, seen) { return true }
                }
            },
            _ => {},
        }
        return false
    }


    // Builder reference-counting helpers (bytes are scalars: drop just frees).
    fun emit_sb_rc_helpers(var self) {
        // built as IR with std.rt's allocator (MYLA-162)
        self.emit_routine(drop_entry_ir("__sb_drop", self.rt_alloc_names().1, false), -1, 0, 0)
        self.raw("\t.set __sb_drop, myla___sb_drop")
        self.emit_routine(clone_ir(self, Type.TSB, "__sb_clone"), -1, 0, 0)
        self.raw("\t.set __sb_clone, myla___sb_clone")
    }

}

// -- free helpers ---------------------------------------------------------

#test(".L1:")[true]
#test(".L2:")[true]
#test("cld")[false]
pub fun ends_colon(s: str) -> bool {
    let n = s.len()
    return n > 0 && s[n - 1] == 58
}

#test("-")["45"]
#test("zero")["122, 101, 114, 111"]
#test("examples/traits_on_builtins.my")["101, 120, 97, 109, 112, 108, 101, 115, 47, 116, 114, 97, 105, 116, 115, 95, 111, 110, 95, 98, 117, 105, 108, 116, 105, 110, 115, 46, 109, 121"]
fun byte_list(s: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < s.len() {
        if i > 0 { sb.append(", ") }
        sb.append(format("{}", s[i]))
        i = i + 1
    }
    return sb.build()
}

#test([])[""]
#test(["s"])["s"]
#test(["n", "d"])["n\nd"]
fun join_lines(xs: [str]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < xs.len() {
        if i > 0 { sb.append("\n") }
        sb.append(xs[i])
        i = i + 1
    }
    return sb.build()
}

// Whether `sig`'s parameter `i`, of type `t`, is a built-in value's `var
// self` receiver, which gets the address of its caller's place (D144); a
// struct's, tuple's or enum's is an address already, an actor's handle is
// shared.
pub fun recv_by_address(sig: FuncSig, i: int32, t: Type) -> bool {
    return i == 0 && sig.has_decl && is_builtin_value(t) && match sig.decl.receiver { Some(r) => r == "var self", None => false }
}

#test(Type.TSB)[false]
#test(Type.TStr)[false]
#test(Type.TEnum("List", []))[true]
pub fun is_aggregate(t: Type) -> bool {
    return match t {
        Type.TStruct(n, a) => true,
        Type.TTuple(es) => true,
        Type.TEnum(n, a) => true,
        Type.TFunc(ps, r) => true,
        Type.TAsync(f) => true,
        _ => false,
    }
}

#test(Some(Type.TInt(32, true)))[false]
pub fun is_aggregate_opt(ot: Option<Type>) -> bool {
    return match ot { Some(t) => is_aggregate(t), None => false }
}

#test(Type.TTuple([Type.TInt(32, true)]))[[Type.TInt(32, true)]]
#test(Type.TTuple([Type.TStruct("Box", []), Type.TInt(32, true)]))[[Type.TStruct("Box", []), Type.TInt(32, true)]]
