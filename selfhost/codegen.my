    // Freestanding I/O runtime backing the `std` intrinsics (D29): `__write`
    // (write(2)), `__args` (build a [str] from the argc/argv captured at _start)
    // and `__read_file` (open/fstat/read/close into a fresh str cell, errno ->
    // __io_errno_val).
    fun emit_io_runtime(var self) {
        self.raw("__write:")
        self.raw("\tmovq (%rsi), %rdx")
        self.raw("\tleaq 8(%rsi), %rsi")
        self.raw("\tmovq $1, %rax")
        self.raw("\tsyscall")
        self.raw("\tret")
        self.raw("")
        self.raw("__args:")
        self.raw("\tpushq %rbp")
        self.raw("\tmovq %rsp, %rbp")
        self.raw("\tpushq %rbx")
        self.raw("\tpushq %r12")
        self.raw("\tpushq %r13")
        self.raw("\tpushq %r14")
        self.raw("\tpushq %r15")
        self.raw("\tmovq __argc(%rip), %rbx")
        self.raw("\tmovq __argv(%rip), %r12")
        self.raw("\tmovq %rbx, %rdi")
        self.raw("\tshlq $3, %rdi")
        self.raw("\taddq $16, %rdi")
        self.raw("\tcall __alloc")
        self.raw("\tmovq %rax, %r13")
        self.raw("\tmovq %rbx, (%r13)")
        self.raw("\tmovq %rbx, 8(%r13)")
        self.raw("\tleaq 16(%r13), %r15")
        self.raw("\txorq %r14, %r14")
        self.raw(".La_loop:")
        self.raw("\tcmpq %rbx, %r14")
        self.raw("\tjae .La_done")
        self.raw("\tmovq (%r12,%r14,8), %rsi")
        self.raw("\txorq %rcx, %rcx")
        self.raw(".La_strlen:")
        self.raw("\tmovb (%rsi,%rcx), %al")
        self.raw("\ttestb %al, %al")
        self.raw("\tjz .La_haslen")
        self.raw("\tincq %rcx")
        self.raw("\tjmp .La_strlen")
        self.raw(".La_haslen:")
        self.raw("\tpushq %rsi")
        self.raw("\tpushq %rcx")
        self.raw("\tleaq 8(%rcx), %rdi")
        self.raw("\tcall __alloc")
        self.raw("\tpopq %rcx")
        self.raw("\tpopq %rsi")
        self.raw("\tmovq %rcx, (%rax)")
        self.raw("\tleaq 8(%rax), %rdi")
        self.raw(".La_copy:")
