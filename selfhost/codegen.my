        self.raw("\tmovl $-1, %r12d")
        self.raw("\tjmp .Lrun_do_err")
        self.raw(".Lrun_so_data:")
        self.raw("\tmovq %r14, %rdi")
        self.raw("\tleaq -4208(%rbp), %rsi")
        self.raw("\tmovq %rax, %rdx")
        self.raw("\tcall __u8list_append")
        self.raw("\tmovq %rax, %r14")
        self.raw(".Lrun_do_err:")
        self.raw("\tmovzwl -98(%rbp), %eax")
        self.raw("\ttestl %eax, %eax")
        self.raw("\tjz .Lrun_poll")
        self.raw("\tcmpl $-1, %r13d")
        self.raw("\tje .Lrun_poll")
        self.raw("\tmovl %r13d, %edi")
        self.raw("\tleaq -4208(%rbp), %rsi")
        self.raw("\tmovq $4096, %rdx")
        self.raw("\tmovq $0, %rax")
        self.raw("\tsyscall")
        self.raw("\tcmpq $-4, %rax")
        self.raw("\tje .Lrun_poll")
        self.raw("\ttestq %rax, %rax")
        self.raw("\tjg .Lrun_se_data")
        self.raw("\tmovl %r13d, %edi")
        self.raw("\tmovq $3, %rax")
        self.raw("\tsyscall")
        self.raw("\tmovl $-1, %r13d")
        self.raw("\tjmp .Lrun_poll")
        self.raw(".Lrun_se_data:")
        self.raw("\tmovq %r15, %rdi")
        self.raw("\tleaq -4208(%rbp), %rsi")
        self.raw("\tmovq %rax, %rdx")
        self.raw("\tcall __u8list_append")
        self.raw("\tmovq %rax, %r15")
        self.raw("\tjmp .Lrun_poll")
        self.raw(".Lrun_drain_done:")
        self.raw("\tcmpl $-1, %r12d")
        self.raw("\tje .Lrun_dc1")
        self.raw("\tmovl %r12d, %edi")
        self.raw("\tmovq $3, %rax")
        self.raw("\tsyscall")
        self.raw(".Lrun_dc1:")
        self.raw("\tcmpl $-1, %r13d")
        self.raw("\tje .Lrun_dc2")
        self.raw("\tmovl %r13d, %edi")
        self.raw("\tmovq $3, %rax")
        self.raw("\tsyscall")
        self.raw(".Lrun_dc2:")
        self.raw(".Lrun_wait:")
        self.raw("\tmovq -72(%rbp), %rdi")
        self.raw("\tleaq -80(%rbp), %rsi")
        self.raw("\txorq %rdx, %rdx")
        self.raw("\txorq %r10, %r10")
        self.raw("\tmovq $61, %rax")
        self.raw("\tsyscall")
        self.raw("\tcmpq $-4, %rax")
        self.raw("\tje .Lrun_wait")
