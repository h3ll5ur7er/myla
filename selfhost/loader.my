// loader.my -- the self-hosted module loader (MYLA-30): links a program's
// modules the way src/myla/loader.py does (wiki: Architecture/Module-loader).
//
//   1. Load: read, lex and parse each reachable module once, following imports
//      depth-first. parse_ids threads node ids through the modules, so they
//      stay unique across the program (the checker keys its tables by them).
//   2. Module ids: "" for the entry module; otherwise the module's path
//      relative to the project root (or to the stdlib root, `std$…`), every
//      run of other characters turned into `$`.
//   3. Exports: a module's `pub` declarations, plus `pub from` / `pub import …
//      as` re-exports, iterated until nothing changes.
//   4. Bindings: each module's own declarations and what its imports bind.
//   5. Renaming: each reference to a module-level name becomes `id$name`, and
//      an `alias.member` chain folds into the qualified name; local variables
//      and type parameters shadow module names.
//   6. Merge: every module's declarations (imports removed), in load order.
//
// Entry points: `load_program(entry, stdlib_root)` for a single program;
// `load_program_packages(entry, stdlib_root, packages, root)` with the
// build's dependencies as (name, directory) pairs, the `--package name=dir`
// flags (MYLA-92), and a project root ("" for the entry's directory); and
// `load_program_opts(entry, opts)` with every option (`LoadOptions`, from
// `load_options(stdlib_root)`), editor buffers included. An import without
// dots resolves `std.*` in the stdlib root, a package's name in its
// directory as if that were `<name>/` in the project root, anything else in
// the project root and then the stdlib root.

from std.fs import read_to_string, exists, is_dir, current_dir
from .stdroot import is_embedded, embedded_text, EMBEDDED_ROOT
from .parser import parse_source_with, expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of
from .diag import Report, reports, type_report, chain
from .checker import CheckErr, DeclOrigin
from .tokens import SrcSpan, no_span, keywords
from .ast import Program, Decl, DeclKind, FunData, Param, TypeParam, Field, Variant
from .ast import ImportPath, ImportItem, TypeExpr, TypeKind, Expr, ExprKind, FieldInit
from .ast import MapEntry, Stmt, StmtKind, Block, ElseTail, BindElem, ExprOrBlock, Attribute
from .ast import Pattern, PatternKind, FieldPat, MatchArm

// What a name visible in a module refers to: a declaration (`value` is its
// qualified name) or a module (`value` is the module id).
struct Binding { is_module: bool, value: str }

struct Module {
    id: str,
    path: str,
    imports: [Decl],
    targets: [int32],          // index of each import's module
    decls: [Decl],
    exports: [str: Binding],
    bindings: [str: Binding],
}

// The linked program: every module's declarations, the next free node id
// (the checker parses the prelude from there), where each module's node ids
// start, in increasing order (`file_of`), and the impls of the standard
// library's modules by node id, with their module and file (the checker's
// `std_impls`: their methods are the standard library's code, MYLA-320),
// and the functions of an entry file that is one of its modules, whose
// names aren't qualified (MYLA-388: `cancel` in std.task is `task.cancel`).
pub struct Loaded { decls: [Decl], next_id: int32, spans: [Span], std_impls: [int32: DeclOrigin] }

pub struct Span { first_id: int32, path: str }

// The file of node `id` (a declaration a type error names); the entry file for
// an unknown one (-1).
pub fun file_of(prog: Loaded, id: int32) -> str {
    var path = prog.spans[0].path
    for sp in prog.spans {
        if sp.first_id <= id { path = sp.path }
    }
    return path
}

// The type errors `errs` (not empty) of the linked program `prog`, each in its
// declaration's file, as one report (MYLA-65, D80).
pub fun type_errors(prog: Loaded, errs: [CheckErr]) -> Report {
    var rs: [Report] = []
    for e in errs {
        var r = type_report(e.line, e.col, e.sp, e.msg, file_of(prog, e.decl))
        r.notes = e.notes
        rs.push(r)
    }
    return chain(rs)
}

// The warnings `ws` of the linked program `prog` (D95), each in its
// declaration's file, as reports of their own.
pub fun warning_reports(prog: Loaded, ws: [CheckErr]) -> [Report] {
    var rs: [Report] = []
    for w in ws {
        var r = type_report(w.line, w.col, w.sp, w.msg, file_of(prog, w.decl))
        r.kind = "warning"
        r.notes = w.notes
        rs.push(r)
    }
    return rs
}

// How to load a program: the stdlib root ("" for none); the packages, each a
// name and its directory (the project tool passes a package's `src/`); the
// project root, the base of imports without dots ("" for the entry file's
// directory, D57); and texts read instead of files (an editor's unsaved
// buffers, path -> text).
// `runtime`: the runtime written in Myla (`std.rt`, MYLA-162) loaded with the
// program, for a native build.
pub struct LoadOptions { stdlib_root: str, packages: [(str, str)], root: str, overrides: [str: str], runtime: bool }

// The options for a program without packages, rooted at its entry's directory.
#test("")[LoadOptions { stdlib_root: "", packages: [], root: "", overrides: [:], runtime: false }]
#test("/work/myla/lib")[LoadOptions { stdlib_root: "/work/myla/lib", packages: [], root: "", overrides: [:], runtime: false }]
pub fun load_options(stdlib_root: str) -> LoadOptions {
    return LoadOptions { stdlib_root: stdlib_root, packages: [], root: "", overrides: [:], runtime: false }
}

// `opts` for the target `target`: aarch64 Linux takes the standard
// library's `std/platform_aarch64.my` for its `std/platform.my` (MYLA-163),
// wasm32 on WASI `std/platform_wasm.my` (MYLA-158), the smallest form of
// choosing a module per target (MYLA-245). The copy the tools carry is chosen
// too, for the runtime a library without its own takes from them (MYLA-268),
// and a library without the target's file takes theirs.
pub fun for_target(opts: LoadOptions, target: str) -> LoadOptions {
    var file = ""
    if target == "aarch64-linux" { file = "platform_aarch64.my" }
    if target == "wasm32-wasi" { file = "platform_wasm.my" }
    if file == "" { return opts }
    var o = opts
    var carried = ""
    match embedded_text(EMBEDDED_ROOT + "/std/" + file) {
        Some(t) => { carried = t },
        None => {},
    }
    o.overrides[EMBEDDED_ROOT + "/std/platform.my"] = carried
    let path = opts.stdlib_root + "/std/" + file
    var text = carried
    match source_text(path, opts.overrides) {
        Some(t) => { text = t },
        None => {
            match read_to_string(path) {
                Ok(t) => { text = t },
                Err(e) => {},
            }
        },
    }
    o.overrides[opts.stdlib_root + "/std/platform.my"] = text
    return o
}

struct Loader {
    stdlib_root: str,
    project_root: str,
    packages: [(str, str)],    // name, normalized directory
    entry: str,
    modules: [Module],
    next_id: int32,
    spans: [Span],
    overrides: [str: str],     // path -> text used instead of the file (an editor's unsaved buffers)
}

// The modules of the standard library every program sees without an import
// (D164, MYLA-320), as `std.<name>`: the methods of their impls on the
// built-in types, and std.hash's on the prelude's `Hasher` with the `Hash`
// impls of the built-in types (D163, MYLA-313). They are loaded for a
// program whose entry file isn't a module of `std` (whose modules import
// what they use), and bind no name.
#test()[["str", "char", "int", "list", "option", "map", "hash"]]
pub fun implicit_modules() -> [str] {
    return ["str", "char", "int", "list", "option", "map", "hash"]
}

#test([0, 2], 2)[true]
#test([0, 2], 1)[false]
fun has_index(xs: [int32], k: int32) -> bool {
    for x in xs {
        if x == k { return true }
    }
    return false
}

// The order the modules' declarations are merged in: the implicit ones
// first, so that a program's own method of the name of one of theirs is
// the duplicate (and the standard library's the first declared), then the
// others in the order they were loaded.
#test(4, [3, 1])[[3, 1, 0, 2]]
#test(2, [])[[0, 1]]
fun merge_order(n: int32, implicit: [int32]) -> [int32] {
    var out = implicit
    var k: int32 = 0
    while k < n {
        if !has_index(implicit, k) { out.push(k) }
        k += 1
    }
    return out
}

// -- paths ------------------------------------------------------------------

#test([], "A")[false]
#test([], "B")[false]
#test(["T"], "T")[true]
fun has(xs: [str], s: str) -> bool {
    for x in xs {
        if x == s { return true }
    }
    return false
}

// Whether `s` has the byte `b`.
#test("args.Spec", '.')[true]
#test("Spec", '.')[false]
fun contains_byte(s: str, b: uint8) -> bool {
    for i in 0..s.len() {
        if s[i] == b { return true }
    }
    return false
}

#test("examples/maps.my", 47)[["examples", "maps.my"]]
#test("examples/errors/type_match_arms_disagree.my", 47)[["examples", "errors", "type_match_arms_disagree.my"]]
#test("examples/errors/type_literal_past_int8_max_annotated.my/..", 47)[["examples", "errors", "type_literal_past_int8_max_annotated.my", ".."]]
fun split_on(s: str, sep: uint8) -> [str] {
    var parts: [str] = []
    var sb = StringBuilder()
    var i = 0
    while i < s.len() {
        if s[i] == sep {
            parts.push(sb.build())
            sb = StringBuilder()
        } else {
            sb.append_byte(s[i])
        }
        i = i + 1
    }
    parts.push(sb.build())
    return parts
}

#test(["examples"], "/")["examples"]
#test(["examples", "errors", "type_bound_unsatisfied.my"], "/")["examples/errors/type_bound_unsatisfied.my"]
#test(["examples", "errors", "type_literal_past_int8_max_annotated.my"], "/")["examples/errors/type_literal_past_int8_max_annotated.my"]
fun join(parts: [str], sep: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < parts.len() {
        if i > 0 { sb.append(sep) }
        sb.append(parts[i])
        i = i + 1
    }
    return sb.build()
}

// `p` with `.` segments, empty segments and `x/..` pairs removed.
#test("examples/maps.my/..")["examples"]
#test("examples/errors/runtime_map_key_absent.my")["examples/errors/runtime_map_key_absent.my"]
#test("examples/errors/type_literal_past_int8_max_annotated.my")["examples/errors/type_literal_past_int8_max_annotated.my"]
pub fun normalize(p: str) -> str {
    let absolute = p.len() > 0 && p[0] == '/'
    var out: [str] = []
    for seg in split_on(p, '/') {
        if seg == "" || seg == "." {
            continue
        }
        if seg == ".." && out.len() > 0 && out[out.len() - 1] != ".." {
            out.pop()
        } else if seg != ".." || !absolute {
            out.push(seg)
        }
    }
    let joined = join(out, "/")
    if absolute { return "/" + joined }
    if joined == "" { return "." }
    return joined
}

// Whether `path` is a file of the standard library at `root`: their raw
// memory is the library's own (D152), so a check of one as the entry (`myla
// test lib/std/rt.my`, an editor) allows it. Both relative to the working
// directory when they aren't absolute.
#test("lib/std/rt.my", "lib")[true]
#test("./lib/std/rt.my", "lib/")[true]
#test("lib2/std/rt.my", "lib")[false]
#test("prog.my", "lib")[false]
pub fun in_stdlib(path: str, root: str) -> bool {
    if root == EMBEDDED_ROOT { return in_std_tree(path) }
    var p = normalize(path)
    var r = normalize(root)
    let pa = p.len() > 0 && p[0] == '/'
    let ra = r.len() > 0 && r[0] == '/'
    if pa != ra {
        let here = match current_dir() {
            Ok(d) => d,
            Err(e) => { return false },
        }
        if !pa { p = normalize(here + "/" + p) }
        if !ra { r = normalize(here + "/" + r) }
    }
    return r != "." && p.len() > r.len() + 1 && starts_with_text(p, r + "/")
}

// Whether `path` is a module of the standard library rooted at `root`: a
// file under its `std` directory, or with the embedded library under a copy
// of it on disk (in_std_tree). Such an entry file gets no implicit modules
// (MYLA-320); `in_stdlib` takes the whole root, for D152's primitives.
#test("lib/std/json.my", "lib")[true]
#test("lib/prog.my", "lib")[false]
pub fun is_std_module(path: str, root: str) -> bool {
    if root == EMBEDDED_ROOT { return in_std_tree(path) }
    return in_stdlib(path, join_path(root, "std"))
}

// With the embedded library, whether `path` is in a copy of the standard
// library on disk (the repository's lib/std): under a directory `std` that
// holds `rt.my`, which `myla check lib/std/fs.my` checks as `--stdlib lib`
// would.
fun in_std_tree(path: str) -> bool {
    var p = normalize(path)
    if p.len() == 0 || p[0] != '/' {
        let here = match current_dir() {
            Ok(d) => d,
            Err(e) => { return false },
        }
        p = normalize(here + "/" + p)
    }
    var end = p.len() - 1
    while end > 0 {
        if p[end] == '/' {
            var sb = StringBuilder()
            sb.append(p, 0, end)
            let dir = sb.build()
            if ends_with_std(dir) && exists(dir + "/rt.my") { return true }
        }
        end -= 1
    }
    return false
}

// Whether the directory `dir` is named `std`.
#test("/a/lib/std")[true]
#test("/a/libstd")[false]
#test("/std")[true]
fun ends_with_std(dir: str) -> bool {
    let n = dir.len()
    return n >= 4 && dir[n - 4] == '/' && dir[n - 3] == 's' && dir[n - 2] == 't' && dir[n - 1] == 'd'
}

fun starts_with_text(s: str, prefix: str) -> bool {
    if prefix.len() > s.len() { return false }
    var i = 0
    while i < prefix.len() {
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    return true
}

#test("/work/myla/lib")[["work", "myla", "lib"]]
#test("/work/myla/lib/std/task.my")[["work", "myla", "lib", "std", "task.my"]]
#test("/work/myla/lib/std/process.my")[["work", "myla", "lib", "std", "process.my"]]
fun segments(p: str) -> [str] {
    if p == "." { return [] }
    var out: [str] = []
    for seg in split_on(p, '/') {
        if seg != "" { out.push(seg) }
    }
    return out
}

#test("examples/maps.my")["examples"]
#test("examples/errors/lex_bad_char.my")["examples/errors"]
#test("/work/myla/selfhost/main.my")["/work/myla/selfhost"]
fun dirname(p: str) -> str {
    return normalize(p + "/..")
}

#test("examples/errors", "nowhere")["examples/errors/nowhere"]
#test("/work/myla/lib/std", "task.my")["/work/myla/lib/std/task.my"]
#test("/work/myla/lib/std/process", "process.my")["/work/myla/lib/std/process/process.my"]
fun join_path(a: str, b: str) -> str {
    return normalize(a + "/" + b)
}

fun readable(path: str) -> bool {
    return match read_to_string(path) { Ok(s) => true, Err(e) => false }
}

#test(ImportPath { line: 4, col: 6, sp: SrcSpan { sline: 4, scol: 6, eline: 4, ecol: 17 }, dots: 0, segments: ["std", "process"] })["std.process"]
#test(ImportPath { line: 4, col: 8, sp: SrcSpan { sline: 4, scol: 8, eline: 4, ecol: 21 }, dots: 0, segments: ["nowhere", "thing"] })["nowhere.thing"]
fun dotted(p: ImportPath) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < p.dots {
        sb.append(".")
        i = i + 1
    }
    sb.append(join(p.segments, "."))
    return sb.build()
}

// The segments of normalized `path` below normalized `root`, if it is below.
#test("/work/myla/lib/std/task.my", "/work/myla/lib")[Some(["std", "task.my"])]
#test("/work/myla/lib/std/process.my", "/work/myla/lib")[Some(["std", "process.my"])]
fun rel_under(path: str, root: str) -> Option<[str]> {
    let ps = segments(path)
    let rs = segments(root)
    if rs.len() > ps.len() { return None }
    var i = 0
    while i < rs.len() {
        if ps[i] != rs[i] { return None }
        i = i + 1
    }
    var rest: [str] = []
    while i < ps.len() {
        rest.push(ps[i])
        i = i + 1
    }
    return Some(rest)
}

// The module id for path segments `parts` (`.my` dropped): every run of
// characters other than letters, digits and `_` becomes one `$`, with none at
// either end.
#test(["std", "task.my"])["std$task"]
#test(["std", "process.my"])["std$process"]
fun module_tag(parts: [str]) -> str {
    var sb = StringBuilder()
    var pending = false
    for c in strip_ext(join(parts, "/")).chars() {
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
        if ok {
            if pending && sb.build().len() > 0 { sb.append_byte('$') }
            pending = false
            sb.append_byte(c as uint8)
        } else {
            pending = true
        }
    }
    return sb.build()
}

#test("std/task.my")["std/task"]
#test("std/process.my")["std/process"]
fun strip_ext(s: str) -> str {
    let n = s.len()
    if n > 3 && s[n - 3] == '.' && s[n - 2] == 'm' && s[n - 1] == 'y' {
        var sb = StringBuilder()
        var i = 0
        while i < n - 3 {
            sb.append_byte(s[i])
            i = i + 1
        }
        return sb.build()
    }
    return s
}

#test("", "A")["A"]
#test("", "unwrap")["unwrap"]
#test("std$process", "SpawnError")["std$process$SpawnError"]
fun qualify(mid: str, name: str) -> str {
    if mid == "" { return name }
    return mid + "$" + name
}

// The name and `pub` flag of a named top-level declaration (all but `impl`
// and imports).
struct NamedDecl { name: str, is_pub: bool }

fun named(d: Decl) -> Option<NamedDecl> {
    return match d.kind {
        DeclKind.StructDecl(n, f, a, t, p, act) => Some(NamedDecl { name: n, is_pub: p }),
        DeclKind.FunDecl(fd) => Some(NamedDecl { name: fd.name, is_pub: fd.is_pub }),
        DeclKind.EnumDecl(n, v, a, t, p) => Some(NamedDecl { name: n, is_pub: p }),
        DeclKind.TypeAliasDecl(n, t, a, p) => Some(NamedDecl { name: n, is_pub: p }),
        DeclKind.TraitDecl(n, m, t, p, dattrs) => Some(NamedDecl { name: n, is_pub: p }),
        DeclKind.ConstDecl(n, t, v, a, p) => Some(NamedDecl { name: n, is_pub: p }),
        _ => None,
    }
}

// What the named declaration `d` declares, as an error about `m.T` says it.
#test(Decl { id: 0, line: 1, col: 1, sp: no_span(), kind: DeclKind.FunDecl(fun_of("fun f() {}")) })["function"]
fun decl_kind_word(d: Decl) -> str {
    return match d.kind {
        DeclKind.StructDecl(n, f, a, t, p, act) => if act { "actor" } else { "struct" },
        DeclKind.FunDecl(fd) => "function",
        DeclKind.EnumDecl(n, v, a, t, p) => "enum",
        DeclKind.TypeAliasDecl(n, t, a, p) => "type alias",
        DeclKind.TraitDecl(n, m, t, p, dattrs) => "trait",
        DeclKind.ConstDecl(n, t, v, a, p) => "constant",
        _ => "declaration",
    }
}

// Whether a declaration of kind `kind` (`decl_kind_word`) is a type.
#test("struct")[true]
#test("type alias")[true]
#test("function")[false]
fun is_type_kind(kind: str) -> bool {
    return kind == "struct" || kind == "actor" || kind == "enum" || kind == "type alias"
}

// A kind of declaration with its article, for messages: `an enum`.
#test("enum")["an enum"]
#test("function")["a function"]
fun with_article(kind: str) -> str {
    if kind.len() > 0 && (kind[0] == 'a' || kind[0] == 'e' || kind[0] == 'i' || kind[0] == 'o' || kind[0] == 'u') { return "an " + kind }
    return "a " + kind
}

fun is_impl(d: Decl) -> bool {
    return match d.kind {
        DeclKind.ImplDecl(t, ms, tps, tn, ta, attrs) => true,
        _ => false,
    }
}

fun is_fun(d: Decl) -> bool {
    return match d.kind {
        DeclKind.FunDecl(fd) => true,
        _ => false,
    }
}

// The dotted name of the standard library's module at `path`, by the
// segments after its last `std` directory (MYLA-388).
#test("lib/std/task.my")["std.task"]
#test("/a/std/lib/std/text/scan.my")["std.text.scan"]
fun std_module_name(path: str) -> str {
    let segs = segments(strip_ext(normalize(path)))
    var last = -1
    var i = 0
    while i < segs.len() - 1 {
        if segs[i] == "std" { last = i }
        i += 1
    }
    if last < 0 { return "" }
    return join(segs[last:], ".")
}

// The dotted name of the module with id `id` (a standard library's: its
// names have no `$` of their own).
#test("std$str")["std.str"]
#test("std$io")["std.io"]
fun dotted_id(id: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < id.len() {
        if id[i] == '$' { sb.append_byte('.') } else { sb.append_byte(id[i]) }
        i += 1
    }
    return sb.build()
}

fun same_binding(a: Binding, b: Binding) -> bool {
    return a.is_module == b.is_module && a.value == b.value
}

fun at(path: str, line: int32, col: int32, sp: SrcSpan, msg: str) -> Report {
    return Report { kind: "module error", msg: msg, path: path, line: line, col: col, sp: sp, more: [], notes: [] }
}

impl Loader {
    fun readable(self, path: str) -> bool {
        return self.overrides.contains(path) || is_embedded(path) || readable(path)
    }

    fun module_id(self, path: str) -> str {
        if path == self.entry { return "" }
        // the standard library the tools carry (the runtime's fallback)
        match rel_under(path, EMBEDDED_ROOT) {
            Some(rest) => { return module_tag(rest) },
            None => {},
        }
        if self.stdlib_root != "" {
            match rel_under(path, self.stdlib_root) {
                Some(rest) => { return module_tag(rest) },
                None => {},
            }
        }
        // a package's module: as if its directory were `<name>/` in the
        // project root (no fetch paths in names); the innermost one wins
        var best: [str] = []
        for pkg in self.packages {
            match rel_under(path, pkg.1) {
                Some(rest) => {
                    if best.len() == 0 || rest.len() + 1 < best.len() {
                        best = [pkg.0]
                        for r in rest { best.push(r) }
                    }
                },
                None => {},
            }
        }
        if best.len() > 0 { return module_tag(best) }
        match rel_under(path, self.project_root) {
            Some(rest) => { return module_tag(rest) },
            None => {},
        }
        // above the project root (`..` imports): one `up` per level climbed
        let ps = segments(path)
        let rs = segments(self.project_root)
        var common = 0
        while common < ps.len() && common < rs.len() && ps[common] == rs[common] {
            common = common + 1
        }
        var parts: [str] = []
        var i = common
        while i < rs.len() {
            parts.push("up")
            i = i + 1
        }
        i = common
        while i < ps.len() {
            parts.push(ps[i])
            i = i + 1
        }
        return module_tag(parts)
    }

    // The directory of package `name`, if there is one.
    fun package_dir(self, name: str) -> Option<str> {
        for pkg in self.packages {
            if pkg.0 == name { return Some(pkg.1) }
        }
        return None
    }

    fun exists(self, path: str) -> bool {
        return self.overrides.contains(path) || is_embedded(path) || exists(path)
    }

    // The module file for `p` imported from `importer`: `x.my`, or the package
    // root `x/x.my`. No dots: the project root, then the stdlib root (`std.*`
    // only the stdlib root, a package's name only its directory); one dot:
    // the importer's directory; more dots climb one level each.
    fun resolve(self, importer: str, p: ImportPath) -> Result<str, Report> {
        var bases: [str] = []
        if p.dots == 0 {
            let first = p.segments[0]
            match self.package_dir(first) {
                Some(dir) => { return self.resolve_in_package(importer, p, dir) },
                None => {},
            }
            if first != "std" { bases.push(self.project_root) }
            if self.stdlib_root != "" { bases.push(self.stdlib_root) }
        } else {
            var base = dirname(importer)
            var k = 1
            while k < p.dots {
                base = dirname(base)
                k = k + 1
            }
            bases.push(base)
        }
        for base in bases {
            match self.descend(importer, p, base, 0)? {
                Some(file) => { return Ok(file) },
                None => {},
            }
        }
        if p.dots == 0 && p.segments[0] == "std" && self.stdlib_root == "" {
            return Err(at(importer, p.line, p.col, p.sp, format("cannot resolve import '{}': no standard library root was given", dotted(p))))
        }
        // a root named by `--stdlib` or MYLA_STDLIB that isn't there says so
        // (the review of 2026-11-06)
        if p.dots == 0 && p.segments[0] == "std" && self.stdlib_root != EMBEDDED_ROOT && !is_dir(self.stdlib_root) {
            return Err(at(importer, p.line, p.col, p.sp, format("cannot resolve import '{}': the standard library root '{}' (from --stdlib or MYLA_STDLIB) is not a directory", dotted(p), self.stdlib_root)))
        }
        return Err(at(importer, p.line, p.col, p.sp, format("cannot resolve import '{}'", dotted(p))))
    }

    // `p` in the package whose directory is `dir`, as if that were the
    // directory `<name>/` in the project root, which therefore may not have
    // one (MYLA-92): `name` is `dir/name.my`, `name.b.c` is `dir/b/c.my` or
    // `dir/b/c/c.my`.
    fun resolve_in_package(self, importer: str, p: ImportPath, dir: str) -> Result<str, Report> {
        let name = p.segments[0]
        if self.exists(join_path(self.project_root, name)) || self.exists(join_path(self.project_root, name + ".my")) {
            return Err(at(importer, p.line, p.col, p.sp, format("'{}' is a dependency and cannot be shadowed by a project file or directory", name)))
        }
        if p.segments.len() == 1 {
            let root = join_path(dir, name + ".my")
            if self.readable(root) { return Ok(root) }
            return Err(at(importer, p.line, p.col, p.sp, format("package '{}' has no root module '{}.my' in {}", name, name, dir)))
        }
        return match self.descend(importer, p, dir, 1)? {
            Some(file) => Ok(file),
            None => Err(at(importer, p.line, p.col, p.sp, format("cannot resolve import '{}'", dotted(p)))),
        }
    }

    // The module `base/seg/…/last` for the segments of `p` from index
    // `first`: the file `last.my` or the package root `last/last.my`, None if
    // neither exists; both is an error.
    fun descend(self, importer: str, p: ImportPath, base: str, first: int32) -> Result<Option<str>, Report> {
        var dir = base
        var i = first
        while i < p.segments.len() - 1 {
            dir = join_path(dir, p.segments[i])
            i = i + 1
        }
        let last = p.segments[p.segments.len() - 1]
        let file = join_path(dir, last + ".my")
        let pkg = join_path(join_path(dir, last), last + ".my")
        let has_file = self.readable(file)
        let has_pkg = self.readable(pkg)
        if has_file && has_pkg {
            return Err(at(importer, p.line, p.col, p.sp, format("ambiguous import '{}': both '{}.my' and a package '{}/' exist in {}", dotted(p), last, last, dir)))
        }
        if has_file { return Ok(Some(file)) }
        if has_pkg { return Ok(Some(pkg)) }
        return Ok(None)
    }

    // The implicit modules (`implicit_modules`) the standard library in use
    // has, each loaded as an import of it would load it: the index of each
    // module, none for a library without it (an older `--stdlib` directory,
    // or no library at all). No module binds a name of theirs.
    fun load_implicit(var self) -> Result<[int32], Report> {
        var out: [int32] = []
        for name in implicit_modules() {
            let p = ImportPath { line: 0, col: 0, sp: no_span(), dots: 0, segments: ["std", name] }
            match self.descend(self.entry, p, self.stdlib_root, 0)? {
                Some(file) => {
                    let k = self.load(file)?
                    if !has_index(out, k) { out.push(k) }
                },
                None => {},
            }
        }
        return Ok(out)
    }

    // Load `path` and its imports (depth first) once each; its module index.
    fun load(var self, path: str) -> Result<int32, Report> {
        var k = 0
        while k < self.modules.len() {
            if self.modules[k].path == path { return Ok(k) }
            k = k + 1
        }
        var src = ""
        match source_text(path, self.overrides) {
            Some(text) => { src = text },
            None => {
                match read_to_string(path) {
                    Ok(s) => { src = s },
                    Err(e) => { return Err(Report { kind: "module error", msg: format("cannot read module '{}'", path), path: path, line: 0, col: 0, sp: no_span(), more: [], notes: [] }) },
                }
            },
        }
        self.spans.push(Span { first_id: self.next_id, path: path })
        // only the entry's `#test` cases are the program's (MYLA-360): every
        // other module's are skipped unparsed, so that importing std.int,
        // with 2,042, costs nothing for them (MYLA-320, MYLA-396)
        var parsed = match parse_source_with(src, self.next_id, path != self.entry) {
            Ok(x) => x,
            Err(ds) => { return Err(reports(ds, path)) },
        }
        self.next_id = parsed.next_id
        var imports: [Decl] = []
        var decls: [Decl] = []
        for d in parsed.program.decls {
            match d.kind {
                DeclKind.ImportDecl(p, items, alias, isp) => { imports.push(d) },
                _ => { decls.push(d) },
            }
        }
        let idx = self.modules.len() as int32
        self.modules.push(Module { id: self.module_id(path), path: path, imports: imports, targets: [], decls: decls, exports: [:], bindings: [:] })
        var targets: [int32] = []
        for imp in imports {
            match imp.kind {
                DeclKind.ImportDecl(p, items, alias, isp) => {
                    let target = self.resolve(path, p)?
                    targets.push(self.load(target)?)
                },
                _ => {},
            }
        }
        var m = self.modules[idx]
        m.targets = targets
        self.modules[idx] = m
        return Ok(idx)
    }

    fun check_ids(self) -> Result<int32, Report> {
        var seen: [str: str] = [:]
        for m in self.modules {
            if m.id == "" { continue }
            match seen.get(m.id) {
                Some(other) => { return Err(at(m.path, 0, 0, no_span(), format("module id collision '{}' between {} and {}", m.id, other, m.path))) },
                None => {},
            }
            seen[m.id] = m.path
        }
        return Ok(0)
    }

    fun build_exports(var self) {
        var i = 0
        while i < self.modules.len() {
            var m = self.modules[i]
            for d in m.decls {
                match named(d) {
                    Some(nd) => {
                        if nd.is_pub { m.exports[nd.name] = Binding { is_module: false, value: qualify(m.id, nd.name) } }
                    },
                    None => {},
                }
            }
            self.modules[i] = m
            i = i + 1
        }
        // re-exports, until chains of them settle
        var changed = true
        while changed {
            changed = false
            i = 0
            while i < self.modules.len() {
                var m = self.modules[i]
                var k = 0
                while k < m.imports.len() {
                    let src = self.modules[m.targets[k]]
                    match m.imports[k].kind {
                        DeclKind.ImportDecl(p, items, alias, isp) => {
                            if isp {
                                for b in reexports(src, items, alias) {
                                    let cur = m.exports.get(b.name)
                                    let fresh = match cur { Some(c) => !same_binding(c, b.binding), None => true }
                                    if fresh {
                                        m.exports[b.name] = b.binding
                                        changed = true
                                    }
                                }
                            }
                        },
                        _ => {},
                    }
                    k = k + 1
                }
                self.modules[i] = m
                i = i + 1
            }
        }
    }

    fun build_bindings(var self) -> Result<int32, Report> {
        var i = 0
        while i < self.modules.len() {
            var m = self.modules[i]
            var bindings: [str: Binding] = [:]
            for d in m.decls {
                match named(d) {
                    Some(nd) => { bindings[nd.name] = Binding { is_module: false, value: qualify(m.id, nd.name) } },
                    None => {},
                }
            }
            var k = 0
            while k < m.imports.len() {
                let imp = m.imports[k]
                let src = self.modules[m.targets[k]]
                match imp.kind {
                    DeclKind.ImportDecl(p, items, alias, isp) => {
                        for nb in import_bindings(src, p, items, alias) {
                            if nb.missing {
                                return Err(at(m.path, imp.line, imp.col, imp.sp, format("module '{}' does not export '{}' (declarations are private unless marked 'pub')", dotted(p), nb.name)))
                            }
                            let clash = match bindings.get(nb.name) { Some(c) => !same_binding(c, nb.binding), None => false }
                            if clash {
                                return Err(at(m.path, imp.line, imp.col, imp.sp, format("import of '{}' collides with an existing name in this module — rename with 'as'", nb.name)))
                            }
                            bindings[nb.name] = nb.binding
                        }
                    },
                    _ => {},
                }
                k = k + 1
            }
            m.bindings = bindings
            self.modules[i] = m
            i = i + 1
        }
        return Ok(0)
    }
}

// A name an import binds; `missing` when the imported module doesn't export it.
struct NameBinding { name: str, binding: Binding, missing: bool }

// What `pub from src import items` / `pub import src as alias` re-exports
// (names `src` doesn't export yet are skipped: they may settle later).
fun reexports(src: Module, items: Option<[ImportItem]>, alias: Option<str>) -> [NameBinding] {
    var out: [NameBinding] = []
    match items {
        None => {
            let a = alias_or(alias, "")
            if a != "" { out.push(NameBinding { name: a, binding: Binding { is_module: true, value: src.id }, missing: false }) }
        },
        Some(its) => {
            for it in its {
                match src.exports.get(it.name) {
                    Some(b) => { out.push(NameBinding { name: alias_or(it.alias, it.name), binding: b, missing: false }) },
                    None => {},
                }
            }
        },
    }
    return out
}

// What an import binds in the importing module.
fun import_bindings(src: Module, p: ImportPath, items: Option<[ImportItem]>, alias: Option<str>) -> [NameBinding] {
    var out: [NameBinding] = []
    match items {
        None => {
            // `import a.b.c [as x]`: the module, for member access
            let key = alias_or(alias, join(p.segments, "."))
            out.push(NameBinding { name: key, binding: Binding { is_module: true, value: src.id }, missing: false })
        },
        Some(its) => {
            for it in its {
                match src.exports.get(it.name) {
                    Some(b) => { out.push(NameBinding { name: alias_or(it.alias, it.name), binding: b, missing: false }) },
                    None => { out.push(NameBinding { name: it.name, binding: Binding { is_module: false, value: "" }, missing: true }) },
                }
            }
        },
    }
    return out
}

#test(Some("task"), "std.task")["task"]
fun alias_or(alias: Option<str>, name: str) -> str {
    return match alias { Some(a) => a, None => name }
}

// -- renaming ---------------------------------------------------------------

struct Renamer {
    env: [str: str],                    // name -> qualified, for declarations
    aliases: [str: str],                // module access key -> module id
    exports: [str: [str: Binding]],     // module id -> its exports
    vals: [str],                        // local value names in scope
    tys: [str],                         // type parameter names in scope
    path: str,
    err: Option<Report>,
    kinds: [str: str],                  // qualified name -> what it declares ("struct", "function", …), for `m.T` (D170)
}

#test(expr_of("-n * 2"), ExprKind.IntLit(0, None, false, ""))[Expr { id: 3, line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, kind: ExprKind.IntLit(0, None, false, "") }]
fun mk_expr(e: Expr, k: ExprKind) -> Expr {
    return Expr { id: e.id, line: e.line, col: e.col, sp: e.sp, kind: k }
}

// `e` rebuilt with kind `k`, positioned where `pos` is.
#test(expr_of("-n * 2"), expr_of("-n * 2"), ExprKind.Name("std$task$cancel"))[Expr { id: 3, line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, kind: ExprKind.Name("std$task$cancel") }]
fun mk_expr_at(e: Expr, pos: Expr, k: ExprKind) -> Expr {
    return Expr { id: e.id, line: pos.line, col: pos.col, sp: e.sp, kind: k }
}

#test([])[[]]
#test([TypeParam { line: 4, col: 8, sp: SrcSpan { sline: 4, scol: 8, eline: 4, ecol: 9 }, name: "T", bounds: [], bound_args: [] }])[["T"]]
#test([TypeParam { line: 8, col: 6, sp: SrcSpan { sline: 8, scol: 6, eline: 8, ecol: 7 }, name: "T", bounds: [], bound_args: [] }])[["T"]]
fun tp_names(tps: [TypeParam]) -> [str] {
    var out: [str] = []
    for tp in tps { out.push(tp.name) }
    return out
}

#test([BindElem.BName("a", 20, 10, SrcSpan { sline: 20, scol: 10, eline: 20, ecol: 11 }), BindElem.BWild])[["a"]]
#test([BindElem.BName("p", 74, 10, SrcSpan { sline: 74, scol: 10, eline: 74, ecol: 11 }), BindElem.BName("q", 74, 13, SrcSpan { sline: 74, scol: 13, eline: 74, ecol: 14 })])[["p", "q"]]
#test([BindElem.BName("moved", 40, 10, SrcSpan { sline: 40, scol: 10, eline: 40, ecol: 15 }), BindElem.BName("amount", 40, 17, SrcSpan { sline: 40, scol: 17, eline: 40, ecol: 23 })])[["moved", "amount"]]
fun bind_names(bs: [BindElem]) -> [str] {
    var out: [str] = []
    for b in bs {
        match b {
            BindElem.BName(n, l, c, sp) => { out.push(n) },
            BindElem.BTuple(sub, l, c, sp) => { for n in bind_names(sub) { out.push(n) } },
            _ => {},
        }
    }
    return out
}

#test(Pattern { id: 4, line: 6, col: 9, sp: SrcSpan { sline: 6, scol: 9, eline: 6, ecol: 10 }, kind: PatternKind.PWild })[[]]
#test(Pattern { id: 158, line: 61, col: 13, sp: SrcSpan { sline: 61, scol: 13, eline: 61, ecol: 14 }, kind: PatternKind.PBind("e") })[["e"]]
#test(Pattern { id: 94, line: 66, col: 34, sp: SrcSpan { sline: 66, scol: 34, eline: 66, ecol: 38 }, kind: PatternKind.PBind("code") })[["code"]]
fun pattern_binds(p: Pattern) -> [str] {
    var out: [str] = []
    match p.kind {
        PatternKind.PBind(n) => { out.push(n) },
        PatternKind.PEnum(en, v, elems, hp) => { for q in elems { for n in pattern_binds(q) { out.push(n) } } },
        PatternKind.PTuple(elems) => { for q in elems { for n in pattern_binds(q) { out.push(n) } } },
        PatternKind.PStruct(t, fps) => { for fp in fps { for n in pattern_binds(fp.pattern) { out.push(n) } } },
        PatternKind.POr(alts) => { if alts.len() > 0 { out = pattern_binds(alts[0]) } },
        _ => {},
    }
    return out
}

impl Renamer {
    fun fail(var self, line: int32, col: int32, sp: SrcSpan, msg: str) {
        match self.err {
            None => { self.err = Some(at(self.path, line, col, sp, msg)) },
            Some(e) => {},
        }
    }

    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: ["x"], tys: ["Self"], path: "examples/variables.my", err: None, kinds: [:] }, "str")["str"]
    #test(Renamer { env: ["P": "P", "main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/errors/type_recover_unknown_trait_impl.my", err: None, kinds: [:] }, "Show")["Show"]
    #test(Renamer { env: ["Clock": "Clock", "Watch": "Watch", "main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/errors/type_become_mutating_receiver.my", err: None, kinds: [:] }, "Watch")["Watch"]
    fun type_name(self, n: str) -> str {
        if !has(self.tys, n) {
            match self.env.get(n) { Some(q) => { return q }, None => {} }
        }
        return n
    }

    // -- declarations --

    fun decl(var self, d: Decl, mid: str) -> Decl {
        let k = match d.kind {
            DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => {
                self.tys = tp_names(tps)
                var fs: [Field] = []
                for f in fields { fs.push(Field { line: f.line, col: f.col, sp: f.sp, name: f.name, ty: self.ty(f.ty) }) }
                self.tys = []
                DeclKind.StructDecl(qualify(mid, n), fs, attrs, tps, isp, act)
            },
            DeclKind.EnumDecl(n, variants, attrs, tps, isp) => {
                self.tys = tp_names(tps)
                var vs: [Variant] = []
                for v in variants { vs.push(Variant { line: v.line, col: v.col, sp: v.sp, name: v.name, payload: self.ty_list(v.payload) }) }
                self.tys = []
                DeclKind.EnumDecl(qualify(mid, n), vs, attrs, tps, isp)
            },
            DeclKind.TypeAliasDecl(n, t, attrs, isp) => DeclKind.TypeAliasDecl(qualify(mid, n), self.ty(t), attrs, isp),
            DeclKind.ConstDecl(n, t, v, attrs, isp) => {
                self.vals = []
                DeclKind.ConstDecl(qualify(mid, n), self.ty(t), self.expr(v), attrs, isp)
            },
            DeclKind.FunDecl(fd) => DeclKind.FunDecl(self.function(fd, qualify(mid, fd.name), false, [])),
            DeclKind.TraitDecl(n, methods, tps, isp, dattrs) => {
                var ms: [FunData] = []
                for m in methods { ms.push(self.signature(m)) }
                DeclKind.TraitDecl(qualify(mid, n), ms, tps, isp, dattrs)
            },
            DeclKind.ImplDecl(target, methods, tps, itrait, targs, dattrs) => {
                self.tys = tp_names(tps)
                self.tys.push("Self")
                let target2 = self.ty(target)
                let targs2 = self.ty_list(targs)
                var trait2 = itrait
                match itrait {
                    Some(tn) => {
                        if contains_byte(tn, '.') { trait2 = Some(self.module_type(tn, target, false)) } else { trait2 = Some(self.type_name(tn)) }
                    },
                    None => {},
                }
                let tps2 = self.bounds(tps)
                self.tys = []
                var ms: [FunData] = []
                for m in methods { ms.push(self.function(m, m.name, true, tp_names(tps))) }
                DeclKind.ImplDecl(target2, ms, tps2, trait2, targs2, dattrs)
            },
            _ => d.kind,
        }
        return Decl { id: d.id, line: d.line, col: d.col, sp: d.sp, kind: k }
    }

    // type parameters with their bounds (trait names) renamed
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/hello.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/loops.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/variables.my", err: None, kinds: [:] }, [])[[]]
    fun bounds(var self, tps: [TypeParam]) -> [TypeParam] {
        var out: [TypeParam] = []
        for tp in tps {
            var bs: [str] = []
            for b in tp.bounds {
                // `T: json.ToJson`, a module's trait (MYLA-398), reported at
                // its type parameter: a bound keeps no position of its own
                if contains_byte(b, '.') { bs.push(self.module_type(b, TypeExpr { id: -1, line: tp.line, col: tp.col, sp: tp.sp, kind: TypeKind.TRef(b, []) }, false)) } else { bs.push(self.type_name(b)) }
            }
            // a generic trait's arguments are types (D171)
            var bargs: [[TypeExpr]] = []
            for a in tp.bound_args { bargs.push(self.ty_list(a)) }
            out.push(TypeParam { line: tp.line, col: tp.col, sp: tp.sp, name: tp.name, bounds: bs, bound_args: bargs })
        }
        return out
    }

    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/hello.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/loops.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/variables.my", err: None, kinds: [:] }, [])[[]]
    fun params(var self, ps: [Param]) -> [Param] {
        var out: [Param] = []
        for p in ps {
            // a default's names are its declaration's module's (D136)
            let d: Option<Expr> = match p.default { Some(x) => Some(self.expr(x)), None => None }
            out.push(Param { line: p.line, col: p.col, sp: p.sp, name: p.name, ty: self.opt_ty(p.ty), default: d })
        }
        return out
    }

    // a trait method: only its signature has names to rename
    fun signature(var self, m: FunData) -> FunData {
        let saved = self.tys
        self.tys = tp_names(m.type_params)
        self.tys.push("Self")
        let ps = self.params(m.params)
        let rt = self.opt_ty(m.ret_type)
        self.tys = saved
        return FunData { line: m.line, col: m.col, sp: m.sp, name: m.name, params: ps, ret_type: rt, body: m.body, attributes: m.attributes, type_params: m.type_params, receiver: m.receiver, is_pub: m.is_pub, is_async: m.is_async }
    }

    fun function(var self, fd: FunData, name: str, receiver: bool, impl_params: [str]) -> FunData {
        let saved = self.tys
        self.tys = tp_names(fd.type_params)
        for t in impl_params { self.tys.push(t) }
        self.tys.push("Self")
        let ps = self.params(fd.params)
        let rt = self.opt_ty(fd.ret_type)
        let tps = self.bounds(fd.type_params)
        self.vals = []
        let attrs = self.attributes(fd.attributes)
        for p in fd.params { self.vals.push(p.name) }
        if receiver { self.vals.push("self") }
        var body = fd.body
        match fd.body { Some(b) => { body = Some(self.block(b)) }, None => {} }
        self.vals = []
        self.tys = saved
        return FunData { line: fd.line, col: fd.col, sp: fd.sp, name: name, params: ps, ret_type: rt, body: body, attributes: attrs, type_params: tps, receiver: fd.receiver, is_pub: fd.is_pub, is_async: fd.is_async }
    }

    // `#test` cases are expressions in the module's scope (MYLA-11)
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/hello.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/loops.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/variables.my", err: None, kinds: [:] }, [])[[]]
    fun attributes(var self, attrs: [Attribute]) -> [Attribute] {
        var out: [Attribute] = []
        for a in attrs {
            if a.name != "test" {
                out.push(a)
                continue
            }
            var args: [Expr] = []
            for x in a.args { args.push(self.expr(x)) }
            var outputs: Option<[Expr]> = None
            match a.outputs {
                Some(os) => {
                    var renamed: [Expr] = []
                    for o in os { renamed.push(self.expr(o)) }
                    outputs = Some(renamed)
                },
                None => {},
            }
            out.push(Attribute { line: a.line, col: a.col, sp: a.sp, name: a.name, args: args, outputs: outputs, label: a.label })
        }
        return out
    }

    // -- types --

    #test(Renamer { env: ["add": "add", "inc_byte": "inc_byte", "run": "run"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/attributes.my", err: None, kinds: [:] }, type_expr_of("int"))[TypeExpr { id: 0, line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 4 }, kind: TypeKind.TRef("int", []) }]
    fun ty(var self, t: TypeExpr) -> TypeExpr {
        let k = match t.kind {
            TypeKind.TRef(n, args) => {
                let q = if contains_byte(n, '.') { self.module_type(n, t, true) } else { self.type_name(n) }
                TypeKind.TRef(q, self.ty_list(args))
            },
            TypeKind.TTuple(es) => TypeKind.TTuple(self.ty_list(es)),
            TypeKind.TList(e) => TypeKind.TList(self.ty(e)),
            TypeKind.TMap(a, b) => TypeKind.TMap(self.ty(a), self.ty(b)),
            TypeKind.TFn(ps, r, asy) => TypeKind.TFn(self.ty_list(ps), self.ty(r), asy),
        }
        return TypeExpr { id: t.id, line: t.line, col: t.col, sp: t.sp, kind: k }
    }

    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: ["x"], tys: ["Self"], path: "examples/variables.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["P": "P"], aliases: [:], exports: ["": [:]], vals: [], tys: [], path: "examples/errors/type_reassign_self.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["P": "P"], aliases: [:], exports: ["": [:]], vals: [], tys: [], path: "examples/errors/type_method_duplicate.my", err: None, kinds: [:] }, [])[[]]
    fun ty_list(var self, ts: [TypeExpr]) -> [TypeExpr] {
        var out: [TypeExpr] = []
        for t in ts { out.push(self.ty(t)) }
        return out
    }

    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/hello.my", err: None, kinds: [:] }, None)[None]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/loops.my", err: None, kinds: [:] }, None)[None]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/variables.my", err: None, kinds: [:] }, None)[None]
    fun opt_ty(var self, t: Option<TypeExpr>) -> Option<TypeExpr> {
        return match t { Some(x) => Some(self.ty(x)), None => None }
    }

    // `m.T` in a type (D170): the qualified name of the type `T` that the
    // module bound as `m` exports, as `from m import T` would bind it. `m`
    // is the longest prefix that names a module (`std.deque.Deque` after
    // `import std.deque`); a segment after it may be a module the one before
    // re-exports (`shapes.dq.Deque`). With `want_type` false, a trait (the
    // trait of `impl m.Show for P`).
    fun module_type(var self, n: str, t: TypeExpr, want_type: bool) -> str {
        let parts = split_on(n, '.')
        var k = parts.len() - 1
        var mid = ""
        while k >= 1 && mid == "" {
            match self.aliases.get(join(parts[:k], ".")) {
                Some(m) => { mid = m },
                None => { k -= 1 },
            }
        }
        if mid == "" {
            let kind = if want_type { "type" } else { "trait" }
            self.fail(t.line, t.col, t.sp, format("unknown module '{}' in the {} '{}': a {} of another module is named through its 'import … as {}'", parts[0], kind, n, kind, parts[0]))
            return n
        }
        while k < parts.len() {
            let name = parts[k]
            let last = k == parts.len() - 1
            var exports: [str: Binding] = [:]
            match self.exports.get(mid) { Some(x) => { exports = x }, None => {} }
            match exports.get(name) {
                Some(b) => {
                    if b.is_module {
                        if last {
                            self.fail(t.line, t.col, t.sp, format("'{}' is a module, not a type", n))
                            return n
                        }
                        mid = b.value
                    } else {
                        let kind = match self.kinds.get(b.value) { Some(w) => w, None => "declaration" }
                        let fits = if want_type { is_type_kind(kind) } else { kind == "trait" }
                        if !last || !fits {
                            let what = if want_type { "a type" } else { "a trait" }
                            self.fail(t.line, t.col, t.sp, format("'{}' is {} of module '{}', not {}", join(parts[:k + 1], "."), with_article(kind), dotted_id(mid), what))
                            return n
                        }
                        return b.value
                    }
                },
                None => {
                    let what = if want_type { "a type" } else { "a trait" }
                    self.fail(t.line, t.col, t.sp, format("module '{}' does not export {} '{}' (declarations are private unless marked 'pub')", dotted_id(mid), what, name))
                    return n
                },
            }
            k += 1
        }
        return n
    }

    // -- statements --

    #test(Renamer { env: ["add": "add", "inc_byte": "inc_byte", "run": "run"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/attributes.my", err: None, kinds: [:] }, block_of("{ }"))[Block { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 4 }, stmts: [] }]
    fun block(var self, b: Block) -> Block {
        let saved = self.vals
        var out: [Stmt] = []
        for s in b.stmts { out.push(self.stmt(s)) }
        self.vals = saved
        return Block { line: b.line, col: b.col, sp: b.sp, stmts: out }
    }

    #test(Renamer { env: ["add": "add", "inc_byte": "inc_byte", "run": "run"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/attributes.my", err: None, kinds: [:] }, stmt_of("return a"))[Stmt { id: 1, line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 9 }, kind: StmtKind.ReturnS(Some(Expr { id: 0, line: 1, col: 8, sp: SrcSpan { sline: 1, scol: 8, eline: 1, ecol: 9 }, kind: ExprKind.Name("a") }), false) }]
    fun stmt(var self, s: Stmt) -> Stmt {
        let k = match s.kind {
            StmtKind.VarDecl(kind, n, t, init) => {
                let init2 = self.expr(init)
                let t2 = self.opt_ty(t)
                self.vals.push(n)
                StmtKind.VarDecl(kind, n, t2, init2)
            },
            StmtKind.DestructDecl(kind, bs, t, init) => {
                let init2 = self.expr(init)
                let t2 = self.opt_ty(t)
                for n in bind_names([bs]) { self.vals.push(n) }
                StmtKind.DestructDecl(kind, bs, t2, init2)
            },
            StmtKind.Assign(target, value) => {
                let t2 = self.expr(target)
                StmtKind.Assign(t2, self.expr(value))
            },
            StmtKind.IfS(c, then, otherwise) => {
                let c2 = self.expr(c)
                let then2 = self.block(then)
                StmtKind.IfS(c2, then2, self.else_tail(otherwise))
            },
            StmtKind.WhileS(c, body) => {
                let c2 = self.expr(c)
                StmtKind.WhileS(c2, self.block(body))
            },
            StmtKind.ForS(v, start, end, body, iter) => {
                let start2 = self.opt_expr(start)
                let end2 = self.opt_expr(end)
                let iter2 = self.opt_expr(iter)
                let saved = self.vals
                self.vals.push(v)
                let body2 = self.block(body)
                self.vals = saved
                StmtKind.ForS(v, start2, end2, body2, iter2)
            },
            StmtKind.ReturnS(v, tail) => StmtKind.ReturnS(self.opt_expr(v), tail),
            StmtKind.ExprStmt(x) => StmtKind.ExprStmt(self.expr(x)),
            StmtKind.DeferS(body) => StmtKind.DeferS(self.block(body)),
            _ => s.kind,
        }
        return Stmt { id: s.id, line: s.line, col: s.col, sp: s.sp, kind: k }
    }

    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/errors/type_if_cond_not_bool.my", err: None, kinds: [:] }, None)[None]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/errors/type_continue_outside_loop.my", err: None, kinds: [:] }, None)[None]
    #test(Renamer { env: ["f": "f", "main": "main"], aliases: [:], exports: ["": [:]], vals: ["n"], tys: ["Self"], path: "examples/errors/type_missing_return_path.my", err: None, kinds: [:] }, None)[None]
    fun else_tail(var self, t: Option<ElseTail>) -> Option<ElseTail> {
        return match t {
            Some(ElseTail.ElseBlock(b)) => Some(ElseTail.ElseBlock(self.block(b))),
            Some(ElseTail.ElseIf(s)) => Some(ElseTail.ElseIf(self.stmt(s))),
            _ => None,
        }
    }

    fun body(var self, b: ExprOrBlock) -> ExprOrBlock {
        return match b {
            ExprOrBlock.EB_Expr(x) => ExprOrBlock.EB_Expr(self.expr(x)),
            ExprOrBlock.EB_Block(bl) => ExprOrBlock.EB_Block(self.block(bl)),
        }
    }

    // -- expressions --

    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/errors/runtime_pop_empty.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/errors/runtime_str_range_oob.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: [], tys: ["Self"], path: "examples/errors/type_list_empty_no_type.my", err: None, kinds: [:] }, [])[[]]
    fun exprs(var self, es: [Expr]) -> [Expr] {
        var out: [Expr] = []
        for e in es { out.push(self.expr(e)) }
        return out
    }

    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: ["sum"], tys: ["Self"], path: "examples/loops.my", err: None, kinds: [:] }, None)[None]
    #test(Renamer { env: ["main": "main"], aliases: [:], exports: ["": [:]], vals: ["n"], tys: ["Self"], path: "examples/errors/type_for_in_non_list.my", err: None, kinds: [:] }, None)[None]
    #test(Renamer { env: ["average": "average", "main": "main"], aliases: [:], exports: ["": [:]], vals: ["xs", "sum"], tys: ["Self"], path: "examples/floats.my", err: None, kinds: [:] }, None)[None]
    fun opt_expr(var self, e: Option<Expr>) -> Option<Expr> {
        return match e { Some(x) => Some(self.expr(x)), None => None }
    }

    fun expr(var self, e: Expr) -> Expr {
        match e.kind {
            ExprKind.Name(n) => {
                // a type parameter is the function's, as in `T.zero()` (D172)
                if !has(self.vals, n) && !has(self.tys, n) {
                    match self.env.get(n) { Some(q) => { return mk_expr(e, ExprKind.Name(q)) }, None => {} }
                    match self.aliases.get(n) {
                        Some(m) => { self.fail(e.line, e.col, e.sp, format("module '{}' cannot be used as a value — access a member with '{}.<name>'", n, n)) },
                        None => {},
                    }
                }
                return e
            },
            ExprKind.GetField(target, f) => {
                match self.module_access(e) { Some(r) => { return r }, None => {} }
                return mk_expr(e, ExprKind.GetField(self.expr(target), f))
            },
            ExprKind.MatchE(scrut, arms) => {
                let scrut2 = self.expr(scrut)
                var arms2: [MatchArm] = []
                for a in arms {
                    let saved = self.vals
                    let pat = self.pattern(a.pattern)
                    for n in pattern_binds(a.pattern) { self.vals.push(n) }
                    let guard = self.opt_expr(a.guard)
                    let body = self.body(a.body)
                    self.vals = saved
                    arms2.push(MatchArm { line: a.line, col: a.col, sp: a.sp, pattern: pat, guard: guard, body: body })
                }
                return mk_expr(e, ExprKind.MatchE(scrut2, arms2))
            },
            ExprKind.Lambda(ps, rt, body, asy) => {
                let saved = self.vals
                var ps2: [Param] = []
                for p in ps {
                    ps2.push(Param { line: p.line, col: p.col, sp: p.sp, name: p.name, ty: self.opt_ty(p.ty), default: None })
                    self.vals.push(p.name)
                }
                let rt2 = self.opt_ty(rt)
                let body2 = self.body(body)
                self.vals = saved
                return mk_expr(e, ExprKind.Lambda(ps2, rt2, body2, asy))
            },
            _ => {},
        }
        let k = match e.kind {
            ExprKind.Unary(op, x) => ExprKind.Unary(op, self.expr(x)),
            ExprKind.Await(x) => ExprKind.Await(self.expr(x)),
            ExprKind.Binary(op, a, b) => {
                let a2 = self.expr(a)
                ExprKind.Binary(op, a2, self.expr(b))
            },
            ExprKind.Call(c, args, targs) => {
                let c2 = self.expr(c)
                let args2 = self.exprs(args)
                ExprKind.Call(c2, args2, self.ty_list(targs))
            },
            ExprKind.StructLit(n, fields) => {
                var fs: [FieldInit] = []
                for f in fields { fs.push(FieldInit { line: f.line, col: f.col, sp: f.sp, name: f.name, value: self.expr(f.value) }) }
                ExprKind.StructLit(self.type_name(n), fs)
            },
            ExprKind.TupleLit(es) => ExprKind.TupleLit(self.exprs(es)),
            ExprKind.TupleIndex(t, i) => ExprKind.TupleIndex(self.expr(t), i),
            ExprKind.ListLit(es) => ExprKind.ListLit(self.exprs(es)),
            ExprKind.MapLit(entries) => {
                var es: [MapEntry] = []
                for en in entries {
                    let key = self.expr(en.key)
                    es.push(MapEntry { key: key, value: self.expr(en.value) })
                }
                ExprKind.MapLit(es)
            },
            ExprKind.Index(t, i) => {
                let t2 = self.expr(t)
                ExprKind.Index(t2, self.expr(i))
            },
            ExprKind.Try(x) => ExprKind.Try(self.expr(x)),
            ExprKind.Cast(x, t) => {
                let x2 = self.expr(x)
                ExprKind.Cast(x2, self.ty(t))
            },
            _ => e.kind,
        }
        return mk_expr(e, k)
    }

    // `alias.member[.field…]`: the module prefix (the longest one that names a
    // module) folds into the qualified member; what follows stays field
    // accesses. The new nodes reuse the ids of the ones they replace.
    #test(Renamer { env: ["Account": "Account", "fetch": "fetch", "deposit_ones": "deposit_ones", "main": "main"], aliases: [:], exports: ["": [:]], vals: ["self"], tys: ["Self"], path: "examples/concurrency.my", err: None, kinds: [:] }, expr_of("-n * 2"))[None]
    fun module_access(var self, e: Expr) -> Option<Expr> {
        var names: [str] = []       // field names, outermost first
        var nodes: [Expr] = []      // their GetField nodes
        var cur = e
        var walking = true
        while walking {
            match cur.kind {
                ExprKind.GetField(t, f) => {
                    names.push(f)
                    nodes.push(cur)
                    cur = t
                },
                _ => { walking = false },
            }
        }
        var root = ""
        match cur.kind { ExprKind.Name(n) => { root = n }, _ => { return None } }
        if has(self.vals, root) || has(self.tys, root) { return None }
        let cnt = names.len() as int32
        // segment s (innermost first) is names[cnt - 1 - s]
        var k = cnt
        var key = ""
        var mid = ""
        var found = false
        while k >= 0 && !found {
            key = root
            var s = 0
            while s < k {
                key = key + "." + names[cnt - 1 - s]
                s = s + 1
            }
            match self.aliases.get(key) {
                Some(m) => {
                    mid = m
                    found = true
                },
                None => { k = k - 1 },
            }
        }
        if !found { return None }
        if k == cnt {
            self.fail(cur.line, cur.col, cur.sp, format("module '{}' cannot be used as a value — access a member with '.<name>'", key))
            return Some(e)
        }
        var s = k
        var qualified = ""
        while s < cnt && qualified == "" {
            let name = names[cnt - 1 - s]
            var exports: [str: Binding] = [:]
            match self.exports.get(mid) { Some(x) => { exports = x }, None => {} }
            match exports.get(name) {
                Some(b) => {
                    if b.is_module { mid = b.value } else { qualified = b.value }
                },
                None => {
                    self.fail(cur.line, cur.col, cur.sp, format("module does not export '{}' (declarations are private unless marked 'pub')", name))
                    return Some(e)
                },
            }
            s = s + 1
        }
        if qualified == "" {
            self.fail(cur.line, cur.col, cur.sp, "a module reference must end in a member access")
            return Some(e)
        }
        // positioned at the root name, as the Python loader does; each node
        // spans the access it replaces (MYLA-65)
        var node = mk_expr_at(nodes[cnt - s], cur, ExprKind.Name(qualified))
        while s < cnt {
            node = mk_expr_at(nodes[cnt - 1 - s], cur, ExprKind.GetField(node, names[cnt - 1 - s]))
            s = s + 1
        }
        return Some(node)
    }

    // -- patterns: enum and struct names --

    #test(Renamer { env: ["Shape": "Shape", "f": "f", "main": "main"], aliases: [:], exports: ["": [:]], vals: ["s"], tys: ["Self"], path: "examples/errors/type_match_arms_disagree.my", err: None, kinds: [:] }, [])[[]]
    #test(Renamer { env: ["Shape": "Shape", "f": "f", "main": "main"], aliases: [:], exports: ["": [:]], vals: ["s"], tys: ["Self"], path: "examples/errors/type_match_nonexhaustive.my", err: None, kinds: [:] }, [])[[]]
    fun patterns(var self, ps: [Pattern]) -> [Pattern] {
        var out: [Pattern] = []
        for p in ps { out.push(self.pattern(p)) }
        return out
    }

    #test(Renamer { env: ["big": "big", "size": "size", "main": "main"], aliases: [:], exports: ["": [:]], vals: ["n"], tys: ["Self"], path: "examples/errors/type_await_in_guard.my", err: None, kinds: [:] }, pattern_of("_"))[Pattern { id: 0, line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, kind: PatternKind.PWild }]
    fun pattern(var self, p: Pattern) -> Pattern {
        let k = match p.kind {
            PatternKind.PLit(x) => PatternKind.PLit(self.expr(x)),
            PatternKind.PEnum(en, v, elems, hp) => {
                var en2 = en
                match en { Some(n) => { en2 = Some(self.type_name(n)) }, None => {} }
                PatternKind.PEnum(en2, v, self.patterns(elems), hp)
            },
            PatternKind.PTuple(elems) => PatternKind.PTuple(self.patterns(elems)),
            PatternKind.PStruct(n, fps) => {
                var fps2: [FieldPat] = []
                for fp in fps { fps2.push(FieldPat { line: fp.line, col: fp.col, sp: fp.sp, name: fp.name, pattern: self.pattern(fp.pattern) }) }
                PatternKind.PStruct(self.type_name(n), fps2)
            },
            PatternKind.POr(alts) => PatternKind.POr(self.patterns(alts)),
            _ => p.kind,
        }
        return Pattern { id: p.id, line: p.line, col: p.col, sp: p.sp, kind: k }
    }
}

#test([:])[[:]]
#test(["Counter": Binding { is_module: false, value: "Counter" }, "main": Binding { is_module: false, value: "main" }])[["Counter": "Counter", "main": "main"]]
#test(["twice": Binding { is_module: false, value: "twice" }, "wrong": Binding { is_module: false, value: "wrong" }, "main": Binding { is_module: false, value: "main" }])[["twice": "twice", "wrong": "wrong", "main": "main"]]
fun decl_env(bindings: [str: Binding]) -> [str: str] {
    var out: [str: str] = [:]
    for k in bindings.keys() {
        let b = bindings[k]
        if !b.is_module { out[k] = b.value }
    }
    return out
}

#test([:])[[:]]
#test(["P": Binding { is_module: false, value: "P" }])[[:]]
#test(["outer": Binding { is_module: false, value: "outer" }, "main": Binding { is_module: false, value: "main" }, "task": Binding { is_module: true, value: "std$task" }])[["task": "std$task"]]
fun module_env(bindings: [str: Binding]) -> [str: str] {
    var out: [str: str] = [:]
    for k in bindings.keys() {
        let b = bindings[k]
        if b.is_module { out[k] = b.value }
    }
    return out
}

// The text `path` has before its file's: an editor's unsaved buffer
// (`overrides`), or the embedded standard library's (MYLA-243).
pub fun source_text(path: str, overrides: [str: str]) -> Option<str> {
    match overrides.get(path) {
        Some(text) => { return Some(text) },
        None => {},
    }
    return embedded_text(path)
}

// A module error without a position (the package list's).
#test("a")[Report { kind: "module error", msg: "a", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] }]
#test("d2")[Report { kind: "module error", msg: "d2", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] }]
#test("right")[Report { kind: "module error", msg: "right", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] }]
fun list_error(msg: str) -> Report {
    return Report { kind: "module error", msg: msg, path: "", line: 0, col: 0, sp: no_span(), more: [], notes: [] }
}

// `name=dir`, the value of a `--package` flag, as a (name, dir) pair for
// `LoadOptions.packages`; the name ends at the first `=`. Loading checks the
// pair.
#test("geo=a=b")[Ok(("geo", "a=b"))]
pub fun parse_package_flag(text: str) -> Result<(str, str), Report> {
    var i = 0
    while i < text.len() {
        if text[i] == '=' {
            var name = StringBuilder()
            name.append(text, 0, i)
            var dir = StringBuilder()
            dir.append(text, i + 1, text.len())
            return Ok((name.build(), dir.build()))
        }
        i = i + 1
    }
    return Err(list_error(format("malformed --package '{}': expected name=dir", text)))
}

// Whether `name` can name a package: an ASCII letter, then ASCII letters,
// digits and `_`, and not a keyword (the manifest's rule).
#test("geo_2")[true]
#test("2geo")[false]
#test("")[false]
#test("match")[false]
fun valid_package_name(name: str) -> bool {
    if name.len() == 0 || has(keywords(), name) { return false }
    var i = 0
    while i < name.len() {
        let c = name[i]
        let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        if !letter && (i == 0 || !((c >= '0' && c <= '9') || c == '_')) { return false }
        i = i + 1
    }
    return true
}

// The packages with normalized directories, or the first error in the list:
// a package named `std`, a name that can't start an import, a name given
// twice, a missing directory.
#test([])[Ok([])]
fun check_packages(packages: [(str, str)]) -> Result<[(str, str)], Report> {
    var out: [(str, str)] = []
    var names: [str] = []
    for pkg in packages {
        let (name, dir) = pkg
        if name == "std" { return Err(list_error("a package cannot be named 'std': it is the standard library")) }
        if !valid_package_name(name) { return Err(list_error(format("invalid package name '{}'", name))) }
        if has(names, name) { return Err(list_error(format("package '{}' is given twice", name))) }
        if dir == "" { return Err(list_error(format("package '{}' has no directory", name))) }
        if !is_dir(dir) { return Err(list_error(format("package '{}': '{}' is not a directory", name, dir))) }
        names.push(name)
        out.push((name, normalize(dir)))
    }
    return Ok(out)
}

// Load and link the program rooted at `entry`; `std.*` imports resolve under
// `stdlib_root` ("" for none).
pub fun load_program(entry: str, stdlib_root: str) -> Result<Loaded, Report> {
    return load_program_opts(entry, load_options(stdlib_root))
}

// The same, reading the files in `overrides` (path -> text) from there
// instead: an editor's unsaved buffers (MYLA-80).
pub fun load_program_with(entry: str, stdlib_root: str, overrides: [str: str]) -> Result<Loaded, Report> {
    var opts = load_options(stdlib_root)
    opts.overrides = overrides
    return load_program_opts(entry, opts)
}

// The program rooted at `entry` with the build's dependencies, each a name
// and its directory, and the project root `root` ("" for the entry's
// directory): what the project tool loads for `src/main.my`, and with root
// `src` for every file under `src/` (MYLA-92).
#test("a", "a", [("let", "let"), ("x", "x")], "a")[Err(Report { kind: "module error", msg: "invalid package name 'let'", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] })]
#test("x", "x", [("let", "let"), ("x", "x")], "x")[Err(Report { kind: "module error", msg: "invalid package name 'let'", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] })]
#test("d1", "d1", [("let", "let"), ("x", "x")], "d1")[Err(Report { kind: "module error", msg: "invalid package name 'let'", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] })]
pub fun load_program_packages(entry: str, stdlib_root: str, packages: [(str, str)], root: str) -> Result<Loaded, Report> {
    var opts = load_options(stdlib_root)
    opts.packages = packages
    opts.root = root
    return load_program_opts(entry, opts)
}

// The program rooted at `entry`, loaded as `opts` says.
pub fun load_program_opts(entry: str, opts: LoadOptions) -> Result<Loaded, Report> {
    let e = normalize(entry)
    var stdlib = ""
    if opts.stdlib_root != "" { stdlib = normalize(opts.stdlib_root) }
    var project_root = dirname(e)
    if opts.root != "" { project_root = normalize(opts.root) }
    let packages = check_packages(opts.packages)?
    var normalized: [str: str] = [:]
    for p in opts.overrides.keys() { normalized[normalize(p)] = opts.overrides[p] }
    var ld = Loader { stdlib_root: stdlib, project_root: project_root, packages: packages, entry: e, modules: [], next_id: 0, spans: [], overrides: normalized }
    ld.load(e)?
    // the standard library's method modules, for a program outside it
    // (D164, MYLA-320)
    var implicit: [int32] = []
    if stdlib != "" && !is_std_module(e, stdlib) { implicit = ld.load_implicit()? }
    // the runtime's functions in Myla (MYLA-162), compiled where a program
    // uses them: the standard library's, else the copy the tools carry
    if opts.runtime {
        var rt_path = EMBEDDED_ROOT + "/std/rt.my"
        if stdlib != "" {
            let own = join_path(stdlib, "std/rt.my")
            let have = match source_text(own, normalized) {
                Some(t) => true,
                None => readable(own),
            }
            if have { rt_path = own }
        }
        let rt = ld.load(rt_path)?
    }
    ld.check_ids()?
    ld.build_exports()
    ld.build_bindings()?
    var exports: [str: [str: Binding]] = [:]
    for m in ld.modules { exports[m.id] = m.exports }
    var kinds: [str: str] = [:]
    for m in ld.modules {
        for d in m.decls {
            match named(d) { Some(nd) => { kinds[qualify(m.id, nd.name)] = decl_kind_word(d) }, None => {} }
        }
    }
    var decls: [Decl] = []
    var std_impls: [int32: DeclOrigin] = [:]
    // an entry file that is a module of the standard library: its own
    // names aren't qualified, so its functions' origins tell (MYLA-388)
    var entry_std = ""
    if stdlib != "" && is_std_module(e, stdlib) { entry_std = std_module_name(e) }
    for k in merge_order(ld.modules.len() as int32, implicit) {
        let m = ld.modules[k]
        var r = Renamer { env: decl_env(m.bindings), aliases: module_env(m.bindings), exports: exports, vals: [], tys: [], path: m.path, err: None, kinds: kinds }
        let in_std = starts_with_text(m.id, "std$")
        let is_implicit = has_index(implicit, k)
        // only the entry's cases are the program's, the others' were left
        // unparsed (`load`): an imported module's methods on a built-in type
        // are named as the entry's own (`str.bang`), so its cases would run
        // as the entry's (MYLA-360)
        let tested = m.path == ld.entry
        for d in m.decls {
            if in_std && is_impl(d) { std_impls[d.id] = DeclOrigin { module: dotted_id(m.id), path: m.path, implicit: is_implicit } }
            // an implicit module's functions too: the checker checks their
            // bodies only once called (MYLA-359)
            if is_implicit && is_fun(d) { std_impls[d.id] = DeclOrigin { module: dotted_id(m.id), path: m.path, implicit: true } }
            if entry_std != "" && tested && is_fun(d) { std_impls[d.id] = DeclOrigin { module: entry_std, path: m.path, implicit: false } }
            decls.push(r.decl(d, m.id))
        }
        match r.err { Some(e) => { return Err(e) }, None => {} }
    }
    return Ok(Loaded { decls: decls, next_id: ld.next_id, spans: ld.spans, std_impls: std_impls })
}
