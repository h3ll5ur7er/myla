// embedded_std.my: the standard library and the gdb script, as the toolchain
// carries them (MYLA-243). Generated from lib/ by tools/embed/main.my, which
// scripts/bootstrap.sh runs: change lib/, not this file.

// The embedded files, by path under the standard library root.
pub fun embedded_paths() -> [str] {
    return [
        "debug/myla_gdb.py",
        "std/archive.my",
        "std/args.my",
        "std/bigint.my",
        "std/bitset.my",
        "std/btree.my",
        "std/bytes.my",
        "std/char.my",
        "std/compress.my",
        "std/csv.my",
        "std/deque.my",
        "std/digest.my",
        "std/encoding.my",
        "std/fmt.my",
        "std/fs.my",
        "std/glob.my",
        "std/graph.my",
        "std/grid.my",
        "std/hash.my",
        "std/heap.my",
        "std/http.my",
        "std/ini.my",
        "std/int.my",
        "std/io.my",
        "std/iter.my",
        "std/json.my",
        "std/list.my",
        "std/log.my",
        "std/map.my",
        "std/math.my",
        "std/net.my",
        "std/num.my",
        "std/option.my",
        "std/path.my",
        "std/platform.my",
        "std/platform_aarch64.my",
        "std/platform_wasm.my",
        "std/process.my",
        "std/random.my",
        "std/regex.my",
        "std/rt.my",
        "std/set.my",
        "std/signal.my",
        "std/slice.my",
        "std/str.my",
        "std/task.my",
        "std/term.my",
        "std/test.my",
        "std/text.my",
        "std/time.my",
        "std/toml.my",
        "std/unionfind.my",
        "std/url.my",
        "std/uuid.my",
        "std/xml.my",
        "std/yaml.my",
    ]
}

// The text of the embedded file `path`, or "" for a path `embedded_paths`
// doesn't list.
pub fun embedded_file(path: str) -> str {
    if path == "debug/myla_gdb.py" { return file_debug_myla_gdb_py() }
    if path == "std/archive.my" { return file_std_archive_my() }
    if path == "std/args.my" { return file_std_args_my() }
    if path == "std/bigint.my" { return file_std_bigint_my() }
    if path == "std/bitset.my" { return file_std_bitset_my() }
