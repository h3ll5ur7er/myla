  w14 = w11 ^ w6 ^ w0 ^ w14; t = w14 >> 31u32; w14 = (w14 << 1u32) | t\n        c = c.wrapping_add(e ^ a ^ b).wrapping_add(0xca62c1d6u32).wrapping_add(w14)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        w15 = w12 ^ w7 ^ w1 ^ w15; t = w15 >> 31u32; w15 = (w15 << 1u32) | t\n        b = b.wrapping_add(d ^ e ^ a).wrapping_add(0xca62c1d6u32).wrapping_add(w15)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        w0 = w13 ^ w8 ^ w2 ^ w0; t = w0 >> 31u32; w0 = (w0 << 1u32) | t\n        a = a.wrapping_add(c ^ d ^ e).wrapping_add(0xca62c1d6u32).wrapping_add(w0)\n        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)\n        t = c >> 2u32; c = (c << 30u32) | t\n        w1 = w14 ^ w9 ^ w3 ^ w1; t = w1 >> 31u32; w1 = (w1 << 1u32) | t\n        e = e.wrapping_add(b ^ c ^ d).wrapping_add(0xca62c1d6u32).wrapping_add(w1)\n        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)\n        t = b >> 2u32; b = (b << 30u32) | t\n        w2 = w15 ^ w10 ^ w4 ^ w2; t = w2 >> 31u32; w2 = (w2 << 1u32) | t\n        d = d.wrapping_add(a ^ b ^ c).wrapping_add(0xca62c1d6u32).wrapping_add(w2)\n        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)\n        t = a >> 2u32; a = (a << 30u32) | t\n        w3 = w0 ^ w11 ^ w5 ^ w3; t = w3 >> 31u32; w3 = (w3 << 1u32) | t\n        c = c.wrapping_add(e ^ a ^ b).wrapping_add(0xca62c1d6u32).wrapping_add(w3)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        w4 = w1 ^ w12 ^ w6 ^ w4; t = w4 >> 31u32; w4 = (w4 << 1u32) | t\n        b = b.wrapping_add(d ^ e ^ a).wrapping_add(0xca62c1d6u32).wrapping_add(w4)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        w5 = w2 ^ w13 ^ w7 ^ w5; t = w5 >> 31u32; w5 = (w5 << 1u32) | t\n        a = a.wrapping_add(c ^ d ^ e).wrapping_add(0xca62c1d6u32).wrapping_add(w5)\n        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)\n        t = c >> 2u32; c = (c << 30u32) | t\n        w6 = w3 ^ w14 ^ w8 ^ w6; t = w6 >> 31u32; w6 = (w6 << 1u32) | t\n        e = e.wrapping_add(b ^ c ^ d).wrapping_add(0xca62c1d6u32).wrapping_add(w6)\n        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)\n        t = b >> 2u32; b = (b << 30u32) | t\n        w7 = w4 ^ w15 ^ w9 ^ w7; t = w7 >> 31u32; w7 = (w7 << 1u32) | t\n        d = d.wrapping_add(a ^ b ^ c).wrapping_add(0xca62c1d6u32).wrapping_add(w7)\n        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)\n        t = a >> 2u32; a = (a << 30u32) | t\n        w8 = w5 ^ w0 ^ w10 ^ w8; t = w8 >> 31u32; w8 = (w8 << 1u32) | t\n        c = c.wrapping_add(e ^ a ^ b).wrapping_add(0xca62c1d6u32).wrapping_add(w8)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        w9 = w6 ^ w1 ^ w11 ^ w9; t = w9 >> 31u32; w9 = (w9 << 1u32) | t\n        b = b.wrapping_add(d ^ e ^ a).wrapping_add(0xca62c1d6u32).wrapping_add(w9)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        w10 = w7 ^ w2 ^ w12 ^ w10; t = w10 >> 31u32; w10 = (w10 << 1u32) | t\n        a = a.wrapping_add(c ^ d ^ e).wrapping_add(0xca62c1d6u32).wrapping_add(w10)\n        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)\n        t = c >> 2u32; c = (c << 30u32) | t\n        w11 = w8 ^ w3 ^ w13 ^ w11; t = w11 >> 31u32; w11 = (w11 << 1u32) | t\n        e = e.wrapping_add(b ^ c ^ d).wrapping_add(0xca62c1d6u32).wrapping_add(w11)\n        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)\n        t = b >> 2u32; b = (b << 30u32) | t\n        w12 = w9 ^ w4 ^ w14 ^ w12; t = w12 >> 31u32; w12 = (w12 << 1u32) | t\n        d = d.wrapping_add(a ^ b ^ c).wrapping_add(0xca62c1d6u32).wrapping_add(w12)\n        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)\n        t = a >> 2u32; a = (a << 30u32) | t\n        w13 = w10 ^ w5 ^ w15 ^ w13; t = w13 >> 31u32; w13 = (w13 << 1u32) | t\n        c = c.wrapping_add(e ^ a ^ b).wrapping_add(0xca62c1d6u32).wrapping_add(w13)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        w14 = w11 ^ w6 ^ w0 ^ w14; t = w14 >> 31u32; w14 = (w14 << 1u32) | t\n        b = b.wrapping_add(d ^ e ^ a).wrapping_add(0xca62c1d6u32).wrapping_add(w14)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        w15 = w12 ^ w7 ^ w1 ^ w15; t = w15 >> 31u32; w15 = (w15 << 1u32) | t\n        a = a.wrapping_add(c ^ d ^ e).wrapping_add(0xca62c1d6u32).wrapping_add(w15)\n        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)\n        t = c >> 2u32; c = (c << 30u32) | t\n        self.a = self.a.wrapping_add(a)\n        self.b = self.b.wrapping_add(b)\n        self.c = self.c.wrapping_add(c)\n        self.d = self.d.wrapping_add(d)\n        self.e = self.e.wrapping_add(e)\n    }\n\n    fun close(var self) {\n        if self.blk.pad() {\n            self.compress()\n            self.blk.clear()\n        }\n        self.blk.put_length()\n        self.compress()\n    }\n\n    fun bytes(self) -> [uint8] {\n        return be_bytes([self.a, self.b, self.c, self.d, self.e], 5)\n    }\n\n    fun hex(self) -> str {\n        var x = new_hex()\n        x.be32(self.a)\n        x.be32(self.b)\n        x.be32(self.c)\n        x.be32(self.d)\n        x.be32(self.e)\n        return x.sb.build()\n    }\n}\n\nimpl Digest for Sha1 {\n    fun update(var self, data: [uint8]) {\n        var i = 0\n        while i < data.len() {\n            i = self.blk.fill(data, i)\n            if self.blk.used == 64 {\n                self.compress()\n                self.blk.used = 0\n            }\n        }\n    }\n\n    #test(new_sha1())[[0xdau8, 0x39u8, 0xa3u8, 0xeeu8, 0x5eu8, 0x6bu8, 0x4bu8, 0x0du8, 0x32u8, 0x55u8, 0xbfu8, 0xefu8, 0x95u8, 0x60u8, 0x18u8, 0x90u8, 0xafu8, 0xd8u8, 0x07u8, 0x09u8]]\n    fun finish(self) -> [uint8] {\n        var h = self\n        h.close()\n        return h.bytes()\n    }\n\n    #test(new_sha1())[64]\n    fun block_size(self) -> int {\n        return 64\n    }\n}\n\n// The SHA-1 digest of `data`, 20 bytes.\n#test([97u8, 98u8, 99u8])[[0xa9u8, 0x99u8, 0x3eu8, 0x36u8, 0x47u8, 0x06u8, 0x81u8, 0x6au8, 0xbau8, 0x3eu8, 0x25u8, 0x71u8, 0x78u8, 0x50u8, 0xc2u8, 0x6cu8, 0x9cu8, 0xd0u8, 0xd8u8, 0x9du8]]\npub fun sha1(data: [uint8]) -> [uint8] {\n    var h = new_sha1()\n    h.update(data)\n    h.close()\n    return h.bytes()\n}\n\n#test(\"\")[\"da39a3ee5e6b4b0d3255bfef95601890afd80709\"]\n#test(\"abc\")[\"a9993e364706816aba3e25717850c26c9cd0d89d\"]\n#test(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")[\"84983e441c3bd26ebaae4aa1f95129e5e54670f1\"] // 448 bits\n#test(\"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu\")[\"a49b2446a02c645bf419f995b67091253a04a259\"] // 896 bits\npub fun sha1_hex(s: str) -> str {\n    var h = new_sha1()\n    h.update_str(s)\n    h.close()\n    return h.hex()\n}\n\n// ---- SHA-256 and SHA-224 (FIPS 180-4, 6.2 and 6.3)\n\n// SHA-256, or SHA-224 (other initial values, 7 words of output).\npub struct Sha256 {\n    blk: Block32,\n    a: uint32,\n    b: uint32,\n    c: uint32,\n    d: uint32,\n    e: uint32,\n    f: uint32,\n    g: uint32,\n    h: uint32,\n    words: int,\n}\n\npub fun new_sha256() -> Sha256 {\n    return Sha256 {\n        blk: new_block32(true),\n        a: 0x6a09e667, b: 0xbb67ae85, c: 0x3c6ef372, d: 0xa54ff53a,\n        e: 0x510e527f, f: 0x9b05688c, g: 0x1f83d9ab, h: 0x5be0cd19,\n        words: 8,\n    }\n}\n\npub fun new_sha224() -> Sha256 {\n    return Sha256 {\n        blk: new_block32(true),\n        a: 0xc1059ed8, b: 0x367cd507, c: 0x3070dd17, d: 0xf70e5939,\n        e: 0xffc00b31, f: 0x68581511