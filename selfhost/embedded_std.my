mpress()\n            self.blk.clear()\n        }\n        self.blk.put_length()\n        self.compress()\n    }\n\n    fun bytes(self) -> [uint8] {\n        return le_bytes([self.a, self.b, self.c, self.d])\n    }\n\n    fun hex(self) -> str {\n        var x = new_hex()\n        x.le32(self.a)\n        x.le32(self.b)\n        x.le32(self.c)\n        x.le32(self.d)\n        return x.sb.build()\n    }\n}\n\nimpl Digest for Md5 {\n    // Adds `data`.\n    fun update(var self, data: [uint8]) {\n        var i = 0\n        while i < data.len() {\n            i = self.blk.fill(data, i)\n            if self.blk.used == 64 {\n                self.compress()\n                self.blk.used = 0\n            }\n        }\n    }\n\n    // The digest of what was added; the hasher itself doesn't change.\n    #test(new_md5())[[0xd4u8, 0x1du8, 0x8cu8, 0xd9u8, 0x8fu8, 0x00u8, 0xb2u8, 0x04u8, 0xe9u8, 0x80u8, 0x09u8, 0x98u8, 0xecu8, 0xf8u8, 0x42u8, 0x7eu8]]\n    fun finish(self) -> [uint8] {\n        var h = self\n        h.close()\n        return h.bytes()\n    }\n\n    #test(new_md5())[64]\n    fun block_size(self) -> int {\n        return 64\n    }\n}\n\n// The MD5 digest of `data`, 16 bytes.\n#test([97u8, 98u8, 99u8])[[0x90u8, 0x01u8, 0x50u8, 0x98u8, 0x3cu8, 0xd2u8, 0x4fu8, 0xb0u8, 0xd6u8, 0x96u8, 0x3fu8, 0x7du8, 0x28u8, 0xe1u8, 0x7fu8, 0x72u8]]\npub fun md5(data: [uint8]) -> [uint8] {\n    var h = new_md5()\n    h.update(data)\n    h.close()\n    return h.bytes()\n}\n\n// The MD5 digest of the bytes of `s`, in hex.\n#test(\"\")[\"d41d8cd98f00b204e9800998ecf8427e\"]\n#test(\"a\")[\"0cc175b9c0f1b6a831c399e269772661\"]\n#test(\"abc\")[\"900150983cd24fb0d6963f7d28e17f72\"]\n#test(\"message digest\")[\"f96b697d7cb7938d525a2f31aaf161d0\"]\n#test(\"abcdefghijklmnopqrstuvwxyz\")[\"c3fcd3d76192e4007dfb496cca67e13b\"]\n#test(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\")[\"d174ab98d277d9f5a5611c2c9f419d9f\"]\n#test(\"12345678901234567890123456789012345678901234567890123456789012345678901234567890\")[\"57edf4a22be3c955ac49da2e2107b67a\"]\npub fun md5_hex(s: str) -> str {\n    var h = new_md5()\n    h.update_str(s)\n    h.close()\n    return h.hex()\n}\n\n// ---- SHA-1 (FIPS 180-4, 6.1)\n\npub struct Sha1 {\n    blk: Block32,\n    a: uint32,\n    b: uint32,\n    c: uint32,\n    d: uint32,\n    e: uint32,\n}\n\npub fun new_sha1() -> Sha1 {\n    return Sha1 { blk: new_block32(true), a: 0x67452301, b: 0xefcdab89, c: 0x98badcfe, d: 0x10325476, e: 0xc3d2e1f0 }\n}\n\nimpl Sha1 {\n    fun update_str(var self, s: str) {\n        var i = 0\n        while i < s.len() {\n            i = self.blk.fill_str(s, i)\n            if self.blk.used == 64 {\n                self.compress()\n                self.blk.used = 0\n            }\n        }\n    }\n\n    #test(new_sha1())[\"da39a3ee5e6b4b0d3255bfef95601890afd80709\"]\n    fun finish_hex(self) -> str {\n        var h = self\n        h.close()\n        return h.hex()\n    }\n\n    fun compress(var self) {\n        let w = self.blk.w\n        var w0 = w[0]\n        var w1 = w[1]\n        var w2 = w[2]\n        var w3 = w[3]\n        var w4 = w[4]\n        var w5 = w[5]\n        var w6 = w[6]\n        var w7 = w[7]\n        var w8 = w[8]\n        var w9 = w[9]\n        var w10 = w[10]\n        var w11 = w[11]\n        var w12 = w[12]\n        var w13 = w[13]\n        var w14 = w[14]\n        var w15 = w[15]\n        var a = self.a\n        var b = self.b\n        var c = self.c\n        var d = self.d\n        var e = self.e\n        var t = 0u32\n        // each step: e += f(b, c, d) + K + W[t] + rotl(a, 5); b = rotl(b, 30); from\n        // step 16 W[t] = rotl(W[t-3] ^ W[t-8] ^ W[t-14] ^ W[t-16], 1) first\n        // steps 0 to 19: Ch\n        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x5a827999u32).wrapping_add(w0)\n        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)\n        t = b >> 2u32; b = (b << 30u32) | t\n        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x5a827999u32).wrapping_add(w1)\n        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)\n        t = a >> 2u32; a = (a << 30u32) | t\n        c = c.wrapping_add(b ^ (e & (a ^ b))).wrapping_add(0x5a827999u32).wrapping_add(w2)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        b = b.wrapping_add(a ^ (d & (e ^ a))).wrapping_add(0x5a827999u32).wrapping_add(w3)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        a = a.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x5a827999u32).wrapping_add(w4)\n        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)\n        t = c >> 2u32; c = (c << 30u32) | t\n        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x5a827999u32).wrapping_add(w5)\n        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)\n        t = b >> 2u32; b = (b << 30u32) | t\n        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x5a827999u32).wrapping_add(w6)\n        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)\n        t = a >> 2u32; a = (a << 30u32) | t\n        c = c.wrapping_add(b ^ (e & (a ^ b))).wrapping_add(0x5a827999u32).wrapping_add(w7)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        b = b.wrapping_add(a ^ (d & (e ^ a))).wrapping_add(0x5a827999u32).wrapping_add(w8)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        a = a.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x5a827999u32).wrapping_add(w9)\n        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)\n        t = c >> 2u32; c = (c << 30u32) | t\n        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x5a827999u32).wrapping_add(w10)\n        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)\n        t = b >> 2u32; b = (b << 30u32) | t\n        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x5a827999u32).wrapping_add(w11)\n        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)\n        t = a >> 2u32; a = (a << 30u32) | t\n        c = c.wrapping_add(b ^ (e & (a ^ b))).wrapping_add(0x5a827999u32).wrapping_add(w12)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        b = b.wrapping_add(a ^ (d & (e ^ a))).wrapping_add(0x5a827999u32).wrapping_add(w13)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        a = a.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x5a827999u32).wrapping_add(w14)\n        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)\n        t = c >> 2u32; c = (c << 30u32) | t\n        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x5a827999u32).wrapping_add(w15)\n        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)\n        t = b >> 2u32; b = (b << 30u32) | t\n        w0 = w13 ^ w8 ^ w2 ^ w0; t = w0 >> 31u32; w0 = (w0 << 1u32) | t\n        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x5a827999u32).wrapping_add(w0)\n        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)\n        t = a >> 2u32; a = (a << 30u32) | t\n        w1 = w14 ^ w9 ^ w3 ^ w1; t = w1 >> 31u32; w1 = (w1 << 1u32) | t\n        c = c.wrapping_add(b ^ (e & (a ^ b))).wrapping_add(0x5a827999u32).wrapping_add(w1)\n        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)\n        t = e >> 2u32; e = (e << 30u32) | t\n        w2 = w15 ^ w10 ^ w4 ^ w2; t = w2 >> 31u32; w2 = (w2 << 1u32) | t\n        b = b.wrapping_add(a ^ (d & (e ^ a))).wrapping_add(0x5a827999u32).wrapping_add(w2)\n        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)\n        t = d >> 2u32; d = (d << 30u32) | t\n        w3 = w0 ^ w11 ^ w5 ^ w3; t = w3 >> 31u32; w3 = (w3 << 1u32) | t\n        a = a.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x5a827999u3