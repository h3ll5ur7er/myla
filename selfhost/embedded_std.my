// embedded_std.my: the standard library and the gdb script, as the toolchain
// carries them (MYLA-243). Generated from lib/ by tools/embed/main.my, which
// scripts/bootstrap.sh runs: change lib/, not this file.

// The embedded files, by path under the standard library root.
pub fun embedded_paths() -> [str] {
    return [
        "debug/myla_gdb.py",
        "std/fs.my",
        "std/io.my",
        "std/json.my",
        "std/num.my",
        "std/process.my",
        "std/task.my",
        "std/toml.my",
    ]
}

// The text of the embedded file `path`, or "" for a path `embedded_paths`
// doesn't list.
pub fun embedded_file(path: str) -> str {
    if path == "debug/myla_gdb.py" { return file_debug_myla_gdb_py() }
    if path == "std/fs.my" { return file_std_fs_my() }
    if path == "std/io.my" { return file_std_io_my() }
    if path == "std/json.my" { return file_std_json_my() }
    if path == "std/num.my" { return file_std_num_my() }
    if path == "std/process.my" { return file_std_process_my() }
    if path == "std/task.my" { return file_std_task_my() }
    if path == "std/toml.my" { return file_std_toml_my() }
    return ""
}

fun file_debug_myla_gdb_py() -> str {
    return "# gdb pretty-printers for Myla programs built with `myla build -g` (MYLA-66, D82).\n#\n# The DWARF of a -g build describes a heap value inside a struct, tuple, enum,\n# list or map (a str, list, builder or map, a boxed enum) as a pointer to its\n# cell, and a float32 kept as a double as an 8-byte float named float32: gdb\n# can't give fields and elements types whose size depends on their value.\n# These printers show them as Myla values instead:\n#\n#   Bag {items: [4, 5], label: \"two\", ratio: 0.100000001, tags: {\"k\": 4}}\n#\n# Both compilers embed this file in the binary's .debug_gdb_scripts section,\n# so gdb runs it when it loads the program, if `auto-load safe-path` allows\n# the program's path (`gdb -iex 'add-auto-load-safe-path .' ./prog`, or that\n# line in ~/.config/gdb/gdbinit). Or load it by hand: `source <this file>`.\n# `print/r x` shows a value without them, `disable pretty-printer global myla`\n# turns them off.\n#\n# Keep this file ASCII: the compilers copy it byte for byte into the assembly.\n\nimport struct\n\nimport gdb\nimport gdb.printing\n\n\ndef _address(val):\n    \"\"\"The address a pointer holds, or of a value in memory.\"\"\"\n    if val.type.strip_typedefs().code == gdb.TYPE_CODE_PTR:\n        return int(val)\n    return int(val.address)\n\n\ndef _read_u64(address):\n    return int.from_bytes(bytes(gdb.selected_inferior().read_memory(address, 8)), \"little\")\n\n\ndef _cell_kind(t):\n    \"\"\"What a cell type describes: 'str', 'sb', 'list' or 'map' (None for\n    other types). Cells are the structs the compilers name `str`,\n    `StringBuilder`, `[T]` and `[K: V]`, with these fields.\"\"\"\n    if t.code != gdb.TYPE_CODE_STRUCT:\n        return None\n    name = t.name or \"\"\n    if name != \"str\" and name != \"StringBuilder\" and not name.startswith(\"[\"):\n        return None\n    fields = tuple(f.name for f in t.fields())\n    if name == \"str\" and fields == (\"len\", \"bytes\"):\n        return \"str\"\n    if name == \"StringBuilder\" and fields == (\"len\", \"cap\", \"bytes\"):\n        return \"sb\"\n    if fields == (\"len\", \"cap\", \"items\"):\n        return \"list\"\n    if fields == (\"len\", \"cap\", \"slots\"):\n        return \"map\"\n    return None\n\n\nclass StringPrinter:\n    \"\"\"A str or StringBuilder cell (or a pointer to one): the text.\"\"\"\n\n    def __init__(self, val, cell_type, data):\n        self.address = _address(val)\n        self.byte = cell_type.fields()[-1].type.target()\n        self.data = data\n\n    def to_string(self):\n        try:\n            length = _read_u64(self.address)\n        except gdb.MemoryError:\n            return \"<unreadable cell 0x%x>\" % self.address\n        start = gdb.Value(self.address + self.data).cast(self.byte.pointer())\n        return start.lazy_string(encoding=\"utf-8\", length=length)\n\n    def display_hint(self):\n        return \"string\"\n\n\nclass ListPrinter:\n    \"\"\"A list cell (or a pointer to one): its elements, `[4, 5]`.\"\"\"\n\n    def __init__(self, cell):\n        self.cell = cell\n\n    def to_string(self):\n        return self.cell[\"items\"]\n\n\ndef _limit():\n    n = gdb.parameter(\"print elements\")\n    return None if n is None or n == 0 else n\n\n\nclass MapPrinter:\n    \"\"\"A map cell (or a pointer to one): its occupied slots, `{\"k\": 4}`, in\n    the order `for k in m` visits them.\"\"\"\n\n    def __init__(self, cell):\n        self.cell = cell\n\n    def to_string(self):\n        slots = self.cell[\"slots\"]\n        cap = int(self.cell[\"cap\"])\n        limit = _limit()\n        occupied = []\n        for i in range(cap):\n            slot = slots[i]\n            if int(slot[\"state\"]) == 1:\n                occupied.append((int(slot[\"order\"]), slot))\n        # in the order of insertion, each slot's `order` (D105, MYLA-179)\n        occupied.sort(key=lambda entry: entry[0])\n        parts = []\n        for _, slot in occupied:\n            if limit is not None and len(parts) == limit:\n                parts.append(\"...\")\n                break\n            parts.append(\"%s: %s\" % (slot[\"key\"].format_string(), slot[\"value\"].format_string()))\n        return \"{\" + \", \".join(parts) + \"}\"\n\n\nclass Float32Printer:\n    \"\"\"A float32 kept as a double (a field or element): as gdb prints a float.\"\"\"\n\n    def __init__(self, val):\n        self.val = val\n\n    def to_string(self):\n        single = struct.unpack(\"<f\", struct.pack(\"<f\", float(self.val)))[0]\n        return \"%.9g\" % single\n\n\nclass DerefPrinter:\n    \"\"\"A pointer to a struct or enum (a boxed enum inside an aggregate, a\n    function's aggregate result): the value it points at.\"\"\"\n\n    def __init__(self, val):\n        self.val = val\n\n    def to_string(self):\n        if int(self.val) == 0:\n            return \"0x0\"\n        return self.val.dereference()\n\n\ndef _printer(val):\n    t = val.type.strip_typedefs()\n    if t.code == gdb.TYPE_CODE_FLT:\n        if t.name == \"float32\" and t.sizeof == 8:\n            return Float32Printer(val)\n        return None\n    pointer = t.code == gdb.TYPE_CODE_PTR\n    if pointer:\n        t = t.target().strip_typedefs()\n    kind = _cell_kind(t)\n    if kind is None:\n        if pointer and t.code == gdb.TYPE_CODE_STRUCT and t.name and not t.name.startswith(\"&\"):\n            return DerefPrinter(val)\n        return None\n    if kind == \"str\":\n        return StringPrinter(val, t, 8)\n    if kind == \"sb\":\n        return StringPrinter(val, t, 16)\n    if pointer:\n        if int(val) == 0:\n            return None\n        val = val.dereference()\n    return ListPrinter(val) if kind == \"list\" else MapPrinter(val)\n\n\nclass MylaPrinters(gdb.printing.PrettyPrinter):\n    def __init__(self):\n        super().__init__(\"myla\")\n\n    def __call__(self, val):\n        return _printer(val) if self.enabled else None\n\n\n# Globally, not for the objfile being loaded: gdb runs an embedded script of a\n# given name once per program space, so the printers must outlive the first\n# Myla binary loaded. They only match the compilers' cell and float32 types.\ngdb.printing.register_pretty_printer(None, MylaPrinters(), replace=True)\n"
}

fun file_std_fs_my() -> str {
    return "// std.fs — minimal filesystem access (v0.5.4, D29; directories MYLA-88).\n//\n// `read_to_string` opens a file, reads it whole, and closes it, returning the\n// contents as a `str` or an `IoError` describing why it failed. Errors are\n// carried in a `Result`, so callers compose them with `?` (D16/D36). The\n// underlying open/read/close run as raw Linux syscalls natively and as Python\n// file IO in the interpreter, with identical (errno-keyed) error mapping.\n\n// Why a filesystem operation failed. `Other` carries the raw OS errno for\n// anything not given its own variant.\npub enum IoError {\n    NotFound,\n    PermissionDenied,\n    Other(int32),\n}\n\n// Map a (nonzero) OS errno to an `IoError`. ENOENT/EACCES on Linux. Also\n// used by `std.io`.\npub fun from_errno(code: int32) -> IoError {\n    if code == 2 {\n        return IoError.NotFound\n    }\n    if code == 13 {\n        return IoError.PermissionDenied\n    }\n    return IoError.Other(code)\n}\n\n// Read the entire file at `path` into a string. On success the bytes are\n// returned verbatim (as UTF-8 text); on failure an `IoError` is returned.\npub fun read_to_string(path: str) -> Result<str, IoError> {\n    let data = __read_file(path)\n    let err = __io_errno()\n    if err == 0 {\n        return Ok(data)\n    }\n    return Err(from_errno(err))\n}\n\n// Write `contents` to `path`, creating or truncating the file (mode 0644). The\n// bytes are written verbatim (as UTF-8). On success `Ok(n)` is returned, where\n// `n` is the number of bytes written; on failure (open/write) an `IoError`\n// carrying the OS errno is returned. Runs as raw open/write/close syscalls\n// natively and as Python file IO in the interpreter, with identical\n// (errno-keyed) error mapping.\npub fun write_to_file(path: str, contents: str) -> Result<int32, IoError> {\n    __write_file(path, contents)\n    let err = __io_errno()\n    if err == 0 {\n        return Ok(contents.len())\n    }\n    return Err(from_errno(err))\n}\n\n// --- directories (MYLA-88) ---------------------------------------------------\n//\n// Four primitives make the system calls, the rest is Myla (D64):\n// `__list_dir(path)` gives every name the directory lists, each followed by a\n// NUL byte, in the file system's order (\".\" and \"..\" may be among them);\n// `__mkdir(path, mode)` makes one directory; `__stat(path)` gives the\n// `st_mode` of what the path names (symbolic links followed), or -1;\n// `__getcwd()` gives the working directory, or \"\" (MYLA-98); `__unlink(path)`,\n// `__rmdir(path)` and `__rename(from, to)` remove a file (or a symbolic link\n// itself), remove an empty directory and rename (MYLA-96). Each sets the errno\n// that `__io_errno` reads.\n//\n// The helpers below have no `#test` cases: `myla test` runs the cases of every\n// linked module, and every program that prints links this one through\n// `std.io`. `tests/unit/test_fs.py` and `tests/burn/test_fs.py` cover them.\n\nconst S_IFMT: int32 = 0xF000\nconst S_IFDIR: int32 = 0x4000\nconst S_IFREG: int32 = 0x8000\n\n// The working directory, as an absolute path without symbolic links (the\n// kernel's getcwd, through the primitive `__getcwd`, MYLA-98). A directory\n// that was removed is `NotFound`.\npub fun current_dir() -> Result<str, IoError> {\n    let dir = __getcwd()\n    let err = __io_errno()\n    if err == 0 {\n        return Ok(dir)\n    }\n    return Err(from_errno(err))\n}\n\n// The names of the entries of the directory `path`, without \".\" and \"..\",\n// sorted by their bytes, so every implementation and file system gives the\n// same list.\npub fun list_dir(path: str) -> Result<[str], IoError> {\n    let raw = __list_dir(path)\n    let err = __io_errno()\n    if err != 0 {\n        return Err(from_errno(err))\n    }\n    return Ok(sorted_names(split_names(raw)))\n}\n\n// Make the directory `path` (mode 0755, less the umask). Its parent must\n// exist; a path that exists already is `Other(17)` (EEXIST). `Ok` holds 0.\npub fun make_dir(path: str) -> Result<int32, IoError> {\n    __mkdir(path, 0o755)\n    let err = __io_errno()\n    if err == 0 {\n        return Ok(0)\n    }\n    return Err(from_errno(err))\n}\n\n// Make the directory `path` and the parents it lacks, like `mkdir -p`. A\n// directory that exists already is fine; a file at `path` is `Other(17)`\n// (EEXIST), and a file where a parent should be is `Other(20)` (ENOTDIR).\n// `Ok` holds 0.\npub fun make_dir_all(path: str) -> Result<int32, IoError> {\n    var i = 1\n    while i <= path.len() {\n        if i == path.len() || path[i] == '/' {\n            var sb = StringBuilder()\n            sb.append(path, 0, i)\n            let prefix = sb.build()\n            if !exists(prefix) {\n                make_dir(prefix)?\n            }\n        }\n        i = i + 1\n    }\n    if is_dir(path) {\n        return Ok(0)\n    }\n    return Err(from_errno(17))\n}\n\n// Remove the file `path` (a symbolic link is removed itself, not what it\n// names). A directory is `Other(21)` (EISDIR). `Ok` holds 0.\npub fun remove_file(path: str) -> Result<int32, IoError> {\n    __unlink(path)\n    return io_result()\n}\n\n// Remove the directory `path`, which must be empty: one that isn't is\n// `Other(39)` (ENOTEMPTY). `Ok` holds 0.\npub fun remove_dir(path: str) -> Result<int32, IoError> {\n    __rmdir(path)\n    return io_result()\n}\n\n// Remove `path` and, for a directory, everything in it, like `rm -r`. A\n// symbolic link is removed, not followed, even one naming a directory.\n// `Ok` holds 0.\npub fun remove_dir_all(path: str) -> Result<int32, IoError> {\n    // a file or a link goes at once; a directory is EISDIR\n    __unlink(path)\n    let err = __io_errno()\n    if err == 0 {\n        return Ok(0)\n    }\n    if err != 21 {\n        return Err(from_errno(err))\n    }\n    for name in list_dir(path)? {\n        remove_dir_all(path + \"/\" + name)?\n    }\n    return remove_dir(path)\n}\n\n// Rename (or move, within one file system) `from_path` to `to`, replacing a\n// file at `to`. `Ok` holds 0.\npub fun rename(from_path: str, to: str) -> Result<int32, IoError> {\n    __rename(from_path, to)\n    return io_result()\n}\n\n// `Ok(0)`, or the error of the last primitive.\nfun io_result() -> Result<int32, IoError> {\n    let err = __io_errno()\n    if err == 0 {\n        return Ok(0)\n    }\n    return Err(from_errno(err))\n}\n\n// Whether `path` names something that exists (a dangling symbolic link\n// doesn't).\npub fun exists(path: str) -> bool {\n    return __stat(path) >= 0\n}\n\n// Whether `path` names a directory (or a symbolic link to one).\npub fun is_dir(path: str) -> bool {\n    let mode = __stat(path)\n    return mode >= 0 && (mode & S_IFMT) == S_IFDIR\n}\n\n// Whether `path` names a regular file (or a symbolic link to one).\npub fun is_file(path: str) -> bool {\n    let mode = __stat(path)\n    return mode >= 0 && (mode & S_IFMT) == S_IFREG\n}\n\n// The names in `raw`, each followed by a NUL byte, without \".\" and \"..\".\nfun split_names(raw: str) -> [str] {\n    var names: [str] = []\n    var start = 0\n    var i = 0\n    while i < raw.len() {\n        if raw[i] == 0 {\n            var sb = StringBuilder()\n            sb.append(raw, start, i)\n            let name = sb.build()\n            if name != \".\" && name != \"..\" {\n                names.push(name)\n            }\n            start = i + 1\n        }\n        i = i + 1\n    }\n    return names\n}\n\n// Whether `a` sorts before `b`, byte by byte (a prefix first).\nfun before(a: str, b: str) -> bool {\n    var i = 0\n    while i < a.len() && i < b.len() {\n        if a[i] != b[i] {\n            return a[i] < b[i]\n        }\n        i = i + 1\n    }\n    return a.len() < b.len()\n}\n\n// `names` sorted by their bytes (a stable merge sort).\nfun sorted_names(names: [str]) -> [str] {\n    if names.len() <= 1 {\n        return names\n    }\n    var left: [str] = []\n    var right: [str] = []\n    var i = 0\n    while i < names.len() {\n        if i < names.len() / 2 { left.push(names[i]) } else { right.push(names[i]) }\n        i = i + 1\n    }\n    let l = sorted_names(left)\n    let r = sorted_names(right)\n    var out: [str] = []\n    var a = 0\n    var b = 0\n    while a < l.len() || b < r.len() {\n        if b >= r.len() || (a < l.len() && !before(r[b], l[a])) {\n            out.push(l[a])\n            a = a + 1\n        } else {\n            out.push(r[b])\n            b = b + 1\n        }\n    }\n    return out\n}\n"
}

fun file_std_io_my() -> str {
    return "// std.io — freestanding console/stream I/O (v0.5.4, D29; reading MYLA-78).\n//\n// Thin wrappers over the runtime's raw `write` and `read` primitives (the\n// Linux syscalls natively; Python `os.write`/`os.read` in the interpreter).\n// String bytes are written verbatim (UTF-8), so `print`/`println` are\n// byte-for-byte identical across the interpreter and the native backend.\n// Output is not buffered, so whatever a program wrote is out before it waits\n// for input.\n\nfrom .fs import IoError, from_errno\n\n// Write `s`'s bytes to file descriptor `fd` (1 = stdout, 2 = stderr).\npub fun write(fd: int32, s: str) {\n    __write(fd, s)\n}\n\n// Write `s` to stdout, followed by a newline.\npub fun println(s: str) {\n    __write(1, s)\n    __write(1, \"\\n\")\n}\n\n// Write `s` to stderr (no newline).\npub fun eprint(s: str) {\n    __write(2, s)\n}\n\n// Write `s` to stderr, followed by a newline.\npub fun eprintln(s: str) {\n    __write(2, s)\n    __write(2, \"\\n\")\n}\n\n// --- Reading ------------------------------------------------------------------\n\n// How many bytes one `read` asks for at least.\nconst CHUNK: int32 = 4096\n\n// A buffered reader over a file descriptor. Keep it in a `var` (or a field of\n// one) and read through its methods; the bytes they return are verbatim, and\n// a read blocks until input is there or the input ends.\npub struct Reader {\n    fd: int32,\n    buf: str,      // bytes read but not returned yet: buf[pos..]\n    pos: int32,\n    eof: bool,     // the input has ended\n}\n\n// A reader of the standard input.\npub fun stdin() -> Reader {\n    return reader(0)\n}\n\n// A reader of file descriptor `fd`.\npub fun reader(fd: int32) -> Reader {\n    return Reader { fd: fd, buf: \"\", pos: 0, eof: false }\n}\n\n// The bytes of `s` from `start` up to `end`.\nfun slice(s: str, start: int32, end: int32) -> str {\n    var sb = StringBuilder()\n    sb.append(s, start, end)\n    return sb.build()\n}\n\nimpl Reader {\n    // Read at least `want` more bytes if the input has them (one `read` of at\n    // least CHUNK bytes, which may return fewer); false at the end of the\n    // input. The bytes already returned are dropped from the buffer.\n    fun fill(var self, want: int32) -> Result<bool, IoError> {\n        if self.eof { return Ok(false) }\n        var n = CHUNK\n        if want > n { n = want }\n        let chunk = __read(self.fd, n)\n        let err = __io_errno()\n        if err != 0 { return Err(from_errno(err)) }\n        if chunk.len() == 0 {\n            self.eof = true\n            return Ok(false)\n        }\n        if self.pos > 0 {\n            self.buf = slice(self.buf, self.pos, self.buf.len())\n            self.pos = 0\n        }\n        self.buf = self.buf + chunk\n        return Ok(true)\n    }\n\n    // The next line, without its \"\\n\" (a \"\\r\" before it is kept); a last line\n    // without \"\\n\" counts too. None at the end of the input.\n    fun read_line(var self) -> Result<Option<str>, IoError> {\n        var scanned = 0                    // bytes after pos known not to be \"\\n\"\n        var found = -1\n        while found < 0 {\n            let buf = self.buf\n            let n = buf.len()\n            var i = self.pos + scanned\n            while i < n {\n                if buf[i] == '\\n' {\n                    found = i\n                    i = n\n                } else {\n                    i = i + 1\n                }\n            }\n            if found < 0 {\n                scanned = self.buf.len() - self.pos\n                if !self.fill(1)? {\n                    if scanned == 0 { return Ok(None) }\n                    found = self.buf.len()\n                }\n            }\n        }\n        let line = slice(self.buf, self.pos, found)\n        if found < self.buf.len() { self.pos = found + 1 } else { self.pos = found }     // past the \"\\n\"\n        return Ok(Some(line))\n    }\n\n    // Exactly the next `n` bytes (\"\" for n <= 0); None if the input ends\n    // first (the bytes that were there stay unread).\n    fun read_exact(var self, n: int32) -> Result<Option<str>, IoError> {\n        if n <= 0 { return Ok(Some(\"\")) }\n        while self.buf.len() - self.pos < n {\n            if !self.fill(n - (self.buf.len() - self.pos))? { return Ok(None) }\n        }\n        let out = slice(self.buf, self.pos, self.pos + n)\n        self.pos = self.pos + n\n        return Ok(Some(out))\n    }\n\n    // Whether a read won't block: bytes are buffered, or within `timeout_ms`\n    // milliseconds (0: don't wait; negative: wait as long as it takes) input\n    // arrives, the input ends or reading fails (MYLA-80).\n    fun ready(self, timeout_ms: int32) -> bool {\n        if self.pos < self.buf.len() || self.eof { return true }\n        return __poll(self.fd, timeout_ms) != 0\n    }\n\n    // Everything up to the end of the input (\"\" if it has ended).\n    fun read_to_end(var self) -> Result<str, IoError> {\n        var sb = StringBuilder()\n        sb.append(slice(self.buf, self.pos, self.buf.len()))\n        while !self.eof {\n            let chunk = __read(self.fd, CHUNK)\n            let err = __io_errno()\n            if err != 0 { return Err(from_errno(err)) }      // the buffer stays as it was\n            if chunk.len() == 0 { self.eof = true } else { sb.append(chunk) }\n        }\n        self.buf = \"\"\n        self.pos = 0\n        return Ok(sb.build())\n    }\n}\n"
}

fun file_std_json_my() -> str {
    return "// std.json — JSON values, parsing and serialization (MYLA-79).\n//\n// `parse` reads a JSON text into a `Json` value and `to_string` writes one\n// compactly. Both follow Python's `json` module, which the tests compare them\n// with: the same values, the same error messages and positions (Python\n// 3.13's wording), and `to_string` writes what\n// `json.dumps(v, ensure_ascii=False, separators=(\",\", \":\"))` writes. Like\n// Python, they accept and write `NaN`, `Infinity` and `-Infinity`. Unlike\n// Python, a `\\u` escape of a lone surrogate is an error, since a Myla string\n// holds UTF-8.\n\nfrom .num import parse_int, parse_float, format_float\n\n// A JSON value. A number without a fraction or exponent that fits in int64 is\n// an `Int`, any other number a `Float`. An object keeps its members in order,\n// duplicates included (`field` finds the last one, as Python keeps it).\npub enum Json {\n    Null,\n    Bool(bool),\n    Int(int64),\n    Float(float64),\n    Str(str),\n    Array([Json]),\n    Object([(str, Json)]),\n}\n\n// Why a text isn't JSON, and where: line and column count from 1, the column\n// in characters.\npub struct JsonError {\n    msg: str,\n    line: int32,\n    col: int32,\n}\n\n// The member `key` of an object (the last one with that key); None if `j`\n// isn't an object or has no such member.\npub fun field(j: Json, key: str) -> Option<Json> {\n    var found: Option<Json> = None\n    match j {\n        Json.Object(members) => {\n            for m in members {\n                if m.0 == key { found = Some(m.1) }\n            }\n        },\n        _ => {},\n    }\n    return found\n}\n\n// --- Parsing ------------------------------------------------------------------\n\n// How deeply arrays and objects may nest. The parser recurses once per\n// level, and the interpreters run it on their own stack: the self-hosted\n// interpreter's frames are large (it dies at about 300 levels), so the limit\n// is what every implementation survives, not what native code could take.\nconst MAX_DEPTH: int32 = 200\n\nstruct Parser {\n    s: str,\n    i: int32,\n}\n\n// The JSON value that `text` holds, with optional whitespace around it.\npub fun parse(text: str) -> Result<Json, JsonError> {\n    var p = Parser { s: text, i: 0 }\n    let v = p.value(0)?\n    p.skip_ws()\n    if p.i < text.len() { return Err(p.error(\"Extra data\", p.i)) }\n    return Ok(v)\n}\n\nimpl Parser {\n    // An error at byte offset `at`.\n    fun error(self, msg: str, at: int32) -> JsonError {\n        var line = 1\n        var col = 1\n        var k = 0\n        while k < at {\n            let c = self.s[k]\n            if c == '\\n' {\n                line = line + 1\n                col = 1\n            } else if c < 128u8 || c >= 192u8 {\n                col = col + 1                  // not a UTF-8 continuation byte\n            }\n            k = k + 1\n        }\n        return JsonError { msg: msg, line: line, col: col }\n    }\n\n    fun at_end(self) -> bool {\n        return self.i >= self.s.len()\n    }\n\n    fun skip_ws(var self) {\n        while !self.at_end() {\n            let c = self.s[self.i]\n            if c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' { self.i = self.i + 1 } else { return }\n        }\n    }\n\n    // Whether the text at the current position starts with `word`.\n    fun looking_at(self, word: str) -> bool {\n        if self.i + word.len() > self.s.len() { return false }\n        var k = 0\n        while k < word.len() {\n            if self.s[self.i + k] != word[k] { return false }\n            k = k + 1\n        }\n        return true\n    }\n\n    // Move past `word` if the text continues with it.\n    fun take(var self, word: str) -> bool {\n        if !self.looking_at(word) { return false }\n        self.i = self.i + word.len()\n        return true\n    }\n\n    fun value(var self, depth: int32) -> Result<Json, JsonError> {\n        self.skip_ws()\n        if self.at_end() { return Err(self.error(\"Expecting value\", self.i)) }\n        let c = self.s[self.i]\n        if c == '\"' { return Ok(Json.Str(self.string()?)) }\n        if c == '{' || c == '[' {\n            if depth >= MAX_DEPTH { return Err(self.error(\"Too deeply nested\", self.i)) }\n            if c == '{' { return self.object(depth + 1) }\n            return self.array(depth + 1)\n        }\n        if self.take(\"null\") { return Ok(Json.Null) }\n        if self.take(\"true\") { return Ok(Json.Bool(true)) }\n        if self.take(\"false\") { return Ok(Json.Bool(false)) }\n        if self.take(\"NaN\") { return Ok(Json.Float(0.0f64 / 0.0f64)) }\n        if self.take(\"Infinity\") { return Ok(Json.Float(1.0f64 / 0.0f64)) }\n        if self.take(\"-Infinity\") { return Ok(Json.Float(-1.0f64 / 0.0f64)) }\n        return self.number()\n    }\n\n    fun digits(var self) -> int32 {\n        let start = self.i\n        while !self.at_end() && self.s[self.i] >= '0' && self.s[self.i] <= '9' { self.i = self.i + 1 }\n        return self.i - start\n    }\n\n    // -?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][-+]?[0-9]+)? ; an optional part that\n    // is incomplete is left for the caller, as Python's scanner does.\n    fun number(var self) -> Result<Json, JsonError> {\n        let start = self.i\n        if self.s[self.i] == '-' { self.i = self.i + 1 }\n        if self.at_end() || self.s[self.i] < '0' || self.s[self.i] > '9' {\n            return Err(self.error(\"Expecting value\", start))\n        }\n        if self.s[self.i] == '0' { self.i = self.i + 1 } else { self.digits() }\n        var integral = true\n        if self.i + 1 < self.s.len() && self.s[self.i] == '.' && self.s[self.i + 1] >= '0' && self.s[self.i + 1] <= '9' {\n            self.i = self.i + 1\n            self.digits()\n            integral = false\n        }\n        if !self.at_end() && (self.s[self.i] == 'e' || self.s[self.i] == 'E') {\n            let mark = self.i\n            self.i = self.i + 1\n            if !self.at_end() && (self.s[self.i] == '+' || self.s[self.i] == '-') { self.i = self.i + 1 }\n            if self.digits() == 0 { self.i = mark } else { integral = false }\n        }\n        var sb = StringBuilder()\n        sb.append(self.s, start, self.i)\n        let text = sb.build()\n        if integral {\n            match parse_int(text) {\n                Some(n) => { return Ok(Json.Int(n)) },\n                None => {},                       // too large for int64\n            }\n        }\n        return match parse_float(text) {\n            Some(f) => Ok(Json.Float(f)),\n            None => Err(self.error(\"Expecting value\", start)),\n        }\n    }\n\n    // The value of the hex digits s[i..i+4], or -1.\n    fun hex4(self, i: int32) -> int32 {\n        if i + 4 > self.s.len() { return -1 }\n        var v = 0\n        var k = i\n        while k < i + 4 {\n            let c = self.s[k]\n            var d = -1\n            if c >= '0' && c <= '9' { d = (c - '0') as int32 }\n            if c >= 'a' && c <= 'f' { d = (c - 'a') as int32 + 10 }\n            if c >= 'A' && c <= 'F' { d = (c - 'A') as int32 + 10 }\n            if d < 0 { return -1 }\n            v = v * 16 + d\n            k = k + 1\n        }\n        return v\n    }\n\n    // A string, the current position at its opening quote.\n    fun string(var self) -> Result<str, JsonError> {\n        let quote = self.i\n        self.i = self.i + 1\n        var sb = StringBuilder()\n        var run = self.i                         // start of bytes to copy as they are\n        while true {\n            if self.at_end() { return Err(self.error(\"Unterminated string starting at\", quote)) }\n            let c = self.s[self.i]\n            if c == '\"' {\n                sb.append(self.s, run, self.i)\n                self.i = self.i + 1\n                return Ok(sb.build())\n            }\n            if c < 32u8 { return Err(self.error(\"Invalid control character at\", self.i)) }\n            if c != '\\\\' {\n                self.i = self.i + 1\n            } else {\n                sb.append(self.s, run, self.i)\n                if self.i + 1 >= self.s.len() { return Err(self.error(\"Unterminated string starting at\", quote)) }\n                let e = self.s[self.i + 1]\n                if e == 'u' {\n                    let cp = self.unicode_escape()?\n                    sb.append(format(\"{}\", cp as char))\n                } else {\n                    if e == '\"' { sb.append_byte('\"') }\n                    else if e == '\\\\' { sb.append_byte('\\\\') }\n                    else if e == '/' { sb.append_byte('/') }\n                    else if e == 'b' { sb.append_byte(8u8) }\n                    else if e == 'f' { sb.append_byte(12u8) }\n                    else if e == 'n' { sb.append_byte('\\n') }\n                    else if e == 'r' { sb.append_byte(13u8) }\n                    else if e == 't' { sb.append_byte('\\t') }\n                    else { return Err(self.error(\"Invalid \\\\escape\", self.i)) }\n                    self.i = self.i + 2\n                }\n                run = self.i\n            }\n        }\n        unreachable()\n    }\n\n    // The code point of a `\\uXXXX` escape (a surrogate pair is two), the\n    // current position at its backslash; moves past it.\n    fun unicode_escape(var self) -> Result<uint32, JsonError> {\n        let u = self.i + 1\n        let hi = self.hex4(u + 1)\n        if hi < 0 { return Err(self.error(\"Invalid \\\\uXXXX escape\", u)) }\n        self.i = u + 5\n        if hi >= 56320 && hi < 57344 { return Err(self.error(\"Lone surrogate in \\\\uXXXX escape\", u)) }\n        if hi < 55296 || hi >= 56320 { return Ok(hi as uint32) }\n        // a high surrogate: a low one must follow\n        if !self.looking_at(\"\\\\u\") { return Err(self.error(\"Lone surrogate in \\\\uXXXX escape\", u)) }\n        let lo = self.hex4(self.i + 2)\n        if lo < 0 { return Err(self.error(\"Invalid \\\\uXXXX escape\", self.i + 1)) }\n        if lo < 56320 || lo >= 57344 { return Err(self.error(\"Lone surrogate in \\\\uXXXX escape\", u)) }\n        self.i = self.i + 6\n        return Ok((65536 + (hi - 55296) * 1024 + (lo - 56320)) as uint32)\n    }\n\n    // An array, the current position at its \"[\".\n    fun array(var self, depth: int32) -> Result<Json, JsonError> {\n        self.i = self.i + 1\n        var items: [Json] = []\n        self.skip_ws()\n        if !self.at_end() && self.s[self.i] == ']' {\n            self.i = self.i + 1\n            return Ok(Json.Array(items))\n        }\n        while true {\n            items.push(self.value(depth)?)\n            self.skip_ws()\n            if self.at_end() { return Err(self.error(\"Expecting ',' delimiter\", self.i)) }\n            let c = self.s[self.i]\n            if c == ']' {\n                self.i = self.i + 1\n                return Ok(Json.Array(items))\n            }\n            if c != ',' { return Err(self.error(\"Expecting ',' delimiter\", self.i)) }\n            let comma = self.i\n            self.i = self.i + 1\n            self.skip_ws()\n            if !self.at_end() && self.s[self.i] == ']' {\n                return Err(self.error(\"Illegal trailing comma before end of array\", comma))\n            }\n        }\n        unreachable()\n    }\n\n    // An object, the current position at its \"{\".\n    fun object(var self, depth: int32) -> Result<Json, JsonError> {\n        self.i = self.i + 1\n        var members: [(str, Json)] = []\n        self.skip_ws()\n        if !self.at_end() && self.s[self.i] == '}' {\n            self.i = self.i + 1\n            return Ok(Json.Object(members))\n        }\n        while true {\n            if self.at_end() || self.s[self.i] != '\"' {\n                return Err(self.error(\"Expecting property name enclosed in double quotes\", self.i))\n            }\n            let key = self.string()?\n            self.skip_ws()\n            if self.at_end() || self.s[self.i] != ':' { return Err(self.error(\"Expecting ':' delimiter\", self.i)) }\n            self.i = self.i + 1\n            let v = self.value(depth)?\n            members.push((key, v))\n            self.skip_ws()\n            if self.at_end() { return Err(self.error(\"Expecting ',' delimiter\", self.i)) }\n            let c = self.s[self.i]\n            if c == '}' {\n                self.i = self.i + 1\n                return Ok(Json.Object(members))\n            }\n            if c != ',' { return Err(self.error(\"Expecting ',' delimiter\", self.i)) }\n            let comma = self.i\n            self.i = self.i + 1\n            self.skip_ws()\n            if !self.at_end() && self.s[self.i] == '}' {\n                return Err(self.error(\"Illegal trailing comma before end of object\", comma))\n            }\n        }\n        unreachable()\n    }\n}\n\n// --- Writing ------------------------------------------------------------------\n\n// `j` as compact JSON text.\n#test(Json.Array([Json.Int(1), Json.Float(2.5), Json.Str(\"a\\\"b\"), Json.Null]))[\"[1,2.5,\\\"a\\\\\\\"b\\\",null]\"]\n#test(Json.Object([(\"k\", Json.Bool(true)), (\"e\", Json.Object([]))]))[\"{\\\"k\\\":true,\\\"e\\\":{}}\"]\npub fun to_string(j: Json) -> str {\n    var w = Writer { sb: StringBuilder() }\n    w.value(j)\n    return w.sb.build()\n}\n\nstruct Writer {\n    sb: StringBuilder,\n}\n\nimpl Writer {\n    fun value(var self, j: Json) {\n        match j {\n            Json.Null => { self.sb.append(\"null\") },\n            Json.Bool(b) => {\n                if b { self.sb.append(\"true\") } else { self.sb.append(\"false\") }\n            },\n            Json.Int(n) => { self.sb.append(format(\"{}\", n)) },\n            Json.Float(f) => { self.sb.append(float_text(f)) },\n            Json.Str(s) => { self.string(s) },\n            Json.Array(items) => {\n                self.sb.append_byte('[')\n                var first = true\n                for item in items {\n                    if !first { self.sb.append_byte(',') }\n                    self.value(item)\n                    first = false\n                }\n                self.sb.append_byte(']')\n            },\n            Json.Object(members) => {\n                self.sb.append_byte('{')\n                var first = true\n                for m in members {\n                    if !first { self.sb.append_byte(',') }\n                    self.string(m.0)\n                    self.sb.append_byte(':')\n                    self.value(m.1)\n                    first = false\n                }\n                self.sb.append_byte('}')\n            },\n        }\n    }\n\n    // `s` quoted: '\"' and '\\\\' escaped, control characters as \\n, \\t … or\n    // \\u00XX; everything else (non-ASCII included) as it is.\n    fun string(var self, s: str) {\n        self.sb.append_byte('\"')\n        var run = 0\n        var i = 0\n        while i < s.len() {\n            let c = s[i]\n            if c == '\"' || c == '\\\\' || c < 32u8 {\n                self.sb.append(s, run, i)\n                if c == '\"' { self.sb.append(\"\\\\\\\"\") }\n                else if c == '\\\\' { self.sb.append(\"\\\\\\\\\") }\n                else if c == '\\n' { self.sb.append(\"\\\\n\") }\n                else if c == '\\t' { self.sb.append(\"\\\\t\") }\n                else if c == 13u8 { self.sb.append(\"\\\\r\") }\n                else if c == 8u8 { self.sb.append(\"\\\\b\") }\n                else if c == 12u8 { self.sb.append(\"\\\\f\") }\n                else {\n                    self.sb.append(\"\\\\u00\")\n                    self.sb.append_byte(HEX[(c >> 4u8) as int32])\n                    self.sb.append_byte(HEX[(c & 15u8) as int32])\n                }\n                run = i + 1\n            }\n            i = i + 1\n        }\n        self.sb.append(s, run, s.len())\n        self.sb.append_byte('\"')\n    }\n}\n\nconst HEX: str = \"0123456789abcdef\"\n\n// A float as Python's json writes it: its shortest repr, with NaN and the\n// infinities spelled as JavaScript does.\n#test(0.1)[\"0.1\"]\n#test(1e16)[\"1e+16\"]\nfun float_text(f: float64) -> str {\n    let t = format_float(f)\n    if t == \"nan\" { return \"NaN\" }\n    if t == \"inf\" { return \"Infinity\" }\n    if t == \"-inf\" { return \"-Infinity\" }\n    return t\n}\n\n// `text` parsed and written again, or the error (for the #test cases).\n#test(\" [1, 2.5, \\\"x\\\", true, null, {\\\"a\\\": {}}] \")[\"[1,2.5,\\\"x\\\",true,null,{\\\"a\\\":{}}]\"]\n#test(\"\\\"\\\\u00e9\\\\ud83d\\\\ude00\\\\n\\\"\")[\"\\\"é😀\\\\n\\\"\"]\n#test(\"[-0, -0.0, 1E2, 1e400, NaN]\")[\"[0,-0.0,100.0,Infinity,NaN]\"]\n#test(\"[1,]\")[\"1:3: Illegal trailing comma before end of array\"]\n#test(\"{\\\"a\\\" 1}\")[\"1:6: Expecting ':' delimiter\"]\n#test(\"[\\\"abc\")[\"1:2: Unterminated string starting at\"]\n#test(\"[\\\"a\\n\")[\"1:4: Invalid control character at\"]\n#test(\"\\\"\\\\ud800\\\"\")[\"1:3: Lone surrogate in \\\\uXXXX escape\"]\n#test(\"\")[\"1:1: Expecting value\"]\nfun round_trip(text: str) -> str {\n    return match parse(text) {\n        Ok(v) => to_string(v),\n        Err(e) => format(\"{}:{}: {}\", e.line, e.col, e.msg),\n    }\n}\n\n"
}

fun file_std_num_my() -> str {
    return "// std.num — numbers from text (MYLA-79).\n//\n// `parse_int` and `parse_float` read decimal numbers such as `-42` and\n// `1.5e-3`. A float is the correctly rounded double, computed with big\n// integers, so the result is the same in every implementation; the\n// self-hosted compiler converts its float literals with the same code\n// (`f64_literal_bits`, `f32_round_bits`), so it needs no float arithmetic\n// (MYLA-29).\n//\n// A big integer is a list of 32-bit limbs held in uint64, least significant\n// first, with no high zero limbs (zero is the empty list).\n\nconst LIMB: uint64 = 4294967296\nconst F64_INF: uint64 = 9218868437227405312     // 0x7ff0000000000000\n\nfun big_norm(a: [uint64]) -> [uint64] {\n    var r = a\n    while r.len() > 0 && r[r.len() - 1] == 0 {\n        r.pop()\n    }\n    return r\n}\n\nfun big_from_u64(x: uint64) -> [uint64] {\n    return big_norm([x % LIMB, x / LIMB])\n}\n\n// a * m + add, for m, add < 2^32\nfun big_mul_add(a: [uint64], m: uint64, add: uint64) -> [uint64] {\n    var out: [uint64] = []\n    var carry = add\n    for limb in a {\n        let t = limb * m + carry\n        out.push(t % LIMB)\n        carry = t / LIMB\n    }\n    if carry > 0 {\n        out.push(carry)\n    }\n    return big_norm(out)\n}\n\nfun u64_bitlen(x: uint64) -> int32 {\n    var n = 0\n    var v = x\n    while v > 0 {\n        v = v >> 1\n        n = n + 1\n    }\n    return n\n}\n\nfun big_bitlen(a: [uint64]) -> int32 {\n    if a.len() == 0 {\n        return 0\n    }\n    return (a.len() as int32 - 1) * 32 + u64_bitlen(a[a.len() - 1])\n}\n\nfun big_bit(a: [uint64], i: int32) -> bool {\n    let limb = i / 32\n    if limb >= a.len() as int32 {\n        return false\n    }\n    return ((a[limb] >> ((i % 32) as uint64)) & 1) == 1\n}\n\n// whether any of the low `n` bits of `a` is set\nfun big_low_bits_set(a: [uint64], n: int32) -> bool {\n    var i = 0\n    while i < n {\n        if big_bit(a, i) {\n            return true\n        }\n        i = i + 1\n    }\n    return false\n}\n\nfun big_shl(a: [uint64], s: int32) -> [uint64] {\n    if a.len() == 0 {\n        return a\n    }\n    var out: [uint64] = []\n    var i = 0\n    while i < s / 32 {\n        out.push(0)\n        i = i + 1\n    }\n    let bits = (s % 32) as uint64\n    var carry: uint64 = 0\n    for limb in a {\n        let t = (limb << bits) | carry\n        out.push(t % LIMB)\n        carry = t / LIMB\n    }\n    if carry > 0 {\n        out.push(carry)\n    }\n    return big_norm(out)\n}\n\nfun big_shr(a: [uint64], s: int32) -> [uint64] {\n    let skip = s / 32\n    let bits = (s % 32) as uint64\n    var out: [uint64] = []\n    var i = skip\n    while i < a.len() as int32 {\n        var t = a[i] >> bits\n        if i + 1 < a.len() as int32 && bits > 0 {\n            t = t | ((a[i + 1] << (32 - bits)) % LIMB)\n        }\n        out.push(t)\n        i = i + 1\n    }\n    return big_norm(out)\n}\n\nfun big_cmp(a: [uint64], b: [uint64]) -> int32 {\n    if a.len() != b.len() {\n        return match a.len() < b.len() { true => -1, false => 1 }\n    }\n    var i = a.len() as int32 - 1\n    while i >= 0 {\n        if a[i] != b[i] {\n            return match a[i] < b[i] { true => -1, false => 1 }\n        }\n        i = i - 1\n    }\n    return 0\n}\n\n// a - b, for a >= b\nfun big_sub(a: [uint64], b: [uint64]) -> [uint64] {\n    var out: [uint64] = []\n    var borrow: uint64 = 0\n    var i = 0\n    while i < a.len() {\n        var sub = borrow\n        if i < b.len() {\n            sub = sub + b[i]\n        }\n        if a[i] >= sub {\n            out.push(a[i] - sub)\n            borrow = 0\n        } else {\n            out.push(a[i] + LIMB - sub)\n            borrow = 1\n        }\n        i = i + 1\n    }\n    return big_norm(out)\n}\n\nfun big_to_u64(a: [uint64]) -> uint64 {\n    var r: uint64 = 0\n    if a.len() > 0 {\n        r = a[0]\n    }\n    if a.len() > 1 {\n        r = r | (a[1] << 32)\n    }\n    return r\n}\n\nstruct DivMod { q: [uint64], r: [uint64] }\n\n// schoolbook binary long division; the quotients here have about 64 bits\nfun big_divmod(n: [uint64], d: [uint64]) -> DivMod {\n    var q: [uint64] = []\n    var r: [uint64] = []\n    var i = big_bitlen(n) - 1\n    while i >= 0 {\n        r = big_shl(r, 1)\n        if big_bit(n, i) {\n            r = big_mul_add(r, 1, 1)\n        }\n        q = big_shl(q, 1)\n        if big_cmp(r, d) >= 0 {\n            r = big_sub(r, d)\n            q = big_mul_add(q, 1, 1)\n        }\n        i = i - 1\n    }\n    return DivMod { q: q, r: r }\n}\n\n// A rounded binary value: mant * 2^exp, or infinity.\nstruct Rounded { mant: uint64, exp: int32, inf: bool }\n\n// Round v * 2^e0 (plus a nonzero tail below it when `sticky`) to nearest, ties\n// to even, keeping at most `prec` significant bits and no bit below 2^emin\n// (which makes subnormals come out right); infinity above 2^(emax+1).\nfun round_binary(v: [uint64], e0: int32, sticky: bool, prec: int32, emin: int32, emax: int32) -> Rounded {\n    let bl = big_bitlen(v)\n    if bl == 0 {\n        return Rounded { mant: 0, exp: 0, inf: false }\n    }\n    var drop = bl - prec\n    if emin - e0 > drop {\n        drop = emin - e0\n    }\n    var mant: uint64 = 0\n    var e = e0\n    if drop <= 0 {\n        mant = big_to_u64(v)     // exact; a sticky tail alone rounds down\n    } else {\n        mant = big_to_u64(big_shr(v, drop))\n        let half = big_bit(v, drop - 1)\n        let rest = sticky || big_low_bits_set(v, drop - 1)\n        if half && (rest || (mant & 1) == 1) {\n            mant = mant + 1\n        }\n        e = e0 + drop\n        if mant == (1 as uint64) << (prec as uint64) {\n            mant = mant >> 1\n            e = e + 1\n        }\n    }\n    if mant != 0 && u64_bitlen(mant) - 1 + e > emax {\n        return Rounded { mant: 0, exp: 0, inf: true }\n    }\n    return Rounded { mant: mant, exp: e, inf: false }\n}\n\n// The double bits of the exact value mant * 2^e (representable as a double).\nfun f64_bits_exact(r: Rounded) -> uint64 {\n    if r.inf {\n        return F64_INF\n    }\n    if r.mant == 0 {\n        return 0\n    }\n    let bl = u64_bitlen(r.mant)\n    let top = bl - 1 + r.exp\n    if top >= -1022 {\n        let m53 = r.mant << ((53 - bl) as uint64)\n        return (((top + 1023) as uint64) << 52) | (m53 - ((1 as uint64) << 52))\n    }\n    return r.mant << ((r.exp + 1074) as uint64)    // subnormal\n}\n\n// The correctly rounded double of a float literal's lexeme, such as\n// `3.25`, `1_000.5e-3`, `2f32` (underscores and the suffix are ignored).\n#test(\"0.5\")[4602678819172646912u64]\n#test(\"0.1\")[4591870180066957722u64]\n#test(\"2f32\")[4611686018427387904u64]\n#test(\"1e400\")[9218868437227405312u64]\npub fun f64_literal_bits(lexeme: str) -> uint64 {\n    var n: [uint64] = []\n    var digits = 0               // significant digits seen (for the zero test)\n    var frac = 0                 // digits after the point\n    var in_frac = false\n    var exp = 0\n    var exp_neg = false\n    var in_exp = false\n    var i = 0\n    while i < lexeme.len() {\n        let c = lexeme[i]\n        if c == 'f' {\n            break                // the suffix\n        } else if c == '_' {\n            i = i + 1\n            continue\n        } else if c == '.' {\n            in_frac = true\n        } else if c == 'e' || c == 'E' {\n            in_exp = true\n        } else if c == '-' {\n            exp_neg = true\n        } else if c == '+' {\n            exp_neg = false\n        } else if in_exp {\n            if exp < 100000 {\n                exp = exp * 10 + (c - '0') as int32\n            }\n        } else {\n            n = big_mul_add(n, 10, (c - '0') as uint64)\n            if n.len() > 0 {\n                digits = digits + 1\n            }\n            if in_frac {\n                frac = frac + 1\n            }\n        }\n        i = i + 1\n    }\n    if n.len() == 0 {\n        return 0\n    }\n    if exp_neg {\n        exp = -exp\n    }\n    let e10 = exp - frac\n    if e10 >= 0 {\n        if e10 > 400 {\n            return F64_INF\n        }\n        return f64_bits_exact(round_binary(big_mul_pow10(n, e10), 0, false, 53, -1074, 1023))\n    }\n    if digits + e10 < -400 {\n        return 0\n    }\n    let d = big_mul_pow10([1], -e10)\n    var s = 64 + big_bitlen(d) - big_bitlen(n)\n    if s < 0 {\n        s = 0\n    }\n    let qr = big_divmod(big_shl(n, s), d)\n    return f64_bits_exact(round_binary(qr.q, -s, qr.r.len() > 0, 53, -1074, 1023))\n}\n\nfun big_mul_pow10(n: [uint64], k: int32) -> [uint64] {\n    var r = n\n    var i = 0\n    while i < k {\n        r = big_mul_add(r, 10, 0)\n        i = i + 1\n    }\n    return r\n}\n\n// Round a double (given as bits) to single precision and widen it back: the\n// double bits of the float32 nearest to it, as the Python toolchain does.\n#test(4591870180066957722u64)[4591870180174331904u64]\n#test(9218868437227405312u64)[9218868437227405312u64]\npub fun f32_round_bits(bits: uint64) -> uint64 {\n    let sign = bits & 9223372036854775808u64\n    let biased = ((bits >> 52) & 2047) as int32\n    if biased == 2047 {\n        return bits                  // inf / nan stay as they are\n    }\n    var mant = bits & 4503599627370495\n    var e = -1074\n    if biased > 0 {\n        mant = mant | ((1 as uint64) << 52)\n        e = biased - 1075\n    }\n    return sign | f64_bits_exact(round_binary(big_from_u64(mant), e, false, 24, -149, 127))\n}\n\n// The float64 with IEEE bit pattern `bits`, which must be non-negative and\n// not NaN (as `f64_literal_bits` gives), built exactly as mantissa * 2^exp.\n#test(4602678819172646912u64)[0.5]\n#test(0u64)[0.0]\npub fun float_from_bits(bits: uint64) -> float64 {\n    let biased = ((bits >> 52) & 2047) as int32\n    if biased == 2047 {\n        return 1.0f64 / 0.0f64\n    }\n    var mant = bits & 4503599627370495\n    var e = -1074\n    if biased > 0 {\n        mant = mant | ((1 as uint64) << 52)\n        e = biased - 1075\n    }\n    let x = mant as float64             // exact: mant < 2^53\n    if e < -1000 {\n        // in two steps, so the intermediate stays a normal double\n        return x * pow2(e + 600) * pow2(-600)\n    }\n    return x * pow2(e)\n}\n\n// 2^k exactly, for -1022 <= k <= 1023 (repeated squaring)\n#test(10)[1024.0]\n#test(-2)[0.25]\npub fun pow2(k: int32) -> float64 {\n    var base = 2.0f64\n    var n = k\n    if n < 0 {\n        base = 0.5f64\n        n = -n\n    }\n    var r = 1.0f64\n    while n > 0 {\n        if (n & 1) == 1 {\n            r = r * base\n        }\n        base = base * base\n        n = n >> 1\n    }\n    return r\n}\n\n// The number of decimal digits at `s[i..]`.\nfun digits_at(s: str, i: int32) -> int32 {\n    var j = i\n    while j < s.len() && s[j] >= '0' && s[j] <= '9' { j = j + 1 }\n    return j - i\n}\n\n// The int64 written in decimal in `s`, with an optional leading \"-\"; None if\n// `s` is anything else or out of range.\n#test(\"42\")[Some(42i64)]\n#test(\"-9223372036854775808\")[Some(-9223372036854775807i64 - 1i64)]\n#test(\"9223372036854775808\")[None]\n#test(\"\")[None]\n#test(\"-\")[None]\n#test(\"1.0\")[None]\n#test(\"+1\")[None]\npub fun parse_int(s: str) -> Option<int64> {\n    var i = 0\n    let negative = s.len() > 0 && s[0] == '-'\n    if negative { i = 1 }\n    if digits_at(s, i) == 0 || digits_at(s, i) != s.len() - i { return None }\n    var limit: uint64 = 9223372036854775807u64\n    if negative { limit = limit + 1u64 }\n    var n: uint64 = 0u64\n    while i < s.len() {\n        let d = (s[i] - '0') as uint64\n        if n > (limit - d) / 10u64 { return None }\n        n = n * 10u64 + d\n        i = i + 1\n    }\n    if negative {\n        if n == 9223372036854775808u64 { return Some(-9223372036854775807i64 - 1i64) }\n        return Some(-(n as int64))\n    }\n    return Some(n as int64)\n}\n\n// The float64 nearest the decimal number in `s`: an optional \"-\", digits,\n// optionally \".\" and digits, optionally \"e\" or \"E\", a sign and digits. None\n// if `s` is anything else. Too large a number is infinite.\n#test(\"1.5\")[Some(1.5)]\n#test(\"-2e-3\")[Some(-0.002)]\n#test(\"1E+2\")[Some(100.0)]\n#test(\"7\")[Some(7.0)]\n#test(\".5\")[None]\n#test(\"1.\")[None]\n#test(\"1e\")[None]\n#test(\"1x\")[None]\npub fun parse_float(s: str) -> Option<float64> {\n    var i = 0\n    let negative = s.len() > 0 && s[0] == '-'\n    if negative { i = 1 }\n    var n = digits_at(s, i)\n    if n == 0 { return None }\n    i = i + n\n    if i < s.len() && s[i] == '.' {\n        n = digits_at(s, i + 1)\n        if n == 0 { return None }\n        i = i + 1 + n\n    }\n    if i < s.len() && (s[i] == 'e' || s[i] == 'E') {\n        i = i + 1\n        if i < s.len() && (s[i] == '+' || s[i] == '-') { i = i + 1 }\n        n = digits_at(s, i)\n        if n == 0 { return None }\n        i = i + n\n    }\n    if i != s.len() { return None }\n    var text = s\n    if negative {\n        var sb = StringBuilder()\n        sb.append(s, 1, s.len())\n        text = sb.build()\n    }\n    let x = float_from_bits(f64_literal_bits(text))\n    if negative { return Some(-x) }\n    return Some(x)\n}\n\n// --- Floats to text -------------------------------------------------------------\n\n// a / d and a % d, for 0 < d < 2^32\nfun big_divmod_small(a: [uint64], d: uint64) -> ([uint64], uint64) {\n    var q: [uint64] = []\n    for x in a { q.push(0) }\n    var rem: uint64 = 0\n    var i = a.len() - 1\n    while i >= 0 {\n        let cur = (rem << 32) | a[i]\n        q[i] = cur / d\n        rem = cur % d\n        i = i - 1\n    }\n    return (big_norm(q), rem)\n}\n\n// The decimal digits of `a` (\"0\" for zero).\nfun big_to_decimal(a: [uint64]) -> str {\n    if a.len() == 0 { return \"0\" }\n    var chunks: [uint64] = []                // base 10^9, least significant first\n    var n = a\n    while n.len() > 0 {\n        let qr = big_divmod_small(n, 1000000000)\n        chunks.push(qr.1)\n        n = qr.0\n    }\n    var sb = StringBuilder()\n    var i = chunks.len() - 1\n    sb.append(format(\"{}\", chunks[i]))\n    i = i - 1\n    while i >= 0 {\n        let part = format(\"{}\", chunks[i])\n        var pad = 9 - part.len()\n        while pad > 0 {\n            sb.append_byte('0')\n            pad = pad - 1\n        }\n        sb.append(part)\n        i = i - 1\n    }\n    return sb.build()\n}\n\n// a * 5^k\nfun big_mul_pow5(a: [uint64], k: int32) -> [uint64] {\n    var r = a\n    var n = k\n    while n >= 13 {\n        r = big_mul_add(r, 1220703125, 0)      // 5^13\n        n = n - 13\n    }\n    while n > 0 {\n        r = big_mul_add(r, 5, 0)\n        n = n - 1\n    }\n    return r\n}\n\n// A finite x > 0 as mant * 2^exp exactly, with mant < 2^53.\nstruct Binary { mant: uint64, exp: int32 }\n\nfun decompose(x: float64) -> Binary {\n    var v = x\n    var e = 0\n    let two53 = pow2(53)\n    while v >= pow2(117) {\n        v = v * pow2(-64)\n        e = e + 64\n    }\n    while v >= two53 {\n        v = v * 0.5f64\n        e = e + 1\n    }\n    // scaling up by a power of two is exact; a subnormal stops at 2^-1074\n    while v < pow2(-12) && e - 64 >= -1074 {\n        v = v * pow2(64)\n        e = e - 64\n    }\n    while v < pow2(52) && e > -1074 {\n        v = v * 2.0f64\n        e = e - 1\n    }\n    return Binary { mant: v as uint64, exp: e }\n}\n\n// `digits` (no leading zero) rounded to nearest, ties to even, to at most `p`\n// digits; the result's decimal point moves one place right when 9s carry.\nstruct Decimal { digits: str, point: int32 }   // the value 0.digits * 10^point\n\nfun round_digits(d: Decimal, p: int32) -> Decimal {\n    if d.digits.len() <= p { return d }\n    var sb = StringBuilder()\n    sb.append(d.digits, 0, p)\n    var kept = sb.build()\n    let next = d.digits[p]\n    var rest = false\n    var i = p + 1\n    while i < d.digits.len() {\n        if d.digits[i] != '0' { rest = true }\n        i = i + 1\n    }\n    let odd = (kept[p - 1] - '0') % 2 == 1\n    if next > '5' || (next == '5' && (rest || odd)) {\n        // add one in the last place\n        var out: [uint8] = []\n        var carry = true\n        var j = p - 1\n        while j >= 0 {\n            var c = kept[j]\n            if carry {\n                if c == '9' { c = '0' } else {\n                    c = c + 1\n                    carry = false\n                }\n            }\n            out.push(c)\n            j = j - 1\n        }\n        var sb2 = StringBuilder()\n        if carry { sb2.append_byte('1') }\n        var k = out.len() - 1\n        while k >= 0 {\n            sb2.append_byte(out[k])\n            k = k - 1\n        }\n        var point = d.point\n        if carry { point = point + 1 }\n        return Decimal { digits: strip_zeros(sb2.build()), point: point }\n    }\n    return Decimal { digits: strip_zeros(kept), point: d.point }\n}\n\n// `s` without trailing \"0\"s (at least one digit stays).\n#test(\"1200\")[\"12\"]\n#test(\"0\")[\"0\"]\nfun strip_zeros(s: str) -> str {\n    var n = s.len()\n    while n > 1 && s[n - 1] == '0' { n = n - 1 }\n    var sb = StringBuilder()\n    sb.append(s, 0, n)\n    return sb.build()\n}\n\n// \"d.ddd\" (or \"d\") followed by \"e\" and the exponent: a literal that\n// f64_literal_bits reads.\nfun scientific(d: Decimal) -> str {\n    var sb = StringBuilder()\n    sb.append(d.digits, 0, 1)\n    if d.digits.len() > 1 {\n        sb.append_byte('.')\n        sb.append(d.digits, 1, d.digits.len())\n    }\n    sb.append(format(\"e{}\", d.point - 1))\n    return sb.build()\n}\n\n// The shortest decimal that reads back as `x`, written as Python's repr\n// writes floats: \"1.0\", \"0.1\", \"1e+16\", \"1.5e-07\", \"-0.0\", \"nan\", \"inf\".\n// Exponents below -4 or from 16 on use scientific notation.\n#test(1.0)[\"1.0\"]\n#test(0.1)[\"0.1\"]\n#test(-2.5)[\"-2.5\"]\n#test(1e16)[\"1e+16\"]\n#test(1.5e-7)[\"1.5e-07\"]\n#test(123456789012345680000.0)[\"1.2345678901234568e+20\"]\n#test(1e15)[\"1000000000000000.0\"]\n#test(0.0001)[\"0.0001\"]\n#test(5e-324)[\"5e-324\"]\n#test(-0.0)[\"-0.0\"]\npub fun format_float(x: float64) -> str {\n    if x != x { return \"nan\" }\n    var v = x\n    var sign = \"\"\n    if v < 0.0f64 || (v == 0.0f64 && 1.0f64 / v < 0.0f64) {\n        sign = \"-\"\n        v = -v\n    }\n    if v == 0.0f64 { return sign + \"0.0\" }\n    if v > 1.7976931348623157e308f64 { return sign + \"inf\" }\n    // the exact decimal expansion of v\n    let b = decompose(v)\n    var exact = Decimal { digits: \"\", point: 0 }\n    if b.exp >= 0 {\n        let digits = big_to_decimal(big_shl(big_from_u64(b.mant), b.exp))\n        exact = Decimal { digits: strip_zeros(digits), point: digits.len() }\n    } else {\n        let digits = big_to_decimal(big_mul_pow5(big_from_u64(b.mant), -b.exp))\n        exact = Decimal { digits: strip_zeros(digits), point: digits.len() + b.exp }\n    }\n    // the fewest digits that read back as v: 17 always do, and if p digits\n    // do, so do more (they are closer), so a binary search finds it\n    var lo = 1\n    var hi = 17\n    while lo < hi {\n        let mid = (lo + hi) / 2\n        if float_from_bits(f64_literal_bits(scientific(round_digits(exact, mid)))) == v { hi = mid } else { lo = mid + 1 }\n    }\n    let d = round_digits(exact, lo)\n    let e10 = d.point - 1\n    var sb = StringBuilder()\n    sb.append(sign)\n    if e10 >= -4 && e10 < 16 {\n        if d.point <= 0 {\n            sb.append(\"0.\")\n            var z = -d.point\n            while z > 0 {\n                sb.append_byte('0')\n                z = z - 1\n            }\n            sb.append(d.digits)\n        } else if d.point >= d.digits.len() {\n            sb.append(d.digits)\n            var z = d.point - d.digits.len()\n            while z > 0 {\n                sb.append_byte('0')\n                z = z - 1\n            }\n            sb.append(\".0\")\n        } else {\n            sb.append(d.digits, 0, d.point)\n            sb.append_byte('.')\n            sb.append(d.digits, d.point, d.digits.len())\n        }\n    } else {\n        sb.append(d.digits, 0, 1)\n        if d.digits.len() > 1 {\n            sb.append_byte('.')\n            sb.append(d.digits, 1, d.digits.len())\n        }\n        if e10 < 0 { sb.append(\"e-\") } else { sb.append(\"e+\") }\n        var mag = e10\n        if mag < 0 { mag = -mag }\n        if mag < 10 { sb.append_byte('0') }\n        sb.append(format(\"{}\", mag))\n    }\n    return sb.build()\n}\n"
}

fun file_std_process_my() -> str {
    return "// std.process — process control (v0.5.4, D29).\n//\n// The file-backed `std.fs` surface arrives in a later v0.5.4 slice; for now\n// this exposes the command-line arguments and process termination.\n\n// The process command-line arguments, captured at startup. `args()[0]` is the\n// program name as invoked; the remainder are its arguments.\npub fun args() -> [str] {\n    return __args()\n}\n\n// Terminate the process with `code` (the low 8 bits become the exit status).\npub fun exit(code: int32) {\n    __exit(code)\n}\n\n// The value of the environment variable `name` the process started with\n// (`\"\"` included), or `None` when there is no such variable (MYLA-243).\n#test(\"\")[None]\npub fun env(name: str) -> Option<str> {\n    let value = __getenv(name)\n    if __io_errno() != 0 {\n        return None\n    }\n    return Some(value)\n}\n\n// --- Subprocess execution (D29 follow-on) ---------------------------------\n//\n// `run` / `Command` spawn an external program, wait for it to finish, and\n// return its captured output. The program is located by the exact path given\n// (no PATH search — pass an explicit path such as \"/usr/bin/as\"); the child\n// inherits the current process environment. Output is returned as raw bytes\n// (`[uint8]`) so binary output survives intact; decode to text yourself when\n// you know it is UTF-8.\n\n// How a finished child terminated.\npub enum ExitStatus {\n    // Exited normally with this status code (0 = success).\n    Exited(int32),\n    // Killed by this signal number.\n    Signaled(int32),\n}\n\n// The captured result of a finished subprocess.\npub struct Output {\n    stdout: [uint8],\n    stderr: [uint8],\n    status: ExitStatus,\n}\n\n// Why a process could not be spawned. `Other` carries the raw OS errno.\npub enum SpawnError {\n    NotFound,\n    PermissionDenied,\n    Other(int32),\n}\n\n// Map a (nonzero) spawn errno to a `SpawnError`. ENOENT/EACCES on Linux.\nfun spawn_error_from_errno(code: int32) -> SpawnError {\n    if code == 2 {\n        return SpawnError.NotFound\n    }\n    if code == 13 {\n        return SpawnError.PermissionDenied\n    }\n    return SpawnError.Other(code)\n}\n\n// Spawn `program` with the complete argument vector `argv` (argv[0] included),\n// wait for it, and collect its output. Shared by `run` and `Command.output`.\nfun collect(program: str, argv: [str]) -> Result<Output, SpawnError> {\n    let out = __run(program, argv)\n    let err = __run_errno()\n    if err != 0 {\n        return Err(spawn_error_from_errno(err))\n    }\n    let errbuf = __run_stderr()\n    let sig = __run_signal()\n    var status = ExitStatus.Exited(__run_exit_code())\n    if sig != 0 {\n        status = ExitStatus.Signaled(sig)\n    }\n    return Ok(Output { stdout: out, stderr: errbuf, status: status })\n}\n\n// Run `program` with `args` (excluding argv[0], which is set to `program`),\n// wait for it, and return its captured output or a `SpawnError`.\npub fun run(program: str, args: [str]) -> Result<Output, SpawnError> {\n    var argv = [program]\n    for a in args {\n        argv.push(a)\n    }\n    return collect(program, argv)\n}\n\n// A builder for a subprocess invocation. Start with `command`, chain `arg` /\n// `args`, then call `output`.\npub struct Command {\n    program: str,\n    argv: [str],\n}\n\n// Begin building a command for `program`. `argv[0]` is seeded with `program`.\npub fun command(program: str) -> Command {\n    return Command { program: program, argv: [program] }\n}\n\nimpl Command {\n    // Append a single argument, returning the extended command.\n    fun arg(self, a: str) -> Command {\n        var argv = self.argv\n        argv.push(a)\n        return Command { program: self.program, argv: argv }\n    }\n\n    // Append several arguments, returning the extended command.\n    fun args(self, extra: [str]) -> Command {\n        var argv = self.argv\n        for a in extra {\n            argv.push(a)\n        }\n        return Command { program: self.program, argv: argv }\n    }\n\n    // Spawn the command, wait for it, and collect its output.\n    fun output(self) -> Result<Output, SpawnError> {\n        return collect(self.program, self.argv)\n    }\n}\n"
}

fun file_std_task_my() -> str {
    return "// std.task — running a number of child tasks known only at run time (D89,\n// docs/Language/Concurrency.md).\n//\n// `all(fs)` runs each async function value of `fs` as a child task, all of\n// them at once, and gives their results in the order of `fs`, whichever\n// finished first. It is written with `async let` alone: the list is halved\n// until each half holds one function, so the tasks nest about log2(len(fs))\n// deep and every child is awaited before `all` returns. Each child gets only\n// its half: a child's captures are copied (D89), so passing the whole list\n// down would copy it at every level.\n\n// The results of `fs`, run as child tasks at once, in the order of `fs`.\npub async fun all<T>(fs: [async () -> T]) -> [T] {\n    if fs.len() == 0 {\n        return []\n    }\n    return await run_halves(fs)\n}\n\n// The results of `fs` (not empty), run as child tasks.\nasync fun run_halves<T>(fs: [async () -> T]) -> [T] {\n    if fs.len() == 1 {\n        let f = fs[0]\n        return [await f()]\n    }\n    let mid = fs.len() / 2\n    var low: [async () -> T] = []\n    var high: [async () -> T] = []\n    for i in 0..fs.len() {\n        if i < mid {\n            low.push(fs[i])\n        } else {\n            high.push(fs[i])\n        }\n    }\n    async let left = run_halves(low)\n    async let right = run_halves(high)\n    var out = await left\n    for x in await right {\n        out.push(x)\n    }\n    return out\n}\n\n// `task.cancel(a)`: the child task of the `async let` named `a` (and its own\n// children) is asked to stop (D96). Only a flag: the child sees it with\n// `cancelled()` and finishes as it chooses (giving back what it holds,\n// returning early); nothing stops on its own, and `await a` gives what it\n// returned. Cancelling a task that has ended does nothing. The argument is the\n// name of an `async let`, as for `await`: the compiler takes this call itself,\n// and this body never runs.\npub fun cancel(child: int) {\n}\n\n// Whether the running task, or a task above it, was cancelled (D96): false\n// in the program's first task and outside any task.\npub fun cancelled() -> bool {\n    return __task_cancelled()\n}\n\n// `await task.yield()`: a turn for the other tasks, and nothing else (D107,\n// MYLA-228). The running task goes behind the ready ones (D110) and goes on\n// when its turn comes; a task the end of the program stopped stops here (D97),\n// so a loop that would never wait otherwise (a sibling spinning while another\n// fails) gives the others a turn with it.\npub async fun yield() {\n    await __yield()\n}\n"
}

fun file_std_toml_my() -> str {
    return "// std.toml — the TOML subset of `myla.toml` and `myla.lock` (MYLA-89, D73).\n//\n// `parse` reads a document into a `Toml` table. The subset, specified on the\n// wiki page Architecture/Project-tool, is TOML 1.0 without floats, dates and\n// times, hexadecimal, octal and binary integers, multi-line strings, dotted\n// keys and arrays of tables; arrays hold strings only. Every document it\n// accepts means the same in TOML: the tests compare it with Python's\n// `tomllib`. A construct outside the subset is an error that names it.\n//\n// `parse_doc` also keeps where each key and its value are, so a program that\n// checks the document (the project tool, MYLA-93) can point at them.\n\n// A TOML value. A table keeps its keys in the order they were defined (a\n// table that a header like `[a.b]` creates on the way counts from there).\npub enum Toml {\n    Str(str),\n    Int(int64),\n    Bool(bool),\n    Array([Toml]),\n    Table([(str, Toml)]),\n}\n\n// Why a text isn't in the subset, and where: line and column count from 1,\n// the column in characters.\npub struct TomlError {\n    msg: str,\n    line: int32,\n    col: int32,\n}\n\n// Where something is in the text: from `line`:`col` to just before\n// `end_line`:`end_col` (lines and columns count from 1, columns in\n// characters).\npub struct TomlPos {\n    line: int32,\n    col: int32,\n    end_line: int32,\n    end_col: int32,\n}\n\n// A parsed document: its table, and where each key path was defined (see\n// `key_pos` and `value_pos`).\npub struct TomlDoc {\n    root: Toml,\n    text: str,\n    // byte offsets of the key and of the value, by `path_key`\n    spans: [str: (int32, int32, int32, int32)],\n}\n\n// The value of `key` in the table `t`; None if `t` isn't a table or has no\n// such key.\npub fun field(t: Toml, key: str) -> Option<Toml> {\n    match t {\n        Toml.Table(members) => {\n            for m in members {\n                if m.0 == key { return Some(m.1) }\n            }\n        },\n        _ => {},\n    }\n    return None\n}\n\n// The table that `text` holds.\npub fun parse(text: str) -> Result<Toml, TomlError> {\n    let d = parse_doc(text)?\n    return Ok(d.root)\n}\n\n// The table that `text` holds, with the positions of its keys and values.\npub fun parse_doc(text: str) -> Result<TomlDoc, TomlError> {\n    var p = Parser { s: text, i: 0, root: Toml.Table([]), kinds: [:], table: [], spans: [:] }\n    p.document()?\n    return Ok(TomlDoc { root: p.root, text: text, spans: p.spans })\n}\n\n// Where the key of the key path `path` is: the key of a key/value pair (also\n// inside an inline table), or the header that opened the table (the first\n// header on the way to it, if none opened it). None if nothing defined it.\npub fun key_pos(d: TomlDoc, path: [str]) -> Option<TomlPos> {\n    return match get(d.spans, path_key(path)) {\n        Some(sp) => Some(pos_of(d.text, sp.0, sp.1))\n        None => None\n    }\n}\n\n// Where the value of the key path `path` is (for a table opened by a header,\n// the header).\npub fun value_pos(d: TomlDoc, path: [str]) -> Option<TomlPos> {\n    return match get(d.spans, path_key(path)) {\n        Some(sp) => Some(pos_of(d.text, sp.2, sp.3))\n        None => None\n    }\n}\n\nfun pos_of(text: str, start: int32, end: int32) -> TomlPos {\n    let (line, col) = line_col(text, start)\n    let (end_line, end_col) = line_col(text, end)\n    return TomlPos { line: line, col: col, end_line: end_line, end_col: end_col }\n}\n\n// The line and column of byte offset `at` in `s`.\nfun line_col(s: str, at: int32) -> (int32, int32) {\n    var line = 1\n    var col = 1\n    var k = 0\n    while k < at && k < s.len() {\n        let c = s[k]\n        if c == '\\n' {\n            line = line + 1\n            col = 1\n        } else if c < 128u8 || c >= 192u8 {\n            col = col + 1                  // not a UTF-8 continuation byte\n        }\n        k = k + 1\n    }\n    return (line, col)\n}\n\n// --- Parsing ------------------------------------------------------------------\n\n// What a key path names, so far: a table a header opened, a table a header\n// created on the way to another, or something closed (a value or an inline\n// table, which nothing may add to).\nconst OPENED: int32 = 1\nconst IMPLIED: int32 = 2\nconst CLOSED: int32 = 3\n\nstruct Parser {\n    s: str,\n    i: int32,\n    root: Toml,\n    // what each key path names (see `path_key`)\n    kinds: [str: int32],\n    // the path of the table that key/value lines go to\n    table: [str],\n    // where each key path was defined: the byte offsets of the key's start\n    // and end and of the value's (see `TomlDoc`)\n    spans: [str: (int32, int32, int32, int32)],\n}\n\n// One string for a key path, unambiguous whatever the keys hold.\nfun path_key(path: [str]) -> str {\n    var sb = StringBuilder()\n    for k in path {\n        sb.append(format(\"{}:\", k.len()))\n        sb.append(k)\n    }\n    return sb.build()\n}\n\nfun with_key(path: [str], key: str) -> [str] {\n    var out = path\n    out.push(key)\n    return out\n}\n\n// A key path as TOML writes it, for messages: keys that aren't bare quoted,\n// with '\"', '\\' and control characters escaped, so a message is one line.\nfun dotted(path: [str]) -> str {\n    var sb = StringBuilder()\n    for k in path {\n        if sb.len() > 0 { sb.append_byte('.') }\n        if is_bare_key(k) {\n            sb.append(k)\n        } else {\n            sb.append_byte('\"')\n            var i = 0\n            while i < k.len() {\n                let c = k[i]\n                if c == '\"' || c == '\\\\' {\n                    sb.append_byte('\\\\')\n                    sb.append_byte(c)\n                } else if is_control(c) || c == '\\t' {\n                    sb.append(format(\"\\\\u{}\", hex4(c as int32)))\n                } else {\n                    sb.append_byte(c)\n                }\n                i = i + 1\n            }\n            sb.append_byte('\"')\n        }\n    }\n    return sb.build()\n}\n\n// `n` (below 65536) as four hex digits.\nfun hex4(n: int32) -> str {\n    let digits = \"0123456789ABCDEF\"\n    var sb = StringBuilder()\n    var shift = 12\n    while shift >= 0 {\n        sb.append_byte(digits[(n >> shift) & 15])\n        shift = shift - 4\n    }\n    return sb.build()\n}\n\nfun is_bare_char(c: uint8) -> bool {\n    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-'\n}\n\nfun is_bare_key(k: str) -> bool {\n    if k.len() == 0 { return false }\n    var i = 0\n    while i < k.len() {\n        if !is_bare_char(k[i]) { return false }\n        i = i + 1\n    }\n    return true\n}\n\nfun is_digit(c: uint8) -> bool {\n    return c >= '0' && c <= '9'\n}\n\n// A control character TOML allows nowhere but in multi-line strings (tab is\n// allowed everywhere).\nfun is_control(c: uint8) -> bool {\n    return (c < 32u8 && c != '\\t') || c == 127u8\n}\n\n// `t` (a table) with `v` added as `key` to the table at `path[at..]` below it.\nfun insert(t: Toml, path: [str], at: int32, key: str, v: Toml) -> Toml {\n    match t {\n        Toml.Table(members) => {\n            var ms = members\n            if at == path.len() {\n                ms.push((key, v))\n                return Toml.Table(ms)\n            }\n            var k = 0\n            while k < ms.len() {\n                if ms[k].0 == path[at] {\n                    ms[k] = (path[at], insert(ms[k].1, path, at + 1, key, v))\n                    return Toml.Table(ms)\n                }\n                k = k + 1\n            }\n        },\n        _ => {},\n    }\n    return t\n}\n\nimpl Parser {\n    // An error at byte offset `at`.\n    fun error(self, msg: str, at: int32) -> TomlError {\n        let (line, col) = line_col(self.s, at)\n        return TomlError { msg: msg, line: line, col: col }\n    }\n\n    fun at_end(self) -> bool {\n        return self.i >= self.s.len()\n    }\n\n    // The byte at the current position, or 0 at the end.\n    fun peek(self) -> uint8 {\n        if self.at_end() { return 0u8 }\n        return self.s[self.i]\n    }\n\n    // The byte `k` places ahead, or 0 past the end.\n    fun ahead(self, k: int32) -> uint8 {\n        if self.i + k >= self.s.len() { return 0u8 }\n        return self.s[self.i + k]\n    }\n\n    fun skip_ws(var self) {\n        while self.peek() == ' ' || self.peek() == '\\t' { self.i = self.i + 1 }\n    }\n\n    // A comment, the current position at its \"#\"; up to the line's end.\n    fun comment(var self) -> Result<int32, TomlError> {\n        while !self.at_end() && self.peek() != '\\n' {\n            if self.peek() == 13u8 && self.ahead(1) == '\\n' { return Ok(0) }\n            if is_control(self.peek()) { return Err(self.error(\"control character in a comment\", self.i)) }\n            self.i = self.i + 1\n        }\n        return Ok(0)\n    }\n\n    // A line break (\"\\n\" or \"\\r\\n\") at the current position, if any.\n    fun newline(var self) -> Result<bool, TomlError> {\n        if self.peek() == '\\n' {\n            self.i = self.i + 1\n            return Ok(true)\n        }\n        if self.peek() == 13u8 {\n            if self.ahead(1) != '\\n' { return Err(self.error(\"a carriage return must be followed by a line feed\", self.i)) }\n            self.i = self.i + 2\n            return Ok(true)\n        }\n        return Ok(false)\n    }\n\n    // White space, comments and line breaks (inside an array).\n    fun skip_blank(var self) -> Result<int32, TomlError> {\n        while true {\n            self.skip_ws()\n            if self.peek() == '#' { self.comment()? }\n            if !self.newline()? { return Ok(0) }\n        }\n        return Ok(0)\n    }\n\n    // The rest of a line after a statement: white space and a comment.\n    fun end_of_line(var self) -> Result<int32, TomlError> {\n        self.skip_ws()\n        if self.peek() == '#' { self.comment()? }\n        if self.at_end() || self.newline()? { return Ok(0) }\n        return Err(self.error(\"expected the end of the line\", self.i))\n    }\n\n    fun document(var self) -> Result<int32, TomlError> {\n        while true {\n            self.skip_ws()\n            if self.at_end() { return Ok(0) }\n            let c = self.peek()\n            if c == '#' {\n                self.comment()?\n                self.end_of_line()?\n            } else if c == '\\n' || c == 13u8 {\n                self.newline()?\n            } else if c == '[' {\n                self.header()?\n                self.end_of_line()?\n            } else {\n                self.key_value()?\n                self.end_of_line()?\n            }\n        }\n        return Ok(0)\n    }\n\n    // A table header, the current position at its \"[\".\n    fun header(var self) -> Result<int32, TomlError> {\n        let start = self.i\n        if self.ahead(1) == '[' { return Err(self.error(\"arrays of tables are not supported\", start)) }\n        self.i = self.i + 1\n        var path: [str] = []\n        while true {\n            self.skip_ws()\n            path.push(self.key()?)\n            self.skip_ws()\n            if self.peek() == ']' {\n                self.i = self.i + 1\n                return self.open_table(path, start, self.i)\n            }\n            if self.peek() != '.' { return Err(self.error(\"expected '.' or ']' in a table header\", self.i)) }\n            self.i = self.i + 1\n        }\n        return Ok(0)\n    }\n\n    // Open the table `path` for the key/value lines that follow, creating the\n    // tables on the way; the header is the text from `at` to `end`.\n    fun open_table(var self, path: [str], at: int32, end: int32) -> Result<int32, TomlError> {\n        var prefix: [str] = []\n        var k = 0\n        while k < path.len() {\n            let parent = prefix\n            prefix = with_key(prefix, path[k])\n            let last = k == path.len() - 1\n            let pk = path_key(prefix)\n            match get(self.kinds, pk) {\n                Some(kind) => {\n                    if kind == CLOSED { return Err(self.error(format(\"'{}' is not a table that can be extended\", dotted(prefix)), at)) }\n                    if last {\n                        if kind == OPENED { return Err(self.error(format(\"table '{}' is defined twice\", dotted(prefix)), at)) }\n                        self.kinds[pk] = OPENED\n                        self.spans[pk] = (at, end, at, end)\n                    }\n                },\n                None => {\n                    self.root = insert(self.root, parent, 0, path[k], Toml.Table([]))\n                    self.kinds[pk] = match last { true => OPENED, false => IMPLIED }\n                    self.spans[pk] = (at, end, at, end)\n                },\n            }\n            k = k + 1\n        }\n        self.table = path\n        return Ok(0)\n    }\n\n    // A key/value line, the current position at the key.\n    fun key_value(var self) -> Result<int32, TomlError> {\n        let at = self.i\n        let (key, v) = self.pair(self.table)?\n        let path = with_key(self.table, key)\n        let pk = path_key(path)\n        if self.kinds.contains(pk) { return Err(self.error(format(\"'{}' is defined twice\", dotted(path)), at)) }\n        self.kinds[pk] = CLOSED\n        self.root = insert(self.root, self.table, 0, key, v)\n        return Ok(0)\n    }\n\n    // `key = value`, in the table `base` (whose path the spans record).\n    fun pair(var self, base: [str]) -> Result<(str, Toml), TomlError> {\n        let key_start = self.i\n        let key = self.key()?\n        let key_end = self.i\n        self.skip_ws()\n        if self.peek() == '.' { return Err(self.error(\"dotted keys are not supported\", self.i)) }\n        if self.peek() != '=' { return Err(self.error(\"expected '=' after a key\", self.i)) }\n        self.i = self.i + 1\n        self.skip_ws()\n        let path = with_key(base, key)\n        let value_start = self.i\n        let v = self.value(path)?\n        self.spans[path_key(path)] = (key_start, key_end, value_start, self.i)\n        return Ok((key, v))\n    }\n\n    fun key(var self) -> Result<str, TomlError> {\n        let c = self.peek()\n        if c == '\"' || c == '\\'' {\n            if self.ahead(1) == c && self.ahead(2) == c { return Err(self.error(\"a key can't be a multi-line string\", self.i)) }\n            if c == '\"' { return self.basic_string() }\n            return self.literal_string()\n        }\n        let start = self.i\n        while is_bare_char(self.peek()) { self.i = self.i + 1 }\n        if self.i == start { return Err(self.error(\"expected a key\", self.i)) }\n        var sb = StringBuilder()\n        sb.append(self.s, start, self.i)\n        return Ok(sb.build())\n    }\n\n    // A value, of the key path `path` (for the spans of an inline table's\n    // keys).\n    fun value(var self, path: [str]) -> Result<Toml, TomlError> {\n        let c = self.peek()\n        if c == '\"' || c == '\\'' {\n            if self.ahead(1) == c && self.ahead(2) == c { return Err(self.error(\"multi-line strings are not supported\", self.i)) }\n            if c == '\"' { return Ok(Toml.Str(self.basic_string()?)) }\n            return Ok(Toml.Str(self.literal_string()?))\n        }\n        if c == '[' { return self.array() }\n        if c == '{' { return self.inline_table(path) }\n        if self.word(\"true\") { return Ok(Toml.Bool(true)) }\n        if self.word(\"false\") { return Ok(Toml.Bool(false)) }\n        if self.word(\"inf\") || self.word(\"nan\") || self.word(\"+inf\") || self.word(\"-inf\") || self.word(\"+nan\") || self.word(\"-nan\") {\n            return Err(self.error(\"floats are not supported\", self.i))\n        }\n        if c == '+' || c == '-' || is_digit(c) { return self.number() }\n        return Err(self.error(\"expected a value\", self.i))\n    }\n\n    // Whether the text continues with `w`, not followed by a key character;\n    // moves past it if so (only for true and false).\n    fun word(var self, w: str) -> bool {\n        if self.i + w.len() > self.s.len() { return false }\n        var k = 0\n        while k < w.len() {\n            if self.s[self.i + k] != w[k] { return false }\n            k = k + 1\n        }\n        if is_bare_char(self.ahead(w.len())) { return false }\n        if w == \"true\" || w == \"false\" { self.i = self.i + w.len() }\n        return true\n    }\n\n    // A decimal integer; floats, dates and times, and other bases are named\n    // in the error.\n    fun number(var self) -> Result<Toml, TomlError> {\n        let start = self.i\n        var negative = false\n        if self.peek() == '+' || self.peek() == '-' {\n            negative = self.peek() == '-'\n            self.i = self.i + 1\n        }\n        let first = self.i\n        if self.peek() == '0' && (self.ahead(1) == 'x' || self.ahead(1) == 'o' || self.ahead(1) == 'b') {\n            return Err(self.error(\"hexadecimal, octal and binary integers are not supported\", start))\n        }\n        var digits = StringBuilder()\n        var last_digit = false\n        while is_digit(self.peek()) || self.peek() == '_' {\n            if self.peek() == '_' {\n                if !last_digit || !is_digit(self.ahead(1)) { return Err(self.error(\"'_' must stand between digits\", self.i)) }\n                last_digit = false\n            } else {\n                digits.append_byte(self.peek())\n                last_digit = true\n            }\n            self.i = self.i + 1\n        }\n        let c = self.peek()\n        if c == '.' || c == 'e' || c == 'E' { return Err(self.error(\"floats are not supported\", start)) }\n        if (c == '-' || c == ':') && self.i > first && start == first { return Err(self.error(\"dates and times are not supported\", start)) }\n        let text = digits.build()\n        if text.len() == 0 { return Err(self.error(\"expected a value\", start)) }\n        if text.len() > 1 && text[0] == '0' { return Err(self.error(\"leading zeros are not allowed\", first)) }\n        // accumulate negatively, so the int64 minimum fits\n        var n: int64 = 0\n        var k = 0\n        while k < text.len() {\n            let d = (text[k] - '0') as int64\n            if n < (-9223372036854775807i64 - 1i64 + d) / 10i64 { return Err(self.error(\"integer out of range\", start)) }\n            n = n * 10i64 - d\n            k = k + 1\n        }\n        if negative { return Ok(Toml.Int(n)) }\n        if n == -9223372036854775807i64 - 1i64 { return Err(self.error(\"integer out of range\", start)) }\n        return Ok(Toml.Int(-n))\n    }\n\n    // The value of the `count` hex digits at the current position, or -1.\n    fun hex(self, count: int32) -> int64 {\n        if self.i + count > self.s.len() { return -1i64 }\n        var v: int64 = 0\n        var k = 0\n        while k < count {\n            let c = self.s[self.i + k]\n            var d: int64 = -1\n            if c >= '0' && c <= '9' { d = (c - '0') as int64 }\n            if c >= 'a' && c <= 'f' { d = (c - 'a') as int64 + 10i64 }\n            if c >= 'A' && c <= 'F' { d = (c - 'A') as int64 + 10i64 }\n            if d < 0i64 { return -1i64 }\n            v = v * 16i64 + d\n            k = k + 1\n        }\n        return v\n    }\n\n    // A basic string, the current position at its opening quote.\n    fun basic_string(var self) -> Result<str, TomlError> {\n        let quote = self.i\n        self.i = self.i + 1\n        var sb = StringBuilder()\n        var run = self.i                         // start of bytes to copy as they are\n        while true {\n            if self.at_end() || self.peek() == '\\n' { return Err(self.error(\"unterminated string\", quote)) }\n            let c = self.peek()\n            if c == '\"' {\n                sb.append(self.s, run, self.i)\n                self.i = self.i + 1\n                return Ok(sb.build())\n            }\n            if is_control(c) { return Err(self.error(\"control character in a string\", self.i)) }\n            if c != '\\\\' {\n                self.i = self.i + 1\n            } else {\n                sb.append(self.s, run, self.i)\n                let esc = self.i\n                let e = self.ahead(1)\n                self.i = self.i + 2\n                if e == 'u' || e == 'U' {\n                    let count = match e == 'u' { true => 4, false => 8 }\n                    let cp = self.hex(count)\n                    if cp < 0i64 || (cp >= 55296i64 && cp < 57344i64) || cp > 1114111i64 {\n                        return Err(self.error(\"invalid unicode escape\", esc))\n                    }\n                    sb.append(format(\"{}\", cp as uint32 as char))\n                    self.i = self.i + count\n                } else if e == '\"' { sb.append_byte('\"') }\n                else if e == '\\\\' { sb.append_byte('\\\\') }\n                else if e == 'b' { sb.append_byte(8u8) }\n                else if e == 'f' { sb.append_byte(12u8) }\n                else if e == 'n' { sb.append_byte('\\n') }\n                else if e == 'r' { sb.append_byte(13u8) }\n                else if e == 't' { sb.append_byte('\\t') }\n                else { return Err(self.error(\"invalid escape in a string\", esc)) }\n                run = self.i\n            }\n        }\n        return Ok(\"\")\n    }\n\n    // A literal string, the current position at its opening quote.\n    fun literal_string(var self) -> Result<str, TomlError> {\n        let quote = self.i\n        self.i = self.i + 1\n        let start = self.i\n        while true {\n            if self.at_end() || self.peek() == '\\n' { return Err(self.error(\"unterminated string\", quote)) }\n            let c = self.peek()\n            if c == '\\'' {\n                var sb = StringBuilder()\n                sb.append(self.s, start, self.i)\n                self.i = self.i + 1\n                return Ok(sb.build())\n            }\n            if is_control(c) { return Err(self.error(\"control character in a string\", self.i)) }\n            self.i = self.i + 1\n        }\n        return Ok(\"\")\n    }\n\n    // An array of strings, the current position at its \"[\".\n    fun array(var self) -> Result<Toml, TomlError> {\n        self.i = self.i + 1\n        var items: [Toml] = []\n        while true {\n            self.skip_blank()?\n            if self.peek() == ']' {\n                self.i = self.i + 1\n                return Ok(Toml.Array(items))\n            }\n            let c = self.peek()\n            if c != '\"' && c != '\\'' {\n                if c == ',' || self.at_end() { return Err(self.error(\"expected a value\", self.i)) }\n                return Err(self.error(\"arrays may only hold strings\", self.i))\n            }\n            items.push(self.value([])?)\n            self.skip_blank()?\n            if self.peek() == ',' {\n                self.i = self.i + 1\n            } else if self.peek() != ']' {\n                return Err(self.error(\"expected ',' or ']' in an array\", self.i))\n            }\n        }\n        return Ok(Toml.Array(items))\n    }\n\n    // An inline table, the value of `path`, the current position at its \"{\".\n    fun inline_table(var self, path: [str]) -> Result<Toml, TomlError> {\n        self.i = self.i + 1\n        var members: [(str, Toml)] = []\n        self.skip_ws()\n        if self.peek() == '}' {\n            self.i = self.i + 1\n            return Ok(Toml.Table(members))\n        }\n        while true {\n            self.skip_ws()\n            let at = self.i\n            if self.peek() == '}' { return Err(self.error(\"a trailing comma is not allowed in an inline table\", at)) }\n            let (key, v) = self.pair(path)?\n            for m in members {\n                if m.0 == key { return Err(self.error(format(\"'{}' is defined twice\", dotted([key])), at)) }\n            }\n            members.push((key, v))\n            self.skip_ws()\n            if self.peek() == '}' {\n                self.i = self.i + 1\n                return Ok(Toml.Table(members))\n            }\n            if self.peek() != ',' { return Err(self.error(\"expected ',' or '}' in an inline table\", self.i)) }\n            self.i = self.i + 1\n        }\n        return Ok(Toml.Table(members))\n    }\n}\n"
}
