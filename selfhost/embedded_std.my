c = c.wrapping_add(a ^ (b & (d ^ a))).wrapping_add(0xf4d50d87u32).wrapping_add(m3)\n        t = c >> 18u32; c = ((c << 14u32) | t).wrapping_add(d)\n        b = b.wrapping_add(d ^ (a & (c ^ d))).wrapping_add(0x455a14edu32).wrapping_add(m8)\n        t = b >> 12u32; b = ((b << 20u32) | t).wrapping_add(c)\n        a = a.wrapping_add(c ^ (d & (b ^ c))).wrapping_add(0xa9e3e905u32).wrapping_add(m13)\n        t = a >> 27u32; a = ((a << 5u32) | t).wrapping_add(b)\n        d = d.wrapping_add(b ^ (c & (a ^ b))).wrapping_add(0xfcefa3f8u32).wrapping_add(m2)\n        t = d >> 23u32; d = ((d << 9u32) | t).wrapping_add(a)\n        c = c.wrapping_add(a ^ (b & (d ^ a))).wrapping_add(0x676f02d9u32).wrapping_add(m7)\n        t = c >> 18u32; c = ((c << 14u32) | t).wrapping_add(d)\n        b = b.wrapping_add(d ^ (a & (c ^ d))).wrapping_add(0x8d2a4c8au32).wrapping_add(m12)\n        t = b >> 12u32; b = ((b << 20u32) | t).wrapping_add(c)\n        // round 3\n        a = a.wrapping_add(b ^ c ^ d).wrapping_add(0xfffa3942u32).wrapping_add(m5)\n        t = a >> 28u32; a = ((a << 4u32) | t).wrapping_add(b)\n        d = d.wrapping_add(a ^ b ^ c).wrapping_add(0x8771f681u32).wrapping_add(m8)\n        t = d >> 21u32; d = ((d << 11u32) | t).wrapping_add(a)\n        c = c.wrapping_add(d ^ a ^ b).wrapping_add(0x6d9d6122u32).wrapping_add(m11)\n        t = c >> 16u32; c = ((c << 16u32) | t).wrapping_add(d)\n        b = b.wrapping_add(c ^ d ^ a).wrapping_add(0xfde5380cu32).wrapping_add(m14)\n        t = b >> 9u32; b = ((b << 23u32) | t).wrapping_add(c)\n        a = a.wrapping_add(b ^ c ^ d).wrapping_add(0xa4beea44u32).wrapping_add(m1)\n        t = a >> 28u32; a = ((a << 4u32) | t).wrapping_add(b)\n        d = d.wrapping_add(a ^ b ^ c).wrapping_add(0x4bdecfa9u32).wrapping_add(m4)\n        t = d >> 21u32; d = ((d << 11u32) | t).wrapping_add(a)\n        c = c.wrapping_add(d ^ a ^ b).wrapping_add(0xf6bb4b60u32).wrapping_add(m7)\n        t = c >> 16u32; c = ((c << 16u32) | t).wrapping_add(d)\n        b = b.wra