n#test(\"\\\\x41\\\\x{42}\", \"zAB\")[\"1-3\"]\n#test(\"\\\\101\", \"A\")[\"0-1\"]\n#test(\"\\\\t\\\\n\", \"a\\t\\nb\")[\"1-3\"]\n#test(\"\\\\a\\\\f\\\\v\\\\r\", \"\\u{7}\\u{c}\\u{b}\\r\")[\"0-4\"]\n#test(\"\\\\*\\\\+\\\\?\\\\(\\\\)\\\\[\\\\]\\\\{\\\\}\\\\|\\\\^\\\\$\\\\\\\\\", \"*+?()[]{}|^$\\\\\")[\"0-13\"]\n#test(\"a{\", \"a{\")[\"0-2\"]\n#test(\"a{,3}\", \"a{,3}\")[\"0-5\"]\n#test(\"a{x}\", \"a{x}\")[\"0-4\"]\n#test(\"a.c\", \"abc\")[\"0-3\"]\n#test(\"a.c\", \"a\\nc\")[\"-\"]\n#test(\"(?s)a.c\", \"a\\nc\")[\"0-3\"]\n#test(\"(?s:.).\", \"\\n\\n\")[\"-\"]\n#test(\".*\", \"ab\\ncd\")[\"0-2\"]\n#test(\"(?s).*\", \"ab\\ncd\")[\"0-5\"]\n#test(\"[abc]+\", \"xxcabz\")[\"2-5\"]\n#test(\"[a-c]+\", \"dcbad\")[\"1-4\"]\n#test(\"[^a-c]+\", \"abcxyzabc\")[\"3-6\"]\n#test(\"[a-]+\", \"x-a-b\")[\"1-4\"]\n#test(\"[-a]+\", \"x-a-b\")[\"1-4\"]\n#test(\"[]a]+\", \"x]a]\")[\"1-4\"]\n#test(\"[^]a]+\", \"]]xy]\")[\"2-4\"]\n#test(\"[a\\\\-z]+\", \"b-az\")[\"1-4\"]\n#test(\"[\\\\d.]+\", \"v1.25x\")[\"1-5\"]\n#test(\"[\\\\w-]+\", \"..foo-bar..\")[\"2-9\"]\n#test(\"[^\\\\s]+\", \"  ab  \")[\"2-4\"]\n#test(\"[\\\\x41-\\\\x43]+\", \"ABCD\")[\"0-3\"]\n#test(\"[\\\\]]\", \"a]\")[\"1-2\"]\n#test(\"[\\\\\\\\]\", \"a\\\\\")[\"1-2\"]\n#test(\"[.]\", \"a.b\")[\"1-2\"]\n#test(\"[*+?]+\", \"a*+?b\")[\"1-4\"]\n#test(\"[\\\\^a]+\", \"^a^\")[\"0-3\"]\n#test(\"[a^]+\", \"^a^\")[\"0-3\"]\n#test(\"\\\\d+\", \"abc 123 def\")[\"4-7\"]\n#test(\"\\\\D+\", \"123abc456\")[\"3-6\"]\n#test(\"\\\\w+\", \"  foo_bar9 \")[\"2-10\"]\n#test(\"\\\\W+\", \"ab, cd\")[\"2-4\"]\n#test(\"\\\\s+\", \"a \\t\\n\\r\\u{c}b\")[\"1-6\"]\n#test(\"\\\\S+\", \"  ab  \")[\"2-4\"]\n#test(\"\\\\s\", \"\\u{b}\")[\"-\"]\n#test(\"[[:alpha:]]+\", \"12abC34\")[\"2-5\"]\n#test(\"[[:digit:]]+\", \"ab123c\")[\"2-5\"]\n#test(\"[[:alnum:]]+\", \"--ab12--\")[\"2-6\"]\n#test(\"[[:space:]]+\", \"a \\t\\u{b}\\u{c}b\")[\"1-5\"]\n#test(\"[[:upper:]]+\", \"abCDe\")[\"2-4\"]\n#test(\"[[:lower:]]+\", \"ABcdE\")[\"2-4\"]\n#test(\"[[:punct:]]+\", \"ab!?.,cd\