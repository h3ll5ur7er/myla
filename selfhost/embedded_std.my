 (e ^ f))).wrapping_add(0x78a5636fu32).wrapping_add(w9)\n        c = c.wrapping_add(g)\n        x = h as uint64; x = (x << 32u64) | x; y = x >> 2u64; y = (x >> 13u64) ^ y; y = (x >> 22u64) ^ y; t = y as uint32; g = g.wrapping_add(t)\n        t = h | a; t = (b & t) | (h & a); g = g.wrapping_add(t)\n        x = w8 as uint64; x = (x << 32u64) | x; y = x >> 17u64; y = (x >> 19u64) ^ y; t = (w8 >> 10u32) ^ (y as uint32); w10 = w10.wrapping_add(t).wrapping_add(w3)\n        x = w11 as uint64; x = (x << 32u64) | x; y = x >> 7u64; y = (x >> 18u64) ^ y; t = (w11 >> 3u32) ^ (y as uint32); w10 = w10.wrapping_add(t)\n        x = c as uint64; x = (x << 32u64) | x; y = x >> 6u64; y = (x >> 11u64) ^ y; y = (x >> 25u64) ^ y; t = y as uint32\n        f = f.wrapping_add(t).wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x84c87814u32).wrapping_add(w10)\n        b = b.wrapping_add(f)\n        x = g as uint64; x = (x << 32u64) | x; y = x >> 2u64; y = (x >> 13u64) ^ y; y = (x >> 22u64) ^ y; t = y as uint32; f = f.wrapping_add(t)\n        t = g | h; t = (a & t) | (g & h); f = f.wrapping_add(t)\n        x = w9 as uint64; x = (x << 32u64) | x; y = x >> 17u64; y = (x >> 19u64) ^ y; t = (w9 >> 10u32) ^ (y as uint32); w11 = w11.wrapping_add(t).wrapping_add(w4)\n        x = w12 as uint64; x = (x << 32u64) | x; y = x >> 7u64; y = (x >> 18u64) ^ y; t = (w12 >> 3u32) ^ (y as uint32); w11 = w11.wrapping_add(t)\n        x = b as uint64; x = (x << 32u64) | x; y = x >> 6u64; y = (x >> 11u64) ^ y; y = (x >> 25u64) ^ y; t = y as uint32\n        e = e.wrapping_add(t).wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x8cc70208u32).wrapping_add(w11)\n        a = a.wrapping_add(e)\n        x = f as uint64; x = (x << 32u64) | x; y = x >> 2u64; y = (x >> 13u64) ^ y; y = (x >> 22u64) ^ y; t = y as uint32; e = e.wrapping_add(t)\n        t = f | g; t = (h & t) | (f & g); e = e.wrapping_add(t)\n        x = w10 as uint64; x = (x << 32u64) | x; y = x >> 17u64; y = (x >> 19u64) ^ y; t = (w10 >> 10u32) ^ (y as uint32); w12 = w12.wrapping_add(t).wrapping_add(w5)\n        x = w13 as uint64; x = (x << 32u64) | x; y = x >> 7u64; y = (x >> 18u64) ^ y; t = (w13 >> 3u32) ^ (y as uint32); w12 = w12.wrapping_add(t)\n        x = a as uint64; x = (x << 32u64) | x; y = x >> 6u64; y = (x >> 11u64) ^ y; y = (x >> 25u64) ^ y; t = y as uint32\n        d = d.wrapping_add(t).wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x90befffau32).wrapping_add(w12)\n        h = h.wrapping_add(d)\n        x = e as uint64; x = (x << 32u64) | x; y = x >> 2u64; y = (x >> 13u64) ^ y; y = (x >> 22u64) ^ y; t = y as uint32; d = d.wrapping_add(t)\n        t = e | f; t = (g & t) | (e & f); d = d.wrapping_add(t)\n        x = w11 as uint64; x = (x << 32u64) | x; y = x >> 17u64; y = (x >> 19u64) ^ y; t = (w11 >> 10u32) ^ (y as uint32); w13 = w13.wrapping_add(t).wrapping_add(w6)\n        x = w14 as uint64; x = (x << 32u64) | x; y = x >> 7u64; y = (x >> 18u64) ^ y; t = (w14 >> 3u32) ^ (y as uint32); w13 = w13.wrapping_add(t)\n        x = h as uint64; x = (x << 32u64) | x; y = x >> 6u64; y = (x >> 11u64) ^ y; y = (x >> 25u64) ^ y; t = y as uint32\n        c = c.wrapping_add(t).wrapping_add(b ^ (h & (a ^ b))).wrapping_add(0xa4506cebu32).wrapping_add(w13)\n        g = g.wrapping_add(c)\n        x = d as uint64; x = (x << 32u64) | x; y = x >> 2u64; y = (x >> 13u64) ^ y; y = (x >> 22u64) ^ y; t = y as uint32; c = c.wrapping_add(t)\n        t = d | e; t = (f & t) | (d & e); c = c.wrapping_add(t)\n        x = w12 as uint64; x = (x << 32u64) | x; y = x >> 17u64; y = (x >> 19u64) ^ y; t = (w12 >> 10u32) ^ (y as uint32); w14 = w14.wrapping_add(t).wrapping_add(w7)\n        x = w15 as uint64; x = (x << 32u64) | x; y = x >> 7u64; y = (x >> 18u64) ^ y; t = (w15 >> 3u32) ^ (y as uint32); w14 = w14.wrapping_add(t)\n        x = g as uint64; x = (x << 32u64) | x; y = x >> 6u64; y = (x >> 11u64) ^ y; y = (x >> 25u64) ^ y; t = y as uint32\n        b = b.wrapping_add(t).wrapping_add(a ^ (g & (h ^ a))).wrapping_add(0xbef9a3f7u32).wrapping_add(w14)\n        f = f.wrapping_add(b)\n        x = c as uint64; x = (x << 32u64) | x; y = x >> 2u64; y = (x >> 13u64) ^ y; y = (x >> 22u64) ^ y; t = y as uint32; b = b.wrapping_add(t)\n        t = c | d; t = (e & t) | (c & d); b = b.wrapping_add(t)\n        x = w13 as uint64; x = (x << 32u64) | x; y = x >> 17u64; y = (x >> 19u64) ^ y; t = (w13 >> 10u32) ^ (y as uint32); w15 = w15.wrapping_add(t).wrapping_add(w8)\n        x = w0 as uint64; x = (x << 32u64) | x; y = x >> 7u64; y = (x >> 18u64) ^ y; t = (w0 >> 3u32) ^ (y as uint32); w15 = w15.wrapping_add(t)\n        x = f as uint64; x = (x << 32u64) | x; y = x >> 6u64; y = (x >> 11u64) ^ y; y = (x >> 25u64) ^ y; t = y as uint32\n        a = a.wrapping_add(t).wrapping_add(h ^ (f & (g ^ h))).wrapping_add(0xc67178f2u32).wrapping_add(w15)\n        e = e.wrapping_add(a)\n        x = b as uint64; x = (x << 32u64) | x; y = x >> 2u64; y = (x >> 13u64) ^ y; y = (x >> 22u64) ^ y; t = y as uint32; a = a.wrapping_add(t)\n        t = b | c; t = (d & t) | (b & c); a = a.wrapping_add(t)\n        self.a = self.a.wrapping_add(a)\n        self.b = self.b.wrapping_add(b)\n        self.c = self.c.wrapping_add(c)\n        self.d = self.d.wrapping_add(d)\n        self.e = self.e.wrapping_add(e)\n        self.f = self.f.wrapping_add(f)\n        self.g = self.g.wrapping_add(g)\n        self.h = self.h.wrapping_add(h)\n    }\n\n    fun close(var self) {\n        if self.blk.pad() {\n            self.compress()\n            self.blk.clear()\n        }\n        self.blk.put_length()\n        self.compress()\n    }\n\n    fun bytes(self) -> [uint8] {\n        return be_bytes([self.a, self.b, self.c, self.d, self.e, self.f, self.g, self.h], self.words)\n    }\n\n    fun hex(self) -> str {\n        var x = new_hex()\n        x.be32(self.a)\n        x.be32(self.b)\n        x.be32(self.c)\n        x.be32(self.d)\n        x.be32(self.e)\n        x.be32(self.f)\n        x.be32(self.g)\n        if self.words == 8 {\n            x.be32(self.h)\n        }\n        return x.sb.build()\n    }\n}\n\nimpl Digest for Sha256 {\n    fun update(var self, data: [uint8]) {\n        var i = 0\n        while i < data.len() {\n            i = self.blk.fill(data, i)\n            if self.blk.used == 64 {\n                self.compress()\n                self.blk.used = 0\n            }\n        }\n    }\n\n    #test(new_sha256())[[0xe3u8, 0xb0u8, 0xc4u8, 0x42u8, 0x98u8, 0xfcu8, 0x1cu8, 0x14u8, 0x9au8, 0xfbu8, 0xf4u8, 0xc8u8, 0x99u8, 0x6fu8, 0xb9u8, 0x24u8, 0x27u8, 0xaeu8, 0x41u8, 0xe4u8, 0x64u8, 0x9bu8, 0x93u8, 0x4cu8, 0xa4u8, 0x95u8, 0x99u8, 0x1bu8, 0x78u8, 0x52u8, 0xb8u8, 0x55u8]]\n    #test(new_sha224())[[0xd1u8, 0x4au8, 0x02u8, 0x8cu8, 0x2au8, 0x3au8, 0x2bu8, 0xc9u8, 0x47u8, 0x61u8, 0x02u8, 0xbbu8, 0x28u8, 0x82u8, 0x34u8, 0xc4u8, 0x15u8, 0xa2u8, 0xb0u8, 0x1fu8, 0x82u8, 0x8eu8, 0xa6u8, 0x2au8, 0xc5u8, 0xb3u8, 0xe4u8, 0x2fu8]]\n    fun finish(self) -> [uint8] {\n        var h = self\n        h.close()\n        return h.bytes()\n    }\n\n    #test(new_sha256())[64]\n    fun block_size(self) -> int {\n        return 64\n    }\n}\n\n// The SHA-256 digest of `data`, 32 bytes.\n#test([97u8, 98u8, 99u8])[[0xbau8, 0x78u8, 0x16u8, 0xbfu8, 0x8fu8, 0x01u8, 0xcfu8, 0xeau8, 0x41u8, 0x41u8, 0x40u8, 0xdeu8, 0x5du8, 0xaeu8, 0x22u8, 0x23u8, 0xb0u8, 0x03u8, 0x61u8, 0xa3u8, 0x96u8, 0x17u8, 0x7au8, 0x9cu8, 0xb4u8, 0x10u8, 0xffu8, 0x61u8, 0xf2u8, 0x00u8, 0x15u8, 0xadu8]]\npub fun sha256(data: [uint8]) -> [uint8] {\n    var h = new_sha256()\n    h.update(data)\n    h.close()\n    return h.bytes()\n}\n\n#test(\"\")[\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"]\n#test(\"abc\")[\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]\n#test(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")[\"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1\"] // 448 bits\n#test(\"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu\")[\"cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1\"] // 896 bits\npub fun sha256_hex(s: str) -> str {\n    var h = new_sha256()\n    h.update_str(s)\n    h.close()\n    return h.hex()\n}\n\n// The SHA-224 digest of `data`, 28 bytes.\n#test([97u8, 98u8, 99u8])[[0x23u8, 0x09u8, 0x7du8, 0x22u8, 0x34u8, 0x05u8, 0xd8u8, 0x22u8, 0x86u8, 0x42u8, 0xa4u8, 0x77u8, 0xbdu8, 0xa2u8, 0x55u8, 0xb3u8, 0x2au8, 0xadu8, 0xbcu8, 0xe4u8, 0xbdu8, 0xa0u8, 0xb3u8, 0xf7u8, 0xe3u8, 0x6cu8, 0x9du8, 0xa7u8]]\npub fun sha224(data: [uint8]) -> [uint8] {\n    var h = new_sha224()\n    h.update(data)\n    h.close()\n    return h.bytes()\n}\n\n#test(\"abc\")[\"23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7\"]\n#test(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")[\"75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525\"] // 448 bits\npub fun sha224_hex(s: str) -> str {\n    var h = new_sha224()\n    h.update_str(s)\n    h.close()\n    return h.hex()\n}\n\n// ---- SHA-512 and SHA-384 (FIPS 180-4, 6.4 and 6.5)\n\n// The functions of FIPS 180-4, 4.1.3, that SHA-512's rounds call: Σ0, Σ1,\n// σ0 (g0), σ1 (g1) and Maj, a rotation as two shifts.\nfun sha512_s0(a: uint64) -> uint64 {\n    var r = a << 36u64\n    r = (a >> 28u64) | r\n    var s = a << 30u64\n    s = (a >> 34u64) | s\n    r = r ^ s\n    s = a << 25u64\n    s = (a >> 39u64) | s\n    return r ^ s\n}\n\nfun sha512_s1(e: uint64) -> uint64 {\n    var r = e << 50u64\n    r = (e >> 14u64) | r\n    var s = e << 46u64\n    s = (e >> 18u64) | s\n    r = r ^ s\n    s = e << 23u64\n    s = (e >> 41u64) | s\n    return r ^ s\n}\n\nfun sha512_g0(w: uint64) -> uint64 {\n    var r = w << 63u64\n    r = (w >> 1u64) | r\n    var s = w << 56u64\n    s = (w >> 8u64) | s\n    r = r ^ s\n    return (w >> 7u64) ^ r\n}\n\nfun sha512_g1(w: uint64) -> uint64 {\n    var r = w << 45u64\n    r = (w >> 19u64) | r\n    var s = w << 3u64\n    s = (w >> 61u64) | s\n    r = r ^ s\n    return (w >> 6u64) ^ r\n}\n\nfun sha512_maj(a: uint64, b: uint64, c: uint64) -> uint64 {\n    var t = a | b\n    t = c & t\n    return (a & b) | t\n}\n\n// SHA-512, or SHA-384 (other initial values, 6 words of output).\npub struct Sha512 {\n    blk: Block64,\n    a: uint64,\n    b: uint64,\n    c: uint64,\n    d: uint64,\n    e: uint64,\n    f: uint64,\n    g: uint64,\n    h: uint64,\n    words: int,\n}\n\npub fun new_sha512() -> Sha512 {\n    return Sha512 {\n        blk: new_block64(),\n        a: 0x6a09e667f3bcc908, b: 0xbb67ae8584caa73b, c: 0x3c6ef372fe94f82b, d: 0xa54ff53a5f1d36f1,\n        e: 0x510e527fade682d1, f: 0x9b05688c2b3e6c1f, g: 0x1f83d9abfb41bd6b, h: 0x5be0cd19137e2179,\n        words: 8,\n    }\n}\n\npub fun new_sha384() -> Sha512 {\n    return Sha512 {\n        blk: new_block64(),\n        a: 0xcbbb9d5dc1059ed8, b: 0x629a292a367cd507, c: 0x9159015a3070dd17, d: 0x152fecd8f70e5939,\n        e: 0x67332667ffc00b31, f: 0x8eb44a8768581511, g: 0xdb0c2e0d64f98fa7, h: 0x47b5481dbefa4fa4,\n        words: 6,\n    }\n}\n\nimpl Sha512 {\n    fun update_str(var self, s: str) {\n        var i = 0\n        while i < s.len() {\n            i = self.blk.fill_str(s, i)\n            if self.blk.used == 128 {\n                self.compress()\n                self.blk.used = 0\n            }\n        }\n    }\n\n    #test(new_sha512())[\"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e\"]\n    #test(new_sha384())[\"38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b\"]\n    fun finish_hex(self) -> str {\n        var h = self\n        h.close()\n        return h.hex()\n    }\n\n    fun compress(var self) {\n        let w = self.blk.w\n        var w0 = w[0]\n        var w1 = w[1]\n        var w2 = w[2]\n        var w3 = w[3]\n        var w4 = w[4]\n        var w5 = w[5]\n        var w6 = w[6]\n        var w7 = w[7]\n        var w8 = w[8]\n        var w9 = w[9]\n        var w10 = w[10]\n        var w11 = w[11]\n        var w12 = w[12]\n        var w13 = w[13]\n        var w14 = w[14]\n        var w15 = w[15]\n        var a = self.a\n        var b = self.b\n        var c = self.c\n        var d = self.d\n        var e = self.e\n        var f = self.f\n        var g = self.g\n        var h = self.h\n        // SHA-256's rounds, with SHA-512's functions\n        h = h.wrapping_add(sha512_s1(e))\n        h = h.wrapping_add(g ^ (e & (f ^ g))).wrapping_add(0x428a2f98d728ae22u64).wrapping_add(w0)\n        d = d.wrapping_add(h)\n        h = h.wrapping_add(sha512_s0(a))\n        h = h.wrapping_add(sha512_maj(a, b, c))\n        g = g.wrapping_add(sha512_s1(d))\n        g = g.wrapping_add(f ^ (d & (e ^ f))).wrapping_add(0x7137449123ef65cdu64).wrapping_add(w1)\n        c = c.wrapping_add(g)\n        g = g.wrapping_add(sha512_s0(h))\n        g = g.wrapping_add(sha512_maj(h, a, b))\n        f = f.wrapping_add(sha512_s1(c))\n        f = f.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0xb5c0fbcfec4d3b2fu64).wrapping_add(w2)\n        b = b.wrapping_add(f)\n        f = f.wrapping_add(sha512_s0(g))\n        f = f.wrapping_add(sha512_maj(g, h, a))\n        e = e.wrapping_add(sha512_s1(b))\n        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0xe9b5dba58189dbbcu64).wrapping_add(w3)\n        a = a.wrapping_add(e)\n        e = e.wrapping_add(sha512_s0(f))\n        e = e.wrapping_add(sha512_maj(f, g, h))\n        d = d.wrapping_add(sha512_s1(a))\n        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x3956c25bf348b538u64).wrapping_add(w4)\n        h = h.wrapping_add(d)\n        d = d.wrapping_add(sha512_s0(e))\n        d = d.wrapping_add(sha512_maj(e, f, g))\n        c = c.wrapping_add(sha512_s1(h))\n        c = c.wrapping_add(b ^ (h & (a ^ b))).wrapping_add(0x59f111f1b605d019u64).wrapping_add(w5)\n        g = g.wrapping_add(c)\n        c = c.wrapping_add(sha512_s0(d))\n        c = c.wrapping_add(sha512_maj(d, e, f))\n        b = b.wrapping_add(sha512_s1(g))\n        b = b.wrapping_add(a ^ (g & (h ^ a))).wrapping_add(0x923f82a4af194f9bu64).wrapping_add(w6)\n        f = f.wrapping_add(b)\n        b = b.wrapping_add(sha512_s0(c))\n        b = b.wrapping_add(sha512_maj(c, d, e))\n        a = a.wrapping_add(sha512_s1(f))\n        a = a.wrapping_add(h ^ (f & (g ^ h))).wrapping_add(0xab1c5ed5da6d8118u64).wrapping_add(w7)\n        e = e.wrapping_add(a)\n        a = a.wrapping_add(sha512_s0(b))\n        a = a.wrapping_add(sha512_maj(b, c, d))\n        h = h.wrapping_add(sha512_s1(e))\n        h = h.wrapping_add(g ^ (e & (f ^ g))).wrapping_add(0xd807aa98a3030242u64).wrapping_add(w8)\n        d = d.wrapping_add(h)\n        h = h.wrapping_add(sha512_s0(a))\n        h = h.wrapping_add(sha512_maj(a, b, c))\n        g = g.wrapping_add(sha512_s1(d))\n        g = g.wrapping_add(f ^ (d & (e ^ f))).wrapping_add(0x12835b0145706fbeu64).wrapping_add(w9)\n        c = c.wrapping_add(g)\n        g = g.wrapping_add(sha512_s0(h))\n        g = g.wrapping_add(sha512_maj(h, a, b))\n        f = f.wrapping_add(sha512_s1(c))\n        f = f.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x243185be4ee4b28cu64).wrapping_add(w10)\n        b = b.wrapping_add(f)\n        f = f.wrapping_add(sha512_s0(g))\n        f = f.wrapping_add(sha512_maj(g, h, a))\n        e = e.wrapping_add(sha512_s1(b))\n        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x550c7dc3d5ffb4e2u64).wrapping_add(w11)\n        a = a.wrapping_add(e)\n        e = e.wrapping_add(sha512_s0(f))\n        e = e.wrapping_add(sha512_maj(f, g, h))\n        d = d.wrapping_add(sha512_s1(a))\n        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x72be5d74f27b896fu64).wrapping_add(w12)\n        h = h.wrapping_add(d)\n        d = d.wrapping_add(sha512_s0(e))\n        d = d.wrapping_add(sha512_maj(e, f, g))\n        c = c.wrapping_add(sha512_s1(h))\n        c = c.wrapping_add(b ^ (h & (a ^ b))).wrapping_add(0x80deb1fe3b1696b1u64).wrapping_add(w13)\n        g = g.wrapping_add(c)\n        c = c.wrapping_add(sha512_s0(d))\n        c = c.wrapping_add(sha512_maj(d, e, f))\n        b = b.wrapping_add(sha512_s1(g))\n        b = b.wrapping_add(a ^ (g & (h ^ a))).wrapping_add(0x9bdc06a725c71235u64).wrapping_add(w14)\n        f = f.wrapping_add(b)\n        b = b.wrapping_add(sha512_s0(c))\n        b = b.wrapping_add(sha512_maj(c, d, e))\n        a = a.wrapping_add(sha512_s1(f))\n        a = a.wrapping_add(h ^ (f & (g ^ h))).wrapping_add(0xc19bf174cf692694u64).wrapping_add(w15)\n        e = e.wrapping_add(a)\n        a = a.wrapping_add(sha512_s0(b))\n        a = a.wrapping_add(sha512_maj(b, c, d))\n        w0 = w0.wrapping_add(sha512_g1(w14))\n        w0 = w0.wrapping_add(w9)\n        w0 = w0.wrapping_add(sha512_g0(w1))\n        h = h.wrapping_add(sha512_s1(e))\n        h = h.wrapping_add(g ^ (e & (f ^ g))).wrapping_add(0xe49b69c19ef14ad2u64).wrapping_add(w0)\n        d = d.wrapping_add(h)\n        h = h.wrapping_add(sha512_s0(a))\n        h = h.wrapping_add(sha512_maj(a, b, c))\n        w1 = w1.wrapping_add(sha512_g1(w15))\n        w1 = w1.wrapping_add(w10)\n        w1 = w1.wrapping_add(sha512_g0(w2))\n        g = g.wrapping_add(sha512_s1(d))\n        g = g.wrapping_add(f ^ (d & (e ^ f))).wrapping_add(0xefbe4786384f25e3u64).wrapping_add(w1)\n        c = c.wrapping_add(g)\n        g = g.wrapping_add(sha512_s0(h))\n        g = g.wrapping_add(sha512_maj(h, a, b))\n        w2 = w2.wrapping_add(sha512_g1(w0))\n        w2 = w2.wrapping_add(w11)\n        w2 = w2.wrapping_add(sha512_g0(w3))\n        f = f.wrapping_add(sha512_s1(c))\n        f = f.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x0fc19dc68b8cd5b5u64).wrapping_add(w2)\n        b = b.wrapping_add(f)\n        f = f.wrapping_add(sha512_s0(g))\n        f = f.wrapping_add(sha512_maj(g, h, a))\n        w3 = w3.wrapping_add(sha512_g1(w1))\n        w3 = w3.wrapping_add(w12)\n        w3 = w3.wrapping_add(sha512_g0(w4))\n        e = e.wrapping_add(sha512_s1(b))\n        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x240ca1cc77ac9c65u64).wrapping_add(w3)\n        a = a.wrapping_add(e)\n        e = e.wrapping_add(sha512_s0(f))\n        e = e.wrapping_add(sha512_maj(f, g, h))\n        w4 = w4.wrapping_add(sha512_g1(w2))\n        w4 = w4.wrapping_add(w13)\n        w4 = w4.wrapping_add(sha512_g0(w5))\n        d = d.wrapping_add(sha512_s1(a))\n        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x2de92c6f592b0275u64).wrapping_add(w4)\n        h = h.wrapping_add(d)\n        d = d.wrapping_add(sha512_s0(e))\n        d = d.wrapping_add(sha512_maj(e, f, g))\n        w5 = w5.wrapping_add(sha512_g1(w3))\n        w5 = w5.wrapping_add(w14)\n        w5 = w5.wrapping_add(sha512_g0(w6))\n        c = c.wrapping_add(sha512_s1(h))\n        c = c.wrapping_add(b ^ (h & (a ^ b))).wrapping_add(0x4a7484aa6ea6e483u64).wrapping_add(w5)\n        g = g.wrapping_add(c)\n        c = c.wrapping_add(sha512_s0(d))\n        c = c.wrapping_add(sha512_maj(d, e, f))\n        w6 = w6.wrapping_add(sha512_g1(w4))\n        w6 = w6.wrapping_add(w15)\n        w6 = w6.wrapping_add(sha512_g0(w7))\n        b = b.wrapping_add(sha512_s1(g))\n        b = b.wrapping_add(a ^ (g & (h ^ a))).wrapping_add(0x5cb0a9dcbd41fbd4u64).wrapping_add(w6)\n        f = f.wrapping_add(b)\n        b = b.wrapping_add(sha512_s0(c))\n        b = b.wrapping_add(sha512_maj(c, d, e))\n        w7 = w7.wrapping_add(sha512_g1(w5))\n        w7 = w7.wrapping_add(w0)\n        w7 = w7.wrapping_add(sha512_g0(w8))\n        a = a.wrapping_add(sha512_s1(f))\n        a = a.wrapping_add(h ^ (f & (g ^ h))).wrapping_add(0x76f988da831153b5u64).wrapping_add(w7)\n        e = e.wrapping_add(a)\n        a = a.wrapping_add(sha512_s0(b))\n        a = a.wrapping_add(sha512_maj(b, c, d))\n        w8 = w8.wrapping_add(sha512_g1(w6))\n        w8 = w8.wrapping_add(w1)\n        w8 = w8.wrapping_add(sha512_g0(w9))\n        h = h.wrapping_add(sha512_s1(e))\n        h = h.wrapping_add(g ^ (e & (f ^ g))).wrapping_add(0x983e5152ee66dfabu64).wrapping_add(w8)\n        d = d.wrapping_add(h)\n        h = h.wra