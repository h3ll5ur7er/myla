// check_main.my — `check --canonical` tool, written in Myla (self-hosting v0.7).
//
// Reads a .my file, lexes + parses + type-checks it, and prints the stable
// accept/reject + diagnostic-position lines for differential comparison against
// the Python checker: `ok` on success, else `err <line> <col> <span> type:
// <message>` (diag.canonical) for each error, in the order found (MYLA-65,
// D80), each followed by its notes (diag.canonical_note).
// (The checker gate covers single-file programs that lex + parse cleanly; the
// only diagnostic class it emits is `type`.)

from std.process import args, exit
from std.fs import read_to_string
from std.io import println, eprintln
from .parser import parse_source_all
from .checker import check_program
from .diag import canonical_err, canonical, canonical_note

fun check_and_report(src: str) {
    let parsed = match parse_source_all(src, 0) {
        Ok(p) => p,
        Err(ds) => {
            for d in ds { println(canonical_err(d)) }
            return
        },
    }
    match check_program(parsed.program) {
        Ok(ws) => {
            // its warnings first (D95), as `check --canonical` prints them
            for w in ws {
                println("warn" + slice_from(canonical(w.line, w.col, w.sp, "warning", w.msg), 3))
                for n in w.notes { println(canonical_note(n)) }
            }
            println("ok")
        },
        Err(errs) => {
            for e in errs {
                println(canonical(e.line, e.col, e.sp, "type", e.msg))
                for n in e.notes { println(canonical_note(n)) }
            }
        },
    }
}

// `s` from byte `i` on.
fun slice_from(s: str, i: int32) -> str {
    var sb = StringBuilder()
    append(sb, s, i, len(s))
    return build(sb)
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        eprintln("usage: check_main <file.my>")
        exit(2)
    }
    match read_to_string(argv[1]) {
        Ok(src) => check_and_report(src),
        Err(e) => {
            eprintln("check_main: cannot read input file")
            exit(1)
        }
    }
}
