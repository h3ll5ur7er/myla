// project_cmd.my -- the project commands of `myla` (MYLA-94, D73): `new`,
// `build`, `run`, `test`, `check`, `clean` and `fetch` (MYLA-95), which
// main.my runs when no `.my` file is given (wiki: Architecture/Project-tool,
// "Commands").
//
// Every command but `new` finds `myla.toml` in the working directory or above
// it, works out the packages with the project model (project.my, MYLA-93) and
// hands them to the loader as `--package` pairs (MYLA-92), with `src/` as the
// project root; locked Git commits that aren't checked out yet are checked
// out first (fetch.my). Paths are shown relative to the working directory, as a file
// given on the command line would be: `src/main.my`.

from std.io import write, eprintln
from std.fs import exists, is_dir, list_dir, make_dir_all, write_to_file, current_dir, remove_dir_all, read_to_string
from std.process import args, command, env, ExitStatus
from std.time import now_ns
from .loader import LoadOptions
from .driver import cmd_build, cmd_interp, own_tests, native_tests, emulator, load_and_check, decode
from .interp import TestOptions, selected
from .stdroot import EMBEDDED_ROOT
from .test_programs import test_program_of, test_program_report
from .project import find_manifest, loader_packages, relative_path, parent_dir, name_error, Project
from .fetch import checked_out_project, fetch

// The project found from the working directory `cwd`.
struct Here { cwd: str, project: Project }

// The manifest around the working directory, with that directory.
fun find_here() -> Result<(str, str), str> {
    let cwd = match current_dir() {
        Ok(d) => d
        Err(e) => { return Err("myla: cannot find the working directory") }
    }
    return match find_manifest(cwd) {
        Some(m) => Ok((cwd, m))
        None => Err("myla: no myla.toml in this directory or above it")
    }
}

// The project around the working directory, its locked Git commits checked
// out, or the message to print.
fun locate() -> Result<Here, str> {
    let (cwd, manifest) = find_here()?
    let p = checked_out_project(manifest)?
    return Ok(Here { cwd: cwd, project: p })
}

// `myla fetch [--update]`: resolve the Git dependencies and write `myla.lock`.
pub fun project_fetch(update: bool) -> int32 {
    let found = find_here()
    let manifest = match found {
        Ok(pair) => pair.1
        Err(msg) => {
            eprintln(msg)
            return 1
        }
    }
    return match fetch(manifest, update) {
        Ok(n) => 0
        Err(msg) => {
            eprintln(msg)
            1
        }
    }
}

// `path` (absolute) as the commands show it.
fun shown(h: Here, path: str) -> str {
    return relative_path(h.cwd, path)
}

// The load options of a build of the project: those of the command line (the
// standard library, extra `--package` flags) with the project's packages
// first and `src/` as the project root.
fun options(h: Here, base: LoadOptions) -> LoadOptions {
    var opts = base
    var packages = loader_packages(h.project)
    for pkg in base.packages { packages.push(pkg) }
    opts.packages = packages
    opts.root = shown(h, h.project.root.dir + "/src")
    return opts
}

// The project around the working directory, if it has a program; else None,
// with the message printed.
fun with_program() -> Option<Here> {
    let h = match locate() {
        Ok(h) => h
        Err(msg) => {
            eprintln(msg)
            return None
        }
    }
    if !h.project.root.has_program {
        eprintln(format("myla: '{}' has no program (src/main.my); `myla check` checks its library", h.project.root.name))
        return None
    }
    return Some(h)
}

// `myla build [-g] [--checked]`: `src/main.my` to `build/<name>`.
pub fun project_build(base: LoadOptions, debug: bool, checked: bool, target: str) -> int32 {
    let h = match with_program() {
        Some(h) => h
        None => { return 1 }
    }
    let out_dir = h.project.root.dir + "/build"
    match make_dir_all(out_dir) {
        Ok(()) => {},
        Err(e) => {
            eprintln("myla: cannot create " + shown(h, out_dir))
            return 1
        },
    }
    let entry = shown(h, h.project.root.dir + "/src/main.my")
    return cmd_build(entry, shown(h, out_dir + "/" + h.project.root.name), options(h, base), debug, checked, target)
}

// `myla run [args…]`: interpret `src/main.my` with the arguments.
pub fun project_run(base: LoadOptions, prog_args: [str]) -> int32 {
    let h = match with_program() {
        Some(h) => h
        None => { return 1 }
    }
    return cmd_interp(shown(h, h.project.root.dir + "/src/main.my"), options(h, base), prog_args)
}

// `myla test [--only <text>] [--list]`: the `#test` cases of every file
// under `src/`, each file's own once, a block of results per file that has
// any; then the files of `tests/` (D162, MYLA-306): a test program (one
// whose trailing comment block has `// output:`, test_programs.my) run in
// the interpreter and compared, the others' cases as `src/`'s; and the
// total. When the project has a program and a `tests/`, the program is
// built first to `build/<name>`, which `std.test.program()` names.
pub fun project_test(base: LoadOptions, sel: TestOptions, native: bool, target: str) -> int32 {
    let h = match locate() {
        Ok(h) => h
        Err(msg) => {
            eprintln(msg)
            return 1
        }
    }
    let opts = options(h, base)
    let tests_dir = h.project.root.dir + "/tests"
    var options = sel
    if is_dir(tests_dir) && h.project.root.has_program && !sel.list {
        // built checked, as everything `myla test` runs is (D175)
        let built = project_build(base, false, true, target)
        if built != 0 { return built }
        options.program = h.project.root.dir + "/build/" + h.project.root.name
    }
    let run_natively = native && !sel.list
    var passed = 0
    var total = 0
    var files = 0
    var broken = 0
    var programs: [str] = []
    var sources = source_files(h.project.root.dir + "/src")
    for path in source_files(tests_dir) {
        let text = match read_to_string(path) { Ok(t) => t, Err(e) => "" }
        match test_program_of(text) {
            Some(tp) => { programs.push(path) },
            None => { sources.push(path) },
        }
    }
    for path in sources {
        let file = shown(h, path)
        let result = if run_natively { native_tests(file, opts, options, target) } else { own_tests(file, opts, options) }
        match result {
            Ok(r) => {
                if r.total > 0 {
                    write(1, "== " + file + "\n")
                    for line in r.report { write(1, line) }
                    passed = passed + r.passed
                    total = total + r.total
                    files = files + 1
                }
            },
            Err(msg) => {
                eprintln(msg)
                broken = broken + 1
            },
        }
    }
    var shown_header = false
    for path in programs {
        let file = shown(h, path)
        if !selected(file, sel.only) { continue }
        if !shown_header {
            write(1, "== tests/\n")
            shown_header = true
        }
        total = total + 1
        files = files + 1
        if sel.list {
            write(1, file + "\n")
            continue
        }
        let report = if run_natively { run_test_program_natively(h, path, opts, target) } else { run_test_program(h, path, opts) }
        if report.len() == 0 {
            passed = passed + 1
            write(1, "PASS  " + file + "\n")
        } else {
            for line in report { write(1, line) }
        }
    }
    if total == 0 {
        if sel.only != "" {
            write(1, format("no #test cases match '{}'.\n", sel.only))
            return 1
        }
        write(1, "no #test cases found.\n")
    } else if sel.list {
        return 0
    } else {
        write(1, format("\n{}/{} passed in {}.\n", passed, total, count(files, "file")))
    }
    if broken > 0 {
        eprintln(format("myla: {} not compiled", count(broken, "file")))
    }
    if passed == total && broken == 0 { return 0 }
    return 1
}

// The test program `path` built for `target` and run (under the emulator,
// for another target), and compared as `run_test_program` compares.
fun run_test_program_natively(h: Here, path: str, opts: LoadOptions, target: str) -> [str] {
    let file = shown(h, path)
    let text = match read_to_string(path) { Ok(t) => t, Err(e) => "" }
    let tp = match test_program_of(text) {
        Some(tp) => tp,
        None => { return [format("FAIL  {}: not a test program\n", file)] },
    }
    var base = match env("TMPDIR") { Some(d) => d, None => "" }
    if base == "" { base = "/tmp" }
    let dir = format("{}/myla-test-{}", base, now_ns())
    match make_dir_all(dir) {
        Ok(()) => {},
        Err(e) => { return [format("FAIL  {}: cannot create {}\n", file, dir)] },
    }
    let out = dir + "/program"
    // checked, as `myla test` runs everything (D175)
    if cmd_build(file, out, opts, false, true, target) != 0 {
        let gone = remove_dir_all(dir)
        return [format("FAIL  {}: didn't build\n", file)]
    }
    var argv = emulator(target)
    argv.push(out)
    var rest: [str] = []
    var i = 1
    while i < argv.len() {
        rest.push(argv[i])
        i = i + 1
    }
    let ran = command(argv[0]).args(rest).stdin(tp.input).output()
    let gone = remove_dir_all(dir)
    let o = match ran {
        Ok(o) => o,
        Err(e) => { return [format("FAIL  {}: cannot run it with '{}'\n", file, argv[0])] },
    }
    let code = match o.status {
        ExitStatus.Exited(c) => c,
        ExitStatus.Signaled(sig) => -sig,
    }
    return test_program_report(file, tp, decode(o.stdout), decode(o.stderr), code)
}

// The test program `path` run in the interpreter, through this tool (`myla
// run` with the project's root and packages, its input on stdin), and its
// output, exit status and stderr compared with what it says
// (test_programs.my): [] when it passed, else its report lines.
fun run_test_program(h: Here, path: str, opts: LoadOptions) -> [str] {
    let file = shown(h, path)
    let text = match read_to_string(path) { Ok(t) => t, Err(e) => "" }
    let tp = match test_program_of(text) {
        Some(tp) => tp,
        None => { return [format("FAIL  {}: not a test program\n", file)] },
    }
    var argv = ["run", file, "--root", opts.root]
    if opts.stdlib_root != EMBEDDED_ROOT { argv.push("--stdlib")
        argv.push(opts.stdlib_root) }
    for pkg in opts.packages {
        argv.push("--package")
        argv.push(pkg.0 + "=" + pkg.1)
    }
    let out = match command(args()[0]).args(argv).stdin(tp.input).output() {
        Ok(o) => o,
        Err(e) => { return [format("FAIL  {}: could not run '{}' to interpret it\n", file, args()[0])] },
    }
    let code = match out.status {
        ExitStatus.Exited(c) => c,
        ExitStatus.Signaled(sig) => -sig,
    }
    return test_program_report(file, tp, decode(out.stdout), decode(out.stderr), code)
}

// `myla check`: type-check every file under `src/`, printing each one's
// first error.
pub fun project_check(base: LoadOptions) -> int32 {
    let h = match locate() {
        Ok(h) => h
        Err(msg) => {
            eprintln(msg)
            return 1
        }
    }
    let opts = options(h, base)
    var status = 0
    for path in source_files(h.project.root.dir + "/src") {
        match load_and_check(shown(h, path), opts) {
            Ok(ch) => {},
            Err(msg) => {
                eprintln(msg)
                status = 1
            },
        }
    }
    return status
}

// `myla clean [--deps]`: remove `build/` (and `.myla/`, the fetched
// dependencies). Only the manifest is needed: the dependencies aren't
// resolved, so a lock file that is missing or stale doesn't stop cleaning.
pub fun project_clean(deps: bool) -> int32 {
    let found = match find_here() {
        Ok(pair) => pair
        Err(msg) => {
            eprintln(msg)
            return 1
        }
    }
    let (cwd, manifest) = found
    let root = parent_dir(manifest)
    var dirs = [root + "/build"]
    if deps { dirs.push(root + "/.myla") }
    for d in dirs {
        if exists(d) {
            match remove_dir_all(d) {
                Ok(()) => {},
                Err(e) => {
                    eprintln("myla: cannot remove " + relative_path(cwd, d))
                    return 1
                },
            }
        }
    }
    return 0
}

// `myla new <name>`: a directory `<name>` with a manifest, a program that
// greets and tests its greeting, and a `.gitignore`.
// With `lib`, a library instead (`src/<name>.my`, MYLA-244), which other
// packages depend on.
pub fun project_new(name: str, lib: bool) -> int32 {
    let problem = name_error(name)
    if problem != "" {
        eprintln("myla: " + problem)
        return 1
    }
    if exists(name) {
        eprintln(format("myla: '{}' exists already", name))
        return 1
    }
    match make_dir_all(name + "/src") {
        Ok(()) => {},
        Err(e) => {
            eprintln(format("myla: cannot create '{}'", name))
            return 1
        },
    }
    var files = [
        (name + "/myla.toml", format("[package]\nname = \"{}\"\nversion = \"0.1.0\"\n\n[dependencies]\n", name)),
        (name + "/.gitignore", "build/\n.myla/\n"),
    ]
    if lib { files.push((name + "/src/" + name + ".my", lib_template(name))) } else { files.push((name + "/src/main.my", main_template(name))) }
    for f in files {
        let (path, text) = f
        match write_to_file(path, text) {
            Ok(()) => {},
            Err(e) => {
                eprintln("myla: cannot write " + path)
                return 1
            },
        }
    }
    if lib { write(1, format("created library '{}' in {}/\n", name, name)) } else { write(1, format("created package '{}' in {}/\n", name, name)) }
    return 0
}

// The `src/<name>.my` that `myla new --lib` writes: a public function with a
// `#test` case, which a package depending on this one calls as `<name>.greeting`.
#test("shapes")["// What a package using `shapes` calls: `import shapes`, then\n// `shapes.greeting(\"you\")`.\n#test(\"you\")[\"Hello from shapes, you!\"]\npub fun greeting(name: str) -> str {\n    return f\"Hello from shapes, {name}!\"\n}\n"]
fun lib_template(name: str) -> str {
    var sb = StringBuilder()
    sb.append(format("// What a package using `{}` calls: `import {}`, then\n", name, name))
    sb.append(format("// `{}.greeting(\"you\")`.\n", name))
    sb.append("#test(\"you\")[\"Hello from " + name + ", you!\"]\n")
    sb.append("pub fun greeting(name: str) -> str {\n")
    sb.append("    return f\"Hello from " + name + ", {name}!\"\n")
    sb.append("}\n")
    return sb.build()
}

// The `src/main.my` that `myla new` writes.
#test("fresh")["// The greeting `main` prints.\n#test(\"fresh\")[\"Hello from fresh!\"]\nfun greeting(name: str) -> str {\n    return f\"Hello from {name}!\"\n}\n\nfun main() {\n    print(greeting(\"fresh\"))\n}\n"]
fun main_template(name: str) -> str {
    var sb = StringBuilder()
    sb.append("// The greeting `main` prints.\n")
    sb.append(format("#test(\"{}\")[\"Hello from {}!\"]\n", name, name))
    sb.append("fun greeting(name: str) -> str {\n")
    sb.append("    return f\"Hello from {name}!\"\n")
    sb.append("}\n\n")
    sb.append("fun main() {\n")
    sb.append(format("    print(greeting(\"{}\"))\n", name))
    sb.append("}\n")
    return sb.build()
}

// The `.my` files under the directory `dir` and its subdirectories, sorted
// (names starting with `.` skipped).
fun source_files(dir: str) -> [str] {
    var out: [str] = []
    let names = match list_dir(dir) {
        Ok(ns) => ns
        Err(e) => { return out }
    }
    for n in names {
        if n[0] != '.' {
            let path = dir + "/" + n
            if is_dir(path) {
                for p in source_files(path) { out.push(p) }
            } else if ends_with(n, ".my") {
                out.push(path)
            }
        }
    }
    return out
}

#test(1, "file")["1 file"]
#test(2, "file")["2 files"]
fun count(n: int32, noun: str) -> str {
    if n == 1 { return format("1 {}", noun) }
    return format("{} {}s", n, noun)
}

#test("a.my", ".my")[true]
#test("my", ".my")[false]
pub fun ends_with(s: str, suffix: str) -> bool {
    if suffix.len() > s.len() { return false }
    var i = 0
    while i < suffix.len() {
        if s[s.len() - suffix.len() + i] != suffix[i] { return false }
        i = i + 1
    }
    return true
}
