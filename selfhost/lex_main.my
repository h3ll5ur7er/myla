// lex_main.my — `tokenize --canonical` tool, written in Myla (self-hosting v0.6a).
//
// Reads a .my file and prints its canonical token dump (src/myla/canon.py), for
// byte-for-byte differential comparison against `myla tokenize --canonical`;
// for a lex error, its `err <line> <col> lex: <message>` line.

from std.process import args, exit
from std.fs import read_to_string
from std.io import println, eprintln
from .lexer import lex, canonical_line
from .diag import canonical_err

fun lex_and_dump(src: str) {
    match lex(src) {
        Ok(toks) => {
            for t in toks { println(canonical_line(t)) }
        },
        Err(d) => { println(canonical_err(d)) },
    }
}

fun main() {
    let argv = args()
    if len(argv) < 2 {
        eprintln("usage: lex_main <file.my>")
        exit(2)
    }
    match read_to_string(argv[1]) {
        Ok(src) => lex_and_dump(src),
        Err(e) => {
            eprintln("lex_main: cannot read input file")
            exit(1)
        }
    }
}
