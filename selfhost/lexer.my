// lexer.my — the Myla lexer (mirror of src/myla/lexer.py).
//
// The source is decoded to a list of Unicode scalars so column counting matches
// the Python oracle (which indexes a codepoint string) and multi-byte literals
// lex correctly. The first error is recorded with the Python lexer's message
// and position, and lexing stops there (`fail` jumps to the end of the input).

from .util import cp_utf8, is_digit, is_ident_start, is_ident_continue
from .util import digit_value, parse_value, is_blank, escape
from .tokens import TokenKind, Token, Diag, SrcSpan, keyword_kind, is_int_suffix, is_float_suffix, kind_name

pub struct Lexer {
    cps: [char],
    pos: int32,
    line: int32,
    col: int32,
    n: int32,
    toks: [Token],
    err: Option<Diag>,
    // the brackets open at the cursor, innermost last: true for `(` and `[`,
    // inside which a line break doesn't end a statement, false for `{`
    // (D104 (3), MYLA-224)
    opens: [bool],
    // a line break left out since the last token, and where it was
    held: bool,
    held_line: int32,
    held_col: int32,
    // the text of a `//` comment after code on the current line, which its
    // NEWLINE token carries as its suffix (a `#test` case's name, MYLA-239)
    comment: str,
    // whether `$` continues an identifier: only in source the checker writes
    // after the loader has qualified the names (`std$json$Json` in a
    // derive's impl, MYLA-385), never in a program's text
    qualified: bool,
    // whether a `#test` attribute is skipped unlexed: in a module whose
    // cases nothing runs, every one but the entry (MYLA-359)
    skip_tests: bool,
    // whether a function's body is skipped unlexed, its braces kept, for
    // the parser to read when the checker needs it: in an implicit module
    // of the standard library (MYLA-359)
    lazy: bool,
}

#test("a")[Lexer { cps: ['a'], pos: 0, line: 1, col: 1, n: 1, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }]
#test("code")[Lexer { cps: ['c', 'o', 'd', 'e'], pos: 0, line: 1, col: 1, n: 4, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }]
#test("tries")[Lexer { cps: ['t', 'r', 'i', 'e', 's'], pos: 0, line: 1, col: 1, n: 5, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }]
pub fun new_lexer(src: str) -> Lexer {
    // the code points as `chars` decodes them, not copied (MYLA-133)
    let cps = src.chars()
    // a UTF-8 byte-order mark at the start is skipped, taking no column
    // (MYLA-178)
    var start = 0
    if cps.len() > 0 && cps[0] == '\u{FEFF}' { start = 1 }
    return Lexer { cps: cps, pos: start, line: 1, col: 1, n: cps.len() as int32, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }
}

// A lexer at the start of `src`, for the cases.
#test("")[Lexer { cps: [], pos: 0, line: 1, col: 1, n: 0, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }]
fun lexer_on(src: str) -> Lexer {
    return new_lexer(src)
}

// The text of the one-character operator `c` (`one_char_kind`'s): a
// literal, where `cp_utf8` made a string for every bracket and comma
// (MYLA-359).
#test(40)["("]
#test(59)[";"]
#test(64)[""]
fun one_char_text(c: int32) -> str {
    return match c {
        43 => "+", 45 => "-", 42 => "*", 47 => "/", 37 => "%", 38 => "&", 94 => "^", 126 => "~",
        60 => "<", 62 => ">", 33 => "!", 61 => "=", 124 => "|", 40 => "(", 41 => ")", 123 => "{",
        125 => "}", 91 => "[", 93 => "]", 44 => ",", 58 => ":", 46 => ".", 35 => "#", 63 => "?",
        59 => ";", _ => "",
    }
}

// One canonical token line (mirror of src/myla/canon.py:canonical_token).
#test(Token { kind: TokenKind.IDENT, lexeme: "East", line: 64, column: 19, eline: 64, ecol: 23, ival: 0, suffix: "", big: "" })["IDENT 64 19 \"East\" end=64:23"]
#test(Token { kind: TokenKind.IDENT, lexeme: "Direction", line: 62, column: 9, eline: 62, ecol: 18, ival: 0, suffix: "", big: "" })["IDENT 62 9 \"Direction\" end=62:18"]
#test(Token { kind: TokenKind.IDENT, lexeme: "Direction", line: 65, column: 9, eline: 65, ecol: 18, ival: 0, suffix: "", big: "" })["IDENT 65 9 \"Direction\" end=65:18"]
pub fun canonical_line(t: Token) -> str {
    var sb = StringBuilder()
    sb.append(kind_name(t.kind))
    sb.append(format(" {} {} \"", t.line, t.column))
    sb.append(escape(t.lexeme))
    sb.append_byte('"')
    if t.kind == TokenKind.INT {
        if t.big != "" { sb.append(format(" int={}", t.big)) } else { sb.append(format(" int={}", t.ival)) }
        if t.suffix != "" {
            sb.append(format(" suf={}", t.suffix))
        }
    } else if t.kind == TokenKind.FLOAT {
        if t.suffix != "" {
            sb.append(format(" suf={}", t.suffix))
        }
    } else if t.kind == TokenKind.CHAR {
        sb.append(format(" cp={}", t.ival))
    }
    sb.append(format(" end={}:{}", t.eline, t.ecol))
    return sb.build()
}

// `s` without the spaces and tabs at its ends.
#test("  my case \t")["my case"]
#test("")[""]
pub fun trim_spaces(s: str) -> str {
    var a = 0
    var b = s.len()
    while a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r') { a = a + 1 }
    while b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r') { b = b - 1 }
    var sb = StringBuilder()
    sb.append(s, a, b)
    return sb.build()
}

// Whether a token of kind `k` can only start a statement or a declaration,
// never stand inside brackets (`if`, `match` and `async` can, and `var` in a
// method's `(var self`).
#test(TokenKind.LET)[true]
#test(TokenKind.IF)[false]
#test(TokenKind.ASYNC)[false]
#test(TokenKind.IDENT)[false]
#test(TokenKind.VAR)[false]
pub fun starts_statement(k: TokenKind) -> bool {
    return k == TokenKind.LET || k == TokenKind.RETURN || k == TokenKind.BECOME || k == TokenKind.FUN || k == TokenKind.STRUCT || k == TokenKind.ACTOR || k == TokenKind.ENUM || k == TokenKind.IMPL || k == TokenKind.TRAIT || k == TokenKind.CONST || k == TokenKind.TYPEALIAS || k == TokenKind.IMPORT || k == TokenKind.FROM || k == TokenKind.PUB || k == TokenKind.WHILE || k == TokenKind.FOR || k == TokenKind.BREAK || k == TokenKind.CONTINUE
}

// Whether a line that ends in a token of kind `k` goes on: a binary operator
// (D104 (3), MYLA-224), but not `>`, which also closes a generic type.
#test(TokenKind.PLUS)[true]
#test(TokenKind.PIPEGT)[true]
#test(TokenKind.GT)[false]
#test(TokenKind.IDENT)[false]
#test(TokenKind.MINUS)[true]
pub fun continues_line(k: TokenKind) -> bool {
    return k == TokenKind.PLUS || k == TokenKind.MINUS || k == TokenKind.STAR || k == TokenKind.SLASH || k == TokenKind.PERCENT || k == TokenKind.EQ || k == TokenKind.NE || k == TokenKind.LT || k == TokenKind.LE || k == TokenKind.GE || k == TokenKind.AND || k == TokenKind.OR || k == TokenKind.AMP || k == TokenKind.PIPE || k == TokenKind.CARET || k == TokenKind.PIPEGT
}

impl Lexer {
    // Build a `str` from the codepoints `cps[start..end]`. A method (not a free
    // function) so `self.cps` is borrowed through `self` rather than passed —
    // and cloned — by value on every token (the lexer's dominant allocation).
    #test(Lexer { cps: ['a'], pos: 1, line: 1, col: 2, n: 1, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 0, 1)["a"]
    #test(Lexer { cps: ['c', 'o', 'd', 'e'], pos: 4, line: 1, col: 5, n: 4, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 0, 4)["code"]
    #test(Lexer { cps: ['t', 'r', 'i', 'e', 's'], pos: 5, line: 1, col: 6, n: 5, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 0, 5)["tries"]
    fun slice_str(self, start: int32, end: int32) -> str {
        var sb = StringBuilder()
        var i = start
        while i < end {
            // ASCII as it is, without a string of its own (MYLA-133)
            let c = self.cps[i] as int32
            if c < 128 { sb.append_byte(c as uint8) } else { sb.append(cp_utf8(c)) }
            i = i + 1
        }
        return sb.build()
    }

    #test(Lexer { cps: ['a'], pos: 1, line: 1, col: 2, n: 1, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[true]
    #test(Lexer { cps: ['b'], pos: 1, line: 1, col: 2, n: 1, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[true]
    #test(Lexer { cps: ['a'], pos: 0, line: 1, col: 1, n: 1, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[false]
    fun at_end(self) -> bool {
        return self.pos >= self.n
    }

    #test(Lexer { cps: ['a'], pos: 0, line: 1, col: 1, n: 1, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[97]
    #test(Lexer { cps: ['n', 'a', 'm', 'e'], pos: 0, line: 1, col: 1, n: 4, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[110]
    #test(Lexer { cps: ['a', ' ', '+', ' ', 'b'], pos: 2, line: 1, col: 3, n: 5, toks: [Token { kind: TokenKind.IDENT, lexeme: "a", line: 1, column: 1, eline: 1, ecol: 2, ival: 0, suffix: "", big: "" }], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[43]
    fun peek(self) -> int32 {
        if self.pos >= self.n { return 0 }
        return self.cps[self.pos] as int32
    }

    #test(Lexer { cps: ['a', ' ', '+', ' ', 'b'], pos: 2, line: 1, col: 3, n: 5, toks: [Token { kind: TokenKind.IDENT, lexeme: "a", line: 1, column: 1, eline: 1, ecol: 2, ival: 0, suffix: "", big: "" }], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[32]
    fun peek1(self) -> int32 {
        if self.pos + 1 >= self.n { return 0 }
        return self.cps[self.pos + 1] as int32
    }

    fun peek2(self) -> int32 {
        if self.pos + 2 >= self.n { return 0 }
        return self.cps[self.pos + 2] as int32
    }

    // Record the first error and stop: the scanners return after calling this,
    // and at the end of the input every loop ends. Its range runs to where the
    // lexer stopped, as in the Python lexer.
    fun fail(var self, line: int32, col: int32, msg: str) {
        self.fail_span(line, col, SrcSpan { sline: line, scol: col, eline: self.line, ecol: self.col }, msg)
    }

    fun fail_span(var self, line: int32, col: int32, sp: SrcSpan, msg: str) {
        match self.err {
            None => { self.err = Some(Diag { kind: "lex error", line: line, col: col, sp: sp, msg: msg }) },
            Some(e) => {},
        }
        self.pos = self.n
    }

    #test(Lexer { cps: ['a'], pos: 0, line: 1, col: 1, n: 1, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[97]
    #test(Lexer { cps: ['n', 'a', 'm', 'e'], pos: 0, line: 1, col: 1, n: 4, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[110]
    #test(Lexer { cps: ['a', ' ', '+', ' ', 'b'], pos: 2, line: 1, col: 3, n: 5, toks: [Token { kind: TokenKind.IDENT, lexeme: "a", line: 1, column: 1, eline: 1, ecol: 2, ival: 0, suffix: "", big: "" }], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false })[43]
    fun advance(var self) -> int32 {
        if self.pos >= self.n { return 0 }
        let c = self.cps[self.pos] as int32
        self.pos = self.pos + 1
        if c == 10 {
            self.line = self.line + 1
            self.col = 1
        } else {
            self.col = self.col + 1
        }
        return c
    }

    // A scanner emits a token once it has consumed it: it ends at the cursor.
    fun emit(var self, kind: TokenKind, lexeme: str, line: int32, col: int32, ival: int64, suffix: str) {
        // a line inside brackets that starts a statement or declaration: the
        // brackets were never closed, the line break ends the statement
        // after all (the parser goes on from there)
        if self.held && starts_statement(kind) {
            while self.opens.len() > 0 && self.opens[self.opens.len() - 1] { let o = self.opens.pop() }
            self.toks.push(Token { kind: TokenKind.NEWLINE, lexeme: "\\n", line: self.held_line, column: self.held_col, eline: self.held_line, ecol: self.held_col, ival: 0, suffix: "", big: "" })
        }
        self.held = false
        self.toks.push(Token { kind: kind, lexeme: lexeme, line: line, column: col, eline: self.line, ecol: self.col, ival: ival, suffix: suffix, big: "" })
        if kind == TokenKind.LPAREN || kind == TokenKind.LBRACKET { self.opens.push(true) }
        else if kind == TokenKind.LBRACE { self.opens.push(false) }
        else if (kind == TokenKind.RPAREN || kind == TokenKind.RBRACKET) && self.opens.len() > 0 && self.opens[self.opens.len() - 1] { let o = self.opens.pop() }
        else if kind == TokenKind.RBRACE {
            // the brackets left open inside the block end with it
            while self.opens.len() > 0 && self.opens[self.opens.len() - 1] { let o = self.opens.pop() }
            if self.opens.len() > 0 { let b = self.opens.pop() }
        }
    }

    fun emit0(var self, kind: TokenKind, lexeme: str, line: int32, col: int32) {
        self.emit(kind, lexeme, line, col, 0, "")
    }

    // A line break: a NEWLINE token, unless the statement goes on (D104 (3),
    // MYLA-224): inside `( )` or `[ ]` (not in a `{ }` within them), or after
    // a binary operator that ends the line (not `>`, which also closes a
    // generic type).
    fun emit_newline(var self) {
        if self.toks.len() == 0 { return }
        let last = self.toks[self.toks.len() - 1].kind
        let comment = self.comment
        self.comment = ""
        if last == TokenKind.NEWLINE { return }
        if (self.opens.len() > 0 && self.opens[self.opens.len() - 1]) || continues_line(last) {
            if !self.held {
                self.held = true
                self.held_line = self.line
                self.held_col = self.col
            }
            return
        }
        self.emit(TokenKind.NEWLINE, "\\n", self.line, self.col, 0, comment)
    }

    fun line_comment(var self) {
        let start = self.pos + 2
        // to the line's end, which `advance` would count no line break in
        var i = self.pos
        while i < self.n && self.cps[i] != '\n' { i += 1 }
        self.col = self.col + (i - self.pos)
        self.pos = i
        // after code on its line: kept for the line's NEWLINE token
        if self.toks.len() > 0 && self.toks[self.toks.len() - 1].kind != TokenKind.NEWLINE && self.toks[self.toks.len() - 1].eline == self.line {
            self.comment = trim_spaces(self.slice_str(start, self.pos))
        }
    }

    fun block_comment(var self) {
        let sl = self.line
        let sc = self.col
        self.advance()
        self.advance()
        while !self.at_end() {
            if self.peek() == 42 && self.peek1() == 47 {
                self.advance()
                self.advance()
                return
            }
            self.advance()
        }
        self.fail(sl, sc, "unterminated block comment")
    }

    #test(Lexer { cps: ['1', ' ', '/', ' ', '0'], pos: 0, line: 1, col: 1, n: 5, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 10)["1"]
    fun scan_digits(var self, base: int32) -> str {
        var sb = StringBuilder()
        var prev_us = false
        var any = false
        while !self.at_end() {
            let c = self.peek()
            if c == 95 {
                if !any || prev_us {
                    self.fail(self.line, self.col, "'_' separators in an integer literal must sit between digits")
                    return ""
                }
                prev_us = true
                self.advance()
            } else {
                let dv = digit_value(c)
                if dv >= 0 && dv < base {
                    sb.append_byte(c as uint8)
                    any = true
                    prev_us = false
                    self.advance()
                } else {
                    break
                }
            }
        }
        if prev_us {
            self.fail(self.line, self.col, "integer literal cannot end with '_'")
        }
        return sb.build()
    }

    #test(Lexer { cps: ['1', ' ', '/', ' ', '0'], pos: 1, line: 1, col: 2, n: 5, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 1, 1)[""]
    fun scan_int_suffix(var self, sl: int32, sc: int32) -> str {
        if self.peek() == 105 || self.peek() == 117 {
            let sp = self.pos
            self.advance()
            while is_digit(self.peek()) {
                self.advance()
            }
            let cand = self.slice_str(sp, self.pos)
            if !is_int_suffix(cand) {
                self.fail(sl, sc, format("invalid integer literal suffix '{}'", cand))
                return ""
            }
            return cand
        }
        if is_ident_continue(self.peek()) {
            self.fail(self.line, self.col, format("invalid integer literal: unexpected '{}' after digits", cp_utf8(self.peek())))
        }
        return ""
    }

    fun scan_number(var self) {
        let sl = self.line
        let sc = self.col
        let sp = self.pos
        let p1 = self.peek1()
        let is_prefix = p1 == 120 || p1 == 88 || p1 == 98 || p1 == 66 || p1 == 111 || p1 == 79
        if self.peek() == 48 && is_prefix {
            var base = 16
            if p1 == 98 || p1 == 66 {
                base = 2
            } else if p1 == 111 || p1 == 79 {
                base = 8
            }
            self.advance()
            self.advance()
            let digits = self.scan_digits(base)
            if digits.len() == 0 {
                self.fail(sl, sc, format("integer literal has no digits after '0{}'", cp_utf8(lower(p1))))
                return
            }
            let value = parse_value(digits, base as int64)
            let suffix = self.scan_int_suffix(sl, sc)
            let lexeme = self.slice_str(sp, self.pos)
            self.emit_int(lexeme, sl, sc, value, suffix, big_text(digits, base as int64))
            return
        }
        let int_digits = self.scan_digits(10)
        var is_float = false
        if self.peek() == 46 && is_digit(self.peek1()) {
            self.advance()
            self.scan_digits(10)
            is_float = true
        }
        if self.peek() == 101 || self.peek() == 69 {
            let nx = self.peek1()
            if is_digit(nx) || ((nx == 43 || nx == 45) && is_digit(self.peek2())) {
                self.advance()
                if self.peek() == 43 || self.peek() == 45 {
                    self.advance()
                }
                self.scan_digits(10)
                is_float = true
            }
        }
        var suffix = ""
        if self.peek() == 102 {
            let fsp = self.pos
            self.advance()
            while is_digit(self.peek()) {
                self.advance()
            }
            let cand = self.slice_str(fsp, self.pos)
            if !is_float_suffix(cand) {
                self.fail(sl, sc, format("invalid float literal suffix '{}'", cand))
                return
            }
            suffix = cand
            is_float = true
        } else if !is_float {
            suffix = self.scan_int_suffix(sl, sc)
        }
        if is_float {
            if is_ident_continue(self.peek()) {
                self.fail(self.line, self.col, format("invalid float literal: unexpected '{}' after digits", cp_utf8(self.peek())))
                return
            }
            let lexeme = self.slice_str(sp, self.pos)
            self.emit(TokenKind.FLOAT, lexeme, sl, sc, 0, suffix)
            return
        }
        let value = parse_value(int_digits, 10)
        let lexeme = self.slice_str(sp, self.pos)
        self.emit_int(lexeme, sl, sc, value, suffix, big_text(int_digits, 10))
    }

    // An INT token: `value` holds the literal's 64 low bits, `big` its decimal
    // text when it is 2^63 or more (Python keeps the exact value).
    fun emit_int(var self, lexeme: str, line: int32, col: int32, value: int64, suffix: str, big: str) {
        self.toks.push(Token { kind: TokenKind.INT, lexeme: lexeme, line: line, column: col, eline: self.line, ecol: self.col, ival: value, suffix: suffix, big: big })
    }

    fun scan_string(var self) {
        let sl = self.line
        let sc = self.col
        self.advance()
        var sb = StringBuilder()
        while true {
            if self.at_end() || self.peek() == 10 {
                self.fail(sl, sc, "unterminated string literal")
                return
            }
            let c = self.advance()
            if c == 34 {
                break
            }
            if c == 92 {
                let el = self.line
                let ec = self.col
                if self.at_end() {
                    self.fail(sl, sc, "unterminated string literal")
                    return
                }
                let cp = self.scan_escape(el, ec, "string")
                if cp < 0 { return }
                sb.append(cp_utf8(cp))
            } else {
                sb.append(cp_utf8(c))
            }
        }
        let value = sb.build()
        self.emit(TokenKind.STRING, value, sl, sc, 0, "")
    }

    // The scalar of the escape whose letter is next (the backslash was at
    // or just before `line`:`col`), in a `literal` ("char" or "string"), the
    // same escapes in both (D72, MYLA-86); -1 after an error.
    fun scan_escape(var self, line: int32, col: int32, literal: str) -> int32 {
        let esc = self.advance()
        if esc == 117 { return self.scan_unicode_escape(line, col, literal) }
        if esc == 110 { return 10 }
        if esc == 116 { return 9 }
        if esc == 114 { return 13 }
        if esc == 48 { return 0 }
        if esc == 92 || esc == 34 || esc == 39 { return esc }
        self.fail(line, col, format("invalid escape sequence '\\{}'", cp_utf8(esc)))
        return -1
    }

    fun scan_unicode_escape(var self, line: int32, col: int32, literal: str) -> int32 {
        if self.at_end() || self.advance() != 123 {
            self.fail(line, col, format("expected '{{' after '\\u' in {} literal", literal))
            return -1
        }
        var sb = StringBuilder()
        var cnt = 0
        while !self.at_end() && self.peek() != 125 {
            let d = self.advance()
            if digit_value(d) < 0 {
                self.fail(line, col, format("invalid hex digit '{}' in '\\u{{…}}' escape", cp_utf8(d)))
                return -1
            }
            sb.append_byte(d as uint8)
            cnt = cnt + 1
        }
        if self.at_end() {
            self.fail(line, col, "unterminated '\\u{…}' escape")
            return -1
        }
        self.advance()
        if cnt == 0 {
            self.fail(line, col, "empty '\\u{…}' escape")
            return -1
        }
        let cp = parse_value(sb.build(), 16)
        if cp > 1114111 || (cp >= 55296 && cp <= 57343) {
            self.fail(line, col, format("invalid Unicode scalar U+{} in {} literal (must be 0..0x10FFFF and not a surrogate)", hex_upper(cp), literal))
            return -1
        }
        return cp as int32
    }

    fun scan_char(var self) {
        let sl = self.line
        let sc = self.col
        let sp = self.pos
        self.advance()
        if self.at_end() || self.peek() == 10 || self.peek() == 39 {
            self.fail(sl, sc, "empty or unterminated char literal")
            return
        }
        let c = self.advance()
        var cp = 0
        if c == 92 {
            let el = self.line
            let ec = self.col
            if self.at_end() {
                self.fail(sl, sc, "unterminated char literal")
                return
            }
            cp = self.scan_escape(el, ec, "char")
            if cp < 0 { return }
        } else {
            cp = c
        }
        if self.at_end() || self.peek() != 39 {
            self.fail(sl, sc, "char literal must contain exactly one character")
            return
        }
        self.advance()
        let lexeme = self.slice_str(sp, self.pos)
        self.emit(TokenKind.CHAR, lexeme, sl, sc, cp as int64, "")
    }

    fun scan_identifier(var self) {
        let sl = self.line
        let sc = self.col
        let sp = self.pos
        // no line break in a name: the column moves with the cursor
        var i = self.pos
        while i < self.n && (is_ident_continue(self.cps[i] as int32) || (self.qualified && self.cps[i] == '$')) { i += 1 }
        self.col = self.col + (i - self.pos)
        self.pos = i
        let text = self.slice_str(sp, self.pos)
        self.emit0(keyword_kind(text), text, sl, sc)
    }

    fun scan_operator(var self) {
        let sl = self.line
        let sc = self.col
        let c = self.peek()
        let c1 = self.peek1()
        if c == 45 && c1 == 62 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.ARROW, "->", sl, sc)
        } else if c == 61 && c1 == 62 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.FATARROW, "=>", sl, sc)
        } else if c == 124 && c1 == 62 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.PIPEGT, "|>", sl, sc)
        } else if c == 46 && c1 == 46 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.DOTDOT, "..", sl, sc)
        } else if c == 61 && c1 == 61 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.EQ, "==", sl, sc)
        } else if c == 33 && c1 == 61 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.NE, "!=", sl, sc)
        } else if c == 60 && c1 == 61 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.LE, "<=", sl, sc)
        } else if c == 62 && c1 == 61 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.GE, ">=", sl, sc)
        } else if c == 38 && c1 == 38 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.AND, "&&", sl, sc)
        } else if c == 124 && c1 == 124 {
            self.advance()
            self.advance()
            self.emit0(TokenKind.OR, "||", sl, sc)
        } else {
            let k = self.one_char_kind(c)
            if k == TokenKind.EOF {
                self.fail(sl, sc, format("unexpected character '{}'", cp_utf8(c)))
                return
            }
            self.advance()
            self.emit0(k, one_char_text(c), sl, sc)
        }
    }

    #test(Lexer { cps: ['[', '1', ',', ' ', '2', ']'], pos: 0, line: 1, col: 1, n: 6, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 91)[TokenKind.LBRACKET]
    #test(Lexer { cps: ['(', '1', ',', ' ', '\'', 'c', '\'', ',', ' ', 't', 'r', 'u', 'e', ')'], pos: 0, line: 1, col: 1, n: 14, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 40)[TokenKind.LPAREN]
    #test(Lexer { cps: ['p', '.', 'x'], pos: 1, line: 1, col: 2, n: 3, toks: [Token { kind: TokenKind.IDENT, lexeme: "p", line: 1, column: 1, eline: 1, ecol: 2, ival: 0, suffix: "", big: "" }], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }, 46)[TokenKind.DOT]
    fun one_char_kind(self, c: int32) -> TokenKind {
        if c == 43 { return TokenKind.PLUS }
        if c == 45 { return TokenKind.MINUS }
        if c == 42 { return TokenKind.STAR }
        if c == 47 { return TokenKind.SLASH }
        if c == 37 { return TokenKind.PERCENT }
        if c == 38 { return TokenKind.AMP }
        if c == 94 { return TokenKind.CARET }
        if c == 126 { return TokenKind.TILDE }
        if c == 60 { return TokenKind.LT }
        if c == 62 { return TokenKind.GT }
        if c == 33 { return TokenKind.BANG }
        if c == 61 { return TokenKind.ASSIGN }
        if c == 124 { return TokenKind.PIPE }
        if c == 40 { return TokenKind.LPAREN }
        if c == 41 { return TokenKind.RPAREN }
        if c == 123 { return TokenKind.LBRACE }
        if c == 125 { return TokenKind.RBRACE }
        if c == 91 { return TokenKind.LBRACKET }
        if c == 93 { return TokenKind.RBRACKET }
        if c == 44 { return TokenKind.COMMA }
        if c == 58 { return TokenKind.COLON }
        if c == 46 { return TokenKind.DOT }
        if c == 35 { return TokenKind.HASH }
        if c == 63 { return TokenKind.QUESTION }
        if c == 59 { return TokenKind.SEMI }
        return TokenKind.EOF            // not an operator character
    }

    fun copy_quoted(var self) -> str {
        var b = StringBuilder()
        let q = self.advance()
        b.append(cp_utf8(q))
        while true {
            if self.at_end() || self.peek() == 10 {
                self.fail(self.line, self.col, "unterminated string in f-string expression")
                return b.build()
            }
            let ch = self.advance()
            b.append(cp_utf8(ch))
            if ch == 92 {
                if self.at_end() {
                    self.fail(self.line, self.col, "unterminated string in f-string expression")
                    return b.build()
                }
                b.append(cp_utf8(self.advance()))
            } else if ch == q {
                return b.build()
            }
        }
        return b.build()
    }

    // A hole's expression as tokens, and its format spec (D139): the text
    // after its first `:` outside brackets and strings ("" for none).
    fun scan_fstring_hole(var self, fs_line: int32, fs_col: int32) -> ([Token], str) {
        let slice_line = self.line
        let slice_col = self.col
        var buf = StringBuilder()
        var depth = 1
        while true {
            if self.at_end() || self.peek() == 10 {
                self.fail(fs_line, fs_col, "unterminated '{' in f-string")
                return ([], "")
            }
            let c = self.peek()
            if c == 123 {
                depth = depth + 1
                self.advance()
                buf.append_byte(123)
            } else if c == 125 {
                self.advance()
                depth = depth - 1
                if depth == 0 {
                    break
                }
                buf.append_byte(125)
            } else if c == 34 || c == 39 {
                buf.append(self.copy_quoted())
            } else {
                let ch = self.advance()
                buf.append(cp_utf8(ch))
            }
        }
        let whole = buf.build()
        let cut = spec_colon(whole)
        var src = whole
        var spec = ""
        if cut >= 0 {
            var eb = StringBuilder()
            eb.append(whole, 0, cut)
            src = eb.build()
            var sb = StringBuilder()
            sb.append(whole, cut + 1, whole.len())
            spec = sb.build()
            if has_brace(spec) {
                self.fail(slice_line, slice_col, "a format spec can't contain '{' or '}'")
                return ([], "")
            }
        }
        if is_blank(src) {
            self.fail(slice_line, slice_col, "empty '{}' hole in f-string (expected an expression)")
            return ([], "")
        }
        var sub = new_lexer(src)
        let sub_toks = sub.run()
        match sub.err {
            // reported in the slice's own coordinates, as the Python lexer does
            Some(e) => {
                self.fail_span(e.line, e.col, e.sp, e.msg)
                return ([], "")
            },
            None => {},
        }
        var out: [Token] = []
        for t in sub_toks {
            if t.kind != TokenKind.EOF && t.kind != TokenKind.NEWLINE {
                let col = slice_col + (t.column - 1)
                let ecol = slice_col + (t.ecol - 1)
                out.push(Token { kind: t.kind, lexeme: t.lexeme, line: slice_line, column: col, eline: slice_line, ecol: ecol, ival: t.ival, suffix: t.suffix, big: t.big })
            }
        }
        return (out, spec)
    }

    fun scan_fstring(var self) {
        let sl = self.line
        let sc = self.col
        self.advance()
        self.advance()
        var fmt = StringBuilder()
        var args: [[Token]] = []
        while true {
            if self.at_end() || self.peek() == 10 {
                self.fail(sl, sc, "unterminated f-string literal (f\"…\" is single-line)")
                return
            }
            let c = self.peek()
            if c == 34 {
                self.advance()
                break
            } else if c == 123 {
                if self.peek1() == 123 {
                    self.advance()
                    self.advance()
                    fmt.append("{{")
                } else {
                    self.advance()
                    let hole = self.scan_fstring_hole(sl, sc)
                    args.push(hole.0)
                    if hole.1 == "" { fmt.append("{}") } else { fmt.append("{:" + hole.1 + "}") }
                }
            } else if c == 125 {
                if self.peek1() == 125 {
                    self.advance()
                    self.advance()
                    fmt.append("}}")
                } else {
                    self.fail(self.line, self.col, "single '}' in f-string (use '}}' for a literal '}')")
                    return
                }
            } else if c == 92 {
                let el = self.line
                let ec = self.col
                self.advance()
                if self.at_end() || self.peek() == 10 {
                    self.fail(sl, sc, "unterminated f-string literal")
                    return
                }
                let cp = self.scan_escape(el, ec, "string")
                if cp < 0 { return }
                // an escaped brace is text: doubled, `format` keeps it
                if cp == 123 || cp == 125 { fmt.append(cp_utf8(cp)) }
                fmt.append(cp_utf8(cp))
            } else {
                self.advance()
                fmt.append(cp_utf8(c))
            }
        }
        let fmt_str = fmt.build()
        self.emit(TokenKind.IDENT, "format", sl, sc, 0, "")
        self.emit0(TokenKind.LPAREN, "(", sl, sc)
        self.emit(TokenKind.STRING, fmt_str, sl, sc, 0, "")
        for toks in args {
            self.emit0(TokenKind.COMMA, ",", sl, sc)
            for t in toks {
                self.toks.push(t)
            }
        }
        self.emit0(TokenKind.RPAREN, ")", sl, sc)
    }

    // At a `#`: if it starts a `#test` attribute, consume it with its
    // arguments and expected values, unlexed, and say so (MYLA-359). Where
    // their brackets don't close (a string that doesn't end, the input that
    // does), nothing is consumed: the lexer and the parser report it.
    #test(lexer_on("#test(1, \"(\")[')'] // a case\nfun"))[true]
    #test(lexer_on("#test\nfun"))[true]
    #test(lexer_on("#tests"))[false]
    #test(lexer_on("#test(1"))[false]
    #test(lexer_on("#derive(Eq)"))[false]
    fun skip_test_attr(var self) -> bool {
        let p = self.pos
        if p + 5 > self.n || self.cps[p + 1] != 't' || self.cps[p + 2] != 'e' || self.cps[p + 3] != 's' || self.cps[p + 4] != 't' { return false }
        if p + 5 < self.n && is_ident_continue(self.cps[p + 5] as int32) { return false }
        let sl = self.line
        let sc = self.col
        self.pos = p + 5
        self.col = sc + 5
        // as the parser takes them: `(…)`, then `[…]`, on the line
        self.skip_blanks()
        if self.peek() == 40 && !self.skip_group() { return self.rewind(p, sl, sc) }
        self.skip_blanks()
        if self.peek() == 91 && !self.skip_group() { return self.rewind(p, sl, sc) }
        return true
    }

    fun rewind(var self, p: int32, line: int32, col: int32) -> bool {
        self.pos = p
        self.line = line
        self.col = col
        return false
    }

    fun skip_blanks(var self) {
        while self.peek() == 32 || self.peek() == 9 { self.advance() }
    }

    // Past the bracket at the cursor and the one that closes it, over
    // nested brackets, strings, chars, f-strings with their holes and
    // comments; false where a bracket doesn't close or closes another, or
    // a string doesn't end (the cursor is then anywhere: the caller goes
    // back). One loop over the code points, which the first test passes
    // over most of (MYLA-359).
    #test(lexer_on("(a, [\"]\", ']'], f\"{x[\")\"]}\") // )\n)x"))[true]
    #test(lexer_on("{ g(\"}\", '}', f\"{a[\"}\"]}\") // }\n  /* } */ [{}] }x"))[true]
    #test(lexer_on("(\"a)"))[false]
    #test(lexer_on("{ ( }"))[false]
    #test(lexer_on("{ (] }"))[false]
    #test(lexer_on("[ /* ]"))[false]
    fun skip_group(var self) -> bool {
        let cps = self.cps
        let n = self.n
        var closers: [char] = []
        var i = self.pos
        var line = self.line
        var col = self.col
        while i < n {
            let c = cps[i]
            if (c >= 'a' && c <= 'z') || c == ' ' || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == ',' {
                i += 1
                col += 1
            } else if c == '\n' {
                i += 1
                line += 1
                col = 1
            } else if c == '{' || c == '(' || c == '[' {
                closers.push(if c == '{' { '}' } else if c == '(' { ')' } else { ']' })
                i += 1
                col += 1
            } else if c == '}' || c == ')' || c == ']' {
                if closers.len() == 0 || closers[closers.len() - 1] != c { return false }
                let o = closers.pop()
                i += 1
                col += 1
                if closers.len() == 0 {
                    self.pos = i
                    self.line = line
                    self.col = col
                    return true
                }
            } else if c == '/' && i + 1 < n && cps[i + 1] == '/' {
                while i < n && cps[i] != '\n' {
                    i += 1
                    col += 1
                }
            } else if c == '/' && i + 1 < n && cps[i + 1] == '*' {
                i += 2
                col += 2
                while i < n && !(cps[i] == '*' && i + 1 < n && cps[i + 1] == '/') {
                    if cps[i] == '\n' {
                        line += 1
                        col = 0
                    }
                    i += 1
                    col += 1
                }
                if i >= n { return false }
                i += 2
                col += 2
            } else if c == '"' || c == '\'' {
                // an `f` of its own before the quote starts an f-string
                let fmt = c == '"' && i > 0 && cps[i - 1] == 'f' && (i < 2 || !is_ident_continue(cps[i - 2] as int32))
                self.pos = i
                self.line = line
                self.col = col
                if !self.skip_quoted(fmt) { return false }
                i = self.pos
                line = self.line
                col = self.col
            } else {
                i += 1
                col += 1
            }
        }
        return false
    }

    // Past the string or char at the cursor (an f-string's holes too, when
    // `fmt`); false where it doesn't end on its line.
    fun skip_quoted(var self, fmt: bool) -> bool {
        let q = self.advance()
        while !self.at_end() && self.peek() != 10 {
            let c = self.advance()
            if c == q { return true }
            if c == 92 {
                if self.at_end() { return false }
                self.advance()
            } else if fmt && c == 123 {
                if self.peek() == 123 { self.advance() } else if !self.skip_hole() { return false }
            }
        }
        return false
    }

    // Past an f-string's hole, its `{` consumed, and its `}`.
    fun skip_hole(var self) -> bool {
        var depth = 1
        while !self.at_end() && self.peek() != 10 {
            let c = self.peek()
            if c == 34 || c == 39 {
                if !self.skip_quoted(false) { return false }
            } else {
                self.advance()
                if c == 123 {
                    depth += 1
                } else if c == 125 {
                    depth -= 1
                    if depth == 0 { return true }
                }
            }
        }
        return false
    }

    // At a `{`, whether it begins a function's body: the tokens back to a
    // `fun` are its signature, with no line break, `;` or brace outside its
    // brackets (MYLA-359).
    #test(lexed("fun f<T>(p: P = P { x: [1] }) -> (int, [T]) "))[true]
    #test(lexed("impl<T> [T] "))[false]
    #test(lexed("fun f() -> int\nx"))[false]
    #test(lexed("fun f(p: P = P "))[false]
    fun body_ahead(self) -> bool {
        var depth = 0
        var i = self.toks.len() - 1
        while i >= 0 {
            let k = self.toks[i].kind
            if k == TokenKind.FUN { return depth == 0 }
            if k == TokenKind.RPAREN || k == TokenKind.RBRACKET {
                depth += 1
            } else if k == TokenKind.LPAREN || k == TokenKind.LBRACKET {
                depth -= 1
                if depth < 0 { return false }
            } else if depth == 0 && (k == TokenKind.NEWLINE || k == TokenKind.SEMI || k == TokenKind.LBRACE || k == TokenKind.RBRACE) {
                return false
            }
            i -= 1
        }
        return false
    }

    // At a function body's `{`: consume it to its `}` unlexed, over nested
    // brackets, strings, chars, f-strings with their holes and comments,
    // and emit the two braces, the `{` with its offset in `cps` (`ival`)
    // and the suffix "body", the `}` with the offset past it, for the
    // parser to keep (MYLA-359). Where a bracket doesn't close or closes
    // another, or a string doesn't end, nothing is consumed: the lexer and
    // the parser report it.
    #test(lexer_on("{ x }"))[true]
    #test(lexer_on("{ \"} }"))[false]
    fun skip_body(var self) -> bool {
        let p = self.pos
        let sl = self.line
        let sc = self.col
        // the checker keys a body by its place in one number (`body_key`)
        if sl >= 1048576 || sc >= 4096 { return false }
        if !self.skip_group() { return self.rewind(p, sl, sc) }
        let el = self.line
        let ec = self.col
        // each brace's token ends just past it, at the cursor
        self.line = sl
        self.col = sc + 1
        self.emit(TokenKind.LBRACE, "{", sl, sc, p as int64, "body")
        self.line = el
        self.col = ec
        self.emit(TokenKind.RBRACE, "}", el, ec - 1, self.pos as int64, "")
        return true
    }

    fun run(var self) -> [Token] {
        while !self.at_end() {
            let c = self.peek()
            if c == 10 {
                self.advance()
                self.emit_newline()
            } else if c == 32 || c == 9 || c == 13 {
                // a run of blanks at once: no line break among them
                // (MYLA-359: a method call a character was a tenth of a
                // check's lexing)
                var i = self.pos + 1
                while i < self.n && (self.cps[i] == ' ' || self.cps[i] == '\t' || self.cps[i] == '\r') { i += 1 }
                self.col = self.col + (i - self.pos)
                self.pos = i
            } else if c == 47 && self.peek1() == 47 {
                self.line_comment()
            } else if c == 47 && self.peek1() == 42 {
                self.block_comment()
            } else if c == 102 && self.peek1() == 34 {
                self.scan_fstring()
            } else if c == 34 {
                self.scan_string()
            } else if c == 39 {
                self.scan_char()
            } else if c == 35 && self.skip_tests && self.skip_test_attr() {
                // a `#test` case nothing runs, consumed unlexed
            } else if is_digit(c) {
                self.scan_number()
            } else if is_ident_start(c) {
                self.scan_identifier()
            } else if c == 123 && self.lazy && self.body_ahead() && self.skip_body() {
                // a function's body, read when it is needed (MYLA-359)
            } else {
                self.scan_operator()
            }
        }
        let has_trailing_nl = self.toks.len() > 0 && self.toks[self.toks.len() - 1].kind == TokenKind.NEWLINE
        if has_trailing_nl {
            self.toks.pop()
        }
        self.emit0(TokenKind.EOF, "", self.line, self.col)
        return self.toks
    }
}

// The tokens of `src`, or its first lex error.
#test("a")[Ok([Token { kind: TokenKind.IDENT, lexeme: "a", line: 1, column: 1, eline: 1, ecol: 2, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.EOF, lexeme: "", line: 1, column: 2, eline: 1, ecol: 2, ival: 0, suffix: "", big: "" }])]
#test("d2")[Ok([Token { kind: TokenKind.IDENT, lexeme: "d2", line: 1, column: 1, eline: 1, ecol: 3, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.EOF, lexeme: "", line: 1, column: 3, eline: 1, ecol: 3, ival: 0, suffix: "", big: "" }])]
#test("right")[Ok([Token { kind: TokenKind.IDENT, lexeme: "right", line: 1, column: 1, eline: 1, ecol: 6, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.EOF, lexeme: "", line: 1, column: 6, eline: 1, ecol: 6, ival: 0, suffix: "", big: "" }])]
pub fun lex(src: str) -> Result<[Token], Diag> {
    return lex_with(src, false)
}

// The tokens of `src`, its `#test` attributes left out when `skip_tests`
// (a module whose cases nothing runs, MYLA-359), or its first lex error.
#test("#test(1)[2]\nfun", true)[Ok([Token { kind: TokenKind.FUN, lexeme: "fun", line: 2, column: 1, eline: 2, ecol: 4, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.EOF, lexeme: "", line: 2, column: 4, eline: 2, ecol: 4, ival: 0, suffix: "", big: "" }])]
pub fun lex_with(src: str, skip_tests: bool) -> Result<[Token], Diag> {
    var lx = new_lexer(src)
    lx.skip_tests = skip_tests
    let toks = lx.run()
    return match lx.err {
        Some(e) => Err(e),
        None => Ok(toks),
    }
}

// The tokens of an implicit module's `src` (MYLA-359): its `#test`
// attributes left out and its functions' bodies skipped, each kept as its
// two braces (`skip_body`); with its code points, which `lex_part` lexes a
// body of. Or its first lex error.
#test("fun f() -> int { return 1 }")[Ok(["fun", "f", "(", ")", "->", "int", "{ 15 body", "} 27", ""])]
#test("trait T {\n    fun m(self) -> int\n}\n#test(1)[2]\nfun g(p: P = P { x: 1 }) {\n    x = \"}\" // }\n}")[Ok(["trait", "T", "{", "\\n", "fun", "m", "(", "self", ")", "->", "int", "\\n", "}", "\\n", "fun", "g", "(", "p", ":", "P", "=", "P", "{", "x", ":", "1", "}", ")", "{ 72 body", "} 92", ""])]
#test("fun f() { (] }")[Ok(["fun", "f", "(", ")", "{", "(", "]", "}", ""])]
#test("fun f() { 1 @ 2 }")[Ok(["fun", "f", "(", ")", "{ 8 body", "} 17", ""])]
fun lazy_shape(src: str) -> Result<[str], Diag> {
    let (toks, cps) = lex_lazy(src)?
    var out: [str] = []
    for t in toks {
        if t.suffix == "body" { out.push(format("{} {} body", t.lexeme, t.ival)) }
        else if t.kind == TokenKind.RBRACE && t.ival > 0 { out.push(format("{} {}", t.lexeme, t.ival)) }
        else { out.push(t.lexeme) }
    }
    return Ok(out)
}

pub fun lex_lazy(src: str) -> Result<([Token], [char]), Diag> {
    var lx = new_lexer(src)
    lx.skip_tests = true
    lx.lazy = true
    let toks = lx.run()
    return match lx.err {
        Some(e) => Err(e),
        None => Ok((toks, lx.cps)),
    }
}

// The tokens of `cps[start:end]`, which begins at `line`:`col` of its
// file: a function's body `lex_lazy` skipped, lexed as it would have been
// (MYLA-359). Or its first lex error, where it is in the file.
#test(['x', ' ', '{', ' ', 'a', '\n', '}', ' ', 'y'], 2, 7, 4, 3)[Ok([Token { kind: TokenKind.LBRACE, lexeme: "{", line: 4, column: 3, eline: 4, ecol: 4, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.IDENT, lexeme: "a", line: 4, column: 5, eline: 4, ecol: 6, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.NEWLINE, lexeme: "\\n", line: 5, column: 1, eline: 5, ecol: 1, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.RBRACE, lexeme: "}", line: 5, column: 1, eline: 5, ecol: 2, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.EOF, lexeme: "", line: 5, column: 2, eline: 5, ecol: 2, ival: 0, suffix: "", big: "" }])]
#test(['{', '@', '}'], 0, 3, 7, 9)[Err(Diag { kind: "lex error", line: 7, col: 10, sp: SrcSpan { sline: 7, scol: 10, eline: 7, ecol: 10 }, msg: "unexpected character '@'" })]
pub fun lex_part(cps: [char], start: int32, end: int32, line: int32, col: int32) -> Result<[Token], Diag> {
    var lx = Lexer { cps: cps, pos: start, line: line, col: col, n: end, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }
    let toks = lx.run()
    return match lx.err {
        Some(e) => Err(e),
        None => Ok(toks),
    }
}

// A lexer that has lexed `src`, without its EOF: the receiver of cases
// that look back at the tokens.
#test("")[Lexer { cps: [], pos: 0, line: 1, col: 1, n: 0, toks: [], err: None, opens: [], held: false, held_line: 0, held_col: 0, comment: "", qualified: false, skip_tests: false, lazy: false }]
fun lexed(src: str) -> Lexer {
    var lx = new_lexer(src)
    let toks = lx.run()
    let eof = lx.toks.pop()
    return lx
}

// The tokens of `src` whose identifiers may hold `$`, as the loader's
// qualified names do (`std$json$Json`): for source the checker writes
// against the linked program (`#derive(Json)`, MYLA-385).
#test("std$json$Json.Null")[Ok([Token { kind: TokenKind.IDENT, lexeme: "std$json$Json", line: 1, column: 1, eline: 1, ecol: 14, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.DOT, lexeme: ".", line: 1, column: 14, eline: 1, ecol: 15, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.IDENT, lexeme: "Null", line: 1, column: 15, eline: 1, ecol: 19, ival: 0, suffix: "", big: "" }, Token { kind: TokenKind.EOF, lexeme: "", line: 1, column: 19, eline: 1, ecol: 19, ival: 0, suffix: "", big: "" }])]
pub fun lex_qualified(src: str) -> Result<[Token], Diag> {
    var lx = new_lexer(src)
    lx.qualified = true
    let toks = lx.run()
    return match lx.err {
        Some(e) => Err(e),
        None => Ok(toks),
    }
}

// The decimal text of the literal `digits` in `base` if its value is 2^63 or
// more, else "" (MYLA-73). Short literals can't be that big, so only long ones
// pay for the base-10^9 arithmetic.
#test("0", 10)[""]
#test("1", 10)[""]
#test("10", 2)[""]
fun big_text(digits: str, base: int64) -> str {
    if digits.len() < 16 { return "" }
    var limbs: [int64] = [0]                 // little endian, base 10^9
    for ch in digits.chars() {
        var carry = digit_value(ch as int32) as int64
        var i = 0
        while i < limbs.len() {
            let x = limbs[i] * base + carry
            limbs[i] = x % 1000000000
            carry = x / 1000000000
            i = i + 1
        }
        while carry > 0 {
            limbs.push(carry % 1000000000)
            carry = carry / 1000000000
        }
    }
    var sb = StringBuilder()
    var top = limbs.len() - 1
    while top > 0 && limbs[top] == 0 { top = top - 1 }
    sb.append(format("{}", limbs[top]))
    var k = top - 1
    while k >= 0 {
        let part = format("{}", limbs[k])
        var pad = 9 - part.len()
        while pad > 0 {
            sb.append_byte('0')
            pad = pad - 1
        }
        sb.append(part)
        k = k - 1
    }
    let text = sb.build()
    if text.len() > 19 || (text.len() == 19 && !text_less(text, "9223372036854775808")) { return text }
    return ""
}

// `a < b` for decimal texts of the same length.
#test("4591870180066957722", "9223372036854775808")[true]
#test("4591870180174331904", "9223372036854775808")[true]
#test("9223372036854775808", "9223372036854775808")[false]
fun text_less(a: str, b: str) -> bool {
    var i = 0
    while i < a.len() {
        if a[i] != b[i] { return a[i] < b[i] }
        i = i + 1
    }
    return false
}

// `c` lowered if it is an ASCII capital letter.
#test(120)[120]
fun lower(c: int32) -> int32 {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

// `v` in upper-case hexadecimal, without a prefix.
#test(0)["0"]
#test(97)["61"]
#test(128512)["1F600"]
fun hex_upper(v: int64) -> str {
    if v == 0 { return "0" }
    var digits: [uint8] = []
    var x = v
    while x > 0 {
        let d = (x % 16) as uint8
        if d < 10 { digits.push(d + 48) } else { digits.push(d + 55) }
        x = x / 16
    }
    var sb = StringBuilder()
    var i = digits.len() - 1
    while i >= 0 {
        sb.append_byte(digits[i])
        i = i - 1
    }
    return sb.build()
}

// Where the format spec of a hole's text starts: its first `:` outside
// brackets and quotes (-1 for none), which no expression has, so
// `{m["a"]:>4}`, `{[1: 2].len()}` and a `:` as the fill (`{x::>8}`) are read
// as they are meant (D139).
#test("x:>8")[1]
#test("x::>8")[1]
#test("[1: 2].len()")[-1]
#test("m[\"a:b\"]:x")[8]
#test("f((a: int) => a)")[-1]
pub fun spec_colon(t: str) -> int32 {
    var depth = 0
    var quote: uint8 = 0
    var i = 0
    while i < t.len() {
        let c = t[i]
        if quote != 0 {
            if c == 92 { i = i + 1 } else if c == quote { quote = 0 }
        } else if c == 34 || c == 39 {
            quote = c
        } else if c == 40 || c == 91 || c == 123 {
            depth = depth + 1
        } else if c == 41 || c == 93 || c == 125 {
            depth = depth - 1
        } else if c == 58 && depth == 0 {
            return i
        }
        i = i + 1
    }
    return -1
}

#test("x}")[true]
#test(">8")[false]
fun has_brace(t: str) -> bool {
    for c in t.chars() { if c == '{' || c == '}' { return true } }
    return false
}
