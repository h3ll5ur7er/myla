// The value of an integer literal pattern that is not a value of `t`, as the
// error shows it, or "": a pattern has no arithmetic to wrap, so `-1` on
// `uint8` or `128` on `int8` could never match (MYLA-7). The literal check
// already bounds the magnitude by 2^(w-1) (signed) or 2^w - 1 (unsigned).
#test(Expr { id: 116, line: 51, col: 21, sp: SrcSpan { sline: 51, scol: 21, eline: 51, ecol: 24 }, kind: ExprKind.IntLit(97, None, true, "") }, Type.TChar)[""]
#test(Expr { id: 11, line: 18, col: 9, sp: SrcSpan { sline: 18, scol: 9, eline: 18, ecol: 10 }, kind: ExprKind.IntLit(0, None, false, "") }, Type.TInt(32, true))[""]
#test(Expr { id: 18, line: 22, col: 9, sp: SrcSpan { sline: 22, scol: 9, eline: 22, ecol: 10 }, kind: ExprKind.IntLit(1, None, false, "") }, Type.TInt(32, true))[""]
fun pattern_misfit(lit: Expr, t: Type) -> str {
    let w = int_width(t)
    if w == 0 { return "" }
    let signed = match t { Type.TInt(tw, ts) => ts, _ => false }
    match lit.kind {
        ExprKind.IntLit(v, suf, isc, big) => {
            if !signed { return "" }
            if big != "" || (w < 64 && v == (1i64 << ((w - 1) as int64))) { return int_text(v, big) }
            return ""
        },
        ExprKind.Unary(op, x) => {
            if signed || op != "-" { return "" }
            return negated_misfit(x)
        },
        _ => {},
    }
    return ""
}

// `-x` for an unsigned scrutinee: fine only for a zero literal.
#test(expr_of("-n * 2"))[""]
fun negated_misfit(x: Expr) -> str {
    match x.kind {
        ExprKind.IntLit(v, suf, isc, big) => {
            if v == 0 && big == "" { return "" }
            return "-" + int_text(v, big)
        },
        _ => {},
    }
    return ""
}


fun impl_eq_target_name(d: Decl) -> Option<str> {
    return impl_target_name(d, "Eq")
}

// The type an `impl <trnm> for T` declaration `d` is for, by name; none for
// another declaration.
fun impl_target_name(d: Decl, trnm: str) -> Option<str> {
    match d.kind {
        DeclKind.ImplDecl(tg, m, tp, tn, ta, dattrs) => {
            let is_eq = match tn { Some(t) => t == trnm, None => false }
            if !is_eq { return None }
            match tg.kind {
                TypeKind.TRef(nm, args) => { return Some(nm) },
                _ => {},
            }
            return None
        },
        _ => {},
    }
    return None
}

