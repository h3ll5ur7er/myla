// A list or map literal's element may leave type parameters open that a
// later element fixes (MYLA-401): `[Either.Left(1), Either.Right("a")]`,
// `[None, Some(2)]`, `[[], [1]]`. Until then such a parameter is a hole, a
// type parameter no program can name.
fun hole() -> Type { return Type.TParam("?") }

#test(Type.TEnum("Either", [Type.TInt(32, true), Type.TParam("?")]))[true]
#test(Type.TList(Type.TList(Type.TParam("?"))))[true]
#test(Type.TList(Type.TParam("T")))[false]
fun has_hole(t: Type) -> bool { return mentions_param(t, "?") }

#test(2)[[Type.TParam("?"), Type.TParam("?")]]
#test(0)[[]]
fun holes(n: int32) -> [Type] {
    var out: [Type] = []
    for i in 0..n { out.push(hole()) }
    return out
}

// The hint an element that can't take a partial type gets: none while the
// hint has a hole.
#test(Some(Type.TList(Type.TParam("?"))))[None]
#test(Some(Type.TStr))[Some(Type.TStr)]
#test(None)[None]
fun whole_hint(t: Option<Type>) -> Option<Type> {
    return match t {
        Some(x) => if has_hole(x) { None } else { Some(x) },
        None => None,
    }
}

// A type for messages, its holes as `_`.
#test(Type.TEnum("Either", [Type.TInt(32, true), Type.TParam("?")]))["Either<int32, _>"]
fun open_type_name(t: Type) -> str { return type_name(subst_type(t, [Subst { name: "?", ty: Type.TParam("_") }])) }

// Two elements' types as one: a hole in either takes the other's type
// there; None where they differ otherwise.
#test(Type.TEnum("Either", [Type.TInt(32, true), Type.TParam("?")]), Type.TEnum("Either", [Type.TParam("?"), Type.TStr]))[Some(Type.TEnum("Either", [Type.TInt(32, true), Type.TStr]))]
#test(Type.TList(Type.TParam("?")), Type.TList(Type.TEnum("Option", [Type.TParam("?")])))[Some(Type.TList(Type.TEnum("Option", [Type.TParam("?")])))]
#test(Type.TMap(Type.TStr, Type.TParam("?")), Type.TMap(Type.TStr, Type.TBool))[Some(Type.TMap(Type.TStr, Type.TBool))]
#test(Type.TEnum("Option", [Type.TInt(32, true)]), Type.TEnum("Option", [Type.TInt(64, true)]))[None]
#test(Type.TEnum("Option", [Type.TParam("?")]), Type.TStr)[None]
fun join_open(a: Type, b: Type) -> Option<Type> {
    if type_eq(a, b) { return Some(a) }
    if type_eq(a, hole()) { return Some(b) }
    if type_eq(b, hole()) { return Some(a) }
    match a {
        Type.TEnum(n1, a1) => { match b { Type.TEnum(n2, a2) => { if n1 == n2 { match join_open_list(a1, a2) { Some(js) => { return Some(Type.TEnum(n1, js)) }, None => {} } } }, _ => {} } },
        Type.TStruct(n1, a1) => { match b { Type.TStruct(n2, a2) => { if n1 == n2 { match join_open_list(a1, a2) { Some(js) => { return Some(Type.TStruct(n1, js)) }, None => {} } } }, _ => {} } },
        Type.TActor(n1, a1) => { match b { Type.TActor(n2, a2) => { if n1 == n2 { match join_open_list(a1, a2) { Some(js) => { return Some(Type.TActor(n1, js)) }, None => {} } } }, _ => {} } },
        Type.TList(e1) => { match b { Type.TList(e2) => { match join_open(e1, e2) { Some(j) => { return Some(Type.TList(j)) }, None => {} } }, _ => {} } },
        Type.TTuple(e1) => { match b { Type.TTuple(e2) => { match join_open_list(e1, e2) { Some(js) => { return Some(Type.TTuple(js)) }, None => {} } }, _ => {} } },
        Type.TMap(k1, v1) => { match b { Type.TMap(k2, v2) => { match join_open_list([k1, v1], [k2, v2]) { Some(js) => { return Some(Type.TMap(js[0], js[1])) }, None => {} } }, _ => {} } },
        _ => {},
    }
    return None
}

// One column of a list or map literal (its elements, a map's keys or its
// values) as its elements are checked: the type they share so far (`have`
// once one is), possibly with holes; the first element, where a mismatch is
// reported; `slot`, the column's lists in the checker's `col_open` (the
// elements whose own type had a hole, MYLA-401) and `col_lits` (its
// literals while nothing else fixes its type, L2); `fixed` once an element
// that isn't such a literal does.
struct LitColumn { ty: Type, have: bool, first: Expr, slot: int32, fixed: bool }

// Whether `t` holds an `Option` or a `Result` (D182, `prelude_need`).
#test(Type.TTuple([Type.TStr, Type.TEnum("Option", [Type.TStr])]))[true]
#test(Type.TMap(Type.TStruct("Box", [Type.TEnum("Result", [Type.TStr, Type.TBool])]), Type.TStr))[true]
#test(Type.TList(Type.TEnum("Shape", [])))[false]
fun holds_prelude_enum(t: Type) -> bool {
    return match t {
        Type.TEnum(n, args) => n == "Option" || n == "Result" || holds_prelude_enum_in(args),
        Type.TStruct(n, args) => holds_prelude_enum_in(args),
        Type.TActor(n, args) => holds_prelude_enum_in(args),
        Type.TTuple(es) => holds_prelude_enum_in(es),
        Type.TList(e) => holds_prelude_enum(e),
        Type.TMap(k, v) => holds_prelude_enum(k) || holds_prelude_enum(v),
        _ => false,
    }
}

fun holds_prelude_enum_in(ts: [Type]) -> bool {
    for t in ts { if holds_prelude_enum(t) { return true } }
    return false
}

// Whether the element `e` is a literal that takes the type its column gets
// later (L2): an integer, float or char literal without a suffix, or one of
// the first two negated.
#test(expr_of("300"))[true]
#test(expr_of("-1"))[true]
#test(expr_of("'a'"))[true]
#test(expr_of("3u8"))[false]
#test(expr_of("x"))[false]
#test(expr_of("-x"))[false]
fun adapts(e: Expr) -> bool {
    return match e.kind {
        ExprKind.IntLit(v, suf, isc, big) => match suf { Some(x) => false, None => true },
        ExprKind.FloatLit(lex, suf) => is_flexible_float_lit(e),
        ExprKind.Unary(op, x) => op == "-" && (is_flexible_float_lit(x) || match x.kind { ExprKind.IntLit(v, suf, isc, big) => !isc && is_flexible_int_lit(x), _ => false }),
        _ => false,
    }
}

// A hint that is a hole says nothing.
#test(Some(Type.TParam("?")))[None]
#test(Some(Type.TList(Type.TParam("?"))))[Some(Type.TList(Type.TParam("?")))]
fun drop_hole(t: Option<Type>) -> Option<Type> {
    return match t {
        Some(x) => if type_eq(x, hole()) { None } else { Some(x) },
        None => None,
    }
}

#test([Type.TParam("?"), Type.TStr], [Type.TBool, Type.TParam("?")])[Some([Type.TBool, Type.TStr])]
#test([Type.TStr], [Type.TBool])[None]
fun join_open_list(xs: [Type], ys: [Type]) -> Option<[Type]> {
    if xs.len() != ys.len() { return None }
    var out: [Type] = []
    var i = 0
    while i < xs.len() {
        match join_open(xs[i], ys[i]) {
            Some(j) => out.push(j),
            None => { return None },
        }
        i += 1
    }
    return Some(out)
}

