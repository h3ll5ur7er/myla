// checker.my - the Myla static type checker (mirror of src/myla/types.py),
// self-hosting v0.7.
//
// A type error is a `CheckErr` (position, the range of the node it is about
// (MYLA-65), and the Python checker's message, with types written by
// `type_name` as types.py does), threaded through
// `Result<_, CheckErr>` and propagated with `?`. The phase order and
// within-phase iteration order mirror types.py exactly, so the *first* error
// is the oracle's: same position, same message (MYLA-28). An error while
// building the tables ends the check; after that each function's attributes
// and each body are checked on their own, and the first error of each is
// collected, up to MAX_ERRORS: the same errors in the same order as types.py
// (MYLA-65, D80).

from .parser import parse_source, parse_qualified, Parsed, expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of, is_let_else_marker
from .ast import int_text, is_unread_body
from .util import format_specs
from std.fmt import parse_spec, spec_need
from .ast import Program, Decl, DeclKind, FunData, Param, TypeParam, Field, Variant
from .ast import Attribute, TypeExpr, TypeKind, Expr, ExprKind, FieldInit, MapEntry
from .ast import Stmt, StmtKind, Block, ElseTail, BindElem, ExprOrBlock
from .ast import Pattern, PatternKind, FieldPat, MatchArm, Expected, failure_callee, expected_failure, call_targs
from .tokens import Note, SrcSpan, no_span, MAX_ERRORS

// =========================================================================
// Types
// =========================================================================

pub enum Type {
    TInt(int32, bool),            // width (8/16/32/64), signed
    TFloat(int32),                // width (32/64)
    TChar,
    TBool,
    TStr,
    TSB,                          // StringBuilder
    TStruct(str, [Type]),         // name, type args
    TEnum(str, [Type]),           // name, type args
    TTuple([Type]),
    TList(Type),
    TMap(Type, Type),
    TFunc([Type], Option<Type>),  // params, return (None = void)
    // an async function type (D89; types.py: FuncType.is_async), a TFunc
    // inside: a separate variant keeps every other type as small as before
    TAsync(Type),
    // an actor's handle (D89): a reference to its state, which only its own
    // methods reach; its fields are those of the struct it is declared like;
    // name, type args (MYLA-386)
    TActor(str, [Type]),
    TParam(str),
    TSelf,
    // the type of a declaration's part that failed to check (MYLA-110, D84;
    // types.py: ErrorType)
    TError,
    // an address, a kind of the IR's temporaries only (D121)
    TPtr,
}

// A type error: position, the range it underlines (that of the node it is
// about, MYLA-65), the Python checker's message, and the id of the declaration
// being checked, whose module is the error's file (-1: unknown).
pub struct CheckErr { line: int32, col: int32, sp: SrcSpan, msg: str, decl: int32, notes: [Note] }

// Where a declaration of the standard library comes from: its module
// (`std.str`) and file, as the loader found them, and whether the module is
// one every program sees without an import (MYLA-320).
pub struct DeclOrigin { module: str, path: str, implicit: bool }

// The functions' bodies the loader left unparsed (MYLA-359): an implicit
// module's, each an empty block until the checker first checks it. `ids`
// are their declarations (an impl, for a method), `keys` the bodies
// (`body_key`), and `parse` reads one, lexed, parsed and renamed as the
// rest of its module was. Its errors are a lex, parse or module error's:
// each message starts with its kind (`parse error: …`, `kind_of`).
pub struct LazyBodies { ids: [int32: bool], keys: [int64: bool], parse: (int64) -> Result<Block, [CheckErr]> }

// No body left unparsed: a program loaded whole.
pub fun no_lazy_bodies() -> LazyBodies {
    return LazyBodies { ids: [:], keys: [:], parse: no_body }
}

#test(7)[Err([CheckErr { line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "internal error: no body 7 to read", decl: -1, notes: [] }])]
fun no_body(key: int64) -> Result<Block, [CheckErr]> {
    return Err([terr(0, 0, f"internal error: no body {key} to read")])
}

// The key of the body whose `{` is at `line`:`col`, of a function of the
// declaration `id` (a method's: its impl's), in `LazyBodies.keys`: the
// three in one number, a line below 2^20 and a column below 2^12 (the
// lexer leaves a body whose `{` is past them unskipped).
#test(7, 3, 5)[30064783365]
#test(0, 1048575, 4095)[4294967295]
pub fun body_key(id: int32, line: int32, col: int32) -> int64 {
    return ((id as int64) << 32) | ((line as int64) << 12) | (col as int64)
}

// The key of `fd`'s body (`body_key`), a function of the declaration `id`,
// if it is the marker of a body the loader left unread (`is_unread_body`):
// by the place of its `{`, which the lexer tested against the limits, not
// its `fun`'s, which may be past them on a line before (MYLA-416).
#test(0, fun_of("fun f() { }"))[None]
pub fun unread_key(id: int32, fd: FunData) -> Option<int64> {
    return match fd.body {
        Some(b) => if is_unread_body(b) { Some(body_key(id, b.line, b.col)) } else { None },
        None => None,
    }
}

// An error at a position without a range (one caret).
#test(27, 27, "x")[CheckErr { line: 27, col: 27, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "x", decl: -1, notes: [] }]
#test(50, 50, "d2")[CheckErr { line: 50, col: 50, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "d2", decl: -1, notes: [] }]
#test(108, 108, "left")[CheckErr { line: 108, col: 108, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "left", decl: -1, notes: [] }]
fun terr(line: int32, col: int32, msg: str) -> CheckErr { return terr_at(line, col, no_span(), msg) }

#test(3, 13, SrcSpan { sline: 3, scol: 13, eline: 3, ecol: 14 }, "unknown name 'y'")[CheckErr { line: 3, col: 13, sp: SrcSpan { sline: 3, scol: 13, eline: 3, ecol: 14 }, msg: "unknown name 'y'", decl: -1, notes: [] }]
#test(11, 15, SrcSpan { sline: 11, scol: 15, eline: 11, ecol: 19 }, "unknown type 'Nope'")[CheckErr { line: 11, col: 15, sp: SrcSpan { sline: 11, scol: 15, eline: 11, ecol: 19 }, msg: "unknown type 'Nope'", decl: -1, notes: [] }]
#test(6, 10, SrcSpan { sline: 6, scol: 5, eline: 6, ecol: 16 }, "unknown function 'pirnt'")[CheckErr { line: 6, col: 10, sp: SrcSpan { sline: 6, scol: 5, eline: 6, ecol: 16 }, msg: "unknown function 'pirnt'", decl: -1, notes: [] }]
fun terr_at(line: int32, col: int32, sp: SrcSpan, msg: str) -> CheckErr { return CheckErr { line: line, col: col, sp: sp, msg: msg, decl: -1, notes: [] } }

// `e` with the notes `ns` (MYLA-65).
fun with_notes(e: CheckErr, ns: [Note]) -> CheckErr {
    var r = e
    r.notes = ns
    return r
}

// A note about the place `line`, `col`, `sp` (errors.py: note).
#test("'p' is declared here", 9, 7, SrcSpan { sline: 9, scol: 7, eline: 9, ecol: 11 })[Note { label: "note", msg: "'p' is declared here", line: 9, col: 7, sp: SrcSpan { sline: 9, scol: 7, eline: 9, ecol: 11 } }]
#test("it is handed over here", 11, 22, SrcSpan { sline: 11, scol: 18, eline: 11, ecol: 26 })[Note { label: "note", msg: "it is handed over here", line: 11, col: 22, sp: SrcSpan { sline: 11, scol: 18, eline: 11, ecol: 26 } }]
#test("'total' is first declared here", 6, 5, SrcSpan { sline: 6, scol: 5, eline: 6, ecol: 18 })[Note { label: "note", msg: "'total' is first declared here", line: 6, col: 5, sp: SrcSpan { sline: 6, scol: 5, eline: 6, ecol: 18 } }]
fun note_at(msg: str, line: int32, col: int32, sp: SrcSpan) -> Note {
    return Note { label: "note", msg: msg, line: line, col: col, sp: sp }
}

// The edits that turn `a` into `b`, counted on their bytes: inserting, deleting
// or replacing a byte, or swapping two neighbours (types.py: _edit_distance).
#test("count", "count")[0]
#test("cuont", "count")[1]
#test("cont", "count")[1]
#test("kitten", "sitting")[3]
#test("", "abc")[3]
#test("ca", "abc")[3]
#test("o", "ö")[2]
fun edit_distance(a: str, b: str) -> int32 {
    let n = a.len() as int32
    let m = b.len() as int32
    var prev2: [int32] = []
    var prev: [int32] = []
    var j = 0
    while j <= m {
        prev.push(j)
        j = j + 1
    }
    var i = 1
    while i <= n {
        var cur: [int32] = [i]
        j = 1
        while j <= m {
            var cost = 1
            if a[i - 1] == b[j - 1] { cost = 0 }
            var d = prev[j] + 1
            if cur[j - 1] + 1 < d { d = cur[j - 1] + 1 }
            if prev[j - 1] + cost < d { d = prev[j - 1] + cost }
            if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] {
                if prev2[j - 2] + 1 < d { d = prev2[j - 2] + 1 }
            }
            cur.push(d)
            j = j + 1
        }
        prev2 = prev
        prev = cur
        i = i + 1
    }
    return prev[m]
}

// Whether `a` sorts before `b`, byte by byte (the order of Python's strings).
#test("abcd", "abce")[true]
#test("abc", "ab")[false]
#test("ab", "abc")[true]
#test("b", "b")[false]
fun str_before(a: str, b: str) -> bool {
    var i = 0
    while i < a.len() && i < b.len() {
        if a[i] != b[i] { return a[i] < b[i] }
        i = i + 1
    }
    return a.len() < b.len()
}

// Whether `name` is internal to the toolchain: a method's `Key.name` or a
// `__` primitive.
#test("T")[false]
#test("n")[false]
#test("Box.label")[true]
fun is_internal_name(name: str) -> bool {
    if name.len() >= 2 && name[0] == '_' && name[1] == '_' { return true }
    for c in name.chars() { if c == '.' { return true } }
    return false
}

// A help line naming the candidate closest to `name`, if one is within a third
// of its length in edits; the alphabetically first of equally close ones
// (types.py: _did_you_mean).
#test("cuont", ["count", "x"])[[Note { label: "help", msg: "did you mean 'count'?", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }]]
#test("abcf", ["abce", "abcd"])[[Note { label: "help", msg: "did you mean 'abcd'?", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }]]
#test("y", ["x"])[[]]
#test("__exti", ["__exit"])[[]]
fun did_you_mean(name: str, cands: [str]) -> [Note] {
    let limit = (name.len() as int32) / 3
    var best = ""
    var best_d = -1
    for c in cands {
        if c == name || is_internal_name(c) { continue }
        let d = edit_distance(name, c)
        if d <= limit && (best_d < 0 || d < best_d || (d == best_d && str_before(c, best))) {
            best = c
            best_d = d
        }
    }
    if best_d < 0 { return [] }
    return [Note { label: "help", msg: format("did you mean '{}'?", best), line: 0, col: 0, sp: no_span() }]
}

// The notes of an unknown function `name`: for `get`, the method that took
// the place of the prelude's free `get(m, k)` (MYLA-393); for any other
// name, the closest of `cands`.
#test("get", ["got"])[[Note { label: "help", msg: "a map's lookup is the method 'm.get(k)', not a function", line: 0, col: 0, sp: no_span() }]]
#test("pirnt", ["print"])[[Note { label: "help", msg: "did you mean 'print'?", line: 0, col: 0, sp: no_span() }]]
fun unknown_function_notes(name: str, cands: [str]) -> [Note] {
    if name == "get" { return [Note { label: "help", msg: "a map's lookup is the method 'm.get(k)', not a function", line: 0, col: 0, sp: no_span() }] }
    return did_you_mean(name, cands)
}

// The names of the primitive types, as types.py's _PRIMITIVES has them.
#test()[["bool", "str", "StringBuilder", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "char"]]
fun primitive_type_names() -> [str] {
    return ["bool", "str", "StringBuilder", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "char"]
}

// The names of the built-in functions (types.py: _BUILTIN_FUNCS, without the
// `__` primitives, which are never suggested).
#test()[["print", "assert", "panic", "unreachable", "len", "push", "pop", "contains", "remove", "keys", "format", "chars", "StringBuilder", "append", "append_byte", "append_char", "build"]]
fun builtin_func_names() -> [str] {
    return ["print", "assert", "panic", "unreachable", "len", "push", "pop", "contains", "remove", "keys", "format", "chars", "StringBuilder", "append", "append_byte", "append_char", "build"]
}

#test([FieldT { name: "x", ty: Type.TInt(32, true) }, FieldT { name: "y", ty: Type.TInt(32, true) }])[["x", "y"]]
#test([FieldT { name: "width", ty: Type.TInt(32, true) }, FieldT { name: "height", ty: Type.TInt(32, true) }])[["width", "height"]]
fun field_names(fields: [FieldT]) -> [str] {
    var out: [str] = []
    for f in fields { out.push(f.name) }
    return out
}

// Whether an index is a slice, `a:b` or `a:b:step` (D142).
#test(expr_of("x"))[false]
pub fun is_slice_expr(e: Expr) -> bool {
    return match e.kind { ExprKind.Binary(op, l, r) => op == ":", _ => false }
}

// What `^n` counts from the end (D142), for an index or a bound that is one.
#test(expr_of("x"))[None]
pub fun from_end_of(e: Expr) -> Option<Expr> {
    return match e.kind {
        ExprKind.Unary(op, x) => if op == "^" { Some(x) } else { None },
        _ => None,
    }
}

// A slice's parts (D142): its start and stop (a `Hole` when left out, a
// `^n` for one counted from the end), and its step (a `Hole` for none).
pub struct SliceParts { start: Expr, stop: Expr, step: Expr }

pub fun slice_parts(e: Expr) -> SliceParts {
    match e.kind {
        ExprKind.Binary(op, l, r) => {
            match l.kind {
                ExprKind.Binary(op2, a, b) => { if op2 == ":" { return SliceParts { start: a, stop: b, step: r } } },
                _ => {},
            }
            return SliceParts { start: l, stop: r, step: Expr { id: -1, line: e.line, col: e.col, sp: e.sp, kind: ExprKind.Hole } }
        },
        _ => {},
    }
    return SliceParts { start: e, stop: e, step: e }
}

// Whether `e` is a part left out (a `Hole`).
pub fun is_hole_part(e: Expr) -> bool {
    return match e.kind { ExprKind.Hole => true, _ => false }
}

// Whether `e` is a call (whose value, without a result, is `()`, D140).
#test(expr_of("f(1)"))[true]
#test(expr_of("x"))[false]
fun is_call_expr(e: Expr) -> bool {
    return match e.kind { ExprKind.Call(c, args, _) => true, _ => false }
}

// A function's result written as `t`: none for `()`, the same thing (D140).
#test(Type.TTuple([]))[None]
#test(Type.TBool)[Some(Type.TBool)]
pub fun result_of(t: Type) -> Option<Type> {
    if is_unit(t) { return None }
    return Some(t)
}

// Whether `t` is the unit type `()`, the 0-tuple (D138).
#test(Type.TTuple([]))[true]
#test(Type.TTuple([Type.TBool]))[false]
#test(Type.TBool)[false]
pub fun is_unit(t: Type) -> bool {
    return match t {
        Type.TTuple(es) => es.len() == 0,
        _ => false,
    }
}

// A type as the Python checker's messages write it (types.py: type_name).
#test(Type.TStr)["str"]
#test(Type.TStruct("Rect", []))["Rect"]
#test(Type.TFunc([Type.TInt(32, true), Type.TInt(32, true)], Some(Type.TInt(32, true))))["(int32, int32) -> int32"]
#test(Type.TActor("Cell", [Type.TStr]))["Cell<str>"]
pub fun type_name(t: Type) -> str {
    return match t {
        Type.TInt(w, signed) => format("{}{}", if_str(signed, "int", "uint"), w),
        Type.TFloat(w) => format("float{}", w),
        Type.TChar => "char",
        Type.TBool => "bool",
        Type.TStr => "str",
        Type.TSB => "StringBuilder",
        Type.TStruct(n, args) => generic_name(n, args),
        Type.TActor(n, args) => generic_name(n, args),
        Type.TEnum(n, args) => generic_name(n, args),
        Type.TParam(n) => n,
        Type.TSelf => "Self",
        Type.TTuple(es) => format("({}{})", type_names(es), if_str(es.len() == 1, ",", "")),
        Type.TList(e) => format("[{}]", type_name(e)),
        Type.TMap(k, v) => format("[{}: {}]", type_name(k), type_name(v)),
        Type.TFunc(ps, r) => format("({}) -> {}", type_names(ps), opt_type_name(r)),
        Type.TAsync(f) => "async " + type_name(f),
        Type.TError => "{error}",
        Type.TPtr => "ptr",
    }
}

// Whether `t` is or contains the error type (types.py: _has_error).
#test(Type.TSB)[false]
#test(Type.TStr)[false]
#test(Type.TError)[true]
#test(Type.TActor("Cell", [Type.TError]))[true]
fun has_error(t: Type) -> bool {
    return match t {
        Type.TError => true,
        Type.TStruct(n, a) => list_has_error(a),
        Type.TActor(n, a) => list_has_error(a),
        Type.TEnum(n, a) => list_has_error(a),
        Type.TTuple(es) => list_has_error(es),
        Type.TList(e) => has_error(e),
        Type.TMap(k, v) => has_error(k) || has_error(v),
        Type.TFunc(ps, r) => list_has_error(ps) || opt_has_error(r),
        Type.TAsync(f) => has_error(f),
        _ => false,
    }
}

#test([])[false]
#test([Type.TStr])[false]
#test([Type.TBool])[false]
fun list_has_error(ts: [Type]) -> bool {
    for t in ts { if has_error(t) { return true } }
    return false
}

#test(None)[false]
#test(Some(Type.TSB))[false]
#test(Some(Type.TError))[true]
fun opt_has_error(t: Option<Type>) -> bool {
    return match t { Some(x) => has_error(x), None => false }
}

#test([], Some(Type.TStr))[false]
#test([], Some(Type.TBool))[false]
#test([Type.TStruct("Sq", [])], Some(Type.TError))[true]
fun sig_has_error(ps: [Type], r: Option<Type>) -> bool {
    return list_has_error(ps) || opt_has_error(r)
}

// What a check returns when what it checks depends on the error type: it
// ends without an error, which would follow from an earlier one (types.py:
// _Poisoned). `?` carries it like an error; the driver drops it.
#test()[CheckErr { line: -1, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "", decl: -1, notes: [] }]
fun poisoned() -> CheckErr {
    return CheckErr { line: -1, col: 0, sp: no_span(), msg: "", decl: -1, notes: [] }
}

#test(CheckErr { line: -1, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "", decl: -1, notes: [] })[true]
#test(CheckErr { line: 3, col: 13, sp: SrcSpan { sline: 3, scol: 13, eline: 3, ecol: 14 }, msg: "unknown name 'y'", decl: -1, notes: [] })[false]
#test(CheckErr { line: 3, col: 10, sp: SrcSpan { sline: 3, scol: 10, eline: 3, ecol: 14 }, msg: "unknown type 'Nope'", decl: -1, notes: [] })[false]
fun is_poisoned(e: CheckErr) -> bool { return e.line == -1 && e.msg == "" }

// What the declaration phases return when MAX_ERRORS errors are collected:
// the check ends (types.py: _Stop).
#test()[CheckErr { line: -2, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "", decl: -1, notes: [] }]
fun stopped() -> CheckErr {
    return CheckErr { line: -2, col: 0, sp: no_span(), msg: "", decl: -1, notes: [] }
}

#test(CheckErr { line: -1, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "", decl: -1, notes: [] })[false]
#test(CheckErr { line: 3, col: 10, sp: SrcSpan { sline: 3, scol: 10, eline: 3, ecol: 14 }, msg: "unknown type 'Nope'", decl: -1, notes: [] })[false]
#test(CheckErr { line: 6, col: 23, sp: SrcSpan { sline: 6, scol: 23, eline: 6, ecol: 27 }, msg: "unknown type 'Nope'", decl: -1, notes: [] })[false]
fun is_stopped(e: CheckErr) -> bool { return e.line == -2 && e.msg == "" }

// `None` (no value) is written `()`.
#test(Some(Type.TStr))["str"]
#test(Some(Type.TInt(32, true)))["int32"]
fun opt_type_name(t: Option<Type>) -> str {
    return match t { Some(x) => type_name(x), None => "()" }
}

#test([Type.TStr])["str"]
#test([Type.TInt(32, true)])["int32"]
#test([Type.TInt(32, true), Type.TInt(32, true)])["int32, int32"]
fun type_names(ts: [Type]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < ts.len() {
        if i > 0 { sb.append(", ") }
        sb.append(type_name(ts[i]))
        i = i + 1
    }
    return sb.build()
}

#test("P", [])["P"]
#test("Rect", [])["Rect"]
#test("Counter", [])["Counter"]
fun generic_name(n: str, args: [Type]) -> str {
    if args.len() == 0 { return n }
    return format("{}<{}>", n, type_names(args))
}

#test(["b"], ", ")["b"]
#test(["Rect"], ", ")["Rect"]
fun join_strs(xs: [str], sep: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < xs.len() {
        if i > 0 { sb.append(sep) }
        sb.append(xs[i])
        i = i + 1
    }
    return sb.build()
}

// Byte-wise `a < b` (Python's order for ASCII names).
#test("a", "a")[false]
#test("x", "x")[false]
#test("y", "y")[false]
fun str_less(a: str, b: str) -> bool {
    var i = 0
    while i < a.len() && i < b.len() {
        if a[i] != b[i] { return a[i] < b[i] }
        i = i + 1
    }
    return a.len() < b.len()
}

#test(["b"])[["b"]]
fun sorted_strs(xs: [str]) -> [str] {
    var out: [str] = []
    for x in xs {
        var k = out.len()
        out.push(x)
        while k > 0 && str_less(x, out[k - 1]) {
            out[k] = out[k - 1]
            k = k - 1
        }
        out[k] = x
    }
    return out
}

#test(false, ",", "")[""]
#test(true, "Result", "")["Result"]
#test(true, " (or '#derive(Eq)')", "")[" (or '#derive(Eq)')"]
fun if_str(c: bool, a: str, b: str) -> str {
    if c { return a }
    return b
}

// type constructors / constants
#test()[Type.TInt(32, true)]
fun t_int() -> Type { return Type.TInt(32, true) }
#test()[Type.TInt(8, false)]
fun t_byte() -> Type { return Type.TInt(8, false) }
// `float`, and a float literal without a suffix: a double (D102, MYLA-220;
// D19 made it `float32`)
#test()[Type.TFloat(64)]
fun t_float() -> Type { return Type.TFloat(64) }

// --- equality ------------------------------------------------------------

#test([], [])[true]
#test([Type.TStr], [Type.TStr])[true]
#test([Type.TInt(32, true)], [Type.TStr])[false]
fun type_list_eq(a: [Type], b: [Type]) -> bool {
    if a.len() != b.len() { return false }
    var i = 0
    while i < a.len() {
        if !type_eq(a[i], b[i]) { return false }
        i = i + 1
    }
    return true
}

// What `become` passes freely (D87), and what lives in a frame, so it must be
// (a part of) a parameter; a type parameter may stand for either.
#test(Type.TStr)[false]
#test(Type.TInt(32, true))[true]
#test(Type.TStruct("Named", []))[false]
fun is_scalar_type(t: Type) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TFloat(w) => true,
        Type.TChar => true,
        Type.TBool => true,
        _ => false,
    }
}

#test(Type.TStr)[false]
#test(Type.TStruct("Named", []))[true]
#test(Type.TStruct("Point", []))[true]
fun is_frame_value(t: Type) -> bool {
    return match t {
        Type.TStruct(n, a) => true,
        Type.TTuple(es) => true,
        Type.TEnum(n, a) => true,
        Type.TFunc(ps, r) => true,
        Type.TAsync(f) => true,
        Type.TParam(n) => true,
        Type.TSelf => true,
        _ => false,
    }
}

// The type `e?` expects of `e` when `expected` is expected of `e?` in a
// function returning `ret` (MYLA-315's follow-up): `Result<X, E>` in one
// returning `Result<_, E>`, `Option<X>` in one returning an `Option`, so
// `let a: B<int> = try_mk(ok)?` solves `try_mk`'s `T`.
#test(Some(Type.TStr), Some(Type.TEnum("Result", [Type.TBool, Type.TChar])))[Some(Type.TEnum("Result", [Type.TStr, Type.TChar]))]
#test(Some(Type.TStr), Some(Type.TEnum("Option", [Type.TBool])))[Some(Type.TEnum("Option", [Type.TStr]))]
#test(None, Some(Type.TEnum("Option", [Type.TBool])))[None]
#test(Some(Type.TStr), Some(Type.TBool))[None]
fun try_hint(expected: Option<Type>, ret: Option<Type>) -> Option<Type> {
    let x = match expected {
        Some(t) => t,
        None => { return None },
    }
    return match ret {
        Some(Type.TEnum(rn, rargs)) => {
            if rn == "Result" && rargs.len() == 2 { Some(Type.TEnum("Result", [x, rargs[1]])) }
            else if rn == "Option" && rargs.len() == 1 { Some(Type.TEnum("Option", [x])) }
            else { None }
        },
        _ => None,
    }
}

// A place as the program writes it (`c`, `a.b`, `p.0`), `x` for any other
// expression.
#test(expr_of("a.b.0"))["a.b.0"]
#test(expr_of("f(x)"))["x"]
#test(expr_of("self.c"))["self.c"]
fun place_text(e: Expr) -> str {
    return match e.kind {
        ExprKind.Name(n) => n,
        ExprKind.GetField(t, f) => place_text(t) + "." + f,
        ExprKind.TupleIndex(t, i) => f"{place_text(t)}.{i}",
        _ => "x",
    }
}

// The variable a place expression (`a.b[i].c`) is a part of ("": none).
#test(Expr { id: 6, line: 8, col: 14, sp: SrcSpan { sline: 8, scol: 14, eline: 8, ecol: 15 }, kind: ExprKind.Name("s") })["s"]
#test(Expr { id: 9, line: 9, col: 14, sp: SrcSpan { sline: 9, scol: 14, eline: 9, ecol: 15 }, kind: ExprKind.Name("p") })["p"]
fun root_name(e: Expr) -> str {
    return match e.kind {
        ExprKind.GetField(t, f) => root_name(t),
        ExprKind.TupleIndex(t, i) => root_name(t),
        ExprKind.Index(t, i) => root_name(t),
        ExprKind.Name(n) => n,
        _ => "",
    }
}

// The argument words that travel in registers (D119, System V on x86-64).
pub const REG_ARG_WORDS: int32 = 6

// Whether `t` is a built-in value type that takes impls (MYLA-221): a
// number, `bool`, `char`, `str`, `StringBuilder`, a list or a map; not a
// struct, enum, tuple or actor handle (D144).
#test(Type.TList(Type.TStr))[true]
#test(Type.TActor("A", []))[false]
#test(Type.TStruct("P", []))[false]
pub fun is_builtin_value(t: Type) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TFloat(w) => true,
        Type.TChar => true,
        Type.TBool => true,
        Type.TStr => true,
        Type.TSB => true,
        Type.TList(e) => true,
        Type.TMap(k, v) => true,
        _ => false,
    }
}

// Whether `t` is passed by its address, or its words by value: a struct,
// tuple, enum or function value.
#test(Type.TTuple([]))[true]
#test(Type.TStr)[false]
fun is_aggregate_type(t: Type) -> bool {
    return match t {
        Type.TStruct(n, a) => true,
        Type.TTuple(es) => true,
        Type.TEnum(n, a) => true,
        Type.TFunc(ps, r) => true,
        Type.TAsync(f) => true,
        _ => false,
    }
}

// The substitution of `args` for the type parameters `params`.
fun subst_of(params: [str], args: [Type]) -> [Subst] {
    var sub: [Subst] = []
    var i = 0
    while i < params.len() && i < args.len() {
        sub.push(Subst { name: params[i], ty: args[i] })
        i = i + 1
    }
    return sub
}

fun max_int(a: int32, b: int32) -> int32 {
    if a > b { return a }
    return b
}

#test(Type.TStr)[false]
#test(Type.TInt(32, true))[false]
#test(Type.TFunc([Type.TInt(32, true)], Some(Type.TStr)))[true]
fun is_tfunc_type(t: Type) -> bool {
    return match t {
        Type.TFunc(ps, r) => true,
        Type.TAsync(f) => true,
        _ => false,
    }
}

fun sig_mutates(sig: FuncSig) -> bool {
    return sig.has_decl && match sig.decl.receiver { Some(r) => r == "var self", None => false }
}

#test(Some(Type.TInt(32, true)))["'int32'"]
#test(Some(Type.TInt(64, true)))["'int64'"]
fun quoted_or_nothing(t: Option<Type>) -> str {
    return match t { Some(x) => format("'{}'", type_name(x)), None => "nothing" }
}

#test(None, None)[true]
#test(Some(Type.TStr), Some(Type.TStr))[true]
#test(Some(Type.TInt(32, true)), Some(Type.TInt(64, true)))[false]
fun opt_type_eq(a: Option<Type>, b: Option<Type>) -> bool {
    return match a {
        Some(x) => match b { Some(y) => type_eq(x, y), None => false },
        None => match b { Some(y) => false, None => true },
    }
}

#test(Type.TStr, Type.TStr)[true]
#test(Type.TBool, Type.TBool)[true]
#test(Type.TBool, Type.TStr)[false]
#test(Type.TActor("Cell", [Type.TInt(32, true)]), Type.TActor("Cell", [Type.TInt(32, true)]))[true]
#test(Type.TActor("Cell", [Type.TInt(32, true)]), Type.TActor("Cell", [Type.TStr]))[false]
#test(Type.TActor("Cell", [Type.TInt(32, true)]), Type.TStruct("Cell", [Type.TInt(32, true)]))[false]
fun type_eq(a: Type, b: Type) -> bool {
    return match a {
        Type.TInt(w1, s1) => match b { Type.TInt(w2, s2) => w1 == w2 && s1 == s2, _ => false },
        Type.TFloat(w1) => match b { Type.TFloat(w2) => w1 == w2, _ => false },
        Type.TChar => match b { Type.TChar => true, _ => false },
        Type.TBool => match b { Type.TBool => true, _ => false },
        Type.TStr => match b { Type.TStr => true, _ => false },
        Type.TSB => match b { Type.TSB => true, _ => false },
        Type.TStruct(n1, a1) => match b { Type.TStruct(n2, a2) => n1 == n2 && type_list_eq(a1, a2), _ => false },
        Type.TActor(n1, a1) => match b { Type.TActor(n2, a2) => n1 == n2 && type_list_eq(a1, a2), _ => false },
        Type.TEnum(n1, a1) => match b { Type.TEnum(n2, a2) => n1 == n2 && type_list_eq(a1, a2), _ => false },
        Type.TTuple(e1) => match b { Type.TTuple(e2) => type_list_eq(e1, e2), _ => false },
        Type.TList(e1) => match b { Type.TList(e2) => type_eq(e1, e2), _ => false },
        Type.TMap(k1, v1) => match b { Type.TMap(k2, v2) => type_eq(k1, k2) && type_eq(v1, v2), _ => false },
        Type.TFunc(p1, r1) => match b { Type.TFunc(p2, r2) => type_list_eq(p1, p2) && opt_type_eq(r1, r2), _ => false },
        Type.TAsync(f1) => match b { Type.TAsync(f2) => type_eq(f1, f2), _ => false },
        Type.TParam(n1) => match b { Type.TParam(n2) => n1 == n2, _ => false },
        Type.TSelf => match b { Type.TSelf => true, _ => false },
        Type.TError => match b { Type.TError => true, _ => false },
        Type.TPtr => match b { Type.TPtr => true, _ => false },
    }
}

