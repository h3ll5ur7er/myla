// checker.my - the Myla static type checker (mirror of src/myla/types.py),
// self-hosting v0.7.
//
// A type error is a `CheckErr` (position, the range of the node it is about
// (MYLA-65), and the Python checker's message, with types written by
// `type_name` as types.py does), threaded through
// `Result<_, CheckErr>` and propagated with `?`. The phase order and
// within-phase iteration order mirror types.py exactly, so the *first* error
// is the oracle's: same position, same message (MYLA-28). An error while
// building the tables ends the check; after that each function's attributes
// and each body are checked on their own, and the first error of each is
// collected, up to MAX_ERRORS: the same errors in the same order as types.py
// (MYLA-65, D80).

from .parser import parse_source, Parsed
from .ast import int_text
from .ast import Program, Decl, DeclKind, FunData, Param, TypeParam, Field, Variant
from .ast import Attribute, TypeExpr, TypeKind, Expr, ExprKind, FieldInit, MapEntry
from .ast import Stmt, StmtKind, Block, ElseTail, BindElem, ExprOrBlock
from .ast import Pattern, PatternKind, FieldPat, MatchArm
from .tokens import Note, SrcSpan, no_span, MAX_ERRORS

// =========================================================================
// Types
// =========================================================================

pub enum Type {
    TInt(int32, bool),            // width (8/16/32/64), signed
    TFloat(int32),                // width (32/64)
    TChar,
    TBool,
    TStr,
    TSB,                          // StringBuilder
    TStruct(str, [Type]),         // name, type args
    TEnum(str, [Type]),           // name, type args
    TTuple([Type]),
    TList(Type),
    TMap(Type, Type),
    TFunc([Type], Option<Type>),  // params, return (None = void)
    // an async function type (D89; types.py: FuncType.is_async), a TFunc
    // inside: a separate variant keeps every other type as small as before
    TAsync(Type),
    // an actor's handle (D89): a reference to its state, which only its own
    // methods reach; its fields are those of the struct it is declared like
    TActor(str),
    TParam(str),
    TSelf,
    // the type of a declaration's part that failed to check (MYLA-110, D84;
    // types.py: ErrorType)
    TError,
}

// A type error: position, the range it underlines (that of the node it is
// about, MYLA-65), the Python checker's message, and the id of the declaration
// being checked, whose module is the error's file (-1: unknown).
pub struct CheckErr { line: int32, col: int32, sp: SrcSpan, msg: str, decl: int32, notes: [Note] }

// An error at a position without a range (one caret).
fun terr(line: int32, col: int32, msg: str) -> CheckErr { return terr_at(line, col, no_span(), msg) }

fun terr_at(line: int32, col: int32, sp: SrcSpan, msg: str) -> CheckErr { return CheckErr { line: line, col: col, sp: sp, msg: msg, decl: -1, notes: [] } }

// `e` with the notes `ns` (MYLA-65).
fun with_notes(e: CheckErr, ns: [Note]) -> CheckErr {
    var r = e
    r.notes = ns
    return r
}

// A note about the place `line`, `col`, `sp` (errors.py: note).
fun note_at(msg: str, line: int32, col: int32, sp: SrcSpan) -> Note {
    return Note { label: "note", msg: msg, line: line, col: col, sp: sp }
}

// The edits that turn `a` into `b`, counted on their bytes: inserting, deleting
// or replacing a byte, or swapping two neighbours (types.py: _edit_distance).
#test("count", "count")[0]
#test("cuont", "count")[1]
#test("cont", "count")[1]
#test("kitten", "sitting")[3]
#test("", "abc")[3]
#test("ca", "abc")[3]
#test("o", "ö")[2]
fun edit_distance(a: str, b: str) -> int32 {
    let n = len(a) as int32
    let m = len(b) as int32
    var prev2: [int32] = []
    var prev: [int32] = []
    var j = 0
    while j <= m {
        push(prev, j)
        j = j + 1
    }
    var i = 1
    while i <= n {
        var cur: [int32] = [i]
        j = 1
        while j <= m {
            var cost = 1
            if a[i - 1] == b[j - 1] { cost = 0 }
            var d = prev[j] + 1
            if cur[j - 1] + 1 < d { d = cur[j - 1] + 1 }
            if prev[j - 1] + cost < d { d = prev[j - 1] + cost }
            if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] {
                if prev2[j - 2] + 1 < d { d = prev2[j - 2] + 1 }
            }
            push(cur, d)
            j = j + 1
        }
        prev2 = prev
        prev = cur
        i = i + 1
    }
    return prev[m]
}

// Whether `a` sorts before `b`, byte by byte (the order of Python's strings).
#test("abcd", "abce")[true]
#test("abc", "ab")[false]
#test("ab", "abc")[true]
#test("b", "b")[false]
fun str_before(a: str, b: str) -> bool {
    var i = 0
    while i < len(a) && i < len(b) {
        if a[i] != b[i] { return a[i] < b[i] }
        i = i + 1
    }
    return len(a) < len(b)
}

// Whether `name` is internal to the toolchain: a method's `Key.name` or a
// `__` primitive.
fun is_internal_name(name: str) -> bool {
    if len(name) >= 2 && name[0] == '_' && name[1] == '_' { return true }
    for c in chars(name) { if c == '.' { return true } }
    return false
}

// A help line naming the candidate closest to `name`, if one is within a third
// of its length in edits; the alphabetically first of equally close ones
// (types.py: _did_you_mean).
#test("cuont", ["count", "x"])[[Note { label: "help", msg: "did you mean 'count'?", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }]]
#test("abcf", ["abce", "abcd"])[[Note { label: "help", msg: "did you mean 'abcd'?", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }]]
#test("y", ["x"])[[]]
#test("__exti", ["__exit"])[[]]
fun did_you_mean(name: str, cands: [str]) -> [Note] {
    let limit = (len(name) as int32) / 3
    var best = ""
    var best_d = -1
    for c in cands {
        if c == name || is_internal_name(c) { continue }
        let d = edit_distance(name, c)
        if d <= limit && (best_d < 0 || d < best_d || (d == best_d && str_before(c, best))) {
            best = c
            best_d = d
        }
    }
    if best_d < 0 { return [] }
    return [Note { label: "help", msg: format("did you mean '{}'?", best), line: 0, col: 0, sp: no_span() }]
}

// The names of the primitive types, as types.py's _PRIMITIVES has them.
fun primitive_type_names() -> [str] {
    return ["bool", "str", "StringBuilder", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "char"]
}

// The names of the built-in functions (types.py: _BUILTIN_FUNCS, without the
// `__` primitives, which are never suggested).
fun builtin_func_names() -> [str] {
    return ["print", "assert", "panic", "unreachable", "len", "push", "pop", "contains", "remove", "keys", "format", "chars", "StringBuilder", "append", "append_byte", "build"]
}

fun field_names(fields: [FieldT]) -> [str] {
    var out: [str] = []
    for f in fields { push(out, f.name) }
    return out
}

// A type as the Python checker's messages write it (types.py: type_name).
pub fun type_name(t: Type) -> str {
    return match t {
        Type.TInt(w, signed) => format("{}{}", if_str(signed, "int", "uint"), w),
        Type.TFloat(w) => format("float{}", w),
        Type.TChar => "char",
        Type.TBool => "bool",
        Type.TStr => "str",
        Type.TSB => "StringBuilder",
        Type.TStruct(n, args) => generic_name(n, args),
        Type.TActor(n) => generic_name(n, []),
        Type.TEnum(n, args) => generic_name(n, args),
        Type.TParam(n) => n,
        Type.TSelf => "Self",
        Type.TTuple(es) => format("({}{})", type_names(es), if_str(len(es) == 1, ",", "")),
        Type.TList(e) => format("[{}]", type_name(e)),
        Type.TMap(k, v) => format("[{}: {}]", type_name(k), type_name(v)),
        Type.TFunc(ps, r) => format("({}) -> {}", type_names(ps), opt_type_name(r)),
        Type.TAsync(f) => "async " + type_name(f),
        Type.TError => "{error}",
    }
}

// Whether `t` is or contains the error type (types.py: _has_error).
fun has_error(t: Type) -> bool {
    return match t {
        Type.TError => true,
        Type.TStruct(n, a) => list_has_error(a),
        Type.TEnum(n, a) => list_has_error(a),
        Type.TTuple(es) => list_has_error(es),
        Type.TList(e) => has_error(e),
        Type.TMap(k, v) => has_error(k) || has_error(v),
        Type.TFunc(ps, r) => list_has_error(ps) || opt_has_error(r),
        Type.TAsync(f) => has_error(f),
        _ => false,
    }
}

fun list_has_error(ts: [Type]) -> bool {
    for t in ts { if has_error(t) { return true } }
    return false
}

fun opt_has_error(t: Option<Type>) -> bool {
    return match t { Some(x) => has_error(x), None => false }
}

fun sig_has_error(ps: [Type], r: Option<Type>) -> bool {
    return list_has_error(ps) || opt_has_error(r)
}

// What a check returns when what it checks depends on the error type: it
// ends without an error, which would follow from an earlier one (types.py:
// _Poisoned). `?` carries it like an error; the driver drops it.
fun poisoned() -> CheckErr {
    return CheckErr { line: -1, col: 0, sp: no_span(), msg: "", decl: -1, notes: [] }
}

fun is_poisoned(e: CheckErr) -> bool { return e.line == -1 && e.msg == "" }

// What the declaration phases return when MAX_ERRORS errors are collected:
// the check ends (types.py: _Stop).
fun stopped() -> CheckErr {
    return CheckErr { line: -2, col: 0, sp: no_span(), msg: "", decl: -1, notes: [] }
}

fun is_stopped(e: CheckErr) -> bool { return e.line == -2 && e.msg == "" }

// `None` (no value) is written `()`.
fun opt_type_name(t: Option<Type>) -> str {
    return match t { Some(x) => type_name(x), None => "()" }
}

fun type_names(ts: [Type]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < len(ts) {
        if i > 0 { append(sb, ", ") }
        append(sb, type_name(ts[i]))
        i = i + 1
    }
    return build(sb)
}

fun generic_name(n: str, args: [Type]) -> str {
    if len(args) == 0 { return n }
    return format("{}<{}>", n, type_names(args))
}

fun join_strs(xs: [str], sep: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < len(xs) {
        if i > 0 { append(sb, sep) }
        append(sb, xs[i])
        i = i + 1
    }
    return build(sb)
}

// Byte-wise `a < b` (Python's order for ASCII names).
fun str_less(a: str, b: str) -> bool {
    var i = 0
    while i < len(a) && i < len(b) {
        if a[i] != b[i] { return a[i] < b[i] }
        i = i + 1
    }
    return len(a) < len(b)
}

fun sorted_strs(xs: [str]) -> [str] {
    var out: [str] = []
    for x in xs {
        var k = len(out)
        push(out, x)
        while k > 0 && str_less(x, out[k - 1]) {
            out[k] = out[k - 1]
            k = k - 1
        }
        out[k] = x
    }
    return out
}

fun if_str(c: bool, a: str, b: str) -> str {
    if c { return a }
    return b
}

// type constructors / constants
fun t_int() -> Type { return Type.TInt(32, true) }
fun t_byte() -> Type { return Type.TInt(8, false) }
fun t_float() -> Type { return Type.TFloat(32) }

// --- equality ------------------------------------------------------------

fun type_list_eq(a: [Type], b: [Type]) -> bool {
    if len(a) != len(b) { return false }
    var i = 0
    while i < len(a) {
        if !type_eq(a[i], b[i]) { return false }
        i = i + 1
    }
    return true
}

// What `become` passes freely (D87), and what lives in a frame, so it must be
// (a part of) a parameter; a type parameter may stand for either.
fun is_scalar_type(t: Type) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TFloat(w) => true,
        Type.TChar => true,
        Type.TBool => true,
        _ => false,
    }
}

fun is_frame_value(t: Type) -> bool {
    return match t {
        Type.TStruct(n, a) => true,
        Type.TTuple(es) => true,
        Type.TEnum(n, a) => true,
        Type.TFunc(ps, r) => true,
        Type.TAsync(f) => true,
        Type.TParam(n) => true,
        Type.TSelf => true,
        _ => false,
    }
}

// The variable a place expression (`a.b[i].c`) is a part of ("": none).
fun root_name(e: Expr) -> str {
    return match e.kind {
        ExprKind.GetField(t, f) => root_name(t),
        ExprKind.TupleIndex(t, i) => root_name(t),
        ExprKind.Index(t, i) => root_name(t),
        ExprKind.Name(n) => n,
        _ => "",
    }
}

fun is_tfunc_type(t: Type) -> bool {
    return match t {
        Type.TFunc(ps, r) => true,
        Type.TAsync(f) => true,
        _ => false,
    }
}

fun sig_mutates(sig: FuncSig) -> bool {
    return sig.has_decl && match sig.decl.receiver { Some(r) => r == "var self", None => false }
}

fun quoted_or_nothing(t: Option<Type>) -> str {
    return match t { Some(x) => format("'{}'", type_name(x)), None => "nothing" }
}

fun opt_type_eq(a: Option<Type>, b: Option<Type>) -> bool {
    return match a {
        Some(x) => match b { Some(y) => type_eq(x, y), None => false },
        None => match b { Some(y) => false, None => true },
    }
}

fun type_eq(a: Type, b: Type) -> bool {
    return match a {
        Type.TInt(w1, s1) => match b { Type.TInt(w2, s2) => w1 == w2 && s1 == s2, _ => false },
        Type.TFloat(w1) => match b { Type.TFloat(w2) => w1 == w2, _ => false },
        Type.TChar => match b { Type.TChar => true, _ => false },
        Type.TBool => match b { Type.TBool => true, _ => false },
        Type.TStr => match b { Type.TStr => true, _ => false },
        Type.TSB => match b { Type.TSB => true, _ => false },
        Type.TStruct(n1, a1) => match b { Type.TStruct(n2, a2) => n1 == n2 && type_list_eq(a1, a2), _ => false },
        Type.TActor(n1) => match b { Type.TActor(n2) => n1 == n2, _ => false },
        Type.TEnum(n1, a1) => match b { Type.TEnum(n2, a2) => n1 == n2 && type_list_eq(a1, a2), _ => false },
        Type.TTuple(e1) => match b { Type.TTuple(e2) => type_list_eq(e1, e2), _ => false },
        Type.TList(e1) => match b { Type.TList(e2) => type_eq(e1, e2), _ => false },
        Type.TMap(k1, v1) => match b { Type.TMap(k2, v2) => type_eq(k1, k2) && type_eq(v1, v2), _ => false },
        Type.TFunc(p1, r1) => match b { Type.TFunc(p2, r2) => type_list_eq(p1, p2) && opt_type_eq(r1, r2), _ => false },
        Type.TAsync(f1) => match b { Type.TAsync(f2) => type_eq(f1, f2), _ => false },
        Type.TParam(n1) => match b { Type.TParam(n2) => n1 == n2, _ => false },
        Type.TSelf => match b { Type.TSelf => true, _ => false },
        Type.TError => match b { Type.TError => true, _ => false },
    }
}

// --- predicates ----------------------------------------------------------

fun is_int(t: Type) -> bool { return match t { Type.TInt(w, s) => true, _ => false } }
fun is_float(t: Type) -> bool { return match t { Type.TFloat(w) => true, _ => false } }
fun is_char(t: Type) -> bool { return match t { Type.TChar => true, _ => false } }
fun is_bool(t: Type) -> bool { return match t { Type.TBool => true, _ => false } }
fun is_str(t: Type) -> bool { return match t { Type.TStr => true, _ => false } }
fun is_sb(t: Type) -> bool { return match t { Type.TSB => true, _ => false } }

fun int_width(t: Type) -> int32 { return match t { Type.TInt(w, s) => w, _ => 0 } }

fun is_map_key(t: Type) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TChar => true,
        Type.TBool => true,
        Type.TStr => true,
        _ => false,
    }
}

fun prim_type(name: str) -> Option<Type> {
    if name == "bool" { return Some(Type.TBool) }
    if name == "str" { return Some(Type.TStr) }
    if name == "StringBuilder" { return Some(Type.TSB) }
    if name == "int8" { return Some(Type.TInt(8, true)) }
    if name == "int16" { return Some(Type.TInt(16, true)) }
    if name == "int32" { return Some(Type.TInt(32, true)) }
    if name == "int64" { return Some(Type.TInt(64, true)) }
    if name == "uint8" { return Some(Type.TInt(8, false)) }
    if name == "uint16" { return Some(Type.TInt(16, false)) }
    if name == "uint32" { return Some(Type.TInt(32, false)) }
    if name == "uint64" { return Some(Type.TInt(64, false)) }
    if name == "float32" { return Some(Type.TFloat(32)) }
    if name == "float64" { return Some(Type.TFloat(64)) }
    if name == "char" { return Some(Type.TChar) }
    return None
}

fun int_suffix_type(s: str) -> Option<Type> {
    if s == "i8" { return Some(Type.TInt(8, true)) }
    if s == "i16" { return Some(Type.TInt(16, true)) }
    if s == "i32" { return Some(Type.TInt(32, true)) }
    if s == "i64" { return Some(Type.TInt(64, true)) }
    if s == "u8" { return Some(Type.TInt(8, false)) }
    if s == "u16" { return Some(Type.TInt(16, false)) }
    if s == "u32" { return Some(Type.TInt(32, false)) }
    if s == "u64" { return Some(Type.TInt(64, false)) }
    return None
}

fun float_suffix_type(s: str) -> Option<Type> {
    if s == "f32" { return Some(Type.TFloat(32)) }
    if s == "f64" { return Some(Type.TFloat(64)) }
    return None
}

// half-open: signed permits magnitude up to 2**(width-1) (negation handled
// separately); unsigned permits up to 2**width - 1.
// Whether a literal fits a type, as types.int_fits: `big` is its decimal text
// when it is 2^63 or more (`value` then holds only its low bits). A signed
// type admits the magnitude 2^(w-1), so that `-128i8` is accepted.
fun lit_fits(value: int64, big: str, w: int32, signed: bool) -> bool {
    if big == "" { return int_fits(value, w, signed) }
    if w < 64 { return false }
    if signed { return big == "9223372036854775808" }
    return len(big) < 20 || (len(big) == 20 && !text_greater(big, "18446744073709551615"))
}

// `a > b` for decimal texts of the same length.
fun text_greater(a: str, b: str) -> bool {
    var i = 0
    while i < len(a) {
        if a[i] != b[i] { return a[i] > b[i] }
        i = i + 1
    }
    return false
}

fun int_fits(value: int64, w: int32, signed: bool) -> bool {
    if value < 0 { return false }
    if signed {
        if w >= 64 { return true }
        var lim: int64 = 1
        lim = lim << (w - 1)
        return value <= lim
    }
    if w >= 64 { return true }
    var lim2: int64 = 1
    lim2 = lim2 << w
    return value <= lim2 - 1
}

fun arith_trait(op: str) -> Option<str> {
    if op == "+" { return Some("Add") }
    if op == "-" { return Some("Sub") }
    if op == "*" { return Some("Mul") }
    if op == "/" { return Some("Div") }
    if op == "%" { return Some("Rem") }
    return None
}

fun is_arith_op(op: str) -> bool {
    return match arith_trait(op) { Some(x) => true, None => false }
}

// implicit primitive operator-trait defaults (D52)
fun primitive_default_trait(t: Type, trnm: str) -> bool {
    return match t {
        Type.TInt(w, s) => trnm == "Add" || trnm == "Sub" || trnm == "Mul" || trnm == "Div" || trnm == "Rem" || trnm == "Eq" || trnm == "Ord",
        Type.TFloat(w) => trnm == "Add" || trnm == "Sub" || trnm == "Mul" || trnm == "Div" || trnm == "Rem" || trnm == "Eq" || trnm == "Ord",
        Type.TChar => trnm == "Eq" || trnm == "Ord",
        Type.TBool => trnm == "Eq",
        Type.TStr => trnm == "Add" || trnm == "Eq",
        _ => false,
    }
}

fun is_builtin_op_trait(name: str) -> bool {
    return name == "Add" || name == "Sub" || name == "Mul" || name == "Div" || name == "Rem" || name == "Eq" || name == "Ord"
}

fun is_builtin_func(name: str) -> bool {
    return name == "print" || name == "assert" || name == "panic" || name == "unreachable" || name == "len" || name == "push" || name == "pop" || name == "contains" || name == "remove" || name == "keys" || name == "format" || name == "chars" || name == "StringBuilder" || name == "append" || name == "append_byte" || name == "build" || name == "__write" || name == "__exit" || name == "__args" || name == "__read_file" || name == "__io_errno" || name == "__run" || name == "__run_stderr" || name == "__run_exit_code" || name == "__run_signal" || name == "__run_errno" || name == "__write_file" || name == "__read" || name == "__poll" || name == "__list_dir" || name == "__mkdir" || name == "__stat" || name == "__getcwd" || name == "__unlink" || name == "__rmdir" || name == "__rename" || name == "__task_cancelled"
}

fun is_diverging_builtin(name: str) -> bool {
    return name == "panic" || name == "unreachable" || name == "__exit"
}

fun prelude_variant_enum(name: str) -> Option<str> {
    if name == "Some" { return Some("Option") }
    if name == "None" { return Some("Option") }
    if name == "Ok" { return Some("Result") }
    if name == "Err" { return Some("Result") }
    return None
}

fun contains_str(xs: [str], s: str) -> bool {
    for x in xs { if x == s { return true } }
    return false
}

fun empty_types() -> [Type] {
    let x: [Type] = []
    return x
}

fun empty_attrs() -> [Attribute] {
    let x: [Attribute] = []
    return x
}

fun int_lit_expected_default(expected: Option<Type>, dflt: Type) -> Type {
    match expected {
        Some(et) => { if is_int(et) { return et } },
        None => {},
    }
    return dflt
}

fun enum_type_matches(et: Type, name: str, nparams: int32) -> bool {
    match et {
        Type.TEnum(en, args) => { if en == name && len(args) == nparams { return true } },
        _ => {},
    }
    return false
}

fun tuple_hint(expected: Option<Type>, n: int32) -> Option<[Type]> {
    match expected {
        Some(et) => {
            match et {
                Type.TTuple(es) => { if len(es) == n { return Some(es) } },
                _ => {},
            }
            return None
        },
        None => {},
    }
    return None
}

fun list_elem_hint(expected: Option<Type>) -> Option<Type> {
    match expected {
        Some(et) => {
            match et {
                Type.TList(el) => { return Some(el) },
                _ => {},
            }
            return None
        },
        None => {},
    }
    return None
}

fun map_kv_hint(expected: Option<Type>) -> Option<[Type]> {
    match expected {
        Some(et) => {
            match et {
                Type.TMap(k, v) => { return Some([k, v]) },
                _ => {},
            }
            return None
        },
        None => {},
    }
    return None
}

fun struct_args_hint(expected: Option<Type>, name: str) -> Option<[Type]> {
    match expected {
        Some(et) => {
            match et {
                Type.TStruct(en, args) => { if en == name { return Some(args) } },
                _ => {},
            }
            return None
        },
        None => {},
    }
    return None
}

fun enum_args_hint(expected: Option<Type>, name: str) -> Option<[Type]> {
    match expected {
        Some(et) => {
            match et {
                Type.TEnum(en, eargs) => { if en == name { return Some(eargs) } },
                _ => {},
            }
            return None
        },
        None => {},
    }
    return None
}

fun func_hint(expected: Option<Type>, nparams: int32) -> Option<Type> {
    match expected {
        Some(et) => {
            let ft = strip_async(et)
            match ft {
                Type.TFunc(ps, r) => { if len(ps) == nparams { return Some(ft) } },
                _ => {},
            }
            return None
        },
        None => {},
    }
    return None
}

fun func_params_of(t: Type) -> [Type] {
    match strip_async(t) {
        Type.TFunc(ps, r) => { return ps },
        _ => {},
    }
    return empty_types()
}

fun func_ret_of(t: Type) -> Option<Type> {
    match strip_async(t) {
        Type.TFunc(ps, r) => { return r },
        _ => {},
    }
    return None
}

// The value of an integer literal pattern that is not a value of `t`, as the
// error shows it, or "": a pattern has no arithmetic to wrap, so `-1` on
// `uint8` or `128` on `int8` could never match (MYLA-7). The literal check
// already bounds the magnitude by 2^(w-1) (signed) or 2^w - 1 (unsigned).
fun pattern_misfit(lit: Expr, t: Type) -> str {
    let w = int_width(t)
    if w == 0 { return "" }
    let signed = match t { Type.TInt(tw, ts) => ts, _ => false }
    match lit.kind {
        ExprKind.IntLit(v, suf, isc, big) => {
            if !signed { return "" }
            if big != "" || (w < 64 && v == (1i64 << ((w - 1) as int64))) { return int_text(v, big) }
            return ""
        },
        ExprKind.Unary(op, x) => {
            if signed || op != "-" { return "" }
            return negated_misfit(x)
        },
        _ => {},
    }
    return ""
}

// `-x` for an unsigned scrutinee: fine only for a zero literal.
fun negated_misfit(x: Expr) -> str {
    match x.kind {
        ExprKind.IntLit(v, suf, isc, big) => {
            if v == 0 && big == "" { return "" }
            return "-" + int_text(v, big)
        },
        _ => {},
    }
    return ""
}


fun impl_eq_target_name(d: Decl) -> Option<str> {
    match d.kind {
        DeclKind.ImplDecl(tg, m, tp, tn, ta) => {
            let is_eq = match tn { Some(t) => t == "Eq", None => false }
            if !is_eq { return None }
            match tg.kind {
                TypeKind.TRef(nm, args) => { return Some(nm) },
                _ => {},
            }
            return None
        },
        _ => {},
    }
    return None
}

fun num_hint(expected: Option<Type>) -> Option<Type> {
    match expected {
        Some(et) => {
            if is_int(et) || is_float(et) { return Some(et) }
        },
        None => {},
    }
    return None
}

fun int_hint(expected: Option<Type>) -> Option<Type> {
    match expected {
        Some(et) => {
            if is_int(et) { return Some(et) }
        },
        None => {},
    }
    return None
}

// =========================================================================
// Substitutions (generic inference)
// =========================================================================

pub struct Subst { name: str, ty: Type }

pub fun subst_get(subst: [Subst], name: str) -> Option<Type> {
    for s in subst { if s.name == name { return Some(s.ty) } }
    return None
}

fun subst_has(subst: [Subst], name: str) -> bool {
    return match subst_get(subst, name) { Some(x) => true, None => false }
}

fun contains_type_param(t: Type) -> bool {
    return match t {
        Type.TParam(n) => true,
        Type.TTuple(es) => list_any_tp(es),
        Type.TList(e) => contains_type_param(e),
        Type.TMap(k, v) => contains_type_param(k) || contains_type_param(v),
        Type.TStruct(n, args) => list_any_tp(args),
        Type.TEnum(n, args) => list_any_tp(args),
        Type.TFunc(ps, r) => list_any_tp(ps) || (match r { Some(rt) => contains_type_param(rt), None => false }),
        Type.TAsync(f) => contains_type_param(f),
        _ => false,
    }
}

fun list_any_tp(xs: [Type]) -> bool {
    for x in xs { if contains_type_param(x) { return true } }
    return false
}

pub fun subst_type(t: Type, subst: [Subst]) -> Type {
    return match t {
        Type.TParam(n) => match subst_get(subst, n) { Some(x) => x, None => t },
        Type.TTuple(es) => Type.TTuple(subst_type_list(es, subst)),
        Type.TList(e) => Type.TList(subst_type(e, subst)),
        Type.TMap(k, v) => Type.TMap(subst_type(k, subst), subst_type(v, subst)),
        Type.TStruct(n, args) => Type.TStruct(n, subst_type_list(args, subst)),
        Type.TEnum(n, args) => Type.TEnum(n, subst_type_list(args, subst)),
        Type.TFunc(ps, r) => Type.TFunc(subst_type_list(ps, subst), match r { Some(rt) => Some(subst_type(rt, subst)), None => None }),
        Type.TAsync(f) => Type.TAsync(subst_type(f, subst)),
        _ => t,
    }
}

fun subst_type_list(xs: [Type], subst: [Subst]) -> [Type] {
    var out: [Type] = []
    for x in xs { push(out, subst_type(x, subst)) }
    return out
}

pub fun opt_subst_type(t: Option<Type>, subst: [Subst]) -> Option<Type> {
    return match t { Some(x) => Some(subst_type(x, subst)), None => None }
}

pub struct UniRes { ok: bool, subst: [Subst] }

fun unify_param(ptype: Type, at: Type, subst: [Subst]) -> UniRes {
    return match ptype {
        Type.TParam(n) => {
            match subst_get(subst, n) {
                Some(prev) => UniRes { ok: type_eq(prev, at), subst: subst },
                None => {
                    var s2 = subst
                    push(s2, Subst { name: n, ty: at })
                    UniRes { ok: true, subst: s2 }
                },
            }
        },
        Type.TTuple(pe) => match at {
            Type.TTuple(ae) => unify_list(pe, ae, subst),
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TList(pe) => match at {
            Type.TList(ae) => unify_param(pe, ae, subst),
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TMap(pk, pv) => match at {
            Type.TMap(ak, av) => {
                let r1 = unify_param(pk, ak, subst)
                if !r1.ok { return UniRes { ok: false, subst: r1.subst } }
                unify_param(pv, av, r1.subst)
            },
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TStruct(pn, pa) => match at {
            Type.TStruct(an, aa) => {
                if pn != an || len(pa) != len(aa) { return UniRes { ok: false, subst: subst } }
                unify_list(pa, aa, subst)
            },
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TEnum(pn, pa) => match at {
            Type.TEnum(an, aa) => {
                if pn != an || len(pa) != len(aa) { return UniRes { ok: false, subst: subst } }
                unify_list(pa, aa, subst)
            },
            _ => UniRes { ok: false, subst: subst },
        },
        // like types.py's, the unification doesn't compare asyncness: the
        // types are compared after it
        Type.TAsync(pf) => unify_param(pf, strip_async(at), subst),
        Type.TFunc(pp, pr) => match strip_async(at) {
            Type.TFunc(ap, ar) => {
                if len(pp) != len(ap) { return UniRes { ok: false, subst: subst } }
                let r1 = unify_list(pp, ap, subst)
                if !r1.ok { return UniRes { ok: false, subst: r1.subst } }
                match pr {
                    Some(prt) => match ar { Some(art) => unify_param(prt, art, r1.subst), None => UniRes { ok: false, subst: r1.subst } },
                    None => match ar { Some(art) => UniRes { ok: false, subst: r1.subst }, None => UniRes { ok: true, subst: r1.subst } },
                }
            },
            _ => UniRes { ok: false, subst: subst },
        },
        _ => UniRes { ok: type_eq(ptype, at), subst: subst },
    }
}

fun unify_list(ps: [Type], ats: [Type], subst: [Subst]) -> UniRes {
    var s = subst
    var i = 0
    while i < len(ps) {
        let r = unify_param(ps[i], ats[i], s)
        if !r.ok { return UniRes { ok: false, subst: r.subst } }
        s = r.subst
        i = i + 1
    }
    return UniRes { ok: true, subst: s }
}

// =========================================================================
// Global-table records
// =========================================================================

pub struct FieldT { name: str, ty: Type }
pub struct StructInfo { name: str, type_params: [str], fields: [FieldT], line: int32, col: int32, sp: SrcSpan, id: int32 }

pub struct VariantT { name: str, payload: [Type] }
pub struct EnumInfo { name: str, type_params: [str], variants: [VariantT], line: int32, col: int32, sp: SrcSpan, id: int32 }

pub struct Bound { tp: str, traits: [str] }
pub struct FuncSig {
    name: str,
    params: [Type],
    ret: Option<Type>,
    type_params: [str],
    bounds: [Bound],
    decl: FunData,
    has_decl: bool,
    decl_id: int32,                 // its declaration (the impl, for a method)
}

pub struct TraitMethodSig { name: str, params: [Type], ret: Option<Type>, receiver: str }
pub struct TraitInfo { name: str, methods: [TraitMethodSig], type_params: [str], builtin: bool, line: int32, col: int32 }

pub struct MethodEntry { key: str, name: str, sig: FuncSig }
pub struct TraitImplPair { trait_name: str, key: str }

pub struct AliasRaw { name: str, target: TypeExpr, line: int32, col: int32, sp: SrcSpan, id: int32 }
pub struct AliasCached { name: str, ty: Type }

pub struct ConstDeclT { name: str, declared: TypeExpr, value: Expr, line: int32, col: int32, sp: SrcSpan, id: int32 }

// A variable: its type, whether it can be assigned, and where it is declared,
// for notes (`line` 0: no note; MYLA-65); `task`: 0, or an `async let`'s name
// (D89), 1 with a result of type `ty`, 2 with none
pub struct Binding { ty: Type, mutable: bool, line: int32, col: int32, sp: SrcSpan, task: int32 }
// A lambda being checked (D89): its parameters' frame and where it is
pub struct LamAt { base: int32, line: int32, col: int32, sp: SrcSpan }
// A function with a `#main` attribute: where it is, its name and declaration.
pub struct MainAt { line: int32, col: int32, sp: SrcSpan, name: str, id: int32 }
pub struct Frame { names: [str], binds: [Binding] }

// `become` (D87; types.py: _check_become): a `become` that hands a heap value
// over to a parameter, the first of each, and one that passes a heap-value
// parameter on to a function value (in declaration `decl`)
pub struct Handover { func: str, index: int32, by: str, line: int32, col: int32, sp: SrcSpan }
pub struct PassedOn { func: str, index: int32, name: str, line: int32, col: int32, sp: SrcSpan, decl: int32 }

// a checked match-arm body value (with its source node for re-inference)
pub struct MatchVal { ty: Type, node: Option<Expr> }
pub enum ArmBody {
    ABDiverge,
    ABValue(Option<Type>, Option<Expr>),
}

// =========================================================================
// Checker
// =========================================================================

pub struct Checker {
    // the index of the first struct, enum, function and method (`key\tname`)
    // of each name, kept with the lists (`add_*`; MYLA-119)
    struct_map: [str: int32],
    enum_map: [str: int32],
    func_map: [str: int32],
    method_map: [str: int32],
    decls: [Decl],
    structs: [StructInfo],
    enums: [EnumInfo],
    recursive_enums: [str],
    functions: [FuncSig],
    methods: [MethodEntry],
    method_decls: [FunData],
    method_decl_keys: [str],
    method_decl_ids: [int32],       // each method's impl declaration
    impl_decls: [Decl],
    traits: [TraitInfo],
    trait_decls: [Decl],
    trait_impls: [TraitImplPair],
    user_trait_impls: [TraitImplPair],
    aliases: [AliasRaw],
    alias_cache: [AliasCached],
    const_decls: [ConstDeclT],
    consts: [AliasCached],          // folded consts: {name, ty}
    const_values: [str: CV],        // ... and their values
    const_done: [str],
    const_folding: [str],
    allow_self: bool,
    type_params: [str],
    bounds_cur: [Bound],
    cur_ret: Option<Type>,
    has_cur_ret: bool,
    ret_at: Option<TypeExpr>,       // the return type of the function being checked, for notes (MYLA-65)
    loop_depth: int32,
    frames: [Frame],
    lambda_infer_active: bool,
    lambda_depth: int32,            // lambdas being checked (`?` names "lambda" or "function")
    cur_decl: int32,                // the declaration being checked, for CheckErr.decl
    lambda_infer: [MatchVal],
    stmt_match: bool,
    resolved: [int32: Type],        // expr node id -> resolved type (v0.8 interp side table)
    errs: [CheckErr],               // the errors of the functions checked so far (MYLA-65, D80)
    warnings: [CheckErr],           // D95: the warnings found, in the order found
    // going on after a declaration's error (MYLA-110, D84; types.py: Checker):
    // the declarations left out and the functions not checked (by
    // name: a function with a bad bound); the `trait\tkey` pairs whose impl or
    // derive failed; redefined builtins; the methods and traits of impls left
    // out for want of a type; the consts that failed; whether the declaration
    // phases are done
    skipped_decls: [int32: bool],   // by index in `decls` (node ids repeat: the prelude's start at 0 too)
    skipped_fns: [str: bool],
    broken_impls: [str: bool],
    redefined: [str: bool],
    lost_methods: [str: bool],
    lost_traits: [str: bool],
    failed_consts: [str: bool],
    bodies: bool,
    mains: [MainAt],                // the `#main` functions found so far
    // `become` (D87): the kind of the call inferred last (`function`,
    // `method` or `value`), its node and its function; the function being
    // checked; the parameters (`function\tindex`) a `become` hands a heap value
    // over to, and the heap-value parameters one passes on to a function value
    call_kind: str,
    call_kind_id: int32,
    call_target: str,
    call_mutates: bool,
    fun_name: str,
    handovers: [str: Handover],
    passed_on: [PassedOn],
    // concurrency (D89; types.py: Checker): the actor types; the first
    // construct of concurrency met (`conc_line` 0: none), which the
    // interpreters and backends don't run yet; whether the function or lambda
    // being checked is async; the actor whose method is being checked ("":
    // none) and the key of the type whose method it is ("": a function); the
    // lambdas being checked; the calls under an `await`, by id; the type key
    // of the method called last and whether that call's callee is async; the
    // call found last to suspend
    actors: [str: bool],
    conc_line: int32,
    conc_col: int32,
    conc_sp: SrcSpan,
    conc_node: int32,
    in_async: bool,
    actor_self: str,
    cur_key: str,
    lams: [LamAt],
    awaited: [int32: bool],
    call_key: str,
    call_async: bool,
    suspended: int32,
    task_init: bool,                // checking an `async let`'s initializer, outside its lambdas
    in_guard: bool,                 // checking a match guard, outside its lambdas
    // the first `async let`, which the compiler doesn't build yet (D91,
    // MYLA-138; `task_line` 0: none)
    task_line: int32,
    task_col: int32,
    task_sp: SrcSpan,
    task_node: int32,
}

fun new_checker(decls: [Decl]) -> Checker {
    return Checker {
        struct_map: [:], enum_map: [:], func_map: [:], method_map: [:],
        decls: decls,
        structs: [], enums: [], recursive_enums: [],
        functions: [], methods: [], method_decls: [], method_decl_keys: [], method_decl_ids: [],
        impl_decls: [], traits: [], trait_decls: [], trait_impls: [], user_trait_impls: [],
        aliases: [], alias_cache: [], const_decls: [], consts: [], const_values: [:], const_done: [], const_folding: [],
        allow_self: false, type_params: [], bounds_cur: [],
        cur_ret: None, has_cur_ret: false, ret_at: None, loop_depth: 0,
        frames: [], lambda_infer_active: false, lambda_depth: 0, cur_decl: -1, lambda_infer: [], stmt_match: false,
        resolved: [:], errs: [], warnings: [], mains: [],
        skipped_decls: [:], skipped_fns: [:], broken_impls: [:], redefined: [:],
        lost_methods: [:], lost_traits: [:], failed_consts: [:], bodies: false,
        call_kind: "", call_kind_id: -1, call_target: "", call_mutates: false, fun_name: "", handovers: [:], passed_on: [],
        actors: [:], conc_line: 0, conc_col: 0, conc_sp: no_span(), conc_node: -1, in_async: false, actor_self: "", cur_key: "",
        lams: [], awaited: [:], call_key: "", call_async: false, suspended: -1, task_init: false, in_guard: false,
        task_line: 0, task_col: 0, task_sp: no_span(), task_node: -1,
    }
}

// AST predicate helpers (free functions over the AST)

fun is_diverging(e: Expr) -> bool {
    return match e.kind {
        ExprKind.Call(c, args) => match c.kind { ExprKind.Name(n) => is_diverging_builtin(n), _ => false },
        _ => false,
    }
}

fun stmt_returns(s: Stmt) -> bool {
    return match s.kind {
        StmtKind.ReturnS(v, tail) => true,
        StmtKind.ExprStmt(e) => is_diverging(e),
        StmtKind.IfS(cond, then, otherwise) => {
            if !block_returns(then) { return false }
            match otherwise {
                Some(et) => match et { ElseTail.ElseBlock(b) => block_returns(b), ElseTail.ElseIf(s2) => stmt_returns(s2) },
                None => false,
            }
        },
        _ => false,
    }
}

fun block_returns(b: Block) -> bool {
    for s in b.stmts { if stmt_returns(s) { return true } }
    return false
}

fun is_flexible_int_lit(e: Expr) -> bool {
    return match e.kind {
        ExprKind.IntLit(v, suf, isc, big) => match suf { Some(x) => false, None => (!isc) || v <= 127 },
        _ => false,
    }
}

fun is_flexible_char_lit(e: Expr) -> bool {
    return match e.kind { ExprKind.IntLit(v, suf, isc, big) => isc, _ => false }
}

fun is_flexible_float_lit(e: Expr) -> bool {
    return match e.kind { ExprKind.FloatLit(lex, suf) => match suf { Some(x) => false, None => true }, _ => false }
}

fun int_lit_value(e: Expr) -> int64 {
    return match e.kind { ExprKind.IntLit(v, suf, isc, big) => v, _ => 0 }
}

fun const_int(e: Expr) -> Option<int64> {
    return match e.kind {
        ExprKind.IntLit(v, suf, isc, big) => Some(v),
        ExprKind.Unary(op, x) => const_int_neg(op, x),
        _ => None,
    }
}

fun const_int_neg(op: str, x: Expr) -> Option<int64> {
    if op != "-" { return None }
    return match x.kind {
        ExprKind.IntLit(v, suf, isc, big) => Some(0 - v),
        _ => None,
    }
}

fun is_lvalue_shape(e: Expr) -> bool {
    return match e.kind {
        ExprKind.Name(n) => true,
        ExprKind.GetField(t, f) => is_lvalue_shape(t),
        ExprKind.Index(t, i) => is_lvalue_shape(t),
        _ => false,
    }
}

// --- lookups -------------------------------------------------------------

impl Checker {
    fun struct_idx(self, name: str) -> int32 { return index_in(self.struct_map, name) }
    fun enum_idx(self, name: str) -> int32 { return index_in(self.enum_map, name) }
    fun func_idx(self, name: str) -> int32 { return index_in(self.func_map, name) }

    // Append to the tables, keeping their maps (the first of a name wins, as
    // the searches they replace found it).
    fun add_struct(var self, info: StructInfo) {
        if !contains(self.struct_map, info.name) { self.struct_map[info.name] = len(self.structs) }
        push(self.structs, info)
    }
    fun add_enum(var self, info: EnumInfo) {
        if !contains(self.enum_map, info.name) { self.enum_map[info.name] = len(self.enums) }
        push(self.enums, info)
    }
    fun add_function(var self, sig: FuncSig) {
        if !contains(self.func_map, sig.name) { self.func_map[sig.name] = len(self.functions) }
        push(self.functions, sig)
    }
    fun add_method(var self, m: MethodEntry) {
        let k = m.key + "\t" + m.name
        if !contains(self.method_map, k) { self.method_map[k] = len(self.methods) }
        push(self.methods, m)
    }
    fun trait_idx(self, name: str) -> int32 {
        var i = 0
        while i < len(self.traits) { if self.traits[i].name == name { return i }
            i = i + 1
        }
        return -1
    }
    fun alias_idx(self, name: str) -> int32 {
        var i = 0
        while i < len(self.aliases) { if self.aliases[i].name == name { return i }
            i = i + 1
        }
        return -1
    }
    fun alias_cache_get(self, name: str) -> Option<Type> {
        for a in self.alias_cache { if a.name == name { return Some(a.ty) } }
        return None
    }
    fun const_decl_idx(self, name: str) -> int32 {
        var i = 0
        while i < len(self.const_decls) { if self.const_decls[i].name == name { return i }
            i = i + 1
        }
        return -1
    }
    fun is_struct(self, name: str) -> bool { return self.struct_idx(name) >= 0 }
    fun is_enum(self, name: str) -> bool { return self.enum_idx(name) >= 0 }

    fun method_sig(self, key: str, name: str) -> Option<FuncSig> {
        let i = index_in(self.method_map, key + "\t" + name)
        if i < 0 { return None }
        return Some(self.methods[i].sig)
    }
    fun type_key(self, t: Type) -> Option<str> {
        return match t {
            Type.TStruct(n, a) => Some(n),
            Type.TActor(n) => Some(n),
            Type.TEnum(n, a) => Some(n),
            Type.TInt(w, s) => Some(int_type_name(w, s)),
            Type.TBool => Some("bool"),
            Type.TStr => Some("str"),
            Type.TSB => Some("StringBuilder"),
            _ => None,
        }
    }
    fun trait_implements_pair(self, key: str, trnm: str) -> bool {
        for p in self.trait_impls { if p.key == key && p.trait_name == trnm { return true } }
        return false
    }
    fun type_implements(self, t: Type, trnm: str) -> Result<bool, CheckErr> {
        match self.type_key(t) {
            Some(k) => {
                if contains(self.broken_impls, trnm + "\t" + k) { return Err(poisoned()) }   // its impl or derive failed (MYLA-110)
                if self.trait_implements_pair(k, trnm) { return Ok(true) }
            },
            None => {},
        }
        if primitive_default_trait(t, trnm) { return Ok(true) }
        if contains(self.lost_traits, trnm) { return Err(poisoned()) }   // maybe the left-out impl (MYLA-110)
        return Ok(false)
    }

    // --- scope -----------------------------------------------------------
    fun push_scope(var self) { push(self.frames, Frame { names: [], binds: [] }) }
    fun pop_scope(var self) { pop(self.frames) }
    fun define(var self, name: str, ty: Type, mutable: bool) -> bool {
        return self.define_at(name, ty, mutable, 0, 0, no_span())
    }
    // `define`, for a variable declared at `line`, `col`, `sp`.
    fun define_at(var self, name: str, ty: Type, mutable: bool, line: int32, col: int32, sp: SrcSpan) -> bool {
        let top = len(self.frames) - 1
        for nm in self.frames[top].names { if nm == name { return false } }
        push(self.frames[top].names, name)
        push(self.frames[top].binds, Binding { ty: ty, mutable: mutable, line: line, col: col, sp: sp, task: 0 })
        return true
    }
    // `define_at` for an `async let`'s name (D89): `ty` its result's type, if any.
    fun define_task(var self, name: str, ty: Option<Type>, line: int32, col: int32, sp: SrcSpan) -> bool {
        let top = len(self.frames) - 1
        for nm in self.frames[top].names { if nm == name { return false } }
        push(self.frames[top].names, name)
        let b = match ty {
            Some(t) => Binding { ty: t, mutable: false, line: line, col: col, sp: sp, task: 1 },
            None => Binding { ty: Type.TTuple([]), mutable: false, line: line, col: col, sp: sp, task: 2 },
        }
        push(self.frames[top].binds, b)
        return true
    }
    // The index of the frame that defines `name`, or -1.
    fun lookup_frame(self, name: str) -> int32 {
        var i = len(self.frames) - 1
        while i >= 0 {
            for nm in self.frames[i].names { if nm == name { return i } }
            i = i - 1
        }
        return -1
    }
    // Every name in scope, innermost scope first.
    fun scope_names(self) -> [str] {
        var out: [str] = []
        var i = len(self.frames) - 1
        while i >= 0 {
            for nm in self.frames[i].names { push(out, nm) }
            i = i - 1
        }
        return out
    }

    // --- notes (MYLA-65) -------------------------------------------------
    // A note on where the variable the assigned place `target` starts from is
    // declared (types.py: _declared_at).
    fun declared_at(self, target: Expr) -> [Note] {
        var e = target
        var going = true
        while going {
            match e.kind {
                ExprKind.GetField(t, f) => { e = t },
                ExprKind.Index(t, i) => { e = t },
                ExprKind.TupleIndex(t, i) => { e = t },
                _ => { going = false },
            }
        }
        match e.kind {
            ExprKind.Name(n) => {
                match self.lookup(n) {
                    Some(b) => { if b.line > 0 { return [note_at(format("'{}' is declared here", n), b.line, b.col, b.sp)] } },
                    None => {},
                }
            },
            _ => {},
        }
        return []
    }
    // A note on the declaration `name` repeats in the innermost scope (types.py:
    // _first_declared).
    fun first_declared(self, name: str) -> [Note] {
        let top = len(self.frames) - 1
        var j = 0
        while j < len(self.frames[top].names) {
            if self.frames[top].names[j] == name {
                let b = self.frames[top].binds[j]
                if b.line == 0 { return [] }
                return [note_at(format("'{}' is first declared here", name), b.line, b.col, b.sp)]
            }
            j = j + 1
        }
        return []
    }
    // The names a value can be: variables, constants, functions and the
    // prelude's variants (types.py: _value_names).
    fun value_names(self) -> [str] {
        var out = self.scope_names()
        for c in self.const_decls { push(out, c.name) }
        for f in self.functions { push(out, f.name) }
        for v in ["Some", "None", "Ok", "Err"] { push(out, v) }
        return out
    }
    // The names a call can name (types.py: _callable_names).
    fun callable_names(self) -> [str] {
        var out: [str] = []
        for f in self.functions { push(out, f.name) }
        for b in builtin_func_names() { push(out, b) }
        for nm in self.scope_names() { push(out, nm) }
        return out
    }
    // The names a type can be (types.py: _type_names).
    fun type_names(self) -> [str] {
        var out = primitive_type_names()
        push(out, "int")
        push(out, "float")
        for si in self.structs { push(out, si.name) }
        for ei in self.enums { push(out, ei.name) }
        for a in self.aliases { push(out, a.name) }
        for tp in self.type_params { push(out, tp) }
        return out
    }
    // The methods of the type with key `key`.
    fun method_names(self, key: Option<str>) -> [str] {
        var out: [str] = []
        match key {
            Some(k) => { for m in self.methods { if m.key == k { push(out, m.name) } } },
            None => {},
        }
        return out
    }
    // The index of the innermost frame defining `name`, or -1.
    fun frame_of(self, name: str) -> int32 {
        var i = len(self.frames) - 1
        while i >= 0 {
            for nm in self.frames[i].names { if nm == name { return i } }
            i = i - 1
        }
        return -1
    }

    fun lookup(self, name: str) -> Option<Binding> {
        var i = len(self.frames) - 1
        while i >= 0 {
            var j = 0
            while j < len(self.frames[i].names) {
                if self.frames[i].names[j] == name { return Some(self.frames[i].binds[j]) }
                j = j + 1
            }
            i = i - 1
        }
        return None
    }
}

fun int_type_name(w: int32, signed: bool) -> str {
    var p = "uint"
    if signed { p = "int" }
    return format("{}{}", p, w)
}

fun tp_names(tps: [TypeParam]) -> [str] {
    var out: [str] = []
    for tp in tps { push(out, tp.name) }
    return out
}

fun decl_kind_name(d: Decl) -> str {
    return match d.kind {
        DeclKind.StructDecl(n, f, a, t, p, act) => n,
        DeclKind.EnumDecl(n, v, a, t, p) => n,
        DeclKind.TypeAliasDecl(n, tt, a, p) => n,
        DeclKind.ConstDecl(n, tt, vv, a, p) => n,
        DeclKind.FunDecl(fd) => fd.name,
        DeclKind.TraitDecl(n, m, t, p) => n,
        _ => "",
    }
}

// =========================================================================
// Type resolution
// =========================================================================

impl Checker {
    fun resolve0(var self, ref: TypeExpr) -> Result<Type, CheckErr> {
        let empty: [str] = []
        return self.resolve(ref, empty)
    }

    fun resolve_list(var self, refs: [TypeExpr], visiting: [str]) -> Result<[Type], CheckErr> {
        var out: [Type] = []
        for r in refs { push(out, self.resolve(r, visiting)?) }
        return Ok(out)
    }

    fun resolve(var self, ref: TypeExpr, visiting: [str]) -> Result<Type, CheckErr> {
        let ln = ref.line
        let cl = ref.col
        let sp = ref.sp
        return match ref.kind {
            TypeKind.TTuple(elems) => Ok(Type.TTuple(self.resolve_list(elems, visiting)?)),
            TypeKind.TList(elem) => Ok(Type.TList(self.resolve(elem, visiting)?)),
            TypeKind.TMap(k, v) => {
                let kt = self.resolve(k, visiting)?
                let vt = self.resolve(v, visiting)?
                if !is_map_key(kt) && !contains_type_param(kt) && !has_error(kt) {
                    return Err(terr_at(ln, cl, sp, format("map key type must be a primitive (integer, char, bool, or str), found '{}'", type_name(kt))))
                }
                Ok(Type.TMap(kt, vt))
            },
            TypeKind.TFn(params, ret, asy) => {
                let ps = self.resolve_list(params, visiting)?
                let rt = self.resolve(ret, visiting)?
                Ok(func_type(ps, Some(rt), asy))
            },
            TypeKind.TRef(name, args) => self.resolve_ref(name, args, ln, cl, sp, visiting),
        }
    }

    fun resolve_ref(var self, name: str, args: [TypeExpr], ln: int32, cl: int32, sp: SrcSpan, visiting: [str]) -> Result<Type, CheckErr> {
        if name == "Self" {
            if !self.allow_self { return Err(terr_at(ln, cl, sp, "'Self' is only valid inside a trait declaration")) }
            if len(args) > 0 { return Err(terr_at(ln, cl, sp, "'Self' cannot take type arguments")) }
            return Ok(Type.TSelf)
        }
        if contains_str(self.type_params, name) {
            if len(args) > 0 { return Err(terr_at(ln, cl, sp, format("type parameter '{}' cannot take type arguments", name))) }
            return Ok(Type.TParam(name))
        }
        let si = self.struct_idx(name)
        let ei = self.enum_idx(name)
        if si >= 0 || ei >= 0 {
            var params: [str] = []
            if si >= 0 { params = self.structs[si].type_params } else { params = self.enums[ei].type_params }
            if len(params) > 0 || len(args) > 0 {
                if len(args) != len(params) { return Err(terr_at(ln, cl, sp, format("type '{}' expects {} type argument(s), got {}", name, len(params), len(args)))) }
                let ra = self.resolve_list(args, visiting)?
                if si >= 0 { return Ok(Type.TStruct(name, ra)) }
                return Ok(Type.TEnum(name, ra))
            }
            let none_args: [Type] = []
            if si >= 0 && self.is_actor(name) { return Ok(Type.TActor(name)) }
            if si >= 0 { return Ok(Type.TStruct(name, none_args)) }
            return Ok(Type.TEnum(name, none_args))
        }
        if len(args) > 0 { return Err(terr_at(ln, cl, sp, format("type '{}' is not generic (it takes no type arguments)", name))) }
        match prim_type(name) { Some(t) => { return Ok(t) }, None => {} }
        if self.alias_idx(name) >= 0 {
            match self.alias_cache_get(name) {
                Some(t) => {
                    if self.bodies && has_error(t) { return Err(poisoned()) }
                    return Ok(t)
                },
                None => {},
            }
            if contains_str(visiting, name) { return Err(terr_at(ln, cl, sp, format("type alias cycle involving '{}'", name))) }
            let ai = self.alias_idx(name)
            var v2 = visiting
            push(v2, name)
            let resolved = match self.resolve(self.aliases[ai].target, v2) {
                Ok(t) => t,
                Err(e) => {
                    // the alias is the error type from now on (MYLA-110)
                    if !is_poisoned(e) { push(self.alias_cache, AliasCached { name: name, ty: Type.TError }) }
                    return Err(e)
                },
            }
            push(self.alias_cache, AliasCached { name: name, ty: resolved })
            return Ok(resolved)
        }
        if name == "int" { return Ok(t_int()) }
        if name == "float" { return Ok(t_float()) }
        return Err(with_notes(terr_at(ln, cl, sp, format("unknown type '{}'", name)), did_you_mean(name, self.type_names())))
    }
}

// =========================================================================
// Global collection
// =========================================================================

impl Checker {
    fun collect_globals(var self) -> Result<int32, CheckErr> {
        var seen: [str: int32] = [:]       // name -> its first declaration's index
        // the prelude's declarations come first (check_program,
        // build_checker_decls); no note points at them
        let n_prelude = len(prelude(0).program.decls)
        var di = -1
        for decl in self.decls {
            di = di + 1
            self.cur_decl = decl.id
            let ln = decl.line
            let cl = decl.col
            let sp = decl.sp
            // a declaration that can't be collected is left out (MYLA-110)
            var fail: Option<CheckErr> = None
            let handled = match decl.kind {
                DeclKind.ImportDecl(p, items, alias, isp) => {
                    fail = Some(terr_at(ln, cl, sp, "imports need the module loader: this file was type-checked on its own (use 'myla check' or 'myla run')"))
                    true
                },
                DeclKind.ImplDecl(tg, m, tp, tn, ta) => { push(self.impl_decls, decl)
            true },
                DeclKind.TraitDecl(n, m, tp, isp) => {
                    if is_builtin_op_trait(n) { fail = Some(terr_at(ln, cl, sp, format("'{}' is a built-in operator trait and cannot be redeclared", n))) }
                    else { for td in self.trait_decls { if decl_kind_name(td) == n { fail = Some(terr_at(ln, cl, sp, format("duplicate trait '{}'", n))) } } }
                    match fail { Some(x) => {}, None => { push(self.trait_decls, decl) } }
                    true
                },
                _ => false,
            }
            if !handled {
                let name = decl_kind_name(decl)
                if is_builtin_func(name) {
                    self.redefined[name] = true
                    fail = Some(terr_at(ln, cl, sp, format("cannot redefine builtin '{}'", name)))
                } else if contains(seen, name) {
                    let fi = seen[name]
                    let first = self.decls[fi]
                    var notes: [Note] = []
                    if fi >= n_prelude { notes = [note_at(format("'{}' is first declared here", name), first.line, first.col, first.sp)] }
                    fail = Some(with_notes(terr_at(ln, cl, sp, format("duplicate top-level declaration '{}'", name)), notes))
                } else {
                    seen[name] = di
                    fail = self.actor_fail(decl)
                    match fail { Some(x) => {}, None => { self.register_decl(decl) } }
                }
            }
            match fail {
                Some(e) => {
                    self.record(e)?
                    self.skipped_decls[di] = true
                },
                None => {},
            }
        }
        return Ok(0)
    }

    // An actor's declaration: why it can't be collected (D89), else none; the
    // actor recorded.
    fun actor_fail(var self, decl: Decl) -> Option<CheckErr> {
        match decl.kind {
            DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => {
                if !act { return None }
                if len(tps) > 0 { return Some(terr_at(decl.line, decl.col, decl.sp, "an actor can't have type parameters")) }
                if len(attrs) > 0 { return Some(terr_at(attrs[0].line, attrs[0].col, attrs[0].sp, "an actor can't have attributes")) }
                self.actors[n] = true
                self.met_concurrency(decl.line, decl.col, decl.sp, decl.id)
            },
            _ => {},
        }
        return None
    }

    // Add `decl` to the tables; its parts are resolved later.
    fun register_decl(var self, decl: Decl) {
        let ln = decl.line
        let cl = decl.col
        let sp = decl.sp
        match decl.kind {
            DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => { self.add_struct(StructInfo { name: n, type_params: tp_names(tps), fields: [], line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.EnumDecl(n, variants, attrs, tps, isp) => { self.add_enum(EnumInfo { name: n, type_params: tp_names(tps), variants: [], line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.TypeAliasDecl(n, target, attrs, isp) => { push(self.aliases, AliasRaw { name: n, target: target, line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.ConstDecl(n, ty, value, attrs, isp) => { push(self.const_decls, ConstDeclT { name: n, declared: ty, value: value, line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.FunDecl(fd) => { self.add_function(FuncSig { name: fd.name, params: [], ret: None, type_params: [], bounds: [], decl: fd, has_decl: true, decl_id: decl.id }) },
            _ => {},
        }
    }

    // shadow built-in / duplicate type-parameter names
    fun check_type_params(self, tps: [str], ln: int32, cl: int32, sp: SrcSpan) -> Result<int32, CheckErr> {
        var seen: [str] = []
        for tp in tps {
            match prim_type(tp) { Some(x) => { return Err(terr_at(ln, cl, sp, format("type parameter '{}' shadows a built-in type name", tp))) }, None => {} }
            if tp == "int" { return Err(terr_at(ln, cl, sp, format("type parameter '{}' shadows a built-in type name", tp))) }
            if contains_str(seen, tp) { return Err(terr_at(ln, cl, sp, format("duplicate type parameter '{}'", tp))) }
            push(seen, tp)
        }
        return Ok(0)
    }

    // `te` resolved in a body, where a failed alias gives the error type
    // instead of poisoned() (types.py: _resolve_annotation).
    fun resolve_annotation(var self, te: TypeExpr) -> Result<Type, CheckErr> {
        match self.resolve0(te) {
            Ok(t) => { return Ok(t) },
            Err(e) => { if !is_poisoned(e) { return Err(e) } },
        }
        return Ok(Type.TError)
    }

    fun param_type(var self, p: Param) -> Result<Type, CheckErr> {
        return match p.ty {
            Some(te) => self.resolve0(te),
            None => Err(terr_at(p.line, p.col, p.sp, format("parameter '{}' needs a type", p.name))),   // unreachable: the parser requires one
        }
    }
}

fun build_bounds(tps: [TypeParam]) -> [Bound] {
    var out: [Bound] = []
    for tp in tps { if len(tp.bounds) > 0 { push(out, Bound { tp: tp.name, traits: tp.bounds }) } }
    return out
}

fun synth_typarams(names: [str]) -> [TypeParam] {
    var out: [TypeParam] = []
    for n in names { push(out, TypeParam { line: 0, col: 0, sp: no_span(), name: n, bounds: [] }) }
    return out
}

// =========================================================================
// Signature resolution
// =========================================================================

impl Checker {
    fun resolve_signatures(var self) -> Result<int32, CheckErr> {
        // aliases eagerly (catch cycles / bad targets even when unreferenced)
        // one that fails is the error type, and so is every alias naming it
        var ai = 0
        while ai < len(self.aliases) {
            let a = self.aliases[ai]
            self.cur_decl = a.id
            match self.alias_cache_get(a.name) {
                Some(t) => {},
                None => {
                    match self.resolve(a.target, [a.name]) {
                        Ok(t) => {},
                        Err(e) => {
                            self.record(e)?
                            push(self.alias_cache, AliasCached { name: a.name, ty: Type.TError })
                        },
                    }
                },
            }
            ai = ai + 1
        }
        // struct fields (under the struct's own type parameters)
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if contains(self.skipped_decls, pos) { continue }
            match decl.kind {
                DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => {
                    self.cur_decl = decl.id
                    self.record_result(self.check_type_params(tp_names(tps), decl.line, decl.col, decl.sp))?
                    self.type_params = tp_names(tps)
                    var fs: [FieldT] = []
                    for f in fields {
                        // a duplicate field is left out, one of a bad type has the error type
                        var dup = false
                        for prev in fs { if prev.name == f.name { dup = true } }
                        if dup {
                            self.record(terr_at(f.line, f.col, f.sp, format("duplicate field '{}' in struct '{}'", f.name, n)))?
                            continue
                        }
                        let ft = self.resolve_part(f.ty)?
                        push(fs, FieldT { name: f.name, ty: ft })
                    }
                    self.type_params = []
                    let idx = self.struct_idx(n)
                    self.structs[idx] = StructInfo { name: n, type_params: tp_names(tps), fields: fs, line: decl.line, col: decl.col, sp: decl.sp, id: decl.id }
                },
                _ => {},
            }
        }
        // enum variants & payloads (under the enum's type parameters)
        pos = -1
        for decl in self.decls {
            pos = pos + 1
            if contains(self.skipped_decls, pos) { continue }
            match decl.kind {
                DeclKind.EnumDecl(n, variants, attrs, tps, isp) => {
                    self.cur_decl = decl.id
                    self.record_result(self.check_type_params(tp_names(tps), decl.line, decl.col, decl.sp))?
                    self.type_params = tp_names(tps)
                    var vs: [VariantT] = []
                    for v in variants {
                        var dup = false
                        for prev in vs { if prev.name == v.name { dup = true } }
                        if dup {
                            self.record(terr_at(v.line, v.col, v.sp, format("duplicate variant '{}' in enum '{}'", v.name, n)))?
                            continue
                        }
                        var payload: [Type] = []
                        for p in v.payload { push(payload, self.resolve_part(p)?) }
                        push(vs, VariantT { name: v.name, payload: payload })
                    }
                    self.type_params = []
                    let idx = self.enum_idx(n)
                    self.enums[idx] = EnumInfo { name: n, type_params: tp_names(tps), variants: vs, line: decl.line, col: decl.col, sp: decl.sp, id: decl.id }
                },
                _ => {},
            }
        }
        self.resolve_recursion()?
        // function signatures (under the function's own type parameters)
        pos = -1
        for decl in self.decls {
            pos = pos + 1
            if contains(self.skipped_decls, pos) { continue }
            match decl.kind {
                DeclKind.FunDecl(fd) => {
                    self.cur_decl = decl.id
                    self.record_result(self.check_type_params(tp_names(fd.type_params), fd.line, fd.col, fd.sp))?
                    self.type_params = tp_names(fd.type_params)
                    var ps: [Type] = []
                    for p in fd.params { push(ps, self.param_part(p)?) }
                    var rt: Option<Type> = None
                    match fd.ret_type { Some(te) => { rt = Some(self.resolve_part(te)?) }, None => {} }
                    self.type_params = []
                    let idx = self.func_idx(fd.name)
                    self.functions[idx] = FuncSig { name: fd.name, params: ps, ret: rt, type_params: tp_names(fd.type_params), bounds: build_bounds(fd.type_params), decl: fd, has_decl: true, decl_id: decl.id }
                },
                _ => {},
            }
        }
        return Ok(0)
    }
}

// =========================================================================
// Recursion classification (boxed enums vs unrepresentable cycles)
// =========================================================================

pub struct AggRef { name: str, is_enum: bool }

impl Checker {
    fun member_types(self, name: str) -> [Type] {
        let si = self.struct_idx(name)
        if si >= 0 {
            var out: [Type] = []
            for f in self.structs[si].fields { push(out, f.ty) }
            return out
        }
        let ei = self.enum_idx(name)
        var out2: [Type] = []
        if ei >= 0 {
            for v in self.enums[ei].variants { for p in v.payload { push(out2, p) } }
        }
        return out2
    }

    fun find_cycle(self, root: str, current: str, seen: [str], stop_at_boxed: bool) -> bool {
        for m in self.member_types(current) {
            for ar in agg_refs(m) {
                if stop_at_boxed && ar.is_enum && contains_str(self.recursive_enums, ar.name) { continue }
                if ar.name == root { return true }
                if contains_str(seen, ar.name) { continue }
                var s2 = seen
                push(s2, ar.name)
                if self.find_cycle(root, ar.name, s2, stop_at_boxed) { return true }
            }
        }
        return false
    }

    fun resolve_recursion(var self) -> Result<int32, CheckErr> {
        for e in self.enums {
            if self.find_cycle(e.name, e.name, [e.name], false) {
                if !contains_str(self.recursive_enums, e.name) { push(self.recursive_enums, e.name) }
            }
        }
        for e in self.enums {
            if self.find_cycle(e.name, e.name, [e.name], true) {
                self.cur_decl = e.id
                self.record(terr_at(e.line, e.col, e.sp, format("recursive enum '{}' would have infinite size; only enums can be recursive (they are boxed) — wrap the cycle in an enum to introduce indirection", e.name)))?
            }
        }
        for s in self.structs {
            if self.find_cycle(s.name, s.name, [s.name], true) {
                self.cur_decl = s.id
                self.record(terr_at(s.line, s.col, s.sp, format("recursive struct '{}' would have infinite size; only enums can be recursive (they are boxed) — wrap the cycle in an enum to introduce indirection", s.name)))?
            }
        }
        return Ok(0)
    }
}

fun agg_refs(t: Type) -> [AggRef] {
    var out: [AggRef] = []
    match t {
        Type.TStruct(n, args) => { push(out, AggRef { name: n, is_enum: false })
            for a in args { for r in agg_refs(a) { push(out, r) } } },
        Type.TEnum(n, args) => { push(out, AggRef { name: n, is_enum: true })
            for a in args { for r in agg_refs(a) { push(out, r) } } },
        Type.TTuple(es) => { for e in es { for r in agg_refs(e) { push(out, r) } } },
        _ => {},
    }
    return out
}

// =========================================================================
// Traits
// =========================================================================

impl Checker {
    fun register_builtin_op_traits(var self) {
        push(self.traits, TraitInfo { name: "Add", methods: [TraitMethodSig { name: "add", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        push(self.traits, TraitInfo { name: "Sub", methods: [TraitMethodSig { name: "sub", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        push(self.traits, TraitInfo { name: "Mul", methods: [TraitMethodSig { name: "mul", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        push(self.traits, TraitInfo { name: "Div", methods: [TraitMethodSig { name: "div", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        push(self.traits, TraitInfo { name: "Rem", methods: [TraitMethodSig { name: "rem", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        push(self.traits, TraitInfo { name: "Eq", methods: [TraitMethodSig { name: "eq", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TBool), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        push(self.traits, TraitInfo { name: "Ord", methods: [TraitMethodSig { name: "cmp", params: [Type.TSelf, Type.TSelf], ret: Some(t_int()), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
    }

    fun resolve_traits(var self) -> Result<int32, CheckErr> {
        self.register_builtin_op_traits()
        for decl in self.trait_decls {
            self.cur_decl = decl.id
            match decl.kind {
                DeclKind.TraitDecl(name, methods, tps, isp) => {
                    // check trait type params: no Self, no dup
                    var seen: [str] = []
                    var tp_fail: Option<CheckErr> = None
                    for p in tps {
                        match tp_fail {
                            Some(x) => {},
                            None => {
                                if p.name == "Self" { tp_fail = Some(terr_at(decl.line, decl.col, decl.sp, format("trait '{}' cannot use 'Self' as a type parameter", name))) }
                                else if contains_str(seen, p.name) { tp_fail = Some(terr_at(decl.line, decl.col, decl.sp, format("duplicate type parameter '{}' on trait '{}'", p.name, name))) }
                                push(seen, p.name)
                            },
                        }
                    }
                    match tp_fail { Some(e) => { self.record(e)? }, None => {} }
                    var msigs: [TraitMethodSig] = []
                    for m in methods {
                        var dup = false
                        for prev in msigs { if prev.name == m.name { dup = true } }
                        if dup {
                            self.record(terr_at(m.line, m.col, m.sp, format("duplicate method '{}' in trait '{}'", m.name, name)))?
                            continue
                        }
                        if m.is_async {
                            self.record(terr_at(m.line, m.col, m.sp, "a trait method can't be async"))?
                            continue
                        }
                        self.allow_self = true
                        self.type_params = tp_names(tps)
                        var params: [Type] = [Type.TSelf]
                        for p in m.params { push(params, self.param_part(p)?) }
                        var rt: Option<Type> = None
                        match m.ret_type { Some(te) => { rt = Some(self.resolve_part(te)?) }, None => {} }
                        self.allow_self = false
                        self.type_params = []
                        let recv = match m.receiver { Some(r) => r, None => "self" }
                        push(msigs, TraitMethodSig { name: m.name, params: params, ret: rt, receiver: recv })
                    }
                    push(self.traits, TraitInfo { name: name, methods: msigs, type_params: tp_names(tps), builtin: false, line: decl.line, col: decl.col })
                },
                _ => {},
            }
        }
        return Ok(0)
    }
}

fun subst_self(t: Type, target: Type, pmap: [Subst]) -> Type {
    return match t {
        Type.TSelf => target,
        Type.TParam(n) => match subst_get(pmap, n) { Some(x) => x, None => t },
        Type.TList(e) => Type.TList(subst_self(e, target, pmap)),
        Type.TMap(k, v) => Type.TMap(subst_self(k, target, pmap), subst_self(v, target, pmap)),
        Type.TTuple(es) => {
            var o: [Type] = []
            for e in es { push(o, subst_self(e, target, pmap)) }
            Type.TTuple(o)
        },
        Type.TFunc(ps, r) => {
            var o: [Type] = []
            for p in ps { push(o, subst_self(p, target, pmap)) }
            Type.TFunc(o, match r { Some(rt) => Some(subst_self(rt, target, pmap)), None => None })
        },
        Type.TAsync(f) => Type.TAsync(subst_self(f, target, pmap)),
        Type.TStruct(n, a) => {
            var o: [Type] = []
            for x in a { push(o, subst_self(x, target, pmap)) }
            Type.TStruct(n, o)
        },
        Type.TEnum(n, a) => {
            var o: [Type] = []
            for x in a { push(o, subst_self(x, target, pmap)) }
            Type.TEnum(n, o)
        },
        _ => t,
    }
}

fun opt_subst_self(t: Option<Type>, target: Type, pmap: [Subst]) -> Option<Type> {
    return match t { Some(x) => Some(subst_self(x, target, pmap)), None => None }
}

// =========================================================================
// Impl blocks & methods
// =========================================================================

impl Checker {
    fun resolve_impls(var self) -> Result<int32, CheckErr> {
        for decl in self.impl_decls {
            self.cur_decl = decl.id
            match decl.kind {
                DeclKind.ImplDecl(target_te, methods, tps, trait_name, trait_args_te) => {
                    self.resolve_impl(decl, target_te, methods, tps, trait_name, trait_args_te)?
                },
                _ => {},
            }
        }
        return Ok(0)
    }

    // One `impl`, its errors collected as it goes (MYLA-110; types.py:
    // _resolve_impl): an impl whose target can't be resolved, can't have
    // methods, or repeats a trait impl is left out; one of an unknown trait
    // keeps its methods; one that doesn't conform leaves the pair broken.
    fun resolve_impl(var self, decl: Decl, target_te: TypeExpr, methods: [FunData], tps: [TypeParam], trait_name: Option<str>, trait_args_te: [TypeExpr]) -> Result<int32, CheckErr> {
        let ln = decl.line
        let cl = decl.col
        let sp = decl.sp
        self.record_result(self.check_type_params(tp_names(tps), ln, cl, sp))?
        self.type_params = tp_names(tps)
        let target = self.resolve_part(target_te)?
        var trait_args: [Type] = []
        for a in trait_args_te { push(trait_args, self.resolve_part(a)?) }
        self.type_params = []
        var key_opt: Option<str> = None
        var target_ok = !has_error(target)
        if target_ok {
            let k0 = match self.type_key(target) { Some(k) => k, None => "" }
            let has_trait = match trait_name { Some(tn) => true, None => false }
            if has_trait && self.is_actor(k0) {
                // a trait's methods are called without `await` (D89)
                self.record(terr_at(ln, cl, sp, "an actor can't implement a trait"))?
                self.lose_impl(methods, trait_name)
                return Ok(0)
            }
        }
        if target_ok {
            key_opt = self.type_key(target)
            match self.check_impl_target(ln, cl, sp, target, key_opt, tps, methods) {
                Ok(x) => {},
                Err(e) => {
                    self.record(e)?
                    target_ok = false
                },
            }
        }
        if !target_ok {
            match key_opt {
                Some(k) => {},
                None => {
                    self.lose_impl(methods, trait_name)
                    return Ok(0)
                },
            }
        }
        let key = match key_opt { Some(k) => k, None => "" }
        // trait binding
        var have_trait = false
        var conforms = true
        var pmap: [Subst] = []
        var tinfo = TraitInfo { name: "", methods: [], type_params: [], builtin: false, line: 0, col: 0 }
        match trait_name {
            Some(tn) => {
                let ti = self.trait_idx(tn)
                if ti < 0 {
                    self.record(terr_at(ln, cl, sp, format("unknown trait '{}' in 'impl {} for {}'", tn, tn, key)))?
                } else {
                    tinfo = self.traits[ti]
                    have_trait = true
                    if len(trait_args) != len(tinfo.type_params) {
                        var expected = tn
                        if len(tinfo.type_params) > 0 { expected = format("{}<{}>", tn, join_strs(tinfo.type_params, ", ")) }
                        self.record(terr_at(ln, cl, sp, format("trait '{}' expects {} type argument(s), got {} (use 'impl {} for {}')", tn, len(tinfo.type_params), len(trait_args), expected, key)))?
                        conforms = false
                    } else {
                        var pi = 0
                        while pi < len(tinfo.type_params) {
                            push(pmap, Subst { name: tinfo.type_params[pi], ty: trait_args[pi] })
                            pi = pi + 1
                        }
                    }
                    var dup = false
                    for p in self.user_trait_impls { if p.trait_name == tn && p.key == key { dup = true } }
                    if dup {
                        self.record(terr_at(ln, cl, sp, format("duplicate impl of trait '{}' for type '{}' (at most one user impl per trait/type pair)", tn, key)))?
                        return Ok(0)
                    }
                    push(self.user_trait_impls, TraitImplPair { trait_name: tn, key: key })
                }
            },
            None => {},
        }
        // field names for collision check
        var field_names: [str] = []
        let si = self.struct_idx(key)
        if si >= 0 { for f in self.structs[si].fields { push(field_names, f.name) } }
        for m in methods {
            // a method that can't be added is left out, body and all
            var bad: Option<CheckErr> = None
            match self.method_sig(key, m.name) { Some(x) => { bad = Some(terr_at(m.line, m.col, m.sp, format("duplicate method '{}' for type '{}'", m.name, key))) }, None => {} }
            match bad {
                Some(x) => {},
                None => { if contains_str(field_names, m.name) { bad = Some(terr_at(m.line, m.col, m.sp, format("method '{}' collides with a field of '{}'", m.name, key))) } },
            }
            match bad {
                Some(e) => { self.record(e)? },
                None => { self.register_method(target_te, key, tps, m, decl.id)? },
            }
        }
        if have_trait {
            if conforms {
                var impl_names: [str] = []
                for m in methods { push(impl_names, m.name) }
                match self.check_trait_conformance(ln, cl, sp, key, target, tinfo, pmap, impl_names) {
                    Ok(ok) => { conforms = ok },
                    Err(e) => {
                        self.record(e)?
                        conforms = false
                    },
                }
            }
            match trait_name {
                Some(tn) => {
                    if !conforms { self.broken_impls[tn + "\t" + key] = true }
                    push(self.trait_impls, TraitImplPair { trait_name: tn, key: key })
                },
                None => {},
            }
        }
        return Ok(0)
    }

    // Leave out an impl whose type is unknown: a missing method or trait impl
    // of its names ends a check silently (MYLA-110).
    fun lose_impl(var self, methods: [FunData], trait_name: Option<str>) {
        for m in methods { self.lost_methods[m.name] = true }
        match trait_name { Some(tn) => { self.lost_traits[tn] = true }, None => {} }
    }

    // Whether an impl may add methods to `target` (types.py: _check_impl_target).
    fun check_impl_target(self, ln: int32, cl: int32, sp: SrcSpan, target: Type, key_opt: Option<str>, tps: [TypeParam], methods: [FunData]) -> Result<int32, CheckErr> {
        let is_agg = match target { Type.TStruct(n, a) => true, Type.TEnum(n, a) => true, Type.TActor(n) => true, _ => false }
        if is_agg {
            let targs = match target { Type.TStruct(n, a) => a, Type.TEnum(n, a) => a, _ => empty_types() }
            if len(tps) > 0 {
                var want: [Type] = []
                for p in tps { push(want, Type.TParam(p.name)) }
                if !type_list_eq(targs, want) { return Err(terr_at(ln, cl, sp, format("a generic impl must apply to '{}<{}>' with its type parameters in order", key_or_none(key_opt), join_strs(tp_names(tps), ", ")))) }
            } else {
                if len(targs) > 0 { return Err(terr_at(ln, cl, sp, format("cannot 'impl' on a concrete generic instantiation; write 'impl<T> {}<T> {{ ... }}' to cover every instance", key_or_none(key_opt)))) }
            }
            return Ok(0)
        }
        match key_opt {
            Some(k) => {
                if len(tps) > 0 { return Err(terr_at(ln, cl, sp, "generic impls on built-in types are not supported yet (v0.4.1 covers concrete built-in receivers)")) }
                for m in methods { if match m.receiver { Some(r) => r == "var self", None => false } { return Err(terr_at(m.line, m.col, m.sp, "'var self' methods on built-in types are not supported yet; use a read-only 'self' receiver")) } }
            },
            None => { return Err(terr_at(ln, cl, sp, format("cannot 'impl' on type '{}'; v0.4.1 supports structs, enums, and concrete scalar / str / StringBuilder receivers", type_name(target)))) },
        }
        return Ok(0)
    }

    fun register_method(var self, target_te: TypeExpr, key: str, impl_tps: [TypeParam], m: FunData, impl_id: int32) -> Result<int32, CheckErr> {
        let mangled = format("{}.{}", key, m.name)
        var combined_names: [str] = []
        for t in impl_tps { push(combined_names, t.name) }
        for t in m.type_params { push(combined_names, t.name) }
        let combined_bounds = merge_bounds(build_bounds(impl_tps), build_bounds(m.type_params))
        self.record_result(self.check_type_params(combined_names, m.line, m.col, m.sp))?
        self.type_params = combined_names
        let self_t = self.resolve_part(target_te)?
        var params: [Type] = [self_t]
        for p in m.params { push(params, self.param_part(p)?) }
        var rt: Option<Type> = None
        match m.ret_type { Some(te) => { rt = Some(self.resolve_part(te)?) }, None => {} }
        self.type_params = []
        // synthesize a self parameter so the body checker binds `self`
        var sparams: [Param] = [Param { line: m.line, col: m.col, sp: no_span(), name: "self", ty: Some(target_te) }]
        for p in m.params { push(sparams, p) }
        let fdecl = FunData {
            line: m.line, col: m.col, sp: m.sp, name: mangled, params: sparams,
            ret_type: m.ret_type, body: m.body, attributes: [],
            type_params: synth_typarams(combined_names), receiver: m.receiver, is_pub: false, is_async: m.is_async,
        }
        let sig = FuncSig { name: mangled, params: params, ret: rt, type_params: combined_names, bounds: combined_bounds, decl: fdecl, has_decl: true, decl_id: impl_id }
        self.add_function(sig)
        self.add_method(MethodEntry { key: key, name: m.name, sig: sig })
        push(self.method_decls, fdecl)
        push(self.method_decl_keys, key)
        push(self.method_decl_ids, impl_id)
        return Ok(0)
    }

    // Ok(false): a method that failed earlier couldn't be compared (MYLA-110).
    fun check_trait_conformance(var self, ln: int32, cl: int32, sp: SrcSpan, key: str, target: Type, trinfo: TraitInfo, pmap: [Subst], impl_names: [str]) -> Result<bool, CheckErr> {
        // missing: trait methods not provided by this impl
        var missing: [str] = []
        for tm in trinfo.methods {
            if !contains_str(impl_names, tm.name) && !contains_str(missing, tm.name) { push(missing, tm.name) }
        }
        if len(missing) > 0 {
            return Err(terr_at(ln, cl, sp, format("impl of trait '{}' for '{}' is missing method(s): {}", trinfo.name, key, join_strs(sorted_strs(missing), ", "))))
        }
        // extra: impl methods not declared by the trait
        var extra: [str] = []
        for nm in impl_names {
            var in_trait = false
            for tm in trinfo.methods { if tm.name == nm { in_trait = true } }
            if !in_trait && !contains_str(extra, nm) { push(extra, nm) }
        }
        if len(extra) > 0 {
            return Err(terr_at(ln, cl, sp, format("impl of trait '{}' for '{}' declares method(s) not in the trait: {}", trinfo.name, key, join_strs(sorted_strs(extra), ", "))))
        }
        var broken = false
        for tm in trinfo.methods {
            let sig_opt = self.method_sig(key, tm.name)
            if match sig_opt { Some(x) => false, None => true } {
                broken = true          // left out (MYLA-110)
                continue
            }
            let sig = match sig_opt { Some(x) => x, None => { return Ok(false) } }
            let recv = match sig.decl.receiver { Some(r) => r, None => "self" }
            if recv != tm.receiver {
                return Err(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("method '{}' in impl of trait '{}' for '{}' has receiver '{}' but the trait declares '{}'", tm.name, trinfo.name, key, recv, tm.receiver)))
            }
            var exp_params: [Type] = []
            for p in tm.params { push(exp_params, subst_self(p, target, pmap)) }
            let exp_ret = opt_subst_self(tm.ret, target, pmap)
            if sig_has_error(exp_params, exp_ret) || sig_has_error(sig.params, sig.ret) {
                broken = true          // one side failed and had its error: no comparison
                continue
            }
            if !type_list_eq(sig.params, exp_params) || !opt_type_eq(sig.ret, exp_ret) {
                var rest: [Type] = []
                var k = 1
                while k < len(exp_params) {
                    push(rest, exp_params[k])
                    k = k + 1
                }
                return Err(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("method '{}' in impl of trait '{}' for '{}' does not match the trait signature (expected '({}) -> {}')", tm.name, trinfo.name, key, type_names(rest), opt_type_name(exp_ret))))
            }
        }
        return Ok(!broken)
    }

    // A bad bound is left out, so calls don't check it, and the function's
    // body, which may rely on it, isn't checked (MYLA-110).
    fun validate_bounds(var self) -> Result<int32, CheckErr> {
        var fi = 0
        while fi < len(self.functions) {
            let sig = self.functions[fi]
            self.cur_decl = sig.decl_id
            var kept: [Bound] = []
            var changed = false
            for b in sig.bounds {
                if !contains_str(sig.type_params, b.tp) {
                    self.record(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("bound on unknown type parameter '{}'", b.tp)))?
                    changed = true
                    continue
                }
                var good: [str] = []
                for tr in b.traits {
                    if self.trait_idx(tr) < 0 {
                        self.record(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("unknown trait '{}' in bound '{}: {}'", tr, b.tp, tr)))?
                        changed = true
                    } else {
                        push(good, tr)
                    }
                }
                push(kept, Bound { tp: b.tp, traits: good })
            }
            if changed {
                self.skipped_fns[sig.name] = true
                var s2 = sig
                s2.bounds = kept
                self.functions[fi] = s2
                // a method's entry has its own copy of the signature
                var mi = 0
                while mi < len(self.methods) {
                    if self.methods[mi].sig.name == sig.name {
                        var m2 = self.methods[mi]
                        m2.sig = s2
                        self.methods[mi] = m2
                    }
                    mi = mi + 1
                }
            }
            fi = fi + 1
        }
        return Ok(0)
    }
}

// A method key as Python's f-strings print it (`None` for no key).
fun key_or_none(k: Option<str>) -> str {
    return match k { Some(x) => x, None => "None" }
}

fun merge_bounds(a: [Bound], b: [Bound]) -> [Bound] {
    var out: [Bound] = []
    for x in a { push(out, x) }
    for y in b { push(out, y) }
    return out
}

fun field_type_get(fields: [FieldT], name: str) -> Option<Type> {
    for f in fields { if f.name == name { return Some(f.ty) } }
    return None
}

// =========================================================================
// Aggregate-instance helpers
// =========================================================================

impl Checker {
    fun struct_field_types(self, name: str, args: [Type]) -> [FieldT] {
        let si = self.struct_idx(name)
        if si < 0 { return [] }
        let info = self.structs[si]
        if len(info.type_params) == 0 { return info.fields }
        var subst: [Subst] = []
        var i = 0
        while i < len(info.type_params) { push(subst, Subst { name: info.type_params[i], ty: args[i] })
            i = i + 1 }
        var out: [FieldT] = []
        for f in info.fields { push(out, FieldT { name: f.name, ty: subst_type(f.ty, subst) }) }
        return out
    }
    fun enum_variant_payload(self, name: str, args: [Type], variant: str) -> Option<[Type]> {
        let ei = self.enum_idx(name)
        if ei < 0 { return None }
        let info = self.enums[ei]
        var found = false
        var payload: [Type] = []
        for v in info.variants { if v.name == variant { found = true
            payload = v.payload } }
        if !found { return None }
        if len(info.type_params) == 0 { return Some(payload) }
        if len(args) < len(info.type_params) { return Some(payload) }
        var subst: [Subst] = []
        var i = 0
        while i < len(info.type_params) { push(subst, Subst { name: info.type_params[i], ty: args[i] })
            i = i + 1 }
        return Some(subst_type_list(payload, subst))
    }
    fun enum_variant_names(self, name: str) -> [str] {
        let ei = self.enum_idx(name)
        var out: [str] = []
        if ei >= 0 { for v in self.enums[ei].variants { push(out, v.name) } }
        return out
    }
    fun enum_has_variant(self, name: str, variant: str) -> bool {
        return contains_str(self.enum_variant_names(name), variant)
    }
    // a bare no-payload variant name of enum `name`?
    fun is_novpayload_variant(self, name: str, variant: str) -> bool {
        return match self.enum_variant_payload(name, [], variant) {
            Some(p) => len(p) == 0,
            None => false,
        }
    }
    fun enum_name_ref(self, e: Expr) -> Option<str> {
        match e.kind {
            ExprKind.Name(n) => {
                let shadowed = match self.lookup(n) { Some(x) => true, None => false }
                if self.is_enum(n) && !shadowed { return Some(n) }
            },
            _ => {},
        }
        return None
    }
}

// =========================================================================
// Expression typing
// =========================================================================

impl Checker {
    fun expect_value(var self, e: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        return match self.infer(e, expected)? {
            Some(t) => Ok(t),
            None => Err(terr_at(e.line, e.col, e.sp, "expression does not produce a value")),
        }
    }

    // `e` must have type `want`; `ctx` names it in the message ("if condition").
    fun expect_type(var self, e: Expr, want: Type, ctx: str) -> Result<int32, CheckErr> {
        let t = self.expect_value(e, Some(want))?
        if !type_eq(t, want) { return Err(terr_at(e.line, e.col, e.sp, format("{} must be '{}', found '{}'", ctx, type_name(want), type_name(t)))) }
        return Ok(0)
    }

    // `e`'s type; poisoned() where it contains the error type, since what uses
    // the value depends on a declaration that failed (MYLA-110).
    fun infer(var self, e: Expr, expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        let r = self.infer_node(e, expected)?
        if opt_has_error(r) { return Err(poisoned()) }
        return Ok(r)
    }

    fun infer_node(var self, e: Expr, expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        let as_stmt = self.stmt_match
        self.stmt_match = false
        let r: Result<Option<Type>, CheckErr> = match e.kind {
            ExprKind.IntLit(v, suf, isc, big) => Ok(Some(self.infer_int_lit(e, expected)?)),
            ExprKind.FloatLit(lex, suf) => Ok(Some(self.infer_float_lit(e, expected)?)),
            ExprKind.StrLit(s) => Ok(Some(Type.TStr)),
            ExprKind.BoolLit(b) => Ok(Some(Type.TBool)),
            ExprKind.Name(n) => Ok(Some(self.infer_name(e, n, expected)?)),
            ExprKind.Unary(op, x) => Ok(Some(self.infer_unary(e, op, x, expected)?)),
            ExprKind.Binary(op, l, r) => Ok(Some(self.infer_binary(e, op, l, r, expected)?)),
            ExprKind.Call(c, args) => {
                self.call_kind_id = -1
                let rc = self.infer_call(e, c, args, expected)
                // a call that may suspend stands under `await` (D89); marked
                // calls succeeded
                if self.call_kind_id == e.id && (self.call_async || len(self.actors) > 0) { self.check_suspension(e, c)? }
                rc
            },
            ExprKind.GetField(t, name) => Ok(Some(self.infer_field(e, t, name, expected)?)),
            ExprKind.StructLit(name, fields) => Ok(Some(self.infer_struct_lit(e, name, fields, expected)?)),
            ExprKind.TupleLit(elems) => Ok(Some(self.infer_tuple_lit(e, elems, expected)?)),
            ExprKind.TupleIndex(t, idx) => Ok(Some(self.infer_tuple_index(e, t, idx)?)),
            ExprKind.ListLit(elems) => Ok(Some(self.infer_list_lit(e, elems, expected)?)),
            ExprKind.MapLit(entries) => Ok(Some(self.infer_map_lit(e, entries, expected)?)),
            ExprKind.Index(t, i) => Ok(Some(self.infer_index(e, t, i)?)),
            ExprKind.MatchE(s, arms) => self.infer_match(e, s, arms, expected, as_stmt),
            ExprKind.Try(x) => Ok(Some(self.infer_try(e, x)?)),
            ExprKind.Cast(x, ty) => Ok(Some(self.infer_cast(e, x, ty)?)),
            ExprKind.Lambda(ps, ret, body, asy) => Ok(Some(self.infer_lambda(e, ps, ret, body, asy, expected)?)),
            ExprKind.Await(x) => self.infer_await(e, x, expected),
            ExprKind.Hole => Err(terr_at(e.line, e.col, e.sp, "'_' placeholder is only valid as a call argument")),
        }
        match r { Ok(om) => { self.record_type(e.id, om) }, Err(x) => {} }
        return r
    }

    fun record_type(var self, id: int32, ot: Option<Type>) {
        match ot { Some(t) => { self.resolved[id] = t }, None => {} }
    }

    fun infer_int_lit(var self, e: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        return match e.kind {
            ExprKind.IntLit(v, suf, isc, big) => {
                var t = t_int()
                if isc {
                    let useint = match expected { Some(et) => is_int(et) && v <= 127, None => false }
                    if useint { t = match expected { Some(et) => et, None => t_int() } } else { return Ok(Type.TChar) }
                } else {
                    match suf {
                        Some(sx) => {
                            t = match int_suffix_type(sx) {
                                Some(st) => st,
                                None => { return Err(terr_at(e.line, e.col, e.sp, format("invalid integer literal suffix '{}'", sx))) },   // unreachable: the lexer checks it
                            }
                        },
                        None => {
                            t = int_lit_expected_default(expected, t)
                        },
                    }
                }
                let w = match t { Type.TInt(ww, ss) => ww, _ => 32 }
                let sg = match t { Type.TInt(ww, ss) => ss, _ => true }
                if !lit_fits(v, big, w, sg) { return Err(terr_at(e.line, e.col, e.sp, format("integer literal {} does not fit in '{}'", int_text(v, big), type_name(t)))) }
                Ok(t)
            },
            _ => Err(terr_at(e.line, e.col, e.sp, "expected an integer literal")),   // unreachable
        }
    }

    fun infer_float_lit(var self, e: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        match e.kind {
            ExprKind.FloatLit(lex, suf) => {
                match suf {
                    Some(sx) => {
                        return match float_suffix_type(sx) {
                            Some(ft) => Ok(ft),
                            None => Err(terr_at(e.line, e.col, e.sp, format("invalid float literal suffix '{}'", sx))),   // unreachable: the lexer checks it
                        }
                    },
                    None => {},
                }
                match expected {
                    Some(et) => {
                        if is_float(et) { return Ok(et) }
                    },
                    None => {},
                }
                return Ok(t_float())
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, "expected a float literal"))   // unreachable
    }

    fun infer_name(var self, e: Expr, ident: str, expected: Option<Type>) -> Result<Type, CheckErr> {
        if ident == "_" { return Err(terr_at(e.line, e.col, e.sp, "'_' placeholder is only valid as a call argument")) }
        match self.lookup(ident) {
            Some(b) => {
                if b.task > 0 { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is the result of a child task: read it with 'await {}'", ident, ident))) }
                if len(self.lams) > 0 && self.actor_self != "" && ident == "self" {
                    // types.py: _record_capture
                    let d = self.lookup_frame(ident)
                    for lam in self.lams {
                        if d < lam.base { return Err(terr_at(lam.line, lam.col, lam.sp, format("a lambda can't capture the actor '{}''s 'self': its state stays with its own methods", self.actor_self))) }
                    }
                }
                return Ok(b.ty)
            },
            None => {},
        }
        if self.const_decl_idx(ident) >= 0 {
            return self.ensure_const(ident)
        }
        match prelude_variant_enum(ident) {
            Some(en) => { return self.infer_bare_variant(e, en, ident, expected) },
            None => {},
        }
        // D96: the compiler takes its calls; as a value it would do nothing
        if ident == "std$task$cancel" { return Err(terr_at(e.line, e.col, e.sp, "task.cancel can only be called, with the name of an 'async let'")) }
        if self.func_idx(ident) >= 0 {
            // a non-method top-level function referenced as a value
            return self.infer_fun_value(e, ident)
        }
        if contains(self.redefined, ident) { return Err(poisoned()) }
        if is_builtin_func(ident) { return Err(terr_at(e.line, e.col, e.sp, format("'{}' cannot be used as a value here", ident))) }
        return Err(with_notes(terr_at(e.line, e.col, e.sp, format("unknown name '{}'", ident)), did_you_mean(ident, self.value_names())))
    }

    fun infer_fun_value(self, e: Expr, ident: str) -> Result<Type, CheckErr> {
        let idx = self.func_idx(ident)
        let sig = self.functions[idx]
        if len(sig.type_params) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("generic function '{}' cannot be used as a value (its type parameters are unresolved)", ident))) }
        return Ok(func_type(sig.params, sig.ret, sig.decl.is_async))
    }

    fun infer_bare_variant(var self, e: Expr, enum_name: str, variant: str, expected: Option<Type>) -> Result<Type, CheckErr> {
        let payload = match self.enum_variant_payload(enum_name, [], variant) { Some(p) => p, None => { return Err(terr_at(e.line, e.col, e.sp, format("enum '{}' has no variant '{}'", enum_name, variant))) } }
        if len(payload) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("variant '{}' carries a payload; call it like '{}(...)'", variant, variant))) }
        let ei = self.enum_idx(enum_name)
        let nparams = len(self.enums[ei].type_params)
        match expected {
            Some(et) => { if enum_type_matches(et, enum_name, nparams) { return Ok(et) } },
            None => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type argument(s) for '{}'; annotate the binding (e.g. ': {}<...>')", variant, enum_name)))
    }

    fun infer_unary(var self, e: Expr, op: str, x: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        if op == "-" {
            let hint = num_hint(expected)
            let t = self.expect_value(x, hint)?
            if !(is_int(t) || is_float(t)) { return Err(terr_at(e.line, e.col, e.sp, "unary '-' requires a numeric operand")) }
            return Ok(t)
        }
        if op == "!" {
            self.expect_type(x, Type.TBool, "operand of '!'")?
            return Ok(Type.TBool)
        }
        if op == "~" {
            let hint = int_hint(expected)
            let t = self.expect_value(x, hint)?
            if !is_int(t) { return Err(terr_at(e.line, e.col, e.sp, "unary '~' requires an integer")) }
            return Ok(t)
        }
        return Err(terr_at(e.line, e.col, e.sp, format("unknown unary operator '{}'", op)))
    }

    fun infer_cast(var self, e: Expr, x: Expr, ty: TypeExpr) -> Result<Type, CheckErr> {
        let target = self.resolve0(ty)?
        let src = self.expect_value(x, None)?
        let src_ok = is_int(src) || is_float(src) || is_char(src)
        let tgt_ok = is_int(target) || is_float(target) || is_char(target)
        if !src_ok || !tgt_ok { return Err(terr_at(e.line, e.col, e.sp, format("cannot cast from '{}' to '{}' ('as' converts between numeric and char types only)", type_name(src), type_name(target)))) }
        if (is_char(src) && is_float(target)) || (is_float(src) && is_char(target)) {
            return Err(terr_at(e.line, e.col, e.sp, "cannot cast directly between 'char' and a float (go through an integer type)"))
        }
        return Ok(target)
    }

    fun unify(var self, ln: Expr, lt0: Type, rn: Expr, rt0: Type) -> Result<Type, CheckErr> {
        var lt = lt0
        var rt = rt0
        if type_eq(lt, rt) { return Ok(lt) }
        if is_int(rt) && is_flexible_char_lit(ln) && int_lit_value(ln) <= 127 {
            lt = self.infer_int_lit(ln, Some(rt))?
        } else {
            if is_int(lt) && is_flexible_char_lit(rn) && int_lit_value(rn) <= 127 {
                rt = self.infer_int_lit(rn, Some(lt))?
            }
        }
        if type_eq(lt, rt) { return Ok(lt) }
        if is_int(lt) && is_int(rt) {
            if is_flexible_int_lit(ln) { lt = self.infer_int_lit(ln, Some(rt))? }
            else { if is_flexible_int_lit(rn) { rt = self.infer_int_lit(rn, Some(lt))? } }
            if type_eq(lt, rt) { return Ok(lt) }
        }
        if is_float(lt) && is_float(rt) {
            if is_flexible_float_lit(ln) { lt = self.infer_float_lit(ln, Some(rt))? }
            else { if is_flexible_float_lit(rn) { rt = self.infer_float_lit(rn, Some(lt))? } }
            if type_eq(lt, rt) { return Ok(lt) }
        }
        return Err(terr_at(ln.line, ln.col, ln.sp, format("type mismatch: '{}' vs '{}' (no implicit conversion between numeric types)", type_name(lt), type_name(rt))))
    }

    fun infer_binary(var self, e: Expr, op: str, l: Expr, r: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        if op == "&&" || op == "||" {
            self.expect_type(l, Type.TBool, format("operand of '{}'", op))?
            self.expect_type(r, Type.TBool, format("operand of '{}'", op))?
            return Ok(Type.TBool)
        }
        if op == "==" || op == "!=" {
            let lt = self.expect_value(l, None)?
            if is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
            if is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
            var hint: Option<Type> = None
            if is_int(lt) || is_float(lt) { hint = Some(lt) }
            let rt = self.expect_value(r, hint)?
            let common = self.unify(l, lt, r, rt)?
            if !(is_int(common) || is_float(common) || is_char(common) || is_bool(common) || is_str(common)) {
                return Err(terr_at(e.line, e.col, e.sp, format("cannot compare values of type '{}'", type_name(common))))
            }
            return Ok(Type.TBool)
        }
        if op == "<" || op == "<=" || op == ">" || op == ">=" {
            let lt = self.expect_value(l, None)?
            if is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
            if is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
            var hint: Option<Type> = None
            if is_int(lt) || is_float(lt) { hint = Some(lt) }
            let rt = self.expect_value(r, hint)?
            let common = self.unify(l, lt, r, rt)?
            if !(is_int(common) || is_float(common) || is_char(common)) { return Err(terr_at(e.line, e.col, e.sp, "comparison requires numeric or char operands")) }
            return Ok(Type.TBool)
        }
        if op == "<<" || op == ">>" {
            let hint = int_hint(expected)
            let lt = self.expect_value(l, hint)?
            if op == ">>" {
                if is_tfunc_type(lt) { return self.infer_compose(e, lt, r) }
            }
            if !is_int(lt) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires an integer left operand", op))) }
            let rt = self.expect_value(r, None)?
            if !is_int(rt) { return Err(terr_at(r.line, r.col, r.sp, format("shift amount for '{}' must be an integer", op))) }
            match const_int(r) {
                Some(amt) => {
                    let w = int_width(lt)
                    if !(amt >= 0 && amt < (w as int64)) { return Err(terr_at(r.line, r.col, r.sp, format("shift amount {} is out of range for '{}' (valid range is 0..{})", amt, type_name(lt), w - 1))) }
                },
                None => {},
            }
            return Ok(lt)
        }
        if op == "+" {
            let hint = num_hint(expected)
            let lt = self.expect_value(l, hint)?
            if is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
            if is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
            if is_str(lt) {
                let rt = self.expect_value(r, None)?
                if !is_str(rt) { return Err(terr_at(e.line, e.col, e.sp, format("cannot concatenate 'str' with '{}'", type_name(rt)))) }
                return Ok(Type.TStr)
            }
            var hint2: Option<Type> = None
            if is_int(lt) || is_float(lt) { hint2 = Some(lt) }
            let rt = self.expect_value(r, hint2)?
            let common = self.unify(l, lt, r, rt)?
            if !(is_int(common) || is_float(common)) { return Err(terr_at(e.line, e.col, e.sp, "operator '+' requires numeric or string operands")) }
            return Ok(common)
        }
        // arithmetic & bitwise: - * / %  and  & | ^
        let hint = num_hint(expected)
        let lt = self.expect_value(l, hint)?
        if is_arith_op(op) && is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
        if is_arith_op(op) && is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
        var hint2 = hint
        if is_int(lt) || is_float(lt) { hint2 = Some(lt) }
        let rt = self.expect_value(r, hint2)?
        let common = self.unify(l, lt, r, rt)?
        if is_float(common) {
            if !is_arith_op(op) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' is not defined for floats", op))) }
            return Ok(common)
        }
        if !is_int(common) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires integer operands", op))) }
        return Ok(common)
    }

    fun infer_operator_overload(var self, e: Expr, op: str, l: Expr, r: Expr, lt: Type) -> Result<Type, CheckErr> {
        var trnm = ""
        var kind = ""
        if op == "==" || op == "!=" { trnm = "Eq"
            kind = "eq" }
        else { if op == "<" || op == "<=" || op == ">" || op == ">=" { trnm = "Ord"
            kind = "ord" }
        else { trnm = match arith_trait(op) { Some(t) => t, None => "" }
            kind = "arith" } }
        if !self.type_implements(lt, trnm)? {
            return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' is not defined for '{}': it needs 'impl {} for {}'{}", op, type_name(lt), trnm, type_name(lt), if_str(trnm == "Eq", " (or '#derive(Eq)')", ""))))
        }
        let rt = self.expect_value(r, None)?
        if !type_eq(lt, rt) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires both operands to have the same type, found '{}' and '{}'", op, type_name(lt), type_name(rt)))) }
        if kind == "arith" {
            // arith trait method returns Self == lt (enforced by conformance)
            let k = match self.type_key(lt) { Some(x) => x, None => "" }
            match self.method_sig(k, arith_method(op)) {
                Some(sig) => {
                    return match sig.ret {
                        Some(rr) => Ok(rr),
                        None => Ok(lt),
                    }
                },
                None => { return Ok(lt) },
            }
        }
        return Ok(Type.TBool)
    }

    fun infer_bounded_op(var self, e: Expr, op: str, l: Expr, r: Expr, lt: Type) -> Result<Type, CheckErr> {
        var trnm = ""
        var result = lt
        if op == "==" || op == "!=" { trnm = "Eq"
            result = Type.TBool }
        else { if op == "<" || op == "<=" || op == ">" || op == ">=" { trnm = "Ord"
            result = Type.TBool }
        else { trnm = match arith_trait(op) { Some(t) => t, None => "" }
            result = lt } }
        let pname = match lt { Type.TParam(n) => n, _ => "" }
        if !self.bound_has(pname, trnm) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' on a value of type parameter '{}' requires the bound '{}: {}'", op, pname, pname, trnm))) }
        let rt = self.expect_value(r, None)?
        if !type_eq(lt, rt) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires both operands to have the same type, found '{}' and '{}'", op, type_name(lt), type_name(rt)))) }
        return Ok(result)
    }

    fun bound_has(self, pname: str, trnm: str) -> bool {
        for b in self.bounds_cur { if b.tp == pname { if contains_str(b.traits, trnm) { return true } } }
        return false
    }

    fun infer_compose(var self, e: Expr, lt: Type, r: Expr) -> Result<Type, CheckErr> {
        let lparams = func_params_of(lt)
        let lret: Option<Type> = func_ret_of(lt)
        if len(lparams) != 1 { return Err(terr_at(e.line, e.col, e.sp, format("composition with '>>' needs a one-argument function on the left, found '{}'", type_name(lt)))) }
        let rt = self.expect_value(r, None)?
        match strip_async(rt) { Type.TFunc(ps, rr) => {}, _ => { return Err(terr_at(e.line, e.col, e.sp, format("cannot compose a function with a value of type '{}' (both operands of '>>' must be functions, or both integers)", type_name(rt)))) } }
        if is_async_func(lt) || is_async_func(rt) { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be composed with '>>'")) }
        let rparams = func_params_of(rt)
        let rret: Option<Type> = func_ret_of(rt)
        if len(rparams) != 1 { return Err(terr_at(e.line, e.col, e.sp, format("composition with '>>' needs a one-argument function on the right, found '{}'", type_name(rt)))) }
        let matches = match lret { Some(x) => type_eq(x, rparams[0]), None => false }
        if !matches {
            return Err(terr_at(e.line, e.col, e.sp, format("cannot compose '{}' with '{}': the left result '{}' must match the right parameter '{}'", type_name(lt), type_name(rt), opt_type_name(lret), type_name(rparams[0]))))
        }
        return Ok(Type.TFunc([lparams[0]], rret))
    }

    fun infer_tuple_lit(var self, e: Expr, elems: [Expr], expected: Option<Type>) -> Result<Type, CheckErr> {
        var exp_elems: [Type] = []
        var have_exp = false
        match tuple_hint(expected, len(elems)) {
            Some(es) => {
                exp_elems = es
                have_exp = true
            },
            None => {},
        }
        var ts: [Type] = []
        var i = 0
        while i < len(elems) {
            var want: Option<Type> = None
            if have_exp { want = Some(exp_elems[i]) }
            push(ts, self.expect_value(elems[i], want)?)
            i = i + 1
        }
        return Ok(Type.TTuple(ts))
    }

    fun infer_tuple_index(var self, e: Expr, t: Expr, idx: int64) -> Result<Type, CheckErr> {
        let base = self.expect_value(t, None)?
        match base {
            Type.TTuple(es) => {
                if !(idx >= 0 && idx < (len(es) as int64)) { return Err(terr_at(e.line, e.col, e.sp, format("tuple index {} out of range for '{}'", idx, type_name(base)))) }
                return Ok(es[idx as int32])
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a tuple and cannot be indexed with '.{}'", type_name(base), idx)))
    }

    fun infer_list_lit(var self, e: Expr, elems: [Expr], expected: Option<Type>) -> Result<Type, CheckErr> {
        var exp_elem: Option<Type> = list_elem_hint(expected)
        if len(elems) == 0 {
            return match exp_elem { Some(el) => Ok(Type.TList(el)), None => Err(terr_at(e.line, e.col, e.sp, "cannot infer the element type of an empty list `[]`; annotate it (e.g. `: [int]`)")) }
        }
        var elem_t = self.expect_value(elems[0], exp_elem)?
        var i = 1
        while i < len(elems) {
            let et = self.expect_value(elems[i], Some(elem_t))?
            elem_t = self.unify(elems[0], elem_t, elems[i], et)?
            i = i + 1
        }
        return Ok(Type.TList(elem_t))
    }

    fun infer_map_lit(var self, e: Expr, entries: [MapEntry], expected: Option<Type>) -> Result<Type, CheckErr> {
        var exp_k: Option<Type> = None
        var exp_v: Option<Type> = None
        var have_exp = false
        match map_kv_hint(expected) {
            Some(kv) => {
                exp_k = Some(kv[0])
                exp_v = Some(kv[1])
                have_exp = true
            },
            None => {},
        }
        if len(entries) == 0 {
            if have_exp { return Ok(match expected { Some(et) => et, None => Type.TMap(Type.TStr, Type.TStr) }) }
            return Err(terr_at(e.line, e.col, e.sp, "cannot infer the key/value types of an empty map `[:]`; annotate it (e.g. `: [str: int]`)"))
        }
        let k0 = entries[0].key
        let v0 = entries[0].value
        var key_t = self.expect_value(k0, exp_k)?
        if !is_map_key(key_t) { return Err(terr_at(k0.line, k0.col, k0.sp, format("map key type must be a primitive (integer, char, bool, or str), found '{}'", type_name(key_t)))) }
        var val_t = self.expect_value(v0, exp_v)?
        var i = 1
        while i < len(entries) {
            let kt = self.expect_value(entries[i].key, Some(key_t))?
            key_t = self.unify(k0, key_t, entries[i].key, kt)?
            let vt = self.expect_value(entries[i].value, Some(val_t))?
            val_t = self.unify(v0, val_t, entries[i].value, vt)?
            i = i + 1
        }
        return Ok(Type.TMap(key_t, val_t))
    }

    fun infer_index(var self, e: Expr, t: Expr, ix: Expr) -> Result<Type, CheckErr> {
        let base = self.expect_value(t, None)?
        match base {
            Type.TMap(k, v) => { self.expect_type(ix, k, "map key")?
            return Ok(v) },
            Type.TStr => {
                let it = self.expect_value(ix, Some(t_int()))?
                if !is_int(it) { return Err(terr_at(ix.line, ix.col, ix.sp, format("string index must be an integer, found '{}'", type_name(it)))) }
                return Ok(t_byte())
            },
            Type.TList(el) => {
                let it = self.expect_value(ix, Some(t_int()))?
                if !is_int(it) { return Err(terr_at(ix.line, ix.col, ix.sp, format("list index must be an integer, found '{}'", type_name(it)))) }
                return Ok(el)
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a list and cannot be indexed with `[...]`", type_name(base))))
    }

    fun infer_field(var self, e: Expr, target: Expr, field: str, expected: Option<Type>) -> Result<Type, CheckErr> {
        match self.enum_name_ref(target) {
            Some(enum_name) => {
                if !self.enum_has_variant(enum_name, field) { return Err(terr_at(e.line, e.col, e.sp, format("enum '{}' has no variant '{}'", enum_name, field))) }
                let payload = match self.enum_variant_payload(enum_name, [], field) { Some(p) => p, None => empty_types() }
                if len(payload) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("variant '{}.{}' takes {} argument(s); call it like '{}.{}(...)'", enum_name, field, len(payload), enum_name, field))) }
                let ei = self.enum_idx(enum_name)
                let nparams = len(self.enums[ei].type_params)
                if nparams == 0 { return Ok(Type.TEnum(enum_name, [])) }
                match expected {
                    Some(et) => { if enum_type_matches(et, enum_name, nparams) { return Ok(et) } },
                    None => {},
                }
                return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type argument(s) for '{}.{}'; annotate the binding (e.g. ': {}<...>')", enum_name, field, enum_name)))
            },
            None => {},
        }
        let base = self.expect_value(target, None)?
        match struct_view(base) {
            Type.TStruct(n, args) => {
                self.check_isolation(n, target, field, e)?
                let fields = self.struct_field_types(n, args)
                return match field_type_get(fields, field) { Some(ft) => Ok(ft), None => Err(with_notes(terr_at(e.line, e.col, e.sp, format("struct '{}' has no field '{}'", n, field)), did_you_mean(field, field_names(fields)))) }
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' has no fields", type_name(base))))
    }

    fun infer_struct_lit(var self, e: Expr, sname: str, fields: [FieldInit], expected: Option<Type>) -> Result<Type, CheckErr> {
        if !self.is_struct(sname) { return Err(terr_at(e.line, e.col, e.sp, format("unknown struct '{}'", sname))) }
        let si = self.struct_idx(sname)
        let info = self.structs[si]
        // duplicate / unknown provided fields
        var provided: [str] = []
        for init in fields {
            if contains_str(provided, init.name) { return Err(terr_at(init.line, init.col, init.sp, format("duplicate field '{}' in struct literal", init.name))) }
            if match field_type_get(info.fields, init.name) { Some(x) => false, None => true } { return Err(with_notes(terr_at(init.line, init.col, init.sp, format("struct '{}' has no field '{}'", sname, init.name)), did_you_mean(init.name, field_names(info.fields)))) }
            push(provided, init.name)
        }
        // missing fields
        var missing: [str] = []
        for f in info.fields { if !contains_str(provided, f.name) { push(missing, f.name) } }
        if len(missing) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("missing field(s) in '{}' literal: {}", sname, join_strs(missing, ", ")))) }
        if len(info.type_params) > 0 {
            for f in info.fields { if has_error(f.ty) { return Err(poisoned()) } }
        }
        if len(info.type_params) == 0 {
            for init in fields {
                let ft = match field_type_get(info.fields, init.name) { Some(x) => x, None => Type.TStr }
                if has_error(ft) { continue }   // the field's type failed (MYLA-110)
                let vt = self.expect_value(init.value, Some(ft))?
                if !type_eq(vt, ft) { return Err(terr_at(init.line, init.col, init.sp, format("field '{}': expected '{}', found '{}'", init.name, type_name(ft), type_name(vt)))) }
            }
            if self.is_actor(sname) { return Ok(Type.TActor(sname)) }
            return Ok(Type.TStruct(sname, []))
        }
        // generic struct: solve type args from fields (declaration order)
        var nodes: [Expr] = []
        var ttypes: [Type] = []
        for f in info.fields {
            for init in fields { if init.name == f.name { push(nodes, init.value) } }
            push(ttypes, f.ty)
        }
        var exp_args: Option<[Type]> = struct_args_hint(expected, sname)
        let args = self.infer_type_args(info.type_params, ttypes, nodes, exp_args, e, format("struct '{}'", sname))?
        return Ok(Type.TStruct(sname, args))
    }
}

fun arith_method(op: str) -> str {
    if op == "+" { return "add" }
    if op == "-" { return "sub" }
    if op == "*" { return "mul" }
    if op == "/" { return "div" }
    if op == "%" { return "rem" }
    return ""
}

fun is_struct_or_enum(t: Type) -> bool {
    return match t { Type.TStruct(n, a) => true, Type.TEnum(n, a) => true, _ => false }
}
fun is_type_param(t: Type) -> bool { return match t { Type.TParam(n) => true, _ => false } }

// =========================================================================
// Generic type-argument inference (shared by struct lit / variant ctor)
// =========================================================================

impl Checker {
    // `label` names the construct in a mismatch message ("struct 'Box'").
    fun infer_type_args(var self, params: [str], template_types: [Type], nodes: [Expr], expected_args: Option<[Type]>, e: Expr, label: str) -> Result<[Type], CheckErr> {
        var subst: [Subst] = []
        match expected_args {
            Some(ea) => { if len(ea) == len(params) { var i = 0
            while i < len(params) { push(subst, Subst { name: params[i], ty: ea[i] })
            i = i + 1 } } },
            None => {},
        }
        var value_types: [Type] = []
        var i = 0
        while i < len(nodes) {
            let tt = template_types[i]
            let hint_t = subst_type(tt, subst)
            var hint: Option<Type> = Some(hint_t)
            if contains_type_param(hint_t) { hint = None }
            let vt = self.expect_value(nodes[i], hint)?
            push(value_types, vt)
            let r = unify_param(tt, vt, subst)
            subst = r.subst
            i = i + 1
        }
        var missing: [str] = []
        for p in params { if !subst_has(subst, p) { push(missing, p) } }
        if len(missing) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {}; add a type annotation to guide inference", join_strs(missing, ", ")))) }
        var j = 0
        while j < len(nodes) {
            let want = subst_type(template_types[j], subst)
            if !type_eq(value_types[j], want) {
                if is_int(want) && is_flexible_int_lit(nodes[j]) {
                    self.infer_int_lit(nodes[j], Some(want))?
                } else {
                    return Err(terr_at(nodes[j].line, nodes[j].col, nodes[j].sp, format("{}: expected '{}', found '{}'", label, type_name(want), type_name(value_types[j]))))
                }
            }
            j = j + 1
        }
        var out: [Type] = []
        for p in params { match subst_get(subst, p) { Some(t) => push(out, t), None => {} } }
        return Ok(out)
    }
}

// =========================================================================
// Match & patterns
// =========================================================================

impl Checker {
    fun infer_match(var self, e: Expr, scrut: Expr, arms: [MatchArm], expected: Option<Type>, as_stmt: bool) -> Result<Option<Type>, CheckErr> {
        let st = self.expect_value(scrut, None)?
        var bodies: [ArmBody] = []
        for arm in arms {
            self.push_scope()
            self.check_pattern(arm.pattern, st)?
            match arm.guard {
                Some(g) => {
                    let saved_guard = self.in_guard
                    self.in_guard = true
                    let gr = self.expect_type(g, Type.TBool, "match guard")
                    self.in_guard = saved_guard
                    gr?
                },
                None => {},
            }
            let ab = self.check_arm_body(arm.body, expected, as_stmt)?
            self.pop_scope()
            push(bodies, ab)
        }
        self.check_exhaustive(e, st, arms)?
        self.check_redundant(arms, st)?
        if as_stmt { return Ok(None) }
        // collect non-diverging arm values
        var vals: [MatchVal] = []
        for ab in bodies {
            match ab {
                ArmBody.ABDiverge => {},
                ArmBody.ABValue(ot, node) => {
                    let t = match ot { Some(x) => x, None => { return Err(terr_at(e.line, e.col, e.sp, "this match is used as a value, so every arm must produce one")) } }
                    push(vals, MatchVal { ty: t, node: node })
                },
            }
        }
        if len(vals) == 0 { return Err(terr_at(e.line, e.col, e.sp, "this match is used as a value, but every arm diverges")) }
        let result = self.unify_match_result(vals)?
        return Ok(Some(result))
    }

    // The arms of a statement match (`as_stmt`) need no value, so their last
    // statement is checked as a statement, and a match there is one too (MYLA-59).
    fun check_arm_body(var self, body: ExprOrBlock, expected: Option<Type>, as_stmt: bool) -> Result<ArmBody, CheckErr> {
        match body {
            ExprOrBlock.EB_Expr(ex) => {
                if as_stmt { match ex.kind { ExprKind.MatchE(sc, arms) => { self.stmt_match = true }, _ => {} } }
                let t = self.infer(ex, expected)?
                if is_diverging(ex) { return Ok(ArmBody.ABDiverge) }
                return Ok(ArmBody.ABValue(t, Some(ex)))
            },
            ExprOrBlock.EB_Block(bl) => {
                self.push_scope()
                let res = self.check_arm_block(bl, expected, as_stmt)?
                self.pop_scope()
                return Ok(res)
            },
        }
        return Ok(ArmBody.ABDiverge)
    }

    fun check_arm_block(var self, bl: Block, expected: Option<Type>, as_stmt: bool) -> Result<ArmBody, CheckErr> {
        let n = len(bl.stmts)
        var i = 0
        while i < n {
            let s = bl.stmts[i]
            if i == n - 1 && !as_stmt {
                match s.kind {
                    StmtKind.ExprStmt(ex) => {
                        let t = self.infer(ex, expected)?
                        if is_diverging(ex) { return Ok(ArmBody.ABDiverge) }
                        return Ok(ArmBody.ABValue(t, Some(ex)))
                    },
                    _ => { self.check_stmt(s)? },
                }
            } else {
                self.check_stmt(s)?
            }
            i = i + 1
        }
        if block_returns(bl) { return Ok(ArmBody.ABDiverge) }
        return Ok(ArmBody.ABValue(None, None))
    }

    fun unify_match_result(var self, vals: [MatchVal]) -> Result<Type, CheckErr> {
        let first = vals[0].ty
        var all_eq = true
        for v in vals { if !type_eq(v.ty, first) { all_eq = false } }
        if all_eq { return Ok(first) }
        var all_int = true
        for v in vals { if !is_int(v.ty) { all_int = false } }
        if all_int {
            var has_target = false
            var target = t_int()
            for v in vals {
                if !has_target {
                    let flex = match v.node { Some(nd) => is_flexible_int_lit(nd), None => false }
                    if !flex { target = v.ty
            has_target = true }
                }
            }
            for v in vals {
                if !type_eq(v.ty, target) {
                    match v.node {
                        Some(nd) => { if is_flexible_int_lit(nd) { self.infer_int_lit(nd, Some(target))? } else { return Err(terr_at(nd.line, nd.col, nd.sp, format("match arms have incompatible types '{}' and '{}'", type_name(target), type_name(v.ty)))) } },
                        None => {},
                    }
                }
            }
            return Ok(target)
        }
        for v in vals {
            if !type_eq(v.ty, first) {
                match v.node { Some(nd) => { return Err(terr_at(nd.line, nd.col, nd.sp, format("match arms have incompatible types '{}' and '{}'", type_name(first), type_name(v.ty)))) }, None => {} }
            }
        }
        return Ok(first)
    }

    fun check_pattern(var self, pat: Pattern, t: Type) -> Result<int32, CheckErr> {
        if has_error(t) { return Err(poisoned()) }
        return self.check_pattern_node(pat, t)
    }

    fun check_pattern_node(var self, pat: Pattern, t: Type) -> Result<int32, CheckErr> {
        return match pat.kind {
            PatternKind.PWild => Ok(0),
            PatternKind.PBind(n) => {
                match t {
                    Type.TEnum(en, args) => {
                        if self.enum_has_variant(en, n) {
                            let payload = match self.enum_variant_payload(en, args, n) { Some(p) => p, None => empty_types() }
                            if len(payload) > 0 { return Err(terr_at(pat.line, pat.col, pat.sp, format("variant '{}.{}' carries a payload; write '{}(...)' to match it", en, n, n))) }
                            return Ok(0)
                        }
                        if !self.define_at(n, t, false, pat.line, pat.col, pat.sp) { return Err(terr_at(pat.line, pat.col, pat.sp, format("'{}' is bound more than once in this pattern", n))) }
                        Ok(0)
                    },
                    _ => {
                        if !self.define_at(n, t, false, pat.line, pat.col, pat.sp) { return Err(terr_at(pat.line, pat.col, pat.sp, format("'{}' is bound more than once in this pattern", n))) }
                        Ok(0)
                    },
                }
            },
            PatternKind.PLit(litexpr) => {
                var hint: Option<Type> = None
                if is_int(t) || is_char(t) { hint = Some(t) }
                let lt = self.expect_value(litexpr, hint)?
                if !(is_int(t) || is_char(t) || is_bool(t) || is_str(t)) { return Err(terr_at(pat.line, pat.col, pat.sp, format("cannot match a literal against '{}'", type_name(t)))) }
                if !type_eq(lt, t) { return Err(terr_at(pat.line, pat.col, pat.sp, format("literal pattern of type '{}' cannot match value of type '{}'", type_name(lt), type_name(t)))) }
                let misfit = pattern_misfit(litexpr, t)
                if misfit != "" { return Err(terr_at(pat.line, pat.col, pat.sp, format("integer literal {} does not fit in '{}'", misfit, type_name(t)))) }
                Ok(0)
            },
            PatternKind.PEnum(en, variant, elems, hp) => self.check_enum_pattern(pat, en, variant, elems, hp, t),
            PatternKind.PTuple(elems) => {
                match t {
                    Type.TTuple(ets) => {
                        if len(elems) != len(ets) { return Err(terr_at(pat.line, pat.col, pat.sp, format("tuple pattern expects {} element(s), got {}", len(ets), len(elems)))) }
                        var i = 0
                        while i < len(elems) { self.check_pattern(elems[i], ets[i])?
            i = i + 1 }
                        Ok(0)
                    },
                    _ => Err(terr_at(pat.line, pat.col, pat.sp, format("tuple pattern cannot match value of type '{}'", type_name(t)))),
                }
            },
            PatternKind.PStruct(name, fps) => self.check_struct_pattern(pat, name, fps, t),
            PatternKind.POr(alts) => self.check_or_pattern(pat, alts, t),
        }
    }

    fun check_enum_pattern(var self, pat: Pattern, en: Option<str>, variant: str, elems: [Pattern], hp: bool, t: Type) -> Result<int32, CheckErr> {
        match t {
            Type.TEnum(tn, args) => {
                match en { Some(name) => { if name != tn { return Err(terr_at(pat.line, pat.col, pat.sp, format("pattern names enum '{}' but the value is '{}'", name, tn))) } }, None => {} }
                let payload = match self.enum_variant_payload(tn, args, variant) { Some(p) => p, None => { return Err(terr_at(pat.line, pat.col, pat.sp, format("enum '{}' has no variant '{}'", tn, variant))) } }
                if hp || len(elems) > 0 {
                    if len(elems) != len(payload) { return Err(terr_at(pat.line, pat.col, pat.sp, format("variant '{}.{}' has {} field(s), but the pattern binds {}", tn, variant, len(payload), len(elems)))) }
                    var i = 0
                    while i < len(elems) { self.check_pattern(elems[i], payload[i])?
            i = i + 1 }
                    return Ok(0)
                }
                if len(payload) > 0 { return Err(terr_at(pat.line, pat.col, pat.sp, format("variant '{}.{}' carries a payload; write '{}(...)' to match it", tn, variant, variant))) }
                return Ok(0)
            },
            _ => {},
        }
        return Err(terr_at(pat.line, pat.col, pat.sp, format("enum pattern cannot match value of type '{}'", type_name(t))))
    }

    fun check_struct_pattern(var self, pat: Pattern, sname: str, fps: [FieldPat], t: Type) -> Result<int32, CheckErr> {
        match struct_view(t) {
            Type.TStruct(tn, args) => {
                if sname != tn { return Err(terr_at(pat.line, pat.col, pat.sp, format("pattern names struct '{}' but the value is '{}'", sname, tn))) }
                if self.is_actor(tn) { return Err(terr_at(pat.line, pat.col, pat.sp, format("a pattern can't reach the fields of the actor '{}'", type_name(t)))) }
                let fields = self.struct_field_types(tn, args)
                var seen: [str] = []
                for fp in fps {
                    if contains_str(seen, fp.name) { return Err(terr_at(fp.line, fp.col, fp.sp, format("field '{}' bound more than once in struct pattern", fp.name))) }
                    push(seen, fp.name)
                    match field_type_get(fields, fp.name) {
                        Some(ft) => { self.check_pattern(fp.pattern, ft)? },
                        None => { return Err(with_notes(terr_at(fp.line, fp.col, fp.sp, format("struct '{}' has no field '{}'", tn, fp.name)), did_you_mean(fp.name, field_names(fields)))) },
                    }
                }
                return Ok(0)
            },
            _ => {},
        }
        return Err(terr_at(pat.line, pat.col, pat.sp, format("struct pattern cannot match value of type '{}'", type_name(t))))
    }

    fun check_or_pattern(var self, pat: Pattern, alts: [Pattern], t: Type) -> Result<int32, CheckErr> {
        var base_names: [str] = []
        var base_types: [Type] = []
        var first = true
        for alt in alts {
            self.push_scope()
            self.check_pattern(alt, t)?
            let top = len(self.frames) - 1
            let names = self.frames[top].names
            var types: [Type] = []
            for b in self.frames[top].binds { push(types, b.ty) }
            self.pop_scope()
            if first {
                base_names = names
                base_types = types
                first = false
            } else {
                if !bindmaps_eq(base_names, base_types, names, types) { return Err(terr_at(pat.line, pat.col, pat.sp, "all alternatives of an or-pattern must bind the same names with the same types")) }
            }
        }
        var i = 0
        while i < len(base_names) {
            if !self.define(base_names[i], base_types[i], false) { return Err(terr_at(pat.line, pat.col, pat.sp, format("'{}' is bound more than once in this pattern", base_names[i]))) }
            i = i + 1
        }
        return Ok(0)
    }

    // -- exhaustiveness & redundancy --------------------------------------

    // Maranget's "usefulness" over pattern matrices (MYLA-14), as in the
    // Python checker: a row of patterns is useful against earlier rows when
    // some value matches it and none of them. Patterns are normalized to
    // `NPat`s first; a constructor's key is an enum variant's name, or `#t` /
    // `#f`, `#()` (a tuple), `#{}` (a struct), `#i<n>` / `#s<text>` (literals).

    fun irrefutable(self, pat: Pattern, t: Type) -> bool {
        return !self.useful([[self.norm_pat(pat, t)]], [NPat.NWild], [t])
    }

    fun norm_pat(self, pat: Pattern, t: Type) -> NPat {
        match pat.kind {
            PatternKind.PWild => { return NPat.NWild },
            PatternKind.PBind(n) => {
                match t {
                    Type.TEnum(en, args) => {
                        if self.enum_has_variant(en, n) && self.is_novpayload_variant(en, n) { return NPat.NCon(n, []) }
                    },
                    _ => {},
                }
                return NPat.NWild
            },
            PatternKind.PLit(e) => { return NPat.NCon(literal_key(e), []) },
            PatternKind.POr(alts) => {
                var out: [NPat] = []
                for a in alts { push(out, self.norm_pat(a, t)) }
                return NPat.NOr(out)
            },
            PatternKind.PTuple(elems) => {
                match t {
                    Type.TTuple(ets) => {
                        var out: [NPat] = []
                        var i = 0
                        while i < len(elems) && i < len(ets) {
                            push(out, self.norm_pat(elems[i], ets[i]))
                            i = i + 1
                        }
                        return NPat.NCon("#()", out)
                    },
                    _ => {},
                }
            },
            PatternKind.PStruct(name, fps) => {
                match t {
                    Type.TStruct(tn, args) => {
                        var out: [NPat] = []
                        for f in self.struct_field_types(tn, args) {
                            var sub = NPat.NWild
                            for fp in fps { if fp.name == f.name { sub = self.norm_pat(fp.pattern, f.ty) } }
                            push(out, sub)
                        }
                        return NPat.NCon("#{}", out)
                    },
                    _ => {},
                }
            },
            PatternKind.PEnum(en, variant, elems, hp) => {
                match t {
                    Type.TEnum(tn, args) => {
                        let payload = match self.enum_variant_payload(tn, args, variant) { Some(p) => p, None => empty_types() }
                        var out: [NPat] = []
                        var i = 0
                        while i < len(payload) {
                            if i < len(elems) { push(out, self.norm_pat(elems[i], payload[i])) } else { push(out, NPat.NWild) }
                            i = i + 1
                        }
                        return NPat.NCon(variant, out)
                    },
                    _ => {},
                }
            },
        }
        return NPat.NWild
    }

    // All constructors of `t` with their field types; none for values that
    // can't be enumerated (integers, strings, chars).
    fun signature(self, t: Type) -> Option<[SigCon]> {
        var out: [SigCon] = []
        match t {
            Type.TEnum(tn, args) => {
                // the variants in one pass, as `enum_variant_payload` gives
                // each (looking each up was quadratic, MYLA-124)
                let ei = self.enum_idx(tn)
                if ei >= 0 {
                    let info = self.enums[ei]
                    var subst: [Subst] = []
                    if len(info.type_params) > 0 && len(args) >= len(info.type_params) {
                        var i = 0
                        while i < len(info.type_params) {
                            push(subst, Subst { name: info.type_params[i], ty: args[i] })
                            i = i + 1
                        }
                    }
                    for v in info.variants {
                        if len(subst) > 0 { push(out, SigCon { key: v.name, types: subst_type_list(v.payload, subst) }) }
                        else { push(out, SigCon { key: v.name, types: v.payload }) }
                    }
                }
            },
            Type.TBool => {
                push(out, SigCon { key: "#t", types: empty_types() })
                push(out, SigCon { key: "#f", types: empty_types() })
            },
            Type.TTuple(ets) => { push(out, SigCon { key: "#()", types: ets }) },
            Type.TStruct(tn, args) => {
                var ts: [Type] = []
                for f in self.struct_field_types(tn, args) { push(ts, f.ty) }
                push(out, SigCon { key: "#{}", types: ts })
            },
            _ => { return None },
        }
        return Some(out)
    }

    fun useful(self, rows0: [[NPat]], q: [NPat], types: [Type]) -> bool {
        if len(q) == 0 { return len(rows0) == 0 }
        let rows = expand_or(rows0)
        let rest = list_tail(q)
        let trest = list_tail(types)
        match q[0] {
            NPat.NOr(alts) => {
                for alt in alts { if self.useful(rows, list_concat([alt], rest), types) { return true } }
                return false
            },
            NPat.NCon(key, subs) => {
                var sub_types: [Type] = []
                match self.signature(types[0]) {
                    Some(sig) => { for c in sig { if c.key == key { sub_types = c.types } } },
                    None => {},
                }
                if len(sub_types) != len(subs) { sub_types = repeat_type(types[0], len(subs)) }
                return self.useful(specialize(rows, key, len(subs)), list_concat(subs, rest), list_concat(sub_types, trest))
            },
            NPat.NWild => {},
        }
        match self.signature(types[0]) {
            Some(sig) => {
                var complete = true
                for c in sig { if !head_has_key(rows, c.key) { complete = false } }
                if complete {
                    for c in sig {
                        if self.useful(specialize(rows, c.key, len(c.types)), list_concat(wilds(len(c.types)), rest), list_concat(c.types, trest)) { return true }
                    }
                    return false
                }
            },
            None => {},
        }
        var def: [[NPat]] = []
        for row in rows { if is_nwild(row[0]) { push(def, list_tail(row)) } }
        return self.useful(def, rest, trest)
    }

    fun covered_variants(self, pat: Pattern, tn: str, args: [Type]) -> [str] {
        if self.irrefutable(pat, Type.TEnum(tn, args)) { return self.enum_variant_names(tn) }
        match pat.kind {
            PatternKind.POr(alts) => {
                var out: [str] = []
                for a in alts {
                    for v in self.covered_variants(a, tn, args) {
                        if !contains_str(out, v) { push(out, v) }
                    }
                }
                return out
            },
            PatternKind.PBind(n) => {
                if self.enum_has_variant(tn, n) && self.is_novpayload_variant(tn, n) { return [n] }
                return []
            },
            PatternKind.PEnum(en, variant, elems, hp) => {
                let payload = match self.enum_variant_payload(tn, args, variant) { Some(p) => p, None => empty_types() }
                var allirr = true
                var i = 0
                while i < len(elems) {
                    if !self.irrefutable(elems[i], payload[i]) { allirr = false }
                    i = i + 1
                }
                if allirr { return [variant] }
                return []
            },
            _ => { return [] },
        }
        return []
    }

    fun check_exhaustive(self, e: Expr, st: Type, arms: [MatchArm]) -> Result<int32, CheckErr> {
        var rows: [[NPat]] = []
        for a in arms { match a.guard { Some(g) => {}, None => push(rows, [self.norm_pat(a.pattern, st)]) } }
        if !self.useful(rows, [NPat.NWild], [st]) { return Ok(0) }
        match st {
            Type.TEnum(tn, args) => {
                var missing: [str] = []
                for v in self.enum_variant_names(tn) {
                    let payload = match self.enum_variant_payload(tn, args, v) { Some(p) => p, None => empty_types() }
                    if self.useful(specialize(rows, v, len(payload)), wilds(len(payload)), payload) { push(missing, v) }
                }
                return Err(terr_at(e.line, e.col, e.sp, format("non-exhaustive match on '{}': missing variant(s) {} (add them or a '_' arm)", tn, join_strs(missing, ", "))))
            },
            Type.TBool => { return Err(terr_at(e.line, e.col, e.sp, "non-exhaustive match on 'bool': cover both true and false (or add a '_' arm)")) },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("non-exhaustive match on '{}': add a '_' arm", type_name(st))))
    }

    fun check_redundant(self, arms: [MatchArm], st: Type) -> Result<int32, CheckErr> {
        var saw_irrefutable = false
        var covered: [str] = []        // enum variants covered in full so far
        var rows: [[NPat]] = []
        for arm in arms {
            if saw_irrefutable { return Err(terr_at(arm.line, arm.col, arm.sp, "unreachable match arm (a previous arm already matches everything)")) }
            let has_guard = match arm.guard { Some(g) => true, None => false }
            let row = [self.norm_pat(arm.pattern, st)]
            var vs: [str] = []
            match st { Type.TEnum(tn, args) => { vs = self.covered_variants(arm.pattern, tn, args) }, _ => {} }
            if !has_guard && len(vs) > 0 {
                var subset = true
                for v in vs { if !contains_str(covered, v) { subset = false } }
                if subset { return Err(terr_at(arm.line, arm.col, arm.sp, "unreachable match arm (its variant(s) are already covered)")) }
            }
            if !self.useful(rows, row, [st]) { return Err(terr_at(arm.line, arm.col, arm.sp, "unreachable match arm (earlier arms already cover it)")) }
            if has_guard { continue }
            for v in vs { if !contains_str(covered, v) { push(covered, v) } }
            push(rows, row)
            if self.irrefutable(arm.pattern, st) { saw_irrefutable = true }
        }
        return Ok(0)
    }
}

// A pattern normalized for exhaustiveness: a wildcard, a constructor with its
// subpatterns, or an or-pattern (MYLA-14).
enum NPat { NWild, NCon(str, [NPat]), NOr([NPat]) }

// A constructor of a type and its field types.
struct SigCon { key: str, types: [Type] }

fun literal_key(e: Expr) -> str {
    match e.kind {
        ExprKind.BoolLit(b) => {
            if b { return "#t" }
            return "#f"
        },
        ExprKind.StrLit(t) => { return "#s" + t },
        ExprKind.IntLit(v, suf, isc, big) => { return "#i" + int_text(v, big) },
        ExprKind.Unary(op, x) => {
            let k = literal_key(x)            // "#i<n>"
            if k == "#i0" { return k }        // -0 is 0
            return "#i-" + slice_from(k, 2)
        },
        _ => {},
    }
    return "#?"
}

fun slice_from(s: str, start: int) -> str {
    var sb = StringBuilder()
    var i = start
    while i < len(s) {
        append_byte(sb, s[i])
        i = i + 1
    }
    return build(sb)
}

fun is_nwild(p: NPat) -> bool {
    return match p { NPat.NWild => true, _ => false }
}

fun head_has_key(rows: [[NPat]], key: str) -> bool {
    for row in rows {
        match row[0] {
            NPat.NCon(k, subs) => { if k == key { return true } },
            _ => {},
        }
    }
    return false
}

fun repeat_type(t: Type, n: int) -> [Type] {
    var out: [Type] = []
    var i = 0
    while i < n {
        push(out, t)
        i = i + 1
    }
    return out
}

fun wilds(n: int) -> [NPat] {
    var out: [NPat] = []
    var i = 0
    while i < n {
        push(out, NPat.NWild)
        i = i + 1
    }
    return out
}

fun list_tail<T>(xs: [T]) -> [T] {
    var out: [T] = []
    var i = 1
    while i < len(xs) {
        push(out, xs[i])
        i = i + 1
    }
    return out
}

fun list_concat<T>(a: [T], b: [T]) -> [T] {
    var out = a
    for x in b { push(out, x) }
    return out
}

// Rows with a leading or-pattern split into one row per alternative.
fun expand_or(rows: [[NPat]]) -> [[NPat]] {
    var out: [[NPat]] = []
    for row in rows {
        var split = false
        if len(row) == 0 {
            push(out, row)
            continue
        }
        match row[0] {
            NPat.NOr(alts) => {
                split = true
                var alt_rows: [[NPat]] = []
                for alt in alts { push(alt_rows, list_concat([alt], list_tail(row))) }
                for r in expand_or(alt_rows) { push(out, r) }
            },
            _ => {},
        }
        if !split { push(out, row) }
    }
    return out
}

// The rows that match constructor `key`, with its subpatterns in front.
fun specialize(rows: [[NPat]], key: str, arity: int) -> [[NPat]] {
    var out: [[NPat]] = []
    for row in expand_or(rows) {
        match row[0] {
            NPat.NWild => { push(out, list_concat(wilds(arity), list_tail(row))) },
            NPat.NCon(k, subs) => { if k == key { push(out, list_concat(subs, list_tail(row))) } },
            NPat.NOr(alts) => {},
        }
    }
    return out
}

fun bindmaps_eq(an: [str], at: [Type], bn: [str], bt: [Type]) -> bool {
    if len(an) != len(bn) { return false }
    var i = 0
    while i < len(an) {
        var found = false
        var j = 0
        while j < len(bn) {
            if bn[j] == an[i] && type_eq(bt[j], at[i]) { found = true }
            j = j + 1
        }
        if !found { return false }
        i = i + 1
    }
    return true
}

// =========================================================================
// Statements & lvalues
// =========================================================================

pub struct LValue { ty: Type, mutable: bool }

impl Checker {
    fun check_block(var self, b: Block) -> Result<int32, CheckErr> {
        self.push_scope()
        for s in b.stmts { self.check_stmt(s)? }
        self.pop_scope()
        return Ok(0)
    }

    fun check_stmt(var self, s: Stmt) -> Result<int32, CheckErr> {
        return match s.kind {
            StmtKind.VarDecl(kind, name, ty, init) => {
                if kind == "async" { return self.check_async_let(s, name, ty, init) }
                var declared: Option<Type> = None
                match ty { Some(te) => { declared = Some(self.resolve_annotation(te)?) }, None => {} }
                if opt_has_error(declared) {
                    // the annotation names a failed alias: the binding has the
                    // error type and its value isn't checked (MYLA-110)
                    if !self.define_at(name, Type.TError, kind == "var", s.line, s.col, s.sp) { return Err(with_notes(terr_at(s.line, s.col, s.sp, format("'{}' is already declared in this scope", name)), self.first_declared(name))) }
                    return Ok(0)
                }
                let value_type = self.expect_value(init, declared)?
                var final_t = value_type
                match declared {
                    Some(d) => {
                        if !type_eq(value_type, d) { return Err(terr_at(s.line, s.col, s.sp, format("cannot assign value of type '{}' to binding of type '{}'", type_name(value_type), type_name(d)))) }
                        final_t = d
                    },
                    None => {},
                }
                if !self.define_at(name, final_t, kind == "var", s.line, s.col, s.sp) { return Err(with_notes(terr_at(s.line, s.col, s.sp, format("'{}' is already declared in this scope", name)), self.first_declared(name))) }
                Ok(0)
            },
            StmtKind.DestructDecl(kind, binding, ty, init) => {
                var declared: Option<Type> = None
                match ty { Some(te) => { declared = Some(self.resolve0(te)?) }, None => {} }
                let value_type = self.expect_value(init, declared)?
                match declared { Some(d) => { if !type_eq(value_type, d) { return Err(terr_at(s.line, s.col, s.sp, format("cannot assign value of type '{}' to binding of type '{}'", type_name(value_type), type_name(d)))) } }, None => {} }
                match value_type {
                    Type.TTuple(ets) => {
                        self.bind_elem(binding, value_type, kind == "var")?
                        Ok(0)
                    },
                    _ => Err(terr_at(s.line, s.col, s.sp, format("cannot destructure non-tuple value of type '{}'", type_name(value_type)))),
                }
            },
            StmtKind.Assign(target, value) => {
                match target.kind { ExprKind.Name(n) => { if n == "self" { return Err(terr_at(s.line, s.col, s.sp, "cannot reassign 'self'; mutate its fields or elements instead")) } }, _ => {} }
                let lv = self.check_lvalue(target)?
                if !lv.mutable { return Err(with_notes(terr_at(s.line, s.col, s.sp, "cannot assign to an immutable binding (declare it with 'var')"), self.declared_at(target))) }
                let vt = self.expect_value(value, Some(lv.ty))?
                if !type_eq(vt, lv.ty) { return Err(terr_at(s.line, s.col, s.sp, format("cannot assign '{}' to '{}'", type_name(vt), type_name(lv.ty)))) }
                Ok(0)
            },
            StmtKind.IfS(cond, then, otherwise) => {
                self.expect_type(cond, Type.TBool, "if condition")?
                self.check_block(then)?
                match otherwise {
                    Some(et) => match et {
                        ElseTail.ElseBlock(b) => { self.check_block(b)? },
                        ElseTail.ElseIf(s2) => { self.check_stmt(s2)? },
                    },
                    None => {},
                }
                Ok(0)
            },
            StmtKind.WhileS(cond, body) => {
                self.expect_type(cond, Type.TBool, "while condition")?
                self.loop_depth = self.loop_depth + 1
                self.check_block(body)?
                self.loop_depth = self.loop_depth - 1
                Ok(0)
            },
            StmtKind.ForS(var_name, start, end, body, iter) => self.check_for(s, var_name, start, end, body, iter),
            StmtKind.ReturnS(v, tail) => {
                if !tail { return self.check_return(s, v) }
                match v { Some(ve) => self.check_become(ve), None => Ok(0) }
            },
            StmtKind.BreakS => {
                if self.loop_depth == 0 { return Err(terr_at(s.line, s.col, s.sp, "'break' outside of a loop")) }
                Ok(0)
            },
            StmtKind.ContinueS => {
                if self.loop_depth == 0 { return Err(terr_at(s.line, s.col, s.sp, "'continue' outside of a loop")) }
                Ok(0)
            },
            StmtKind.ExprStmt(ex) => {
                match ex.kind { ExprKind.MatchE(sc, arms) => { self.stmt_match = true }, _ => {} }
                // a result of the error type is fine here: nothing uses it (MYLA-110)
                self.infer_node(ex, None)?
                Ok(0)
            },
        }
    }

    fun check_for(var self, s: Stmt, var_name: str, start: Option<Expr>, end: Option<Expr>, body: Block, iter: Option<Expr>) -> Result<int32, CheckErr> {
        var loop_t = t_int()
        match iter {
            Some(it_expr) => {
                let it = self.expect_value(it_expr, None)?
                loop_t = match it {
                    Type.TList(el) => el,
                    Type.TMap(k, v) => k,
                    _ => { return Err(terr_at(it_expr.line, it_expr.col, it_expr.sp, format("`for ... in` requires a list or map, found '{}'", type_name(it)))) },
                }
            },
            None => {
                let se = match start { Some(x) => x, None => { return Err(terr_at(s.line, s.col, s.sp, "for-range bounds must be integers")) } }
                let ee = match end { Some(x) => x, None => { return Err(terr_at(s.line, s.col, s.sp, "for-range bounds must be integers")) } }
                let st = self.expect_value(se, None)?
                let et = self.expect_value(ee, None)?
                loop_t = self.unify(se, st, ee, et)?
                if !is_int(loop_t) { return Err(terr_at(s.line, s.col, s.sp, "for-range bounds must be integers")) }
            },
        }
        self.push_scope()
        self.define(var_name, loop_t, false)
        self.loop_depth = self.loop_depth + 1
        self.check_block(body)?
        self.loop_depth = self.loop_depth - 1
        self.pop_scope()
        return Ok(0)
    }

    fun check_return(var self, s: Stmt, v: Option<Expr>) -> Result<int32, CheckErr> {
        if !self.has_cur_ret {
            match v {
                Some(ve) => {
                    if self.lambda_infer_active {
                        let vt = self.expect_value(ve, None)?
                        // positioned at the `return`, where Python reports a mismatch
                        push(self.lambda_infer, MatchVal { ty: vt, node: Some(Expr { id: ve.id, line: s.line, col: s.col, sp: s.sp, kind: ve.kind }) })
                    } else {
                        return Err(terr_at(s.line, s.col, s.sp, "cannot return a value from a function with no return type"))
                    }
                },
                None => {},
            }
            return Ok(0)
        }
        let ret = match self.cur_ret { Some(r) => r, None => t_int() }
        if has_error(ret) { return Ok(0) }   // the return type failed: the value isn't checked (MYLA-110)
        match v {
            None => { return Err(terr_at(s.line, s.col, s.sp, format("expected a return value of type '{}'", type_name(ret)))) },
            Some(ve) => {
                let vt = self.expect_value(ve, Some(ret))?
                if !type_eq(vt, ret) {
                    var notes: [Note] = []
                    if self.lambda_depth == 0 {
                        match self.ret_at { Some(te) => { notes = [note_at("the return type is declared here", te.line, te.col, te.sp)] }, None => {} }
                    }
                    return Err(with_notes(terr_at(s.line, s.col, s.sp, format("return type mismatch: expected '{}', found '{}'", type_name(ret), type_name(vt))), notes))
                }
            },
        }
        return Ok(0)
    }

    // `become ve` (D87): a call of a function, a method or a function value
    // that returns what the function does, whose arguments can be passed
    // without the function's frame (types.py: _check_become).
    fun check_become(var self, ve: Expr) -> Result<int32, CheckErr> {
        if self.lambda_depth > 0 { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' can't stand in a lambda")) }
        if self.in_async { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' can't stand in an async function")) }
        var callee = ve
        var args: [Expr] = []
        match ve.kind {
            ExprKind.Call(c, a) => {
                callee = c
                args = a
            },
            ExprKind.Try(x) => { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' needs a call, not a '?'")) },
            _ => { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' needs a call")) },
        }
        var partial = false
        for a in args { match a.kind { ExprKind.Hole => { partial = true }, _ => {} } }
        self.call_kind_id = -1
        let t = self.infer_node(ve, self.cur_ret)?
        var kind = ""
        if !partial && self.call_kind_id == ve.id { kind = self.call_kind }
        if kind == "" { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' needs a call of a function, a method or a function value")) }
        if opt_has_error(t) || opt_has_error(self.cur_ret) { return Err(poisoned()) }
        if !opt_type_eq(t, self.cur_ret) {
            var notes: [Note] = []
            match self.ret_at { Some(te) => { notes = [note_at("the return type is declared here", te.line, te.col, te.sp)] }, None => {} }
            return Err(with_notes(terr_at(ve.line, ve.col, ve.sp, format("'become' needs a call returning {}, found {}", quoted_or_nothing(self.cur_ret), quoted_or_nothing(t))), notes))
        }
        if kind == "value" && !self.in_param(callee) { return Err(terr_at(callee.line, callee.col, callee.sp, "'become' can only call a function value that is (a part of) a parameter")) }
        let target = self.call_target
        var all: [Expr] = []
        match callee.kind {
            ExprKind.GetField(recv, f) => {
                if kind == "method" {
                    // the method changes the receiver of the call that `become` ends
                    let on_self = match recv.kind { ExprKind.Name(n) => n == "self", _ => false }
                    if self.call_mutates && !on_self { return Err(terr_at(recv.line, recv.col, recv.sp, format("'become' can call the mutating method '{}' only on 'self'", f))) }
                    push(all, recv)
                }
            },
            _ => {},
        }
        for a in args { push(all, a) }
        var i = 0
        while i < len(all) {
            let arg = all[i]
            if contains(self.resolved, arg.id) {
                let at = self.resolved[arg.id]
                if !has_error(at) && !is_scalar_type(at) {
                    let frame = is_frame_value(at)
                    if kind == "value" {
                        // a function value borrows what it gets: a pointer to
                        // an aggregate, a heap value
                        if !self.in_param(arg) {
                            if frame { return Err(terr_at(arg.line, arg.col, arg.sp, format("'become' can only pass a '{}' that is (a part of) a parameter", type_name(at)))) }
                            return Err(terr_at(arg.line, arg.col, arg.sp, format("'become' can only pass a '{}' to a function value when it is (a part of) a parameter", type_name(at))))
                        }
                        let root = root_name(arg)
                        push(self.passed_on, PassedOn { func: self.fun_name, index: self.param_index(root), name: root, line: arg.line, col: arg.col, sp: arg.sp, decl: self.cur_decl })
                    } else if is_tfunc_type(at) {
                        // a function or method takes a struct, tuple or enum
                        // by value (D88) and a heap value owned (D87); a
                        // function value it gets by its address
                        if !self.in_param(arg) { return Err(terr_at(arg.line, arg.col, arg.sp, format("'become' can only pass a '{}' that is (a part of) a parameter", type_name(at)))) }
                    } else if !(i == 0 && self.call_mutates) {
                        // (a `var self` receiver is its caller's variable)
                        let key = format("{}\t{}", target, i)
                        if !contains(self.handovers, key) { self.handovers[key] = Handover { func: target, index: i, by: self.fun_name, line: arg.line, col: arg.col, sp: arg.sp } }
                    }
                }
            }
            i = i + 1
        }
        return Ok(0)
    }

    // Whether `e` is a parameter of the function being checked or a field or
    // element of one, which lives in its caller's storage.
    fun in_param(self, e: Expr) -> bool {
        var x = e
        var walking = true
        while walking {
            match x.kind {
                ExprKind.GetField(t, f) => { x = t },
                ExprKind.TupleIndex(t, k) => { x = t },
                _ => { walking = false },
            }
        }
        let n = match x.kind { ExprKind.Name(nm) => nm, _ => "" }
        if n == "" { return false }
        var i = len(self.frames) - 1
        while i >= 0 {
            if contains_str(self.frames[i].names, n) { return i == 0 }
            i = i - 1
        }
        return false
    }

    fun param_index(self, name: str) -> int32 {
        var i = 0
        while i < len(self.frames[0].names) {
            if self.frames[0].names[i] == name { return i }
            i = i + 1
        }
        return -1
    }

    // A heap value a `become` passes on to a function value stays its
    // caller's, so a `become` can't hand one over to that parameter.
    fun check_passed_on(var self) {
        for p in self.passed_on {
            let key = format("{}\t{}", p.func, p.index)
            if !contains(self.handovers, key) { continue }
            if self.full() { return }
            let h = self.handovers[key]
            let msg = format("'become' can't pass '{}' on to a function value: a 'become' in '{}' hands it over to '{}'", p.name, h.by, p.func)
            push(self.errs, CheckErr { line: p.line, col: p.col, sp: p.sp, msg: msg, decl: p.decl, notes: [note_at("it is handed over here", h.line, h.col, h.sp)] })
        }
    }

    // -- concurrency (D89; types.py: _check_isolation, _infer_await, ...) ----

    // Whether `key` names an actor (an empty table needs no hashing).
    fun is_actor(self, key: str) -> bool {
        return len(self.actors) > 0 && contains(self.actors, key)
    }

    // The first construct of concurrency met, which the interpreters and
    // backends refuse until they run it (MYLA-136, MYLA-137).
    fun met_concurrency(var self, line: int32, col: int32, sp: SrcSpan, node: int32) {
        if self.conc_line == 0 {
            self.conc_node = node
            self.conc_line = line
            self.conc_col = col
            self.conc_sp = sp
        }
    }

    // An actor's fields are reachable only through `self` in its own methods.
    fun check_isolation(self, sname: str, target: Expr, field: str, e: Expr) -> Result<int32, CheckErr> {
        if !self.is_actor(sname) { return Ok(0) }
        let own = match target.kind { ExprKind.Name(n) => n == "self" && self.actor_self == sname, _ => false }
        if own { return Ok(0) }
        return Err(terr_at(e.line, e.col, e.sp, format("'{}' belongs to the actor '{}': only its own methods reach it", field, type_name(Type.TStruct(sname, [])))))
    }

    // `task.cancel(a)` (D96): `a` names an `async let` in scope, as an `await`
    // of it would; the call has no result (types.py: _infer_task_cancel).
    fun infer_task_cancel(var self, e: Expr, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if len(args) == 1 {
            match args[0].kind {
                ExprKind.Name(n) => {
                    match self.lookup(n) {
                        Some(b) => {
                            if b.task > 0 {
                                let d = self.lookup_frame(n)
                                for lam in self.lams {
                                    if d < lam.base { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("a lambda can't cancel the child task '{}' of its function", n))) }
                                }
                                self.met_concurrency(e.line, e.col, e.sp, e.id)
                                if b.task != 2 { self.record_type(args[0].id, Some(b.ty)) }
                                return Ok(None)
                            }
                        },
                        None => {},
                    }
                },
                _ => {},
            }
            return Err(terr_at(args[0].line, args[0].col, args[0].sp, "task.cancel() takes the name of an 'async let'"))
        }
        return Err(terr_at(e.line, e.col, e.sp, "task.cancel() takes the name of an 'async let'"))
    }

    // `await x`: in async code, a call that may suspend or an `async let`'s name.
    fun infer_await(var self, e: Expr, op: Expr, expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        if !self.in_async { return Err(terr_at(e.line, e.col, e.sp, "'await' can only stand in an async function")) }
        if self.in_guard { return Err(terr_at(e.line, e.col, e.sp, "'await' can't stand in a match guard: bind the awaited value before the 'match'")) }
        match op.kind {
            ExprKind.Name(n) => {
                match self.lookup(n) {
                    Some(b) => {
                        if b.task > 0 {
                            let d = self.lookup_frame(n)
                            for lam in self.lams {
                                if d < lam.base { return Err(terr_at(op.line, op.col, op.sp, format("a lambda can't await the child task '{}' of its function", n))) }
                            }
                            if b.task == 2 { return Ok(None) }
                            self.record_type(op.id, Some(b.ty))
                            return Ok(Some(b.ty))
                        }
                    },
                    None => {},
                }
            },
            ExprKind.Call(c, args) => {
                self.awaited[op.id] = true
                self.suspended = -1
                let t = self.infer_node(op, expected)?
                if self.suspended == op.id { return Ok(t) }
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, "'await' needs a call that may suspend (an async function, an actor's method) or the name of an 'async let'"))
    }

    // The call `e` just inferred (marked by `mark_call`) stands under `await`
    // if it may suspend: a call of an async function, method or function
    // value, or of an actor's method from outside it.
    fun check_suspension(var self, e: Expr, callee: Expr) -> Result<int32, CheckErr> {
        var why = ""
        if self.call_kind == "method" {
            var own = false
            var field = ""
            match callee.kind {
                ExprKind.GetField(tg, f) => {
                    field = f
                    own = match tg.kind { ExprKind.Name(n) => n == "self" && self.actor_self == self.call_key, _ => false }
                },
                _ => {},
            }
            if self.is_actor(self.call_key) && !own { why = format("a call into the actor '{}' needs 'await'", type_name(Type.TStruct(self.call_key, []))) }
            else if self.call_async { why = format("a call to the async method '{}' needs 'await'", field) }
        } else if self.call_kind == "value" {
            if self.call_async { why = "a call to an async function value needs 'await'" }
        } else if self.call_async {
            why = format("a call to the async function '{}' needs 'await'", self.call_target)
        }
        if why == "" { return Ok(0) }
        self.suspended = e.id
        if !contains(self.awaited, e.id) { return Err(terr_at(e.line, e.col, e.sp, why)) }
        return Ok(0)
    }

    // `async let name = init` (s): a child task in async code; a call it makes
    // is awaited by the task.
    fun check_async_let(var self, s: Stmt, name: str, ty: Option<TypeExpr>, init: Expr) -> Result<int32, CheckErr> {
        if !self.in_async { return Err(terr_at(s.line, s.col, s.sp, "'async let' can only stand in an async function")) }
        if self.task_line == 0 {
            self.task_line = s.line
            self.task_col = s.col
            self.task_sp = s.sp
            self.task_node = self.cur_decl
        }
        var declared: Option<Type> = None
        match ty { Some(te) => { declared = Some(self.resolve_annotation(te)?) }, None => {} }
        var t: Option<Type> = None
        if !opt_has_error(declared) {
            match init.kind { ExprKind.Call(c, a) => { self.awaited[init.id] = true }, _ => {} }
            self.task_init = true
            let it = self.infer(init, declared)
            self.task_init = false
            t = it?
            match declared {
                Some(d) => {
                    if !opt_has_error(t) && !opt_type_eq(t, declared) { return Err(terr_at(s.line, s.col, s.sp, format("type mismatch in 'async let': declared '{}', found '{}'", type_name(d), opt_type_name(t)))) }
                    t = declared
                },
                None => {},
            }
        } else {
            t = declared
        }
        if !self.define_task(name, t, s.line, s.col, s.sp) { return Err(with_notes(terr_at(s.line, s.col, s.sp, format("'{}' is already declared in this scope", name)), self.first_declared(name))) }
        return Ok(0)
    }

    // The kind of the call `e` just inferred, for `become`; for a method the
    // key of its type, and whether the callee is async (D89).
    fun mark_call(var self, e: Expr, kind: str, target: str, mutates: bool, key: str, asy: bool) {
        self.call_kind = kind
        self.call_kind_id = e.id
        self.call_target = target
        self.call_mutates = mutates
        self.call_key = key
        self.call_async = asy
    }

    fun bind_elem(var self, be: BindElem, t: Type, mutable: bool) -> Result<int32, CheckErr> {
        return match be {
            BindElem.BWild => Ok(0),
            BindElem.BName(n, ln, cl, sp) => {
                if !self.define_at(n, t, mutable, ln, cl, sp) { return Err(with_notes(terr_at(ln, cl, sp, format("'{}' is already declared in this scope", n)), self.first_declared(n))) }
                Ok(0)
            },
            BindElem.BTuple(elems, ln, cl, sp) => {
                match t {
                    Type.TTuple(ets) => {
                        if len(elems) != len(ets) { return Err(terr_at(ln, cl, sp, format("tuple pattern expects {} element(s), but value has {}", len(elems), len(ets)))) }
                        var i = 0
                        while i < len(elems) { self.bind_elem(elems[i], ets[i], mutable)?
            i = i + 1 }
                        Ok(0)
                    },
                    _ => Err(terr_at(ln, cl, sp, format("cannot destructure non-tuple value of type '{}'", type_name(t)))),
                }
            },
        }
    }

    fun check_lvalue(var self, e: Expr) -> Result<LValue, CheckErr> {
        let lv = self.check_lvalue_node(e)?
        if has_error(lv.ty) { return Err(poisoned()) }
        return Ok(lv)
    }

    fun check_lvalue_node(var self, e: Expr) -> Result<LValue, CheckErr> {
        return match e.kind {
            ExprKind.Name(n) => {
                // a lambda holds copies of what it captures (D48): a change to
                // one would reach neither the variable nor its next call (D93)
                if len(self.lams) > 0 && self.frame_of(n) >= 0 && self.frame_of(n) < self.lams[len(self.lams) - 1].base {
                    return Err(with_notes(terr_at(e.line, e.col, e.sp, format("a lambda can't change '{}', a variable it captures: it holds a copy of its own", n)), [Note { label: "help", msg: "return the new value, or keep shared state in an actor", line: 0, col: 0, sp: no_span() }]))
                }
                match self.lookup(n) { Some(b) => Ok(LValue { ty: b.ty, mutable: b.mutable }), None => Err(with_notes(terr_at(e.line, e.col, e.sp, format("unknown name '{}'", n)), did_you_mean(n, self.scope_names()))) }
            },
            ExprKind.GetField(target, field) => {
                let base = self.check_lvalue(target)?
                match struct_view(base.ty) {
                    Type.TStruct(nm, args) => {
                        self.check_isolation(nm, target, field, e)?
                        let fields = self.struct_field_types(nm, args)
                        match field_type_get(fields, field) { Some(ft) => Ok(LValue { ty: ft, mutable: base.mutable }), None => Err(with_notes(terr_at(e.line, e.col, e.sp, format("struct '{}' has no field '{}'", nm, field)), did_you_mean(field, field_names(fields)))) }
                    },
                    _ => Err(terr_at(e.line, e.col, e.sp, format("type '{}' has no fields", type_name(base.ty)))),
                }
            },
            ExprKind.Index(target, index) => {
                let base = self.check_lvalue(target)?
                match base.ty {
                    Type.TMap(k, v) => { self.expect_type(index, k, "map key")?
            Ok(LValue { ty: v, mutable: base.mutable }) },
                    Type.TStr => Err(terr_at(e.line, e.col, e.sp, "strings are immutable; `s[i]` cannot be assigned to")),
                    Type.TList(el) => {
                        let it = self.expect_value(index, Some(t_int()))?
                        if !is_int(it) { return Err(terr_at(index.line, index.col, index.sp, format("list index must be an integer, found '{}'", type_name(it)))) }
                        Ok(LValue { ty: el, mutable: base.mutable })
                    },
                    _ => Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a list and cannot be indexed with `[...]`", type_name(base.ty)))),
                }
            },
            _ => Err(terr_at(e.line, e.col, e.sp, "invalid assignment target")),
        }
    }

    fun check_function(var self, fd: FunData) -> Result<int32, CheckErr> {
        let idx = self.func_idx(fd.name)
        let sig = self.functions[idx]
        self.cur_ret = sig.ret
        self.has_cur_ret = match sig.ret { Some(x) => true, None => false }
        self.ret_at = fd.ret_type
        self.fun_name = fd.name
        self.type_params = sig.type_params
        self.bounds_cur = sig.bounds
        self.frames = []
        self.push_scope()
        self.in_async = fd.is_async
        if fd.is_async { self.met_concurrency(fd.line, fd.col, fd.sp, self.cur_decl) }
        if self.is_actor(self.cur_key) { self.actor_self = self.cur_key } else { self.actor_self = "" }
        let recv = match fd.receiver { Some(r) => r, None => "" }
        var i = 0
        while i < len(fd.params) {
            let mutable = i == 0 && recv == "var self"
            // the synthesized receiver has no place of its own for a note
            if i == 0 && recv != "" { self.define(fd.params[i].name, sig.params[i], mutable) }
            else { self.define_at(fd.params[i].name, sig.params[i], mutable, fd.params[i].line, fd.params[i].col, fd.params[i].sp) }
            i = i + 1
        }
        match fd.body {
            Some(b) => {
                self.check_block(b)?
                if self.has_cur_ret && !block_returns(b) {
                    self.type_params = []
                    self.bounds_cur = []
                    return Err(terr_at(fd.line, fd.col, fd.sp, format("function '{}' may finish without returning a '{}'", fd.name, opt_type_name(sig.ret))))
                }
            },
            None => {},
        }
        self.type_params = []
        self.bounds_cur = []
        return Ok(0)
    }
}

// =========================================================================
// #derive(Eq) (v0.4.4) - validate + register a structural Eq impl
// =========================================================================

fun is_eq_type(t: Type, eq_names: [str]) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TBool => true,
        Type.TStr => true,
        Type.TChar => true,
        Type.TFloat(w) => true,
        Type.TError => true,          // has had its error (MYLA-110)
        Type.TStruct(n, a) => contains_str(eq_names, n),
        Type.TEnum(n, a) => contains_str(eq_names, n),
        _ => false,
    }
}

impl Checker {
    fun synthesize_derives(var self) -> Result<int32, CheckErr> {
        var targets: [Decl] = []
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if contains(self.skipped_decls, pos) { continue }
            self.cur_decl = decl.id
            let attrs = decl_attrs(decl)
            let is_se = match decl.kind { DeclKind.StructDecl(n, f, a, t, p, act) => true, DeclKind.EnumDecl(n, v, a, t, p) => true, _ => false }
            for attr in attrs {
                if attr.name != "derive" { continue }
                match self.check_derive_attr(decl, attr) {
                    Ok(x) => {
                        var present = false
                        for d in targets { if d.line == decl.line && d.col == decl.col { present = true } }
                        if !present { push(targets, decl) }
                    },
                    Err(e) => {
                        self.record(e)?
                        // Eq is broken for the type: its uses stop silently (MYLA-110)
                        if is_se { self.broken_impls["Eq\t" + decl_kind_name(decl)] = true }
                    },
                }
            }
        }
        if len(targets) == 0 { return Ok(0) }
        var eq_names: [str] = []
        for d in targets { push(eq_names, decl_kind_name(d)) }
        // an `impl Eq` for a type that doesn't exist may have been meant for
        // any of them: a type that isn't Eq is then no news (MYLA-110)
        var lost_eq = false
        for d in self.impl_decls {
            match impl_eq_target_name(d) {
                Some(nm) => {
                    if !contains_str(eq_names, nm) { push(eq_names, nm) }
                    if !self.names_a_type(nm) { lost_eq = true }
                },
                None => {},
            }
        }
        for decl in targets {
            self.cur_decl = decl.id
            let name = decl_kind_name(decl)
            // explicit `impl Eq for name`? (it stands)
            var explicit = false
            for d in self.impl_decls {
                match impl_eq_target_name(d) {
                    Some(nm) => { if nm == name { explicit = true } },
                    None => {},
                }
            }
            if explicit {
                self.record(terr_at(decl.line, decl.col, decl.sp, format("type '{}' both derives Eq and has an explicit 'impl Eq for {}'", name, name)))?
                continue
            }
            match self.check_derivable_eq(decl, name, eq_names) {
                Ok(x) => {},
                Err(e) => {
                    if !lost_eq { self.record(e)? }
                    self.broken_impls["Eq\t" + name] = true
                    continue
                },
            }
            // register the synthesized Eq impl: method `eq: (Self,Self)->bool`
            var self_t = Type.TEnum(name, [])
            if self.is_struct(name) { self_t = Type.TStruct(name, []) }
            let fdecl = FunData { line: decl.line, col: decl.col, sp: no_span(), name: format("{}.eq", name), params: [], ret_type: None, body: None, attributes: [], type_params: [], receiver: Some("self"), is_pub: false, is_async: false }
            let sig = FuncSig { name: format("{}.eq", name), params: [self_t, self_t], ret: Some(Type.TBool), type_params: [], bounds: [], decl: fdecl, has_decl: true, decl_id: decl.id }
            self.add_method(MethodEntry { key: name, name: "eq", sig: sig })
            push(self.trait_impls, TraitImplPair { trait_name: "Eq", key: name })
            push(self.user_trait_impls, TraitImplPair { trait_name: "Eq", key: name })
        }
        return Ok(0)
    }

    fun check_derive_attr(self, decl: Decl, attr: Attribute) -> Result<int32, CheckErr> {
        let is_se = match decl.kind { DeclKind.StructDecl(n, f, a, t, p, act) => true, DeclKind.EnumDecl(n, v, a, t, p) => true, _ => false }
        if !is_se { return Err(terr_at(attr.line, attr.col, attr.sp, "'#derive' may only be applied to a struct or enum")) }
        let has_tps = match decl.kind {
            DeclKind.StructDecl(n, f, a, t, p, act) => len(t) > 0,
            DeclKind.EnumDecl(n, v, a, t, p) => len(t) > 0,
            _ => false,
        }
        if has_tps { return Err(terr_at(attr.line, attr.col, attr.sp, "deriving on generic types is not supported yet (v0.4.4 derives Eq for concrete structs/enums)")) }
        return self.validate_derive_attr(attr)
    }

    // Whether `name` is a type the program or the language declares.
    fun names_a_type(self, name: str) -> bool {
        if self.struct_idx(name) >= 0 || self.enum_idx(name) >= 0 || self.alias_idx(name) >= 0 { return true }
        match prim_type(name) { Some(t) => { return true }, None => {} }
        return name == "int" || name == "float"
    }

    fun validate_derive_attr(self, attr: Attribute) -> Result<int32, CheckErr> {
        match attr.outputs { Some(x) => { return Err(terr_at(attr.line, attr.col, attr.sp, "'#derive' takes trait names in parentheses, e.g. #derive(Eq)")) }, None => {} }
        if len(attr.args) == 0 { return Err(terr_at(attr.line, attr.col, attr.sp, "'#derive' needs at least one trait, e.g. #derive(Eq)")) }
        for a in attr.args {
            match a.kind {
                ExprKind.Name(id) => { if id != "Eq" { return Err(terr_at(a.line, a.col, a.sp, format("cannot derive '{}'; only 'Eq' is derivable in v0.4.4 (Ord is the planned next addition)", id))) } },
                _ => { return Err(terr_at(a.line, a.col, a.sp, "'#derive' arguments must be trait names")) },
            }
        }
        return Ok(0)
    }

    fun check_derivable_eq(self, decl: Decl, name: str, eq_names: [str]) -> Result<int32, CheckErr> {
        let si = self.struct_idx(name)
        if si >= 0 {
            for f in self.structs[si].fields { if !is_eq_type(f.ty, eq_names) { return Err(terr_at(decl.line, decl.col, decl.sp, format("cannot derive Eq for struct '{}': field '{}' has type '{}', which is not Eq", name, f.name, type_name(f.ty)))) } }
            return Ok(0)
        }
        let ei = self.enum_idx(name)
        if ei >= 0 {
            for v in self.enums[ei].variants {
                var i = 0
                for pt in v.payload {
                    if !is_eq_type(pt, eq_names) { return Err(terr_at(decl.line, decl.col, decl.sp, format("cannot derive Eq for enum '{}': payload #{} of variant '{}' has type '{}', which is not Eq", name, i, v.name, type_name(pt)))) }
                    i = i + 1
                }
            }
        }
        return Ok(0)
    }
}

fun decl_attrs(d: Decl) -> [Attribute] {
    return match d.kind {
        DeclKind.StructDecl(n, f, a, t, p, act) => a,
        DeclKind.EnumDecl(n, v, a, t, p) => a,
        DeclKind.TypeAliasDecl(n, tt, a, p) => a,
        DeclKind.ConstDecl(n, tt, vv, a, p) => a,
        DeclKind.FunDecl(fd) => fd.attributes,
        _ => empty_attrs(),
    }
}

// =========================================================================
// const folding
// =========================================================================

// A folded const value; float values and values derived from them are not tracked.
pub enum CV { CVInt(int64), CVFloat, CVBool(bool), CVStr(str), CVUnknown }

impl Checker {
    fun fold_consts(var self) -> Result<int32, CheckErr> {
        var i = 0
        while i < len(self.const_decls) {
            match self.ensure_const(self.const_decls[i].name) {
                Ok(t) => {},
                Err(e) => { if is_stopped(e) { return Err(e) } },   // its error, if any, is collected
            }
            i = i + 1
        }
        return Ok(0)
    }

    fun const_done_idx(self, name: str) -> int32 {
        var i = 0
        while i < len(self.consts) { if self.consts[i].name == name { return i }
            i = i + 1
        }
        return -1
    }

    fun ensure_const(var self, name: str) -> Result<Type, CheckErr> {
        let di = self.const_done_idx(name)
        if di >= 0 { return Ok(self.consts[di].ty) }
        let ci = self.const_decl_idx(name)
        let decl = self.const_decls[ci]
        // errors folding it are in the const's file, wherever it is used from
        let outer_decl = self.cur_decl
        if contains_str(self.const_folding, name) { return Err(terr_at(decl.line, decl.col, decl.sp, format("const '{}' is defined in terms of itself", name))) }
        self.cur_decl = decl.id
        push(self.const_folding, name)
        // a const that fails keeps its declared type, if that resolved, and
        // no value: its error is collected here, once, and the consts folded
        // from it fail silently (MYLA-110)
        var declared = Type.TError
        var fail: Option<CheckErr> = None
        match self.resolve0(decl.declared) {
            Ok(t) => {
                if is_type_param(t) { fail = Some(terr_at(decl.line, decl.col, decl.sp, "a const type must be concrete")) }
                else {
                    declared = t
                    if has_error(t) { fail = Some(poisoned()) }
                }
            },
            Err(e) => { fail = Some(e) },
        }
        if match fail { Some(x) => false, None => true } {
            self.push_scope()
            let r = self.expect_value(decl.value, Some(declared))
            self.pop_scope()
            match r {
                Ok(vt) => {
                    if !type_eq(vt, declared) { fail = Some(terr_at(decl.value.line, decl.value.col, decl.value.sp, format("const '{}' is declared '{}' but its value has type '{}'", name, type_name(declared), type_name(vt)))) }
                    else {
                        match self.fold_const_expr(decl.value) {
                            Ok(v) => { self.const_values[name] = v },
                            Err(e) => { fail = Some(e) },
                        }
                    }
                },
                Err(e) => { fail = Some(e) },
            }
        }
        self.const_folding = remove_str(self.const_folding, name)
        push(self.consts, AliasCached { name: name, ty: declared })
        match fail {
            Some(e) => {
                self.failed_consts[name] = true
                self.record(e)?
                self.cur_decl = outer_decl
                return Err(poisoned())
            },
            None => {},
        }
        self.cur_decl = outer_decl
        return Ok(declared)
    }

    // The value of a const initializer, as types.py folds it: integers wrapped
    // to each node's type. Float values aren't tracked (`CVFloat`), so a float
    // cast to an integer folds to an unknown value (`CVUnknown`).
    fun fold_const_expr(var self, e: Expr) -> Result<CV, CheckErr> {
        let t = self.node_type(e)
        return match e.kind {
            ExprKind.IntLit(v, suf, isc, big) => {
                if is_char(t) { return Ok(CV.CVInt(v)) }      // a char folds to its codepoint
                Ok(CV.CVInt(wrap_int(v, t)))
            },
            ExprKind.FloatLit(lex, suf) => Ok(CV.CVFloat),
            ExprKind.BoolLit(b) => Ok(CV.CVBool(b)),
            ExprKind.StrLit(s) => Ok(CV.CVStr(s)),
            ExprKind.Name(n) => {
                if self.const_decl_idx(n) < 0 { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is not a constant and cannot appear in a const initializer", n))) }
                self.ensure_const(n)?
                if contains(self.failed_consts, n) { return Err(poisoned()) }
                return match get(self.const_values, n) { Some(v) => Ok(v), None => Ok(CV.CVUnknown) }
            },
            ExprKind.Unary(op, x) => {
                let v = self.fold_const_expr(x)?
                if op == "!" { return Ok(CV.CVBool(!cv_bool(v))) }
                if is_float(t) { return Ok(CV.CVFloat) }
                return match v {
                    CV.CVInt(i) => Ok(CV.CVInt(wrap_int(if_neg(op == "-", i), t))),
                    _ => Ok(CV.CVUnknown),
                }
            },
            ExprKind.Cast(x, ty) => {
                let v = self.fold_const_expr(x)?
                let src = self.node_type(x)
                if is_float(t) { return Ok(CV.CVFloat) }
                return match v {
                    CV.CVInt(i) => {
                        if is_char(t) { return Ok(CV.CVInt(i)) }
                        Ok(CV.CVInt(wrap_int(i, t)))
                    },
                    _ => Ok(CV.CVUnknown),
                }
            },
            ExprKind.Binary(op, l, r) => self.fold_const_binary(e, op, l, r, t),
            _ => Err(terr_at(e.line, e.col, e.sp, "const initializer must be a constant expression (literals, other consts, and arithmetic/bitwise/comparison/cast operations over them)")),
        }
    }

    fun node_type(self, e: Expr) -> Type {
        return match get(self.resolved, e.id) { Some(t) => t, None => t_int() }
    }

    fun fold_const_binary(var self, e: Expr, op: str, l: Expr, r: Expr, t: Type) -> Result<CV, CheckErr> {
        if op == "&&" {
            let lv = self.fold_const_expr(l)?
            if !cv_bool(lv) { return Ok(CV.CVBool(false)) }
            return Ok(CV.CVBool(cv_bool(self.fold_const_expr(r)?)))
        }
        if op == "||" {
            let lv = self.fold_const_expr(l)?
            if cv_bool(lv) { return Ok(CV.CVBool(true)) }
            return Ok(CV.CVBool(cv_bool(self.fold_const_expr(r)?)))
        }
        let lv = self.fold_const_expr(l)?
        let rv = self.fold_const_expr(r)?
        if op == "==" || op == "!=" {
            return match cv_equal(lv, rv) {
                Some(eq) => Ok(CV.CVBool(eq == (op == "=="))),
                None => Ok(CV.CVUnknown),
            }
        }
        if is_float(t) { return Ok(CV.CVFloat) }
        if op == "+" {
            // strings concatenate (the code generator emits a str const's value)
            match (lv, rv) {
                (CV.CVStr(x), CV.CVStr(y)) => { return Ok(CV.CVStr(x + y)) },
                _ => {},
            }
        }
        let li = match lv { CV.CVInt(x) => x, _ => { return Ok(CV.CVUnknown) } }
        let ri = match rv { CV.CVInt(x) => x, _ => { return Ok(CV.CVUnknown) } }
        if op == "+" { return Ok(CV.CVInt(wrap_int(li + ri, t))) }
        if op == "-" { return Ok(CV.CVInt(wrap_int(li - ri, t))) }
        if op == "*" { return Ok(CV.CVInt(wrap_int(li * ri, t))) }
        if op == "/" || op == "%" {
            if ri == 0 { return Err(terr_at(e.line, e.col, e.sp, "const division by zero")) }
            if is_u64(t) {
                let q = ((li as uint64) / (ri as uint64)) as int64
                if op == "/" { return Ok(CV.CVInt(q)) }
                return Ok(CV.CVInt(li - q * ri))
            }
            let q = li / ri                                  // truncates toward zero, like _const_idiv
            if op == "/" { return Ok(CV.CVInt(wrap_int(q, t))) }
            return Ok(CV.CVInt(wrap_int(li - q * ri, t)))
        }
        if op == "&" { return Ok(CV.CVInt(wrap_int(li & ri, t))) }
        if op == "|" { return Ok(CV.CVInt(wrap_int(li | ri, t))) }
        if op == "^" { return Ok(CV.CVInt(wrap_int(li ^ ri, t))) }
        let w = int_width(t) as int64
        if op == "<<" { return Ok(CV.CVInt(wrap_int(li << (ri & (w - 1)), t))) }
        if op == ">>" {
            let lw = wrap_int(li, self.node_type(l))
            if is_u64(t) { return Ok(CV.CVInt(((lw as uint64) >> ((ri & (w - 1)) as uint64)) as int64)) }
            return Ok(CV.CVInt(wrap_int(lw >> (ri & (w - 1)), t)))
        }
        // comparisons, unsigned for uint64 (stored as int64)
        let lt_ = int_less(li, ri, self.node_type(l))
        let gt_ = int_less(ri, li, self.node_type(l))
        if op == "<" { return Ok(CV.CVBool(lt_)) }
        if op == "<=" { return Ok(CV.CVBool(!gt_)) }
        if op == ">" { return Ok(CV.CVBool(gt_)) }
        if op == ">=" { return Ok(CV.CVBool(!lt_)) }
        return Ok(CV.CVUnknown)
    }
}

// `v` wrapped into integer type `t` (two's complement); other types unchanged.
fun wrap_int(v: int64, t: Type) -> int64 {
    return match t {
        Type.TInt(w, signed) => {
            if w >= 64 { return v }
            let m = v & (((1 as int64) << (w as int64)) - 1)
            if signed && ((m >> ((w - 1) as int64)) & 1) == 1 { return m - ((1 as int64) << (w as int64)) }
            m
        },
        _ => v,
    }
}

fun is_u64(t: Type) -> bool {
    return match t { Type.TInt(w, signed) => w == 64 && !signed, _ => false }
}

fun int_less(a: int64, b: int64, t: Type) -> bool {
    if is_u64(t) { return (a as uint64) < (b as uint64) }
    return a < b
}

fun if_neg(neg: bool, v: int64) -> int64 {
    if neg { return 0 - v }
    return ~v
}

fun cv_bool(v: CV) -> bool {
    return match v { CV.CVBool(b) => b, _ => false }
}

fun cv_equal(a: CV, b: CV) -> Option<bool> {
    return match (a, b) {
        (CV.CVInt(x), CV.CVInt(y)) => Some(x == y),
        (CV.CVBool(x), CV.CVBool(y)) => Some(x == y),
        (CV.CVStr(x), CV.CVStr(y)) => Some(x == y),
        _ => None,
    }
}

fun remove_str(xs: [str], s: str) -> [str] {
    var out: [str] = []
    for x in xs { if x != s { push(out, x) } }
    return out
}

// =========================================================================
// Attributes & entry point
// =========================================================================

impl Checker {
    // Every declaration's attributes, each on its own, then the entry point
    // (types.py: _check_attributes_and_entry): errors are collected.
    fun check_attributes_and_entry(var self) {
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if self.full() { return }
            if contains(self.skipped_decls, pos) { continue }
            self.reset_state(decl.id)
            match self.check_attributes(decl) {
                Ok(x) => {},
                Err(e) => { self.note(e) },
            }
        }
        if self.full() { return }
        var main_names: [str] = []
        for m in self.mains { push(main_names, m.name) }
        let named_main = self.func_idx("main")
        if len(self.mains) > 0 && named_main >= 0 && !contains_str(main_names, "main") {
            let d = self.functions[named_main].decl
            self.reset_state(self.functions[named_main].decl_id)
            self.note(terr_at(d.line, d.col, d.sp, "both a '#main' function and a function named 'main' are present"))
        } else if len(self.mains) > 1 {
            self.reset_state(self.mains[1].id)
            self.note(terr_at(self.mains[1].line, self.mains[1].col, self.mains[1].sp, "more than one '#main' entry point"))
        } else {
            // the entry point: the `#main` function, else `main`
            var ei = named_main
            if len(self.mains) > 0 { ei = self.func_idx(self.mains[0].name) }
            if ei >= 0 && len(self.functions[ei].decl.params) > 0 {
                let d = self.functions[ei].decl
                self.reset_state(self.functions[ei].decl_id)
                self.note(terr_at(d.line, d.col, d.sp, "entry point must take no parameters in v0.0"))
            }
        }
    }

    // `decl`'s attributes (types.py: _check_attributes); each `#main`
    // function goes to `mains`.
    fun check_attributes(var self, decl: Decl) -> Result<int32, CheckErr> {
        let attrs = decl_attrs(decl)
        let is_fun = match decl.kind { DeclKind.FunDecl(fd) => true, _ => false }
        for attr in attrs {
            if attr.name == "derive" { continue }
            if attr.name != "main" && attr.name != "test" { return Err(terr_at(attr.line, attr.col, attr.sp, format("unknown attribute '#{}'", attr.name))) }
            if !is_fun { return Err(terr_at(attr.line, attr.col, attr.sp, format("attribute '#{}' may only be applied to functions", attr.name))) }
            match decl.kind {
                DeclKind.FunDecl(fd) => {
                    if len(fd.type_params) > 0 { return Err(terr_at(attr.line, attr.col, attr.sp, format("attribute '#{}' cannot be applied to a generic function (it has no single concrete instantiation)", attr.name))) }
                    if attr.name == "main" {
                        match attr.outputs { Some(x) => { return Err(terr_at(attr.line, attr.col, attr.sp, "'#main' takes no arguments")) }, None => {} }
                        if len(attr.args) > 0 { return Err(terr_at(attr.line, attr.col, attr.sp, "'#main' takes no arguments")) }
                        push(self.mains, MainAt { line: fd.line, col: fd.col, sp: fd.sp, name: fd.name, id: decl.id })
                    } else {
                        self.check_test_attr(decl, fd, attr)?
                    }
                },
                _ => {},
            }
        }
        return Ok(0)
    }

    fun check_test_attr(var self, decl: Decl, fd: FunData, attr: Attribute) -> Result<int32, CheckErr> {
        if fd.is_async { return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' can't run an async function")) }
        let idx = self.func_idx(fd.name)
        let sig = self.functions[idx]
        let outs = match attr.outputs { Some(x) => x, None => { return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' requires an expected result, e.g. #test(args)[expected]")) } }
        match sig.ret { Some(x) => {}, None => { return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' requires the function to return a value")) } }
        if len(attr.args) != len(sig.params) { return Err(terr_at(attr.line, attr.col, attr.sp, format("'#test' expects {} argument(s), got {}", len(sig.params), len(attr.args)))) }
        if sig_has_error(sig.params, sig.ret) { return Err(poisoned()) }   // the signature failed (MYLA-110)
        self.push_scope()
        var i = 0
        while i < len(attr.args) {
            let at = self.expect_value(attr.args[i], Some(sig.params[i]))?
            if !type_eq(at, sig.params[i]) {
                self.pop_scope()
                return Err(terr_at(attr.args[i].line, attr.args[i].col, attr.args[i].sp, format("'#test' argument type mismatch: expected '{}', found '{}'", type_name(sig.params[i]), type_name(at))))
            }
            i = i + 1
        }
        if len(outs) != 1 { self.pop_scope()
            return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' expects exactly one expected value in [...]")) }
        let rt = match sig.ret { Some(x) => x, None => t_int() }
        let ot = self.expect_value(outs[0], Some(rt))?
        self.pop_scope()
        if !type_eq(ot, rt) { return Err(terr_at(outs[0].line, outs[0].col, outs[0].sp, format("'#test' expected value type mismatch: expected '{}', found '{}'", type_name(rt), type_name(ot)))) }
        return Ok(0)
    }

    // -- driver -----------------------------------------------------------

    // Check the program: the declaration phases, which collect each part's
    // error and go on (MYLA-110, D84), then every function's attributes and
    // body on its own (types.py: Checker.check). Err: the errors, in the order
    // found (MYLA-65, D80).
    fun run_all(var self) -> Result<int32, [CheckErr]> {
        match self.run_phases() {
            Ok(x) => {},
            Err(e) => {
                if !is_stopped(e) { self.note(e) }
                return Err(self.errs)
            },
        }
        self.bodies = true
        self.check_attributes_and_entry()
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if contains(self.skipped_decls, pos) { continue }
            match decl.kind { DeclKind.FunDecl(fd) => { if !contains(self.skipped_fns, fd.name) { self.check_body(decl.id, fd, "") } }, _ => {} }
        }
        var i = 0
        while i < len(self.method_decls) {
            if !contains(self.skipped_fns, self.method_decls[i].name) { self.check_body(self.method_decl_ids[i], self.method_decls[i], self.method_decl_keys[i]) }
            i = i + 1
        }
        self.check_passed_on()
        if len(self.errs) > 0 { return Err(self.errs) }
        self.warnings = sort_by_place(self.warnings)
        return Ok(0)
    }

    fun run_phases(var self) -> Result<int32, CheckErr> {
        self.collect_globals()?
        self.resolve_signatures()?
        self.resolve_traits()?
        self.synthesize_derives()?
        self.resolve_impls()?
        self.validate_bounds()?
        self.fold_consts()?
        return Ok(0)
    }

    // The body of `fd` (declaration `id`; a method of the type with key
    // `key`, else ""), on its own: its error is collected.
    fun check_body(var self, id: int32, fd: FunData, key: str) {
        if self.full() { return }
        self.reset_state(id)
        self.cur_key = key
        match self.check_function(fd) {
            Ok(x) => {
                // an actor's async method: its state changed after an `await`
                // on the strength of what was read before it (D95, MYLA-146)
                if fd.is_async && self.actor_self != "" {
                    match fd.body {
                        Some(b) => {
                            var r = Reentrancy { epoch: 0, checked: [:], locals: [:], awaits: [], out: [] }
                            r.block(b)
                            for w in r.out { push(self.warnings, CheckErr { line: w.line, col: w.col, sp: w.sp, msg: w.msg, decl: id, notes: w.notes }) }
                        },
                        None => {},
                    }
                }
            },
            Err(e) => { self.note(e) },
        }
    }

    // Before checking declaration `id` on its own: what an earlier check that
    // failed may have left behind (types.py: _on_its_own).
    fun reset_state(var self, id: int32) {
        self.cur_decl = id
        self.frames = []
        self.loop_depth = 0
        self.lambda_depth = 0
        self.lambda_infer_active = false
        self.lambda_infer = []
        self.stmt_match = false
        self.cur_ret = None
        self.has_cur_ret = false
        self.ret_at = None
        self.type_params = []
        self.bounds_cur = []
        self.in_async = false
        self.actor_self = ""
        self.cur_key = ""
        self.lams = []
        if len(self.awaited) > 0 { self.awaited = [:] }
        self.task_init = false
        self.in_guard = false
    }

    // Collect `e`, an error in the declaration being checked.
    fun note(var self, e: CheckErr) {
        if is_poisoned(e) { return }   // depends on the error type: no error (MYLA-110)
        push(self.errs, CheckErr { line: e.line, col: e.col, sp: e.sp, msg: e.msg, decl: self.cur_decl, notes: e.notes })
    }

    // Whether MAX_ERRORS errors were collected: the check ends.
    fun full(self) -> bool {
        return len(self.errs) >= MAX_ERRORS
    }

    // Collect `e`, the error of a declaration's part, and go on (types.py:
    // _record): Err(stopped()) at MAX_ERRORS. A part that depends on the
    // error type has nothing to collect.
    fun record(var self, e: CheckErr) -> Result<int32, CheckErr> {
        if is_poisoned(e) { return Ok(0) }
        if is_stopped(e) { return Err(e) }
        self.note(e)
        if self.full() { return Err(stopped()) }
        return Ok(0)
    }

    // `te` resolved, else the error type, its error collected (types.py: _part).
    fun resolve_part(var self, te: TypeExpr) -> Result<Type, CheckErr> {
        return match self.resolve0(te) {
            Ok(t) => Ok(t),
            Err(e) => {
                self.record(e)?
                Ok(Type.TError)
            },
        }
    }

    fun param_part(var self, p: Param) -> Result<Type, CheckErr> {
        return match self.param_type(p) {
            Ok(t) => Ok(t),
            Err(e) => {
                self.record(e)?
                Ok(Type.TError)
            },
        }
    }

    // `r`'s error, if any, collected.
    fun record_result(var self, r: Result<int32, CheckErr>) -> Result<int32, CheckErr> {
        match r {
            Ok(x) => {},
            Err(e) => { self.record(e)? },
        }
        return Ok(0)
    }
}

fun prelude_src() -> str {
    return "enum Option<T> { Some(T), None }\nenum Result<T, E> { Ok(T), Err(E) }\nfun get<K, V>(m: [K: V], k: K) -> Option<V> {\n    if contains(m, k) {\n        return Some(m[k])\n    }\n    return None\n}\n"
}

// The prelude's declarations, with node ids from `first_id`.
fun prelude(first_id: int32) -> Parsed {
    return match parse_source(prelude_src(), first_id) {
        Ok(p) => p,
        Err(d) => { panic("the prelude does not parse") },
    }
}

// Type-check a program; its warnings (D95), or its errors.
pub fun check_program(user: Program) -> Result<[CheckErr], [CheckErr]> {
    let pre = prelude(0)
    var decls: [Decl] = []
    for d in pre.program.decls { push(decls, d) }
    for d in user.decls { push(decls, d) }
    var c = new_checker(decls)
    let r = c.run_all()
    match r { Ok(x) => {}, Err(e) => { return Err(e) } }
    return Ok(c.warnings)
}

// Type-check a linked program (selfhost/loader.my: its declarations, whose node
// ids are below `next_id`), with the prelude parsed after it so every id stays
// unique, and return the populated checker (MYLA-30), or its errors (D80).
pub fun build_checker_decls(decls: [Decl], next_id: int32) -> Result<Checker, [CheckErr]> {
    let pre = prelude(next_id)
    var all: [Decl] = []
    for d in pre.program.decls { push(all, d) }
    for d in decls { push(all, d) }
    var c = new_checker(all)
    let r = c.run_all()
    match r { Ok(x) => {}, Err(e) => { return Err(e) } }
    return Ok(c)
}

fun is_printable(t: Type) -> bool {
    return is_int(t) || is_float(t) || is_char(t) || is_bool(t) || is_str(t)
}

fun count_format_holes(fmt: str, line: int32, col: int32) -> Result<int32, CheckErr> {
    let cs = chars(fmt)
    let n = len(cs)
    var holes = 0
    var i = 0
    while i < n {
        let c = cs[i]
        if c == '{' {
            if i + 1 < n && cs[i + 1] == '{' { i = i + 2
            continue }
            if i + 1 < n && cs[i + 1] == '}' { holes = holes + 1
            i = i + 2
            continue }
            return Err(terr(line, col, "format(): a single '{' must be a '{}' placeholder or an escaped '{{'"))
        }
        if c == '}' {
            if i + 1 < n && cs[i + 1] == '}' { i = i + 2
            continue }
            return Err(terr(line, col, "format(): a single '}' must close a '{}' placeholder or be an escaped '}}'"))
        }
        i = i + 1
    }
    return Ok(holes)
}

// =========================================================================
// Calls
// =========================================================================

impl Checker {
    fun infer_call(var self, e: Expr, callee: Expr, args: [Expr], expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        for a in args { match a.kind { ExprKind.Hole => { return Ok(Some(self.infer_partial(e, callee, args)?)) }, _ => {} } }
        // local binding shadows a global function: call as a value
        match callee.kind {
            ExprKind.Name(nm) => {
                let shadowed = match self.lookup(nm) { Some(b) => true, None => false }
                if shadowed { return self.infer_indirect_call(e, callee, args) }
            },
            _ => {},
        }
        match callee.kind {
            ExprKind.GetField(target, field) => {
                match self.enum_name_ref(target) {
                    Some(en) => { return Ok(Some(self.infer_variant_ctor(e, en, field, args, expected)?)) },
                    None => {},
                }
                return self.infer_method_call(e, callee, target, field, args, expected)
            },
            _ => {},
        }
        let name = match callee.kind { ExprKind.Name(nm) => nm, _ => "" }
        if name == "" { return self.infer_indirect_call(e, callee, args) }
        if contains(self.redefined, name) { return Err(poisoned()) }   // written against the left-out redefinition (MYLA-110)

        if name == "print" {
            if len(args) != 1 { return Err(terr_at(e.line, e.col, e.sp, "print() takes exactly one argument")) }
            let at = self.expect_value(args[0], None)?
            if !is_printable(at) { return Err(terr_at(e.line, e.col, e.sp, format("print() cannot print a value of type '{}'", type_name(at)))) }
            return Ok(None)
        }
        if name == "__write" {
            if len(args) != 2 { return Err(terr_at(e.line, e.col, e.sp, "__write() takes (fd: int32, s: str)")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let s_t = self.expect_value(args[1], Some(Type.TStr))?
            if !is_str(s_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write() expects a string, found '{}'", type_name(s_t)))) }
            return Ok(None)
        }
        if name == "__exit" {
            if len(args) != 1 { return Err(terr_at(e.line, e.col, e.sp, "__exit() takes exactly one argument")) }
            let c_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(c_t) { return Err(terr_at(e.line, e.col, e.sp, format("__exit() code must be an integer, found '{}'", type_name(c_t)))) }
            return Ok(None)
        }
        if name == "__args" {
            if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, "__args() takes no arguments")) }
            return Ok(Some(Type.TList(Type.TStr)))
        }
        if name == "__read_file" {
            if len(args) != 1 { return Err(terr_at(e.line, e.col, e.sp, "__read_file() takes exactly one argument")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read_file() expects a string path, found '{}'", type_name(p_t)))) }
            return Ok(Some(Type.TStr))
        }
        if name == "__read" {
            if len(args) != 2 { return Err(terr_at(e.line, e.col, e.sp, "__read() takes (fd: int32, n: int32)")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let n_t = self.expect_value(args[1], Some(t_int()))?
            if !is_int(n_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read() n must be an integer, found '{}'", type_name(n_t)))) }
            return Ok(Some(Type.TStr))
        }
        if name == "__poll" {
            if len(args) != 2 { return Err(terr_at(e.line, e.col, e.sp, "__poll() takes (fd: int32, timeout_ms: int32)")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__poll() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let t_t = self.expect_value(args[1], Some(t_int()))?
            if !is_int(t_t) { return Err(terr_at(e.line, e.col, e.sp, format("__poll() timeout must be an integer, found '{}'", type_name(t_t)))) }
            return Ok(Some(t_int()))
        }
        if name == "__io_errno" {
            if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, "__io_errno() takes no arguments")) }
            return Ok(Some(t_int()))
        }
        if name == "__getcwd" {
            if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, "__getcwd() takes no arguments")) }
            return Ok(Some(Type.TStr))
        }
        if name == "__write_file" {
            if len(args) != 2 { return Err(terr_at(e.line, e.col, e.sp, "__write_file() takes (path: str, contents: str)")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write_file() path must be a string, found '{}'", type_name(p_t)))) }
            let c_t = self.expect_value(args[1], Some(Type.TStr))?
            if !is_str(c_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write_file() contents must be a string, found '{}'", type_name(c_t)))) }
            return Ok(None)
        }
        if name == "__list_dir" || name == "__stat" {
            if len(args) != 1 { return Err(terr(e.line, e.col, format("{}() takes (path: str)", name))) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr(e.line, e.col, format("{}() path must be a string, found '{}'", name, type_name(p_t)))) }
            if name == "__list_dir" { return Ok(Some(Type.TStr)) }
            return Ok(Some(t_int()))
        }
        if name == "__mkdir" {
            if len(args) != 2 { return Err(terr(e.line, e.col, "__mkdir() takes (path: str, mode: int32)")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr(e.line, e.col, format("__mkdir() path must be a string, found '{}'", type_name(p_t)))) }
            let m_t = self.expect_value(args[1], Some(t_int()))?
            if !is_int(m_t) { return Err(terr(e.line, e.col, format("__mkdir() mode must be an integer, found '{}'", type_name(m_t)))) }
            return Ok(None)
        }
        if name == "__unlink" || name == "__rmdir" || name == "__rename" {
            // unlink(2), rmdir(2), rename(2) (MYLA-96): paths, no result
            var want = "path: str"
            var nargs = 1
            if name == "__rename" {
                want = "from: str, to: str"
                nargs = 2
            }
            if len(args) != nargs { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes ({})", name, want))) }
            for a in args {
                let a_t = self.expect_value(a, Some(Type.TStr))?
                if !is_str(a_t) { return Err(terr_at(a.line, a.col, a.sp, format("{}() paths must be strings, found '{}'", name, type_name(a_t)))) }
            }
            return Ok(None)
        }
        if name == "__run" {
            if len(args) != 2 { return Err(terr_at(e.line, e.col, e.sp, "__run() takes (program: str, argv: [str])")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("__run() program must be a string, found '{}'", type_name(p_t)))) }
            let a_t = self.expect_value(args[1], Some(Type.TList(Type.TStr)))?
            let a_ok = match a_t { Type.TList(el) => is_str(el), _ => false }
            if !a_ok { return Err(terr_at(e.line, e.col, e.sp, format("__run() argv must be a [str], found '{}'", type_name(a_t)))) }
            return Ok(Some(Type.TList(t_byte())))
        }
        if name == "__run_stderr" {
            if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, "__run_stderr() takes no arguments")) }
            return Ok(Some(Type.TList(t_byte())))
        }
        if name == "__task_cancelled" {
            if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, "__task_cancelled() takes no arguments")) }
            return Ok(Some(Type.TBool))
        }
        if name == "__run_exit_code" || name == "__run_signal" || name == "__run_errno" {
            if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes no arguments", name))) }
            return Ok(Some(t_int()))
        }
        if name == "len" {
            if len(args) != 1 { return Err(terr_at(e.line, e.col, e.sp, "len() takes exactly one argument")) }
            let at = self.expect_value(args[0], None)?
            let ok = match at { Type.TList(x) => true, Type.TMap(k, v) => true, Type.TStr => true, Type.TSB => true, _ => false }
            if !ok { return Err(terr_at(e.line, e.col, e.sp, format("len() requires a list, map, string, or StringBuilder, found '{}'", type_name(at)))) }
            return Ok(Some(t_int()))
        }
        if name == "chars" {
            if len(args) != 1 { return Err(terr_at(e.line, e.col, e.sp, "chars() takes exactly one argument")) }
            let at = self.expect_value(args[0], None)?
            if !is_str(at) { return Err(terr_at(e.line, e.col, e.sp, format("chars() requires a string, found '{}'", type_name(at)))) }
            return Ok(Some(Type.TList(Type.TChar)))
        }
        if name == "std$task$cancel" { return self.infer_task_cancel(e, args) }
        if name == "push" || name == "pop" { return self.infer_list_mutation(e, name, args) }
        if name == "contains" || name == "remove" || name == "keys" { return self.infer_map_builtin(e, name, args) }
        if name == "format" { return Ok(Some(self.infer_format(e, args)?)) }
        if name == "StringBuilder" || name == "append" || name == "append_byte" || name == "build" { return self.infer_string_builder(e, name, args) }
        if is_builtin_func(name) { return self.infer_intrinsic(e, name, args) }

        let fi = self.func_idx(name)
        if fi < 0 {
            match prelude_variant_enum(name) {
                Some(en) => {
                    let shadowed = match self.lookup(name) { Some(b) => true, None => false }
                    if !shadowed { return Ok(Some(self.infer_variant_ctor(e, en, name, args, expected)?)) }
                },
                None => {},
            }
            return Err(with_notes(terr_at(e.line, e.col, e.sp, format("unknown function '{}'", name)), did_you_mean(name, self.callable_names())))
        }
        let sig = self.functions[fi]
        if len(sig.type_params) > 0 {
            let gr = self.infer_generic_call(e, name, sig, args)?
            self.mark_call(e, "function", name, sig_mutates(sig), "", sig.decl.is_async)
            return Ok(gr)
        }
        if len(args) != len(sig.params) { return Err(terr_at(e.line, e.col, e.sp, format("function '{}' expects {} argument(s), got {}", name, len(sig.params), len(args)))) }
        var i = 0
        while i < len(args) {
            if !has_error(sig.params[i]) {   // else the parameter's type failed (MYLA-110)
                let at = self.expect_value(args[i], Some(sig.params[i]))?
                if !type_eq(at, sig.params[i]) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", name, type_name(sig.params[i]), type_name(at)))) }
            }
            i = i + 1
        }
        self.mark_call(e, "function", name, sig_mutates(sig), "", sig.decl.is_async)
        return Ok(sig.ret)
    }

    fun infer_list_mutation(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        var nargs = 1
        if name == "push" { nargs = 2 }
        if len(args) != nargs { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes {} argument(s)", name, nargs))) }
        let lv = self.check_lvalue(args[0])?
        let elem = match lv.ty { Type.TList(el) => el, _ => { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() requires a list, found '{}'", name, type_name(lv.ty)))) } }
        if !lv.mutable { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() needs a mutable list (declare it with 'var')", name))) }
        if name == "push" {
            self.expect_type(args[1], elem, "push value")?
            return Ok(None)
        }
        return Ok(Some(elem))
    }

    fun infer_map_builtin(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        var nargs = 2
        if name == "keys" { nargs = 1 }
        if len(args) != nargs { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes {} argument(s)", name, nargs))) }
        var map_t = Type.TStr
        var mutable = true
        if name == "remove" {
            let lv = self.check_lvalue(args[0])?
            map_t = lv.ty
            mutable = lv.mutable
        } else {
            map_t = self.expect_value(args[0], None)?
        }
        let kv: Option<Type> = match map_t { Type.TMap(k, v) => Some(Type.TTuple([k, v])), _ => None }
        match kv { Some(x) => {}, None => { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() requires a map, found '{}'", name, type_name(map_t)))) } }
        let mk = match map_t { Type.TMap(k, v) => k, _ => Type.TStr }
        let mv = match map_t { Type.TMap(k, v) => v, _ => Type.TStr }
        if name == "keys" { return Ok(Some(Type.TList(mk))) }
        self.expect_type(args[1], mk, "map key")?
        if name == "contains" { return Ok(Some(Type.TBool)) }
        if !mutable { return Err(terr_at(args[0].line, args[0].col, args[0].sp, "remove() needs a mutable map (declare it with 'var')")) }
        return Ok(None)
    }

    fun infer_format(var self, e: Expr, args: [Expr]) -> Result<Type, CheckErr> {
        if len(args) == 0 { return Err(terr_at(e.line, e.col, e.sp, "format() needs a string literal format and its arguments")) }
        let fmt = args[0]
        let fval = match fmt.kind { ExprKind.StrLit(s) => s, _ => { return Err(terr_at(fmt.line, fmt.col, fmt.sp, "format()'s first argument must be a string literal")) } }
        let holes = count_format_holes(fval, fmt.line, fmt.col)?
        let rest = len(args) - 1
        if holes != rest { return Err(terr_at(e.line, e.col, e.sp, format("format() has {} placeholder(s) but {} argument(s)", holes, rest))) }
        var i = 1
        while i < len(args) {
            let at = self.expect_value(args[i], None)?
            if !is_printable(at) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("format() cannot render a value of type '{}'", type_name(at)))) }
            i = i + 1
        }
        return Ok(Type.TStr)
    }

    fun infer_string_builder(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if name == "StringBuilder" {
            if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, "StringBuilder() takes no arguments")) }
            return Ok(Some(Type.TSB))
        }
        if name == "build" {
            if len(args) != 1 { return Err(terr_at(e.line, e.col, e.sp, "build() takes exactly one argument")) }
            let at = self.expect_value(args[0], None)?
            if !is_sb(at) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("build() requires a StringBuilder, found '{}'", type_name(at)))) }
            return Ok(Some(Type.TStr))
        }
        // append(sb, s, start, end) appends the bytes s[start..end] (MYLA-85)
        if name == "append" && len(args) != 2 && len(args) != 4 { return Err(terr_at(e.line, e.col, e.sp, "append() takes 2 or 4 argument(s)")) }
        if name == "append_byte" && len(args) != 2 { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes 2 argument(s)", name))) }
        let lv = self.check_lvalue(args[0])?
        if !is_sb(lv.ty) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() requires a StringBuilder, found '{}'", name, type_name(lv.ty)))) }
        if !lv.mutable { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() needs a mutable StringBuilder (declare it with 'var')", name))) }
        if name == "append" {
            self.expect_type(args[1], Type.TStr, "append value")?
            if len(args) == 4 {
                self.expect_type(args[2], t_int(), "append start")?
                self.expect_type(args[3], t_int(), "append end")?
            }
        } else {
            self.expect_type(args[1], t_byte(), "append_byte value")?
        }
        return Ok(None)
    }

    fun infer_intrinsic(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if name == "assert" {
            if !(len(args) == 1 || len(args) == 2) { return Err(terr_at(e.line, e.col, e.sp, "assert() takes a condition and an optional message")) }
            self.expect_type(args[0], Type.TBool, "assert condition")?
            if len(args) == 2 { self.expect_type(args[1], Type.TStr, "assert message")? }
            return Ok(None)
        }
        if name == "panic" {
            if len(args) != 1 { return Err(terr_at(e.line, e.col, e.sp, "panic() takes exactly one message")) }
            self.expect_type(args[0], Type.TStr, "panic message")?
            return Ok(None)
        }
        // unreachable
        if len(args) > 0 { return Err(terr_at(e.line, e.col, e.sp, "unreachable() takes no arguments")) }
        return Ok(None)
    }

    fun infer_indirect_call(var self, e: Expr, callee: Expr, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        let ft = self.expect_value(callee, None)?
        let ps = match strip_async(ft) { Type.TFunc(p, r) => p, _ => { return Err(terr_at(e.line, e.col, e.sp, format("cannot call a value of type '{}'", type_name(ft)))) } }
        let rr: Option<Type> = func_ret_of(ft)
        if len(args) != len(ps) { return Err(terr_at(e.line, e.col, e.sp, format("this function value expects {} argument(s), got {}", len(ps), len(args)))) }
        var i = 0
        while i < len(args) {
            let at = self.expect_value(args[i], Some(ps[i]))?
            if !type_eq(at, ps[i]) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch: expected '{}', found '{}'", type_name(ps[i]), type_name(at)))) }
            i = i + 1
        }
        self.mark_call(e, "value", "", false, "", is_async_func(ft))
        return Ok(rr)
    }

    fun infer_variant_ctor(var self, e: Expr, enum_name: str, variant: str, args: [Expr], expected: Option<Type>) -> Result<Type, CheckErr> {
        if !self.enum_has_variant(enum_name, variant) { return Err(terr_at(e.line, e.col, e.sp, format("enum '{}' has no variant '{}'", enum_name, variant))) }
        let payload = match self.enum_variant_payload(enum_name, [], variant) { Some(p) => p, None => empty_types() }
        if len(args) != len(payload) { return Err(terr_at(e.line, e.col, e.sp, format("variant '{}.{}' expects {} argument(s), got {}", enum_name, variant, len(payload), len(args)))) }
        let ei = self.enum_idx(enum_name)
        let params = self.enums[ei].type_params
        if list_has_error(payload) && len(params) > 0 { return Err(poisoned()) }
        if len(params) == 0 {
            var i = 0
            while i < len(args) {
                if !has_error(payload[i]) {   // else the payload's type failed (MYLA-110)
                    let at = self.expect_value(args[i], Some(payload[i]))?
                    if !type_eq(at, payload[i]) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("variant '{}.{}': expected '{}', found '{}'", enum_name, variant, type_name(payload[i]), type_name(at)))) }
                }
                i = i + 1
            }
            return Ok(Type.TEnum(enum_name, []))
        }
        var exp_args: Option<[Type]> = enum_args_hint(expected, enum_name)
        let args_t = self.infer_type_args(params, payload, args, exp_args, e, format("variant '{}.{}'", enum_name, variant))?
        return Ok(Type.TEnum(enum_name, args_t))
    }

    fun infer_generic_call(var self, e: Expr, name: str, sig: FuncSig, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if sig_has_error(sig.params, sig.ret) { return Err(poisoned()) }   // its type arguments can't be inferred (MYLA-110)
        if len(args) != len(sig.params) { return Err(terr_at(e.line, e.col, e.sp, format("function '{}' expects {} argument(s), got {}", name, len(sig.params), len(args)))) }
        var subst: [Subst] = []
        var arg_types: [Type] = []
        var i = 0
        while i < len(args) {
            let want = subst_type(sig.params[i], subst)
            var hint: Option<Type> = Some(want)
            if contains_type_param(want) { hint = None }
            let at = self.expect_value(args[i], hint)?
            push(arg_types, at)
            let r = unify_param(sig.params[i], at, subst)
            subst = r.subst
            i = i + 1
        }
        var missing: [str] = []
        for tp in sig.type_params { if !subst_has(subst, tp) { push(missing, tp) } }
        if len(missing) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {} for '{}' from the arguments; add a type annotation to guide inference", join_strs(missing, ", "), name))) }
        var j = 0
        while j < len(args) {
            let want = subst_type(sig.params[j], subst)
            if !type_eq(arg_types[j], want) {
                if is_int(want) && is_flexible_int_lit(args[j]) { self.infer_int_lit(args[j], Some(want))? }
                else { return Err(terr_at(args[j].line, args[j].col, args[j].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", name, type_name(want), type_name(arg_types[j])))) }
            }
            j = j + 1
        }
        self.check_call_bounds(sig, subst, e)?
        return Ok(opt_subst_type(sig.ret, subst))
    }

    fun check_call_bounds(self, sig: FuncSig, subst: [Subst], e: Expr) -> Result<int32, CheckErr> {
        for b in sig.bounds {
            match subst_get(subst, b.tp) {
                Some(concrete) => {
                    for tr in b.traits {
                        var ok = false
                        match concrete { Type.TParam(pn) => { ok = self.bound_has(pn, tr) }, _ => { ok = self.type_implements(concrete, tr)? } }
                        if !ok { return Err(terr_at(e.line, e.col, e.sp, format("type '{}' does not satisfy the bound '{}: {}' required by '{}'", type_name(concrete), b.tp, tr, sig.decl.name))) }
                    }
                },
                None => {},
            }
        }
        return Ok(0)
    }

    // `callee` is the `target.field` node itself (a function-valued field is
    // typed through it, MYLA-33).
    fun infer_method_call(var self, e: Expr, callee: Expr, target: Expr, field: str, args: [Expr], expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        let recv_type = self.expect_value(target, None)?
        let key_opt = self.type_key(recv_type)
        var sig_opt: Option<FuncSig> = None
        match key_opt { Some(k) => { sig_opt = self.method_sig(k, field) }, None => {} }
        match sig_opt {
            None => {
                // fallback: a struct field holding a function value
                match struct_view(recv_type) {
                    Type.TStruct(nm, sargs) => {
                        let fields = self.struct_field_types(nm, sargs)
                        let fopt = field_type_get(fields, field)
                        let is_func = match fopt {
                            Some(ft) => is_tfunc_type(ft),
                            None => false,
                        }
                        if is_func { return self.infer_indirect_call(e, callee, args) }
                        if match fopt { Some(ft) => has_error(ft), None => false } { return Err(poisoned()) }   // the field's type failed (MYLA-110)
                    },
                    _ => {},
                }
                if contains(self.lost_methods, field) { return Err(poisoned()) }   // maybe a left-out impl's (MYLA-110)
                return Err(with_notes(terr_at(e.line, e.col, e.sp, format("type '{}' has no method '{}'", type_name(recv_type), field)), did_you_mean(field, self.method_names(key_opt))))
            },
            Some(sig) => {
                let recv = match sig.decl.receiver { Some(r) => r, None => "self" }
                let mkey = match key_opt { Some(k) => k, None => "" }
                // an actor's handle needn't be mutable: its methods change the actor (D89)
                if recv == "var self" && !self.is_actor(mkey) {
                    if !is_lvalue_shape(target) { return Err(terr_at(e.line, e.col, e.sp, format("method '{}' mutates its receiver ('var self'); it needs a mutable variable (or one of its fields/elements), not a temporary", field))) }
                    let lv = self.check_lvalue(target)?
                    if !lv.mutable { return Err(with_notes(terr_at(e.line, e.col, e.sp, format("cannot call the mutating method '{}' on an immutable receiver (declare it with 'var')", field)), self.declared_at(target))) }
                }
                let nargs = len(sig.params) - 1
                if len(args) != nargs { return Err(terr_at(e.line, e.col, e.sp, format("method '{}' expects {} argument(s), got {}", field, nargs, len(args)))) }
                if len(sig.type_params) > 0 {
                    let gr = self.infer_generic_method(e, sig, field, recv_type, args)?
                    self.mark_call(e, "method", sig.name, recv == "var self", mkey, sig.decl.is_async)
                    return Ok(gr)
                }
                var i = 0
                while i < len(args) {
                    let pt = sig.params[i + 1]
                    if !has_error(pt) {   // else the parameter's type failed (MYLA-110)
                        let at = self.expect_value(args[i], Some(pt))?
                        if !type_eq(at, pt) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", field, type_name(pt), type_name(at)))) }
                    }
                    i = i + 1
                }
                self.mark_call(e, "method", sig.name, recv == "var self", mkey, sig.decl.is_async)
                return Ok(sig.ret)
            },
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' has no method '{}'", type_name(recv_type), field)))
    }

    fun infer_generic_method(var self, e: Expr, sig: FuncSig, method: str, recv_type: Type, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if sig_has_error(sig.params, sig.ret) { return Err(poisoned()) }   // its type arguments can't be inferred (MYLA-110)
        var subst: [Subst] = []
        let r0 = unify_param(sig.params[0], recv_type, subst)
        subst = r0.subst
        var arg_types: [Type] = []
        var i = 0
        while i < len(args) {
            let pt = sig.params[i + 1]
            let want = subst_type(pt, subst)
            var hint: Option<Type> = Some(want)
            if contains_type_param(want) { hint = None }
            let at = self.expect_value(args[i], hint)?
            push(arg_types, at)
            let r = unify_param(pt, at, subst)
            subst = r.subst
            i = i + 1
        }
        var missing: [str] = []
        for tp in sig.type_params { if !subst_has(subst, tp) { push(missing, tp) } }
        if len(missing) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {} for method '{}'; add a type annotation to guide inference", join_strs(missing, ", "), method))) }
        var j = 0
        while j < len(args) {
            let pt = sig.params[j + 1]
            let want = subst_type(pt, subst)
            if !type_eq(arg_types[j], want) {
                if is_int(want) && is_flexible_int_lit(args[j]) { self.infer_int_lit(args[j], Some(want))? }
                else { return Err(terr_at(args[j].line, args[j].col, args[j].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", method, type_name(want), type_name(arg_types[j])))) }
            }
            j = j + 1
        }
        self.check_call_bounds(sig, subst, e)?
        return Ok(opt_subst_type(sig.ret, subst))
    }

    fun infer_try(var self, e: Expr, operand: Expr) -> Result<Type, CheckErr> {
        let ot = self.expect_value(operand, None)?
        if self.task_init { return Err(terr_at(e.line, e.col, e.sp, "'?' can't stand in an 'async let': its child task has no function to return from")) }
        if opt_has_error(self.cur_ret) { return Err(poisoned()) }   // the return type failed (MYLA-110)
        // `?` returns from the innermost function or lambda (MYLA-72)
        let where = if_str(self.lambda_depth > 0, "lambda", "function")
        if !self.has_cur_ret && self.lambda_depth > 0 {
            return Err(terr_at(e.line, e.col, e.sp, "'?' in a lambda needs the lambda's result type: pass the lambda where a function type is expected, or annotate the variable (e.g. 'let f: (int) -> Option<int> = …')"))
        }
        let ret_is = match self.cur_ret {
            Some(r) => match r {
                Type.TEnum(rn, rargs) => if_str(rn == "Result" && len(rargs) == 2, "Result", if_str(rn == "Option" && len(rargs) == 1, "Option", "")),
                _ => "",
            },
            None => "",
        }
        match ot {
            Type.TEnum(nm, oargs) => {
                if nm == "Result" && len(oargs) == 2 {
                    let err_t = oargs[1]
                    if ret_is != "Result" { return Err(terr_at(e.line, e.col, e.sp, format("'?' on a Result requires the enclosing {} to return a Result", where))) }
                    let ret_err = match self.cur_ret { Some(r) => match r { Type.TEnum(rn, rargs) => rargs[1], _ => err_t }, None => err_t }
                    if !type_eq(ret_err, err_t) {
                        return Err(terr_at(e.line, e.col, e.sp, format("'?' propagates an error of type '{}', but the {} returns 'Result<_, {}>' (there is no error conversion in v0.2)", type_name(err_t), where, type_name(ret_err))))
                    }
                    return Ok(oargs[0])
                }
                if nm == "Option" && len(oargs) == 1 {
                    if ret_is != "Option" { return Err(terr_at(e.line, e.col, e.sp, format("'?' on an Option requires the enclosing {} to return an Option", where))) }
                    return Ok(oargs[0])
                }
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("'?' can only be applied to an Option or Result, not '{}'", type_name(ot))))
    }

    fun infer_lambda(var self, e: Expr, params: [Param], ret_ann: Option<TypeExpr>, body: ExprOrBlock, asy: bool, expected: Option<Type>) -> Result<Type, CheckErr> {
        var have_exp = false
        var exp_params: [Type] = []
        var exp_ret: Option<Type> = None
        match func_hint(expected, len(params)) {
            Some(ft) => {
                have_exp = true
                exp_params = func_params_of(ft)
                exp_ret = func_ret_of(ft)
            },
            None => {},
        }
        var ptypes: [Type] = []
        var i = 0
        while i < len(params) {
            match params[i].ty {
                Some(te) => push(ptypes, self.resolve0(te)?),
                None => { if have_exp { push(ptypes, exp_params[i]) } else { return Err(terr_at(params[i].line, params[i].col, params[i].sp, format("cannot infer the type of lambda parameter '{}'; annotate it (e.g. '{}: int')", params[i].name, params[i].name))) } },
            }
            i = i + 1
        }
        self.push_scope()
        var k = 0
        while k < len(params) {
            if !self.define_at(params[k].name, ptypes[k], false, params[k].line, params[k].col, params[k].sp) { self.pop_scope()
            return Err(terr_at(params[k].line, params[k].col, params[k].sp, format("duplicate lambda parameter '{}'", params[k].name))) }
            k = k + 1
        }
        var want_ret: Option<Type> = None
        if have_exp { want_ret = exp_ret }
        // save context
        let saved_ret = self.cur_ret
        let saved_has = self.has_cur_ret
        let saved_active = self.lambda_infer_active
        let saved_infer = self.lambda_infer
        let saved_async = self.in_async
        let saved_task_init = self.task_init
        let saved_guard = self.in_guard
        self.task_init = false
        self.in_guard = false
        self.lambda_depth = self.lambda_depth + 1
        push(self.lams, LamAt { base: len(self.frames) - 1, line: e.line, col: e.col, sp: e.sp })
        self.in_async = asy
        if asy { self.met_concurrency(e.line, e.col, e.sp, e.id) }
        var ret_t: Option<Type> = None
        match body {
            ExprOrBlock.EB_Block(bl) => {
                match want_ret {
                    Some(wr) => {
                        self.cur_ret = Some(wr)
                        self.has_cur_ret = true
                        self.check_block(bl)?
                        if !block_returns(bl) { self.restore_lambda(saved_ret, saved_has, saved_active, saved_infer, saved_async, saved_task_init, saved_guard)
            self.pop_scope()
            return Err(terr_at(e.line, e.col, e.sp, format("lambda may finish without returning a '{}'", type_name(wr)))) }
                        ret_t = Some(wr)
                    },
                    None => {
                        self.lambda_infer_active = true
                        self.lambda_infer = []
                        self.cur_ret = None
                        self.has_cur_ret = false
                        self.check_block(bl)?
                        let collected = self.lambda_infer
                        if len(collected) == 0 { ret_t = None }
                        else {
                            ret_t = Some(collected[0].ty)
                            var m = 1
                            while m < len(collected) {
                                if !type_eq(collected[m].ty, collected[0].ty) {
                                    self.restore_lambda(saved_ret, saved_has, saved_active, saved_infer, saved_async, saved_task_init, saved_guard)
                                    self.pop_scope()
                                    let ln = match collected[m].node { Some(nd) => nd.line, None => e.line }
                                    let cl = match collected[m].node { Some(nd) => nd.col, None => e.col }
                                    let sp = match collected[m].node { Some(nd) => nd.sp, None => e.sp }
                                    return Err(terr_at(ln, cl, sp, format("inconsistent lambda return types: '{}' vs '{}'", type_name(collected[0].ty), type_name(collected[m].ty))))
                                }
                                m = m + 1
                            }
                        }
                    },
                }
            },
            ExprOrBlock.EB_Expr(ex) => {
                // a `?` in the body returns from the lambda (MYLA-72)
                self.cur_ret = want_ret
                self.has_cur_ret = match want_ret { Some(w) => true, None => false }
                ret_t = self.infer(ex, want_ret)?
            },
        }
        self.restore_lambda(saved_ret, saved_has, saved_active, saved_infer, saved_async, saved_task_init, saved_guard)
        self.pop_scope()
        return Ok(func_type(ptypes, ret_t, asy))
    }

    fun restore_lambda(var self, r: Option<Type>, h: bool, a: bool, inf: [MatchVal], asy: bool, ti: bool, ig: bool) {
        self.lambda_depth = self.lambda_depth - 1
        pop(self.lams)
        self.in_async = asy
        self.task_init = ti
        self.in_guard = ig
        self.cur_ret = r
        self.has_cur_ret = h
        self.lambda_infer_active = a
        self.lambda_infer = inf
    }

    fun infer_partial(var self, e: Expr, callee: Expr, args: [Expr]) -> Result<Type, CheckErr> {
        let pt = self.partial_target(e, callee)?
        if sig_has_error(pt.params, pt.ret) { return Err(poisoned()) }
        let param_types = pt.params
        if len(args) != len(param_types) {
            return Err(terr_at(e.line, e.col, e.sp, format("partial application must list every argument position ({} expected, found {}); write '_' for each one to leave open (no implicit currying)", len(param_types), len(args))))
        }
        var hole_types: [Type] = []
        var i = 0
        while i < len(args) {
            match args[i].kind {
                ExprKind.Hole => push(hole_types, param_types[i]),
                _ => {
                    let at = self.expect_value(args[i], Some(param_types[i]))?
                    if !type_eq(at, param_types[i]) {
                        // as the call in Python's synthesized lambda reports it
                        var call_to = ""
                        if pt.name != "" { call_to = format(" in call to '{}'", pt.name) }
                        return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch{}: expected '{}', found '{}'", call_to, type_name(param_types[i]), type_name(at))))
                    }
                },
            }
            i = i + 1
        }
        return Ok(Type.TFunc(hole_types, pt.ret))
    }

    fun partial_target(var self, e: Expr, callee: Expr) -> Result<PartialTgt, CheckErr> {
        match callee.kind {
            ExprKind.Name(nm) => { return self.partial_name(e, nm) },
            ExprKind.GetField(target, field) => { return self.partial_field(e, callee, target, field) },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, "'_' partial application requires a function, method, or function value"))
    }

    fun partial_name(var self, e: Expr, nm: str) -> Result<PartialTgt, CheckErr> {
        match self.lookup(nm) {
            Some(b) => { return func_to_partial_res(b.ty, e) },
            None => {},
        }
        let fi = self.func_idx(nm)
        if fi < 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply '{}' with '_' (only functions, methods, and function values are supported)", nm))) }
        let sig = self.functions[fi]
        if len(sig.type_params) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply the generic function '{}'", nm))) }
        if sig.decl.is_async { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be partially applied")) }
        return Ok(PartialTgt { params: sig.params, ret: sig.ret, name: nm })
    }

    fun partial_field(var self, e: Expr, callee: Expr, target: Expr, field: str) -> Result<PartialTgt, CheckErr> {
        let recv = self.expect_value(target, None)?
        match self.method_partial(recv, field, e)? {
            Some(pt) => { return Ok(pt) },
            None => {},
        }
        match struct_view(recv) {
            Type.TStruct(nm, sargs) => {
                let fields = self.struct_field_types(nm, sargs)
                if match field_type_get(fields, field) { Some(x) => true, None => false } { self.check_isolation(nm, target, field, callee)? }
                let ft = match field_type_get(fields, field) { Some(x) => x, None => Type.TBool }
                let is_fn = is_tfunc_type(ft)
                if is_fn { return func_to_partial_res(ft, e) }
                if has_error(ft) { return Err(poisoned()) }   // the field's type failed (MYLA-110)
            },
            _ => {},
        }
        if contains(self.lost_methods, field) { return Err(poisoned()) }   // maybe a left-out impl's (MYLA-110)
        return Err(with_notes(terr_at(e.line, e.col, e.sp, format("type '{}' has no method '{}'", type_name(recv), field)), did_you_mean(field, self.method_names(self.type_key(recv)))))
    }

    fun method_partial(self, recv: Type, field: str, e: Expr) -> Result<Option<PartialTgt>, CheckErr> {
        match self.type_key(recv) {
            Some(k) => {
                match self.method_sig(k, field) {
                    Some(sig) => {
                        if len(sig.type_params) > 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply the generic method '{}'", field))) }
                        if sig.decl.is_async || self.is_actor(k) { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be partially applied")) }
                        var rest: [Type] = []
                        var i = 1
                        while i < len(sig.params) {
                            push(rest, sig.params[i])
                            i = i + 1
                        }
                        return Ok(Some(PartialTgt { params: rest, ret: sig.ret, name: field }))
                    },
                    None => {},
                }
                return Ok(None)
            },
            None => {},
        }
        return Ok(None)
    }
}

fun func_to_partial_res(t: Type, e: Expr) -> Result<PartialTgt, CheckErr> {
    match t {
        Type.TFunc(p, r) => { return Ok(PartialTgt { params: p, ret: r, name: "" }) },
        Type.TAsync(f) => { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be partially applied")) },
        _ => {},
    }
    return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply a value of type '{}'", type_name(t))))
}

// The struct an actor's type is declared like, for its fields; any other type
// as it is.
fun struct_view(t: Type) -> Type {
    return match t { Type.TActor(n) => Type.TStruct(n, []), _ => t }
}

// Whether `t` is an async function type (D89).
fun is_async_func(t: Type) -> bool {
    return match t { Type.TAsync(f) => true, _ => false }
}

// The function type `t` is, without its asyncness.
fun strip_async(t: Type) -> Type {
    return match t { Type.TAsync(f) => f, _ => t }
}

// The function type with parameters `ps` and result `r`, async if `asy`.
fun func_type(ps: [Type], r: Option<Type>, asy: bool) -> Type {
    if asy { return Type.TAsync(Type.TFunc(ps, r)) }
    return Type.TFunc(ps, r)
}

// A partially applied callee: its parameter and return types, and the name a
// call to it reports ("" for a function value).
pub struct PartialTgt { params: [Type], ret: Option<Type>, name: str }



// The index `m` maps `name` to, or -1.
fun index_in(m: [str: int32], name: str) -> int32 {
    return match get(m, name) {
        Some(i) => i
        None => -1
    }
}

// -- reentrancy warnings (D95, MYLA-146; types.py: _Reentrancy) ------------

// What a local was read from: fields of `self`, and the epoch of the read.
struct Taint { fields: [str], epoch: int32 }

// What an expression reads: fields of `self`, the locals with a taint (in the
// order they appear), and its first `await`.
struct Reads { fields: [str], names: [str], awaits: [Expr] }

fun add_name(xs: [str], n: str) -> [str] {
    for x in xs { if x == n { return xs } }
    var out = xs
    push(out, n)
    return out
}

fun has_name(xs: [str], n: str) -> bool {
    for x in xs { if x == n { return true } }
    return false
}

// The field of `self` a place starts from (`stock` of `self.stock[0].n`), or "".
fun self_field(e: Expr) -> str {
    match e.kind {
        ExprKind.GetField(t, f) => {
            match t.kind {
                ExprKind.Name(n) => {
                    if n == "self" { return f }
                    return ""
                },
                _ => { return self_field(t) },
            }
        },
        ExprKind.Index(t, i) => { return self_field(t) },
        _ => {},
    }
    return ""
}

// `ws` in the order of their places (line, then column), stable.
fun sort_by_place(ws: [CheckErr]) -> [CheckErr] {
    var out: [CheckErr] = []
    for w in ws {
        var i = len(out)
        push(out, w)
        while i > 0 && (out[i - 1].line > w.line || (out[i - 1].line == w.line && out[i - 1].col > w.col)) {
            out[i] = out[i - 1]
            i = i - 1
        }
        out[i] = w
    }
    return out
}

impl Reads {
    fun expr(var self, e: Expr, locals: [str: Taint]) {
        match e.kind {
            ExprKind.Lambda(ps, rt, body, asy) => { return },
            ExprKind.GetField(t, f) => {
                match t.kind {
                    ExprKind.Name(n) => {
                        if n == "self" {
                            self.fields = add_name(self.fields, f)
                            return
                        }
                    },
                    _ => {},
                }
                self.expr(t, locals)
            },
            ExprKind.Name(n) => { if contains(locals, n) { self.names = add_name(self.names, n) } },
            ExprKind.Await(x) => {
                if len(self.awaits) == 0 { push(self.awaits, e) }
                self.expr(x, locals)
            },
            ExprKind.Unary(op, x) => { self.expr(x, locals) },
            ExprKind.Binary(op, l, r) => {
                self.expr(l, locals)
                self.expr(r, locals)
            },
            ExprKind.Call(c, args) => {
                self.expr(c, locals)
                for a in args { self.expr(a, locals) }
            },
            ExprKind.StructLit(n, fs) => { for fi in fs { self.expr(fi.value, locals) } },
            ExprKind.TupleLit(es) => { for x in es { self.expr(x, locals) } },
            ExprKind.ListLit(es) => { for x in es { self.expr(x, locals) } },
            ExprKind.MapLit(ents) => {
                for en in ents {
                    self.expr(en.key, locals)
                    self.expr(en.value, locals)
                }
            },
            ExprKind.TupleIndex(t, i) => { self.expr(t, locals) },
            ExprKind.Index(t, i) => {
                self.expr(t, locals)
                self.expr(i, locals)
            },
            ExprKind.MatchE(sc, arms) => {
                self.expr(sc, locals)
                for arm in arms {
                    match arm.guard { Some(g) => { self.expr(g, locals) }, None => {} }
                    match arm.body {
                        ExprOrBlock.EB_Expr(x) => { self.expr(x, locals) },
                        ExprOrBlock.EB_Block(b) => { self.block(b, locals) },
                    }
                }
            },
            ExprKind.Try(x) => { self.expr(x, locals) },
            ExprKind.Cast(x, ty) => { self.expr(x, locals) },
            _ => {},
        }
    }

    fun opt(var self, e: Option<Expr>, locals: [str: Taint]) {
        match e { Some(x) => { self.expr(x, locals) }, None => {} }
    }

    fun block(var self, b: Block, locals: [str: Taint]) {
        for s in b.stmts { self.stmt(s, locals) }
    }

    fun stmt(var self, s: Stmt, locals: [str: Taint]) {
        match s.kind {
            StmtKind.VarDecl(k, n, ty, init) => { self.expr(init, locals) },
            StmtKind.DestructDecl(k, b, ty, init) => { self.expr(init, locals) },
            StmtKind.Assign(t, v) => {
                self.expr(t, locals)
                self.expr(v, locals)
            },
            StmtKind.IfS(c, th, el) => {
                self.expr(c, locals)
                self.block(th, locals)
                match el {
                    Some(ElseTail.ElseBlock(b)) => { self.block(b, locals) },
                    Some(ElseTail.ElseIf(x)) => { self.stmt(x, locals) },
                    None => {},
                }
            },
            StmtKind.WhileS(c, b) => {
                self.expr(c, locals)
                self.block(b, locals)
            },
            StmtKind.ForS(v, st, en, body, it) => {
                self.opt(st, locals)
                self.opt(en, locals)
                self.block(body, locals)
                self.opt(it, locals)
            },
            StmtKind.ReturnS(v, t) => { self.opt(v, locals) },
            StmtKind.ExprStmt(x) => { self.expr(x, locals) },
            _ => {},
        }
    }
}

// The walk of an actor's async method (types.py: _Reentrancy): `epoch`
// counts the statements with an `await` so far, `checked` the epoch each
// field was last examined in by a condition, `locals` what each local was read
// from, `awaits` the `await` that started each epoch after the first.
struct Reentrancy { epoch: int32, checked: [str: int32], locals: [str: Taint], awaits: [Expr], out: [CheckErr] }

impl Reentrancy {
    fun scan(self, e: Expr) -> Reads {
        var r = Reads { fields: [], names: [], awaits: [] }
        r.expr(e, self.locals)
        return r
    }

    fun taint(self, r: Reads) -> [str] {
        var out = r.fields
        for n in r.names {
            match get(self.locals, n) {
                Some(t) => { for f in t.fields { out = add_name(out, f) } },
                None => {},
            }
        }
        return out
    }

    // `e` examined as a condition; its awaits.
    fun check(var self, e: Expr) -> [Expr] {
        let r = self.scan(e)
        for n in r.names {
            match get(self.locals, n) {
                Some(t) => {
                    for f in t.fields {
                        var prev = -1
                        match get(self.checked, f) { Some(p) => { prev = p }, None => {} }
                        if t.epoch > prev { self.checked[f] = t.epoch } else { self.checked[f] = prev }
                    }
                },
                None => {},
            }
        }
        for f in r.fields { self.checked[f] = self.epoch }
        return r.awaits
    }

    fun suspend(var self, awaits: [Expr]) {
        if len(awaits) > 0 {
            push(self.awaits, awaits[0])
            self.epoch = self.epoch + 1
        }
    }

    fun block(var self, b: Block) {
        for s in b.stmts { self.stmt(s) }
    }

    // A statement's value: a `match`'s scrutinee and guards are conditions and
    // its block arms statements; its awaits.
    fun value(var self, e: Expr) -> [Expr] {
        match e.kind {
            ExprKind.MatchE(sc, arms) => {
                var awaits = self.check(sc)
                for arm in arms {
                    match arm.guard {
                        Some(g) => { for a in self.check(g) { push(awaits, a) } },
                        None => {},
                    }
                    match arm.body {
                        ExprOrBlock.EB_Block(b) => { self.block(b) },
                        ExprOrBlock.EB_Expr(x) => { for a in self.scan(x).awaits { push(awaits, a) } },
                    }
                }
                return awaits
            },
            _ => {},
        }
        return self.scan(e).awaits
    }

    fun stmt(var self, s: Stmt) {
        match s.kind {
            StmtKind.VarDecl(k, name, ty, init) => {
                if k == "async" { return }
                let r = self.scan(init)
                let before = self.epoch
                let awaits = self.value(init)
                self.locals[name] = Taint { fields: self.taint(r), epoch: before }
                self.suspend(awaits)
            },
            StmtKind.Assign(target, v) => {
                let r = self.scan(v)
                let before = self.epoch
                let awaits = self.value(v)
                self.suspend(awaits)
                let root = self_field(target)
                if root != "" {
                    self.write(root, r.names, target)
                } else {
                    match target.kind {
                        ExprKind.Name(n) => { self.locals[n] = Taint { fields: self.taint(r), epoch: before } },
                        _ => {},
                    }
                }
            },
            StmtKind.IfS(c, th, el) => {
                let aw = self.check(c)
                self.suspend(aw)
                self.block(th)
                match el {
                    Some(ElseTail.ElseBlock(b)) => { self.block(b) },
                    Some(ElseTail.ElseIf(x)) => { self.stmt(x) },
                    None => {},
                }
            },
            StmtKind.WhileS(c, b) => {
                let aw = self.check(c)
                self.suspend(aw)
                self.block(b)
            },
            StmtKind.ForS(v, st, en, body, it) => {
                var awaits: [Expr] = []
                match st { Some(x) => { for a in self.scan(x).awaits { push(awaits, a) } }, None => {} }
                match en { Some(x) => { for a in self.scan(x).awaits { push(awaits, a) } }, None => {} }
                match it { Some(x) => { for a in self.scan(x).awaits { push(awaits, a) } }, None => {} }
                self.suspend(awaits)
                self.block(body)
            },
            StmtKind.ReturnS(v, t) => {
                match v {
                    Some(x) => {
                        let aw = self.value(x)
                        self.suspend(aw)
                    },
                    None => {},
                }
            },
            StmtKind.ExprStmt(e) => {
                match e.kind {
                    ExprKind.Call(c, args) => {
                        match c.kind {
                            ExprKind.Name(f) => {
                                if (f == "push" || f == "pop" || f == "remove" || f == "append") && len(args) > 0 {
                                    let root = self_field(args[0])
                                    var names: [str] = []
                                    var awaits: [Expr] = []
                                    var i = 1
                                    while i < len(args) {
                                        let r = self.scan(args[i])
                                        for n in r.names { names = add_name(names, n) }
                                        for a in r.awaits { push(awaits, a) }
                                        i = i + 1
                                    }
                                    self.suspend(awaits)
                                    if root != "" { self.write(root, names, e) }
                                    return
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
                let aw = self.value(e)
                self.suspend(aw)
            },
            StmtKind.DestructDecl(k, b, ty, init) => {
                let aw = self.scan(init).awaits
                self.suspend(aw)
            },
            _ => {},
        }
    }

    fun write(var self, f: str, names: [str], at: Expr) {
        // a change settles the field's check: what comes after depends on it
        match get(self.checked, f) {
            Some(c) => {
                remove(self.checked, f)
                if c < self.epoch {
                    self.warn(format("'self.{}' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile", f), at, self.awaits[c], "check it again after the 'await', or change it before")
                    return
                }
            },
            None => {},
        }
        for n in names {
            match get(self.locals, n) {
                Some(t) => {
                    if has_name(t.fields, f) && t.epoch < self.epoch {
                        self.warn(format("'self.{}' is set from a value read before an 'await': another call to this actor may have changed it meanwhile", f), at, self.awaits[t.epoch], "read it again after the 'await'")
                        return
                    }
                },
                None => {},
            }
        }
    }

    fun warn(var self, msg: str, at: Expr, aw: Expr, help: str) {
        push(self.out, CheckErr { line: at.line, col: at.col, sp: at.sp, msg: msg, decl: -1, notes: [note_at("other calls to the actor may run at this 'await'", aw.line, aw.col, aw.sp), Note { label: "help", msg: help, line: 0, col: 0, sp: no_span() }] })
    }
}
