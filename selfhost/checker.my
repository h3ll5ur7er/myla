// =========================================================================
// Substitutions (generic inference)
// =========================================================================

pub struct Subst { name: str, ty: Type }

#test([], "A")[None]
#test([Subst { name: "T", ty: Type.TParam("V") }], "T")[Some(Type.TParam("V"))]
#test([Subst { name: "S", ty: Type.TEnum("ErrorCode", []) }], "S")[Some(Type.TEnum("ErrorCode", []))]
pub fun subst_get(subst: [Subst], name: str) -> Option<Type> {
    for s in subst { if s.name == name { return Some(s.ty) } }
    return None
}

#test([Subst { name: "T", ty: Type.TStr }], "T")[true]
#test([Subst { name: "T", ty: Type.TBool }], "T")[true]
#test([Subst { name: "T", ty: Type.TParam("T") }], "T")[true]
fun subst_has(subst: [Subst], name: str) -> bool {
    return match subst_get(subst, name) { Some(x) => true, None => false }
}

// Whether `subst` solves every type parameter `t` names. In a callee's
// signature every one is the callee's own, while what `subst` maps them to
// may name the caller's, which are known types in the caller's body
// (MYLA-315): so this, not `contains_type_param` after the substitution,
// says whether a parameter's type is known.
#test(Type.TList(Type.TParam("T")), [Subst { name: "T", ty: Type.TParam("T") }])[true]
#test(Type.TMap(Type.TStr, Type.TParam("V")), [Subst { name: "K", ty: Type.TStr }])[false]
#test(Type.TFunc([Type.TParam("A")], Some(Type.TParam("B"))), [Subst { name: "A", ty: Type.TBool }])[false]
#test(Type.TStr, [])[true]
#test(Type.TActor("Cell", [Type.TParam("T")]), [])[false]
fun solved_in(t: Type, subst: [Subst]) -> bool {
    return match t {
        Type.TParam(n) => subst_has(subst, n),
        Type.TTuple(es) => all_solved_in(es, subst),
        Type.TList(e) => solved_in(e, subst),
        Type.TMap(k, v) => solved_in(k, subst) && solved_in(v, subst),
        Type.TStruct(n, args) => all_solved_in(args, subst),
        Type.TActor(n, args) => all_solved_in(args, subst),
        Type.TEnum(n, args) => all_solved_in(args, subst),
        Type.TFunc(ps, r) => all_solved_in(ps, subst) && (match r { Some(rt) => solved_in(rt, subst), None => true }),
        Type.TAsync(f) => solved_in(f, subst),
        _ => true,
    }
}

#test([], [])[true]
#test([Type.TParam("T"), Type.TStr], [])[false]
fun all_solved_in(xs: [Type], subst: [Subst]) -> bool {
    for x in xs { if !solved_in(x, subst) { return false } }
    return true
}

// The hint an argument of a generic call or a field of a generic literal
// gets, for a parameter or field of type `pt` and the type parameters known
// so far (`subst`): `pt` under them when they solve it. Else for a lambda
// (`lambda`), when `pt` is a function type whose parameter types they solve,
// that function type with its result left open: the lambda's parameters take
// them and its result is inferred from its body (MYLA-356). Else none.
#test(Type.TList(Type.TParam("T")), [Subst { name: "T", ty: Type.TParam("T") }], false)[Some(Type.TList(Type.TParam("T")))]
#test(Type.TList(Type.TParam("T")), [], false)[None]
#test(Type.TFunc([Type.TParam("T")], Some(Type.TParam("U"))), [Subst { name: "T", ty: Type.TInt(32, true) }], true)[Some(Type.TFunc([Type.TInt(32, true)], None))]
#test(Type.TFunc([Type.TParam("T")], Some(Type.TParam("U"))), [Subst { name: "T", ty: Type.TInt(32, true) }], false)[None]
#test(Type.TFunc([Type.TParam("T")], Some(Type.TParam("U"))), [], true)[None]
#test(Type.TAsync(Type.TFunc([Type.TParam("T")], Some(Type.TParam("U")))), [Subst { name: "T", ty: Type.TStr }], true)[Some(Type.TAsync(Type.TFunc([Type.TStr], None)))]
fun arg_hint(pt: Type, subst: [Subst], lambda: bool) -> Option<Type> {
    if solved_in(pt, subst) { return Some(subst_type(pt, subst)) }
    if !lambda { return None }
    return match pt {
        // the result's known part too, its open parameters holes: `(T) ->
        // Result<U, E>` with `T` and `E` known types a lambda's `Ok(x + 1)`
        // (MYLA-356's follow-up)
        Type.TFunc(ps, r) => if all_solved_in(ps, subst) { Some(Type.TFunc(subst_type_list(ps, subst), partial_result(r, subst))) } else { None },
        Type.TAsync(f) => match arg_hint(f, subst, true) {
            Some(h) => Some(Type.TAsync(h)),
            None => None,
        },
        _ => None,
    }
}

// A lambda's result hint, `r` with the type parameters `subst` leaves open
// as holes: only a generic struct or enum some of whose arguments it knows
// (a lambda's expression body takes it, `infer_lambda`).
#test(Some(Type.TEnum("Result", [Type.TParam("U"), Type.TParam("E")])), [Subst { name: "E", ty: Type.TStr }])[Some(Type.TEnum("Result", [Type.TParam("?"), Type.TStr]))]
#test(Some(Type.TEnum("Option", [Type.TParam("U")])), [])[None]
#test(Some(Type.TParam("U")), [])[None]
fun partial_result(r: Option<Type>, subst: [Subst]) -> Option<Type> {
    let rt = match r {
        Some(t) => t,
        None => { return None },
    }
    let args = match rt {
        Type.TEnum(n, a) => a,
        Type.TStruct(n, a) => a,
        _ => { return None },
    }
    var known = false
    for a in args { if solved_in(a, subst) { known = true } }
    if !known { return None }
    var open = subst
    for n in type_params_named(rt) { if !subst_has(subst, n) { open.push(Subst { name: n, ty: hole() }) } }
    return Some(subst_type(rt, open))
}

// The type parameters `t` names, each once.
#test(Type.TMap(Type.TParam("K"), Type.TList(Type.TParam("K"))))[["K"]]
fun type_params_named(t: Type) -> [str] {
    var out: [str] = []
    var todo = [t]
    while todo.len() > 0 {
        let x = todo.pop()
        match x {
            Type.TParam(n) => { if !contains_str(out, n) { out.push(n) } },
            Type.TTuple(es) => { for y in es { todo.push(y) } },
            Type.TList(e) => { todo.push(e) },
            Type.TMap(k, v) => {
                todo.push(k)
                todo.push(v)
            },
            Type.TStruct(n, a) => { for y in a { todo.push(y) } },
            Type.TActor(n, a) => { for y in a { todo.push(y) } },
            Type.TEnum(n, a) => { for y in a { todo.push(y) } },
            Type.TFunc(ps, r) => {
                for y in ps { todo.push(y) }
                match r { Some(y) => { todo.push(y) }, None => {} }
            },
            Type.TAsync(f) => { todo.push(f) },
            _ => {},
        }
    }
    return out
}

// The range of a call's explicit type arguments (not empty), which an error
// about them underlines.
fun targs_span(targs: [TypeExpr]) -> SrcSpan {
    let a = targs[0].sp
    let b = targs[targs.len() - 1].sp
    return SrcSpan { sline: a.sline, scol: a.scol, eline: b.eline, ecol: b.ecol }
}

// What a call's callee is, as an error about its type arguments names it.
#test(expr_of("f"))["function 'f'"]
#test(expr_of("x.m"))["method 'm'"]
#test(expr_of("fs[0]"))["this call"]
fun callee_words(c: Expr) -> str {
    return match c.kind {
        ExprKind.Name(n) => format("function '{}'", n),
        ExprKind.GetField(t, f) => format("method '{}'", f),
        _ => "this call",
    }
}

// Explicit type arguments on the call `e` of something that has no type
// parameters of its own (D169).
fun not_generic(e: Expr, what: str) -> CheckErr {
    let targs = call_targs(e)
    return terr_at(targs[0].line, targs[0].col, targs_span(targs), format("{} is not generic (it takes no type arguments)", what))
}

fun is_ok_call(r: Result<Option<Type>, CheckErr>) -> bool {
    return match r {
        Ok(t) => true,
        Err(e) => false,
    }
}

// The type parameters a generic call's expected type fixes (MYLA-315): its
// declared result `ret` unified with `expected`; none when either is missing
// or they don't fit together, since the expected type is only a hint.
#test(Some(Type.TStruct("B", [Type.TParam("T")])), Some(Type.TStruct("B", [Type.TInt(32, true)])))[[Subst { name: "T", ty: Type.TInt(32, true) }]]
#test(Some(Type.TStruct("B", [Type.TParam("T")])), Some(Type.TStruct("C", [Type.TInt(32, true)])))[[]]
#test(Some(Type.TParam("T")), None)[[]]
#test(None, Some(Type.TStr))[[]]
fun expected_subst(ret: Option<Type>, expected: Option<Type>) -> [Subst] {
    return match ret {
        Some(rt) => match expected {
            Some(et) => {
                let r = unify_param(rt, et, [])
                if r.ok { r.subst } else { [] }
            },
            None => [],
        },
        None => [],
    }
}

// A generic call's declared result `ret` when the type `expected` of the
// call can't be an instance of it (`B<T>` where an `int32` is expected).
#test(Some(Type.TStruct("B", [Type.TParam("T")])), Some(Type.TInt(32, true)))[Some((Type.TStruct("B", [Type.TParam("T")]), Type.TInt(32, true)))]
#test(Some(Type.TStruct("B", [Type.TParam("T")])), Some(Type.TStruct("B", [Type.TStr])))[None]
#test(Some(Type.TParam("T")), Some(Type.TStr))[None]
#test(Some(Type.TStr), None)[None]
fun result_clash(ret: Option<Type>, expected: Option<Type>) -> Option<(Type, Type)> {
    return match ret {
        Some(rt) => match expected {
            Some(et) => if unify_param(rt, et, []).ok || has_hole(et) { None } else { Some((rt, et)) },
            None => None,
        },
        None => None,
    }
}

// `first`, then those of `more` it doesn't name: the type parameters the
// arguments fixed, then the ones the expected type adds (MYLA-315).
#test([Subst { name: "T", ty: Type.TStr }], [Subst { name: "T", ty: Type.TBool }, Subst { name: "U", ty: Type.TChar }])[[Subst { name: "T", ty: Type.TStr }, Subst { name: "U", ty: Type.TChar }]]
#test([], [])[[]]
fun subst_then(first: [Subst], more: [Subst]) -> [Subst] {
    var out = first
    for s in more { if !subst_has(first, s.name) { out.push(s) } }
    return out
}

#test(expr_of("(x) => x"))[true]
#test(expr_of("f(x)"))[false]
fun is_lambda(e: Expr) -> bool {
    return match e.kind { ExprKind.Lambda(ps, rt, body, asy) => true, _ => false }
}

#test(Type.TStr)[false]
#test(Type.TParam("A"))[true]
#test(Type.TParam("B"))[true]
#test(Type.TActor("Cell", [Type.TParam("T")]))[true]
fun contains_type_param(t: Type) -> bool {
    return match t {
        Type.TParam(n) => true,
        Type.TTuple(es) => list_any_tp(es),
        Type.TList(e) => contains_type_param(e),
        Type.TMap(k, v) => contains_type_param(k) || contains_type_param(v),
        Type.TStruct(n, args) => list_any_tp(args),
        Type.TActor(n, args) => list_any_tp(args),
        Type.TEnum(n, args) => list_any_tp(args),
        Type.TFunc(ps, r) => list_any_tp(ps) || (match r { Some(rt) => contains_type_param(rt), None => false }),
        Type.TAsync(f) => contains_type_param(f),
        _ => false,
    }
}

// The names of the parameters from `start` on, when every one of them has
// a default (the defaults a `#test` case leaves out); else none.
fun defaulted_from(params: [Param], start: int32) -> [str] {
    var out: [str] = []
    var i = start
    while i < params.len() {
        match params[i].default {
            Some(d) => { out.push(params[i].name) },
            None => { return [] },
        }
        i += 1
    }
    return out
}

// `'a'`, `'a' and 'b'`, `'a', 'b' and 'c'`.
#test(["x"])["'x'"]
#test(["x", "y"])["'x' and 'y'"]
#test(["x", "y", "z"])["'x', 'y' and 'z'"]
fun quoted_list(names: [str]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < names.len() {
        if i > 0 { sb.append(if i == names.len() - 1 { " and " } else { ", " }) }
        sb.append(f"'{names[i]}'")
        i += 1
    }
    return sb.build()
}

#test(None)[true]
#test(Some(Type.TStr))[false]
fun is_none_type(t: Option<Type>) -> bool {
    return match t { Some(x) => false, None => true }
}

// Whether an arm's body never gives a value (it returns, panics, ...).
fun arm_diverges(body: ExprOrBlock) -> bool {
    return match body {
        ExprOrBlock.EB_Expr(x) => is_diverging(x),
        ExprOrBlock.EB_Block(b) => block_returns(b),
    }
}

// Whether the type parameter `p` occurs in `t`.
#test(Type.TList(Type.TParam("T")), "T")[true]
#test(Type.TList(Type.TParam("T")), "E")[false]
#test(Type.TStr, "T")[false]
#test(Type.TActor("Cell", [Type.TParam("T")]), "T")[true]
fun mentions_param(t: Type, p: str) -> bool {
    return match t {
        Type.TParam(n) => n == p,
        Type.TTuple(es) => list_mentions(es, p),
        Type.TList(e) => mentions_param(e, p),
        Type.TMap(k, v) => mentions_param(k, p) || mentions_param(v, p),
        Type.TStruct(n, args) => list_mentions(args, p),
        Type.TActor(n, args) => list_mentions(args, p),
        Type.TEnum(n, args) => list_mentions(args, p),
        Type.TFunc(ps, r) => list_mentions(ps, p) || (match r { Some(rt) => mentions_param(rt, p), None => false }),
        Type.TAsync(f) => mentions_param(f, p),
        _ => false,
    }
}

fun list_mentions(xs: [Type], p: str) -> bool {
    for x in xs { if mentions_param(x, p) { return true } }
    return false
}

#test([])[false]
#test([Type.TStr])[false]
#test([Type.TParam("T")])[true]
fun list_any_tp(xs: [Type]) -> bool {
    for x in xs { if contains_type_param(x) { return true } }
    return false
}

#test(Type.TSB, [])[Type.TSB]
#test(Type.TList(Type.TParam("T")), [])[Type.TList(Type.TParam("T"))]
#test(Type.TTuple([Type.TTuple([Type.TInt(32, true), Type.TInt(32, true)]), Type.TInt(32, true)]), [])[Type.TTuple([Type.TTuple([Type.TInt(32, true), Type.TInt(32, true)]), Type.TInt(32, true)])]
#test(Type.TActor("Cell", [Type.TParam("T")]), [Subst { name: "T", ty: Type.TStr }])[Type.TActor("Cell", [Type.TStr])]
#test(Type.TFunc([], Some(Type.TParam("T"))), [Subst { name: "T", ty: Type.TTuple([]) }])[Type.TFunc([], None)]
#test(Type.TFunc([], Some(Type.TParam("T"))), [Subst { name: "T", ty: Type.TBool }])[Type.TFunc([], Some(Type.TBool))]
pub fun subst_type(t: Type, subst: [Subst]) -> Type {
    return match t {
        Type.TParam(n) => match subst_get(subst, n) { Some(x) => x, None => t },
        Type.TTuple(es) => Type.TTuple(subst_type_list(es, subst)),
        Type.TList(e) => Type.TList(subst_type(e, subst)),
        Type.TMap(k, v) => Type.TMap(subst_type(k, subst), subst_type(v, subst)),
        Type.TStruct(n, args) => Type.TStruct(n, subst_type_list(args, subst)),
        Type.TActor(n, args) => Type.TActor(n, subst_type_list(args, subst)),
        Type.TEnum(n, args) => Type.TEnum(n, subst_type_list(args, subst)),
        // a result that becomes `()` is none, as a function without one
        // is written (D140): `() -> T` with `T` the unit type (M24)
        Type.TFunc(ps, r) => Type.TFunc(subst_type_list(ps, subst), match r { Some(rt) => result_of(subst_type(rt, subst)), None => None }),
        Type.TAsync(f) => Type.TAsync(subst_type(f, subst)),
        _ => t,
    }
}

#test([], [])[[]]
#test([Type.TParam("T"), Type.TParam("T")], [])[[Type.TParam("T"), Type.TParam("T")]]
#test([Type.TParam("T"), Type.TEnum("List", [Type.TParam("T")])], [Subst { name: "T", ty: Type.TInt(32, true) }])[[Type.TInt(32, true), Type.TEnum("List", [Type.TInt(32, true)])]]
fun subst_type_list(xs: [Type], subst: [Subst]) -> [Type] {
    var out: [Type] = []
    for x in xs { out.push(subst_type(x, subst)) }
    return out
}

// The type arguments `subst` gives the type parameters `tps`, in their
// order: a type parameter it leaves open stays itself (D172, `call_types`).
#test(["T", "U"], [Subst { name: "U", ty: Type.TStr }])[[Type.TParam("T"), Type.TStr]]
fun type_args_in(tps: [str], subst: [Subst]) -> [Type] {
    var out: [Type] = []
    for tp in tps { out.push(subst_type(Type.TParam(tp), subst)) }
    return out
}

#test(None, [])[None]
#test(Some(Type.TStruct("Counter", [])), [])[Some(Type.TStruct("Counter", []))]
#test(Some(Type.TFunc([Type.TParam("T")], Some(Type.TParam("T")))), [Subst { name: "T", ty: Type.TInt(32, true) }])[Some(Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true))))]
pub fun opt_subst_type(t: Option<Type>, subst: [Subst]) -> Option<Type> {
    return match t { Some(x) => Some(subst_type(x, subst)), None => None }
}

pub struct UniRes { ok: bool, subst: [Subst] }

#test(Type.TParam("T"), Type.TStr, [])[UniRes { ok: true, subst: [Subst { name: "T", ty: Type.TStr }] }]
#test(Type.TParam("T"), Type.TStruct("P", []), [])[UniRes { ok: true, subst: [Subst { name: "T", ty: Type.TStruct("P", []) }] }]
#test(Type.TParam("B"), Type.TInt(32, true), [Subst { name: "A", ty: Type.TInt(32, true) }])[UniRes { ok: true, subst: [Subst { name: "A", ty: Type.TInt(32, true) }, Subst { name: "B", ty: Type.TInt(32, true) }] }]
#test(Type.TActor("Cell", [Type.TParam("T")]), Type.TActor("Cell", [Type.TStr]), [])[UniRes { ok: true, subst: [Subst { name: "T", ty: Type.TStr }] }]
#test(Type.TActor("Cell", [Type.TParam("T")]), Type.TStruct("Cell", [Type.TStr]), [])[UniRes { ok: false, subst: [] }]
#test(Type.TFunc([], Some(Type.TParam("T"))), Type.TFunc([], None), [])[UniRes { ok: true, subst: [Subst { name: "T", ty: Type.TTuple([]) }] }]
#test(Type.TFunc([], Some(Type.TInt(32, true))), Type.TFunc([], None), [])[UniRes { ok: false, subst: [] }]
pub fun unify_param(ptype: Type, at: Type, subst: [Subst]) -> UniRes {
    return match ptype {
        Type.TParam(n) => {
            match subst_get(subst, n) {
                Some(prev) => UniRes { ok: type_eq(prev, at), subst: subst },
                None => {
                    var s2 = subst
                    s2.push(Subst { name: n, ty: at })
                    UniRes { ok: true, subst: s2 }
                },
            }
        },
        Type.TTuple(pe) => match at {
            Type.TTuple(ae) => unify_list(pe, ae, subst),
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TList(pe) => match at {
            Type.TList(ae) => unify_param(pe, ae, subst),
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TMap(pk, pv) => match at {
            Type.TMap(ak, av) => {
                let r1 = unify_param(pk, ak, subst)
                if !r1.ok { return UniRes { ok: false, subst: r1.subst } }
                unify_param(pv, av, r1.subst)
            },
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TStruct(pn, pa) => match at {
            Type.TStruct(an, aa) => {
                if pn != an || pa.len() != aa.len() { return UniRes { ok: false, subst: subst } }
                unify_list(pa, aa, subst)
            },
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TEnum(pn, pa) => match at {
            Type.TEnum(an, aa) => {
                if pn != an || pa.len() != aa.len() { return UniRes { ok: false, subst: subst } }
                unify_list(pa, aa, subst)
            },
            _ => UniRes { ok: false, subst: subst },
        },
        Type.TActor(pn, pa) => match at {
            Type.TActor(an, aa) => {
                if pn != an || pa.len() != aa.len() { return UniRes { ok: false, subst: subst } }
                unify_list(pa, aa, subst)
            },
            _ => UniRes { ok: false, subst: subst },
        },
        // like types.py's, the unification doesn't compare asyncness: the
        // types are compared after it
        Type.TAsync(pf) => unify_param(pf, strip_async(at), subst),
        Type.TFunc(pp, pr) => match strip_async(at) {
            Type.TFunc(ap, ar) => {
                if pp.len() != ap.len() { return UniRes { ok: false, subst: subst } }
                let r1 = unify_list(pp, ap, subst)
                if !r1.ok { return UniRes { ok: false, subst: r1.subst } }
                match pr {
                    // a function without a result gives `()` (D140, M24)
                    Some(prt) => match ar { Some(art) => unify_param(prt, art, r1.subst), None => unify_param(prt, Type.TTuple([]), r1.subst) },
                    None => match ar { Some(art) => UniRes { ok: false, subst: r1.subst }, None => UniRes { ok: true, subst: r1.subst } },
                }
            },
            _ => UniRes { ok: false, subst: subst },
        },
        _ => UniRes { ok: type_eq(ptype, at), subst: subst },
    }
}

#test([], [], [])[UniRes { ok: true, subst: [] }]
#test([Type.TParam("T")], [Type.TParam("T")], [])[UniRes { ok: true, subst: [Subst { name: "T", ty: Type.TParam("T") }] }]
#test([Type.TParam("A"), Type.TParam("B")], [Type.TInt(32, true), Type.TInt(32, true)], [])[UniRes { ok: true, subst: [Subst { name: "A", ty: Type.TInt(32, true) }, Subst { name: "B", ty: Type.TInt(32, true) }] }]
fun unify_list(ps: [Type], ats: [Type], subst: [Subst]) -> UniRes {
    var s = subst
    var i = 0
    while i < ps.len() {
        let r = unify_param(ps[i], ats[i], s)
        if !r.ok { return UniRes { ok: false, subst: r.subst } }
        s = r.subst
        i = i + 1
    }
    return UniRes { ok: true, subst: s }
}

// =========================================================================
// Global-table records
// =========================================================================

pub struct FieldT { name: str, ty: Type }
pub struct StructInfo { name: str, type_params: [str], fields: [FieldT], line: int32, col: int32, sp: SrcSpan, id: int32 }

pub struct VariantT { name: str, payload: [Type] }
pub struct EnumInfo { name: str, type_params: [str], variants: [VariantT], line: int32, col: int32, sp: SrcSpan, id: int32 }

// `args`: each trait's type arguments, `I: Iterator<T>` (D171), [] for one
// without them
pub struct Bound { tp: str, traits: [str], args: [[Type]] }
// The trait arguments of an impl of a generic trait, `impl<T> Iterator<T> for
// ListIter<T>` (D55, D171): its target and its arguments, both in its own type
// parameters, which a type of the target's solves.
pub struct ImplArgs { target: Type, args: [Type] }
// Whether `e` is `None`, or a call of `Some`, `Ok` or `Err`: a value whose
// type `==` takes from its other side (MYLA-379).
#test(expr_of("None"))[true]
#test(expr_of("Ok(1)"))[true]
#test(expr_of("f(1)"))[false]
fun needs_other_side(e: Expr) -> bool {
    return match e.kind {
        ExprKind.Name(n) => n == "None",
        ExprKind.Call(c, args, targs) => match c.kind {
            ExprKind.Name(n) => targs.len() == 0 && (n == "Some" || n == "Ok" || n == "Err"),
            _ => false,
        },
        _ => false,
    }
}

#test(None)[true]
#test(Some((Type.TStr, "Eq")))[false]
fun is_none_tt(x: Option<(Type, str)>) -> bool {
    return match x {
        Some(v) => false,
        None => true,
    }
}

// The bounds of a generic impl of a trait, `impl<T: Eq> Eq for Box<T>`
// (MYLA-379): its target in its own type parameters, which a type of the
// target's solves, and the bounds those must meet for the type to have it.
pub struct ImplBounds { target: Type, bounds: [Bound] }
// A map's key type met before every impl was known, checked once they are
// (D163): where, and in which declaration.
pub struct PendingKey { t: Type, line: int32, col: int32, sp: SrcSpan, decl: int32 }
pub struct FuncSig {
    name: str,
    params: [Type],
    ret: Option<Type>,
    type_params: [str],
    own_type_params: int32,         // how many of them, the last ones, are its own: a method's, not its impl's (D169)
    bounds: [Bound],
    decl: FunData,
    has_decl: bool,
    decl_id: int32,                 // its declaration (the impl, for a method)
}

pub struct TraitMethodSig { name: str, params: [Type], ret: Option<Type>, receiver: str }
pub struct TraitInfo { name: str, methods: [TraitMethodSig], type_params: [str], builtin: bool, line: int32, col: int32 }

pub struct MethodEntry { key: str, name: str, sig: FuncSig }
pub struct TraitImplPair { trait_name: str, key: str }

pub struct AliasRaw { name: str, target: TypeExpr, line: int32, col: int32, sp: SrcSpan, id: int32 }
pub struct AliasCached { name: str, ty: Type }

pub struct ConstDeclT { name: str, declared: TypeExpr, value: Expr, line: int32, col: int32, sp: SrcSpan, id: int32 }

// A variable: its type, whether it can be assigned, and where it is declared,
// for notes (`line` 0: no note; MYLA-65); `task`: 0, or an `async let`'s name
// (D89), 1 with a result of type `ty`, 2 with none
pub struct Binding { ty: Type, mutable: bool, line: int32, col: int32, sp: SrcSpan, task: int32 }
// A lambda being checked (D89): its parameters' frame and where it is
// `defer_at`: the checker's `defer_at` outside the lambda, given back after it
pub struct LamAt { base: int32, line: int32, col: int32, sp: SrcSpan, defer_at: int32 }
// A function with a `#main` attribute: where it is, its name and declaration.
pub struct MainAt { line: int32, col: int32, sp: SrcSpan, name: str, id: int32 }
pub struct Frame { names: [str], binds: [Binding] }

// A `become` in function `func` calling `target` (a function value's call
// when `value`; `mutates`: a `var self` method's), with the types of its
// arguments (the receiver first), for `check_become_words` (D119).
pub struct BecomeWords { func: str, target: str, value: bool, mutates: bool, args: [Type], defaults: [str], line: int32, col: int32, sp: SrcSpan, decl: int32 }

// `become` (D87; types.py: _check_become): a `become` that hands a heap value
// over to a parameter, the first of each, and one that passes a heap-value
// parameter on to a function value (in declaration `decl`)
pub struct Handover { func: str, index: int32, by: str, line: int32, col: int32, sp: SrcSpan }
pub struct PassedOn { func: str, index: int32, name: str, line: int32, col: int32, sp: SrcSpan, decl: int32 }

// a checked match-arm body value (with its source node for re-inference)
pub struct MatchVal { ty: Type, node: Option<Expr> }
pub enum ArmBody {
    ABDiverge,
    ABValue(Option<Type>, Option<Expr>),
}

// =========================================================================
// Checker
// =========================================================================

pub struct Checker {
    // the index of the first struct, enum, function and method (`key\tname`)
    // of each name, kept with the lists (`add_*`; MYLA-119)
    struct_map: [str: int32],
    enum_map: [str: int32],
    func_map: [str: int32],
    method_map: [str: int32],
    decls: [Decl],
    structs: [StructInfo],
    enums: [EnumInfo],
    recursive_enums: [str],
    functions: [FuncSig],
    methods: [MethodEntry],
    method_decls: [FunData],
    method_decl_keys: [str],
    method_decl_ids: [int32],       // each method's impl declaration
    impl_decls: [Decl],
    next_id: int32,            // the first node id no declaration has: a derived impl's (MYLA-313)
    // map key types (D163): those met before the impls were known, whether
    // they are, and whether a function's bounds are in force (its signature
    // and body are being checked)
    pending_keys: [PendingKey],
    keys_ready: bool,
    key_ctx: bool,
    traits: [TraitInfo],
    trait_decls: [Decl],
    trait_impls: [TraitImplPair],
    user_trait_impls: [TraitImplPair],
    impl_args: [str: ImplArgs],     // a generic trait's impls' arguments, by `trait\tkey` (D171)
    impl_bounds: [str: ImplBounds], // a generic impl's bounds on its type parameters, by `trait\tkey` (MYLA-379)
    for_iters: [int32: Stmt],       // a `for` over an iterator, by its id: the loop it is (D171, `check_for_iterator`)
    // functions without `self` (D172): each one's impl target, by its name
    // (`Box.zero`: `Box<T>`), which solves the impl's type parameters; the
    // calls of one, `T.zero()` or `int.zero()`, by the call's id: the type
    // it is called on, in the caller's type parameters; whether one is
    // called on a type parameter, which the interpreter then binds at each
    // generic call, with the type arguments the checker solved there (by
    // the call's id, in the order of the callee's type parameters)
    static_selfs: [str: Type],
    static_calls: [int32: Type],
    on_type_params: bool,
    call_types: [int32: [Type]],
    aliases: [AliasRaw],
    alias_cache: [AliasCached],
    const_decls: [ConstDeclT],
    consts: [AliasCached],          // folded consts: {name, ty}
    const_values: [str: CV],        // ... and their values
    const_done: [str],
    const_folding: [str],
    allow_self: bool,
    type_params: [str],
    bounds_cur: [Bound],
    cur_ret: Option<Type>,
    has_cur_ret: bool,
    ret_at: Option<TypeExpr>,       // the return type of the function being checked, for notes (MYLA-65)
    loop_depth: int32,
    // in a deferred block (D135): the loop depth where the innermost one
    // starts, which its `break` and `continue` can't leave; -1 outside one
    defer_at: int32,
    frames: [Frame],
    lambda_infer_active: bool,
    lambda_depth: int32,            // lambdas being checked (`?` names "lambda" or "function")
    cur_decl: int32,                // the declaration being checked, for CheckErr.decl
    lambda_infer: [MatchVal],
    stmt_match: bool,
    resolved: [int32: Type],        // expr node id -> resolved type (v0.8 interp side table)
    call_defaults: [int32: [Expr]], // call node id -> the defaults it leaves to its trailing parameters (D136)
    fill_decls: [int32: bool],      // the declarations holding a recorded default, `for` over an iterator or rename: those `fill_in` rewrites (MYLA-382)
    errs: [CheckErr],               // the errors of the functions checked so far (MYLA-65, D80)
    warnings: [CheckErr],           // D95: the warnings found, in the order found
    primitives: bool,               // a program may call the raw-memory primitives (`gen_main --primitives`, the toolchain's tests)
    // the functions (`std$str$join`) and methods (`str.trim`) checked code
    // calls or names: an implicit module's others aren't checked (MYLA-359)
    called: [str: bool],
    lazy_bodies: LazyBodies,        // the bodies the loader left unparsed (MYLA-359)
    read_bodies: [int64: Block],    // those read so far, by `body_key`
    read_ids: [int32: bool],        // and their declarations
    std_impls: [int32: DeclOrigin], // the standard library's impls by node id (the loader's): their methods are its code (MYLA-320); and an entry std module's functions (MYLA-388)
    mutating_calls: [int32: bool],  // the calls of a `var self` method in an actor's methods, by node id: D95 counts one on a field of `self` as a change of it (MYLA-394)
    renames: [int32: str],          // a callee's node id -> the name it stands for, put in by `fill_in`: `cancel` inside std.task is `std$task$cancel` (MYLA-388)
    // `#allow` (D161): the warnings the function being checked silences
    // (`primitive`, `primitive:__poll`, `reentrancy`), and the impl block's
    // `#allow`s while its methods are registered
    allowed: [str],
    impl_allows: [Attribute],
    method_decl_allows: [[Attribute]],  // each method's impl block's `#allow`s (D161)
    // going on after a declaration's error (MYLA-110, D84; types.py: Checker):
    // the declarations left out and the functions not checked (by
    // name: a function with a bad bound); the `trait\tkey` pairs whose impl or
    // derive failed; redefined builtins; the methods and traits of impls left
    // out for want of a type; the consts that failed; whether the declaration
    // phases are done
    skipped_decls: [int32: bool],   // by index in `decls` (node ids repeat: the prelude's start at 0 too)
    skipped_fns: [str: bool],
    broken_impls: [str: bool],
    redefined: [str: bool],
    lost_methods: [str: bool],
    lost_traits: [str: bool],
    failed_consts: [str: bool],
    bodies: bool,
    mains: [MainAt],                // the `#main` functions found so far
    // `become` (D87): the kind of the call inferred last (`function`,
    // `method` or `value`), its node and its function; the function being
    // checked; the parameters (`function\tindex`) a `become` hands a heap value
    // over to, and the heap-value parameters one passes on to a function value
    call_kind: str,
    call_kind_id: int32,
    targs_taken: int32,             // the last call whose explicit type arguments a generic function or method took (D169)
    open_at: int32,                 // the list or map literal's element that may leave type parameters open, as holes (MYLA-401)
    col_open: [[Expr]],             // each open literal column's elements with a hole (`LitColumn.slot`)
    col_lits: [[Expr]],             // each open literal column's literals while only literals fix its type (L2)
    tp_fields: [str: bool],         // the names of the fields of a type parameter's type, once `tp_fields_ready` (D178)
    tp_fields_ready: bool,
    prelude_needed: bool,           // whether a type holding an `Option` or a `Result` was compared or hashed
    lazy_prelude: [int32: bool],    // the prelude's derived `Eq` and `Hash` impls of `Option` and `Result`, until a type that holds one is compared or hashed (D182)
    call_target: str,
    call_mutates: bool,
    fun_name: str,
    handovers: [str: Handover],
    become_words: [BecomeWords],
    passed_on: [PassedOn],
    // concurrency (D89; types.py: Checker): the actor types; the first
    // construct of concurrency met (`conc_line` 0: none), which the
    // interpreters and backends don't run yet; whether the function or lambda
    // being checked is async; the actor whose method is being checked ("":
    // none) and the key of the type whose method it is ("": a function); the
    // lambdas being checked; the calls under an `await`, by id; the type key
    // of the method called last and whether that call's callee is async; the
    // call found last to suspend
    actors: [str: bool],
    conc_line: int32,
    conc_col: int32,
    conc_sp: SrcSpan,
    conc_node: int32,
    in_async: bool,
    self_assignable: bool,          // D144: in a `var self` method of a built-in type or an enum, `self = v` writes the receiver
    actor_self: str,
    // the call being checked is a builtin function called as a method
    // (`xs.push(v)`, D103, MYLA-221): a local of the same name doesn't shadow it
    builtin_as_method: bool,
    cur_key: str,
    lams: [LamAt],
    awaited: [int32: bool],
    call_key: str,
    call_async: bool,
    suspended: int32,
    task_init: bool,                // checking an `async let`'s initializer, outside its lambdas
    in_guard: bool,                 // checking a match guard, outside its lambdas
    neg_lit: int32,                 // the integer literal under a unary minus, or -1 (MYLA-175)
    // the first `async let`, which the compiler doesn't build yet (D91,
    // MYLA-138; `task_line` 0: none)
    task_line: int32,
    task_col: int32,
    task_sp: SrcSpan,
    task_node: int32,
}

fun new_checker(decls: [Decl]) -> Checker {
    return Checker {
        struct_map: [:], enum_map: [:], func_map: [:], method_map: [:],
        decls: decls,
        structs: [], enums: [], recursive_enums: [],
        functions: [], methods: [], method_decls: [], method_decl_keys: [], method_decl_ids: [],
        impl_decls: [], next_id: 1000000000, pending_keys: [], keys_ready: false, key_ctx: false, traits: [], trait_decls: [], trait_impls: [], user_trait_impls: [], impl_args: [:], impl_bounds: [:], for_iters: [:],
        static_selfs: [:], static_calls: [:], on_type_params: false, call_types: [:],
        aliases: [], alias_cache: [], const_decls: [], consts: [], const_values: [:], const_done: [], const_folding: [],
        allow_self: false, type_params: [], bounds_cur: [],
        cur_ret: None, has_cur_ret: false, ret_at: None, loop_depth: 0, defer_at: -1,
        frames: [], lambda_infer_active: false, lambda_depth: 0, cur_decl: -1, lambda_infer: [], stmt_match: false,
        resolved: [:], call_defaults: [:], errs: [], warnings: [], primitives: false, called: [:], lazy_bodies: no_lazy_bodies(), read_bodies: [:], read_ids: [:], std_impls: [:], allowed: [], impl_allows: [], method_decl_allows: [], mains: [],
        skipped_decls: [:], skipped_fns: [:], broken_impls: [:], redefined: [:],
        lost_methods: [:], lost_traits: [:], failed_consts: [:], bodies: false,
        call_kind: "", call_kind_id: -1, targs_taken: -1, open_at: -1, col_open: [], col_lits: [], tp_fields: [:], tp_fields_ready: false, prelude_needed: false, lazy_prelude: [:], call_target: "", call_mutates: false, fun_name: "", handovers: [:], become_words: [], passed_on: [],
        actors: [:], conc_line: 0, conc_col: 0, conc_sp: no_span(), conc_node: -1, in_async: false, self_assignable: false, actor_self: "", builtin_as_method: false, cur_key: "",
        lams: [], awaited: [:], call_key: "", call_async: false, suspended: -1, task_init: false, in_guard: false, neg_lit: -1,
        task_line: 0, task_col: 0, task_sp: no_span(), task_node: -1, fill_decls: [:], renames: [:], mutating_calls: [:],
    }
}

// AST predicate helpers (free functions over the AST)

#test(Expr { id: 9, line: 5, col: 29, sp: SrcSpan { sline: 5, scol: 29, eline: 5, ecol: 30 }, kind: ExprKind.Name("r") })[false]
#test(Expr { id: 10, line: 5, col: 28, sp: SrcSpan { sline: 5, scol: 28, eline: 5, ecol: 29 }, kind: ExprKind.Name("r") })[false]
#test(Expr { id: 16, line: 20, col: 13, sp: SrcSpan { sline: 20, scol: 13, eline: 20, ecol: 14 }, kind: ExprKind.Name("s") })[false]
fun is_diverging(e: Expr) -> bool {
    return match e.kind {
        ExprKind.Call(c, args, _) => match c.kind { ExprKind.Name(n) => is_diverging_builtin(n), _ => false },
        _ => false,
    }
}

#test(stmt_of("return a"))[true]
fun stmt_returns(s: Stmt) -> bool {
    return match s.kind {
        StmtKind.ReturnS(v, tail) => true,
        StmtKind.ExprStmt(e) => is_diverging(e) || match_returns(e),
        StmtKind.IfS(cond, then, otherwise) => {
            if !block_returns(then) { return false }
            match otherwise {
                Some(et) => match et { ElseTail.ElseBlock(b) => block_returns(b), ElseTail.ElseIf(s2) => stmt_returns(s2) },
                None => false,
            }
        },
        _ => false,
    }
}

// Whether `e` is a match whose every arm returns (or diverges): a function
// may end with one, as with a let-else (D137).
#test(expr_of("match o { Some(v) => 1, None => 2 }"))[false]
fun match_returns(e: Expr) -> bool {
    match e.kind {
        ExprKind.MatchE(value, arms) => {
            for arm in arms {
                let ok = match arm.body { ExprOrBlock.EB_Block(b) => block_returns(b), ExprOrBlock.EB_Expr(x) => is_diverging(x) }
                if !ok { return false }
            }
            return arms.len() > 0
        },
        _ => {},
    }
    return false
}

// Whether running `b` always leaves it: a `return`, `become`, `break` or
// `continue` at its level, a call that never returns, or an `if` (or match)
// whose every branch leaves (a let-else's `else`, D137). A `break` inside a
// loop in `b` leaves that loop, not `b`, so loops are not looked into.
#test(block_of("{ }"))[false]
fun block_leaves(b: Block) -> bool {
    for st in b.stmts { if stmt_leaves(st) { return true } }
    return false
}

#test(stmt_of("break"))[true]
#test(stmt_of("x = 1"))[false]
fun stmt_leaves(st: Stmt) -> bool {
    return match st.kind {
        StmtKind.BreakS => true,
        StmtKind.ContinueS => true,
        StmtKind.IfS(cond, then, otherwise) => {
            if !block_leaves(then) { return false }
            match otherwise {
                Some(et) => match et { ElseTail.ElseBlock(b) => block_leaves(b), ElseTail.ElseIf(s2) => stmt_leaves(s2) },
                None => false,
            }
        },
        _ => stmt_returns(st),
    }
}

#test(block_of("{ }"))[false]
fun block_returns(b: Block) -> bool {
    for s in b.stmts { if stmt_returns(s) { return true } }
    return false
}

#test(Expr { id: 3, line: 4, col: 12, sp: SrcSpan { sline: 4, scol: 12, eline: 4, ecol: 13 }, kind: ExprKind.Name("a") })[false]
#test(Expr { id: 4, line: 4, col: 16, sp: SrcSpan { sline: 4, scol: 16, eline: 4, ecol: 17 }, kind: ExprKind.Name("b") })[false]
#test(Expr { id: 4, line: 9, col: 36, sp: SrcSpan { sline: 9, scol: 36, eline: 9, ecol: 42 }, kind: ExprKind.StrLit("nope") })[false]
fun is_flexible_int_lit(e: Expr) -> bool {
    return match e.kind {
        ExprKind.IntLit(v, suf, isc, big) => match suf { Some(x) => false, None => (!isc) || v <= 127 },
        _ => false,
    }
}

#test(Expr { id: 3, line: 4, col: 12, sp: SrcSpan { sline: 4, scol: 12, eline: 4, ecol: 13 }, kind: ExprKind.Name("a") })[false]
#test(Expr { id: 4, line: 4, col: 16, sp: SrcSpan { sline: 4, scol: 16, eline: 4, ecol: 17 }, kind: ExprKind.Name("b") })[false]
#test(Expr { id: 3, line: 5, col: 23, sp: SrcSpan { sline: 5, scol: 23, eline: 5, ecol: 26 }, kind: ExprKind.StrLit("x") })[false]
fun is_flexible_char_lit(e: Expr) -> bool {
    return match e.kind { ExprKind.IntLit(v, suf, isc, big) => isc, _ => false }
}

#test(expr_of("-n * 2"))[false]
fun is_flexible_float_lit(e: Expr) -> bool {
    return match e.kind { ExprKind.FloatLit(lex, suf) => match suf { Some(x) => false, None => true }, _ => false }
}

#test(expr_of("-n * 2"))[0]
fun int_lit_value(e: Expr) -> int64 {
    return match e.kind { ExprKind.IntLit(v, suf, isc, big) => v, _ => 0 }
}

#test(Expr { id: 78, line: 51, col: 17, sp: SrcSpan { sline: 51, scol: 17, eline: 51, ecol: 19 }, kind: ExprKind.Name("by") })[None]
#test(Expr { id: 2, line: 4, col: 19, sp: SrcSpan { sline: 4, scol: 19, eline: 4, ecol: 20 }, kind: ExprKind.IntLit(9, None, false, "") })[Some(9)]
#test(Expr { id: 2, line: 10, col: 25, sp: SrcSpan { sline: 10, scol: 25, eline: 10, ecol: 27 }, kind: ExprKind.IntLit(10, None, false, "") })[Some(10)]
fun const_int(e: Expr) -> Option<int64> {
    return match e.kind {
        ExprKind.IntLit(v, suf, isc, big) => Some(v),
        ExprKind.Unary(op, x) => const_int_neg(op, x),
        _ => None,
    }
}

#test("a", expr_of("-n * 2"))[None]
fun const_int_neg(op: str, x: Expr) -> Option<int64> {
    if op != "-" { return None }
    return match x.kind {
        ExprKind.IntLit(v, suf, isc, big) => Some(0 - v),
        _ => None,
    }
}

#test(Expr { id: 14, line: 13, col: 5, sp: SrcSpan { sline: 13, scol: 5, eline: 13, ecol: 6 }, kind: ExprKind.Name("c") })[true]
#test(Expr { id: 24, line: 19, col: 5, sp: SrcSpan { sline: 19, scol: 5, eline: 19, ecol: 6 }, kind: ExprKind.Name("w") })[true]
#test(Expr { id: 116, line: 57, col: 5, sp: SrcSpan { sline: 57, scol: 5, eline: 57, ecol: 6 }, kind: ExprKind.Name("c") })[true]
fun is_lvalue_shape(e: Expr) -> bool {
    return match e.kind {
        ExprKind.Name(n) => true,
        ExprKind.GetField(t, f) => is_lvalue_shape(t),
        ExprKind.Index(t, i) => is_lvalue_shape(t),
        _ => false,
    }
}

// --- lookups -------------------------------------------------------------

impl Checker {
    #test(checker_on("[int]"), "int")[-1]
    fun struct_idx(self, name: str) -> int32 { return index_in(self.struct_map, name) }
    #test(checker_on("[int]"), "int")[-1]
    fun enum_idx(self, name: str) -> int32 { return index_in(self.enum_map, name) }
    #test(checker_on("[int]"), "add")[-1]
    fun func_idx(self, name: str) -> int32 { return index_in(self.func_map, name) }

    // Append to the tables, keeping their maps (the first of a name wins, as
    // the searches they replace found it).
    fun add_struct(var self, info: StructInfo) {
        if !self.struct_map.contains(info.name) { self.struct_map[info.name] = self.structs.len() }
        self.structs.push(info)
    }
    fun add_enum(var self, info: EnumInfo) {
        if !self.enum_map.contains(info.name) { self.enum_map[info.name] = self.enums.len() }
        self.enums.push(info)
    }
    fun add_function(var self, sig: FuncSig) {
        if !self.func_map.contains(sig.name) { self.func_map[sig.name] = self.functions.len() }
        self.functions.push(sig)
    }
    fun add_method(var self, m: MethodEntry) {
        let k = m.key + "\t" + m.name
        if !self.method_map.contains(k) { self.method_map[k] = self.methods.len() }
        self.methods.push(m)
    }
    #test(checker_on("[int]"), "Eq")[5]
    fun trait_idx(self, name: str) -> int32 {
        var i = 0
        while i < self.traits.len() { if self.traits[i].name == name { return i }
            i = i + 1
        }
        return -1
    }
    #test(checker_on("[int]"), "A")[-1]
    fun alias_idx(self, name: str) -> int32 {
        var i = 0
        while i < self.aliases.len() { if self.aliases[i].name == name { return i }
            i = i + 1
        }
        return -1
    }
    #test(checker_on("[int]"), "A")[None]
    fun alias_cache_get(self, name: str) -> Option<Type> {
        for a in self.alias_cache { if a.name == name { return Some(a.ty) } }
        return None
    }
    #test(checker_on("[int]"), "KIB")[-1]
    fun const_decl_idx(self, name: str) -> int32 {
        var i = 0
        while i < self.const_decls.len() { if self.const_decls[i].name == name { return i }
            i = i + 1
        }
        return -1
    }
    #test(checker_on("[int]"), "Box")[false]
    fun is_struct(self, name: str) -> bool { return self.struct_idx(name) >= 0 }
    #test(checker_on("[int]"), "a")[false]
    fun is_enum(self, name: str) -> bool { return self.enum_idx(name) >= 0 }

    #test(checker_on("[int]"), "Adder", "f")[None]
    fun method_sig(self, key: str, name: str) -> Option<FuncSig> {
        let i = index_in(self.method_map, key + "\t" + name)
        if i < 0 { return None }
        return Some(self.methods[i].sig)
    }
    #test(checker_on("[int]"), Type.TInt(32, true))[Some("int32")]
    fun type_key(self, t: Type) -> Option<str> {
        return match t {
            Type.TStruct(n, a) => Some(n),
            Type.TActor(n, a) => Some(n),
            Type.TEnum(n, a) => Some(n),
            Type.TInt(w, s) => Some(int_type_name(w, s)),
            Type.TBool => Some("bool"),
            Type.TStr => Some("str"),
            Type.TSB => Some("StringBuilder"),
            // the builtin kinds a program may give methods too (D103, MYLA-221):
            // a list's or map's are keyed by its kind, as a generic struct's
            // are by its name, with names no program can declare
            Type.TChar => Some("char"),
            Type.TFloat(w) => Some(format("float{}", w)),
            Type.TList(e) => Some("__list"),
            Type.TMap(k, v) => Some("__map"),
            _ => None,
        }
    }
    #test(checker_on("[int]"), "Vec2", "Eq")[false]
    fun trait_implements_pair(self, key: str, trnm: str) -> bool {
        for p in self.trait_impls { if p.key == key && p.trait_name == trnm { return true } }
        return false
    }
    #test(checker_on("[int]"), Type.TInt(32, true), "Add")[Ok(true)]
    #test(checker_on("[int]"), Type.TTuple([Type.TInt(32, true), Type.TStr]), "Eq")[Ok(true)]
    #test(checker_on("[int]"), Type.TList(Type.TTuple([Type.TChar, Type.TFloat(64)])), "Eq")[Ok(true)]
    #test(checker_on("[int]"), Type.TTuple([Type.TInt(32, true), Type.TFloat(64)]), "Hash")[Ok(false)]
    #test(checker_on("[int]"), Type.TList(Type.TStr), "Hash")[Ok(true)]
    #test(checker_on("[int]"), Type.TTuple([Type.TStruct("P", [])]), "Eq")[Ok(false)]
    fun type_implements(self, t: Type, trnm: str) -> Result<bool, CheckErr> {
        // a tuple, and a list, is `Eq` and `Hash` when its elements are
        // (D163); a type parameter when its bounds say so
        if trnm == "Eq" || trnm == "Hash" {
            match t {
                Type.TTuple(es) => {
                    for et in es {
                        if !self.type_implements(et, trnm)? { return Ok(false) }
                    }
                    return Ok(true)
                },
                Type.TList(et) => { return self.type_implements(et, trnm) },
                Type.TParam(n) => { return Ok(self.bound_has(n, trnm)) },
                Type.TError => { return Ok(true) },   // has had its error (MYLA-110)
                _ => {},
            }
        }
        match self.type_key(t) {
            Some(k) => {
                if self.broken_impls.contains(trnm + "\t" + k) { return Err(poisoned()) }   // its impl or derive failed (MYLA-110)
                if self.trait_implements_pair(k, trnm) { return Ok(is_none_tt(self.impl_bound_failing(k, trnm, t)?)) }
            },
            None => {},
        }
        if primitive_default_trait(t, trnm) { return Ok(true) }
        if self.lost_traits.contains(trnm) { return Err(poisoned()) }   // maybe the left-out impl (MYLA-110)
        return Ok(false)
    }

    // The first argument of `t` (a type with the key `k`) that doesn't meet
    // a bound of its impl of `trnm`, and the bound's trait: `P` and `Eq` of
    // `Option<P>` for `impl<T: Eq> Eq for Option<T>` (MYLA-379); None when
    // they all do or the impl has none.
    #test(checker_on("[int]"), "Vec2", "Eq", Type.TStruct("Vec2", []))[Ok(None)]
    fun impl_bound_failing(self, k: str, trnm: str, t: Type) -> Result<Option<(Type, str)>, CheckErr> {
        let ib = match self.impl_bounds.get(trnm + "\t" + k) {
            Some(x) => x,
            None => { return Ok(None) },
        }
        let u = unify_param(ib.target, t, [])
        for b in ib.bounds {
            // (a parameter the target doesn't hold has nothing to meet)
            let c = match subst_get(u.subst, b.tp) {
                Some(x) => x,
                None => Type.TError,
            }
            if has_error(c) { continue }
            var j = 0
            while j < b.traits.len() {
                // a generic trait's arguments are its impl's to solve (D171)
                if b.args[j].len() == 0 {
                    let ok = match c {
                        Type.TParam(pn) => self.bound_has(pn, b.traits[j]),
                        _ => self.type_implements(c, b.traits[j])?,
                    }
                    if !ok { return Ok(Some((c, b.traits[j]))) }
                }
                j += 1
            }
        }
        return Ok(None)
    }

    // --- scope -----------------------------------------------------------
    fun push_scope(var self) { self.frames.push(Frame { names: [], binds: [] }) }
    fun pop_scope(var self) { self.frames.pop() }
    #test(checker_on("fun main() { print(1 + 2) }"), "c", Type.TChar, false)[true]
    fun define(var self, name: str, ty: Type, mutable: bool) -> bool {
        return self.define_at(name, ty, mutable, 0, 0, no_span())
    }
    // `define`, for a variable declared at `line`, `col`, `sp`.
    #test(checker_on("fun main() { print(1 + 2) }"), "c", Type.TChar, false, 7, 14, SrcSpan { sline: 7, scol: 14, eline: 7, ecol: 21 })[true]
    fun define_at(var self, name: str, ty: Type, mutable: bool, line: int32, col: int32, sp: SrcSpan) -> bool {
        let top = self.frames.len() - 1
        for nm in self.frames[top].names { if nm == name { return false } }
        self.frames[top].names.push(name)
        self.frames[top].binds.push(Binding { ty: ty, mutable: mutable, line: line, col: col, sp: sp, task: 0 })
        return true
    }
    // `define_at` for an `async let`'s name (D89): `ty` its result's type, if any.
    #test(checker_on("fun main() { print(1 + 2) }"), "d1", None, 52, 5, SrcSpan { sline: 52, scol: 5, eline: 52, ecol: 40 })[true]
    fun define_task(var self, name: str, ty: Option<Type>, line: int32, col: int32, sp: SrcSpan) -> bool {
        let top = self.frames.len() - 1
        for nm in self.frames[top].names { if nm == name { return false } }
        self.frames[top].names.push(name)
        let b = match ty {
            Some(t) => Binding { ty: t, mutable: false, line: line, col: col, sp: sp, task: 1 },
            None => Binding { ty: Type.TTuple([]), mutable: false, line: line, col: col, sp: sp, task: 2 },
        }
        self.frames[top].binds.push(b)
        return true
    }
    // The index of the frame that defines `name`, or -1.
    #test(checker_on("[int]"), "a")[-1]
    fun lookup_frame(self, name: str) -> int32 {
        var i = self.frames.len() - 1
        while i >= 0 {
            for nm in self.frames[i].names { if nm == name { return i } }
            i = i - 1
        }
        return -1
    }
    // Every name in scope, innermost scope first.
    #test(checker_on("[int]"))[[]]
    fun scope_names(self) -> [str] {
        var out: [str] = []
        var i = self.frames.len() - 1
        while i >= 0 {
            for nm in self.frames[i].names { out.push(nm) }
            i = i - 1
        }
        return out
    }

    // --- notes (MYLA-65) -------------------------------------------------
    // A note on where the variable the assigned place `target` starts from is
    // declared (types.py: _declared_at).
    #test(checker_on("[int]"), Expr { id: 2, line: 9, col: 5, sp: SrcSpan { sline: 9, scol: 5, eline: 9, ecol: 6 }, kind: ExprKind.Name("x") })[[]]
    fun declared_at(self, target: Expr) -> [Note] {
        var e = target
        var going = true
        while going {
            match e.kind {
                ExprKind.GetField(t, f) => { e = t },
                ExprKind.Index(t, i) => { e = t },
                ExprKind.TupleIndex(t, i) => { e = t },
                _ => { going = false },
            }
        }
        match e.kind {
            ExprKind.Name(n) => {
                match self.lookup(n) {
                    Some(b) => { if b.line > 0 { return [note_at(format("'{}' is declared here", n), b.line, b.col, b.sp)] } },
                    None => {},
                }
            },
            _ => {},
        }
        return []
    }
    // A note on the declaration `name` repeats in the innermost scope (types.py:
    // _first_declared).
    #test(checker_on("fun main() { print(1 + 2) }"), "total")[[]]
    fun first_declared(self, name: str) -> [Note] {
        let top = self.frames.len() - 1
        var j = 0
        while j < self.frames[top].names.len() {
            if self.frames[top].names[j] == name {
                let b = self.frames[top].binds[j]
                if b.line == 0 { return [] }
                return [note_at(format("'{}' is first declared here", name), b.line, b.col, b.sp)]
            }
            j = j + 1
        }
        return []
    }
    // The names a value can be: variables, constants, functions and the
    // prelude's variants (types.py: _value_names).
    #test(checker_on("[int]"))[["Some", "None", "Ok", "Err"]]
    fun value_names(self) -> [str] {
        var out = self.scope_names()
        for c in self.const_decls { out.push(c.name) }
        for f in self.functions { out.push(f.name) }
        for v in ["Some", "None", "Ok", "Err"] { out.push(v) }
        return out
    }
    // The names a call can name (types.py: _callable_names): not the
    // builtins that are methods (MYLA-221).
    #test(checker_on("[int]"))[["print", "assert", "panic", "unreachable", "format", "StringBuilder"]]
    fun callable_names(self) -> [str] {
        var out: [str] = []
        for f in self.functions { out.push(f.name) }
        for b in builtin_func_names() {
            if !builtin_method_name(b) { out.push(b) }
        }
        for nm in self.scope_names() { out.push(nm) }
        return out
    }
    // The names a type can be (types.py: _type_names).
    #test(checker_on("[int]"))[["bool", "str", "StringBuilder", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "char", "int", "float"]]
    fun type_names(self) -> [str] {
        var out = primitive_type_names()
        out.push("int")
        out.push("float")
        for si in self.structs { out.push(si.name) }
        for ei in self.enums { out.push(ei.name) }
        for a in self.aliases { out.push(a.name) }
        for tp in self.type_params { out.push(tp) }
        return out
    }
    // The methods of the type with key `key`.
    #test(checker_on("[int]"), Some("P"))[[]]
    fun method_names(self, key: Option<str>) -> [str] {
        var out: [str] = []
        match key {
            Some(k) => { for m in self.methods { if m.key == k { out.push(m.name) } } },
            None => {},
        }
        return out
    }
    // The index of the innermost frame defining `name`, or -1.
    #test(checker_on("[int]"), "xs")[-1]
    fun frame_of(self, name: str) -> int32 {
        var i = self.frames.len() - 1
        while i >= 0 {
            for nm in self.frames[i].names { if nm == name { return i } }
            i = i - 1
        }
        return -1
    }

    #test(checker_on("[int]"), "a")[None]
    fun lookup(self, name: str) -> Option<Binding> {
        var i = self.frames.len() - 1
        while i >= 0 {
            var j = 0
            while j < self.frames[i].names.len() {
                if self.frames[i].names[j] == name { return Some(self.frames[i].binds[j]) }
                j = j + 1
            }
            i = i - 1
        }
        return None
    }
}

#test(32, true)["int32"]
fun int_type_name(w: int32, signed: bool) -> str {
    var p = "uint"
    if signed { p = "int" }
    return format("{}{}", p, w)
}

#test([])[[]]
#test([TypeParam { line: 4, col: 8, sp: SrcSpan { sline: 4, scol: 8, eline: 4, ecol: 9 }, name: "T", bounds: [], bound_args: [] }])[["T"]]
#test([TypeParam { line: 10, col: 16, sp: SrcSpan { sline: 10, scol: 16, eline: 10, ecol: 17 }, name: "S", bounds: [], bound_args: [] }])[["S"]]
fun tp_names(tps: [TypeParam]) -> [str] {
    var out: [str] = []
    for tp in tps { out.push(tp.name) }
    return out
}

fun decl_kind_name(d: Decl) -> str {
    return match d.kind {
        DeclKind.StructDecl(n, f, a, t, p, act) => n,
        DeclKind.EnumDecl(n, v, a, t, p) => n,
        DeclKind.TypeAliasDecl(n, tt, a, p) => n,
        DeclKind.ConstDecl(n, tt, vv, a, p) => n,
        DeclKind.FunDecl(fd) => fd.name,
        DeclKind.TraitDecl(n, m, t, p, dattrs) => n,
        _ => "",
    }
}

// =========================================================================
// Type resolution
// =========================================================================

impl Checker {
    #test(checker_on("[int]"), TypeExpr { id: 9, line: 8, col: 12, sp: SrcSpan { sline: 8, scol: 12, eline: 8, ecol: 15 }, kind: TypeKind.TRef("int", []) })[Ok(Type.TInt(32, true))]
    fun resolve0(var self, ref: TypeExpr) -> Result<Type, CheckErr> {
        let empty: [str] = []
        return self.resolve(ref, empty)
    }

    #test(checker_on("[int]"), [TypeExpr { id: 0, line: 12, col: 9, sp: SrcSpan { sline: 12, scol: 9, eline: 12, ecol: 12 }, kind: TypeKind.TRef("int", []) }], [])[Ok([Type.TInt(32, true)])]
    fun resolve_list(var self, refs: [TypeExpr], visiting: [str]) -> Result<[Type], CheckErr> {
        var out: [Type] = []
        for r in refs { out.push(self.resolve(r, visiting)?) }
        return Ok(out)
    }

    #test(checker_on("enum E { A, B(int) }"), TypeExpr { id: 43, line: 2, col: 32, sp: SrcSpan { sline: 2, scol: 32, eline: 2, ecol: 33 }, kind: TypeKind.TRef("E", []) }, [])[Ok(Type.TEnum("E", []))]
    fun resolve(var self, ref: TypeExpr, visiting: [str]) -> Result<Type, CheckErr> {
        let ln = ref.line
        let cl = ref.col
        let sp = ref.sp
        return match ref.kind {
            TypeKind.TTuple(elems) => Ok(Type.TTuple(self.resolve_list(elems, visiting)?)),
            TypeKind.TList(elem) => Ok(Type.TList(self.resolve(elem, visiting)?)),
            TypeKind.TMap(k, v) => {
                let kt = self.resolve(k, visiting)?
                let vt = self.resolve(v, visiting)?
                self.check_key(kt, ln, cl, sp)?
                Ok(Type.TMap(kt, vt))
            },
            TypeKind.TFn(params, ret, asy) => {
                let ps = self.resolve_list(params, visiting)?
                let rt = self.resolve(ret, visiting)?
                Ok(func_type(ps, result_of(rt), asy))
            },
            TypeKind.TRef(name, args) => self.resolve_ref(name, args, ln, cl, sp, visiting),
        }
    }

    #test(checker_on("enum E { A, B(int) }"), "E", [], 2, 32, SrcSpan { sline: 2, scol: 32, eline: 2, ecol: 33 }, [])[Ok(Type.TEnum("E", []))]
    fun resolve_ref(var self, name: str, args: [TypeExpr], ln: int32, cl: int32, sp: SrcSpan, visiting: [str]) -> Result<Type, CheckErr> {
        if name == "Self" {
            if !self.allow_self { return Err(terr_at(ln, cl, sp, "'Self' is only valid inside a trait declaration")) }
            if args.len() > 0 { return Err(terr_at(ln, cl, sp, "'Self' cannot take type arguments")) }
            return Ok(Type.TSelf)
        }
        if contains_str(self.type_params, name) {
            if args.len() > 0 { return Err(terr_at(ln, cl, sp, format("type parameter '{}' cannot take type arguments", name))) }
            return Ok(Type.TParam(name))
        }
        let si = self.struct_idx(name)
        let ei = self.enum_idx(name)
        if si >= 0 || ei >= 0 {
            var params: [str] = []
            if si >= 0 { params = self.structs[si].type_params } else { params = self.enums[ei].type_params }
            if params.len() > 0 || args.len() > 0 {
                if args.len() != params.len() { return Err(terr_at(ln, cl, sp, format("type '{}' expects {} type argument(s), got {}", name, params.len(), args.len()))) }
                let ra = self.resolve_list(args, visiting)?
                if si >= 0 && self.is_actor(name) { return Ok(Type.TActor(name, ra)) }
                if si >= 0 { return Ok(Type.TStruct(name, ra)) }
                return Ok(Type.TEnum(name, ra))
            }
            let none_args: [Type] = []
            if si >= 0 && self.is_actor(name) { return Ok(Type.TActor(name, none_args)) }
            if si >= 0 { return Ok(Type.TStruct(name, none_args)) }
            return Ok(Type.TEnum(name, none_args))
        }
        if args.len() > 0 { return Err(terr_at(ln, cl, sp, format("type '{}' is not generic (it takes no type arguments)", name))) }
        match prim_type(name) { Some(t) => { return Ok(t) }, None => {} }
        if self.alias_idx(name) >= 0 {
            match self.alias_cache_get(name) {
                Some(t) => {
                    if self.bodies && has_error(t) { return Err(poisoned()) }
                    return Ok(t)
                },
                None => {},
            }
            if contains_str(visiting, name) { return Err(terr_at(ln, cl, sp, format("type alias cycle involving '{}'", name))) }
            let ai = self.alias_idx(name)
            var v2 = visiting
            v2.push(name)
            let resolved = match self.resolve(self.aliases[ai].target, v2) {
                Ok(t) => t,
                Err(e) => {
                    // the alias is the error type from now on (MYLA-110)
                    if !is_poisoned(e) { self.alias_cache.push(AliasCached { name: name, ty: Type.TError }) }
                    return Err(e)
                },
            }
            self.alias_cache.push(AliasCached { name: name, ty: resolved })
            return Ok(resolved)
        }
        if name == "int" { return Ok(t_int()) }
        if name == "float" { return Ok(t_float()) }
        return Err(with_notes(terr_at(ln, cl, sp, format("unknown type '{}'", name)), did_you_mean(name, self.type_names())))
    }
}

// =========================================================================
// Global collection
// =========================================================================

impl Checker {
    #test(checker_on("[int]"))[Ok(0)]
    fun collect_globals(var self) -> Result<int32, CheckErr> {
        var seen: [str: int32] = [:]       // name -> its first declaration's index
        // the prelude's declarations come first (check_program,
        // build_checker_decls); no note points at them
        let n_prelude = prelude(0).program.decls.len()
        var di = -1
        for decl in self.decls {
            di = di + 1
            self.cur_decl = decl.id
            let ln = decl.line
            let cl = decl.col
            let sp = decl.sp
            // a declaration that can't be collected is left out (MYLA-110)
            var fail: Option<CheckErr> = None
            let handled = match decl.kind {
                DeclKind.ImportDecl(p, items, alias, isp) => {
                    fail = Some(terr_at(ln, cl, sp, "imports need the module loader: this file was type-checked on its own (use 'myla check' or 'myla run')"))
                    true
                },
                DeclKind.ImplDecl(tg, m, tp, tn, ta, dattrs) => { self.impl_decls.push(decl)
            true },
                DeclKind.TraitDecl(n, m, tp, isp, dattrs) => {
                    if is_builtin_op_trait(n) { fail = Some(terr_at(ln, cl, sp, format("'{}' is a built-in operator trait and cannot be redeclared", n))) }
                    else { for td in self.trait_decls { if decl_kind_name(td) == n { fail = Some(terr_at(ln, cl, sp, format("duplicate trait '{}'", n))) } } }
                    match fail { Some(x) => {}, None => { self.trait_decls.push(decl) } }
                    true
                },
                _ => false,
            }
            if !handled {
                let name = decl_kind_name(decl)
                if is_builtin_func(name) {
                    self.redefined[name] = true
                    fail = Some(terr_at(ln, cl, sp, format("cannot redefine builtin '{}'", name)))
                } else if seen.contains(name) {
                    let fi = seen[name]
                    let first = self.decls[fi]
                    var notes: [Note] = []
                    if fi >= n_prelude { notes = [note_at(format("'{}' is first declared here", name), first.line, first.col, first.sp)] }
                    fail = Some(with_notes(terr_at(ln, cl, sp, format("duplicate top-level declaration '{}'", name)), notes))
                } else {
                    seen[name] = di
                    fail = self.actor_fail(decl)
                    match fail { Some(x) => {}, None => { self.register_decl(decl) } }
                }
            }
            match fail {
                Some(e) => {
                    self.record(e)?
                    self.skipped_decls[di] = true
                },
                None => {},
            }
        }
        return Ok(0)
    }

    // An actor's declaration: why it can't be collected (D89), else none; the
    // actor recorded.
    #test(checker_on("[int]"), Decl { id: 1, line: 2, col: 1, sp: SrcSpan { sline: 2, scol: 1, eline: 2, ecol: 16 }, kind: DeclKind.TypeAliasDecl("A", TypeExpr { id: 0, line: 2, col: 15, sp: SrcSpan { sline: 2, scol: 15, eline: 2, ecol: 16 }, kind: TypeKind.TRef("B", []) }, [], false) })[None]
    fun actor_fail(var self, decl: Decl) -> Option<CheckErr> {
        match decl.kind {
            DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => {
                if !act { return None }
                if attrs.len() > 0 { return Some(terr_at(attrs[0].line, attrs[0].col, attrs[0].sp, "an actor can't have attributes")) }
                self.actors[n] = true
                self.met_concurrency(decl.line, decl.col, decl.sp, decl.id)
            },
            _ => {},
        }
        return None
    }

    // Add `decl` to the tables; its parts are resolved later.
    fun register_decl(var self, decl: Decl) {
        let ln = decl.line
        let cl = decl.col
        let sp = decl.sp
        match decl.kind {
            DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => { self.add_struct(StructInfo { name: n, type_params: tp_names(tps), fields: [], line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.EnumDecl(n, variants, attrs, tps, isp) => { self.add_enum(EnumInfo { name: n, type_params: tp_names(tps), variants: [], line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.TypeAliasDecl(n, target, attrs, isp) => { self.aliases.push(AliasRaw { name: n, target: target, line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.ConstDecl(n, ty, value, attrs, isp) => { self.const_decls.push(ConstDeclT { name: n, declared: ty, value: value, line: ln, col: cl, sp: sp, id: decl.id }) },
            DeclKind.FunDecl(fd) => { self.add_function(FuncSig { name: fd.name, params: [], ret: None, type_params: [], own_type_params: 0, bounds: [], decl: fd, has_decl: true, decl_id: decl.id }) },
            _ => {},
        }
    }

    // shadow built-in / duplicate type-parameter names
    #test(checker_on("[int]"), [], 7, 1, SrcSpan { sline: 7, scol: 1, eline: 9, ecol: 2 })[Ok(0)]
    fun check_type_params(self, tps: [str], ln: int32, cl: int32, sp: SrcSpan) -> Result<int32, CheckErr> {
        var seen: [str] = []
        for tp in tps {
            match prim_type(tp) { Some(x) => { return Err(terr_at(ln, cl, sp, format("type parameter '{}' shadows a built-in type name", tp))) }, None => {} }
            if tp == "int" { return Err(terr_at(ln, cl, sp, format("type parameter '{}' shadows a built-in type name", tp))) }
            if contains_str(seen, tp) { return Err(terr_at(ln, cl, sp, format("duplicate type parameter '{}'", tp))) }
            seen.push(tp)
        }
        return Ok(0)
    }

    // `te` resolved in a body, where a failed alias gives the error type
    // instead of poisoned() (types.py: _resolve_annotation).
    #test(checker_on("[int]"), TypeExpr { id: 45, line: 27, col: 12, sp: SrcSpan { sline: 27, scol: 12, eline: 27, ecol: 16 }, kind: TypeKind.TRef("char", []) })[Ok(Type.TChar)]
    fun resolve_annotation(var self, te: TypeExpr) -> Result<Type, CheckErr> {
        match self.resolve0(te) {
            Ok(t) => { return Ok(t) },
            Err(e) => { if !is_poisoned(e) { return Err(e) } },
        }
        return Ok(Type.TError)
    }

    #test(checker_on("[int]"), Param { line: 7, col: 14, sp: SrcSpan { sline: 7, scol: 14, eline: 7, ecol: 21 }, name: "c", ty: Some(TypeExpr { id: 8, line: 7, col: 17, sp: SrcSpan { sline: 7, scol: 17, eline: 7, ecol: 21 }, kind: TypeKind.TRef("char", []) }), default: None })[Ok(Type.TChar)]
    fun param_type(var self, p: Param) -> Result<Type, CheckErr> {
        return match p.ty {
            Some(te) => self.resolve0(te),
            None => Err(terr_at(p.line, p.col, p.sp, format("parameter '{}' needs a type", p.name))),   // unreachable: the parser requires one
        }
    }

    // The bounds of `tps`, a generic trait's arguments (`I: Iterator<T>`,
    // D171) resolved under the type parameters in force.
    #test(checker_on("[int]"), [])[Ok([])]
    #test(checker_on("[int]"), [TypeParam { line: 59, col: 14, sp: SrcSpan { sline: 59, scol: 14, eline: 59, ecol: 19 }, name: "T", bounds: ["Eq"], bound_args: [[]] }])[Ok([Bound { tp: "T", traits: ["Eq"], args: [[]] }])]
    #test(checker_on("[int]"), [TypeParam { line: 1, col: 5, sp: SrcSpan { sline: 1, scol: 5, eline: 1, ecol: 6 }, name: "I", bounds: ["Iterator", "Eq"], bound_args: [[type_expr_of("[str]")], []] }])[Ok([Bound { tp: "I", traits: ["Iterator", "Eq"], args: [[Type.TList(Type.TStr)], []] }])]
    fun bounds_of(var self, tps: [TypeParam]) -> Result<[Bound], CheckErr> {
        var out: [Bound] = []
        for tp in tps {
            if tp.bounds.len() == 0 { continue }
            var args: [[Type]] = []
            var i = 0
            while i < tp.bounds.len() {
                var ts: [Type] = []
                if i < tp.bound_args.len() { for a in tp.bound_args[i] { ts.push(self.resolve_part(a)?) } }
                args.push(ts)
                i += 1
            }
            out.push(Bound { tp: tp.name, traits: tp.bounds, args: args })
        }
        return Ok(out)
    }
}

#test([])[[]]
#test(["T"])[[TypeParam { line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, name: "T", bounds: [], bound_args: [] }]]
fun synth_typarams(names: [str]) -> [TypeParam] {
    var out: [TypeParam] = []
    for n in names { out.push(TypeParam { line: 0, col: 0, sp: no_span(), name: n, bounds: [], bound_args: [] }) }
    return out
}

// =========================================================================
// Signature resolution
// =========================================================================

impl Checker {
    #test(checker_on("[int]"))[Ok(0)]
    fun resolve_signatures(var self) -> Result<int32, CheckErr> {
        // aliases eagerly (catch cycles / bad targets even when unreferenced)
        // one that fails is the error type, and so is every alias naming it
        var ai = 0
        while ai < self.aliases.len() {
            let a = self.aliases[ai]
            self.cur_decl = a.id
            match self.alias_cache_get(a.name) {
                Some(t) => {},
                None => {
                    match self.resolve(a.target, [a.name]) {
                        Ok(t) => {},
                        Err(e) => {
                            self.record(e)?
                            self.alias_cache.push(AliasCached { name: a.name, ty: Type.TError })
                        },
                    }
                },
            }
            ai = ai + 1
        }
        // struct fields (under the struct's own type parameters)
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if self.skipped_decls.contains(pos) { continue }
            match decl.kind {
                DeclKind.StructDecl(n, fields, attrs, tps, isp, act) => {
                    self.cur_decl = decl.id
                    self.record_result(self.check_type_params(tp_names(tps), decl.line, decl.col, decl.sp))?
                    self.type_params = tp_names(tps)
                    var fs: [FieldT] = []
                    for f in fields {
                        // a duplicate field is left out, one of a bad type has the error type
                        var dup = false
                        for prev in fs { if prev.name == f.name { dup = true } }
                        if dup {
                            self.record(terr_at(f.line, f.col, f.sp, format("duplicate field '{}' in struct '{}'", f.name, n)))?
                            continue
                        }
                        let ft = self.resolve_part(f.ty)?
                        fs.push(FieldT { name: f.name, ty: ft })
                    }
                    self.type_params = []
                    let idx = self.struct_idx(n)
                    self.structs[idx] = StructInfo { name: n, type_params: tp_names(tps), fields: fs, line: decl.line, col: decl.col, sp: decl.sp, id: decl.id }
                },
                _ => {},
            }
        }
        // enum variants & payloads (under the enum's type parameters)
        pos = -1
        for decl in self.decls {
            pos = pos + 1
            if self.skipped_decls.contains(pos) { continue }
            match decl.kind {
                DeclKind.EnumDecl(n, variants, attrs, tps, isp) => {
                    self.cur_decl = decl.id
                    self.record_result(self.check_type_params(tp_names(tps), decl.line, decl.col, decl.sp))?
                    self.type_params = tp_names(tps)
                    var vs: [VariantT] = []
                    for v in variants {
                        var dup = false
                        for prev in vs { if prev.name == v.name { dup = true } }
                        if dup {
                            self.record(terr_at(v.line, v.col, v.sp, format("duplicate variant '{}' in enum '{}'", v.name, n)))?
                            continue
                        }
                        var payload: [Type] = []
                        for p in v.payload { payload.push(self.resolve_part(p)?) }
                        vs.push(VariantT { name: v.name, payload: payload })
                    }
                    self.type_params = []
                    let idx = self.enum_idx(n)
                    self.enums[idx] = EnumInfo { name: n, type_params: tp_names(tps), variants: vs, line: decl.line, col: decl.col, sp: decl.sp, id: decl.id }
                },
                _ => {},
            }
        }
        self.resolve_recursion()?
        // function signatures (under the function's own type parameters)
        pos = -1
        for decl in self.decls {
            pos = pos + 1
            if self.skipped_decls.contains(pos) { continue }
            match decl.kind {
                DeclKind.FunDecl(fd) => {
                    self.cur_decl = decl.id
                    self.record_result(self.check_type_params(tp_names(fd.type_params), fd.line, fd.col, fd.sp))?
                    self.type_params = tp_names(fd.type_params)
                    var ps: [Type] = []
                    for p in fd.params { ps.push(self.param_part(p)?) }
                    var rt: Option<Type> = None
                    match fd.ret_type { Some(te) => { rt = result_of(self.resolve_part(te)?) }, None => {} }
                    let bs = self.bounds_of(fd.type_params)?
                    self.type_params = []
                    let idx = self.func_idx(fd.name)
                    self.functions[idx] = FuncSig { name: fd.name, params: ps, ret: rt, type_params: tp_names(fd.type_params), own_type_params: fd.type_params.len(), bounds: bs, decl: fd, has_decl: true, decl_id: decl.id }
                },
                _ => {},
            }
        }
        return Ok(0)
    }
}

// =========================================================================
// Recursion classification (boxed enums vs unrepresentable cycles)
// =========================================================================

pub struct AggRef { name: str, is_enum: bool }

impl Checker {
    #test(checker_on("[int]"), "Adder")[[]]
    fun member_types(self, name: str) -> [Type] {
        let si = self.struct_idx(name)
        if si >= 0 {
            var out: [Type] = []
            for f in self.structs[si].fields { out.push(f.ty) }
            return out
        }
        let ei = self.enum_idx(name)
        var out2: [Type] = []
        if ei >= 0 {
            for v in self.enums[ei].variants { for p in v.payload { out2.push(p) } }
        }
        return out2
    }

    #test(checker_on("[int]"), "Adder", "Adder", ["Adder"], true)[false]
    fun find_cycle(self, root: str, current: str, seen: [str], stop_at_boxed: bool) -> bool {
        for m in self.member_types(current) {
            for ar in agg_refs(m) {
                if stop_at_boxed && ar.is_enum && contains_str(self.recursive_enums, ar.name) { continue }
                if ar.name == root { return true }
                if contains_str(seen, ar.name) { continue }
                var s2 = seen
                s2.push(ar.name)
                if self.find_cycle(root, ar.name, s2, stop_at_boxed) { return true }
            }
        }
        return false
    }

    #test(checker_on("[int]"))[Ok(0)]
    fun resolve_recursion(var self) -> Result<int32, CheckErr> {
        for e in self.enums {
            if self.find_cycle(e.name, e.name, [e.name], false) {
                if !contains_str(self.recursive_enums, e.name) { self.recursive_enums.push(e.name) }
            }
        }
        for e in self.enums {
            if self.find_cycle(e.name, e.name, [e.name], true) {
                self.cur_decl = e.id
                self.record(terr_at(e.line, e.col, e.sp, format("recursive enum '{}' would have infinite size; only enums can be recursive (they are boxed) — wrap the cycle in an enum to introduce indirection", e.name)))?
            }
        }
        for s in self.structs {
            if self.find_cycle(s.name, s.name, [s.name], true) {
                self.cur_decl = s.id
                self.record(terr_at(s.line, s.col, s.sp, format("recursive struct '{}' would have infinite size; only enums can be recursive (they are boxed) — wrap the cycle in an enum to introduce indirection", s.name)))?
            }
        }
        return Ok(0)
    }
}

#test(Type.TStr)[[]]
#test(Type.TStruct("Bare", []))[[AggRef { name: "Bare", is_enum: false }]]
#test(Type.TStruct("Clock", []))[[AggRef { name: "Clock", is_enum: false }]]
fun agg_refs(t: Type) -> [AggRef] {
    var out: [AggRef] = []
    match t {
        Type.TStruct(n, args) => { out.push(AggRef { name: n, is_enum: false })
            for a in args { for r in agg_refs(a) { out.push(r) } } },
        Type.TEnum(n, args) => { out.push(AggRef { name: n, is_enum: true })
            for a in args { for r in agg_refs(a) { out.push(r) } } },
        Type.TTuple(es) => { for e in es { for r in agg_refs(e) { out.push(r) } } },
        _ => {},
    }
    return out
}

// =========================================================================
// Traits
// =========================================================================

impl Checker {
    fun register_builtin_op_traits(var self) {
        self.traits.push(TraitInfo { name: "Add", methods: [TraitMethodSig { name: "add", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        self.traits.push(TraitInfo { name: "Sub", methods: [TraitMethodSig { name: "sub", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        self.traits.push(TraitInfo { name: "Mul", methods: [TraitMethodSig { name: "mul", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        self.traits.push(TraitInfo { name: "Div", methods: [TraitMethodSig { name: "div", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        self.traits.push(TraitInfo { name: "Rem", methods: [TraitMethodSig { name: "rem", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TSelf), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        self.traits.push(TraitInfo { name: "Eq", methods: [TraitMethodSig { name: "eq", params: [Type.TSelf, Type.TSelf], ret: Some(Type.TBool), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
        self.traits.push(TraitInfo { name: "Ord", methods: [TraitMethodSig { name: "cmp", params: [Type.TSelf, Type.TSelf], ret: Some(t_int()), receiver: "self" }], type_params: [], builtin: true, line: 0, col: 0 })
    }

    #test(checker_on("[int]"))[Ok(0)]
    fun resolve_traits(var self) -> Result<int32, CheckErr> {
        self.register_builtin_op_traits()
        for decl in self.trait_decls {
            self.cur_decl = decl.id
            match decl.kind {
                DeclKind.TraitDecl(name, methods, tps, isp, dattrs) => {
                    // check trait type params: no Self, no dup
                    var seen: [str] = []
                    var tp_fail: Option<CheckErr> = None
                    for p in tps {
                        match tp_fail {
                            Some(x) => {},
                            None => {
                                if p.name == "Self" { tp_fail = Some(terr_at(decl.line, decl.col, decl.sp, format("trait '{}' cannot use 'Self' as a type parameter", name))) }
                                else if contains_str(seen, p.name) { tp_fail = Some(terr_at(decl.line, decl.col, decl.sp, format("duplicate type parameter '{}' on trait '{}'", p.name, name))) }
                                seen.push(p.name)
                            },
                        }
                    }
                    match tp_fail { Some(e) => { self.record(e)? }, None => {} }
                    var msigs: [TraitMethodSig] = []
                    for m in methods {
                        // a call through a bound can't know an implementation's
                        // defaults, so a trait's methods have none (D136)
                        for p in m.params {
                            match p.default {
                                Some(d) => { self.record(terr_at(d.line, d.col, d.sp, format("the methods of a trait can't have default values (parameter '{}' of '{}.{}')", p.name, name, m.name)))? },
                                None => {},
                            }
                        }
                        var dup = false
                        for prev in msigs { if prev.name == m.name { dup = true } }
                        if dup {
                            self.record(terr_at(m.line, m.col, m.sp, format("duplicate method '{}' in trait '{}'", m.name, name)))?
                            continue
                        }
                        if m.is_async {
                            self.record(terr_at(m.line, m.col, m.sp, "a trait method can't be async"))?
                            continue
                        }
                        self.allow_self = true
                        self.type_params = tp_names(tps)
                        // a function without `self` (D172, receiver ""): its
                        // parameters only
                        let recv = match m.receiver { Some(r) => r, None => "" }
                        var params: [Type] = []
                        if recv != "" { params.push(Type.TSelf) }
                        for p in m.params { params.push(self.param_part(p)?) }
                        var rt: Option<Type> = None
                        match m.ret_type { Some(te) => { rt = result_of(self.resolve_part(te)?) }, None => {} }
                        self.allow_self = false
                        self.type_params = []
                        msigs.push(TraitMethodSig { name: m.name, params: params, ret: rt, receiver: recv })
                    }
                    self.traits.push(TraitInfo { name: name, methods: msigs, type_params: tp_names(tps), builtin: false, line: decl.line, col: decl.col })
                },
                _ => {},
            }
        }
        return Ok(0)
    }
}

#test(Type.TStr, Type.TStruct("Size", []), [])[Type.TStr]
#test(Type.TSelf, Type.TStruct("Size", []), [])[Type.TStruct("Size", [])]
#test(Type.TSelf, Type.TStruct("Money", []), [Subst { name: "T", ty: Type.TInt(32, true) }])[Type.TStruct("Money", [])]
#test(Type.TActor("Cell", [Type.TSelf]), Type.TStr, [])[Type.TActor("Cell", [Type.TStr])]
fun subst_self(t: Type, target: Type, pmap: [Subst]) -> Type {
    return match t {
        Type.TSelf => target,
        Type.TParam(n) => match subst_get(pmap, n) { Some(x) => x, None => t },
        Type.TList(e) => Type.TList(subst_self(e, target, pmap)),
        Type.TMap(k, v) => Type.TMap(subst_self(k, target, pmap), subst_self(v, target, pmap)),
        Type.TTuple(es) => {
            var o: [Type] = []
            for e in es { o.push(subst_self(e, target, pmap)) }
            Type.TTuple(o)
        },
        Type.TFunc(ps, r) => {
            var o: [Type] = []
            for p in ps { o.push(subst_self(p, target, pmap)) }
            Type.TFunc(o, match r { Some(rt) => Some(subst_self(rt, target, pmap)), None => None })
        },
        Type.TAsync(f) => Type.TAsync(subst_self(f, target, pmap)),
        Type.TStruct(n, a) => {
            var o: [Type] = []
            for x in a { o.push(subst_self(x, target, pmap)) }
            Type.TStruct(n, o)
        },
        Type.TEnum(n, a) => {
            var o: [Type] = []
            for x in a { o.push(subst_self(x, target, pmap)) }
            Type.TEnum(n, o)
        },
        Type.TActor(n, a) => {
            var o: [Type] = []
            for x in a { o.push(subst_self(x, target, pmap)) }
            Type.TActor(n, o)
        },
        _ => t,
    }
}

#test(Some(Type.TStr), Type.TStruct("Size", []), [])[Some(Type.TStr)]
#test(Some(Type.TSelf), Type.TStruct("Vec2", []), [])[Some(Type.TStruct("Vec2", []))]
#test(Some(Type.TParam("S")), Type.TInt(32, true), [Subst { name: "S", ty: Type.TEnum("ErrorCode", []) }])[Some(Type.TEnum("ErrorCode", []))]
fun opt_subst_self(t: Option<Type>, target: Type, pmap: [Subst]) -> Option<Type> {
    return match t { Some(x) => Some(subst_self(x, target, pmap)), None => None }
}

// =========================================================================
// Impl blocks & methods
// =========================================================================

impl Checker {
    #test(checker_on("[int]"))[Ok(0)]
    fun resolve_impls(var self) -> Result<int32, CheckErr> {
        for decl in self.impl_decls {
            self.cur_decl = decl.id
            match decl.kind {
                DeclKind.ImplDecl(target_te, methods, tps, trait_name, trait_args_te, dattrs) => {
                    self.impl_allows = allow_attrs(dattrs)
                    let r = self.resolve_impl(decl, target_te, methods, tps, trait_name, trait_args_te)
                    self.impl_allows = []
                    r?
                },
                _ => {},
            }
        }
        return Ok(0)
    }

    // One `impl`, its errors collected as it goes (MYLA-110; types.py:
    // _resolve_impl): an impl whose target can't be resolved, can't have
    // methods, or repeats a trait impl is left out; one of an unknown trait
    // keeps its methods; one that doesn't conform leaves the pair broken.
    fun resolve_impl(var self, decl: Decl, target_te: TypeExpr, methods: [FunData], tps: [TypeParam], trait_name: Option<str>, trait_args_te: [TypeExpr]) -> Result<int32, CheckErr> {
        let ln = decl.line
        let cl = decl.col
        let sp = decl.sp
        self.record_result(self.check_type_params(tp_names(tps), ln, cl, sp))?
        self.type_params = tp_names(tps)
        let target = self.resolve_part(target_te)?
        var trait_args: [Type] = []
        for a in trait_args_te { trait_args.push(self.resolve_part(a)?) }
        // what a type of the target must meet to have the trait (MYLA-379);
        // a bound that doesn't resolve has its error with the methods
        let ibounds = match self.bounds_of(tps) {
            Ok(bs) => bs,
            Err(x) => [],
        }
        self.type_params = []
        var key_opt: Option<str> = None
        var target_ok = !has_error(target)
        if target_ok {
            let k0 = match self.type_key(target) { Some(k) => k, None => "" }
            let has_trait = match trait_name { Some(tn) => true, None => false }
            if has_trait && self.is_actor(k0) {
                // a trait's methods are called without `await` (D89)
                self.record(terr_at(ln, cl, sp, "an actor can't implement a trait"))?
                self.lose_impl(methods, trait_name)
                return Ok(0)
            }
        }
        if target_ok {
            // a builtin method's name is the builtin's on its kind: a program
            // can't define it there, as it can't a builtin function (the
            // review of 2026-11-06, R3: the program's `len` was called by the
            // standard library's own code, natively)
            for m in methods {
                if builtin_method(target, m.name) {
                    self.record(terr_at(m.line, m.col, m.sp, format("'{}' is a builtin method of '{}': an impl can't define it", m.name, type_name(target))))?
                    self.lose_impl(methods, trait_name)
                    return Ok(0)
                }
            }
            key_opt = self.type_key(target)
            match self.check_impl_target(ln, cl, sp, target, key_opt, tps, methods) {
                Ok(x) => {},
                Err(e) => {
                    self.record(e)?
                    target_ok = false
                },
            }
        }
        if !target_ok {
            match key_opt {
                Some(k) => {},
                None => {
                    self.lose_impl(methods, trait_name)
                    return Ok(0)
                },
            }
        }
        let key = match key_opt { Some(k) => k, None => "" }
        // trait binding
        var have_trait = false
        var conforms = true
        var pmap: [Subst] = []
        var tinfo = TraitInfo { name: "", methods: [], type_params: [], builtin: false, line: 0, col: 0 }
        match trait_name {
            Some(tn) => {
                let ti = self.trait_idx(tn)
                if ti < 0 {
                    self.record(terr_at(ln, cl, sp, format("unknown trait '{}' in 'impl {} for {}'", tn, tn, key)))?
                } else {
                    tinfo = self.traits[ti]
                    have_trait = true
                    if trait_args.len() != tinfo.type_params.len() {
                        var expected = tn
                        if tinfo.type_params.len() > 0 { expected = format("{}<{}>", tn, join_strs(tinfo.type_params, ", ")) }
                        self.record(terr_at(ln, cl, sp, format("trait '{}' expects {} type argument(s), got {} (use 'impl {} for {}')", tn, tinfo.type_params.len(), trait_args.len(), expected, key)))?
                        conforms = false
                    } else {
                        var pi = 0
                        while pi < tinfo.type_params.len() {
                            pmap.push(Subst { name: tinfo.type_params[pi], ty: trait_args[pi] })
                            pi = pi + 1
                        }
                    }
                    var dup = false
                    for p in self.user_trait_impls { if p.trait_name == tn && p.key == key { dup = true } }
                    if dup {
                        self.record(terr_at(ln, cl, sp, format("duplicate impl of trait '{}' for type '{}' (at most one user impl per trait/type pair)", tn, key)))?
                        return Ok(0)
                    }
                    self.user_trait_impls.push(TraitImplPair { trait_name: tn, key: key })
                    // what a bound naming the trait with arguments compares
                    // and solves (D171)
                    if conforms && trait_args.len() > 0 { self.impl_args[tn + "\t" + key] = ImplArgs { target: target, args: trait_args } }
                }
            },
            None => {},
        }
        // a method may share a field's name, `x.name` being the field and
        // `x.name(…)` the method, unless the field holds a function, which
        // `x.name(…)` calls (MYLA-406)
        var fun_fields: [str] = []
        let si = self.struct_idx(key)
        if si >= 0 { for f in self.structs[si].fields { if is_tfunc_type(f.ty) { fun_fields.push(f.name) } } }
        for m in methods {
            // a method that can't be added is left out, body and all
            var bad: Option<CheckErr> = None
            match self.method_sig(key, m.name) { Some(x) => { bad = Some(self.duplicate_method(m, key, x)) }, None => {} }
            match bad {
                Some(x) => {},
                None => { if contains_str(fun_fields, m.name) { bad = Some(with_notes(terr_at(m.line, m.col, m.sp, format("method '{}' has the name of a field of '{}' that holds a function: a call '.{}(…)' would mean either", m.name, key, m.name)), [Note { label: "help", msg: "rename the method or the field; a field that holds no function may share a method's name", line: 0, col: 0, sp: no_span() }])) } },
            }
            // a function without `self` (D172) is a trait's: called as
            // `P.f()`, which a variant's name would take
            let no_self = match m.receiver { Some(r) => false, None => true }
            match bad {
                Some(x) => {},
                None => {
                    if no_self && match trait_name { Some(tn) => false, None => true } { bad = Some(self.inherent_function(m, key)) }
                    else if no_self && self.enum_has_variant(key, m.name) { bad = Some(terr_at(m.line, m.col, m.sp, format("function '{}' collides with a variant of '{}': '{}.{}()' would build the variant", m.name, key, key, m.name))) }
                },
            }
            match bad {
                Some(e) => { self.record(e)? },
                None => { self.register_method(target_te, key, tps, m, decl.id)? },
            }
        }
        if have_trait {
            if conforms {
                var impl_names: [str] = []
                for m in methods { impl_names.push(m.name) }
                match self.check_trait_conformance(ln, cl, sp, key, target, tinfo, pmap, impl_names) {
                    Ok(ok) => { conforms = ok },
                    Err(e) => {
                        self.record(e)?
                        conforms = false
                    },
                }
            }
            match trait_name {
                Some(tn) => {
                    if !conforms { self.broken_impls[tn + "\t" + key] = true }
                    self.trait_impls.push(TraitImplPair { trait_name: tn, key: key })
                    if ibounds.len() > 0 { self.impl_bounds[tn + "\t" + key] = ImplBounds { target: target, bounds: ibounds } }
                },
                None => {},
            }
        }
        return Ok(0)
    }

    // The error of a method `m` that `key` has already, as `first`: with a
    // note naming the standard library's module and place when the first
    // one is its, as a method of the modules every program sees is
    // (MYLA-320; a note's place is in the error's file, so this one's is in
    // its message).
    fun duplicate_method(self, m: FunData, key: str, first: FuncSig) -> CheckErr {
        let e = terr_at(m.line, m.col, m.sp, format("duplicate method '{}' for type '{}'", m.name, key))
        return match self.std_impls.get(first.decl_id) {
            Some(o) => {
                var module = o.module
                if o.implicit { module = module + ", which every program sees," }
                let place = format("{}:{}:{}", o.path, first.decl.line, first.decl.col)
                with_notes(e, [note_at(format("'{}' for '{}' is first defined in {} at {}", m.name, key, module, place), 0, 0, no_span())])
            },
            None => e,
        }
    }

    // The error of a function without `self` in an impl of no trait: only a
    // trait's functions go without one (D172), a type has no static methods.
    #test(checker_on("[int]"), fun_of("fun f() { print(1) }"), "P")[CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 21 }, msg: "function 'f' in 'impl P' has no 'self': only a trait's functions go without one", decl: -1, notes: [Note { label: "help", msg: "write a free function 'fun f(…)', or declare it in a trait and implement that for 'P'", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }] }]
    fun inherent_function(self, m: FunData, key: str) -> CheckErr {
        let e = terr_at(m.line, m.col, m.sp, format("function '{}' in 'impl {}' has no 'self': only a trait's functions go without one", m.name, key))
        return with_notes(e, [Note { label: "help", msg: format("write a free function 'fun {}(…)', or declare it in a trait and implement that for '{}'", m.name, key), line: 0, col: 0, sp: no_span() }])
    }

    // Leave out an impl whose type is unknown: a missing method or trait impl
    // of its names ends a check silently (MYLA-110).
    fun lose_impl(var self, methods: [FunData], trait_name: Option<str>) {
        for m in methods { self.lost_methods[m.name] = true }
        match trait_name { Some(tn) => { self.lost_traits[tn] = true }, None => {} }
    }

    // Whether an impl may add methods to `target` (types.py: _check_impl_target).
    fun check_impl_target(self, ln: int32, cl: int32, sp: SrcSpan, target: Type, key_opt: Option<str>, tps: [TypeParam], methods: [FunData]) -> Result<int32, CheckErr> {
        let is_agg = match target { Type.TStruct(n, a) => true, Type.TEnum(n, a) => true, Type.TActor(n, a) => true, _ => false }
        if is_agg {
            let targs = match target { Type.TStruct(n, a) => a, Type.TEnum(n, a) => a, Type.TActor(n, a) => a, _ => empty_types() }
            if tps.len() > 0 {
                var want: [Type] = []
                for p in tps { want.push(Type.TParam(p.name)) }
                if !type_list_eq(targs, want) { return Err(terr_at(ln, cl, sp, format("a generic impl must apply to '{}<{}>' with its type parameters in order", key_or_none(key_opt), join_strs(tp_names(tps), ", ")))) }
            } else {
                if targs.len() > 0 { return Err(terr_at(ln, cl, sp, format("cannot 'impl' on a concrete generic instantiation; write 'impl<T> {}<T> {{ ... }}' to cover every instance", key_or_none(key_opt)))) }
            }
            return Ok(0)
        }
        match key_opt {
            Some(k) => {
                // generic ones on lists and maps, their parameters bound by the
                // receiver's type (MYLA-221)
                let generic_ok = match target { Type.TList(e) => true, Type.TMap(kt, vt) => true, _ => false }
                if tps.len() > 0 && !generic_ok { return Err(terr_at(ln, cl, sp, "generic impls on built-in types are only for lists and maps")) }
            },
            None => { return Err(terr_at(ln, cl, sp, format("cannot 'impl' on type '{}': an impl takes structs, enums, and concrete scalar / str / StringBuilder receivers", type_name(target)))) },
        }
        return Ok(0)
    }

    #test(checker_on("struct P { x: int, y: int }"), type_expr_of("[str]"), "Name", [], fun_of("fun g() { print(1) }"), 60)[Ok(0)]
    fun register_method(var self, target_te: TypeExpr, key: str, impl_tps: [TypeParam], m: FunData, impl_id: int32) -> Result<int32, CheckErr> {
        let mangled = format("{}.{}", key, m.name)
        var combined_names: [str] = []
        for t in impl_tps { combined_names.push(t.name) }
        for t in m.type_params { combined_names.push(t.name) }
        self.record_result(self.check_type_params(combined_names, m.line, m.col, m.sp))?
        self.type_params = combined_names
        let combined_bounds = merge_bounds(self.bounds_of(impl_tps)?, self.bounds_of(m.type_params)?)
        let self_t = self.resolve_part(target_te)?
        // a function without `self` (D172) takes its parameters only; the
        // type it is called on is its impl's target, which solves the impl's
        // type parameters
        let has_self = match m.receiver { Some(r) => true, None => false }
        var params: [Type] = []
        if has_self { params.push(self_t) } else { self.static_selfs[mangled] = self_t }
        for p in m.params { params.push(self.param_part(p)?) }
        var rt: Option<Type> = None
        match m.ret_type { Some(te) => { rt = result_of(self.resolve_part(te)?) }, None => {} }
        self.type_params = []
        // synthesize a self parameter so the body checker binds `self`
        var sparams: [Param] = []
        if has_self { sparams.push(Param { line: m.line, col: m.col, sp: no_span(), name: "self", ty: Some(target_te), default: None }) }
        for p in m.params { sparams.push(p) }
        let fdecl = FunData {
            line: m.line, col: m.col, sp: m.sp, name: mangled, params: sparams,
            ret_type: m.ret_type, body: m.body, attributes: m.attributes,
            type_params: synth_typarams(combined_names), receiver: m.receiver, is_pub: false, is_async: m.is_async,
        }
        let sig = FuncSig { name: mangled, params: params, ret: rt, type_params: combined_names, own_type_params: m.type_params.len(), bounds: combined_bounds, decl: fdecl, has_decl: true, decl_id: impl_id }
        self.add_function(sig)
        self.add_method(MethodEntry { key: key, name: m.name, sig: sig })
        self.method_decls.push(fdecl)
        self.method_decl_keys.push(key)
        self.method_decl_ids.push(impl_id)
        self.method_decl_allows.push(self.impl_allows)
        return Ok(0)
    }

    // Ok(false): a method that failed earlier couldn't be compared (MYLA-110).
    #test(checker_on("[int]"), 11, 1, SrcSpan { sline: 11, scol: 1, eline: 15, ecol: 2 }, "Sq", Type.TStruct("Sq", []), TraitInfo { name: "Shape", methods: [TraitMethodSig { name: "area", params: [Type.TSelf], ret: Some(Type.TError), receiver: "self" }], type_params: [], builtin: false, line: 5, col: 1 }, [], ["area"])[Ok(false)]
    fun check_trait_conformance(var self, ln: int32, cl: int32, sp: SrcSpan, key: str, target: Type, trinfo: TraitInfo, pmap: [Subst], impl_names: [str]) -> Result<bool, CheckErr> {
        // missing: trait methods not provided by this impl
        var missing: [str] = []
        for tm in trinfo.methods {
            if !contains_str(impl_names, tm.name) && !contains_str(missing, tm.name) { missing.push(tm.name) }
        }
        if missing.len() > 0 {
            return Err(terr_at(ln, cl, sp, format("impl of trait '{}' for '{}' is missing method(s): {}", trinfo.name, key, join_strs(sorted_strs(missing), ", "))))
        }
        // extra: impl methods not declared by the trait
        var extra: [str] = []
        for nm in impl_names {
            var in_trait = false
            for tm in trinfo.methods { if tm.name == nm { in_trait = true } }
            if !in_trait && !contains_str(extra, nm) { extra.push(nm) }
        }
        if extra.len() > 0 {
            return Err(terr_at(ln, cl, sp, format("impl of trait '{}' for '{}' declares method(s) not in the trait: {}", trinfo.name, key, join_strs(sorted_strs(extra), ", "))))
        }
        var broken = false
        for tm in trinfo.methods {
            let sig_opt = self.method_sig(key, tm.name)
            if match sig_opt { Some(x) => false, None => true } {
                broken = true          // left out (MYLA-110)
                continue
            }
            let sig = match sig_opt { Some(x) => x, None => { return Ok(false) } }
            let recv = match sig.decl.receiver { Some(r) => r, None => "" }
            if recv != tm.receiver {
                // a function without `self` (D172) on one side
                if recv == "" { return Err(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("'{}' in impl of trait '{}' for '{}' has no receiver but the trait declares '{}'", tm.name, trinfo.name, key, tm.receiver))) }
                if tm.receiver == "" { return Err(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("method '{}' in impl of trait '{}' for '{}' has receiver '{}' but the trait declares a function without 'self'", tm.name, trinfo.name, key, recv))) }
                return Err(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("method '{}' in impl of trait '{}' for '{}' has receiver '{}' but the trait declares '{}'", tm.name, trinfo.name, key, recv, tm.receiver)))
            }
            var exp_params: [Type] = []
            for p in tm.params { exp_params.push(subst_self(p, target, pmap)) }
            let exp_ret = opt_subst_self(tm.ret, target, pmap)
            if sig_has_error(exp_params, exp_ret) || sig_has_error(sig.params, sig.ret) {
                broken = true          // one side failed and had its error: no comparison
                continue
            }
            if !type_list_eq(sig.params, exp_params) || !opt_type_eq(sig.ret, exp_ret) {
                var rest: [Type] = []
                var k = if tm.receiver == "" { 0 } else { 1 }
                while k < exp_params.len() {
                    rest.push(exp_params[k])
                    k = k + 1
                }
                return Err(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("method '{}' in impl of trait '{}' for '{}' does not match the trait signature (expected '({}) -> {}')", tm.name, trinfo.name, key, type_names(rest), opt_type_name(exp_ret))))
            }
        }
        return Ok(!broken)
    }

    // A bad bound is left out, so calls don't check it, and the function's
    // body, which may rely on it, isn't checked (MYLA-110).
    #test(checker_on("[int]"))[Ok(0)]
    fun validate_bounds(var self) -> Result<int32, CheckErr> {
        var fi = 0
        while fi < self.functions.len() {
            let sig = self.functions[fi]
            self.cur_decl = sig.decl_id
            var kept: [Bound] = []
            var changed = false
            for b in sig.bounds {
                if !contains_str(sig.type_params, b.tp) {
                    self.record(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("bound on unknown type parameter '{}'", b.tp)))?
                    changed = true
                    continue
                }
                var good: [str] = []
                var good_args: [[Type]] = []
                var j = 0
                while j < b.traits.len() {
                    let tr = b.traits[j]
                    let args = b.args[j]
                    j += 1
                    let ti = self.trait_idx(tr)
                    if ti < 0 {
                        self.record(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, format("unknown trait '{}' in bound '{}: {}'", tr, b.tp, tr)))?
                        changed = true
                        continue
                    }
                    // a generic trait takes its arguments, as in an impl (D171)
                    let want = self.traits[ti].type_params
                    if args.len() != want.len() {
                        self.record(terr_at(sig.decl.line, sig.decl.col, sig.decl.sp, bound_arity_msg(b.tp, tr, want, args)))?
                        changed = true
                        continue
                    }
                    good.push(tr)
                    good_args.push(args)
                }
                kept.push(Bound { tp: b.tp, traits: good, args: good_args })
            }
            if changed { self.skipped_fns[sig.name] = true }
            if changed {
                var s2 = sig
                s2.bounds = kept
                self.functions[fi] = s2
                // a method's entry has its own copy of the signature
                var mi = 0
                while mi < self.methods.len() {
                    if self.methods[mi].sig.name == sig.name {
                        var m2 = self.methods[mi]
                        m2.sig = s2
                        self.methods[mi] = m2
                    }
                    mi = mi + 1
                }
            }
            fi = fi + 1
        }
        return Ok(0)
    }
}

// A method key as Python's f-strings print it (`None` for no key).
#test(Some("Box"))["Box"]
fun key_or_none(k: Option<str>) -> str {
    return match k { Some(x) => x, None => "None" }
}

// The error of a bound naming the trait `tr`, whose type parameters are
// `want`, with the arguments `args` (D171).
#test("I", "Iterator", ["T"], [])["trait 'Iterator' expects 1 type argument(s) in the bound 'I: Iterator', got 0 (write 'I: Iterator<T>')"]
#test("T", "Eq", [], [Type.TStr])["trait 'Eq' expects 0 type argument(s) in the bound 'T: Eq<str>', got 1 (write 'T: Eq')"]
fun bound_arity_msg(tp: str, tr: str, want: [str], args: [Type]) -> str {
    var expected = tr
    if want.len() > 0 { expected = format("{}<{}>", tr, join_strs(want, ", ")) }
    return format("trait '{}' expects {} type argument(s) in the bound '{}: {}', got {} (write '{}: {}')", tr, want.len(), tp, generic_name(tr, args), args.len(), tp, expected)
}

// The arguments of the generic trait `trnm` as `t`, whose type key is `key`,
// implements it (D55, D171): its impl's, the impl's type parameters solved by
// `t`; None without one. The code generator's too, on the instances' types.
#test([:], "C", "Iterator", Type.TStruct("C", []))[None]
#test(["Iterator\tL": ImplArgs { target: Type.TStruct("L", [Type.TParam("T")]), args: [Type.TTuple([Type.TParam("T"), Type.TStr])] }], "L", "Iterator", Type.TStruct("L", [Type.TChar]))[Some([Type.TTuple([Type.TChar, Type.TStr])])]
pub fun impl_trait_args(impls: [str: ImplArgs], key: str, trnm: str, t: Type) -> Option<[Type]> {
    return match impls.get(trnm + "\t" + key) {
        Some(ia) => Some(subst_type_list(ia.args, unify_param(ia.target, t, []).subst)),
        None => None,
    }
}

#test([], [])[[]]
fun merge_bounds(a: [Bound], b: [Bound]) -> [Bound] {
    var out: [Bound] = []
    for x in a { out.push(x) }
    for y in b { out.push(y) }
    return out
}

#test([FieldT { name: "x", ty: Type.TInt(32, true) }], "nope")[None]
#test([FieldT { name: "x", ty: Type.TInt(32, true) }, FieldT { name: "c", ty: Type.TError }], "c")[Some(Type.TError)]
#test([FieldT { name: "f", ty: Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true))) }], "f")[Some(Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true))))]
fun field_type_get(fields: [FieldT], name: str) -> Option<Type> {
    for f in fields { if f.name == name { return Some(f.ty) } }
    return None
}

// =========================================================================
// Aggregate-instance helpers
// =========================================================================

impl Checker {
    #test(checker_on("[int]"), "Name", [])[[]]
    fun struct_field_types(self, name: str, args: [Type]) -> [FieldT] {
        let si = self.struct_idx(name)
        if si < 0 { return [] }
        let info = self.structs[si]
        if info.type_params.len() == 0 { return info.fields }
        var subst: [Subst] = []
        var i = 0
        while i < info.type_params.len() { subst.push(Subst { name: info.type_params[i], ty: args[i] })
            i = i + 1 }
        var out: [FieldT] = []
        for f in info.fields { out.push(FieldT { name: f.name, ty: subst_type(f.ty, subst) }) }
        return out
    }
    #test(checker_on("[int]"), "Shape", [], "Rect")[None]
    fun enum_variant_payload(self, name: str, args: [Type], variant: str) -> Option<[Type]> {
        let ei = self.enum_idx(name)
        if ei < 0 { return None }
        let info = self.enums[ei]
        var found = false
        var payload: [Type] = []
        for v in info.variants { if v.name == variant { found = true
            payload = v.payload } }
        if !found { return None }
        if info.type_params.len() == 0 { return Some(payload) }
        if args.len() < info.type_params.len() { return Some(payload) }
        var subst: [Subst] = []
        var i = 0
        while i < info.type_params.len() { subst.push(Subst { name: info.type_params[i], ty: args[i] })
            i = i + 1 }
        return Some(subst_type_list(payload, subst))
    }
    #test(checker_on("[int]"), "List")[[]]
    fun enum_variant_names(self, name: str) -> [str] {
        let ei = self.enum_idx(name)
        var out: [str] = []
        if ei >= 0 { for v in self.enums[ei].variants { out.push(v.name) } }
        return out
    }
    #test(checker_on("[int]"), "Color", "Red")[false]
    fun enum_has_variant(self, name: str, variant: str) -> bool {
        return contains_str(self.enum_variant_names(name), variant)
    }
    // a bare no-payload variant name of enum `name`?
    #test(checker_on("[int]"), "C", "A")[false]
    fun is_novpayload_variant(self, name: str, variant: str) -> bool {
        return match self.enum_variant_payload(name, [], variant) {
            Some(p) => p.len() == 0,
            None => false,
        }
    }
    #test(checker_on("[int]"), Expr { id: 56, line: 36, col: 23, sp: SrcSpan { sline: 36, scol: 23, eline: 36, ecol: 24 }, kind: ExprKind.Name("a") })[None]
    fun enum_name_ref(self, e: Expr) -> Option<str> {
        match e.kind {
            ExprKind.Name(n) => {
                // the table first: a scope's walk costs more
                if !self.is_enum(n) { return None }
                let shadowed = match self.lookup(n) { Some(x) => true, None => false }
                if !shadowed { return Some(n) }
            },
            _ => {},
        }
        return None
    }
}

// =========================================================================
// Expression typing
// =========================================================================

impl Checker {
    #test(checker_on("[int]"), Expr { id: 0, line: 5, col: 7, sp: SrcSpan { sline: 5, scol: 7, eline: 5, ecol: 8 }, kind: ExprKind.IntLit(1, None, false, "") }, Some(Type.TInt(32, true)))[Ok(Type.TInt(32, true))]
    fun expect_value(var self, e: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        return match self.infer(e, expected)? {
            Some(t) => Ok(t),
            None => {
                // a call of a function without a result: the value `()` (D140)
                if !is_call_expr(e) { return Err(terr_at(e.line, e.col, e.sp, "expression does not produce a value")) }
                self.resolved[e.id] = Type.TTuple([])
                Ok(Type.TTuple([]))
            },
        }
    }

    // `e` must have type `want`; `ctx` names it in the message ("if condition").
    #test(checker_on("[int]"), Expr { id: 104, line: 49, col: 10, sp: SrcSpan { sline: 49, scol: 10, eline: 49, ecol: 13 }, kind: ExprKind.IntLit(120, None, true, "") }, Type.TChar, "map key")[Ok(0)]
    fun expect_type(var self, e: Expr, want: Type, ctx: str) -> Result<int32, CheckErr> {
        let t = self.expect_value(e, Some(want))?
        if !type_eq(t, want) { return Err(terr_at(e.line, e.col, e.sp, format("{} must be '{}', found '{}'", ctx, type_name(want), type_name(t)))) }
        return Ok(0)
    }

    // `e`'s type; poisoned() where it contains the error type, since what uses
    // the value depends on a declaration that failed (MYLA-110).
    #test(checker_on("[int]"), Expr { id: 0, line: 5, col: 7, sp: SrcSpan { sline: 5, scol: 7, eline: 5, ecol: 8 }, kind: ExprKind.IntLit(1, None, false, "") }, Some(Type.TInt(32, true)))[Ok(Some(Type.TInt(32, true)))]
    fun infer(var self, e: Expr, expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        let r = self.infer_node(e, expected)?
        if opt_has_error(r) { return Err(poisoned()) }
        return Ok(r)
    }

    #test(checker_on("[int]"), Expr { id: 0, line: 5, col: 7, sp: SrcSpan { sline: 5, scol: 7, eline: 5, ecol: 8 }, kind: ExprKind.IntLit(1, None, false, "") }, Some(Type.TInt(32, true)))[Ok(Some(Type.TInt(32, true)))]
    fun infer_node(var self, e: Expr, expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        let as_stmt = self.stmt_match
        self.stmt_match = false
        let r: Result<Option<Type>, CheckErr> = match e.kind {
            ExprKind.IntLit(v, suf, isc, big) => Ok(Some(self.infer_int_lit(e, expected)?)),
            ExprKind.FloatLit(lex, suf) => Ok(Some(self.infer_float_lit(e, expected)?)),
            ExprKind.StrLit(s) => Ok(Some(Type.TStr)),
            ExprKind.BoolLit(b) => Ok(Some(Type.TBool)),
            ExprKind.Name(n) => Ok(Some(self.infer_name(e, n, expected)?)),
            ExprKind.Unary(op, x) => Ok(Some(self.infer_unary(e, op, x, expected)?)),
            ExprKind.Binary(op, l, r) => Ok(Some(self.infer_binary(e, op, l, r, expected)?)),
            ExprKind.Call(c, args, targs) => {
                self.call_kind_id = -1
                let rc = self.infer_call(e, c, args, expected)
                // explicit type arguments a generic function or method didn't
                // take (D169): a builtin's, a variant's, a function value's
                if targs.len() > 0 && self.targs_taken != e.id && is_ok_call(rc) { return Err(not_generic(e, callee_words(c))) }
                // a call that may suspend stands under `await` (D89); marked
                // calls succeeded
                if self.call_kind_id == e.id && (self.call_async || self.actors.len() > 0) { self.check_suspension(e, c)? }
                rc
            },
            ExprKind.GetField(t, name) => Ok(Some(self.infer_field(e, t, name, expected)?)),
            ExprKind.StructLit(name, fields) => Ok(Some(self.infer_struct_lit(e, name, fields, expected)?)),
            ExprKind.TupleLit(elems) => Ok(Some(self.infer_tuple_lit(e, elems, expected)?)),
            ExprKind.TupleIndex(t, idx) => Ok(Some(self.infer_tuple_index(e, t, idx)?)),
            ExprKind.ListLit(elems) => Ok(Some(self.infer_list_lit(e, elems, expected)?)),
            ExprKind.MapLit(entries) => Ok(Some(self.infer_map_lit(e, entries, expected)?)),
            ExprKind.Index(t, i) => Ok(Some(self.infer_index(e, t, i)?)),
            ExprKind.MatchE(s, arms) => self.infer_match(e, s, arms, expected, as_stmt),
            ExprKind.Try(x) => {
                if self.defer_at >= 0 { return Err(terr_at(e.line, e.col, e.sp, "a deferred block can't use '?': it runs as its block ends")) }
                Ok(Some(self.infer_try(e, x, expected)?))
            },
            ExprKind.Cast(x, ty) => Ok(Some(self.infer_cast(e, x, ty)?)),
            ExprKind.Lambda(ps, ret, body, asy) => Ok(Some(self.infer_lambda(e, ps, ret, body, asy, expected)?)),
            ExprKind.Await(x) => {
                if self.defer_at >= 0 { return Err(terr_at(e.line, e.col, e.sp, "a deferred block can't 'await': it runs as its block ends, without suspending")) }
                self.infer_await(e, x, expected)
            },
            ExprKind.Hole => Err(terr_at(e.line, e.col, e.sp, "'_' placeholder is only valid as a call argument")),
        }
        match r { Ok(om) => { self.record_type(e.id, om) }, Err(x) => {} }
        return r
    }

    fun record_type(var self, id: int32, ot: Option<Type>) {
        match ot { Some(t) => { self.resolved[id] = t }, None => {} }
    }

    #test(checker_on("[int]"), Expr { id: 0, line: 5, col: 7, sp: SrcSpan { sline: 5, scol: 7, eline: 5, ecol: 8 }, kind: ExprKind.IntLit(1, None, false, "") }, Some(Type.TInt(32, true)))[Ok(Type.TInt(32, true))]
    fun infer_int_lit(var self, e: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        return match e.kind {
            ExprKind.IntLit(v, suf, isc, big) => {
                var t = t_int()
                if isc {
                    let useint = match expected { Some(et) => is_int(et) && v <= 127, None => false }
                    if useint { t = match expected { Some(et) => et, None => t_int() } } else { return Ok(Type.TChar) }
                } else {
                    match suf {
                        Some(sx) => {
                            t = match int_suffix_type(sx) {
                                Some(st) => st,
                                None => { return Err(terr_at(e.line, e.col, e.sp, format("invalid integer literal suffix '{}'", sx))) },   // unreachable: the lexer checks it
                            }
                        },
                        None => {
                            t = int_lit_expected_default(expected, t)
                        },
                    }
                }
                let w = match t { Type.TInt(ww, ss) => ww, _ => 32 }
                let sg = match t { Type.TInt(ww, ss) => ss, _ => true }
                if !lit_fits(v, big, w, sg, self.neg_lit == e.id) { return Err(terr_at(e.line, e.col, e.sp, format("integer literal {} does not fit in '{}'", int_text(v, big), type_name(t)))) }
                // recorded here too: a literal typed again by its context
                // (the other operand, an argument) keeps the type it gets,
                // which the lowering reads (MYLA-358)
                self.record_type(e.id, Some(t))
                Ok(t)
            },
            _ => Err(terr_at(e.line, e.col, e.sp, "expected an integer literal")),   // unreachable
        }
    }

    #test(checker_on("[int]"), Expr { id: 12, line: 6, col: 15, sp: SrcSpan { sline: 6, scol: 15, eline: 6, ecol: 21 }, kind: ExprKind.FloatLit("0.0f64", Some("f64")) }, None)[Ok(Type.TFloat(64))]
    fun infer_float_lit(var self, e: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        match e.kind {
            ExprKind.FloatLit(lex, suf) => {
                match suf {
                    Some(sx) => {
                        return match float_suffix_type(sx) {
                            Some(ft) => Ok(ft),
                            None => Err(terr_at(e.line, e.col, e.sp, format("invalid float literal suffix '{}'", sx))),   // unreachable: the lexer checks it
                        }
                    },
                    None => {},
                }
                // recorded here too, as an integer literal is (MYLA-358)
                match expected {
                    Some(et) => {
                        if is_float(et) {
                            self.record_type(e.id, Some(et))
                            return Ok(et)
                        }
                    },
                    None => {},
                }
                self.record_type(e.id, Some(t_float()))
                return Ok(t_float())
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, "expected a float literal"))   // unreachable
    }

    #test(checker_on("[int]"), Expr { id: 52, line: 4, col: 17, sp: SrcSpan { sline: 4, scol: 17, eline: 4, ecol: 18 }, kind: ExprKind.Name("m") }, "m", None)[Err(CheckErr { line: 4, col: 17, sp: SrcSpan { sline: 4, scol: 17, eline: 4, ecol: 18 }, msg: "unknown name 'm'", decl: -1, notes: [] })]
    fun infer_name(var self, e: Expr, ident: str, expected: Option<Type>) -> Result<Type, CheckErr> {
        if ident == "_" { return Err(terr_at(e.line, e.col, e.sp, "'_' placeholder is only valid as a call argument")) }
        match self.lookup(ident) {
            Some(b) => {
                if b.task > 0 { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is the result of a child task: read it with 'await {}'", ident, ident))) }
                if self.lams.len() > 0 && self.actor_self != "" && ident == "self" {
                    // types.py: _record_capture
                    let d = self.lookup_frame(ident)
                    for lam in self.lams {
                        if d < lam.base { return Err(terr_at(lam.line, lam.col, lam.sp, format("a lambda can't capture the actor '{}''s 'self': its state stays with its own methods", self.actor_self))) }
                    }
                }
                return Ok(b.ty)
            },
            None => {},
        }
        if self.const_decl_idx(ident) >= 0 {
            return self.ensure_const(ident)
        }
        match prelude_variant_enum(ident) {
            Some(en) => { return self.infer_bare_variant(e, en, ident, expected) },
            None => {},
        }
        // D96: the compiler takes its calls; as a value it would do nothing
        if self.is_task_cancel(ident) { return Err(terr_at(e.line, e.col, e.sp, "task.cancel can only be called, with the name of an 'async let'")) }
        if self.func_idx(ident) >= 0 {
            // a non-method top-level function referenced as a value
            self.called[ident] = true
            return self.infer_fun_value(e, ident)
        }
        if self.redefined.contains(ident) { return Err(poisoned()) }
        if is_builtin_func(ident) { return Err(terr_at(e.line, e.col, e.sp, format("'{}' cannot be used as a value here", ident))) }
        return Err(with_notes(terr_at(e.line, e.col, e.sp, format("unknown name '{}'", ident)), did_you_mean(ident, self.value_names())))
    }

    fun infer_fun_value(self, e: Expr, ident: str) -> Result<Type, CheckErr> {
        let idx = self.func_idx(ident)
        let sig = self.functions[idx]
        if sig.type_params.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("generic function '{}' cannot be used as a value (its type parameters are unresolved)", ident))) }
        return Ok(func_type(sig.params, sig.ret, sig.decl.is_async))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "Option", "None", None)[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "enum 'Option' has no variant 'None'", decl: -1, notes: [] })]
    fun infer_bare_variant(var self, e: Expr, enum_name: str, variant: str, expected: Option<Type>) -> Result<Type, CheckErr> {
        let payload = match self.enum_variant_payload(enum_name, [], variant) { Some(p) => p, None => { return Err(terr_at(e.line, e.col, e.sp, format("enum '{}' has no variant '{}'", enum_name, variant))) } }
        if payload.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("variant '{}' carries a payload; call it like '{}(...)'", variant, variant))) }
        let ei = self.enum_idx(enum_name)
        let nparams = self.enums[ei].type_params.len()
        match expected {
            Some(et) => { if enum_type_matches(et, enum_name, nparams) { return Ok(et) } },
            None => {},
        }
        if self.open_at == e.id { return Ok(Type.TEnum(enum_name, holes(nparams))) }   // MYLA-401
        return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type argument(s) for '{}'; annotate the binding (e.g. ': {}<...>')", variant, enum_name)))
    }

    #test(checker_on("fun f(n: int) -> int { return n * 2 }"), expr_of("1 + 2 * 3"), "-", expr_of("1 + 2 * 3"), None)[Ok(Type.TInt(32, true))]
    fun infer_unary(var self, e: Expr, op: str, x: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        if op == "-" {
            let hint = num_hint(expected)
            // the magnitude one past the signed maximum fits only here
            let saved_neg = self.neg_lit
            match x.kind { ExprKind.IntLit(v, suf, isc, big) => { self.neg_lit = x.id }, _ => {} }
            let tr = self.expect_value(x, hint)
            self.neg_lit = saved_neg
            let t = tr?
            if !(is_int(t) || is_float(t)) { return Err(terr_at(e.line, e.col, e.sp, "unary '-' requires a numeric operand")) }
            // a negative literal fits no unsigned type (L5)
            match x.kind {
                ExprKind.IntLit(v, suf, isc, big) => {
                    if !isc && (v != 0 || big != "") && !is_signed_int(t) { return Err(terr_at(e.line, e.col, e.sp, format("integer literal -{} does not fit in '{}'", int_text(v, big), type_name(t)))) }
                },
                _ => {},
            }
            return Ok(t)
        }
        if op == "!" {
            self.expect_type(x, Type.TBool, "operand of '!'")?
            return Ok(Type.TBool)
        }
        if op == "~" {
            let hint = int_hint(expected)
            let t = self.expect_value(x, hint)?
            if !is_int(t) { return Err(terr_at(e.line, e.col, e.sp, "unary '~' requires an integer")) }
            return Ok(t)
        }
        return Err(terr_at(e.line, e.col, e.sp, format("unknown unary operator '{}'", op)))
    }

    #test(checker_on("fun f(n: int) -> int { return n * 2 }"), expr_of("1 + 2 * 3"), expr_of("1 + 2 * 3"), type_expr_of("int"))[Ok(Type.TInt(32, true))]
    fun infer_cast(var self, e: Expr, x: Expr, ty: TypeExpr) -> Result<Type, CheckErr> {
        let target = self.resolve0(ty)?
        let src = self.expect_value(x, None)?
        let src_ok = is_int(src) || is_float(src) || is_char(src)
        let tgt_ok = is_int(target) || is_float(target) || is_char(target)
        if !src_ok || !tgt_ok { return Err(terr_at(e.line, e.col, e.sp, format("cannot cast from '{}' to '{}' ('as' converts between numeric and char types only)", type_name(src), type_name(target)))) }
        if (is_char(src) && is_float(target)) || (is_float(src) && is_char(target)) {
            return Err(terr_at(e.line, e.col, e.sp, "cannot cast directly between 'char' and a float (go through an integer type)"))
        }
        return Ok(target)
    }

    #test(checker_on("[int]"), Expr { id: 10, line: 8, col: 12, sp: SrcSpan { sline: 8, scol: 12, eline: 8, ecol: 13 }, kind: ExprKind.Name("c") }, Type.TChar, Expr { id: 11, line: 8, col: 17, sp: SrcSpan { sline: 8, scol: 17, eline: 8, ecol: 20 }, kind: ExprKind.IntLit(97, None, true, "") }, Type.TChar)[Ok(Type.TChar)]
    fun unify(var self, ln: Expr, lt0: Type, rn: Expr, rt0: Type) -> Result<Type, CheckErr> {
        var lt = lt0
        var rt = rt0
        if type_eq(lt, rt) { return Ok(lt) }
        if is_int(rt) && is_flexible_char_lit(ln) && int_lit_value(ln) <= 127 {
            lt = self.infer_int_lit(ln, Some(rt))?
        } else {
            if is_int(lt) && is_flexible_char_lit(rn) && int_lit_value(rn) <= 127 {
                rt = self.infer_int_lit(rn, Some(lt))?
            }
        }
        if type_eq(lt, rt) { return Ok(lt) }
        if is_int(lt) && is_int(rt) {
            if is_flexible_int_lit(ln) { lt = self.infer_int_lit(ln, Some(rt))? }
            else { if is_flexible_int_lit(rn) { rt = self.infer_int_lit(rn, Some(lt))? } }
            if type_eq(lt, rt) { return Ok(lt) }
        }
        if is_float(lt) && is_float(rt) {
            if is_flexible_float_lit(ln) { lt = self.infer_float_lit(ln, Some(rt))? }
            else { if is_flexible_float_lit(rn) { rt = self.infer_float_lit(rn, Some(lt))? } }
            if type_eq(lt, rt) { return Ok(lt) }
        }
        return Err(terr_at(ln.line, ln.col, ln.sp, format("type mismatch: '{}' vs '{}' (no implicit conversion between numeric types)", type_name(lt), type_name(rt))))
    }

    // A slice's bounds and step: integers, a bound possibly `^n` (D142).
    fun check_slice(var self, ix: Expr) -> Result<int32, CheckErr> {
        let p = slice_parts(ix)
        for b in [p.start, p.stop] {
            if !is_hole_part(b) {
                var v = b
                match from_end_of(b) { Some(n) => { v = n }, None => {} }
                let bt = self.expect_value(v, Some(t_int()))?
                if !is_int(bt) { return Err(terr_at(v.line, v.col, v.sp, format("a slice's bounds and step are integers, found '{}'", type_name(bt)))) }
                self.resolved[b.id] = bt
            }
        }
        if !is_hole_part(p.step) {
            match from_end_of(p.step) {
                Some(n) => { return Err(terr_at(p.step.line, p.step.col, p.step.sp, "a slice's step is a plain integer: '^' counts from the end only in a bound")) },
                None => {},
            }
            let st = self.expect_value(p.step, Some(t_int()))?
            if !is_int(st) { return Err(terr_at(p.step.line, p.step.col, p.step.sp, format("a slice's bounds and step are integers, found '{}'", type_name(st)))) }
        }
        return Ok(0)
    }

    #test(checker_on("fun f(n: int) -> int { return n * 2 }"), expr_of("1 + 2 * 3"), "==", expr_of("1 + 2 * 3"), expr_of("1 + 2 * 3"), None)[Ok(Type.TBool)]
    fun infer_binary(var self, e: Expr, op: str, l: Expr, r: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        if op == "&&" || op == "||" {
            self.expect_type(l, Type.TBool, format("operand of '{}'", op))?
            self.expect_type(r, Type.TBool, format("operand of '{}'", op))?
            return Ok(Type.TBool)
        }
        if op == "==" || op == "!=" {
            if self.other_side_first(l) && !self.other_side_first(r) {
                // `None == opt`, `Ok(1) == res`: the left side typed by the
                // right one (MYLA-379)
                let rt0 = self.expect_value(r, None)?
                let lt0 = self.expect_value(l, Some(rt0))?
                if is_struct_or_enum(lt0) { return self.infer_overload_known(e, op, l, r, lt0, Some(rt0)) }
                if !type_eq(lt0, rt0) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires both operands to have the same type, found '{}' and '{}'", op, type_name(lt0), type_name(rt0)))) }
                return Ok(Type.TBool)
            }
            let lt = self.expect_value(l, None)?
            if is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
            if is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
            var hint: Option<Type> = None
            if is_int(lt) || is_float(lt) { hint = Some(lt) }
            // a tuple's or list's literal takes the left side's type
            if is_compound_eq(lt) { hint = Some(lt) }
            let rt = self.expect_value(r, hint)?
            let common = self.unify(l, lt, r, rt)?
            if is_compound_eq(common) {
                // a tuple or list of `Eq` elements (D163, MYLA-313)
                self.prelude_need(common)
                if self.type_implements(common, "Eq")? { return Ok(Type.TBool) }
                return Err(terr_at(e.line, e.col, e.sp, format("cannot compare values of type '{}': {}", type_name(common), self.not_eq_why(common))))
            }
            if !(is_int(common) || is_float(common) || is_char(common) || is_bool(common) || is_str(common) || is_unit(common)) {
                return Err(terr_at(e.line, e.col, e.sp, format("cannot compare values of type '{}'", type_name(common))))
            }
            return Ok(Type.TBool)
        }
        if op == "<" || op == "<=" || op == ">" || op == ">=" {
            let lt = self.expect_value(l, None)?
            if is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
            if is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
            var hint: Option<Type> = None
            if is_int(lt) || is_float(lt) { hint = Some(lt) }
            let rt = self.expect_value(r, hint)?
            let common = self.unify(l, lt, r, rt)?
            // strings byte by byte, as list_dir sorts them (MYLA-318)
            if !(is_int(common) || is_float(common) || is_char(common) || is_str(common)) { return Err(terr_at(e.line, e.col, e.sp, "comparison requires numeric or char operands")) }
            return Ok(Type.TBool)
        }
        if op == "<<" || op == ">>" {
            let hint = int_hint(expected)
            let lt = self.expect_value(l, hint)?
            if op == ">>" {
                if is_tfunc_type(lt) { return self.infer_compose(e, lt, r) }
            }
            if !is_int(lt) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires an integer left operand", op))) }
            let rt = self.expect_value(r, None)?
            if !is_int(rt) { return Err(terr_at(r.line, r.col, r.sp, format("shift amount for '{}' must be an integer", op))) }
            match const_int(r) {
                Some(amt) => {
                    let w = int_width(lt)
                    if !(amt >= 0 && amt < (w as int64)) { return Err(terr_at(r.line, r.col, r.sp, format("shift amount {} is out of range for '{}' (valid range is 0..{})", amt, type_name(lt), w - 1))) }
                },
                None => {},
            }
            return Ok(lt)
        }
        if op == "+" {
            let hint = num_hint(expected)
            let lt = self.expect_value(l, hint)?
            if is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
            if is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
            if is_str(lt) {
                let rt = self.expect_value(r, None)?
                if !is_str(rt) { return Err(terr_at(e.line, e.col, e.sp, format("cannot concatenate 'str' with '{}'", type_name(rt)))) }
                return Ok(Type.TStr)
            }
            var hint2: Option<Type> = None
            if is_int(lt) || is_float(lt) { hint2 = Some(lt) }
            let rt = self.expect_value(r, hint2)?
            match self.char_arith(e, op, l, lt, rt)? { Some(t) => { return Ok(t) }, None => {} }
            let common = self.unify(l, lt, r, rt)?
            if !(is_int(common) || is_float(common)) { return Err(terr_at(e.line, e.col, e.sp, "operator '+' requires numeric or string operands")) }
            return Ok(common)
        }
        // arithmetic & bitwise: - * / %  and  & | ^
        let hint = num_hint(expected)
        let lt = self.expect_value(l, hint)?
        if is_arith_op(op) && is_struct_or_enum(lt) { return self.infer_operator_overload(e, op, l, r, lt) }
        if is_arith_op(op) && is_type_param(lt) { return self.infer_bounded_op(e, op, l, r, lt) }
        var hint2 = hint
        if is_int(lt) || is_float(lt) { hint2 = Some(lt) }
        // what a char is moved by or measured from isn't the context's type
        if is_char(lt) { hint2 = None }
        let rt = self.expect_value(r, hint2)?
        if op == "-" {
            match self.char_arith(e, op, l, lt, rt)? { Some(t) => { return Ok(t) }, None => {} }
        }
        let common = self.unify(l, lt, r, rt)?
        if is_float(common) {
            if !is_arith_op(op) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' is not defined for floats", op))) }
            return Ok(common)
        }
        if !is_int(common) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires integer operands", op))) }
        return Ok(common)
    }

    // `c - d` on two chars, their distance, an `int32`; `c + n` and `c - n`
    // with `n` an `int32`, `c` moved by `n`, a char (checked to be one when
    // it runs, as a cast to char is). None for any other operands, which
    // `unify` takes: a char literal before another integer type adapts to
    // it (`'0' + d` with `d: uint8`), anything else is a mismatch (D4, no
    // implicit mixing; MYLA-318).
    #test(checker_on("[int]"), expr_of("c - d"), "-", expr_of("c"), Type.TChar, Type.TChar)[Ok(Some(Type.TInt(32, true)))]
    #test(checker_on("[int]"), expr_of("c + 1"), "+", expr_of("c"), Type.TChar, Type.TInt(32, true))[Ok(Some(Type.TChar))]
    #test(checker_on("[int]"), expr_of("'0' + b"), "+", expr_of("'0'"), Type.TChar, Type.TInt(8, false))[Ok(None)]
    #test(checker_on("[int]"), expr_of("n - 1"), "-", expr_of("n"), Type.TInt(32, true), Type.TInt(32, true))[Ok(None)]
    fun char_arith(var self, e: Expr, op: str, l: Expr, lt: Type, rt: Type) -> Result<Option<Type>, CheckErr> {
        if !is_char(lt) { return Ok(None) }
        if is_char(rt) {
            if op == "-" { return Ok(Some(t_int())) }
            return Err(terr_at(e.line, e.col, e.sp, "operator '+' can't add two chars: 'c - d' is their distance (an 'int32'), 'c + n' moves 'c' by the 'int32' 'n'"))
        }
        if type_eq(rt, t_int()) { return Ok(Some(Type.TChar)) }
        if is_int(rt) && !(is_flexible_char_lit(l) && int_lit_value(l) <= 127) {
            return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' moves a char by an 'int32', found '{}' (convert it with 'as int32')", op, type_name(rt))))
        }
        return Ok(None)
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "+", expr_of("a.b[0]"), expr_of("a.b[0]"), Type.TStruct("Vec2", []))[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "operator '+' is not defined for 'Vec2': it needs 'impl Add for Vec2'", decl: -1, notes: [] })]
    fun infer_operator_overload(var self, e: Expr, op: str, l: Expr, r: Expr, lt: Type) -> Result<Type, CheckErr> {
        return self.infer_overload_known(e, op, l, r, lt, None)
    }

    // `infer_operator_overload`, the right side's type `known_rt` when it
    // was inferred first (`None == opt`).
    fun infer_overload_known(var self, e: Expr, op: str, l: Expr, r: Expr, lt: Type, known_rt: Option<Type>) -> Result<Type, CheckErr> {
        var trnm = ""
        var kind = ""
        if op == "==" || op == "!=" { trnm = "Eq"
            kind = "eq"
            self.prelude_need(lt) }
        else { if op == "<" || op == "<=" || op == ">" || op == ">=" { trnm = "Ord"
            kind = "ord" }
        else { trnm = match arith_trait(op) { Some(t) => t, None => "" }
            kind = "arith" } }
        if !self.type_implements(lt, trnm)? {
            // its generic impl's bound unmet: why its argument isn't (MYLA-379)
            match self.failing_arg(lt, trnm) {
                Some(ct) => { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' is not defined for '{}': {}", op, type_name(lt), self.not_trait_why(ct.0, ct.1)))) },
                None => {},
            }
            return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' is not defined for '{}': it needs 'impl {} for {}'{}", op, type_name(lt), trnm, type_name(lt), if_str(trnm == "Eq", " (or '#derive(Eq)')", ""))))
        }
        // the left side's type for the right one's, `opt == None` (MYLA-379)
        let rt = match known_rt {
            Some(t) => t,
            None => self.expect_value(r, Some(lt))?,
        }
        if !type_eq(lt, rt) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires both operands to have the same type, found '{}' and '{}'", op, type_name(lt), type_name(rt)))) }
        if kind == "arith" {
            // arith trait method returns Self == lt (enforced by conformance)
            let k = match self.type_key(lt) { Some(x) => x, None => "" }
            match self.method_sig(k, arith_method(op)) {
                Some(sig) => {
                    // a generic impl's result in the receiver's arguments,
                    // `Box<int> + Box<int>` a `Box<int>` (M2)
                    return match sig.ret {
                        Some(rr) => Ok(subst_type(rr, unify_param(sig.params[0], lt, []).subst)),
                        None => Ok(lt),
                    }
                },
                None => { return Ok(lt) },
            }
        }
        return Ok(Type.TBool)
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "+", expr_of("a.b[0]"), expr_of("a.b[0]"), Type.TParam("T"))[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "operator '+' on a value of type parameter 'T' requires the bound 'T: Add'", decl: -1, notes: [] })]
    fun infer_bounded_op(var self, e: Expr, op: str, l: Expr, r: Expr, lt: Type) -> Result<Type, CheckErr> {
        var trnm = ""
        var result = lt
        if op == "==" || op == "!=" { trnm = "Eq"
            result = Type.TBool }
        else { if op == "<" || op == "<=" || op == ">" || op == ">=" { trnm = "Ord"
            result = Type.TBool }
        else { trnm = match arith_trait(op) { Some(t) => t, None => "" }
            result = lt } }
        let pname = match lt { Type.TParam(n) => n, _ => "" }
        if !self.bound_has(pname, trnm) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' on a value of type parameter '{}' requires the bound '{}: {}'", op, pname, pname, trnm))) }
        let rt = self.expect_value(r, None)?
        if !type_eq(lt, rt) { return Err(terr_at(e.line, e.col, e.sp, format("operator '{}' requires both operands to have the same type, found '{}' and '{}'", op, type_name(lt), type_name(rt)))) }
        return Ok(result)
    }

    // Why the tuple or list type `t` isn't `Eq`: the first element type that
    // isn't, as the message after "cannot compare values of type …" says it.
    #test(checker_on("[int]"), Type.TTuple([Type.TInt(32, true), Type.TStruct("P", [])]))["'P' isn't Eq (it needs 'impl Eq for P' or '#derive(Eq)')"]
    #test(checker_on("[int]"), Type.TList(Type.TMap(Type.TStr, Type.TStr)))["'[str: str]' isn't Eq"]
    fun not_eq_why(self, t: Type) -> str {
        return self.not_trait_why(t, "Eq")
    }

    // The key type `kt` of a map type met at `ln`, `cl` (D163, MYLA-313): an
    // integer, `char`, `bool` or `str`, or any type that is `Eq` and `Hash`;
    // one with a type parameter by the bounds of the function it is in (a
    // struct's field's isn't checked until a function uses it). Met before
    // the impls are known, it waits for `check_pending_keys`.
    fun check_key(var self, kt: Type, ln: int32, cl: int32, sp: SrcSpan) -> Result<int32, CheckErr> {
        self.prelude_need(kt)
        if !self.keys_ready && !is_map_key(kt) && !contains_type_param(kt) && !has_error(kt) {
            self.pending_keys.push(PendingKey { t: kt, line: ln, col: cl, sp: sp, decl: self.cur_decl })
            return Ok(0)
        }
        return self.key_ok(kt, ln, cl, sp)
    }

    // The prelude's derived `Eq` and `Hash` of `Option` and `Result` (D182)
    // are called once a type `t` that holds one is compared or hashed: by
    // `==`, as a map's key, a bound's argument, a member of a derived `Eq`,
    // a tuple's `hash`. Their bodies wait until then (`lazy_prelude`), as
    // they and std.hash's methods they call would cost a hello world's check
    // 1.4 %; the runners call them only there.
    fun prelude_need(var self, t: Type) {
        if !self.prelude_needed && holds_prelude_enum(t) {
            for m in ["Option.eq", "Result.eq", "Option.hash", "Result.hash"] { self.called[m] = true }
            self.prelude_needed = true
        }
    }

    // The derived impl added last waits (`prelude_need`) if it is the
    // prelude's `Option`'s or `Result`'s.
    fun prelude_waits(var self, name: str) {
        if (name == "Option" || name == "Result") && !self.prelude_needed { self.lazy_prelude[self.decls[self.decls.len() - 1].id] = true }
    }

    // `prelude_need` of the members of the struct or enum `name`.
    fun members_need(var self, name: str) {
        let si = self.struct_idx(name)
        if si >= 0 { for f in self.structs[si].fields { self.prelude_need(f.ty) } }
        let ei = self.enum_idx(name)
        if ei >= 0 { for v in self.enums[ei].variants { for pt in v.payload { self.prelude_need(pt) } } }
    }

    // `prelude_need` of the types a generic call's substitution gives.
    fun prelude_need_all(var self, subst: [Subst]) {
        if !self.prelude_needed { for sb in subst { self.prelude_need(sb.ty) } }
    }

    // `check_key` once the impls are known.
    fun key_ok(self, kt: Type, ln: int32, cl: int32, sp: SrcSpan) -> Result<int32, CheckErr> {
        if is_map_key(kt) || has_error(kt) { return Ok(0) }
        if contains_type_param(kt) {
            // (a signature's own map keys imply their bounds, see
            // `validate_bounds`)
            if !self.key_ctx { return Ok(0) }
        }
        let why = self.key_why(kt)?
        if why == "" { return Ok(0) }
        return Err(terr_at(ln, cl, sp, format("map key type must be Eq and Hash, found '{}': {}", type_name(kt), why)))
    }

    // Why `kt` can't be a map's key ("" when it can).
    fun key_why(self, kt: Type) -> Result<str, CheckErr> {
        if !self.type_implements(kt, "Eq")? {
            match kt {
                Type.TParam(n) => { return Ok(format("it needs the bound '{}: Eq + Hash'", n)) },
                _ => { return Ok(self.not_trait_why(kt, "Eq")) },
            }
        }
        if !self.type_implements(kt, "Hash")? {
            match kt {
                Type.TParam(n) => { return Ok(format("it needs the bound '{}: Eq + Hash'", n)) },
                _ => { return Ok(self.not_trait_why(kt, "Hash")) },
            }
        }
        return Ok("")
    }

    // `check_key` of every map type in `t`.
    fun check_keys_in(var self, t: Type, ln: int32, cl: int32, sp: SrcSpan) -> Result<int32, CheckErr> {
        match t {
            Type.TMap(k, v) => {
                self.check_key(k, ln, cl, sp)?
                self.check_keys_in(k, ln, cl, sp)?
                self.check_keys_in(v, ln, cl, sp)?
            },
            Type.TList(e) => { self.check_keys_in(e, ln, cl, sp)? },
            Type.TTuple(es) => { for e in es { self.check_keys_in(e, ln, cl, sp)? } },
            Type.TStruct(n, a) => { for e in a { self.check_keys_in(e, ln, cl, sp)? } },
            Type.TActor(n, a) => { for e in a { self.check_keys_in(e, ln, cl, sp)? } },
            Type.TEnum(n, a) => { for e in a { self.check_keys_in(e, ln, cl, sp)? } },
            Type.TFunc(ps, r) => {
                for e in ps { self.check_keys_in(e, ln, cl, sp)? }
                match r {
                    Some(x) => { self.check_keys_in(x, ln, cl, sp)? },
                    None => {},
                }
            },
            _ => {},
        }
        return Ok(0)
    }

    // The map key types met before the impls were known, checked (D163).
    fun check_pending_keys(var self) -> Result<int32, CheckErr> {
        self.keys_ready = true
        let pending = self.pending_keys
        self.pending_keys = []
        for p in pending {
            self.cur_decl = p.decl
            match self.key_why(p.t) {
                Ok(why) => {
                    if why != "" { self.record(terr_at(p.line, p.col, p.sp, format("map key type must be Eq and Hash, found '{}': {}", type_name(p.t), why)))? }
                },
                Err(e) => { self.record(e)? },
            }
        }
        return Ok(0)
    }

    // `not_eq_why` for `Hash`: a float isn't, as NaN is unequal to itself.
    #test(checker_on("[int]"), Type.TTuple([Type.TInt(32, true), Type.TFloat(64)]))["'float64' isn't Hash (NaN is unequal to itself)"]
    fun not_hash_why(self, t: Type) -> str {
        return self.not_trait_why(t, "Hash")
    }

    // Why the tuple or list type `t` isn't `trnm` (`Eq` or `Hash`).
    fun not_trait_why(self, t: Type, trnm: str) -> str {
        var inner: [Type] = []
        match t {
            Type.TTuple(es) => { inner = es },
            Type.TList(et) => { inner = [et] },
            _ => { inner = [t] },
        }
        for et in inner {
            let ok = match self.type_implements(et, trnm) {
                Ok(b) => b,
                Err(x) => true,
            }
            if !ok {
                if is_compound_eq(et) { return self.not_trait_why(et, trnm) }
                match self.failing_arg(et, trnm) {
                    Some(ct) => { return self.not_trait_why(ct.0, ct.1) },
                    None => {},
                }
                if is_struct_or_enum(et) { return format("'{}' isn't {} (it needs 'impl {} for {}' or '#derive({})')", type_name(et), trnm, trnm, type_name(et), trnm) }
                if is_type_param(et) { return format("'{}' isn't {} (it needs the bound '{}: {}')", type_name(et), trnm, type_name(et), trnm) }
                if is_float(et) && trnm == "Hash" { return format("'{}' isn't Hash (NaN is unequal to itself)", type_name(et)) }
                return format("'{}' isn't {}", type_name(et), trnm)
            }
        }
        return format("its elements aren't {}", trnm)
    }

    // The argument of the struct or enum `t` that its generic impl of
    // `trnm` has a bound it doesn't meet, and that bound's trait (MYLA-379);
    // None for a type without that impl or whose arguments meet them.
    #test(checker_on("[int]"), Type.TStruct("Vec2", []), "Eq")[None]
    fun failing_arg(self, t: Type, trnm: str) -> Option<(Type, str)> {
        let k = match self.type_key(t) {
            Some(x) => x,
            None => { return None },
        }
        if !is_struct_or_enum(t) || !self.trait_implements_pair(k, trnm) { return None }
        return match self.impl_bound_failing(k, trnm, t) {
            Ok(x) => x,
            Err(x) => None,
        }
    }

    #test(checker_on("[int]"), "T", "Eq")[false]
    fun bound_has(self, pname: str, trnm: str) -> bool {
        for b in self.bounds_cur { if b.tp == pname { if contains_str(b.traits, trnm) { return true } } }
        return false
    }

    // The arguments of the generic trait `trnm` as `t` implements it: its
    // one impl's (D55), or a type parameter's bound's (D171); None when it
    // has neither.
    #test(checker_on("[int]"), Type.TParam("I"), "Iterator")[None]
    #test(checker_on("enum Option<T> { Some(T), None }\ntrait Iterator<T> {\n    fun next(var self) -> Option<T>\n}\nstruct C { n: int }\nimpl Iterator<int> for C {\n    fun next(var self) -> Option<int> { return None }\n}"), Type.TStruct("C", []), "Iterator")[Some([Type.TInt(32, true)])]
    #test(checker_on("enum Option<T> { Some(T), None }\ntrait Iterator<T> {\n    fun next(var self) -> Option<T>\n}\nstruct L<T> { xs: [T] }\nimpl<T> Iterator<T> for L<T> {\n    fun next(var self) -> Option<T> { return None }\n}"), Type.TStruct("L", [Type.TStr]), "Iterator")[Some([Type.TStr])]
    fun trait_args_of(self, t: Type, trnm: str) -> Option<[Type]> {
        match t {
            Type.TParam(pn) => {
                for b in self.bounds_cur {
                    if b.tp != pn { continue }
                    var j = 0
                    while j < b.traits.len() {
                        if b.traits[j] == trnm { return Some(b.args[j]) }
                        j += 1
                    }
                }
                return None
            },
            _ => {},
        }
        return match self.type_key(t) {
            Some(k) => impl_trait_args(self.impl_args, k, trnm, t),
            None => None,
        }
    }

    // `subst` and what the bounds fix once their type parameters are known:
    // `I: Iterator<T>` with `I` a type gives `T` by `I`'s one impl of the
    // trait (D55, D171). A disagreement is left to `check_call_bounds`.
    #test(checker_on("[int]"), [], [])[[]]
    #test(checker_on("enum Option<T> { Some(T), None }\ntrait Iterator<T> {\n    fun next(var self) -> Option<T>\n}\nstruct C { n: int }\nimpl Iterator<int> for C {\n    fun next(var self) -> Option<int> { return None }\n}"), [Bound { tp: "I", traits: ["Iterator"], args: [[Type.TParam("T")]] }], [Subst { name: "I", ty: Type.TStruct("C", []) }])[[Subst { name: "I", ty: Type.TStruct("C", []) }, Subst { name: "T", ty: Type.TInt(32, true) }]]
    fun solve_bounds(self, bounds: [Bound], subst: [Subst]) -> [Subst] {
        var s = subst
        for b in bounds {
            let known = subst_get(s, b.tp)
            if match known { Some(x) => false, None => true } { continue }
            let t = match known { Some(x) => x, None => Type.TError }
            var j = 0
            while j < b.traits.len() {
                if b.args[j].len() > 0 {
                    match self.trait_args_of(t, b.traits[j]) {
                        Some(have) => {
                            if have.len() == b.args[j].len() {
                                let r = unify_list(b.args[j], have, s)
                                if r.ok { s = r.subst }
                            }
                        },
                        None => {},
                    }
                }
                j += 1
            }
        }
        return s
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), Type.TFunc([Type.TInt(32, true)], Some(Type.TStr)), expr_of("a.b[0]"))[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun infer_compose(var self, e: Expr, lt: Type, r: Expr) -> Result<Type, CheckErr> {
        let lparams = func_params_of(lt)
        let lret: Option<Type> = func_ret_of(lt)
        if lparams.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, format("composition with '>>' needs a one-argument function on the left, found '{}'", type_name(lt)))) }
        let rt = self.expect_value(r, None)?
        match strip_async(rt) { Type.TFunc(ps, rr) => {}, _ => { return Err(terr_at(e.line, e.col, e.sp, format("cannot compose a function with a value of type '{}' (both operands of '>>' must be functions, or both integers)", type_name(rt)))) } }
        if is_async_func(lt) || is_async_func(rt) { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be composed with '>>'")) }
        let rparams = func_params_of(rt)
        let rret: Option<Type> = func_ret_of(rt)
        if rparams.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, format("composition with '>>' needs a one-argument function on the right, found '{}'", type_name(rt)))) }
        let matches = match lret { Some(x) => type_eq(x, rparams[0]), None => false }
        if !matches {
            return Err(terr_at(e.line, e.col, e.sp, format("cannot compose '{}' with '{}': the left result '{}' must match the right parameter '{}'", type_name(lt), type_name(rt), opt_type_name(lret), type_name(rparams[0]))))
        }
        return Ok(Type.TFunc([lparams[0]], rret))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), [Expr { id: 47, line: 39, col: 8, sp: SrcSpan { sline: 39, scol: 8, eline: 39, ecol: 9 }, kind: ExprKind.IntLit(7, None, false, "") }], Some(Type.TTuple([Type.TInt(32, true)])))[Ok(Type.TTuple([Type.TInt(32, true)]))]
    fun infer_tuple_lit(var self, e: Expr, elems: [Expr], expected: Option<Type>) -> Result<Type, CheckErr> {
        var exp_elems: [Type] = []
        var have_exp = false
        match tuple_hint(expected, elems.len()) {
            Some(es) => {
                exp_elems = es
                have_exp = true
            },
            None => {},
        }
        // a list's element leaves its components open as the list does (MYLA-401)
        let may_open = self.open_at == e.id
        var ts: [Type] = []
        var i = 0
        while i < elems.len() {
            var want: Option<Type> = None
            if have_exp { want = Some(exp_elems[i]) }
            if may_open {
                want = drop_hole(want)
                if !self.takes_partial(elems[i]) { want = whole_hint(want) }
                self.open_at = elems[i].id
                let r = self.expect_value(elems[i], want)
                self.open_at = e.id
                ts.push(r?)
            } else {
                ts.push(self.expect_value(elems[i], want)?)
            }
            i = i + 1
        }
        return Ok(Type.TTuple(ts))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), 0)[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun infer_tuple_index(var self, e: Expr, t: Expr, idx: int64) -> Result<Type, CheckErr> {
        let base = self.expect_value(t, None)?
        match base {
            Type.TTuple(es) => {
                if !(idx >= 0 && idx < (es.len() as int64)) { return Err(terr_at(e.line, e.col, e.sp, format("tuple index {} out of range for '{}'", idx, type_name(base)))) }
                return Ok(es[idx as int32])
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a tuple and cannot be indexed with '.{}'", type_name(base), idx)))
    }

    #test(checker_on("[int]"), Expr { id: 40, line: 30, col: 20, sp: SrcSpan { sline: 30, scol: 20, eline: 30, ecol: 22 }, kind: ExprKind.ListLit([]) }, [], Some(Type.TList(Type.TParam("T"))))[Ok(Type.TList(Type.TParam("T")))]
    fun infer_list_lit(var self, e: Expr, elems: [Expr], expected: Option<Type>) -> Result<Type, CheckErr> {
        // this list may be an element that leaves its type open (MYLA-401)
        let may_open = self.open_at == e.id
        var exp_elem: Option<Type> = drop_hole(list_elem_hint(expected))
        if elems.len() == 0 {
            match exp_elem { Some(el) => { return Ok(Type.TList(el)) }, None => {} }
            if may_open { return Ok(Type.TList(hole())) }
            return Err(terr_at(e.line, e.col, e.sp, "cannot infer the element type of an empty list `[]`; annotate it (e.g. `: [int]`)"))
        }
        var col = self.open_column(elems[0])
        for x in elems { col = self.column_step(col, x, exp_elem)? }
        let t = self.close_column(col, may_open)?
        self.drop_columns(col.slot)
        return Ok(Type.TList(t))
    }

    // A new column of a literal, its first element `first`; its lists live
    // in the checker, so that a step adds to them in place (MYLA-401's
    // quadratic join).
    fun open_column(var self, first: Expr) -> LitColumn {
        let slot = self.col_open.len()
        self.col_open.push([])
        self.col_lits.push([])
        return LitColumn { ty: hole(), have: false, first: first, slot: slot, fixed: false }
    }

    // The columns from `slot` on, once their literal is checked.
    fun drop_columns(var self, slot: int32) {
        while self.col_open.len() > slot {
            self.col_open.pop()
            self.col_lits.pop()
        }
    }

    // The column `col` with its next element `x` (MYLA-401). `x` is checked
    // against the elements' type so far, and may leave type parameters open
    // (`open_at`): a later element may fix them. A hint with a hole goes only
    // to an element that can take it.
    //
    // A literal (`adapts`) takes the column's type as its hint; while only
    // such literals are in the column, an element of another type gives it
    // to all of them, each checked again against it (L2): `[1, 300, 3u8]`
    // is an error at `300`, `[1, 2, x]` with `x: int64` an `[int64]`.
    fun column_step(var self, col: LitColumn, x: Expr, exp: Option<Type>) -> Result<LitColumn, CheckErr> {
        var hint = exp
        if col.have { hint = Some(col.ty) }
        if !self.takes_partial(x) { hint = whole_hint(hint) }
        let saved = self.open_at
        self.open_at = x.id
        let r = self.expect_value(x, hint)
        self.open_at = saved
        let t = r?
        if has_hole(t) { self.col_open[col.slot].push(x) }
        let lit = adapts(x)
        let fixed = col.fixed || !lit
        if lit && !col.fixed { self.col_lits[col.slot].push(x) }
        if !col.have { return Ok(LitColumn { ty: t, have: true, first: x, slot: col.slot, fixed: fixed }) }
        if !has_hole(t) && !has_hole(col.ty) {
            if type_eq(col.ty, t) { return Ok(LitColumn { ty: t, have: true, first: col.first, slot: col.slot, fixed: fixed }) }
            if !col.fixed {
                // the literals so far take the type `x` gives
                var all = true
                for y in self.col_lits[col.slot] {
                    if y.id != x.id && !type_eq(self.expect_value(y, Some(t))?, t) { all = false }
                }
                if all { return Ok(LitColumn { ty: t, have: true, first: col.first, slot: col.slot, fixed: fixed }) }
            }
            return Err(terr_at(col.first.line, col.first.col, col.first.sp, format("type mismatch: '{}' vs '{}' (no implicit conversion between numeric types)", type_name(col.ty), type_name(t))))
        }
        return match join_open(col.ty, t) {
            Some(j) => Ok(LitColumn { ty: j, have: true, first: col.first, slot: col.slot, fixed: fixed }),
            None => Err(terr_at(x.line, x.col, x.sp, format("type mismatch: '{}' vs '{}'", open_type_name(col.ty), open_type_name(t)))),
        }
    }

    // The column's type once every element is checked: the elements that
    // left a parameter open take it. If none fixed it, the first of them says
    // what it lacks as it would alone, unless the literal is itself an
    // element that may stay open (`may_open`).
    fun close_column(var self, col: LitColumn, may_open: bool) -> Result<Type, CheckErr> {
        if has_hole(col.ty) {
            if may_open { return Ok(col.ty) }
            // the element the hole is in, as deep as it goes: what the
            // others filled there isn't the error (L6)
            let x = self.hole_at(self.col_open[col.slot][0], col.ty)
            self.expect_value(x, None)?
            return Err(terr_at(x.line, x.col, x.sp, format("cannot infer the type '{}' of this element; add a type annotation to guide inference", open_type_name(col.ty))))
        }
        for x in self.col_open[col.slot] { self.fill_open(x, col.ty)? }
        return Ok(col.ty)
    }

    // An element that left type parameters open gets the type its list's
    // elements share, and so do its own elements that left them open.
    fun fill_open(var self, x: Expr, t: Type) -> Result<int32, CheckErr> {
        self.resolved[x.id] = t
        match x.kind {
            ExprKind.ListLit(es) => {
                match t {
                    Type.TList(el) => { for y in es { if self.holed(y) { self.fill_open(y, el)? } } },
                    _ => {},
                }
            },
            ExprKind.TupleLit(es) => {
                match t {
                    Type.TTuple(ts) => {
                        var i = 0
                        while i < es.len() && i < ts.len() {
                            if self.holed(es[i]) { self.fill_open(es[i], ts[i])? }
                            i += 1
                        }
                    },
                    _ => {},
                }
            },
            ExprKind.MapLit(ents) => {
                match t {
                    Type.TMap(k, v) => {
                        // a key type left open wasn't checked yet
                        if ents.len() > 0 && self.holed(ents[0].key) { self.check_key(k, ents[0].key.line, ents[0].key.col, ents[0].key.sp)? }
                        for en in ents {
                            if self.holed(en.key) { self.fill_open(en.key, k)? }
                            if self.holed(en.value) { self.fill_open(en.value, v)? }
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        return Ok(0)
    }

    // The innermost element of the open element `x` where the type `t` its
    // column's elements share has a hole: `None` in the second place of
    // `(None, None)` beside `(Some(1), None)`.
    fun hole_at(self, x: Expr, t: Type) -> Expr {
        match x.kind {
            ExprKind.TupleLit(es) => {
                match t {
                    Type.TTuple(ts) => {
                        var i = 0
                        while i < es.len() && i < ts.len() {
                            if has_hole(ts[i]) && self.holed(es[i]) { return self.hole_at(es[i], ts[i]) }
                            i += 1
                        }
                    },
                    _ => {},
                }
            },
            ExprKind.ListLit(es) => {
                match t {
                    Type.TList(el) => { for y in es { if self.holed(y) { return self.hole_at(y, el) } } },
                    _ => {},
                }
            },
            ExprKind.MapLit(ents) => {
                match t {
                    Type.TMap(k, v) => {
                        for en in ents {
                            if has_hole(k) && self.holed(en.key) { return self.hole_at(en.key, k) }
                            if has_hole(v) && self.holed(en.value) { return self.hole_at(en.value, v) }
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        return x
    }

    fun holed(self, x: Expr) -> bool {
        return match self.resolved.get(x.id) { Some(t) => has_hole(t), None => false }
    }

    // Whether the element `x` can take a hint with a hole, its holes left
    // open: a variant, a struct, tuple, list or map literal.
    fun takes_partial(self, x: Expr) -> bool {
        return match x.kind {
            ExprKind.ListLit(es) => true,
            ExprKind.MapLit(es) => true,
            ExprKind.TupleLit(es) => true,
            ExprKind.StructLit(n, fs) => true,
            ExprKind.Name(n) => n == "None" && self.unshadowed(n),
            ExprKind.GetField(target, field) => self.is_variant_ref(target, field),
            ExprKind.Call(callee, args, targs) => targs.len() == 0 && (match callee.kind {
                ExprKind.Name(n) => (n == "Some" || n == "Ok" || n == "Err") && self.unshadowed(n),
                ExprKind.GetField(target, field) => self.is_variant_ref(target, field),
                _ => false,
            }),
            _ => false,
        }
    }

    // Whether `==` types the operand `e` by the other one (MYLA-379): `None`,
    // `Some(…)`, `Ok(…)`, `Err(…)`, or a variant of a program's enum,
    // `Tree.Leaf`, `Tree.Node(…)`, whose type arguments the other side has.
    fun other_side_first(self, e: Expr) -> bool {
        if needs_other_side(e) { return true }
        return match e.kind {
            ExprKind.GetField(target, field) => self.is_variant_ref(target, field),
            ExprKind.Call(callee, args, targs) => targs.len() == 0 && match callee.kind {
                ExprKind.GetField(target, field) => self.is_variant_ref(target, field),
                _ => false,
            },
            _ => false,
        }
    }

    fun unshadowed(self, n: str) -> bool { return match self.lookup(n) { Some(b) => false, None => true } }

    fun is_variant_ref(self, target: Expr, field: str) -> bool {
        return match self.enum_name_ref(target) {
            Some(en) => self.enum_has_variant(en, field),
            None => false,
        }
    }

    #test(checker_on("[int]"), Expr { id: 101, line: 48, col: 29, sp: SrcSpan { sline: 48, scol: 29, eline: 48, ecol: 32 }, kind: ExprKind.MapLit([]) }, [], Some(Type.TMap(Type.TChar, Type.TInt(32, true))))[Ok(Type.TMap(Type.TChar, Type.TInt(32, true)))]
    fun infer_map_lit(var self, e: Expr, entries: [MapEntry], expected: Option<Type>) -> Result<Type, CheckErr> {
        // this map may be an element that leaves its type open (MYLA-401)
        let may_open = self.open_at == e.id
        var exp_k: Option<Type> = None
        var exp_v: Option<Type> = None
        var have_exp = false
        match map_kv_hint(expected) {
            Some(kv) => {
                exp_k = drop_hole(Some(kv[0]))
                exp_v = drop_hole(Some(kv[1]))
                have_exp = true
            },
            None => {},
        }
        if entries.len() == 0 {
            if have_exp { return Ok(match expected { Some(et) => et, None => Type.TMap(Type.TStr, Type.TStr) }) }
            if may_open { return Ok(Type.TMap(hole(), hole())) }
            return Err(terr_at(e.line, e.col, e.sp, "cannot infer the key/value types of an empty map `[:]`; annotate it (e.g. `: [str: int]`)"))
        }
        let k0 = entries[0].key
        var keys = self.open_column(k0)
        var vals = self.open_column(entries[0].value)
        var i = 0
        while i < entries.len() {
            keys = self.column_step(keys, entries[i].key, exp_k)?
            if i == 0 && !has_hole(keys.ty) { self.check_key(keys.ty, k0.line, k0.col, k0.sp)? }
            vals = self.column_step(vals, entries[i].value, exp_v)?
            i = i + 1
        }
        // a key type a later key fixed is checked once it is
        let key_open = self.holed(k0)
        let key_t = self.close_column(keys, may_open)?
        if key_open && !has_hole(key_t) { self.check_key(key_t, k0.line, k0.col, k0.sp)? }
        let val_t = self.close_column(vals, may_open)?
        self.drop_columns(keys.slot)
        return Ok(Type.TMap(key_t, val_t))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), expr_of("a.b[0]"))[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun infer_index(var self, e: Expr, t: Expr, ix: Expr) -> Result<Type, CheckErr> {
        let base = self.expect_value(t, None)?
        // a slice (D142): the same kind of list or string
        if is_slice_expr(ix) {
            match base {
                Type.TMap(k, v) => { return Err(terr_at(e.line, e.col, e.sp, "a map has no slices")) },
                Type.TStr => {},
                Type.TList(el) => {},
                _ => { return Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a list and cannot be sliced", type_name(base)))) },
            }
            self.check_slice(ix)?
            self.resolved[ix.id] = Type.TInt(64, true)
            return Ok(base)
        }
        // `^n`, the n-th from the end
        match from_end_of(ix) {
            Some(n) => {
                match base {
                    Type.TMap(k, v) => { return Err(terr_at(ix.line, ix.col, ix.sp, "'^' counts from the end of a list or a string, not a map")) },
                    _ => {},
                }
                let nt = self.expect_value(n, Some(t_int()))?
                if !is_int(nt) { return Err(terr_at(n.line, n.col, n.sp, format("an index must be an integer, found '{}'", type_name(nt)))) }
                self.resolved[ix.id] = nt
                return match base {
                    Type.TStr => Ok(t_byte()),
                    Type.TList(el) => Ok(el),
                    _ => Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a list and cannot be indexed with `[...]`", type_name(base)))),
                }
            },
            None => {},
        }
        match base {
            Type.TMap(k, v) => { self.key_ok(k, e.line, e.col, e.sp)?
                self.prelude_need(k)
                self.expect_type(ix, k, "map key")?
            return Ok(v) },
            Type.TStr => {
                let it = self.expect_value(ix, Some(t_int()))?
                if !is_int(it) { return Err(terr_at(ix.line, ix.col, ix.sp, format("string index must be an integer, found '{}'", type_name(it)))) }
                return Ok(t_byte())
            },
            Type.TList(el) => {
                let it = self.expect_value(ix, Some(t_int()))?
                if !is_int(it) { return Err(terr_at(ix.line, ix.col, ix.sp, format("list index must be an integer, found '{}'", type_name(it)))) }
                return Ok(el)
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a list and cannot be indexed with `[...]`", type_name(base))))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), "f", None)[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun infer_field(var self, e: Expr, target: Expr, field: str, expected: Option<Type>) -> Result<Type, CheckErr> {
        match self.enum_name_ref(target) {
            Some(enum_name) => {
                if !self.enum_has_variant(enum_name, field) { return Err(terr_at(e.line, e.col, e.sp, format("enum '{}' has no variant '{}'", enum_name, field))) }
                let payload = match self.enum_variant_payload(enum_name, [], field) { Some(p) => p, None => empty_types() }
                if payload.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("variant '{}.{}' takes {} argument(s); call it like '{}.{}(...)'", enum_name, field, payload.len(), enum_name, field))) }
                let ei = self.enum_idx(enum_name)
                let nparams = self.enums[ei].type_params.len()
                if nparams == 0 { return Ok(Type.TEnum(enum_name, [])) }
                match expected {
                    Some(et) => { if enum_type_matches(et, enum_name, nparams) { return Ok(et) } },
                    None => {},
                }
                if self.open_at == e.id { return Ok(Type.TEnum(enum_name, holes(nparams))) }   // MYLA-401
                return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type argument(s) for '{}.{}'; annotate the binding (e.g. ': {}<...>')", enum_name, field, enum_name)))
            },
            None => {},
        }
        // a type's function isn't a value (D172)
        match self.static_target(target)? {
            Some(st) => { return Err(terr_at(e.line, e.col, e.sp, format("'{}.{}' names a type's function, not a value: call it, '{}.{}(…)', or wrap the call in a lambda", type_name(st), field, type_name(st), field))) },
            None => {},
        }
        let base = self.expect_value(target, None)?
        match struct_view(base) {
            Type.TStruct(n, args) => {
                self.check_isolation(n, target, field, e)?
                let fields = self.struct_field_types(n, args)
                return match field_type_get(fields, field) { Some(ft) => Ok(ft), None => Err(with_notes(terr_at(e.line, e.col, e.sp, format("struct '{}' has no field '{}'", n, field)), did_you_mean(field, field_names(fields)))) }
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' has no fields", type_name(base))))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "Name", [FieldInit { line: 54, col: 20, sp: SrcSpan { sline: 54, scol: 20, eline: 54, ecol: 27 }, name: "text", value: Expr { id: 96, line: 54, col: 26, sp: SrcSpan { sline: 54, scol: 26, eline: 54, ecol: 27 }, kind: ExprKind.Name("a") } }], None)[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "unknown struct 'Name'", decl: -1, notes: [] })]
    fun infer_struct_lit(var self, e: Expr, sname: str, fields: [FieldInit], expected: Option<Type>) -> Result<Type, CheckErr> {
        if !self.is_struct(sname) { return Err(terr_at(e.line, e.col, e.sp, format("unknown struct '{}'", sname))) }
        let si = self.struct_idx(sname)
        let info = self.structs[si]
        // duplicate / unknown provided fields
        var provided: [str] = []
        for init in fields {
            if contains_str(provided, init.name) { return Err(terr_at(init.line, init.col, init.sp, format("duplicate field '{}' in struct literal", init.name))) }
            if match field_type_get(info.fields, init.name) { Some(x) => false, None => true } { return Err(with_notes(terr_at(init.line, init.col, init.sp, format("struct '{}' has no field '{}'", sname, init.name)), did_you_mean(init.name, field_names(info.fields)))) }
            provided.push(init.name)
        }
        // missing fields
        var missing: [str] = []
        for f in info.fields { if !contains_str(provided, f.name) { missing.push(f.name) } }
        if missing.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("missing field(s) in '{}' literal: {}", sname, join_strs(missing, ", ")))) }
        if info.type_params.len() > 0 {
            for f in info.fields { if has_error(f.ty) { return Err(poisoned()) } }
        }
        if info.type_params.len() == 0 {
            for init in fields {
                let ft = match field_type_get(info.fields, init.name) { Some(x) => x, None => Type.TStr }
                if has_error(ft) { continue }   // the field's type failed (MYLA-110)
                let vt = self.expect_value(init.value, Some(ft))?
                if !type_eq(vt, ft) { return Err(terr_at(init.line, init.col, init.sp, format("field '{}': expected '{}', found '{}'", init.name, type_name(ft), type_name(vt)))) }
            }
            if self.is_actor(sname) { return Ok(Type.TActor(sname, [])) }
            return Ok(Type.TStruct(sname, []))
        }
        // generic struct: solve type args from fields (declaration order)
        var nodes: [Expr] = []
        var ttypes: [Type] = []
        for f in info.fields {
            for init in fields { if init.name == f.name { nodes.push(init.value) } }
            ttypes.push(f.ty)
        }
        var exp_args: Option<[Type]> = struct_args_hint(expected, sname)
        let args = self.infer_type_args(info.type_params, ttypes, nodes, exp_args, e, format("{} '{}'", if_str(self.is_actor(sname), "actor", "struct"), sname))?
        if self.is_actor(sname) { return Ok(Type.TActor(sname, args)) }
        return Ok(Type.TStruct(sname, args))
    }
}

#test("+")["add"]
fun arith_method(op: str) -> str {
    if op == "+" { return "add" }
    if op == "-" { return "sub" }
    if op == "*" { return "mul" }
    if op == "/" { return "div" }
    if op == "%" { return "rem" }
    return ""
}

#test(Type.TStr)[false]
#test(Type.TChar)[false]
#test(Type.TStruct("P", []))[true]
fun is_struct_or_enum(t: Type) -> bool {
    return match t { Type.TStruct(n, a) => true, Type.TEnum(n, a) => true, _ => false }
}
#test(Type.TStr)[false]
#test(Type.TBool)[false]
#test(Type.TParam("T"))[true]
fun is_type_param(t: Type) -> bool { return match t { Type.TParam(n) => true, _ => false } }

// What a type `for` can't loop over lacks to be an iterator (D171).
#test(Type.TInt(32, true))[""]
#test(Type.TStruct("P", []))[" (it needs 'impl Iterator<T> for P')"]
#test(Type.TParam("I"))[" (it needs the bound 'I: Iterator<T>')"]
fun iterator_hint(t: Type) -> str {
    if is_struct_or_enum(t) { return format(" (it needs 'impl Iterator<T> for {}')", type_name(t)) }
    if is_type_param(t) { return format(" (it needs the bound '{}: Iterator<T>')", type_name(t)) }
    return ""
}

// Whether `t` is a tuple (not the unit type) or a list, which `==` compares
// element by element when its elements are `Eq` (D163, MYLA-313).
#test(Type.TTuple([Type.TInt(32, true)]))[true]
#test(Type.TList(Type.TStr))[true]
#test(Type.TTuple([]))[false]
#test(Type.TStr)[false]
fun is_compound_eq(t: Type) -> bool {
    return match t {
        Type.TTuple(es) => es.len() > 0,
        Type.TList(e) => true,
        _ => false,
    }
}

// =========================================================================
// Generic type-argument inference (shared by struct lit / variant ctor)
// =========================================================================

impl Checker {
    // `label` names the construct in a mismatch message ("struct 'Box'").
    // The expected type's arguments may be the enclosing generic function's
    // type parameters, known types there: `B { items: [] }` returned as a
    // `B<T>` (MYLA-315, the second case).
    #test(checker_on("enum E { A, B(int) }"), ["T"], [Type.TParam("T")], [Expr { id: 96, line: 70, col: 26, sp: SrcSpan { sline: 70, scol: 26, eline: 70, ecol: 28 }, kind: ExprKind.IntLit(42, None, false, "") }], None, expr_of("a.b[0]"), "struct 'Box'")[Ok([Type.TInt(32, true)])]
    #test(checker_on("enum E { A, B(int) }"), ["T"], [Type.TList(Type.TParam("T"))], [expr_of("[]")], Some([Type.TParam("T")]), expr_of("B { items: [] }"), "struct 'B'")[Ok([Type.TParam("T")])]
    fun infer_type_args(var self, params: [str], template_types: [Type], nodes: [Expr], expected_args: Option<[Type]>, e: Expr, label: str) -> Result<[Type], CheckErr> {
        var subst: [Subst] = []
        match expected_args {
            Some(ea) => { if ea.len() == params.len() { var i = 0
            while i < params.len() { if !has_hole(ea[i]) { subst.push(Subst { name: params[i], ty: ea[i] }) }
            i = i + 1 } } },
            None => {},
        }
        var value_types: [Type] = []
        var i = 0
        while i < nodes.len() {
            let tt = template_types[i]
            let vt = self.expect_value(nodes[i], arg_hint(tt, subst, is_lambda(nodes[i])))?
            value_types.push(vt)
            let r = unify_param(tt, vt, subst)
            subst = r.subst
            i = i + 1
        }
        var missing: [str] = []
        for p in params { if !subst_has(subst, p) { missing.push(p) } }
        if missing.len() > 0 {
            // a list's element leaves them to a later one (MYLA-401)
            if self.open_at != e.id { return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {}; add a type annotation to guide inference", join_strs(missing, ", ")))) }
            for p in missing { subst.push(Subst { name: p, ty: hole() }) }
        }
        var j = 0
        while j < nodes.len() {
            let want = subst_type(template_types[j], subst)
            if !type_eq(value_types[j], want) {
                if is_int(want) && is_flexible_int_lit(nodes[j]) {
                    self.infer_int_lit(nodes[j], Some(want))?
                } else {
                    return Err(terr_at(nodes[j].line, nodes[j].col, nodes[j].sp, format("{}: expected '{}', found '{}'", label, type_name(want), type_name(value_types[j]))))
                }
            }
            j = j + 1
        }
        var out: [Type] = []
        for p in params { match subst_get(subst, p) { Some(t) => out.push(t), None => {} } }
        return Ok(out)
    }
}

// =========================================================================
// Match & patterns
// =========================================================================

impl Checker {
    fun infer_match(var self, e: Expr, scrut: Expr, arms: [MatchArm], expected: Option<Type>, as_stmt: bool) -> Result<Option<Type>, CheckErr> {
        let st = self.expect_value(scrut, None)?
        // an arm whose value can't say its type alone (`None`, `[]`,
        // `Err(e)`) takes the type of the first arm that can, when nothing
        // is expected (MYLA-290): those arms are checked last
        var later: [bool] = []
        var any_later = false
        var any_now = false
        for arm in arms {
            let l = !as_stmt && is_none_type(expected) && self.arm_needs_context(arm.body)
            later.push(l)
            if l { any_later = true } else { any_now = true }
        }
        var bodies: [ArmBody] = []
        var i = 0
        while i < arms.len() {
            if any_later && any_now && later[i] {
                bodies.push(ArmBody.ABDiverge)
            } else {
                bodies.push(self.check_arm(arms[i], st, expected, as_stmt)?)
            }
            i += 1
        }
        if any_later && any_now {
            var hint = expected
            for ab in bodies {
                if is_none_type(hint) {
                    match ab { ArmBody.ABValue(ot, node) => { hint = ot }, _ => {} }
                }
            }
            i = 0
            while i < arms.len() {
                if later[i] { bodies[i] = self.check_arm(arms[i], st, hint, as_stmt)? }
                i += 1
            }
        }
        self.check_exhaustive(e, st, arms)?
        match self.check_redundant(arms, st) {
            Ok(x) => {},
            Err(err) => { return Err(if_worded(err, arms)) },
        }
        // a let-else's `else` must leave the block (D137)
        if arms.len() == 2 && is_let_else_marker(arms[1].pattern) {
            let leaves = match arms[1].body { ExprOrBlock.EB_Block(b) => block_leaves(b), ExprOrBlock.EB_Expr(x) => is_diverging(x) }
            if !leaves {
                return Err(terr_at(arms[1].line, arms[1].col, arms[1].sp, "the 'else' of a let-else must leave the block: end it with 'return', 'become', 'break', 'continue' or a call that never returns ('panic', 'unreachable')"))
            }
        }
        if as_stmt { return Ok(None) }
        // collect non-diverging arm values
        var vals: [MatchVal] = []
        for ab in bodies {
            match ab {
                ArmBody.ABDiverge => {},
                ArmBody.ABValue(ot, node) => {
                    var t = Type.TTuple([])
                    match ot {
                        Some(x) => { t = x },
                        None => {
                            // a call of a function without a result is the value `()` (D140), as in `expect_value`
                            let call = match node { Some(ex) => is_call_expr(ex), None => false }
                            if !call { return Err(if_worded(terr_at(e.line, e.col, e.sp, "this match is used as a value, so every arm must produce one"), arms)) }
                            match node { Some(ex) => { self.resolved[ex.id] = Type.TTuple([]) }, None => {} }
                        },
                    }
                    vals.push(MatchVal { ty: t, node: node })
                },
            }
        }
        if vals.len() == 0 { return Err(if_worded(terr_at(e.line, e.col, e.sp, "this match is used as a value, but every arm diverges"), arms)) }
        let result = match self.unify_match_result(vals) {
            Ok(t) => t,
            Err(err) => { return Err(if_worded(err, arms)) },
        }
        return Ok(Some(result))
    }

    // One arm: its pattern against the scrutinee's type `st`, its guard, its body.
    fun check_arm(var self, arm: MatchArm, st: Type, expected: Option<Type>, as_stmt: bool) -> Result<ArmBody, CheckErr> {
        self.push_scope()
        self.check_pattern(arm.pattern, st)?
        match arm.guard {
            Some(g) => {
                let saved_guard = self.in_guard
                self.in_guard = true
                let gr = self.expect_type(g, Type.TBool, "match guard")
                self.in_guard = saved_guard
                gr?
            },
            None => {},
        }
        let ab = self.check_arm_body(arm.body, expected, as_stmt)?
        self.pop_scope()
        return Ok(ab)
    }

    // Whether an arm's value can't give its type without an expected one
    // (MYLA-290): `None`, `E.V` of a generic enum, `[]`, `[:]`, a variant
    // that leaves a type parameter open (`Ok(x)`, `Err(e)`), or an inner
    // `if` or `match` whose arms all can't.
    #test(checker_on("[int]"), ExprOrBlock.EB_Expr(expr_of("None")))[true]
    #test(checker_on("[int]"), ExprOrBlock.EB_Expr(expr_of("Some(1)")))[false]
    #test(checker_on("[int]"), ExprOrBlock.EB_Expr(expr_of("Err(1)")))[true]
    #test(checker_on("[int]"), ExprOrBlock.EB_Expr(expr_of("[]")))[true]
    #test(checker_on("[int]"), ExprOrBlock.EB_Expr(expr_of("[1]")))[false]
    fun arm_needs_context(self, body: ExprOrBlock) -> bool {
        let value = match body {
            ExprOrBlock.EB_Expr(ex) => ex,
            ExprOrBlock.EB_Block(bl) => {
                if bl.stmts.len() == 0 { return false }
                match bl.stmts[bl.stmts.len() - 1].kind {
                    StmtKind.ExprStmt(ex) => ex,
                    _ => { return false },
                }
            },
        }
        return self.needs_context(value)
    }

    fun needs_context(self, ex: Expr) -> bool {
        match ex.kind {
            ExprKind.Name(n) => {
                if n != "None" { return false }
                return match self.lookup(n) { Some(b) => false, None => true }
            },
            ExprKind.ListLit(es) => { return es.len() == 0 },
            ExprKind.MapLit(es) => { return es.len() == 0 },
            ExprKind.GetField(target, field) => {
                return match self.enum_name_ref(target) {
                    Some(en) => self.variant_leaves_params(en, field),
                    None => false,
                }
            },
            ExprKind.Call(callee, args, _) => {
                match callee.kind {
                    ExprKind.Name(n) => {
                        if n != "Ok" && n != "Err" { return false }
                        return match self.lookup(n) { Some(b) => false, None => true }
                    },
                    ExprKind.GetField(target, field) => {
                        return match self.enum_name_ref(target) {
                            Some(en) => self.variant_leaves_params(en, field),
                            None => false,
                        }
                    },
                    _ => { return false },
                }
            },
            ExprKind.MatchE(sc, arms) => {
                if arms.len() == 0 { return false }
                for arm in arms {
                    if !self.arm_needs_context(arm.body) && !arm_diverges(arm.body) { return false }
                }
                return true
            },
            _ => { return false },
        }
        return false
    }

    // Whether variant `variant` of the enum `name` leaves one of the enum's
    // type parameters out of its payload, so that a value of it doesn't say
    // the whole type (`Err(e)` of `Result<T, E>`, `None`).
    #test(checker_on("enum Opt<T> { Has(T), Nothing }"), "Opt", "Nothing")[true]
    #test(checker_on("enum Opt<T> { Has(T), Nothing }"), "Opt", "Has")[false]
    #test(checker_on("enum Res<T, E> { Good(T), Bad(E) }"), "Res", "Good")[true]
    #test(checker_on("enum Res<T, E> { Good(T), Bad(E) }"), "Res", "Missing")[false]
    fun variant_leaves_params(self, name: str, variant: str) -> bool {
        let ei = self.enum_idx(name)
        if ei < 0 { return false }
        let payload = match self.enum_variant_payload(name, [], variant) { Some(p) => p, None => { return false } }
        for tp in self.enums[ei].type_params {
            var seen = false
            for t in payload { if mentions_param(t, tp) { seen = true } }
            if !seen { return true }
        }
        return false
    }

    // The arms of a statement match (`as_stmt`) need no value, so their last
    // statement is checked as a statement, and a match there is one too (MYLA-59).
    #test(checker_on("enum E { A, B(int) }"), ExprOrBlock.EB_Expr(Expr { id: 57, line: 29, col: 25, sp: SrcSpan { sline: 29, scol: 25, eline: 29, ecol: 31 }, kind: ExprKind.StrLit("warm") }), Some(Type.TStr), false)[Ok(ArmBody.ABValue(Some(Type.TStr), Some(Expr { id: 57, line: 29, col: 25, sp: SrcSpan { sline: 29, scol: 25, eline: 29, ecol: 31 }, kind: ExprKind.StrLit("warm") })))]
    fun check_arm_body(var self, body: ExprOrBlock, expected: Option<Type>, as_stmt: bool) -> Result<ArmBody, CheckErr> {
        match body {
            ExprOrBlock.EB_Expr(ex) => {
                if as_stmt { match ex.kind { ExprKind.MatchE(sc, arms) => { self.stmt_match = true }, _ => {} } }
                let t = self.infer(ex, expected)?
                if is_diverging(ex) { return Ok(ArmBody.ABDiverge) }
                return Ok(ArmBody.ABValue(t, Some(ex)))
            },
            ExprOrBlock.EB_Block(bl) => {
                self.push_scope()
                let res = self.check_arm_block(bl, expected, as_stmt)?
                self.pop_scope()
                return Ok(res)
            },
        }
        return Ok(ArmBody.ABDiverge)
    }

    #test(checker_on("fun main() { print(1 + 2) }"), block_of("{ }"), None, true)[Ok(ArmBody.ABValue(None, None))]
    fun check_arm_block(var self, bl: Block, expected: Option<Type>, as_stmt: bool) -> Result<ArmBody, CheckErr> {
        let n = bl.stmts.len()
        var i = 0
        while i < n {
            let s = bl.stmts[i]
            if i == n - 1 && !as_stmt {
                match s.kind {
                    StmtKind.ExprStmt(ex) => {
                        let t = self.infer(ex, expected)?
                        if is_diverging(ex) { return Ok(ArmBody.ABDiverge) }
                        return Ok(ArmBody.ABValue(t, Some(ex)))
                    },
                    _ => { self.check_stmt(s)? },
                }
            } else {
                self.check_stmt(s)?
            }
            i = i + 1
        }
        if block_returns(bl) { return Ok(ArmBody.ABDiverge) }
        return Ok(ArmBody.ABValue(None, None))
    }

    fun unify_match_result(var self, vals: [MatchVal]) -> Result<Type, CheckErr> {
        let first = vals[0].ty
        var all_eq = true
        for v in vals { if !type_eq(v.ty, first) { all_eq = false } }
        if all_eq { return Ok(first) }
        var all_int = true
        for v in vals { if !is_int(v.ty) { all_int = false } }
        if all_int {
            var has_target = false
            var target = t_int()
            for v in vals {
                if !has_target {
                    let flex = match v.node { Some(nd) => is_flexible_int_lit(nd), None => false }
                    if !flex { target = v.ty
            has_target = true }
                }
            }
            for v in vals {
                if !type_eq(v.ty, target) {
                    match v.node {
                        Some(nd) => { if is_flexible_int_lit(nd) { self.infer_int_lit(nd, Some(target))? } else { return Err(terr_at(nd.line, nd.col, nd.sp, format("match arms have incompatible types '{}' and '{}'", type_name(target), type_name(v.ty)))) } },
                        None => {},
                    }
                }
            }
            return Ok(target)
        }
        for v in vals {
            if !type_eq(v.ty, first) {
                match v.node { Some(nd) => { return Err(terr_at(nd.line, nd.col, nd.sp, format("match arms have incompatible types '{}' and '{}'", type_name(first), type_name(v.ty)))) }, None => {} }
            }
        }
        return Ok(first)
    }

    #test(checker_on("[int]"), Pattern { id: 120, line: 51, col: 31, sp: SrcSpan { sline: 51, scol: 31, eline: 51, ecol: 32 }, kind: PatternKind.PWild }, Type.TChar)[Ok(0)]
    fun check_pattern(var self, pat: Pattern, t: Type) -> Result<int32, CheckErr> {
        if has_error(t) { return Err(poisoned()) }
        return self.check_pattern_node(pat, t)
    }

    #test(checker_on("[int]"), Pattern { id: 120, line: 51, col: 31, sp: SrcSpan { sline: 51, scol: 31, eline: 51, ecol: 32 }, kind: PatternKind.PWild }, Type.TChar)[Ok(0)]
    fun check_pattern_node(var self, pat: Pattern, t: Type) -> Result<int32, CheckErr> {
        return match pat.kind {
            PatternKind.PWild => Ok(0),
            PatternKind.PBind(n) => {
                match t {
                    Type.TEnum(en, args) => {
                        if self.enum_has_variant(en, n) {
                            let payload = match self.enum_variant_payload(en, args, n) { Some(p) => p, None => empty_types() }
                            if payload.len() > 0 { return Err(terr_at(pat.line, pat.col, pat.sp, format("variant '{}.{}' carries a payload; write '{}(...)' to match it", en, n, n))) }
                            return Ok(0)
                        }
                        if !self.define_at(n, t, false, pat.line, pat.col, pat.sp) { return Err(terr_at(pat.line, pat.col, pat.sp, format("'{}' is bound more than once in this pattern", n))) }
                        Ok(0)
                    },
                    _ => {
                        if !self.define_at(n, t, false, pat.line, pat.col, pat.sp) { return Err(terr_at(pat.line, pat.col, pat.sp, format("'{}' is bound more than once in this pattern", n))) }
                        Ok(0)
                    },
                }
            },
            PatternKind.PLit(litexpr) => {
                var hint: Option<Type> = None
                if is_int(t) || is_char(t) { hint = Some(t) }
                let lt = self.expect_value(litexpr, hint)?
                if !(is_int(t) || is_char(t) || is_bool(t) || is_str(t)) { return Err(terr_at(pat.line, pat.col, pat.sp, format("cannot match a literal against '{}'", type_name(t)))) }
                if !type_eq(lt, t) { return Err(terr_at(pat.line, pat.col, pat.sp, format("literal pattern of type '{}' cannot match value of type '{}'", type_name(lt), type_name(t)))) }
                let misfit = pattern_misfit(litexpr, t)
                if misfit != "" { return Err(terr_at(pat.line, pat.col, pat.sp, format("integer literal {} does not fit in '{}'", misfit, type_name(t)))) }
                Ok(0)
            },
            PatternKind.PEnum(en, variant, elems, hp) => self.check_enum_pattern(pat, en, variant, elems, hp, t),
            PatternKind.PTuple(elems) => {
                match t {
                    Type.TTuple(ets) => {
                        if elems.len() != ets.len() { return Err(terr_at(pat.line, pat.col, pat.sp, format("tuple pattern expects {} element(s), got {}", ets.len(), elems.len()))) }
                        var i = 0
                        while i < elems.len() { self.check_pattern(elems[i], ets[i])?
            i = i + 1 }
                        Ok(0)
                    },
                    _ => Err(terr_at(pat.line, pat.col, pat.sp, format("tuple pattern cannot match value of type '{}'", type_name(t)))),
                }
            },
            PatternKind.PStruct(name, fps) => self.check_struct_pattern(pat, name, fps, t),
            PatternKind.POr(alts) => self.check_or_pattern(pat, alts, t),
        }
    }

    #test(checker_on("enum E { A, B(int) }"), pattern_of("(a, _)"), Some("Shape"), "Empty", [], false, Type.TEnum("Shape", []))[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "enum 'Shape' has no variant 'Empty'", decl: -1, notes: [] })]
    fun check_enum_pattern(var self, pat: Pattern, en: Option<str>, variant: str, elems: [Pattern], hp: bool, t: Type) -> Result<int32, CheckErr> {
        match t {
            Type.TEnum(tn, args) => {
                match en { Some(name) => { if name != tn { return Err(terr_at(pat.line, pat.col, pat.sp, format("pattern names enum '{}' but the value is '{}'", name, tn))) } }, None => {} }
                let payload = match self.enum_variant_payload(tn, args, variant) { Some(p) => p, None => { return Err(terr_at(pat.line, pat.col, pat.sp, format("enum '{}' has no variant '{}'", tn, variant))) } }
                if hp || elems.len() > 0 {
                    if elems.len() != payload.len() { return Err(terr_at(pat.line, pat.col, pat.sp, format("variant '{}.{}' has {} field(s), but the pattern binds {}", tn, variant, payload.len(), elems.len()))) }
                    var i = 0
                    while i < elems.len() { self.check_pattern(elems[i], payload[i])?
            i = i + 1 }
                    return Ok(0)
                }
                if payload.len() > 0 { return Err(terr_at(pat.line, pat.col, pat.sp, format("variant '{}.{}' carries a payload; write '{}(...)' to match it", tn, variant, variant))) }
                return Ok(0)
            },
            _ => {},
        }
        return Err(terr_at(pat.line, pat.col, pat.sp, format("enum pattern cannot match value of type '{}'", type_name(t))))
    }

    fun check_struct_pattern(var self, pat: Pattern, sname: str, fps: [FieldPat], t: Type) -> Result<int32, CheckErr> {
        match struct_view(t) {
            Type.TStruct(tn, args) => {
                if sname != tn { return Err(terr_at(pat.line, pat.col, pat.sp, format("pattern names struct '{}' but the value is '{}'", sname, tn))) }
                if self.is_actor(tn) { return Err(terr_at(pat.line, pat.col, pat.sp, format("a pattern can't reach the fields of the actor '{}'", type_name(t)))) }
                let fields = self.struct_field_types(tn, args)
                var seen: [str] = []
                for fp in fps {
                    if contains_str(seen, fp.name) { return Err(terr_at(fp.line, fp.col, fp.sp, format("field '{}' bound more than once in struct pattern", fp.name))) }
                    seen.push(fp.name)
                    match field_type_get(fields, fp.name) {
                        Some(ft) => { self.check_pattern(fp.pattern, ft)? },
                        None => { return Err(with_notes(terr_at(fp.line, fp.col, fp.sp, format("struct '{}' has no field '{}'", tn, fp.name)), did_you_mean(fp.name, field_names(fields)))) },
                    }
                }
                return Ok(0)
            },
            _ => {},
        }
        return Err(terr_at(pat.line, pat.col, pat.sp, format("struct pattern cannot match value of type '{}'", type_name(t))))
    }

    fun check_or_pattern(var self, pat: Pattern, alts: [Pattern], t: Type) -> Result<int32, CheckErr> {
        var base_names: [str] = []
        var base_types: [Type] = []
        var first = true
        for alt in alts {
            self.push_scope()
            self.check_pattern(alt, t)?
            let top = self.frames.len() - 1
            let names = self.frames[top].names
            var types: [Type] = []
            for b in self.frames[top].binds { types.push(b.ty) }
            self.pop_scope()
            if first {
                base_names = names
                base_types = types
                first = false
            } else {
                if !bindmaps_eq(base_names, base_types, names, types) { return Err(terr_at(pat.line, pat.col, pat.sp, "all alternatives of an or-pattern must bind the same names with the same types")) }
            }
        }
        var i = 0
        while i < base_names.len() {
            if !self.define(base_names[i], base_types[i], false) { return Err(terr_at(pat.line, pat.col, pat.sp, format("'{}' is bound more than once in this pattern", base_names[i]))) }
            i = i + 1
        }
        return Ok(0)
    }

    // -- exhaustiveness & redundancy --------------------------------------

    // Maranget's "usefulness" over pattern matrices (MYLA-14), as in the
    // Python checker: a row of patterns is useful against earlier rows when
    // some value matches it and none of them. Patterns are normalized to
    // `NPat`s first; a constructor's key is an enum variant's name, or `#t` /
    // `#f`, `#()` (a tuple), `#{}` (a struct), `#i<n>` / `#s<text>` (literals).

    #test(checker_on("[int]"), Pattern { id: 120, line: 51, col: 31, sp: SrcSpan { sline: 51, scol: 31, eline: 51, ecol: 32 }, kind: PatternKind.PWild }, Type.TChar)[true]
    fun irrefutable(self, pat: Pattern, t: Type) -> bool {
        return !self.useful([[self.norm_pat(pat, t)]], [NPat.NWild], [t])
    }

    #test(checker_on("[int]"), Pattern { id: 120, line: 51, col: 31, sp: SrcSpan { sline: 51, scol: 31, eline: 51, ecol: 32 }, kind: PatternKind.PWild }, Type.TChar)[NPat.NWild]
    fun norm_pat(self, pat: Pattern, t: Type) -> NPat {
        match pat.kind {
            PatternKind.PWild => { return NPat.NWild },
            PatternKind.PBind(n) => {
                match t {
                    Type.TEnum(en, args) => {
                        if self.enum_has_variant(en, n) && self.is_novpayload_variant(en, n) { return NPat.NCon(n, []) }
                    },
                    _ => {},
                }
                return NPat.NWild
            },
            PatternKind.PLit(e) => { return NPat.NCon(literal_key(e), []) },
            PatternKind.POr(alts) => {
                var out: [NPat] = []
                for a in alts { out.push(self.norm_pat(a, t)) }
                return NPat.NOr(out)
            },
            PatternKind.PTuple(elems) => {
                match t {
                    Type.TTuple(ets) => {
                        var out: [NPat] = []
                        var i = 0
                        while i < elems.len() && i < ets.len() {
                            out.push(self.norm_pat(elems[i], ets[i]))
                            i = i + 1
                        }
                        return NPat.NCon("#()", out)
                    },
                    _ => {},
                }
            },
            PatternKind.PStruct(name, fps) => {
                match t {
                    Type.TStruct(tn, args) => {
                        var out: [NPat] = []
                        for f in self.struct_field_types(tn, args) {
                            var sub = NPat.NWild
                            for fp in fps { if fp.name == f.name { sub = self.norm_pat(fp.pattern, f.ty) } }
                            out.push(sub)
                        }
                        return NPat.NCon("#{}", out)
                    },
                    _ => {},
                }
            },
            PatternKind.PEnum(en, variant, elems, hp) => {
                match t {
                    Type.TEnum(tn, args) => {
                        let payload = match self.enum_variant_payload(tn, args, variant) { Some(p) => p, None => empty_types() }
                        var out: [NPat] = []
                        var i = 0
                        while i < payload.len() {
                            if i < elems.len() { out.push(self.norm_pat(elems[i], payload[i])) } else { out.push(NPat.NWild) }
                            i = i + 1
                        }
                        return NPat.NCon(variant, out)
                    },
                    _ => {},
                }
            },
        }
        return NPat.NWild
    }

    // All constructors of `t` with their field types; none for values that
    // can't be enumerated (integers, strings, chars).
    #test(checker_on("[int]"), Type.TChar)[None]
    fun signature(self, t: Type) -> Option<[SigCon]> {
        var out: [SigCon] = []
        match t {
            Type.TEnum(tn, args) => {
                // the variants in one pass, as `enum_variant_payload` gives
                // each (looking each up was quadratic, MYLA-124)
                let ei = self.enum_idx(tn)
                if ei >= 0 {
                    let info = self.enums[ei]
                    var subst: [Subst] = []
                    if info.type_params.len() > 0 && args.len() >= info.type_params.len() {
                        var i = 0
                        while i < info.type_params.len() {
                            subst.push(Subst { name: info.type_params[i], ty: args[i] })
                            i = i + 1
                        }
                    }
                    for v in info.variants {
                        if subst.len() > 0 { out.push(SigCon { key: v.name, types: subst_type_list(v.payload, subst) }) }
                        else { out.push(SigCon { key: v.name, types: v.payload }) }
                    }
                }
            },
            Type.TBool => {
                out.push(SigCon { key: "#t", types: empty_types() })
                out.push(SigCon { key: "#f", types: empty_types() })
            },
            Type.TTuple(ets) => { out.push(SigCon { key: "#()", types: ets }) },
            Type.TStruct(tn, args) => {
                var ts: [Type] = []
                for f in self.struct_field_types(tn, args) { ts.push(f.ty) }
                out.push(SigCon { key: "#{}", types: ts })
            },
            _ => { return None },
        }
        return Some(out)
    }

    #test(checker_on("[int]"), [], [], [])[true]
    fun useful(self, rows0: [[NPat]], q: [NPat], types: [Type]) -> bool {
        if q.len() == 0 { return rows0.len() == 0 }
        let rows = expand_or(rows0)
        let rest = list_tail(q)
        let trest = list_tail(types)
        match q[0] {
            NPat.NOr(alts) => {
                for alt in alts { if self.useful(rows, list_concat([alt], rest), types) { return true } }
                return false
            },
            NPat.NCon(key, subs) => {
                var sub_types: [Type] = []
                match self.signature(types[0]) {
                    Some(sig) => { for c in sig { if c.key == key { sub_types = c.types } } },
                    None => {},
                }
                if sub_types.len() != subs.len() { sub_types = repeat_type(types[0], subs.len()) }
                return self.useful(specialize(rows, key, subs.len()), list_concat(subs, rest), list_concat(sub_types, trest))
            },
            NPat.NWild => {},
        }
        match self.signature(types[0]) {
            Some(sig) => {
                var complete = true
                for c in sig { if !head_has_key(rows, c.key) { complete = false } }
                if complete {
                    for c in sig {
                        if self.useful(specialize(rows, c.key, c.types.len()), list_concat(wilds(c.types.len()), rest), list_concat(c.types, trest)) { return true }
                    }
                    return false
                }
            },
            None => {},
        }
        var def: [[NPat]] = []
        for row in rows { if is_nwild(row[0]) { def.push(list_tail(row)) } }
        return self.useful(def, rest, trest)
    }

    #test(checker_on("[int]"), Pattern { id: 55, line: 29, col: 9, sp: SrcSpan { sline: 29, scol: 9, eline: 29, ecol: 12 }, kind: PatternKind.PBind("Red") }, "Color", [])[[]]
    fun covered_variants(self, pat: Pattern, tn: str, args: [Type]) -> [str] {
        if self.irrefutable(pat, Type.TEnum(tn, args)) { return self.enum_variant_names(tn) }
        match pat.kind {
            PatternKind.POr(alts) => {
                var out: [str] = []
                for a in alts {
                    for v in self.covered_variants(a, tn, args) {
                        if !contains_str(out, v) { out.push(v) }
                    }
                }
                return out
            },
            PatternKind.PBind(n) => {
                if self.enum_has_variant(tn, n) && self.is_novpayload_variant(tn, n) { return [n] }
                return []
            },
            PatternKind.PEnum(en, variant, elems, hp) => {
                let payload = match self.enum_variant_payload(tn, args, variant) { Some(p) => p, None => empty_types() }
                var allirr = true
                var i = 0
                while i < elems.len() {
                    if !self.irrefutable(elems[i], payload[i]) { allirr = false }
                    i = i + 1
                }
                if allirr { return [variant] }
                return []
            },
            _ => { return [] },
        }
        return []
    }

    fun check_exhaustive(self, e: Expr, st: Type, arms: [MatchArm]) -> Result<int32, CheckErr> {
        var rows: [[NPat]] = []
        for a in arms { match a.guard { Some(g) => {}, None => rows.push([self.norm_pat(a.pattern, st)]) } }
        if !self.useful(rows, [NPat.NWild], [st]) { return Ok(0) }
        match st {
            Type.TEnum(tn, args) => {
                var missing: [str] = []
                for v in self.enum_variant_names(tn) {
                    let payload = match self.enum_variant_payload(tn, args, v) { Some(p) => p, None => empty_types() }
                    if self.useful(specialize(rows, v, payload.len()), wilds(payload.len()), payload) { missing.push(v) }
                }
                return Err(terr_at(e.line, e.col, e.sp, format("non-exhaustive match on '{}': missing variant(s) {} (add them or a '_' arm)", tn, join_strs(missing, ", "))))
            },
            Type.TBool => { return Err(terr_at(e.line, e.col, e.sp, "non-exhaustive match on 'bool': cover both true and false (or add a '_' arm)")) },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("non-exhaustive match on '{}': add a '_' arm", type_name(st))))
    }

    fun check_redundant(self, arms: [MatchArm], st: Type) -> Result<int32, CheckErr> {
        var saw_irrefutable = false
        var covered: [str] = []        // enum variants covered in full so far
        var rows: [[NPat]] = []
        for arm in arms {
            if saw_irrefutable { return Err(terr_at(arm.line, arm.col, arm.sp, "unreachable match arm (a previous arm already matches everything)")) }
            let has_guard = match arm.guard { Some(g) => true, None => false }
            let row = [self.norm_pat(arm.pattern, st)]
            var vs: [str] = []
            match st { Type.TEnum(tn, args) => { vs = self.covered_variants(arm.pattern, tn, args) }, _ => {} }
            if !has_guard && vs.len() > 0 {
                var subset = true
                for v in vs { if !contains_str(covered, v) { subset = false } }
                if subset { return Err(terr_at(arm.line, arm.col, arm.sp, "unreachable match arm (its variant(s) are already covered)")) }
            }
            if !self.useful(rows, row, [st]) { return Err(terr_at(arm.line, arm.col, arm.sp, "unreachable match arm (earlier arms already cover it)")) }
            if has_guard { continue }
            for v in vs { if !contains_str(covered, v) { covered.push(v) } }
            rows.push(row)
            if self.irrefutable(arm.pattern, st) { saw_irrefutable = true }
        }
        return Ok(0)
    }
}

// A pattern normalized for exhaustiveness: a wildcard, a constructor with its
// subpatterns, or an or-pattern (MYLA-14).
enum NPat { NWild, NCon(str, [NPat]), NOr([NPat]) }

// A constructor of a type and its field types.
struct SigCon { key: str, types: [Type] }

#test(Expr { id: 11, line: 18, col: 9, sp: SrcSpan { sline: 18, scol: 9, eline: 18, ecol: 10 }, kind: ExprKind.IntLit(0, None, false, "") })["#i0"]
#test(Expr { id: 136, line: 71, col: 9, sp: SrcSpan { sline: 71, scol: 9, eline: 71, ecol: 12 }, kind: ExprKind.IntLit(117, None, true, "") })["#i117"]
#test(Expr { id: 56, line: 51, col: 13, sp: SrcSpan { sline: 51, scol: 13, eline: 51, ecol: 16 }, kind: ExprKind.IntLit(500, None, false, "") })["#i500"]
fun literal_key(e: Expr) -> str {
    match e.kind {
        ExprKind.BoolLit(b) => {
            if b { return "#t" }
            return "#f"
        },
        ExprKind.StrLit(t) => { return "#s" + t },
        ExprKind.IntLit(v, suf, isc, big) => { return "#i" + int_text(v, big) },
        ExprKind.Unary(op, x) => {
            let k = literal_key(x)            // "#i<n>"
            if k == "#i0" { return k }        // -0 is 0
            return "#i-" + slice_from(k, 2)
        },
        _ => {},
    }
    return "#?"
}

#test("#i1", 2)["1"]
fun slice_from(s: str, start: int) -> str {
    var sb = StringBuilder()
    var i = start
    while i < s.len() {
        sb.append_byte(s[i])
        i = i + 1
    }
    return sb.build()
}

#test(NPat.NWild)[true]
#test(NPat.NCon("A", []))[false]
#test(NPat.NCon("#i0", []))[false]
fun is_nwild(p: NPat) -> bool {
    return match p { NPat.NWild => true, _ => false }
}

#test([], "A")[false]
#test([], "B")[false]
#test([[NPat.NCon("Nil", [])]], "Nil")[true]
fun head_has_key(rows: [[NPat]], key: str) -> bool {
    for row in rows {
        match row[0] {
            NPat.NCon(k, subs) => { if k == key { return true } },
            _ => {},
        }
    }
    return false
}

fun repeat_type(t: Type, n: int) -> [Type] {
    var out: [Type] = []
    var i = 0
    while i < n {
        out.push(t)
        i = i + 1
    }
    return out
}

#test(0)[[]]
#test(1)[[NPat.NWild]]
#test(2)[[NPat.NWild, NPat.NWild]]
fun wilds(n: int) -> [NPat] {
    var out: [NPat] = []
    var i = 0
    while i < n {
        out.push(NPat.NWild)
        i = i + 1
    }
    return out
}

fun list_tail<T>(xs: [T]) -> [T] {
    var out: [T] = []
    var i = 1
    while i < xs.len() {
        out.push(xs[i])
        i = i + 1
    }
    return out
}

fun list_concat<T>(a: [T], b: [T]) -> [T] {
    var out = a
    for x in b { out.push(x) }
    return out
}

// Rows with a leading or-pattern split into one row per alternative.
#test([])[[]]
#test([[NPat.NCon("Some", [NPat.NWild])]])[[[NPat.NCon("Some", [NPat.NWild])]]]
#test([[NPat.NCon("Leaf", [NPat.NWild]), NPat.NCon("Leaf", [NPat.NWild])], [NPat.NWild, NPat.NWild]])[[[NPat.NCon("Leaf", [NPat.NWild]), NPat.NCon("Leaf", [NPat.NWild])], [NPat.NWild, NPat.NWild]]]
fun expand_or(rows: [[NPat]]) -> [[NPat]] {
    var out: [[NPat]] = []
    for row in rows {
        var split = false
        if row.len() == 0 {
            out.push(row)
            continue
        }
        match row[0] {
            NPat.NOr(alts) => {
                split = true
                var alt_rows: [[NPat]] = []
                for alt in alts { alt_rows.push(list_concat([alt], list_tail(row))) }
                for r in expand_or(alt_rows) { out.push(r) }
            },
            _ => {},
        }
        if !split { out.push(row) }
    }
    return out
}

// The rows that match constructor `key`, with its subpatterns in front.
#test([], "Ok", 1)[[]]
#test([[NPat.NCon("Some", [NPat.NWild])], [NPat.NCon("None", [])]], "Some", 1)[[[NPat.NWild]]]
#test([[NPat.NCon("Node", [NPat.NCon("Leaf", [NPat.NWild]), NPat.NCon("Leaf", [NPat.NWild])])]], "Node", 2)[[[NPat.NCon("Leaf", [NPat.NWild]), NPat.NCon("Leaf", [NPat.NWild])]]]
fun specialize(rows: [[NPat]], key: str, arity: int) -> [[NPat]] {
    var out: [[NPat]] = []
    for row in expand_or(rows) {
        match row[0] {
            NPat.NWild => { out.push(list_concat(wilds(arity), list_tail(row))) },
            NPat.NCon(k, subs) => { if k == key { out.push(list_concat(subs, list_tail(row))) } },
            NPat.NOr(alts) => {},
        }
    }
    return out
}

#test([], [], [], [])[true]
#test(["x"], [Type.TInt(32, true)], ["y"], [Type.TInt(32, true)])[false]
fun bindmaps_eq(an: [str], at: [Type], bn: [str], bt: [Type]) -> bool {
    if an.len() != bn.len() { return false }
    var i = 0
    while i < an.len() {
        var found = false
        var j = 0
        while j < bn.len() {
            if bn[j] == an[i] && type_eq(bt[j], at[i]) { found = true }
            j = j + 1
        }
        if !found { return false }
        i = i + 1
    }
    return true
}

// =========================================================================
// Statements & lvalues
// =========================================================================

pub struct LValue { ty: Type, mutable: bool }

impl Checker {
    #test(checker_on("[int]"), Block { line: 7, col: 12, sp: SrcSpan { sline: 7, scol: 12, eline: 7, ecol: 14 }, stmts: [] })[Ok(0)]
    fun check_block(var self, b: Block) -> Result<int32, CheckErr> {
        self.push_scope()
        for s in b.stmts { self.check_stmt(s)? }
        self.pop_scope()
        return Ok(0)
    }

    #test(checker_on("fun main() { print(1 + 2) }"), Stmt { id: 89, line: 44, col: 5, sp: SrcSpan { sline: 44, scol: 5, eline: 44, ecol: 20 }, kind: StmtKind.VarDecl("let", "s", None, Expr { id: 88, line: 44, col: 13, sp: SrcSpan { sline: 44, scol: 13, eline: 44, ecol: 20 }, kind: ExprKind.StrLit("hello") }) })[Ok(0)]
    fun check_stmt(var self, s: Stmt) -> Result<int32, CheckErr> {
        return match s.kind {
            StmtKind.VarDecl(kind, name, ty, init) => {
                if kind == "async" { return self.check_async_let(s, name, ty, init) }
                var declared: Option<Type> = None
                match ty { Some(te) => { declared = Some(self.resolve_annotation(te)?) }, None => {} }
                if opt_has_error(declared) {
                    // the annotation names a failed alias: the binding has the
                    // error type and its value isn't checked (MYLA-110)
                    if !self.define_at(name, Type.TError, kind == "var", s.line, s.col, s.sp) { return Err(with_notes(terr_at(s.line, s.col, s.sp, format("'{}' is already declared in this scope", name)), self.first_declared(name))) }
                    return Ok(0)
                }
                let value_type = self.expect_value(init, declared)?
                var final_t = value_type
                match declared {
                    Some(d) => {
                        if !type_eq(value_type, d) { return Err(terr_at(s.line, s.col, s.sp, format("cannot assign value of type '{}' to binding of type '{}'", type_name(value_type), type_name(d)))) }
                        final_t = d
                    },
                    None => {},
                }
                if !self.define_at(name, final_t, kind == "var", s.line, s.col, s.sp) { return Err(with_notes(terr_at(s.line, s.col, s.sp, format("'{}' is already declared in this scope", name)), self.first_declared(name))) }
                Ok(0)
            },
            StmtKind.DestructDecl(kind, binding, ty, init) => {
                var declared: Option<Type> = None
                match ty { Some(te) => { declared = Some(self.resolve0(te)?) }, None => {} }
                let value_type = self.expect_value(init, declared)?
                match declared { Some(d) => { if !type_eq(value_type, d) { return Err(terr_at(s.line, s.col, s.sp, format("cannot assign value of type '{}' to binding of type '{}'", type_name(value_type), type_name(d)))) } }, None => {} }
                match value_type {
                    Type.TTuple(ets) => {
                        self.bind_elem(binding, value_type, kind == "var")?
                        Ok(0)
                    },
                    _ => Err(terr_at(s.line, s.col, s.sp, format("cannot destructure non-tuple value of type '{}'", type_name(value_type)))),
                }
            },
            StmtKind.Assign(target, value) => {
                match target.kind { ExprKind.Name(n) => { if n == "self" && !self.self_assignable { return Err(terr_at(s.line, s.col, s.sp, "cannot reassign 'self'; mutate its fields or elements instead")) } }, _ => {} }
                let lv = self.check_lvalue(target)?
                if !lv.mutable { return Err(with_notes(terr_at(s.line, s.col, s.sp, "cannot assign to an immutable binding (declare it with 'var')"), self.declared_at(target))) }
                let vt = self.expect_value(value, Some(lv.ty))?
                if !type_eq(vt, lv.ty) { return Err(terr_at(s.line, s.col, s.sp, format("cannot assign '{}' to '{}'", type_name(vt), type_name(lv.ty)))) }
                Ok(0)
            },
            StmtKind.IfS(cond, then, otherwise) => {
                self.expect_type(cond, Type.TBool, "if condition")?
                self.check_block(then)?
                match otherwise {
                    Some(et) => match et {
                        ElseTail.ElseBlock(b) => { self.check_block(b)? },
                        ElseTail.ElseIf(s2) => { self.check_stmt(s2)? },
                    },
                    None => {},
                }
                Ok(0)
            },
            StmtKind.WhileS(cond, body) => {
                self.expect_type(cond, Type.TBool, "while condition")?
                self.loop_depth = self.loop_depth + 1
                self.check_block(body)?
                self.loop_depth = self.loop_depth - 1
                Ok(0)
            },
            StmtKind.ForS(var_name, start, end, body, iter) => self.check_for(s, var_name, start, end, body, iter),
            StmtKind.ReturnS(v, tail) => {
                if self.defer_at >= 0 { return Err(terr_at(s.line, s.col, s.sp, format("a deferred block can't '{}': it runs as its block ends", if_str(tail, "become", "return")))) }
                if !tail { return self.check_return(s, v) }
                match v { Some(ve) => self.check_become(ve), None => Ok(0) }
            },
            StmtKind.BreakS => {
                if self.loop_depth == 0 { return Err(terr_at(s.line, s.col, s.sp, "'break' outside of a loop")) }
                if self.loop_depth == self.defer_at { return Err(terr_at(s.line, s.col, s.sp, "a deferred block can't 'break' out of itself")) }
                Ok(0)
            },
            StmtKind.ContinueS => {
                if self.loop_depth == 0 { return Err(terr_at(s.line, s.col, s.sp, "'continue' outside of a loop")) }
                if self.loop_depth == self.defer_at { return Err(terr_at(s.line, s.col, s.sp, "a deferred block can't 'continue' out of itself")) }
                Ok(0)
            },
            StmtKind.DeferS(body) => {
                // checked where it stands, with the names declared before it
                let saved = self.defer_at
                self.defer_at = self.loop_depth
                let r = self.check_block(body)
                self.defer_at = saved
                r?
                Ok(0)
            },
            StmtKind.ExprStmt(ex) => {
                match ex.kind { ExprKind.MatchE(sc, arms) => { self.stmt_match = true }, _ => {} }
                // a result of the error type is fine here: nothing uses it (MYLA-110)
                self.infer_node(ex, None)?
                Ok(0)
            },
        }
    }

    #test(checker_on("fun h(xs: [int]) -> int { var t = 0; for x in xs { t = t + x }; return t }"), stmt_of("for v in xs { print(v) }"), "x", None, None, block_of("{ print(1); print(2) }"), Some(Expr { id: 14, line: 7, col: 14, sp: SrcSpan { sline: 7, scol: 14, eline: 7, ecol: 16 }, kind: ExprKind.Name("xs") }))[Ok(0)]
    fun check_for(var self, s: Stmt, var_name: str, start: Option<Expr>, end: Option<Expr>, body: Block, iter: Option<Expr>) -> Result<int32, CheckErr> {
        var loop_t = t_int()
        match iter {
            Some(it_expr) => {
                let it = self.expect_value(it_expr, None)?
                loop_t = match it {
                    Type.TList(el) => el,
                    Type.TMap(k, v) => {
                        self.key_ok(k, it_expr.line, it_expr.col, it_expr.sp)?
                        // `for (k, v) in m`: a map's loop visits its keys
                        // (MYLA-390's follow-up)
                        let destructs = var_name.len() > 4 && var_name[:4] == "%for"
                        let key_tuple = match k { Type.TTuple(ks) => true, _ => false }
                        if destructs && !key_tuple {
                            return Err(with_notes(terr_at(it_expr.line, it_expr.col, it_expr.sp, format("a loop over the map '{}' visits its keys, of type '{}', not its entries", type_name(it), type_name(k))), [Note { label: "help", msg: "write 'for (k, v) in m.items()' for the keys and values", line: 0, col: 0, sp: no_span() }]))
                        }
                        k
                    },
                    // a string's characters, as `s.chars()` gives them (MYLA-318)
                    Type.TStr => Type.TChar,
                    _ => {
                        if self.is_iterator(it)? { return self.check_for_iterator(s, var_name, body, it_expr, it) }
                        return Err(terr_at(it_expr.line, it_expr.col, it_expr.sp, format("`for ... in` requires a list, a map, a string, a range or an Iterator, found '{}'{}", type_name(it), iterator_hint(it))))
                    },
                }
            },
            None => {
                let se = match start { Some(x) => x, None => { return Err(terr_at(s.line, s.col, s.sp, "for-range bounds must be integers")) } }
                let ee = match end { Some(x) => x, None => { return Err(terr_at(s.line, s.col, s.sp, "for-range bounds must be integers")) } }
                let st = self.expect_value(se, None)?
                let et = self.expect_value(ee, None)?
                loop_t = self.unify(se, st, ee, et)?
                if !is_int(loop_t) { return Err(terr_at(s.line, s.col, s.sp, "for-range bounds must be integers")) }
            },
        }
        self.push_scope()
        self.define(var_name, loop_t, false)
        self.loop_depth = self.loop_depth + 1
        self.check_block(body)?
        self.loop_depth = self.loop_depth - 1
        self.pop_scope()
        return Ok(0)
    }

    // Whether `t` implements `Iterator` (D171): an impl's, or a type
    // parameter's bound.
    #test(checker_on("[int]"), Type.TStr)[Ok(false)]
    #test(checker_on("enum Option<T> { Some(T), None }\ntrait Iterator<T> {\n    fun next(var self) -> Option<T>\n}\nstruct C { n: int }\nimpl Iterator<int> for C {\n    fun next(var self) -> Option<int> { return None }\n}"), Type.TStruct("C", []))[Ok(true)]
    fun is_iterator(self, t: Type) -> Result<bool, CheckErr> {
        return match t {
            Type.TParam(pn) => Ok(self.bound_has(pn, "Iterator")),
            _ => self.type_implements(t, "Iterator"),
        }
    }

    // `for x in e` over an iterator of the type `it_t` (D171) is `var it = e;
    // while let Some(x) = it.next() { body }`: that loop, built here with new
    // node ids and checked in place of the `for`, inside a block of its own
    // (an `if true`), which `fill_in` puts where the `for` was, so the
    // interpreters and the code generator run it as they run one written so.
    // The hidden variable, `%iter<id>`, is one no program can name.
    #test(checker_on("enum Option<T> { Some(T), None }\ntrait Iterator<T> {\n    fun next(var self) -> Option<T>\n}\nstruct C { n: int }\nimpl Iterator<int> for C {\n    fun next(var self) -> Option<int> { return None }\n}"), stmt_of("for v in c { print(v) }"), "v", block_of("{ print(v) }"), expr_of("c"), Type.TStruct("C", []))[Ok(0)]
    fun check_for_iterator(var self, s: Stmt, var_name: str, body: Block, it_expr: Expr, it_t: Type) -> Result<int32, CheckErr> {
        let name = format("%iter{}", s.id)
        let ln = it_expr.line
        let cl = it_expr.col
        let sp = it_expr.sp
        let recv = Expr { id: self.fresh_id(), line: ln, col: cl, sp: sp, kind: ExprKind.Name(name) }
        let callee = Expr { id: self.fresh_id(), line: ln, col: cl, sp: sp, kind: ExprKind.GetField(recv, "next") }
        let call = Expr { id: self.fresh_id(), line: ln, col: cl, sp: sp, kind: ExprKind.Call(callee, [], []) }
        var bind = PatternKind.PBind(var_name)
        if var_name == "_" { bind = PatternKind.PWild }
        let elem = Pattern { id: self.fresh_id(), line: s.line, col: s.col, sp: s.sp, kind: bind }
        let some = Pattern { id: self.fresh_id(), line: s.line, col: s.col, sp: s.sp, kind: PatternKind.PEnum(None, "Some", [elem], true) }
        let none = Pattern { id: self.fresh_id(), line: ln, col: cl, sp: sp, kind: PatternKind.PEnum(None, "None", [], false) }
        let stop = Stmt { id: self.fresh_id(), line: ln, col: cl, sp: sp, kind: StmtKind.BreakS }
        let arms = [
            MatchArm { line: body.line, col: body.col, sp: body.sp, pattern: some, guard: None, body: ExprOrBlock.EB_Block(body) },
            MatchArm { line: ln, col: cl, sp: sp, pattern: none, guard: None, body: ExprOrBlock.EB_Block(Block { line: ln, col: cl, sp: sp, stmts: [stop] }) },
        ]
        let m = Expr { id: self.fresh_id(), line: s.line, col: s.col, sp: s.sp, kind: ExprKind.MatchE(call, arms) }
        let step = Stmt { id: self.fresh_id(), line: s.line, col: s.col, sp: s.sp, kind: StmtKind.ExprStmt(m) }
        self.push_scope()
        self.define_at(name, it_t, true, ln, cl, sp)
        self.loop_depth = self.loop_depth + 1
        self.check_stmt(step)?
        self.loop_depth = self.loop_depth - 1
        self.pop_scope()
        let decl = Stmt { id: self.fresh_id(), line: ln, col: cl, sp: sp, kind: StmtKind.VarDecl("var", name, None, it_expr) }
        let loop = Stmt { id: self.fresh_id(), line: s.line, col: s.col, sp: s.sp, kind: StmtKind.WhileS(self.true_lit(s), Block { line: body.line, col: body.col, sp: body.sp, stmts: [step] }) }
        let own = Block { line: s.line, col: s.col, sp: s.sp, stmts: [decl, loop] }
        self.for_iters[s.id] = Stmt { id: self.fresh_id(), line: s.line, col: s.col, sp: s.sp, kind: StmtKind.IfS(self.true_lit(s), own, None) }
        self.fill_decls[self.cur_decl] = true
        return Ok(0)
    }

    // A new `true` at `s`, typed.
    fun true_lit(var self, s: Stmt) -> Expr {
        let e = Expr { id: self.fresh_id(), line: s.line, col: s.col, sp: s.sp, kind: ExprKind.BoolLit(true) }
        self.resolved[e.id] = Type.TBool
        return e
    }

    // A node id no declaration has (`next_id`), for a node the checker builds.
    #test(checker_on("[int]"))[1000000000]
    fun fresh_id(var self) -> int32 {
        let id = self.next_id
        self.next_id += 1
        return id
    }

    #test(checker_on("fun f(n: int) -> int { return n * 2 }"), stmt_of("let x = 1"), Some(Expr { id: 28, line: 26, col: 12, sp: SrcSpan { sline: 26, scol: 12, eline: 26, ecol: 15 }, kind: ExprKind.Name("acc") }))[Err(CheckErr { line: 26, col: 12, sp: SrcSpan { sline: 26, scol: 12, eline: 26, ecol: 15 }, msg: "unknown name 'acc'", decl: -1, notes: [] })]
    fun check_return(var self, s: Stmt, v: Option<Expr>) -> Result<int32, CheckErr> {
        if !self.has_cur_ret {
            match v {
                Some(ve) => {
                    if self.lambda_infer_active {
                        let vt = self.expect_value(ve, None)?
                        // positioned at the `return`, where Python reports a mismatch
                        self.lambda_infer.push(MatchVal { ty: vt, node: Some(Expr { id: ve.id, line: s.line, col: s.col, sp: s.sp, kind: ve.kind }) })
                    } else {
                        // `return ()`, or the call of another function without
                        // a result: the same as `return` (D140)
                        let vt = self.expect_value(ve, None)?
                        if !is_unit(vt) { return Err(terr_at(s.line, s.col, s.sp, "cannot return a value from a function with no return type")) }
                    }
                },
                None => {},
            }
            return Ok(0)
        }
        let ret = match self.cur_ret { Some(r) => r, None => t_int() }
        if has_error(ret) { return Ok(0) }   // the return type failed: the value isn't checked (MYLA-110)
        match v {
            None => { return Err(terr_at(s.line, s.col, s.sp, format("expected a return value of type '{}'", type_name(ret)))) },
            Some(ve) => {
                let vt = self.expect_value(ve, Some(ret))?
                if !type_eq(vt, ret) {
                    var notes: [Note] = []
                    if self.lambda_depth == 0 {
                        match self.ret_at { Some(te) => { notes = [note_at("the return type is declared here", te.line, te.col, te.sp)] }, None => {} }
                    }
                    return Err(with_notes(terr_at(s.line, s.col, s.sp, format("return type mismatch: expected '{}', found '{}'", type_name(ret), type_name(vt))), notes))
                }
            },
        }
        return Ok(0)
    }

    // `become ve` (D87): a call of a function, a method or a function value
    // that returns what the function does, whose arguments can be passed
    // without the function's frame (types.py: _check_become).
    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"))[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "'become' needs a call", decl: -1, notes: [] })]
    fun check_become(var self, ve: Expr) -> Result<int32, CheckErr> {
        if self.lambda_depth > 0 { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' can't stand in a lambda")) }
        if self.in_async { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' can't stand in an async function")) }
        var callee = ve
        var args: [Expr] = []
        match ve.kind {
            ExprKind.Call(c, a, _) => {
                callee = c
                args = a
            },
            ExprKind.Try(x) => { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' needs a call, not a '?'")) },
            _ => { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' needs a call")) },
        }
        var partial = false
        for a in args { match a.kind { ExprKind.Hole => { partial = true }, _ => {} } }
        self.call_kind_id = -1
        let t = self.infer_node(ve, self.cur_ret)?
        var kind = ""
        if !partial && self.call_kind_id == ve.id { kind = self.call_kind }
        if kind == "" { return Err(terr_at(ve.line, ve.col, ve.sp, "'become' needs a call of a function, a method or a function value")) }
        if opt_has_error(t) || opt_has_error(self.cur_ret) { return Err(poisoned()) }
        if !opt_type_eq(t, self.cur_ret) {
            var notes: [Note] = []
            match self.ret_at { Some(te) => { notes = [note_at("the return type is declared here", te.line, te.col, te.sp)] }, None => {} }
            return Err(with_notes(terr_at(ve.line, ve.col, ve.sp, format("'become' needs a call returning {}, found {}", quoted_or_nothing(self.cur_ret), quoted_or_nothing(t))), notes))
        }
        if kind == "value" && !self.in_param(callee) { return Err(terr_at(callee.line, callee.col, callee.sp, "'become' can only call a function value that is (a part of) a parameter")) }
        let target = self.call_target
        var all: [Expr] = []
        match callee.kind {
            ExprKind.GetField(recv, f) => {
                if kind == "method" {
                    // the method changes the receiver of the call that `become` ends
                    let on_self = match recv.kind { ExprKind.Name(n) => n == "self", _ => false }
                    if self.call_mutates && !on_self { return Err(terr_at(recv.line, recv.col, recv.sp, format("'become' can call the mutating method '{}' only on 'self'", f))) }
                    all.push(recv)
                }
            },
            _ => {},
        }
        for a in args { all.push(a) }
        var i = 0
        while i < all.len() {
            let arg = all[i]
            if self.resolved.contains(arg.id) {
                let at = self.resolved[arg.id]
                if !has_error(at) && !is_scalar_type(at) {
                    let frame = is_frame_value(at)
                    if kind == "value" {
                        // a function value borrows what it gets: a pointer to
                        // an aggregate, a heap value
                        if !self.in_param(arg) {
                            if frame { return Err(terr_at(arg.line, arg.col, arg.sp, format("'become' can only pass a '{}' that is (a part of) a parameter", type_name(at)))) }
                            return Err(terr_at(arg.line, arg.col, arg.sp, format("'become' can only pass a '{}' to a function value when it is (a part of) a parameter", type_name(at))))
                        }
                        let root = root_name(arg)
                        self.passed_on.push(PassedOn { func: self.fun_name, index: self.param_index(root), name: root, line: arg.line, col: arg.col, sp: arg.sp, decl: self.cur_decl })
                    } else if is_tfunc_type(at) {
                        // a function or method takes a struct, tuple or enum
                        // by value (D88) and a heap value owned (D87); a
                        // function value it gets by its address
                        if !self.in_param(arg) { return Err(terr_at(arg.line, arg.col, arg.sp, format("'become' can only pass a '{}' that is (a part of) a parameter", type_name(at)))) }
                    } else if !(i == 0 && self.call_mutates) {
                        // (a `var self` receiver is its caller's variable)
                        let key = format("{}\t{}", target, i)
                        if !self.handovers.contains(key) { self.handovers[key] = Handover { func: target, index: i, by: self.fun_name, line: arg.line, col: arg.col, sp: arg.sp } }
                    }
                }
            }
            i = i + 1
        }
        // its argument words, counted once every hand-over is known
        // (`check_become_words`)
        var ats: [Type] = []
        for a in all {
            if self.resolved.contains(a.id) { ats.push(self.resolved[a.id]) } else { ats.push(Type.TBool) }
        }
        // and the defaults the call leaves to its trailing parameters (D136),
        // as their parameters' types say (the defaults may not be checked yet)
        var defaults: [str] = []
        if self.call_defaults.contains(ve.id) {
            let fi = self.func_idx(target)
            var k = ats.len()
            for d in self.call_defaults[ve.id] {
                if fi >= 0 && k < self.functions[fi].params.len() { ats.push(self.functions[fi].params[k]) } else { ats.push(Type.TBool) }
                if fi >= 0 && k < self.functions[fi].decl.params.len() { defaults.push(self.functions[fi].decl.params[k].name) }
                k = k + 1
            }
        }
        self.become_words.push(BecomeWords { func: self.fun_name, target: target, value: kind == "value", mutates: self.call_mutates, args: ats, defaults: defaults, line: ve.line, col: ve.col, sp: ve.sp, decl: self.cur_decl })
        return Ok(0)
    }

    // The argument words past the registers go where the function's own
    // came, which its caller pops (D119): a `become` can't pass more of them
    // than its function received. A struct, tuple or enum a `become` hands
    // over travels by value, its words in the argument words (D88), as the
    // parameter it goes to then always does.
    fun check_become_words(var self) {
        for b in self.become_words {
            if self.full() { return }
            let caller = self.functions[self.func_idx(b.func)]
            var passed = 0
            var received = 0
            match caller.ret {
                Some(rt) => {
                    if is_aggregate_type(rt) {
                        passed = 1
                        received = 1
                    }
                },
                None => {},
            }
            var i = 0
            while i < b.args.len() {
                passed = passed + 1
                if !b.value && !(i == 0 && b.mutates) { passed = passed + self.by_value_words(b.target, i, b.args[i]) }
                i = i + 1
            }
            i = 0
            while i < caller.params.len() {
                received = received + 1 + self.by_value_words(b.func, i, caller.params[i])
                i = i + 1
            }
            if passed > REG_ARG_WORDS && passed > received {
                var msg = format("'become' passes {} argument words, {} of them on the stack, but '{}' received {} there", passed, passed - REG_ARG_WORDS, b.func, max_int(received - REG_ARG_WORDS, 0))
                // the defaults the call leaves are passed too (D136, MYLA-293)
                if b.defaults.len() > 0 { msg = format("{}, counting the defaults of {} the call leaves out", msg, quoted_list(b.defaults)) }
                self.errs.push(CheckErr { line: b.line, col: b.col, sp: b.sp, msg: msg, decl: b.decl, notes: [] })
            }
        }
    }

    // The words parameter `i` of function `f`, of type `t`, takes beyond
    // one: those of a struct, tuple or enum a `become` hands over to it (at
    // least one, as an empty one takes a word too).
    fun by_value_words(self, f: str, i: int32, t: Type) -> int32 {
        if !is_aggregate_type(t) || is_tfunc_type(t) || !self.handovers.contains(format("{}\t{}", f, i)) { return 0 }
        return max_int(self.value_words(t), 1) - 1
    }

    // How many 8-byte words a value of type `t` takes, as the code generator
    // lays it out (`CodeGen.size`): a recursive enum held by another value
    // is a pointer to it.
    #test(checker_on("struct P { x: int, y: int }"), Type.TStruct("P", []))[2]
    #test(checker_on("enum E { A, B(int, int) }"), Type.TEnum("E", []))[3]
    fun value_words(self, t: Type) -> int32 {
        return match t {
            Type.TStruct(n, a) => {
                var w = 0
                for st in self.structs {
                    if st.name == n {
                        let sub = subst_of(st.type_params, a)
                        for f in st.fields { w = w + self.held_words(subst_type(f.ty, sub)) }
                    }
                }
                w
            }
            Type.TTuple(es) => {
                var w = 0
                for e in es { w = w + self.held_words(e) }
                w
            }
            Type.TEnum(n, a) => {
                var most = 0
                for en in self.enums {
                    if en.name == n {
                        let sub = subst_of(en.type_params, a)
                        for v in en.variants {
                            var w = 0
                            for pt in v.payload { w = w + self.held_words(subst_type(pt, sub)) }
                            if w > most { most = w }
                        }
                    }
                }
                1 + most
            }
            Type.TFunc(ps, r) => 2
            Type.TAsync(f) => 2
            _ => 1
        }
    }

    // `value_words` of a value held inside another.
    fun held_words(self, t: Type) -> int32 {
        match t {
            Type.TEnum(n, a) => { if contains_str(self.recursive_enums, n) { return 1 } },
            _ => {},
        }
        return self.value_words(t)
    }

    // Whether `e` is a parameter of the function being checked or a field or
    // element of one, which lives in its caller's storage.
    #test(checker_on("[int]"), Expr { id: 5, line: 8, col: 12, sp: SrcSpan { sline: 8, scol: 12, eline: 8, ecol: 13 }, kind: ExprKind.Name("g") })[false]
    fun in_param(self, e: Expr) -> bool {
        var x = e
        var walking = true
        while walking {
            match x.kind {
                ExprKind.GetField(t, f) => { x = t },
                ExprKind.TupleIndex(t, k) => { x = t },
                _ => { walking = false },
            }
        }
        let n = match x.kind { ExprKind.Name(nm) => nm, _ => "" }
        if n == "" { return false }
        var i = self.frames.len() - 1
        while i >= 0 {
            if contains_str(self.frames[i].names, n) { return i == 0 }
            i = i - 1
        }
        return false
    }

    #test(checker_on("fun main() { print(1 + 2) }"), "p")[-1]
    fun param_index(self, name: str) -> int32 {
        var i = 0
        while i < self.frames[0].names.len() {
            if self.frames[0].names[i] == name { return i }
            i = i + 1
        }
        return -1
    }

    // A heap value a `become` passes on to a function value stays its
    // caller's, so a `become` can't hand one over to that parameter.
    fun check_passed_on(var self) {
        for p in self.passed_on {
            let key = format("{}\t{}", p.func, p.index)
            if !self.handovers.contains(key) { continue }
            if self.full() { return }
            let h = self.handovers[key]
            let msg = format("'become' can't pass '{}' on to a function value: a 'become' in '{}' hands it over to '{}'", p.name, h.by, p.func)
            self.errs.push(CheckErr { line: p.line, col: p.col, sp: p.sp, msg: msg, decl: p.decl, notes: [note_at("it is handed over here", h.line, h.col, h.sp)] })
        }
    }

    // -- concurrency (D89; types.py: _check_isolation, _infer_await, ...) ----

    // Whether `key` names an actor (an empty table needs no hashing).
    #test(checker_on("[int]"), "")[false]
    fun is_actor(self, key: str) -> bool {
        return self.actors.len() > 0 && self.actors.contains(key)
    }

    // The first construct of concurrency met, which the interpreters and
    // backends refuse until they run it (MYLA-136, MYLA-137).
    fun met_concurrency(var self, line: int32, col: int32, sp: SrcSpan, node: int32) {
        if self.conc_line == 0 {
            self.conc_node = node
            self.conc_line = line
            self.conc_col = col
            self.conc_sp = sp
        }
    }

    // An actor's fields are reachable only through `self` in its own methods.
    #test(checker_on("enum E { A, B(int) }"), "Adder", expr_of("a.b[0]"), "f", expr_of("a.b[0]"))[Ok(0)]
    fun check_isolation(self, sname: str, target: Expr, field: str, e: Expr) -> Result<int32, CheckErr> {
        if !self.is_actor(sname) { return Ok(0) }
        let own = match target.kind { ExprKind.Name(n) => n == "self" && self.actor_self == sname, _ => false }
        if own && self.task_init { return Err(child_reaches_self(e)) }
        if own { return Ok(0) }
        return Err(terr_at(e.line, e.col, e.sp, format("'{}' belongs to the actor '{}': only its own methods reach it", field, type_name(Type.TStruct(sname, [])))))
    }

    // Whether the function `name` names is std.task's `cancel` (D96), which
    // the compiler takes itself: as other modules name it, or as std.task
    // does, checked as the entry file (MYLA-388).
    #test(checker_on("fun cancel(x: int) {}"), "cancel")[false]
    #test(checker_on("[int]"), "std$task$cancel")[true]
    fun is_task_cancel(self, name: str) -> bool {
        if name == "std$task$cancel" { return true }
        if name != "cancel" || self.std_impls.len() == 0 { return false }
        let fi = self.func_idx(name)
        if fi < 0 { return false }
        return match self.std_impls.get(self.functions[fi].decl_id) { Some(o) => o.module == "std.task", None => false }
    }

    // `task.cancel(a)` (D96): `a` names an `async let` in scope, as an `await`
    // of it would; the call has no result (types.py: _infer_task_cancel).
    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), [Expr { id: 5, line: 7, col: 17, sp: SrcSpan { sline: 7, scol: 17, eline: 7, ecol: 18 }, kind: ExprKind.Name("n") }])[Err(CheckErr { line: 7, col: 17, sp: SrcSpan { sline: 7, scol: 17, eline: 7, ecol: 18 }, msg: "task.cancel() takes the name of an 'async let'", decl: -1, notes: [] })]
    fun infer_task_cancel(var self, e: Expr, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if args.len() == 1 {
            match args[0].kind {
                ExprKind.Name(n) => {
                    match self.lookup(n) {
                        Some(b) => {
                            if b.task > 0 {
                                let d = self.lookup_frame(n)
                                for lam in self.lams {
                                    if d < lam.base { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("a lambda can't cancel the child task '{}' of its function", n))) }
                                }
                                self.met_concurrency(e.line, e.col, e.sp, e.id)
                                if b.task != 2 { self.record_type(args[0].id, Some(b.ty)) }
                                return Ok(None)
                            }
                        },
                        None => {},
                    }
                },
                _ => {},
            }
            return Err(terr_at(args[0].line, args[0].col, args[0].sp, "task.cancel() takes the name of an 'async let'"))
        }
        return Err(terr_at(e.line, e.col, e.sp, "task.cancel() takes the name of an 'async let'"))
    }

    // `await x`: in async code, a call that may suspend or an `async let`'s name.
    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), None)[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "'await' can only stand in an async function", decl: -1, notes: [] })]
    fun infer_await(var self, e: Expr, op: Expr, expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        if !self.in_async { return Err(terr_at(e.line, e.col, e.sp, "'await' can only stand in an async function")) }
        if self.in_guard { return Err(terr_at(e.line, e.col, e.sp, "'await' can't stand in a match guard: bind the awaited value before the 'match'")) }
        match op.kind {
            ExprKind.Name(n) => {
                match self.lookup(n) {
                    Some(b) => {
                        if b.task > 0 {
                            let d = self.lookup_frame(n)
                            for lam in self.lams {
                                if d < lam.base { return Err(terr_at(op.line, op.col, op.sp, format("a lambda can't await the child task '{}' of its function", n))) }
                            }
                            if b.task == 2 { return Ok(None) }
                            self.record_type(op.id, Some(b.ty))
                            return Ok(Some(b.ty))
                        }
                    },
                    None => {},
                }
            },
            ExprKind.Call(c, args, _) => {
                self.awaited[op.id] = true
                self.suspended = -1
                let t = self.infer_node(op, expected)?
                if self.suspended == op.id { return Ok(t) }
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, "'await' needs a call that may suspend (an async function, an actor's method) or the name of an 'async let'"))
    }

    // The call `e` just inferred (marked by `mark_call`) stands under `await`
    // if it may suspend: a call of an async function, method or function
    // value, or of an actor's method from outside it.
    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"))[Ok(0)]
    fun check_suspension(var self, e: Expr, callee: Expr) -> Result<int32, CheckErr> {
        var why = ""
        if self.call_kind == "method" {
            var own = false
            var field = ""
            match callee.kind {
                ExprKind.GetField(tg, f) => {
                    field = f
                    own = match tg.kind { ExprKind.Name(n) => n == "self" && self.actor_self == self.call_key, _ => false }
                },
                _ => {},
            }
            if own && self.task_init && !self.call_async { return Err(child_reaches_self(e)) }
            if self.is_actor(self.call_key) && !own { why = format("a call into the actor '{}' needs 'await'", type_name(Type.TStruct(self.call_key, []))) }
            else if self.call_async { why = format("a call to the async method '{}' needs 'await'", field) }
        } else if self.call_kind == "value" {
            if self.call_async { why = "a call to an async function value needs 'await'" }
        } else if self.call_async {
            why = format("a call to the async function '{}' needs 'await'", self.call_target)
        }
        if why == "" { return Ok(0) }
        self.suspended = e.id
        if !self.awaited.contains(e.id) { return Err(terr_at(e.line, e.col, e.sp, why)) }
        return Ok(0)
    }

    // `async let name = init` (s): a child task in async code; a call it makes
    // is awaited by the task.
    #test(checker_on("enum E { A, B(int) }"), stmt_of("x = x + 1"), "a", None, expr_of("a.b[0]"))[Err(CheckErr { line: 1, col: 3, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 10 }, msg: "'async let' can only stand in an async function", decl: -1, notes: [] })]
    fun check_async_let(var self, s: Stmt, name: str, ty: Option<TypeExpr>, init: Expr) -> Result<int32, CheckErr> {
        if !self.in_async { return Err(terr_at(s.line, s.col, s.sp, "'async let' can only stand in an async function")) }
        // its scope would wait for the child: a suspension (D135)
        if self.defer_at >= 0 { return Err(terr_at(s.line, s.col, s.sp, "a deferred block can't start a task: it runs as its block ends, without suspending")) }
        if self.task_line == 0 {
            self.task_line = s.line
            self.task_col = s.col
            self.task_sp = s.sp
            self.task_node = self.cur_decl
        }
        var declared: Option<Type> = None
        match ty { Some(te) => { declared = Some(self.resolve_annotation(te)?) }, None => {} }
        var t: Option<Type> = None
        if !opt_has_error(declared) {
            match init.kind { ExprKind.Call(c, a, _) => { self.awaited[init.id] = true }, _ => {} }
            self.task_init = true
            let it = self.infer(init, declared)
            self.task_init = false
            t = it?
            match declared {
                Some(d) => {
                    if !opt_has_error(t) && !opt_type_eq(t, declared) { return Err(terr_at(s.line, s.col, s.sp, format("type mismatch in 'async let': declared '{}', found '{}'", type_name(d), opt_type_name(t)))) }
                    t = declared
                },
                None => {},
            }
        } else {
            t = declared
        }
        if !self.define_task(name, t, s.line, s.col, s.sp) { return Err(with_notes(terr_at(s.line, s.col, s.sp, format("'{}' is already declared in this scope", name)), self.first_declared(name))) }
        return Ok(0)
    }

    // The kind of the call `e` just inferred, for `become`; for a method the
    // key of its type, and whether the callee is async (D89).
    fun mark_call(var self, e: Expr, kind: str, target: str, mutates: bool, key: str, asy: bool) {
        self.call_kind = kind
        self.call_kind_id = e.id
        self.call_target = target
        self.call_mutates = mutates
        self.call_key = key
        self.call_async = asy
        if mutates && self.actor_self != "" { self.mutating_calls[e.id] = true }
    }

    #test(checker_on("[int]"), BindElem.BWild, Type.TParam("T"), false)[Ok(0)]
    fun bind_elem(var self, be: BindElem, t: Type, mutable: bool) -> Result<int32, CheckErr> {
        return match be {
            BindElem.BWild => Ok(0),
            BindElem.BName(n, ln, cl, sp) => {
                if !self.define_at(n, t, mutable, ln, cl, sp) { return Err(with_notes(terr_at(ln, cl, sp, format("'{}' is already declared in this scope", n)), self.first_declared(n))) }
                Ok(0)
            },
            BindElem.BTuple(elems, ln, cl, sp) => {
                match t {
                    Type.TTuple(ets) => {
                        if elems.len() != ets.len() { return Err(terr_at(ln, cl, sp, format("tuple pattern expects {} element(s), but value has {}", elems.len(), ets.len()))) }
                        var i = 0
                        while i < elems.len() { self.bind_elem(elems[i], ets[i], mutable)?
            i = i + 1 }
                        Ok(0)
                    },
                    _ => Err(terr_at(ln, cl, sp, format("cannot destructure non-tuple value of type '{}'", type_name(t)))),
                }
            },
        }
    }

    #test(checker_on("[int]"), Expr { id: 22, line: 24, col: 9, sp: SrcSpan { sline: 24, scol: 9, eline: 24, ecol: 10 }, kind: ExprKind.Name("i") })[Err(CheckErr { line: 24, col: 9, sp: SrcSpan { sline: 24, scol: 9, eline: 24, ecol: 10 }, msg: "unknown name 'i'", decl: -1, notes: [] })]
    fun check_lvalue(var self, e: Expr) -> Result<LValue, CheckErr> {
        let lv = self.check_lvalue_node(e)?
        if has_error(lv.ty) { return Err(poisoned()) }
        return Ok(lv)
    }

    #test(checker_on("[int]"), Expr { id: 22, line: 24, col: 9, sp: SrcSpan { sline: 24, scol: 9, eline: 24, ecol: 10 }, kind: ExprKind.Name("i") })[Err(CheckErr { line: 24, col: 9, sp: SrcSpan { sline: 24, scol: 9, eline: 24, ecol: 10 }, msg: "unknown name 'i'", decl: -1, notes: [] })]
    fun check_lvalue_node(var self, e: Expr) -> Result<LValue, CheckErr> {
        return match e.kind {
            ExprKind.Name(n) => {
                // a lambda holds copies of what it captures (D48): a change to
                // one would reach neither the variable nor its next call (D93)
                if self.lams.len() > 0 && self.frame_of(n) >= 0 && self.frame_of(n) < self.lams[self.lams.len() - 1].base {
                    return Err(with_notes(terr_at(e.line, e.col, e.sp, format("a lambda can't change '{}', a variable it captures: it holds a copy of its own", n)), [Note { label: "help", msg: "return the new value, or keep shared state in an actor", line: 0, col: 0, sp: no_span() }]))
                }
                match self.lookup(n) { Some(b) => Ok(LValue { ty: b.ty, mutable: b.mutable }), None => Err(with_notes(terr_at(e.line, e.col, e.sp, format("unknown name '{}'", n)), did_you_mean(n, self.scope_names()))) }
            },
            ExprKind.GetField(target, field) => {
                let base = self.check_lvalue(target)?
                match struct_view(base.ty) {
                    Type.TStruct(nm, args) => {
                        self.check_isolation(nm, target, field, e)?
                        let fields = self.struct_field_types(nm, args)
                        match field_type_get(fields, field) { Some(ft) => Ok(LValue { ty: ft, mutable: base.mutable }), None => Err(with_notes(terr_at(e.line, e.col, e.sp, format("struct '{}' has no field '{}'", nm, field)), did_you_mean(field, field_names(fields)))) }
                    },
                    _ => Err(terr_at(e.line, e.col, e.sp, format("type '{}' has no fields", type_name(base.ty)))),
                }
            },
            ExprKind.Index(target, index) => {
                if is_slice_expr(index) { return Err(terr_at(e.line, e.col, e.sp, "a slice can't be assigned to (not yet): assign its elements")) }
                let base = self.check_lvalue(target)?
                match from_end_of(index) {
                    Some(n) => {
                        match base.ty {
                            Type.TList(el) => {
                                let nt = self.expect_value(n, Some(t_int()))?
                                if !is_int(nt) { return Err(terr_at(n.line, n.col, n.sp, format("an index must be an integer, found '{}'", type_name(nt)))) }
                                self.resolved[index.id] = nt
                                return Ok(LValue { ty: el, mutable: base.mutable })
                            },
                            _ => {},
                        }
                    },
                    None => {},
                }
                match base.ty {
                    Type.TMap(k, v) => { self.key_ok(k, e.line, e.col, e.sp)?
                        self.expect_type(index, k, "map key")?
            Ok(LValue { ty: v, mutable: base.mutable }) },
                    Type.TStr => Err(terr_at(e.line, e.col, e.sp, "strings are immutable; `s[i]` cannot be assigned to")),
                    Type.TList(el) => {
                        let it = self.expect_value(index, Some(t_int()))?
                        if !is_int(it) { return Err(terr_at(index.line, index.col, index.sp, format("list index must be an integer, found '{}'", type_name(it)))) }
                        Ok(LValue { ty: el, mutable: base.mutable })
                    },
                    _ => Err(terr_at(e.line, e.col, e.sp, format("type '{}' is not a list and cannot be indexed with `[...]`", type_name(base.ty)))),
                }
            },
            _ => Err(terr_at(e.line, e.col, e.sp, "invalid assignment target")),
        }
    }

    // A call of `sig` with `given` arguments (after `skip` parameters: a
    // method's receiver): too many or too few is an error; fewer than its
    // parameters records the defaults of the ones left out (D136).
    fun call_arity(var self, e: Expr, sig: FuncSig, skip: int32, given: int32, what: str) -> Result<bool, CheckErr> {
        let total = sig.params.len() - skip
        let optional = trailing_defaults(sig.decl.params)
        if given > total || given < total - optional {
            if optional == 0 { return Err(terr_at(e.line, e.col, e.sp, format("{} expects {} argument(s), got {}", what, total, given))) }
            return Err(terr_at(e.line, e.col, e.sp, format("{} expects {} to {} argument(s), got {}", what, total - optional, total, given)))
        }
        if given < total {
            var ds: [Expr] = []
            var i = skip + given
            while i < sig.decl.params.len() {
                match sig.decl.params[i].default { Some(d) => { ds.push(d) }, None => {} }
                i += 1
            }
            self.call_defaults[e.id] = ds
            self.fill_decls[self.cur_decl] = true
        }
        return Ok(true)
    }

    // The defaults of `fd`'s parameters (D136): only trailing ones, each of
    // its parameter's type, checked before any parameter is in scope (a
    // default can't name one). A default whose parameter's type mentions a
    // type parameter isn't supported: the caller, which evaluates it, has no
    // binding for it.
    fun check_defaults(var self, fd: FunData, sig: FuncSig) -> Result<bool, CheckErr> {
        var seen = false
        var i = 0
        while i < fd.params.len() {
            let p = fd.params[i]
            match p.default {
                Some(d) => {
                    seen = true
                    let pt = sig.params[i]
                    if !has_error(pt) {
                        if contains_type_param(pt) { return Err(terr_at(d.line, d.col, d.sp, format("parameter '{}' can't have a default: its type mentions a type parameter", p.name))) }
                        let dt = self.expect_value(d, Some(pt))?
                        if !type_eq(dt, pt) { return Err(terr_at(d.line, d.col, d.sp, format("the default of parameter '{}' is a '{}', but the parameter is a '{}'", p.name, type_name(dt), type_name(pt)))) }
                    }
                },
                None => {
                    if seen { return Err(terr_at(p.line, p.col, p.sp, format("parameter '{}' needs a default: the parameters after one with a default have one too", p.name))) }
                },
            }
            i = i + 1
        }
        return Ok(true)
    }

    #test(checker_on("fun f(n: int) -> int { return n * 2 }"), fun_of("fun f(n: int) -> int { return n * 2 }"))[Ok(0)]
    fun check_function(var self, fd: FunData) -> Result<int32, CheckErr> {
        let idx = self.func_idx(fd.name)
        let sig = self.functions[idx]
        self.cur_ret = sig.ret
        self.has_cur_ret = match sig.ret { Some(x) => true, None => false }
        self.ret_at = fd.ret_type
        self.fun_name = fd.name
        self.type_params = sig.type_params
        self.bounds_cur = sig.bounds
        self.key_ctx = true
        // a generic map type's key needs its bounds (D163)
        for pt in sig.params { self.check_keys_in(pt, fd.line, fd.col, fd.sp)? }
        match sig.ret {
            Some(rt) => { self.check_keys_in(rt, fd.line, fd.col, fd.sp)? },
            None => {},
        }
        self.frames = []
        self.push_scope()
        self.check_defaults(fd, sig)?
        self.in_async = fd.is_async
        if fd.is_async { self.met_concurrency(fd.line, fd.col, fd.sp, self.cur_decl) }
        if self.is_actor(self.cur_key) { self.actor_self = self.cur_key } else { self.actor_self = "" }
        let recv = match fd.receiver { Some(r) => r, None => "" }
        // a built-in value's `var self` method changes it by assigning it,
        // which reaches the caller's place (D144), and so does an enum's,
        // which has no fields to change (an enum as a stateful iterator,
        // MYLA-380's follow-up); a struct's changes its fields
        self.self_assignable = recv == "var self" && sig.params.len() > 0 && (is_builtin_value(sig.params[0]) || (!fd.is_async && match sig.params[0] { Type.TEnum(en, ea) => true, _ => false }))
        // an async one would need its receiver back from its frame, as a
        // struct's gets it (D99)
        if self.self_assignable && fd.is_async { return Err(terr_at(fd.line, fd.col, fd.sp, "async 'var self' methods on built-in types are not supported yet")) }
        var i = 0
        while i < fd.params.len() {
            let mutable = i == 0 && recv == "var self"
            // the synthesized receiver has no place of its own for a note
            if i == 0 && recv != "" { self.define(fd.params[i].name, sig.params[i], mutable) }
            else { self.define_at(fd.params[i].name, sig.params[i], mutable, fd.params[i].line, fd.params[i].col, fd.params[i].sp) }
            i = i + 1
        }
        match fd.body {
            Some(b) => {
                self.check_block(b)?
                if self.has_cur_ret && !block_returns(b) {
                    self.type_params = []
                    self.bounds_cur = []
                    self.key_ctx = false
                    return Err(terr_at(fd.line, fd.col, fd.sp, format("function '{}' may finish without returning a '{}'", fd.name, opt_type_name(sig.ret))))
                }
            },
            None => {},
        }
        self.type_params = []
        self.bounds_cur = []
        self.key_ctx = false
        return Ok(0)
    }
}

// =========================================================================
// #derive(Eq) (v0.4.4) - validate + register a structural Eq impl
// =========================================================================

#test(Type.TInt(32, true), ["Pair"])[true]
#test(Type.TStruct("Bare", []), ["Holder"])[false]
#test(Type.TChar, ["Color", "Pixel", "Glyph", "Vec2"])[true]
fun is_eq_type(t: Type, eq_names: [str]) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TBool => true,
        Type.TStr => true,
        Type.TChar => true,
        Type.TFloat(w) => true,
        Type.TError => true,          // has had its error (MYLA-110)
        // the unit type (D138), and a tuple or list of `Eq` elements (D163)
        Type.TTuple(es) => all_eq_types(es, eq_names),
        Type.TList(e) => is_eq_type(e, eq_names),
        // a generic type's arguments too; a type parameter of a generic
        // type's derive gets the bound (MYLA-379)
        Type.TStruct(n, a) => contains_str(eq_names, n) && all_eq_types(a, eq_names),
        Type.TEnum(n, a) => contains_str(eq_names, n) && all_eq_types(a, eq_names),
        Type.TParam(n) => true,
        _ => false,
    }
}

// Whether `t` is `Hash` for a derived impl's field, the structs and enums
// among `hash_names` being so (D163): not a float, nor anything holding one.
#test(Type.TTuple([Type.TInt(32, true), Type.TStr]), [])[true]
#test(Type.TList(Type.TFloat(64)), [])[false]
#test(Type.TStruct("P", []), ["P"])[true]
fun is_hash_type(t: Type, hash_names: [str]) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TBool => true,
        Type.TStr => true,
        Type.TChar => true,
        Type.TError => true,          // has had its error (MYLA-110)
        Type.TTuple(es) => all_hash_types(es, hash_names),
        Type.TList(e) => is_hash_type(e, hash_names),
        Type.TStruct(n, a) => contains_str(hash_names, n) && all_hash_types(a, hash_names),
        Type.TEnum(n, a) => contains_str(hash_names, n) && all_hash_types(a, hash_names),
        Type.TParam(n) => true,
        _ => false,
    }
}

fun all_hash_types(ts: [Type], hash_names: [str]) -> bool {
    for t in ts {
        if !is_hash_type(t, hash_names) { return false }
    }
    return true
}

// What a refusal of a field of type `t` adds when `t` is or holds a float.
#test(Type.TFloat(64))[" (a float isn't: NaN is unequal to itself; a hand-written 'impl Hash' may add 'math.to_bits(x)')"]
#test(Type.TStr)[""]
fun float_note(t: Type) -> str {
    if holds_float(t) { return " (a float isn't: NaN is unequal to itself; a hand-written 'impl Hash' may add 'math.to_bits(x)')" }
    return ""
}

#test(Type.TTuple([Type.TStr, Type.TList(Type.TFloat(32))]))[true]
#test(Type.TInt(8, true))[false]
fun holds_float(t: Type) -> bool {
    return match t {
        Type.TFloat(w) => true,
        Type.TTuple(es) => {
            for e in es {
                if holds_float(e) { return true }
            }
            false
        },
        Type.TList(e) => holds_float(e),
        _ => false,
    }
}

// Whether the derive attributes among `attrs` name the trait `trnm`.
fun derives(attrs: [Attribute], trnm: str) -> bool {
    for a in attrs {
        if a.name == "derive" {
            for arg in a.args {
                match arg.kind {
                    ExprKind.Name(n) => { if n == trnm { return true } },
                    _ => {},
                }
            }
        }
    }
    return false
}

// Whether `d` is an inherent `impl <name> { … }`.
fun impl_of_type(d: Decl, name: str) -> bool {
    return match d.kind {
        DeclKind.ImplDecl(tg, m, tp, tn, ta, dattrs) => match tn {
            Some(t) => false,
            None => match tg.kind {
                TypeKind.TRef(nm, args) => nm == name,
                _ => false,
            },
        },
        _ => false,
    }
}

// The source of a derived `impl Hash` (D163) for a type `parts` describes
// (`derived_parts`), its first line `head`: `impl Hash for Derived`, a
// placeholder type that `impl_for` names, or a generic type's bounded impl
// (MYLA-379); its body adds a struct's fields, or an enum's variant index
// and payload.
#test("impl Hash for Derived", [("x", -1), ("y", -1)])["impl Hash for Derived {\n    fun hash(self, hasher: Hasher) -> Hasher {\n        return hasher.add(self.x).add(self.y)\n    }\n}\n"]
#test("impl<T: Hash> Hash for m$E<T>", [("A", 0), ("B", 2)])["impl<T: Hash> Hash for m$E<T> {\n    fun hash(self, hasher: Hasher) -> Hasher {\n        return match self {\n            A => hasher.add_u64(0)\n            B(field0, field1) => hasher.add_u64(1).add(field0).add(field1)\n        }\n    }\n}\n"]
fun derived_hash_src(head: str, parts: [(str, int32)]) -> str {
    var sb = StringBuilder()
    sb.append(head)
    sb.append(" {\n    fun hash(self, hasher: Hasher) -> Hasher {\n")
    let is_enum = parts.len() > 0 && parts[0].1 >= 0
    if !is_enum {
        sb.append("        return hasher")
        for p in parts { sb.append(f".add(self.{p.0})") }
        sb.append("\n")
    } else {
        sb.append("        return match self {\n")
        var i = 0
        for p in parts {
            sb.append(f"            {p.0}")
            if p.1 > 0 {
                sb.append("(")
                var k = 0
                while k < p.1 {
                    if k > 0 { sb.append(", ") }
                    sb.append(f"field{k}")
                    k += 1
                }
                sb.append(")")
            }
            sb.append(f" => hasher.add_u64({i})")
            var k = 0
            while k < p.1 {
                sb.append(f".add(field{k})")
                k += 1
            }
            sb.append("\n")
            i += 1
        }
        sb.append("        }\n")
    }
    sb.append("    }\n}\n")
    return sb.build()
}

// The source of a derived `impl Eq` of the generic struct or enum `name`
// with the type parameters `tps` (MYLA-379), each bounded by `Eq`, that
// `parts` describes (`derived_parts`): a struct's fields compared in turn,
// an enum's variants each against the same variant, its payloads in turn.
#test("Pair", ["A", "B"], [("a", -1), ("b", -1)])["impl<A: Eq, B: Eq> Eq for Pair<A, B> {\n    fun eq(self, other: Pair<A, B>) -> bool {\n        return self.a == other.a && self.b == other.b\n    }\n}\n"]
#test("m$Unit", ["T"], [])["impl<T: Eq> Eq for m$Unit<T> {\n    fun eq(self, other: m$Unit<T>) -> bool {\n        return true\n    }\n}\n"]
#test("Tree", ["T"], [("Leaf", 0), ("Node", 2)])["impl<T: Eq> Eq for Tree<T> {\n    fun eq(self, other: Tree<T>) -> bool {\n        return match self {\n            Leaf => match other {\n                Leaf => true\n                _ => false\n            }\n            Node(field0, field1) => match other {\n                Node(other0, other1) => field0 == other0 && field1 == other1\n                _ => false\n            }\n        }\n    }\n}\n"]
#test("One", ["T"], [("A", 1)])["impl<T: Eq> Eq for One<T> {\n    fun eq(self, other: One<T>) -> bool {\n        return match self {\n            A(field0) => match other {\n                A(other0) => field0 == other0\n            }\n        }\n    }\n}\n"]
fun derived_eq_src(name: str, tps: [str], parts: [(str, int32)]) -> str {
    let full = with_params(name, tps)
    var sb = StringBuilder()
    sb.append(f"impl{bounded_params(tps, "Eq")} Eq for {full} {{\n    fun eq(self, other: {full}) -> bool {{\n")
    let is_enum = parts.len() > 0 && parts[0].1 >= 0
    if !is_enum {
        var cmps: [str] = []
        for p in parts { cmps.push(f"self.{p.0} == other.{p.0}") }
        if cmps.len() == 0 { cmps.push("true") }
        sb.append(f"        return {cmps.join(" && ")}\n")
    } else {
        sb.append("        return match self {\n")
        for p in parts {
            var mine: [str] = []
            var theirs: [str] = []
            var cmps: [str] = []
            var k = 0
            while k < p.1 {
                mine.push(f"field{k}")
                theirs.push(f"other{k}")
                cmps.push(f"field{k} == other{k}")
                k += 1
            }
            if cmps.len() == 0 { cmps.push("true") }
            var pat_a = p.0
            var pat_b = p.0
            if p.1 > 0 {
                pat_a = f"{p.0}({mine.join(", ")})"
                pat_b = f"{p.0}({theirs.join(", ")})"
            }
            sb.append(f"            {pat_a} => match other {{\n                {pat_b} => {cmps.join(" && ")}\n")
            // another variant, unless there is none (an unreachable arm is an error)
            if parts.len() > 1 { sb.append("                _ => false\n") }
            sb.append("            }\n")
        }
        sb.append("        }\n")
    }
    sb.append("    }\n}\n")
    return sb.build()
}

// `name` with its type parameters, as a type: `Pair<A, B>`, `P`.
#test("Pair", ["A", "B"])["Pair<A, B>"]
#test("P", [])["P"]
fun with_params(name: str, tps: [str]) -> str {
    if tps.len() == 0 { return name }
    return f"{name}<{tps.join(", ")}>"
}

// The type parameters `tps` of an impl, each bounded by `trnm`: `<A: Eq, B:
// Eq>`, "" for none.
#test(["A", "B"], "Eq")["<A: Eq, B: Eq>"]
#test([], "Eq")[""]
fun bounded_params(tps: [str], trnm: str) -> str {
    if tps.len() == 0 { return "" }
    var out: [str] = []
    for t in tps { out.push(f"{t}: {trnm}") }
    return f"<{out.join(", ")}>"
}

// A type's name without its module, as a program writes it (`geo$Point` is
// `Point`), for the messages of a derived impl.
#test("geo$Point")["Point"]
#test("Point")["Point"]
fun unqualified(name: str) -> str {
    var start = 0
    var i = 0
    while i < name.len() {
        if name[i] == '$' { start = i + 1 }
        i += 1
    }
    return name[start:]
}

// Whether `t` is `Option<…>`, and its element.
#test(Type.TEnum("Option", [Type.TStr]))[Some(Type.TStr)]
#test(Type.TList(Type.TStr))[None]
fun option_of(t: Type) -> Option<Type> {
    return match t {
        Type.TEnum(n, args) => if n == "Option" && args.len() == 1 { Some(args[0]) } else { None },
        _ => None,
    }
}

// A format a derive writes impls for (D172): `Json` (std.json, MYLA-385) or
// `Toml` (std.toml, MYLA-407). `name` is the derive's, the value enum's and
// the traits' (`ToJson`, `FromJson`), `method` the functions' (`to_json`,
// `from_json`), `table` the value's variant a struct is (`Object`, `Table`)
// and `table_word` what it is in words; without `null` (TOML) an `Option`
// is only a struct's field, left out when `None`.
struct Serial {
    name: str,
    method: str,
    title: str,
    table: str,
    table_word: str,
    has_null: bool,
}

fun json_serial() -> Serial {
    return Serial { name: "Json", method: "json", title: "JSON", table: "Object", table_word: "an object", has_null: true }
}

fun toml_serial() -> Serial {
    return Serial { name: "Toml", method: "toml", title: "TOML", table: "Table", table_word: "a table", has_null: false }
}

// The source of the derived impls of `f` (`impl ToJson` and `impl
// FromJson`, D172, MYLA-385; `ToToml` and `FromToml`, MYLA-407) of the
// struct `name` with these fields, against the module's names qualified by
// `pre` (`std$json$`, or "" in std.json itself): an object (a table) of the
// fields named as written, an `Option` field left out when `None` and read
// as `None` when absent (or `null`); members it has no field for are
// ignored. Parsed with `parse_qualified`, as the names are the loader's.
#test(json_serial(), "P", [], "std$json$", [("x", Type.TInt(32, true)), ("tag", Type.TEnum("Option", [Type.TStr]))])["impl std$json$ToJson for P {\n    fun to_json(self) -> std$json$Json {\n        var out: [(str, std$json$Json)] = []\n        out.push((\"x\", self.x.to_json()))\n        if let Some(v) = self.tag {\n            out.push((\"tag\", v.to_json()))\n        }\n        return std$json$Json.Object(out)\n    }\n}\n\nimpl std$json$FromJson for P {\n    fun from_json(j: std$json$Json) -> Result<P, std$json$JsonError> {\n        let fields = std$json$members(j, \"P\")?\n        return Ok(P {\n            x: std$json$member<int32>(fields, \"x\")?,\n            tag: std$json$optional_member<str>(fields, \"tag\")?,\n        })\n    }\n}\n"]
#test(json_serial(), "m$E", [], "", [])["impl ToJson for m$E {\n    fun to_json(self) -> Json {\n        var out: [(str, Json)] = []\n        return Json.Object(out)\n    }\n}\n\nimpl FromJson for m$E {\n    fun from_json(j: Json) -> Result<m$E, JsonError> {\n        let fields = members(j, \"E\")?\n        return Ok(m$E {\n        })\n    }\n}\n"]
#test(json_serial(), "Box", ["T"], "", [("v", Type.TParam("T"))])["impl<T: ToJson> ToJson for Box<T> {\n    fun to_json(self) -> Json {\n        var out: [(str, Json)] = []\n        out.push((\"v\", self.v.to_json()))\n        return Json.Object(out)\n    }\n}\n\nimpl<T: FromJson> FromJson for Box<T> {\n    fun from_json(j: Json) -> Result<Box<T>, JsonError> {\n        let fields = members(j, \"Box\")?\n        return Ok(Box {\n            v: member<T>(fields, \"v\")?,\n        })\n    }\n}\n"]
#test(toml_serial(), "P", [], "std$toml$", [("x", Type.TInt(32, true)), ("tag", Type.TEnum("Option", [Type.TStr]))])["impl std$toml$ToToml for P {\n    fun to_toml(self) -> std$toml$Toml {\n        var out: [(str, std$toml$Toml)] = []\n        out.push((\"x\", self.x.to_toml()))\n        if let Some(v) = self.tag {\n            out.push((\"tag\", v.to_toml()))\n        }\n        return std$toml$Toml.Table(out)\n    }\n}\n\nimpl std$toml$FromToml for P {\n    fun from_toml(j: std$toml$Toml) -> Result<P, std$toml$TomlError> {\n        let fields = std$toml$members(j, \"P\")?\n        return Ok(P {\n            x: std$toml$member<int32>(fields, \"x\")?,\n            tag: std$toml$optional_member<str>(fields, \"tag\")?,\n        })\n    }\n}\n"]
fun derived_struct_src(f: Serial, name: str, tps: [str], pre: str, fields: [(str, Type)]) -> str {
    let full = with_params(name, tps)
    let to_trait = f"{pre}To{f.name}"
    let from_trait = f"{pre}From{f.name}"
    let value = pre + f.name
    var sb = StringBuilder()
    sb.append(f"impl{bounded_params(tps, to_trait)} {to_trait} for {full} {{\n    fun to_{f.method}(self) -> {value} {{\n")
    sb.append(f"        var out: [(str, {value})] = []\n")
    for fd in fields {
        match option_of(fd.1) {
            Some(t) => { sb.append(f"        if let Some(v) = self.{fd.0} {{\n            out.push((\"{fd.0}\", v.to_{f.method}()))\n        }}\n") },
            None => { sb.append(f"        out.push((\"{fd.0}\", self.{fd.0}.to_{f.method}()))\n") },
        }
    }
    sb.append(f"        return {value}.{f.table}(out)\n    }}\n}}\n\n")
    sb.append(f"impl{bounded_params(tps, from_trait)} {from_trait} for {full} {{\n    fun from_{f.method}(j: {value}) -> Result<{full}, {value}Error> {{\n")
    sb.append(f"        let fields = {pre}members(j, \"{unqualified(name)}\")?\n        return Ok({name} {{\n")
    for fd in fields {
        match option_of(fd.1) {
            Some(t) => { sb.append(f"            {fd.0}: {pre}optional_member<{type_name(t)}>(fields, \"{fd.0}\")?,\n") },
            None => { sb.append(f"            {fd.0}: {pre}member<{type_name(fd.1)}>(fields, \"{fd.0}\")?,\n") },
        }
    }
    sb.append("        })\n    }\n}\n")
    return sb.build()
}

// The source of the derived impls of the enum `name` with these variants
// (each its name and payload), externally tagged: `"Red"` for a variant
// without payload, `{"Dot": x}` for one with one, `{"Line": [a, b]}` for
// one with more (`{ Dot = x }`, `{ Line = [a, b] }` in TOML).
#test(json_serial(), "E", [], "std$json$", [("A", []), ("B", [Type.TStr]), ("C", [Type.TInt(32, true), Type.TList(Type.TBool)])])["impl std$json$ToJson for E {\n    fun to_json(self) -> std$json$Json {\n        return match self {\n            A => std$json$Json.Str(\"A\")\n            B(field0) => std$json$Json.Object([(\"B\", field0.to_json())])\n            C(field0, field1) => std$json$Json.Object([(\"C\", std$json$Json.Array([field0.to_json(), field1.to_json()]))])\n        }\n    }\n}\n\nimpl std$json$FromJson for E {\n    fun from_json(j: std$json$Json) -> Result<E, std$json$JsonError> {\n        let v = std$json$variant_of(j, \"E\")?\n        return match v.0 {\n            \"A\" => std$json$unit_variant(v, \"E\", E.A)\n            \"B\" => Ok(E.B(std$json$payload<str>(v, \"E\", 1, 0)?))\n            \"C\" => Ok(E.C(std$json$payload<int32>(v, \"E\", 2, 0)?, std$json$payload<[bool]>(v, \"E\", 2, 1)?))\n            _ => Err(std$json$unknown_variant(v.0, \"E\", [\"A\", \"B\", \"C\"]))\n        }\n    }\n}\n"]
#test(toml_serial(), "E", ["T"], "", [("A", []), ("B", [Type.TParam("T"), Type.TStr])])["impl<T: ToToml> ToToml for E<T> {\n    fun to_toml(self) -> Toml {\n        return match self {\n            A => Toml.Str(\"A\")\n            B(field0, field1) => Toml.Table([(\"B\", Toml.Array([field0.to_toml(), field1.to_toml()]))])\n        }\n    }\n}\n\nimpl<T: FromToml> FromToml for E<T> {\n    fun from_toml(j: Toml) -> Result<E<T>, TomlError> {\n        let v = variant_of(j, \"E\")?\n        return match v.0 {\n            \"A\" => unit_variant(v, \"E\", E.A)\n            \"B\" => Ok(E.B(payload<T>(v, \"E\", 2, 0)?, payload<str>(v, \"E\", 2, 1)?))\n            _ => Err(unknown_variant(v.0, \"E\", [\"A\", \"B\"]))\n        }\n    }\n}\n"]
fun derived_enum_src(f: Serial, name: str, tps: [str], pre: str, variants: [(str, [Type])]) -> str {
    let shown = unqualified(name)
    let full = with_params(name, tps)
    let to_trait = f"{pre}To{f.name}"
    let from_trait = f"{pre}From{f.name}"
    let value = pre + f.name
    var sb = StringBuilder()
    sb.append(f"impl{bounded_params(tps, to_trait)} {to_trait} for {full} {{\n    fun to_{f.method}(self) -> {value} {{\n        return match self {{\n")
    for v in variants {
        let n = v.1.len()
        if n == 0 {
            sb.append(f"            {v.0} => {value}.Str(\"{v.0}\")\n")
            continue
        }
        var binds: [str] = []
        var items: [str] = []
        var k = 0
        while k < n {
            binds.push(f"field{k}")
            items.push(f"field{k}.to_{f.method}()")
            k += 1
        }
        var payload = items[0]
        if n > 1 { payload = f"{value}.Array([{items.join(", ")}])" }
        sb.append(f"            {v.0}({binds.join(", ")}) => {value}.{f.table}([(\"{v.0}\", {payload})])\n")
    }
    sb.append("        }\n    }\n}\n\n")
    sb.append(f"impl{bounded_params(tps, from_trait)} {from_trait} for {full} {{\n    fun from_{f.method}(j: {value}) -> Result<{full}, {value}Error> {{\n")
    sb.append(f"        let v = {pre}variant_of(j, \"{shown}\")?\n        return match v.0 {{\n")
    var names: [str] = []
    for v in variants {
        names.push(f"\"{v.0}\"")
        let n = v.1.len()
        if n == 0 {
            sb.append(f"            \"{v.0}\" => {pre}unit_variant(v, \"{shown}\", {name}.{v.0})\n")
            continue
        }
        var args: [str] = []
        var k = 0
        for t in v.1 {
            args.push(f"{pre}payload<{type_name(t)}>(v, \"{shown}\", {n}, {k})?")
            k += 1
        }
        sb.append(f"            \"{v.0}\" => Ok({name}.{v.0}({args.join(", ")}))\n")
    }
    sb.append(f"            _ => Err({pre}unknown_variant(v.0, \"{shown}\", [{names.join(", ")}]))\n")
    sb.append("        }\n    }\n}\n")
    return sb.build()
}

// Whether a value of type `t` can be in a derived impl of `f`: a scalar, a
// string, the format's value (`Json`, `Toml`), a list, a map with `str`
// keys, an `Option` (JSON only: TOML has no null), or a type in `names`
// (derived or with both impls written) whose arguments are.
#test(json_serial(), Type.TMap(Type.TStr, Type.TList(Type.TFloat(32))), [])[true]
#test(json_serial(), Type.TMap(Type.TInt(32, true), Type.TStr), [])[false]
#test(json_serial(), Type.TTuple([Type.TStr]), [])[false]
#test(json_serial(), Type.TEnum("Option", [Type.TStruct("P", [])]), ["P"])[true]
#test(json_serial(), Type.TStruct("Q", []), ["P"])[false]
#test(toml_serial(), Type.TEnum("Option", [Type.TStr]), [])[false]
#test(toml_serial(), Type.TList(Type.TStruct("P", [])), ["P"])[true]
fun is_serial_type(f: Serial, t: Type, names: [str]) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TFloat(w) => true,
        Type.TBool => true,
        Type.TStr => true,
        Type.TChar => true,
        Type.TError => true,          // has had its error (MYLA-110)
        Type.TList(e) => is_serial_type(f, e, names),
        Type.TMap(k, v) => match k { Type.TStr => is_serial_type(f, v, names), _ => false },
        Type.TStruct(n, a) => contains_str(names, n) && all_serial_types(f, a, names),
        Type.TEnum(n, a) => ((n == "Option" && f.has_null) || contains_str(names, n)) && all_serial_types(f, a, names),
        Type.TParam(n) => true,
        _ => false,
    }
}

fun all_serial_types(f: Serial, ts: [Type], names: [str]) -> bool {
    for t in ts {
        if !is_serial_type(f, t, names) { return false }
    }
    return true
}

// Whether a struct's field of type `t` can be in a derived impl of `f`: an
// `Option` of such a type too, left out when `None`.
#test(toml_serial(), Type.TEnum("Option", [Type.TStr]), [])[true]
#test(toml_serial(), Type.TEnum("Option", [Type.TEnum("Option", [Type.TStr])]), [])[false]
fun serial_field_ok(f: Serial, t: Type, names: [str]) -> bool {
    if f.has_null { return is_serial_type(f, t, names) }
    return match option_of(t) {
        Some(inner) => is_serial_type(f, inner, names)
        None => is_serial_type(f, t, names)
    }
}

// What a refusal of a field of type `t` for `f` adds: why a map, a tuple or
// (in TOML) an `Option` isn't.
#test(json_serial(), Type.TMap(Type.TInt(32, true), Type.TStr))[" (a map is an object only with 'str' keys)"]
#test(json_serial(), Type.TStr)[""]
#test(toml_serial(), Type.TList(Type.TEnum("Option", [Type.TInt(32, true)])))[" (TOML has no null: an 'Option' can only be a struct's field, left out when 'None')"]
#test(toml_serial(), Type.TTuple([Type.TStr]))[" (a tuple has no TOML form: make it a struct)"]
#test(toml_serial(), Type.TMap(Type.TInt(32, true), Type.TStr))[" (a map is a table only with 'str' keys)"]
fun serial_note(f: Serial, t: Type) -> str {
    if !f.has_null && holds_option(t) { return f" ({f.title} has no null: an 'Option' can only be a struct's field, left out when 'None')" }
    return match t {
        Type.TMap(k, v) => match k { Type.TStr => "", _ => f" (a map is {f.table_word} only with 'str' keys)" },
        Type.TTuple(es) => f" (a tuple has no {f.title} form: make it a struct)",
        _ => "",
    }
}

// Whether `t` is or holds an `Option` (in a list, a map or a type's
// arguments).
#test(Type.TMap(Type.TStr, Type.TEnum("Option", [Type.TStr])))[true]
#test(Type.TList(Type.TStr))[false]
fun holds_option(t: Type) -> bool {
    return match t {
        Type.TEnum(n, a) => n == "Option" || any_holds_option(a),
        Type.TStruct(n, a) => any_holds_option(a),
        Type.TList(e) => holds_option(e),
        Type.TMap(k, v) => holds_option(k) || holds_option(v),
        _ => false,
    }
}

fun any_holds_option(ts: [Type]) -> bool {
    for t in ts {
        if holds_option(t) { return true }
    }
    return false
}

// The impl `d` (`impl Hash for Derived`), for the type `name` instead.
fun impl_for(d: Decl, name: str) -> Decl {
    return match d.kind {
        DeclKind.ImplDecl(tg, m, tp, tn, ta, dattrs) => Decl { id: d.id, line: d.line, col: d.col, sp: d.sp, kind: DeclKind.ImplDecl(TypeExpr { id: tg.id, line: tg.line, col: tg.col, sp: tg.sp, kind: TypeKind.TRef(name, []) }, m, tp, tn, ta, dattrs) },
        _ => d,
    }
}

#test([Type.TInt(32, true), Type.TStr], [])[true]
#test([Type.TStruct("Bare", [])], ["Holder"])[false]
fun all_eq_types(ts: [Type], eq_names: [str]) -> bool {
    for t in ts {
        if !is_eq_type(t, eq_names) { return false }
    }
    return true
}

impl Checker {
    #test(checker_on("[int]"))[Ok(0)]
    fun synthesize_derives(var self) -> Result<int32, CheckErr> {
        var targets: [Decl] = []
        var target_pos: [int32] = []
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if self.skipped_decls.contains(pos) { continue }
            self.cur_decl = decl.id
            let attrs = decl_attrs(decl)
            let is_se = match decl.kind { DeclKind.StructDecl(n, f, a, t, p, act) => true, DeclKind.EnumDecl(n, v, a, t, p) => true, _ => false }
            for attr in attrs {
                if attr.name != "derive" { continue }
                match self.check_derive_attr(decl, attr) {
                    Ok(x) => {
                        // by its place: `check_program` numbers the prelude's
                        // nodes from 0 as the program's, so their ids meet
                        // (the prelude's `Option` derives, MYLA-379)
                        if !target_pos.contains(pos) {
                            targets.push(decl)
                            target_pos.push(pos)
                        }
                    },
                    Err(e) => {
                        self.record(e)?
                        // Eq is broken for the type: its uses stop silently (MYLA-110)
                        if is_se {
                            self.broken_impls["Eq\t" + decl_kind_name(decl)] = true
                            self.broken_impls["Hash\t" + decl_kind_name(decl)] = true
                            self.mark_json_broken(decl_kind_name(decl))
                        }
                    },
                }
            }
        }
        if targets.len() == 0 { return Ok(0) }
        var eq_targets: [Decl] = []
        var hash_targets: [Decl] = []
        var json_targets: [Decl] = []
        var toml_targets: [Decl] = []
        for d in targets {
            if derives(decl_attrs(d), "Eq") { eq_targets.push(d) }
            if derives(decl_attrs(d), "Hash") { hash_targets.push(d) }
            if derives(decl_attrs(d), "Json") { json_targets.push(d) }
            if derives(decl_attrs(d), "Toml") { toml_targets.push(d) }
        }
        var eq_names: [str] = []
        for d in eq_targets { eq_names.push(decl_kind_name(d)) }
        // an `impl Eq` for a type that doesn't exist may have been meant for
        // any of them: a type that isn't Eq is then no news (MYLA-110)
        var lost_eq = false
        // the targets of the explicit impls, found once, not once a target
        var explicit_eq: [str: bool] = [:]
        for d in self.impl_decls {
            match impl_eq_target_name(d) {
                Some(nm) => {
                    if !contains_str(eq_names, nm) { eq_names.push(nm) }
                    if !self.names_a_type(nm) { lost_eq = true }
                    explicit_eq[nm] = true
                },
                None => {},
            }
        }
        for decl in eq_targets {
            self.cur_decl = decl.id
            let name = decl_kind_name(decl)
            // explicit `impl Eq for name`? (it stands)
            if explicit_eq.contains(name) {
                self.record(terr_at(decl.line, decl.col, decl.sp, format("type '{}' both derives Eq and has an explicit 'impl Eq for {}'", name, name)))?
                continue
            }
            match self.check_derivable_eq(decl, name, eq_names) {
                Ok(x) => {},
                Err(e) => {
                    if !lost_eq { self.record(e)? }
                    self.broken_impls["Eq\t" + name] = true
                    continue
                },
            }
            let tps = self.type_params_of(name)
            if tps.len() > 0 {
                // a generic type's: an impl bounded by `T: Eq`, written as
                // source and checked and run as any other (MYLA-379)
                self.add_derived_impl(derived_eq_src(name, tps, self.derived_parts(name)), "Eq")
                self.prelude_waits(name)
                continue
            }
            // compared member by member: a member's `Option` or `Result`
            // by its `eq` (D182)
            self.members_need(name)
            // register the synthesized Eq impl: method `eq: (Self,Self)->bool`
            var self_t = Type.TEnum(name, [])
            if self.is_struct(name) { self_t = Type.TStruct(name, []) }
            let fdecl = FunData { line: decl.line, col: decl.col, sp: no_span(), name: format("{}.eq", name), params: [], ret_type: None, body: None, attributes: [], type_params: [], receiver: Some("self"), is_pub: false, is_async: false }
            let sig = FuncSig { name: format("{}.eq", name), params: [self_t, self_t], ret: Some(Type.TBool), type_params: [], own_type_params: 0, bounds: [], decl: fdecl, has_decl: true, decl_id: decl.id }
            self.add_method(MethodEntry { key: name, name: "eq", sig: sig })
            self.trait_impls.push(TraitImplPair { trait_name: "Eq", key: name })
            self.user_trait_impls.push(TraitImplPair { trait_name: "Eq", key: name })
        }
        if hash_targets.len() > 0 { self.derive_hashes(hash_targets, eq_names)? }
        if json_targets.len() > 0 { self.derive_serial(json_serial(), json_targets)? }
        if toml_targets.len() > 0 { self.derive_serial(toml_serial(), toml_targets)? }
        return Ok(0)
    }

    // `#derive(Hash)` (D163, MYLA-313) of each of `targets`: an `impl Hash`
    // written for it, as source, and checked and run as any other, its
    // fields added in order (`h.add(self.x).add(self.y)`), an enum's variant
    // index first and then its payload. The type must be `Eq` (`eq_names`,
    // derived or written) and its fields `Hash`; a float field isn't.
    fun derive_hashes(var self, targets: [Decl], eq_names: [str]) -> Result<int32, CheckErr> {
        var hash_names: [str] = []
        for d in targets { hash_names.push(decl_kind_name(d)) }
        var lost = false
        var has_hasher = false
        var explicit_hash: [str: bool] = [:]
        for d in self.impl_decls {
            match impl_target_name(d, "Hash") {
                Some(nm) => {
                    if !contains_str(hash_names, nm) { hash_names.push(nm) }
                    if !self.names_a_type(nm) { lost = true }
                    explicit_hash[nm] = true
                },
                None => {},
            }
            if impl_of_type(d, "Hasher") { has_hasher = true }
        }
        for decl in targets {
            self.cur_decl = decl.id
            let name = decl_kind_name(decl)
            if explicit_hash.contains(name) {
                self.record(terr_at(decl.line, decl.col, decl.sp, format("type '{}' both derives Hash and has an explicit 'impl Hash for {}'", name, name)))?
                continue
            }
            if self.broken_impls.contains("Eq\t" + name) {
                // its Eq failed, with its own error
                self.broken_impls["Hash\t" + name] = true
                continue
            }
            if !contains_str(eq_names, name) {
                self.record(terr_at(decl.line, decl.col, decl.sp, format("cannot derive Hash for '{}': it isn't Eq; derive both, '#derive(Eq, Hash)', or write 'impl Eq for {}'", name, name)))?
                self.broken_impls["Hash\t" + name] = true
                continue
            }
            match self.check_derivable_hash(decl, name, hash_names) {
                Ok(x) => {},
                Err(e) => {
                    if !lost { self.record(e)? }
                    self.broken_impls["Hash\t" + name] = true
                    continue
                },
            }
            if !has_hasher {
                // without std.hash (a module of `std` that doesn't import
                // it, a program checked without the standard library) the
                // type is `Hash`, a map's key, but has no `hash` to call:
                // the runners hash a derived key by its members
                self.trait_impls.push(TraitImplPair { trait_name: "Hash", key: name })
                self.user_trait_impls.push(TraitImplPair { trait_name: "Hash", key: name })
                let gtps = self.type_params_of(name)
                if gtps.len() > 0 {
                    // a generic type's arguments `Hash` too (MYLA-379)
                    var params: [Type] = []
                    var bounds: [Bound] = []
                    for t in gtps {
                        params.push(Type.TParam(t))
                        bounds.push(Bound { tp: t, traits: ["Hash"], args: [[]] })
                    }
                    var target = Type.TEnum(name, params)
                    if self.is_struct(name) { target = Type.TStruct(name, params) }
                    self.impl_bounds["Hash\t" + name] = ImplBounds { target: target, bounds: bounds }
                }
                continue
            }
            let tps = self.type_params_of(name)
            if tps.len() > 0 {
                // a generic type's, bounded, against the linked program's names (MYLA-379)
                self.add_derived_impl(derived_hash_src(f"impl{bounded_params(tps, "Hash")} Hash for {with_params(name, tps)}", self.derived_parts(name)), "Hash")
                // the prelude's (D182): its body, and std.hash's methods it
                // calls, checked once a type that holds one is hashed
                self.prelude_waits(name)
                continue
            }
            let src = derived_hash_src("impl Hash for Derived", self.derived_parts(name))
            match parse_source(src, self.next_id) {
                Ok(p) => {
                    self.next_id = p.next_id
                    for d in p.program.decls {
                        let made = impl_for(d, name)
                        self.decls.push(made)
                        self.impl_decls.push(made)
                    }
                },
                Err(d) => { panic("a derived Hash impl does not parse") },
            }
        }
        return Ok(0)
    }

    // The type parameters of the struct or enum `name`.
    #test(checker_on("enum E<T> { A(T) }"), "E")[["T"]]
    #test(checker_on("struct P { x: int }"), "P")[[]]
    fun type_params_of(self, name: str) -> [str] {
        let si = self.struct_idx(name)
        if si >= 0 { return self.structs[si].type_params }
        let ei = self.enum_idx(name)
        if ei >= 0 { return self.enums[ei].type_params }
        return []
    }

    // The impl `src` a derive of `trnm` wrote, against the linked program's
    // names (`parse_qualified`), among the declarations: its impls are
    // resolved after the derives (MYLA-379).
    fun add_derived_impl(var self, src: str, trnm: str) {
        match parse_qualified(src, self.next_id) {
            Ok(p) => {
                self.next_id = p.next_id
                for d in p.program.decls {
                    self.decls.push(d)
                    self.impl_decls.push(d)
                }
            },
            Err(d) => { panic(f"a derived {trnm} impl does not parse: {d.msg}\n{src}") },
        }
    }

    // How std.json's names are qualified in the linked program: `std$json$`
    // when a program imports it, "" when std.json itself is checked, none
    // without it.
    #test(checker_on("[int]"))[None]
    fun json_prefix(self) -> Option<str> {
        return self.serial_prefix(json_serial())
    }

    // How the names of `f`'s module (std.json, std.toml) are qualified (see
    // `json_prefix`).
    #test(checker_on("[int]"), toml_serial())[None]
    fun serial_prefix(self, f: Serial) -> Option<str> {
        for pre in [f"std${f.method}$", ""] {
            if self.trait_idx(f"{pre}To{f.name}") >= 0 && self.trait_idx(f"{pre}From{f.name}") >= 0 && self.enum_idx(pre + f.name) >= 0 && self.func_idx(pre + "unknown_variant") >= 0 {
                return Some(pre)
            }
        }
        return None
    }

    // The help for a struct or enum `t` that isn't std.json's or std.toml's
    // trait `trnm`: the derive that gives it one.
    #test(checker_on("struct P { x: int }"), Type.TStruct("P", []), "ToJson")[[]]
    fun json_help(self, t: Type, trnm: str) -> [Note] {
        let name = match t {
            Type.TStruct(n, a) => n,
            Type.TEnum(n, a) => n,
            _ => "",
        }
        for f in [json_serial(), toml_serial()] {
            match self.serial_prefix(f) {
                Some(pre) => {
                    if name != "" && (trnm == f"{pre}To{f.name}" || trnm == f"{pre}From{f.name}") {
                        return [Note { label: "help", msg: f"'#derive({f.name})' on '{name}' gives it 'To{f.name}' and 'From{f.name}' (D172)", line: 0, col: 0, sp: no_span() }]
                    }
                },
                None => {},
            }
        }
        return []
    }

    // `name`'s `ToJson` and `FromJson` (and `ToToml` and `FromToml`) are
    // broken: their uses stop silently (MYLA-110).
    fun mark_json_broken(var self, name: str) {
        for f in [json_serial(), toml_serial()] { self.mark_serial_broken(f, name) }
    }

    fun mark_serial_broken(var self, f: Serial, name: str) {
        match self.serial_prefix(f) {
            Some(pre) => {
                self.broken_impls[f"{pre}To{f.name}\t{name}"] = true
                self.broken_impls[f"{pre}From{f.name}\t{name}"] = true
            },
            None => {},
        }
    }

    // `#derive(Json)` (D172, MYLA-385) or `#derive(Toml)` (MYLA-407), `f`,
    // of each of `targets`: an `impl ToJson` and an `impl FromJson` written
    // for it as source (`derived_struct_src`, `derived_enum_src`) against
    // std.json (std.toml), which the program must import, and checked and
    // run as any other. Its fields' types must have both impls (built-in,
    // derived or written).
    fun derive_serial(var self, f: Serial, targets: [Decl]) -> Result<int32, CheckErr> {
        let to_trait = f"To{f.name}"
        let from_trait = f"From{f.name}"
        let pre = match self.serial_prefix(f) {
            Some(p) => p,
            None => {
                for decl in targets {
                    self.cur_decl = decl.id
                    self.record(terr_at(decl.line, decl.col, decl.sp, f"cannot derive {f.name} for '{decl_kind_name(decl)}': std.{f.method} isn't imported (write 'import std.{f.method} as {f.method}')"))?
                }
                return Ok(0)
            },
        }
        var names: [str] = [pre + f.name]
        for d in targets { names.push(decl_kind_name(d)) }
        // a type with both impls written
        for d in self.impl_decls {
            match impl_target_name(d, pre + to_trait) {
                Some(nm) => {
                    for e in self.impl_decls {
                        match impl_target_name(e, pre + from_trait) {
                            Some(other) => { if other == nm && !contains_str(names, nm) { names.push(nm) } },
                            None => {},
                        }
                    }
                },
                None => {},
            }
        }
        for decl in targets {
            self.cur_decl = decl.id
            let name = decl_kind_name(decl)
            var explicit = ""
            for d in self.impl_decls {
                for trnm in [to_trait, from_trait] {
                    match impl_target_name(d, pre + trnm) {
                        Some(nm) => { if nm == name { explicit = trnm } },
                        None => {},
                    }
                }
            }
            if explicit != "" {
                self.record(terr_at(decl.line, decl.col, decl.sp, f"type '{name}' both derives {f.name} and has an explicit 'impl {explicit} for {name}'"))?
                continue
            }
            match self.check_derivable_serial(f, decl, name, names) {
                Ok(x) => {},
                Err(e) => {
                    self.record(e)?
                    self.mark_serial_broken(f, name)
                    continue
                },
            }
            var src = ""
            let si = self.struct_idx(name)
            if si >= 0 {
                var fields: [(str, Type)] = []
                for fd in self.structs[si].fields { fields.push((fd.name, fd.ty)) }
                src = derived_struct_src(f, name, self.type_params_of(name), pre, fields)
            } else {
                var variants: [(str, [Type])] = []
                let ei = self.enum_idx(name)
                if ei >= 0 {
                    for v in self.enums[ei].variants { variants.push((v.name, v.payload)) }
                }
                src = derived_enum_src(f, name, self.type_params_of(name), pre, variants)
            }
            match parse_qualified(src, self.next_id) {
                Ok(p) => {
                    self.next_id = p.next_id
                    for d in p.program.decls {
                        self.decls.push(d)
                        self.impl_decls.push(d)
                    }
                },
                Err(d) => { panic(f"a derived {f.name} impl does not parse: {d.msg}\n{src}") },
            }
        }
        return Ok(0)
    }

    fun check_derivable_serial(self, f: Serial, decl: Decl, name: str, names: [str]) -> Result<int32, CheckErr> {
        let si = self.struct_idx(name)
        if si >= 0 {
            for fd in self.structs[si].fields {
                if serial_field_ok(f, fd.ty, names) { continue }
                // what is wrong is inside a field's `Option`, which may be one
                var inner = fd.ty
                if !f.has_null {
                    match option_of(fd.ty) {
                        Some(t) => { inner = t },
                        None => {},
                    }
                }
                return Err(terr_at(decl.line, decl.col, decl.sp, f"cannot derive {f.name} for struct '{name}': field '{fd.name}' has type '{type_name(fd.ty)}', which isn't To{f.name} and From{f.name}{serial_note(f, inner)}"))
            }
            return Ok(0)
        }
        let ei = self.enum_idx(name)
        if ei >= 0 {
            for v in self.enums[ei].variants {
                var i = 0
                for pt in v.payload {
                    if !is_serial_type(f, pt, names) { return Err(terr_at(decl.line, decl.col, decl.sp, f"cannot derive {f.name} for enum '{name}': payload #{i} of variant '{v.name}' has type '{type_name(pt)}', which isn't To{f.name} and From{f.name}{serial_note(f, pt)}")) }
                    i = i + 1
                }
            }
        }
        return Ok(0)
    }

    // What a derived `hash` of the struct or enum `name` adds: a struct's
    // field names; an enum's variants, each its name and payload's length.
    #test(checker_on("enum E { A, B(int, str) }"), "E")[[("A", 0), ("B", 2)]]
    #test(checker_on("struct P { x: int, y: str }"), "P")[[("x", -1), ("y", -1)]]
    fun derived_parts(self, name: str) -> [(str, int32)] {
        var out: [(str, int32)] = []
        let si = self.struct_idx(name)
        if si >= 0 {
            for f in self.structs[si].fields { out.push((f.name, -1)) }
            return out
        }
        let ei = self.enum_idx(name)
        if ei >= 0 {
            for v in self.enums[ei].variants { out.push((v.name, v.payload.len() as int32)) }
        }
        return out
    }

    fun check_derivable_hash(self, decl: Decl, name: str, hash_names: [str]) -> Result<int32, CheckErr> {
        let si = self.struct_idx(name)
        if si >= 0 {
            for f in self.structs[si].fields {
                if !is_hash_type(f.ty, hash_names) { return Err(terr_at(decl.line, decl.col, decl.sp, format("cannot derive Hash for struct '{}': field '{}' has type '{}', which isn't Hash{}", name, f.name, type_name(f.ty), float_note(f.ty)))) }
            }
            return Ok(0)
        }
        let ei = self.enum_idx(name)
        if ei >= 0 {
            for v in self.enums[ei].variants {
                var i = 0
                for pt in v.payload {
                    if !is_hash_type(pt, hash_names) { return Err(terr_at(decl.line, decl.col, decl.sp, format("cannot derive Hash for enum '{}': payload #{} of variant '{}' has type '{}', which isn't Hash{}", name, i, v.name, type_name(pt), float_note(pt)))) }
                    i = i + 1
                }
            }
        }
        return Ok(0)
    }

    fun check_derive_attr(self, decl: Decl, attr: Attribute) -> Result<int32, CheckErr> {
        let is_se = match decl.kind { DeclKind.StructDecl(n, f, a, t, p, act) => true, DeclKind.EnumDecl(n, v, a, t, p) => true, _ => false }
        if !is_se { return Err(terr_at(attr.line, attr.col, attr.sp, "'#derive' may only be applied to a struct or enum")) }
        return self.validate_derive_attr(attr)
    }

    // Whether `name` is a type the program or the language declares.
    #test(checker_on("[int]"), "Vec2")[false]
    fun names_a_type(self, name: str) -> bool {
        if self.struct_idx(name) >= 0 || self.enum_idx(name) >= 0 || self.alias_idx(name) >= 0 { return true }
        match prim_type(name) { Some(t) => { return true }, None => {} }
        return name == "int" || name == "float"
    }

    #test(checker_on("[int]"), Attribute { line: 5, col: 1, sp: SrcSpan { sline: 5, scol: 1, eline: 5, ecol: 12 }, name: "derive", args: [Expr { id: 2, line: 5, col: 9, sp: SrcSpan { sline: 5, scol: 9, eline: 5, ecol: 11 }, kind: ExprKind.Name("Eq") }], outputs: None , label: ""})[Ok(0)]
    fun validate_derive_attr(self, attr: Attribute) -> Result<int32, CheckErr> {
        match attr.outputs { Some(x) => { return Err(terr_at(attr.line, attr.col, attr.sp, "'#derive' takes trait names in parentheses, e.g. #derive(Eq)")) }, None => {} }
        if attr.args.len() == 0 { return Err(terr_at(attr.line, attr.col, attr.sp, "'#derive' needs at least one trait, e.g. #derive(Eq)")) }
        for a in attr.args {
            match a.kind {
                ExprKind.Name(id) => { if id != "Eq" && id != "Hash" && id != "Json" && id != "Toml" { return Err(terr_at(a.line, a.col, a.sp, format("cannot derive '{}': only 'Eq', 'Hash', 'Json' and 'Toml' are derivable", id))) } },
                _ => { return Err(terr_at(a.line, a.col, a.sp, "'#derive' arguments must be trait names")) },
            }
        }
        return Ok(0)
    }

    fun check_derivable_eq(self, decl: Decl, name: str, eq_names: [str]) -> Result<int32, CheckErr> {
        let si = self.struct_idx(name)
        if si >= 0 {
            for f in self.structs[si].fields { if !is_eq_type(f.ty, eq_names) { return Err(terr_at(decl.line, decl.col, decl.sp, format("cannot derive Eq for struct '{}': field '{}' has type '{}', which is not Eq", name, f.name, type_name(f.ty)))) } }
            return Ok(0)
        }
        let ei = self.enum_idx(name)
        if ei >= 0 {
            for v in self.enums[ei].variants {
                var i = 0
                for pt in v.payload {
                    if !is_eq_type(pt, eq_names) { return Err(terr_at(decl.line, decl.col, decl.sp, format("cannot derive Eq for enum '{}': payload #{} of variant '{}' has type '{}', which is not Eq", name, i, v.name, type_name(pt)))) }
                    i = i + 1
                }
            }
        }
        return Ok(0)
    }
}

// The warnings `#allow` can silence (D161), each by the name its output
// shows (`warning[primitive]: …`, `diag.warning_name`).
#test()[["primitive", "reentrancy"]]
fun warning_names() -> [str] {
    return ["primitive", "reentrancy"]
}

#test("primitive")[true]
#test("unused")[false]
fun is_warning_name(n: str) -> bool {
    return contains_str(warning_names(), n)
}

// The `#allow` attributes among `attrs`.
fun allow_attrs(attrs: [Attribute]) -> [Attribute] {
    var out: [Attribute] = []
    for a in attrs { if a.name == "allow" { out.push(a) } }
    return out
}

fun concat_attrs(a: [Attribute], b: [Attribute]) -> [Attribute] {
    var out = a
    for x in b { out.push(x) }
    return out
}

// What the `#allow`s among `attrs` silence: a warning's name, or
// `primitive:__name` for one primitive.
fun allowed_warnings(attrs: [Attribute]) -> [str] {
    var out: [str] = []
    for attr in allow_attrs(attrs) {
        for a in attr.args {
            match a.kind {
                ExprKind.Name(n) => { out.push(n) },
                ExprKind.Call(callee, prims, _) => {
                    for p in prims {
                        match p.kind { ExprKind.Name(n) => { out.push("primitive:" + n) }, _ => {} }
                    }
                },
                _ => {},
            }
        }
    }
    return out
}

fun decl_attrs(d: Decl) -> [Attribute] {
    return match d.kind {
        DeclKind.StructDecl(n, f, a, t, p, act) => a,
        DeclKind.EnumDecl(n, v, a, t, p) => a,
        DeclKind.TypeAliasDecl(n, tt, a, p) => a,
        DeclKind.ConstDecl(n, tt, vv, a, p) => a,
        DeclKind.FunDecl(fd) => fd.attributes,
        DeclKind.ImplDecl(t, m, tp, tn, ta, attrs) => attrs,
        DeclKind.TraitDecl(n, m, tp, p, attrs) => attrs,
        _ => empty_attrs(),
    }
}

// =========================================================================
// const folding
// =========================================================================

// A folded const value; float values and values derived from them are not tracked.
pub enum CV { CVInt(int64), CVFloat, CVBool(bool), CVStr(str), CVUnknown }

impl Checker {
    #test(checker_on("[int]"))[Ok(0)]
    fun fold_consts(var self) -> Result<int32, CheckErr> {
        var i = 0
        while i < self.const_decls.len() {
            match self.ensure_const(self.const_decls[i].name) {
                Ok(t) => {},
                Err(e) => { if is_stopped(e) { return Err(e) } },   // its error, if any, is collected
            }
            i = i + 1
        }
        return Ok(0)
    }

    #test(checker_on("[int]"), "H")[-1]
    fun const_done_idx(self, name: str) -> int32 {
        var i = 0
        while i < self.consts.len() { if self.consts[i].name == name { return i }
            i = i + 1
        }
        return -1
    }

    fun ensure_const(var self, name: str) -> Result<Type, CheckErr> {
        let di = self.const_done_idx(name)
        if di >= 0 { return Ok(self.consts[di].ty) }
        let ci = self.const_decl_idx(name)
        let decl = self.const_decls[ci]
        // errors folding it are in the const's file, wherever it is used from
        let outer_decl = self.cur_decl
        if contains_str(self.const_folding, name) { return Err(terr_at(decl.line, decl.col, decl.sp, format("const '{}' is defined in terms of itself", name))) }
        self.cur_decl = decl.id
        self.const_folding.push(name)
        // a const that fails keeps its declared type, if that resolved, and
        // no value: its error is collected here, once, and the consts folded
        // from it fail silently (MYLA-110)
        var declared = Type.TError
        var fail: Option<CheckErr> = None
        match self.resolve0(decl.declared) {
            Ok(t) => {
                if is_type_param(t) { fail = Some(terr_at(decl.line, decl.col, decl.sp, "a const type must be concrete")) }
                else {
                    declared = t
                    if has_error(t) { fail = Some(poisoned()) }
                }
            },
            Err(e) => { fail = Some(e) },
        }
        if match fail { Some(x) => false, None => true } {
            self.push_scope()
            let r = self.expect_value(decl.value, Some(declared))
            self.pop_scope()
            match r {
                Ok(vt) => {
                    if !type_eq(vt, declared) { fail = Some(terr_at(decl.value.line, decl.value.col, decl.value.sp, format("const '{}' is declared '{}' but its value has type '{}'", name, type_name(declared), type_name(vt)))) }
                    else {
                        match self.fold_const_expr(decl.value) {
                            Ok(v) => { self.const_values[name] = v },
                            Err(e) => { fail = Some(e) },
                        }
                    }
                },
                Err(e) => { fail = Some(e) },
            }
        }
        self.const_folding = remove_str(self.const_folding, name)
        self.consts.push(AliasCached { name: name, ty: declared })
        match fail {
            Some(e) => {
                self.failed_consts[name] = true
                self.record(e)?
                self.cur_decl = outer_decl
                return Err(poisoned())
            },
            None => {},
        }
        self.cur_decl = outer_decl
        return Ok(declared)
    }

    // The value of a const initializer, as types.py folds it: integers wrapped
    // to each node's type. Float values aren't tracked (`CVFloat`), so a float
    // cast to an integer folds to an unknown value (`CVUnknown`).
    #test(checker_on("[int]"), Expr { id: 19, line: 14, col: 21, sp: SrcSpan { sline: 14, scol: 21, eline: 14, ecol: 27 }, kind: ExprKind.StrLit("myla") })[Ok(CV.CVStr("myla"))]
    fun fold_const_expr(var self, e: Expr) -> Result<CV, CheckErr> {
        let t = self.node_type(e)
        return match e.kind {
            ExprKind.IntLit(v, suf, isc, big) => {
                if is_char(t) { return Ok(CV.CVInt(v)) }      // a char folds to its codepoint
                Ok(CV.CVInt(wrap_int(v, t)))
            },
            ExprKind.FloatLit(lex, suf) => Ok(CV.CVFloat),
            ExprKind.BoolLit(b) => Ok(CV.CVBool(b)),
            ExprKind.StrLit(s) => Ok(CV.CVStr(s)),
            ExprKind.Name(n) => {
                if self.const_decl_idx(n) < 0 { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is not a constant and cannot appear in a const initializer", n))) }
                self.ensure_const(n)?
                if self.failed_consts.contains(n) { return Err(poisoned()) }
                return match self.const_values.get(n) { Some(v) => Ok(v), None => Ok(CV.CVUnknown) }
            },
            ExprKind.Unary(op, x) => {
                let v = self.fold_const_expr(x)?
                if op == "!" { return Ok(CV.CVBool(!cv_bool(v))) }
                if is_float(t) { return Ok(CV.CVFloat) }
                return match v {
                    CV.CVInt(i) => {
                        // a negative literal is checked as a literal is
                        let literal = match x.kind { ExprKind.IntLit(n, suf, isc, big) => true, _ => false }
                        if op == "-" && !literal && is_int(t) && int_neg_overflows(i, int_width(t), is_signed_int(t)) { return Err(const_overflow(e)) }
                        Ok(CV.CVInt(wrap_int(if_neg(op == "-", i), t)))
                    },
                    _ => Ok(CV.CVUnknown),
                }
            },
            ExprKind.Cast(x, ty) => {
                let v = self.fold_const_expr(x)?
                let src = self.node_type(x)
                if is_float(t) { return Ok(CV.CVFloat) }
                return match v {
                    CV.CVInt(i) => {
                        if is_char(t) { return Ok(CV.CVInt(i)) }
                        Ok(CV.CVInt(wrap_int(i, t)))
                    },
                    _ => Ok(CV.CVUnknown),
                }
            },
            ExprKind.Binary(op, l, r) => self.fold_const_binary(e, op, l, r, t),
            _ => Err(terr_at(e.line, e.col, e.sp, "const initializer must be a constant expression (literals, other consts, and arithmetic/bitwise/comparison/cast operations over them)")),
        }
    }

    #test(checker_on("[int]"), Expr { id: 7, line: 11, col: 25, sp: SrcSpan { sline: 11, scol: 25, eline: 11, ecol: 28 }, kind: ExprKind.Name("KIB") })[Type.TInt(32, true)]
    fun node_type(self, e: Expr) -> Type {
        return match self.resolved.get(e.id) { Some(t) => t, None => t_int() }
    }

    #test(checker_on("fun f(n: int) -> int { return n * 2 }"), expr_of("1 + 2 * 3"), ">", expr_of("1 + 2 * 3"), expr_of("1 + 2 * 3"), Type.TBool)[Ok(CV.CVBool(false))]
    fun fold_const_binary(var self, e: Expr, op: str, l: Expr, r: Expr, t: Type) -> Result<CV, CheckErr> {
        if op == "&&" {
            let lv = self.fold_const_expr(l)?
            if !cv_bool(lv) { return Ok(CV.CVBool(false)) }
            return Ok(CV.CVBool(cv_bool(self.fold_const_expr(r)?)))
        }
        if op == "||" {
            let lv = self.fold_const_expr(l)?
            if cv_bool(lv) { return Ok(CV.CVBool(true)) }
            return Ok(CV.CVBool(cv_bool(self.fold_const_expr(r)?)))
        }
        let lv = self.fold_const_expr(l)?
        let rv = self.fold_const_expr(r)?
        if op == "==" || op == "!=" {
            return match cv_equal(lv, rv) {
                Some(eq) => Ok(CV.CVBool(eq == (op == "=="))),
                None => Ok(CV.CVUnknown),
            }
        }
        if is_float(t) { return Ok(CV.CVFloat) }
        if op == "+" {
            // strings concatenate (the code generator emits a str const's value)
            match (lv, rv) {
                (CV.CVStr(x), CV.CVStr(y)) => { return Ok(CV.CVStr(x + y)) },
                _ => {},
            }
        }
        let li = match lv { CV.CVInt(x) => x, _ => { return Ok(CV.CVUnknown) } }
        let ri = match rv { CV.CVInt(x) => x, _ => { return Ok(CV.CVUnknown) } }
        // an overflow is an error, as a division by zero is (D175): a const
        // has no run to trap in
        if is_int(t) && int_op_overflows(op, li, ri, int_width(t), is_signed_int(t)) { return Err(const_overflow(e)) }
        if op == "+" { return Ok(CV.CVInt(wrap_int(li.wrapping_add(ri), t))) }
        if op == "-" { return Ok(CV.CVInt(wrap_int(li.wrapping_sub(ri), t))) }
        if op == "*" { return Ok(CV.CVInt(wrap_int(li.wrapping_mul(ri), t))) }
        if op == "/" || op == "%" {
            if ri == 0 { return Err(terr_at(e.line, e.col, e.sp, "const division by zero")) }
            if is_u64(t) {
                let q = ((li as uint64) / (ri as uint64)) as int64
                if op == "/" { return Ok(CV.CVInt(q)) }
                return Ok(CV.CVInt(li - q * ri))
            }
            // truncates toward zero, like _const_idiv; by -1 the negation
            // (wrapping only for a `%` of the minimum, whose remainder is 0)
            if ri == -1 { return Ok(CV.CVInt(if op == "/" { wrap_int(li.wrapping_neg(), t) } else { 0 })) }
            let q = li / ri
            if op == "/" { return Ok(CV.CVInt(wrap_int(q, t))) }
            return Ok(CV.CVInt(wrap_int(li - q * ri, t)))
        }
        if op == "&" { return Ok(CV.CVInt(wrap_int(li & ri, t))) }
        if op == "|" { return Ok(CV.CVInt(wrap_int(li | ri, t))) }
        if op == "^" { return Ok(CV.CVInt(wrap_int(li ^ ri, t))) }
        let w = int_width(t) as int64
        if op == "<<" { return Ok(CV.CVInt(wrap_int(li << (ri & (w - 1)), t))) }
        if op == ">>" {
            let lw = wrap_int(li, self.node_type(l))
            if is_u64(t) { return Ok(CV.CVInt(((lw as uint64) >> ((ri & (w - 1)) as uint64)) as int64)) }
            return Ok(CV.CVInt(wrap_int(lw >> (ri & (w - 1)), t)))
        }
        // comparisons, unsigned for uint64 (stored as int64)
        let lt_ = int_less(li, ri, self.node_type(l))
        let gt_ = int_less(ri, li, self.node_type(l))
        if op == "<" { return Ok(CV.CVBool(lt_)) }
        if op == "<=" { return Ok(CV.CVBool(!gt_)) }
        if op == ">" { return Ok(CV.CVBool(gt_)) }
        if op == ">=" { return Ok(CV.CVBool(!lt_)) }
        return Ok(CV.CVUnknown)
    }
}

// The error of a const whose value overflows its type (D175).
fun const_overflow(e: Expr) -> CheckErr {
    return terr_at(e.line, e.col, e.sp, "const integer overflow")
}

// Whether `t` is a signed integer type.
#test(Type.TInt(8, true))[true]
#test(Type.TInt(64, false))[false]
fun is_signed_int(t: Type) -> bool {
    return match t { Type.TInt(w, s) => s, _ => false }
}

// `v` wrapped into integer type `t` (two's complement); other types unchanged.
#test(0, Type.TInt(32, true))[0]
#test(10, Type.TInt(32, true))[10]
#test(4096, Type.TInt(32, true))[4096]
fun wrap_int(v: int64, t: Type) -> int64 {
    return match t {
        Type.TInt(w, signed) => {
            if w >= 64 { return v }
            let m = v & (((1 as int64) << (w as int64)) - 1)
            if signed && ((m >> ((w - 1) as int64)) & 1) == 1 { return m - ((1 as int64) << (w as int64)) }
            m
        },
        _ => v,
    }
}

// --- integer overflow (D175, MYLA-395) ----------------------------------------

// Whether `a op b` (`+`, `-`, `*` or `/`) on integers of width `w`, signed or
// not, has no result of that width: the operands are in canonical form (their
// `w`-bit values extended to 64 bits). A `/` overflows only as the minimum of
// a signed type divided by -1 (a zero divisor is an error of its own); `%`
// never does (`MIN % -1` is 0). Computed with the wrapping methods, so it
// can't overflow itself where it runs checked (the compiler interpreted).
#test("+", 2147483647, 1, 32, true)[true]
#test("+", 2147483646, 1, 32, true)[false]
#test("-", -2147483648, 1, 32, true)[true]
#test("-", 3, 4, 8, false)[true]
#test("-", 4, 4, 8, false)[false]
#test("*", 65536, 65536, 32, true)[true]
#test("*", 4294967295, 4294967295, 32, false)[true]
#test("*", 65535, 65537, 32, false)[false]
#test("+", 9223372036854775807, 1, 64, true)[true]
#test("+", -9223372036854775807, -1, 64, true)[false]
#test("-", 0, -9223372036854775807 - 1, 64, true)[true]
#test("-", -1, -9223372036854775807 - 1, 64, true)[false]
#test("*", -1, -9223372036854775807 - 1, 64, true)[true]
#test("*", -9223372036854775807 - 1, -1, 64, true)[true]
#test("*", -9223372036854775807 - 1, 1, 64, true)[false]
#test("*", 3037000500, 3037000500, 64, true)[true]
#test("*", 3037000499, 3037000499, 64, true)[false]
#test("+", -1, 1, 64, false)[true]
#test("-", 0, 1, 64, false)[true]
#test("*", 4294967296, 4294967296, 64, false)[true]
#test("*", 4294967296, 4294967295, 64, false)[false]
#test("/", -128, -1, 8, true)[true]
#test("/", -127, -1, 8, true)[false]
#test("/", -9223372036854775807 - 1, -1, 64, true)[true]
#test("/", -1, -1, 64, false)[false]
#test("%", -128, -1, 8, true)[false]
pub fun int_op_overflows(op: str, a: int64, b: int64, w: int32, signed: bool) -> bool {
    if op == "/" { return signed && b == -1 && a == int_min(w) }
    if op == "+" { return add_overflows(a, b, a.wrapping_add(b), w, signed) }
    if op == "-" { return sub_overflows(a, b, a.wrapping_sub(b), w, signed) }
    if op == "*" { return mul_overflows(a, b, a.wrapping_mul(b), w, signed) }
    return false
}

// Whether `r`, `a + b` wrapped to 64 bits, overflows the width `w`. The
// interpreter calls this and its two siblings with the result it computed,
// for each operation, without `int_op_overflows`' dispatch on the operator.
#test(2147483647, 1, 2147483648, 32, true)[true]
#test(-1, 1, 0, 64, false)[true]
pub fun add_overflows(a: int64, b: int64, r: int64, w: int32, signed: bool) -> bool {
    if w < 64 { return !fits_width(r, w, signed) }
    if signed { return ((a ^ r) & (b ^ r)) < 0 }
    return (r as uint64) < (a as uint64)
}

// Whether `r`, `a - b` wrapped to 64 bits, overflows the width `w`.
#test(0, 1, -1, 8, false)[true]
#test(-1, -9223372036854775807 - 1, 9223372036854775807, 64, true)[false]
pub fun sub_overflows(a: int64, b: int64, r: int64, w: int32, signed: bool) -> bool {
    if w < 64 { return !fits_width(r, w, signed) }
    if signed { return ((a ^ b) & (a ^ r)) < 0 }
    return (a as uint64) < (b as uint64)
}

// Whether `r`, `a * b` wrapped to 64 bits, overflows the width `w`.
#test(65536, 65536, 4294967296, 32, true)[true]
#test(-1, -9223372036854775807 - 1, -9223372036854775807 - 1, 64, true)[true]
pub fun mul_overflows(a: int64, b: int64, r: int64, w: int32, signed: bool) -> bool {
    // narrower than 64 bits: the 64-bit result is exact (a `uint32` product
    // as the unsigned word), and fits if it is its own canonical form
    if w < 64 { return !fits_width(r, w, signed) }
    if a == 0 || b == 0 { return false }
    if signed {
        if a == -1 { return b == int_min(64) }
        return r / a != b
    }
    return (r as uint64) / (a as uint64) != (b as uint64)
}

// Whether the 64-bit `r` is a `w`-bit integer's canonical form (its value
// sign- or zero-extended), for `w` below 64.
#test(127, 8, true)[true]
#test(128, 8, true)[false]
#test(255, 8, false)[true]
#test(-1, 8, false)[false]
fun fits_width(r: int64, w: int32, signed: bool) -> bool {
    let k = (64 - w) as int64
    if signed { return (r << k) >> k == r }
    return ((r as uint64) >> (w as uint64)) == 0
}

// Whether `-a` on an integer of width `w` has no result of that width: the
// signed minimum, or any unsigned number but 0 (D175).
#test(-128, 8, true)[true]
#test(127, 8, true)[false]
#test(0, 32, false)[false]
#test(1, 32, false)[true]
pub fun int_neg_overflows(a: int64, w: int32, signed: bool) -> bool {
    if signed { return a == int_min(w) }
    return a != 0
}

// Whether a shift's count `n` is outside 0 to `w - 1`, the width of the
// shifted type (D175's proposal: `shift amount out of range` where overflow
// traps; a constant count out of range is a compile-time error already).
#test(31, 32)[false]
#test(32, 32)[true]
#test(-1, 8)[true]
#test(0, 64)[false]
pub fun shift_out_of_range(n: int64, w: int32) -> bool {
    return n < 0 || n >= (w as int64)
}

// The minimum of the signed type of width `w`, sign-extended.
#test(8)[-128]
#test(64)[-9223372036854775807 - 1]
pub fun int_min(w: int32) -> int64 {
    let one: int64 = -1
    return one << ((w - 1) as int64)
}

#test(Type.TInt(32, true))[false]
fun is_u64(t: Type) -> bool {
    return match t { Type.TInt(w, signed) => w == 64 && !signed, _ => false }
}

#test(0, 1024, Type.TInt(32, true))[true]
#test(1024, 0, Type.TInt(32, true))[false]
fun int_less(a: int64, b: int64, t: Type) -> bool {
    if is_u64(t) { return (a as uint64) < (b as uint64) }
    return a < b
}

#test(true, 1)[-1]
#test(false, 255)[-256]
#test(true, 128512)[-128512]
fun if_neg(neg: bool, v: int64) -> int64 {
    if neg { return v.wrapping_neg() }
    return ~v
}

#test(CV.CVBool(true))[true]
#test(CV.CVBool(false))[false]
fun cv_bool(v: CV) -> bool {
    return match v { CV.CVBool(b) => b, _ => false }
}

fun cv_equal(a: CV, b: CV) -> Option<bool> {
    return match (a, b) {
        (CV.CVInt(x), CV.CVInt(y)) => Some(x == y),
        (CV.CVBool(x), CV.CVBool(y)) => Some(x == y),
        (CV.CVStr(x), CV.CVStr(y)) => Some(x == y),
        _ => None,
    }
}

#test(["A"], "A")[[]]
#test(["H"], "H")[[]]
#test(["A", "B"], "B")[["A"]]
fun remove_str(xs: [str], s: str) -> [str] {
    var out: [str] = []
    for x in xs { if x != s { out.push(x) } }
    return out
}

// =========================================================================
// Attributes & entry point
// =========================================================================

impl Checker {
    // Every declaration's attributes, each on its own, then the entry point
    // (types.py: _check_attributes_and_entry): errors are collected.
    fun check_attributes_and_entry(var self) {
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if self.full() { return }
            if self.skipped_decls.contains(pos) { continue }
            self.reset_state(decl.id)
            match self.check_attributes(decl) {
                Ok(x) => {},
                Err(e) => { self.note(e) },
            }
        }
        // then the methods' `#test` cases (D116), in the order registered
        var mi = 0
        while mi < self.method_decls.len() {
            if self.full() { return }
            let md = self.method_decls[mi]
            if md.attributes.len() > 0 && !self.skipped_fns.contains(md.name) {
                self.reset_state(self.method_decl_ids[mi])
                match self.check_method_attributes(md, self.method_decl_keys[mi]) {
                    Ok(x) => {},
                    Err(e) => { self.note(e) },
                }
            }
            mi = mi + 1
        }
        if self.full() { return }
        var main_names: [str] = []
        for m in self.mains { main_names.push(m.name) }
        let named_main = self.func_idx("main")
        if self.mains.len() > 0 && named_main >= 0 && !contains_str(main_names, "main") {
            let d = self.functions[named_main].decl
            self.reset_state(self.functions[named_main].decl_id)
            self.note(terr_at(d.line, d.col, d.sp, "both a '#main' function and a function named 'main' are present"))
        } else if self.mains.len() > 1 {
            self.reset_state(self.mains[1].id)
            self.note(terr_at(self.mains[1].line, self.mains[1].col, self.mains[1].sp, "more than one '#main' entry point"))
        } else {
            // the entry point: the `#main` function, else `main`
            var ei = named_main
            if self.mains.len() > 0 { ei = self.func_idx(self.mains[0].name) }
            if ei >= 0 && self.functions[ei].decl.params.len() > 0 {
                let d = self.functions[ei].decl
                self.reset_state(self.functions[ei].decl_id)
                self.note(terr_at(d.line, d.col, d.sp, "entry point must take no parameters"))
            }
        }
    }

    // `decl`'s attributes (types.py: _check_attributes); each `#main`
    // function goes to `mains`.
    #test(checker_on("[int]"), Decl { id: 1, line: 2, col: 1, sp: SrcSpan { sline: 2, scol: 1, eline: 2, ecol: 16 }, kind: DeclKind.TypeAliasDecl("A", TypeExpr { id: 0, line: 2, col: 15, sp: SrcSpan { sline: 2, scol: 15, eline: 2, ecol: 16 }, kind: TypeKind.TRef("B", []) }, [], false) })[Ok(0)]
    fun check_attributes(var self, decl: Decl) -> Result<int32, CheckErr> {
        let attrs = decl_attrs(decl)
        let is_fun = match decl.kind { DeclKind.FunDecl(fd) => true, _ => false }
        let is_impl = match decl.kind { DeclKind.ImplDecl(a, b, c, d, e, f) => true, _ => false }
        for attr in attrs {
            if attr.name == "derive" { continue }
            if attr.name == "allow" {
                if !is_fun && !is_impl { return Err(terr_at(attr.line, attr.col, attr.sp, "'#allow' stands on a function or an impl block (a struct's or actor's code is in its impl)")) }
                self.check_allow(attr)?
                continue
            }
            if attr.name != "main" && attr.name != "test" { return Err(terr_at(attr.line, attr.col, attr.sp, format("unknown attribute '#{}'", attr.name))) }
            if !is_fun { return Err(terr_at(attr.line, attr.col, attr.sp, format("attribute '#{}' may only be applied to functions", attr.name))) }
            match decl.kind {
                DeclKind.FunDecl(fd) => {
                    if fd.type_params.len() > 0 { return Err(terr_at(attr.line, attr.col, attr.sp, format("attribute '#{}' cannot be applied to a generic function (it has no single concrete instantiation)", attr.name))) }
                    if attr.name == "main" {
                        match attr.outputs { Some(x) => { return Err(terr_at(attr.line, attr.col, attr.sp, "'#main' takes no arguments")) }, None => {} }
                        if attr.args.len() > 0 { return Err(terr_at(attr.line, attr.col, attr.sp, "'#main' takes no arguments")) }
                        self.mains.push(MainAt { line: fd.line, col: fd.col, sp: fd.sp, name: fd.name, id: decl.id })
                    } else {
                        self.check_test_attr(fd, attr)?
                    }
                },
                _ => {},
            }
        }
        return Ok(0)
    }

    // A method takes `#test` cases, its receiver as the first argument
    // (D116); no other attribute (types.py: _check_method_attributes).
    #test(checker_on("struct P { x: int, y: int }"), fun_of("fun g() { print(1) }"), "App")[Ok(0)]
    fun check_method_attributes(var self, fd: FunData, key: str) -> Result<int32, CheckErr> {
        for attr in fd.attributes {
            if attr.name == "allow" {
                self.check_allow(attr)?
                continue
            }
            if attr.name != "test" { return Err(terr_at(attr.line, attr.col, attr.sp, format("attribute '#{}' can't be applied to a method (a method takes only '#test' and '#allow')", attr.name))) }
            if self.actors.contains(key) { return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' can't run an actor method (its receiver is an actor, not a value)")) }
            if fd.is_async { return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' can't run an async method (test it through an async test function, D162)")) }
            if fd.type_params.len() > 0 { return Err(terr_at(attr.line, attr.col, attr.sp, "attribute '#test' cannot be applied to a generic method (it has no single concrete instantiation)")) }
            self.check_test_attr(fd, attr)?
        }
        return Ok(0)
    }

    // `#allow(name, …)` (D161): each argument a warning's name, or
    // `primitive(__a, __b)` for some primitives only. A name no warning has
    // is a warning itself; an error can't be allowed, so a raw-memory
    // primitive (D152) in the list is one.
    fun check_allow(var self, attr: Attribute) -> Result<int32, CheckErr> {
        if attr.args.len() == 0 { return Err(terr_at(attr.line, attr.col, attr.sp, "'#allow' names the warnings it silences, as in '#allow(primitive)'")) }
        match attr.outputs { Some(x) => { return Err(terr_at(attr.line, attr.col, attr.sp, "'#allow' takes no expected values in [...]")) }, None => {} }
        for a in attr.args {
            match a.kind {
                ExprKind.Name(n) => {
                    if !is_warning_name(n) {
                        self.warnings.push(CheckErr { line: a.line, col: a.col, sp: a.sp, msg: format("'{}' is no warning's name: '#allow' takes {}", n, quoted_list(warning_names())), decl: self.cur_decl, notes: [] })
                    }
                },
                ExprKind.Call(callee, prims, _) => {
                    let ok = match callee.kind { ExprKind.Name(n) => n == "primitive", _ => false }
                    if !ok || prims.len() == 0 { return Err(terr_at(a.line, a.col, a.sp, "only 'primitive' takes a list, of the primitives it silences: '#allow(primitive(__poll, __spawn))'")) }
                    for p in prims {
                        let pname = match p.kind { ExprKind.Name(n) => n, _ => "" }
                        if pname == "" || !is_builtin_func(pname) || !starts_with_dunder(pname) { return Err(terr_at(p.line, p.col, p.sp, "'#allow(primitive(…))' lists primitives, such as '__poll'")) }
                        if is_raw_memory_primitive(pname) { return Err(terr_at(p.line, p.col, p.sp, format("'{}' reads or writes raw memory, which is an error outside the standard library: '#allow' silences warnings only", pname))) }
                    }
                },
                _ => { return Err(terr_at(a.line, a.col, a.sp, "'#allow' takes warning names, as in '#allow(primitive)' or '#allow(primitive(__poll))'")) },
            }
        }
        return Ok(0)
    }

    // A case, `#test(args)[expected]`, or a test function under a bare
    // `#test` (D162): a function without parameters, with no result or a
    // `Result<(), E>`. An expected value may be `panic("message")` or
    // `exit(n)`, the failure the call must end in.
    fun check_test_attr(var self, fd: FunData, attr: Attribute) -> Result<int32, CheckErr> {
        let idx = self.func_idx(fd.name)
        let sig = self.functions[idx]
        let outs = match attr.outputs {
            Some(x) => x,
            None => {
                if attr.args.len() > 0 { return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' requires an expected result, e.g. #test(args)[expected]")) }
                if sig_has_error(sig.params, sig.ret) { return Err(poisoned()) }
                if sig.params.len() > 0 { return Err(terr_at(attr.line, attr.col, attr.sp, format("a bare '#test' marks a test function, which takes no parameters; a case of '{}' is '#test(args)[expected]'", fd.name))) }
                if !is_test_result(sig.ret) { return Err(terr_at(attr.line, attr.col, attr.sp, format("a test function has no result or a 'Result<(), E>'; a case of '{}' is '#test()[expected]'", fd.name))) }
                return Ok(0)
            },
        }
        if attr.args.len() != sig.params.len() {
            var msg = format("'#test' expects {} argument(s), got {}", sig.params.len(), attr.args.len())
            // a case gives every argument, a default's too (D136, MYLA-293)
            let left = defaulted_from(fd.params, attr.args.len())
            if left.len() > 0 { msg = format("{}: a case gives every argument, the defaults of {} too", msg, quoted_list(left)) }
            return Err(terr_at(attr.line, attr.col, attr.sp, msg))
        }
        if sig_has_error(sig.params, sig.ret) { return Err(poisoned()) }   // the signature failed (MYLA-110)
        self.push_scope()
        var i = 0
        while i < attr.args.len() {
            let at = self.expect_value(attr.args[i], Some(sig.params[i]))?
            if !type_eq(at, sig.params[i]) {
                self.pop_scope()
                return Err(terr_at(attr.args[i].line, attr.args[i].col, attr.args[i].sp, format("'#test' argument type mismatch: expected '{}', found '{}'", type_name(sig.params[i]), type_name(at))))
            }
            i = i + 1
        }
        if outs.len() != 1 { self.pop_scope()
            return Err(terr_at(attr.line, attr.col, attr.sp, "'#test' expects exactly one expected value in [...]")) }
        // an expected failure, `[panic("message")]` or `[exit(n)]` (D162)
        match failure_callee(outs[0]) {
            Some(callee) => {
                self.pop_scope()
                return match expected_failure(outs[0]) {
                    Expected.Value => {
                        if callee == "panic" { Err(terr_at(outs[0].line, outs[0].col, outs[0].sp, "an expected failure is '[panic(\"message\")]', the message a string literal")) }
                        else { Err(terr_at(outs[0].line, outs[0].col, outs[0].sp, "an expected exit is '[exit(n)]', the status an integer literal")) }
                    },
                    _ => Ok(0),
                }
            },
            None => {},
        }
        // a function without a result gives `()`, so its case says `[()]` (D138)
        let rt = match sig.ret { Some(x) => x, None => Type.TTuple([]) }
        let ot = self.expect_value(outs[0], Some(rt))?
        self.pop_scope()
        if !type_eq(ot, rt) {
            match sig.ret { Some(x) => {}, None => { return Err(terr_at(outs[0].line, outs[0].col, outs[0].sp, "'#test' on a function without a result expects '[()]'")) } }
            return Err(terr_at(outs[0].line, outs[0].col, outs[0].sp, format("'#test' expected value type mismatch: expected '{}', found '{}'", type_name(rt), type_name(ot))))
        }
        return Ok(0)
    }

    // -- driver -----------------------------------------------------------

    // Check the program: the declaration phases, which collect each part's
    // error and go on (MYLA-110, D84), then every function's attributes and
    // body on its own (types.py: Checker.check). Err: the errors, in the order
    // found (MYLA-65, D80).
    #test(checker_on("[int]"))[Ok(0)]
    fun run_all(var self) -> Result<int32, [CheckErr]> {
        match self.run_phases() {
            Ok(x) => {},
            Err(e) => {
                if !is_stopped(e) { self.note(e) }
                return Err(unmangled_all(self.errs, self.known_names()))
            },
        }
        self.bodies = true
        self.check_attributes_and_entry()
        // a function or method of an implicit module (D164) that no code
        // checked calls or names is never called: its body is checked once
        // one does (MYLA-359), as its module's own `myla test` checks them
        // all. Trait impls' are checked, as an operator, a bound or a derive
        // calls them unnamed.
        var lazy = self.lazy_decls()
        for id in self.lazy_prelude.keys() { lazy[id] = true }
        var waiting_fns: [int32] = []
        var pos = -1
        for decl in self.decls {
            pos = pos + 1
            if self.skipped_decls.contains(pos) { continue }
            match decl.kind {
                DeclKind.FunDecl(fd) => {
                    if lazy.contains(decl.id) { waiting_fns.push(pos) } else { self.check_fun_body(pos) }
                },
                _ => {},
            }
        }
        var waiting: [int32] = []
        var i = 0
        while i < self.method_decls.len() {
            if lazy.contains(self.method_decl_ids[i]) {
                waiting.push(i)
            } else {
                self.check_method_body(i)
            }
            i = i + 1
        }
        var more = true
        while more {
            more = false
            var fns: [int32] = []
            for k in waiting_fns {
                let fname = match self.decls[k].kind { DeclKind.FunDecl(fd) => fd.name, _ => "" }
                if self.called.contains(fname) {
                    self.check_fun_body(k)
                    more = true
                } else {
                    fns.push(k)
                }
            }
            waiting_fns = fns
            var rest: [int32] = []
            for k in waiting {
                if self.called.contains(self.method_decls[k].name) {
                    self.check_method_body(k)
                    more = true
                } else {
                    rest.push(k)
                }
            }
            waiting = rest
        }
        self.check_passed_on()
        self.check_become_words()
        if self.errs.len() > 0 { return Err(unmangled_all(self.errs, self.known_names())) }
        if self.warnings.len() > 0 { self.warnings = unmangled_all(sort_by_place(self.warnings), self.known_names()) }
        return Ok(0)
    }

    // The qualified names the loader made that a message may hold (a
    // function, type, trait, alias or const, and each module path before
    // one), which `unmangled_in` writes as a program does; only when there
    // is a message.
    fun known_names(self) -> [str: bool] {
        var out: [str: bool] = [:]
        var names: [str] = []
        for k in self.func_map.keys() { names.push(k) }
        for k in self.struct_map.keys() { names.push(k) }
        for k in self.enum_map.keys() { names.push(k) }
        for t in self.traits { names.push(t.name) }
        for a in self.aliases { names.push(a.name) }
        for c in self.const_decls { names.push(c.name) }
        for n in names {
            var i = 0
            while i < n.len() {
                if n[i] == '$' { out[n[:i]] = true }
                i += 1
            }
            out[n] = true
        }
        return out
    }

    // The body of the function `decls[pos]`, unless it was left out.
    fun check_fun_body(var self, pos: int32) {
        let decl = self.decls[pos]
        match decl.kind {
            DeclKind.FunDecl(fd) => { if !self.skipped_fns.contains(fd.name) { self.check_body(decl.id, fd, "") } },
            _ => {},
        }
    }

    // The body of the method `i` of `method_decls`, unless it was left out.
    fun check_method_body(var self, i: int32) {
        if self.skipped_fns.contains(self.method_decls[i].name) { return }
        self.impl_allows = self.method_decl_allows[i]
        self.check_body(self.method_decl_ids[i], self.method_decls[i], self.method_decl_keys[i])
        self.impl_allows = []
    }

    // `fd`, a function of the declaration `id` (a method's: its impl), with
    // its body: one the loader left unparsed is read (`LazyBodies.parse`),
    // once (MYLA-359). None when that fails: its errors are collected.
    #test(checker_on("[int]"), 0, fun_of("fun f() { }"))[Some(FunData { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 12 }, name: "f", params: [], ret_type: None, body: Some(Block { line: 1, col: 9, sp: SrcSpan { sline: 1, scol: 9, eline: 1, ecol: 12 }, stmts: [] }), attributes: [], type_params: [], receiver: None, is_pub: false, is_async: false })]
    fun with_body(var self, id: int32, fd: FunData) -> Option<FunData> {
        if !self.lazy_bodies.ids.contains(id) { return Some(fd) }
        let key = match unread_key(id, fd) {
            Some(k) => k,
            None => { return Some(fd) },
        }
        if !self.lazy_bodies.keys.contains(key) { return Some(fd) }
        var g = fd
        match self.read_bodies.get(key) {
            Some(b) => {
                g.body = Some(b)
                return Some(g)
            },
            None => {},
        }
        let parse = self.lazy_bodies.parse
        match parse(key) {
            Ok(b) => {
                self.read_bodies[key] = b
                self.read_ids[id] = true
                g.body = Some(b)
                return Some(g)
            },
            Err(es) => {
                for e in es { self.note(e) }
                return None
            },
        }
    }

    // The bodies read (`with_body`) in place of their empty blocks, in the
    // declarations and the tables of functions and methods, which the
    // interpreter and the code generator read (MYLA-359).
    #test(checker_on("[int]"))[()]
    fun put_bodies(var self) {
        if self.read_bodies.len() == 0 { return }
        var i = 0
        while i < self.decls.len() {
            let d = self.decls[i]
            if self.read_ids.contains(d.id) {
                let k = match d.kind {
                    DeclKind.FunDecl(fd) => DeclKind.FunDecl(self.read_into(d.id, fd)),
                    DeclKind.ImplDecl(t, ms, tps, tr, targs, attrs) => {
                        var out: [FunData] = []
                        for m in ms { out.push(self.read_into(d.id, m)) }
                        DeclKind.ImplDecl(t, out, tps, tr, targs, attrs)
                    },
                    _ => d.kind,
                }
                self.decls[i] = Decl { id: d.id, line: d.line, col: d.col, sp: d.sp, kind: k }
            }
            i += 1
        }
        i = 0
        while i < self.functions.len() {
            let sig = self.functions[i]
            if sig.has_decl && self.read_ids.contains(sig.decl_id) {
                var s = sig
                s.decl = self.read_into(sig.decl_id, sig.decl)
                self.functions[i] = s
            }
            i += 1
        }
        i = 0
        while i < self.methods.len() {
            let sig = self.methods[i].sig
            if sig.has_decl && self.read_ids.contains(sig.decl_id) {
                var s = sig
                s.decl = self.read_into(sig.decl_id, sig.decl)
                var m = self.methods[i]
                m.sig = s
                self.methods[i] = m
            }
            i += 1
        }
        i = 0
        while i < self.method_decls.len() {
            let id = self.method_decl_ids[i]
            if self.read_ids.contains(id) { self.method_decls[i] = self.read_into(id, self.method_decls[i]) }
            i += 1
        }
    }

    // `fd` of the declaration `id` with its body if it was read.
    fun read_into(self, id: int32, fd: FunData) -> FunData {
        let key = match unread_key(id, fd) {
            Some(k) => k,
            None => { return fd },
        }
        return match self.read_bodies.get(key) {
            Some(b) => {
                var g = fd
                g.body = Some(b)
                g
            },
            None => fd,
        }
    }

    // The functions and impls (by node id) of the implicit modules whose
    // bodies are checked only once called (MYLA-359): impls of no trait.
    #test(checker_on("[int]"))[[:]]
    fun lazy_decls(self) -> [int32: bool] {
        var out: [int32: bool] = [:]
        for d in self.decls {
            let lazy = match d.kind {
                DeclKind.ImplDecl(t, ms, tps, None, targs, attrs) => true,
                DeclKind.FunDecl(fd) => true,
                _ => false,
            }
            if lazy {
                match self.std_impls.get(d.id) {
                    Some(o) => { if o.implicit { out[d.id] = true } },
                    None => {},
                }
            }
        }
        return out
    }

    // Whether the function being checked is the standard library's.
    #test(checker_on("[int]"))[false]
    fun in_std(self) -> bool {
        // a method of an impl on a built-in type is named after the type
        // (`str.trim`): its impl's origin tells (MYLA-320)
        if self.std_impls.contains(self.cur_decl) { return true }
        return self.fun_name.len() >= 4 && self.fun_name[0] == 's' && self.fun_name[1] == 't' && self.fun_name[2] == 'd' && self.fun_name[3] == '$'
    }

    // A call of a `__` primitive outside the standard library: allowed, with
    // a warning (D100, MYLA-186), once per place (types.py: _warn_primitive).
    // A file of the standard library checked on its own (`primitives`) gets none.
    fun warn_primitive(var self, at: Expr, name: str) {
        if self.in_std() || self.primitives { return }
        if contains_str(self.allowed, "primitive") || contains_str(self.allowed, "primitive:" + name) { return }
        let msg = format("'{}' is a primitive of the standard library, not meant to be called from a program", name)
        for w in self.warnings { if w.msg == msg && w.line == at.line && w.col == at.col { return } }
        self.warnings.push(CheckErr { line: at.line, col: at.col, sp: at.sp, msg: msg, decl: self.cur_decl, notes: [Note { label: "help", msg: "call the function of `std` that wraps it; a primitive's behaviour may change with the standard library", line: 0, col: 0, sp: no_span() }] })
    }

    #test(checker_on("[int]"))[Ok(0)]
    fun run_phases(var self) -> Result<int32, CheckErr> {
        self.collect_globals()?
        self.resolve_signatures()?
        self.resolve_traits()?
        self.synthesize_derives()?
        self.resolve_impls()?
        self.validate_bounds()?
        self.check_pending_keys()?
        self.fold_consts()?
        return Ok(0)
    }

    // The body of `fd` (declaration `id`; a method of the type with key
    // `key`, else ""), on its own: its error is collected.
    fun check_body(var self, id: int32, unread: FunData, key: str) {
        if self.full() { return }
        self.reset_state(id)
        // a body the loader left unparsed is read now (MYLA-359)
        let fd = match self.with_body(id, unread) {
            Some(f) => f,
            None => { return },
        }
        self.cur_key = key
        // its own `#allow`s and, for a method, its impl block's
        self.allowed = allowed_warnings(concat_attrs(fd.attributes, self.impl_allows))
        match self.check_function(fd) {
            Ok(x) => {
                // an actor's async method: its state changed after an `await`
                // on the strength of what was read before it (D95, MYLA-146)
                if fd.is_async && self.actor_self != "" {
                    match fd.body {
                        Some(b) => {
                            let (changes, examines) = self.self_effects(self.actor_self)
                            var r = Reentrancy { epoch: 0, checked: [:], locals: [:], awaits: [], out: [], changes: changes, examines: examines, mutators: self.mutating_calls }
                            r.block(b)
                            if !contains_str(self.allowed, "reentrancy") {
                                for w in r.out { self.warnings.push(CheckErr { line: w.line, col: w.col, sp: w.sp, msg: w.msg, decl: id, notes: w.notes }) }
                            }
                        },
                        None => {},
                    }
                }
            },
            Err(e) => { self.note(e) },
        }
    }

    // The fields each synchronous method of the actor `key` changes and
    // examines, through the methods of `self` it calls (MYLA-171), in the
    // order first met.
    fun self_effects(self, key: str) -> ([str: [str]], [str: [str]]) {
        var names: [str] = []
        var direct: [str: Effects] = [:]
        let prefix = key + "."
        var i = 0
        while i < self.method_decls.len() {
            let fd = self.method_decls[i]
            // the declaration's name is `key.name` (`register_method`); only
            // the actor's own are cut, as another type's may be shorter than
            // the prefix (`str.trim` of std.str, D164)
            var name = ""
            if self.method_decl_keys[i] == key {
                var sb = StringBuilder()
                sb.append(fd.name, prefix.len(), fd.name.len())
                name = sb.build()
            }
            if self.method_decl_keys[i] == key && !fd.is_async && !direct.contains(name) {
                match fd.body {
                    Some(b) => {
                        var e = Effects { changes: [], examines: [], calls: [], mutators: self.mutating_calls }
                        e.block(b)
                        direct[name] = e
                        names.push(name)
                    },
                    None => {},
                }
            }
            i = i + 1
        }
        var changes: [str: [str]] = [:]
        var examines: [str: [str]] = [:]
        for n in names {
            // the methods it reaches, itself first
            var reached = [n]
            var k = 0
            var ch: [str] = []
            var ex: [str] = []
            while k < reached.len() {
                match direct.get(reached[k]) {
                    Some(e) => {
                        for f in e.changes { ch = add_name(ch, f) }
                        for f in e.examines { ex = add_name(ex, f) }
                        for c in e.calls { reached = add_name(reached, c) }
                    },
                    None => {},
                }
                k = k + 1
            }
            changes[n] = ch
            examines[n] = ex
        }
        return (changes, examines)
    }

    // Before checking declaration `id` on its own: what an earlier check that
    // failed may have left behind (types.py: _on_its_own).
    fun reset_state(var self, id: int32) {
        self.cur_decl = id
        // a literal's columns an error left open
        if self.col_open.len() > 0 {
            self.col_open = []
            self.col_lits = []
        }
        self.frames = []
        self.loop_depth = 0
        self.defer_at = -1
        self.lambda_depth = 0
        self.lambda_infer_active = false
        self.lambda_infer = []
        self.stmt_match = false
        self.cur_ret = None
        self.has_cur_ret = false
        self.ret_at = None
        self.type_params = []
        self.bounds_cur = []
        self.in_async = false
        self.actor_self = ""
        self.cur_key = ""
        self.lams = []
        if self.awaited.len() > 0 { self.awaited = [:] }
        self.task_init = false
        self.in_guard = false
        self.key_ctx = false
    }

    // Collect `e`, an error in the declaration being checked.
    fun note(var self, e: CheckErr) {
        if is_poisoned(e) { return }   // depends on the error type: no error (MYLA-110)
        self.errs.push(CheckErr { line: e.line, col: e.col, sp: e.sp, msg: e.msg, decl: self.cur_decl, notes: e.notes })
    }

    // Whether MAX_ERRORS errors were collected: the check ends.
    #test(checker_on("[int]"))[false]
    fun full(self) -> bool {
        return self.errs.len() >= MAX_ERRORS
    }

    // Collect `e`, the error of a declaration's part, and go on (types.py:
    // _record): Err(stopped()) at MAX_ERRORS. A part that depends on the
    // error type has nothing to collect.
    #test(checker_on("[int]"), CheckErr { line: 5, col: 5, sp: SrcSpan { sline: 5, scol: 5, eline: 5, ecol: 32 }, msg: "a trait method can't be async", decl: -1, notes: [] })[Ok(0)]
    fun record(var self, e: CheckErr) -> Result<int32, CheckErr> {
        if is_poisoned(e) { return Ok(0) }
        if is_stopped(e) { return Err(e) }
        self.note(e)
        if self.full() { return Err(stopped()) }
        return Ok(0)
    }

    // `te` resolved, else the error type, its error collected (types.py: _part).
    #test(checker_on("[int]"), TypeExpr { id: 40, line: 1, col: 23, sp: SrcSpan { sline: 1, scol: 23, eline: 1, ecol: 24 }, kind: TypeKind.TRef("T", []) })[Ok(Type.TError)]
    fun resolve_part(var self, te: TypeExpr) -> Result<Type, CheckErr> {
        return match self.resolve0(te) {
            Ok(t) => Ok(t),
            Err(e) => {
                self.record(e)?
                Ok(Type.TError)
            },
        }
    }

    #test(checker_on("[int]"), Param { line: 3, col: 26, sp: SrcSpan { sline: 3, scol: 26, eline: 3, ecol: 30 }, name: "k", ty: Some(TypeExpr { id: 48, line: 3, col: 29, sp: SrcSpan { sline: 3, scol: 29, eline: 3, ecol: 30 }, kind: TypeKind.TRef("K", []) }), default: None })[Ok(Type.TError)]
    fun param_part(var self, p: Param) -> Result<Type, CheckErr> {
        return match self.param_type(p) {
            Ok(t) => Ok(t),
            Err(e) => {
                self.record(e)?
                Ok(Type.TError)
            },
        }
    }

    // `r`'s error, if any, collected.
    #test(checker_on("[int]"), Ok(0))[Ok(0)]
    fun record_result(var self, r: Result<int32, CheckErr>) -> Result<int32, CheckErr> {
        match r {
            Ok(x) => {},
            Err(e) => { self.record(e)? },
        }
        return Ok(0)
    }
}

#test()["#derive(Eq, Hash)\nenum Option<T> { Some(T), None }\n#derive(Eq, Hash)\nenum Result<T, E> { Ok(T), Err(E) }\ntrait Format {\n    fun format(self, spec: str) -> str\n}\nstruct Hasher {\n    state: uint64,\n}\nimpl Eq for Hasher {\n    fun eq(self, other: Hasher) -> bool {\n        return self.state == other.state\n    }\n}\ntrait Hash {\n    fun hash(self, h: Hasher) -> Hasher\n}\ntrait Iterator<T> {\n    fun next(var self) -> Option<T>\n}\n"]
// The prelude: what every program has without an import. The `Hasher`'s
// state and the `Hash` trait are here (D163, MYLA-313), so that every type
// can be a map key's and every module can name them; the hasher's methods,
// its algorithm, and the `Hash` impls of the built-in types are std.hash's,
// an implicit module. `Option` and `Result` derive `Eq`, so `opt == None`
// works when the payload is `Eq` (MYLA-379), and `Hash`, so they are map keys
// when the payload is `Hash` (D182); those impls' bodies are checked once a
// program compares or hashes one (`prelude_need`). `Iterator<T>` is here for `for`
// over one (D171). A
// map's `get` is std.map's method `m.get(k)`: the free `get(m, k)` that was
// here went, so a file may declare a `get` of its own (MYLA-393).
fun prelude_src() -> str {
    return "#derive(Eq, Hash)\nenum Option<T> { Some(T), None }\n#derive(Eq, Hash)\nenum Result<T, E> { Ok(T), Err(E) }\ntrait Format {\n    fun format(self, spec: str) -> str\n}\nstruct Hasher {\n    state: uint64,\n}\nimpl Eq for Hasher {\n    fun eq(self, other: Hasher) -> bool {\n        return self.state == other.state\n    }\n}\ntrait Hash {\n    fun hash(self, h: Hasher) -> Hasher\n}\ntrait Iterator<T> {\n    fun next(var self) -> Option<T>\n}\n"
}

// The prelude's declarations, with node ids from `first_id`.
fun prelude(first_id: int32) -> Parsed {
    return match parse_source(prelude_src(), first_id) {
        Ok(p) => p,
        Err(d) => { panic("the prelude does not parse") },
    }
}

// Type-check a program; its warnings (D95), or its errors.
pub fun check_program(user: Program) -> Result<[CheckErr], [CheckErr]> {
    let pre = prelude(0)
    var decls: [Decl] = []
    for d in pre.program.decls { decls.push(d) }
    for d in user.decls { decls.push(d) }
    var c = new_checker(decls)
    let r = c.run_all()
    match r { Ok(x) => {}, Err(e) => { return Err(e) } }
    return Ok(c.warnings)
}

// Type-check a linked program (selfhost/loader.my: its declarations, whose node
// ids are below `next_id`), with the prelude parsed after it so every id stays
// unique, and return the populated checker (MYLA-30), or its errors (D80).
pub fun build_checker_decls(decls: [Decl], next_id: int32) -> Result<Checker, [CheckErr]> {
    return build_checker_with(decls, next_id, false)
}

// `build_checker_decls`, a program allowed to call the raw-memory
// primitives when `primitives` (the toolchain's tests of their code,
// `gen_main --primitives`).
pub fun build_checker_with(decls: [Decl], next_id: int32, primitives: bool) -> Result<Checker, [CheckErr]> {
    return build_checker_std(decls, next_id, primitives, [:])
}

// `build_checker_with` of a linked program whose standard library's impls,
// by node id, are `std_impls` (`Loaded.std_impls`, MYLA-320).
pub fun build_checker_std(decls: [Decl], next_id: int32, primitives: bool, std_impls: [int32: DeclOrigin]) -> Result<Checker, [CheckErr]> {
    return build_checker_lazy(decls, next_id, primitives, std_impls, no_lazy_bodies())
}

// `build_checker_std` of a linked program whose implicit modules' bodies
// the loader left unparsed (`Loaded.bodies`, MYLA-359): each is read once
// checked, and in the returned checker's declarations.
pub fun build_checker_lazy(decls: [Decl], next_id: int32, primitives: bool, std_impls: [int32: DeclOrigin], bodies: LazyBodies) -> Result<Checker, [CheckErr]> {
    let pre = prelude(next_id)
    var all: [Decl] = []
    for d in pre.program.decls { all.push(d) }
    for d in decls { all.push(d) }
    var c = new_checker(all)
    c.primitives = primitives
    c.std_impls = std_impls
    c.lazy_bodies = bodies
    c.next_id = pre.next_id
    let r = c.run_all()
    match r { Ok(x) => {}, Err(e) => { return Err(e) } }
    c.put_bodies()
    // every call with all its arguments, for whatever runs the program (D136)
    c.fill_in()
    return Ok(c)
}

// A checker that has checked `src` alone, the receiver of `#test` cases of
// the checker's methods (MYLA-184): without the prelude, which would take a
// third of a second per case in the Python interpreter. Its errors stay in
// `errs`; a `src` that doesn't parse gives an empty checker.
pub fun checker_on(src: str) -> Checker {
    var decls: [Decl] = []
    match parse_source(src, 0) {
        Ok(p) => { decls = p.program.decls },
        Err(d) => {},
    }
    var c = new_checker(decls)
    let r = c.run_all()
    return c
}

// The messages of the errors `checker_on(src)` finds: cases that check a
// whole program. Here the expected type (an annotation, a parameter, a
// return type) types a generic literal's empty list and map in generic code
// and fixes a generic call's type parameters (MYLA-315).
#test("struct B<T> { items: [T] }\nfun mk<T>() -> B<T> { return B { items: [] } }\nfun main() { let b: B<int> = mk() }")[[]]
#test("struct M<T> { m: [str: T], n: [T] }\nfun mk<T>() -> M<T> { return M { m: [:], n: [] } }\nfun size(x: M<int>) -> int { return x.n.len() }\nfun main() { print(size(mk())) }")[[]]
#test("struct B<T> { items: [T] }\nfun mk<T>() -> B<T> { return B { items: [] } }\nfun again<T>() -> B<T> { return mk() }\nfun main() { let b: B<str> = again() }")[[]]
#test("struct B<T> { items: [T] }\nimpl<T> B<T> { fun emptied<U>(self) -> B<U> { return B { items: [] } } }\nfun main() { let b = B { items: [1] }\nlet c: B<str> = b.emptied() }")[[]]
#test("struct B<T> { items: [T] }\nfun of<T>(xs: [T]) -> B<T> { return B { items: xs } }\nfun main() { let b: B<int64> = of([5000000000]) }")[[]]
#test("struct B<T> { items: [T] }\nfun mk<T>() -> B<T> { return B { items: [] } }\nfun main() { let b = mk() }")[["cannot infer type parameter(s) T for 'mk' from the arguments; add a type annotation to guide inference"]]
#test("struct B<T> { items: [T] }\nfun of<T>(xs: [T]) -> B<T> { return B { items: xs } }\nfun main() { let b: B<int> = of([\"x\"]) }")[["cannot assign value of type 'B<str>' to binding of type 'B<int32>'"]]
// tuples and lists compared, and map keys of any `Eq + Hash` type (D163)
#test("fun main() { print((1, \"a\") == (1, \"a\") && [(1, 2)] != [(2, 1)]) }")[[]]
#test("struct P { x: int }\nfun main() { print((1, P { x: 1 }) == (1, P { x: 1 })) }")[["cannot compare values of type '(int32, P)': 'P' isn't Eq (it needs 'impl Eq for P' or '#derive(Eq)')"]]
#test("fun main() { var m: [(int, int): int] = [:]\nm[(1, 2)] = 3\nvar n: [[str]: bool] = [[\"a\"]: true] }")[[]]
#test("#derive(Eq)\nstruct P { x: int }\nfun main() { var m: [P: int] = [:] }")[["map key type must be Eq and Hash, found 'P': 'P' isn't Hash (it needs 'impl Hash for P' or '#derive(Hash)')"]]
#test("struct Q { m: [(int, float): int] }")[["map key type must be Eq and Hash, found '(int32, float64)': 'float64' isn't Hash (NaN is unequal to itself)"]]
#test("fun f<T>(x: T) -> [T: int] { return [x: 1] }")[["map key type must be Eq and Hash, found 'T': it needs the bound 'T: Eq + Hash'"]]
#test("#derive(Eq, Hash)\nstruct P { x: float }")[["cannot derive Hash for struct 'P': field 'x' has type 'float64', which isn't Hash (a float isn't: NaN is unequal to itself; a hand-written 'impl Hash' may add 'math.to_bits(x)')"]]
#test("#derive(Hash)\nstruct P { x: int }")[["cannot derive Hash for 'P': it isn't Eq; derive both, '#derive(Eq, Hash)', or write 'impl Eq for P'"]]
// a string's characters in a `for`, strings ordered and `Ord`, a char's
// distance and moves (MYLA-318)
#test("fun main() { for c in \"hé\" { let d: char = c }\nlet s: str = \"x\"\nfor c in s + \"y\" { print(c) } }")[[]]
#test("fun big<T: Ord>(a: T, b: T) -> T { return if a < b { b } else { a } }\nfun main() { print(big(\"a\", \"b\") >= \"a\" && \"a\" != \"b\") }")[[]]
#test("fun main() { let d: int = 'p' - 'a'\nlet c: char = 'a' + d\nvar e = c - 1\ne += 2\nlet k: int = e - c\nlet b: uint8 = 3\nlet z: uint8 = '0' + b }")[[]]
#test("fun main() { let c = 'a'\nlet k: int = c + 1 }")[["cannot assign value of type 'char' to binding of type 'int32'"]]
#test("fun main() { let c = 'a'\nlet n: uint8 = 1\nprint(c - n) }")[["operator '-' moves a char by an 'int32', found 'uint8' (convert it with 'as int32')"]]
#test("fun main() { let c = 'a'\nprint(c * 2) }")[["type mismatch: 'char' vs 'int32' (no implicit conversion between numeric types)"]]
// a trait's functions without `self` (D172, MYLA-384): on a built-in type,
// a type keyword, a struct, a generic struct solved by the expected type,
// a bounded type parameter, and the errors around them
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nfun main() { let a: int = int.zero()\nlet b: int32 = int32.zero() }")[[]]
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nfun total<T: Z + Add>(xs: [T]) -> T { var s = T.zero()\nfor x in xs { s = s + x }\nreturn s }\nfun main() { print(total([1, 2])) }")[[]]
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nstruct B<T> { v: T }\nimpl<T: Z> Z for B<T> { fun zero() -> B<T> { return B { v: T.zero() } } }\nfun main() { let b: B<int> = B.zero()\nprint(b.v) }")[[]]
#test("enum R<T> { Good(T), Bad(str) }\ntrait P { fun parse(t: str) -> R<Self> }\nimpl P for bool { fun parse(t: str) -> R<bool> { return R.Good(t == \"true\") } }\nfun get<T: P>(t: str) -> R<T> { return T.parse(t) }\nfun main() { let r: R<bool> = get(\"true\")\nlet s = bool.parse(1) }")[["argument type mismatch in call to 'bool.parse': expected 'str', found 'int32'"]]
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nfun main() { let n = 1\nprint(n.zero()) }")[["'zero' is a function of 'int32' without 'self': call it on the type, 'int32.zero(…)', not on a value"]]
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nfun f<T>() -> T { return T.zero() }")[["type parameter 'T' has no function 'zero': it has no bounds (write 'T: Trait' to call a trait's functions)"]]
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nfun f<T: Add>() -> T { return T.zero() }")[["type parameter 'T' has no function 'zero': none of its bounds ('Add') declares one"]]
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nfun main() { print(str.zero()) }")[["type 'str' has no function 'zero'"]]
#test("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }\nfun f<T: Z>() -> T { return T.zero(1) }")[["function 'T.zero' expects 0 argument(s), got 1"]]
#test("struct P { x: int }\nimpl P { fun f() -> int { return 1 } }")[["function 'f' in 'impl P' has no 'self': only a trait's functions go without one"]]
#test("trait S { fun a(self) -> int }\nstruct Q { x: int }\nimpl S for Q { fun a() -> int { return 1 } }")[["'a' in impl of trait 'S' for 'Q' has no receiver but the trait declares 'self'"]]
// `#derive(Json)` (D172, MYLA-385): without std.json; the field check
// against std.json's names ("" here, as in std.json itself); generic types
// too (MYLA-379), and a generic type's derived impl is bounded
#test("#derive(Json)\nstruct P { x: int }")[["cannot derive Json for 'P': std.json isn't imported (write 'import std.json as json')"]]
#test("enum Json { Null }\ntrait ToJson { fun to_json(self) -> Json }\ntrait FromJson { fun from_json(j: Json) -> Self }\nfun unknown_variant() {}\n#derive(Json)\nstruct P { x: (int, str) }")[["cannot derive Json for struct 'P': field 'x' has type '(int32, str)', which isn't ToJson and FromJson (a tuple has no JSON form: make it a struct)"]]
#test("enum Json { Null }\ntrait ToJson { fun to_json(self) -> Json }\ntrait FromJson { fun from_json(j: Json) -> Self }\nfun unknown_variant() {}\nstruct Q { x: int }\n#derive(Json)\nenum E { A, B([str: Q]) }")[["cannot derive Json for enum 'E': payload #0 of variant 'B' has type '[str: Q]', which isn't ToJson and FromJson"]]
#test("#derive(Json)\nstruct B<T> { v: T }")[["cannot derive Json for 'B': std.json isn't imported (write 'import std.json as json')"]]
// `#derive(Toml)` (MYLA-407): without std.toml; an `Option` only as a
// struct's field (TOML has no null)
#test("#derive(Toml)\nstruct P { x: int }")[["cannot derive Toml for 'P': std.toml isn't imported (write 'import std.toml as toml')"]]
#test("enum Toml { Str(str) }\ntrait ToToml { fun to_toml(self) -> Toml }\ntrait FromToml { fun from_toml(t: Toml) -> Self }\nfun unknown_variant() {}\nenum Option<T> { Some(T), None }\n#derive(Toml)\nstruct P { x: Option<int>, y: [Option<str>] }")[["cannot derive Toml for struct 'P': field 'y' has type '[Option<str>]', which isn't ToToml and FromToml (TOML has no null: an 'Option' can only be a struct's field, left out when 'None')"]]
#test("enum Toml { Str(str) }\ntrait ToToml { fun to_toml(self) -> Toml }\ntrait FromToml { fun from_toml(t: Toml) -> Self }\nfun unknown_variant() {}\nenum Option<T> { Some(T), None }\n#derive(Toml)\nstruct P { x: Option<(int, int)> }")[["cannot derive Toml for struct 'P': field 'x' has type 'Option<(int32, int32)>', which isn't ToToml and FromToml (a tuple has no TOML form: make it a struct)"]]
#test("enum Toml { Str(str) }\ntrait ToToml { fun to_toml(self) -> Toml }\ntrait FromToml { fun from_toml(t: Toml) -> Self }\nfun unknown_variant() {}\nenum Option<T> { Some(T), None }\n#derive(Toml)\nenum E { A, B(Option<int>) }")[["cannot derive Toml for enum 'E': payload #0 of variant 'B' has type 'Option<int32>', which isn't ToToml and FromToml (TOML has no null: an 'Option' can only be a struct's field, left out when 'None')"]]
#test("#derive(Eq)\nstruct B<T> { v: T }\nstruct N { x: int }\nfun f(b: B<N>) -> bool { return b == b }")[["operator '==' is not defined for 'B<N>': 'N' isn't Eq (it needs 'impl Eq for N' or '#derive(Eq)')"]]
#test("#derive(Eq)\nenum Option<T> { Some(T), None }\nfun f(a: Option<[str: int]>) -> bool { return a == None }")[["operator '==' is not defined for 'Option<[str: int32]>': '[str: int32]' isn't Eq"]]
// a literal before the element that fixes its column's type is checked
// again against it (L2), map keys and values too; a column another element
// fixed doesn't adopt a later one's type
#test("fun main() { let a = [1, 300, 3u8] }")[["integer literal 300 does not fit in 'uint8'"]]
#test("fun main() { let m = [1: 0, 300: 1, 3u8: 2] }")[["integer literal 300 does not fit in 'uint8'"]]
#test("fun main() { let m = [0: 1, 1: 300, 2: 3u8] }")[["integer literal 300 does not fit in 'uint8'"]]
#test("fun main() { let a = [1, -129, 3i8] }")[["integer literal 129 does not fit in 'int8'"]]
#test("fun main() { let x = 5\nlet a = [1, x, 3u8] }")[["type mismatch: 'int32' vs 'uint8' (no implicit conversion between numeric types)"]]
#test("fun main() { let a = ['a', 300, 3u8] }")[["integer literal 300 does not fit in 'uint8'"]]
#test("fun main() { let a = [1, 2.5] }")[["type mismatch: 'int32' vs 'float64' (no implicit conversion between numeric types)"]]
#test("fun main() { let x: int64 = 5\nlet a = [1, -2, 3, x]\nlet b: [int64] = a\nlet c = [1.5, -2.5, 3.5f32]\nlet d: [float32] = c\nlet e = ['a', 98u8]\nlet f: [uint8] = e\nlet g = [-1, 3i8]\nlet h: [int8] = g }")[[]]
// D178 (L1): a method found where the receiver's field of its name holds
// a function at that instantiation; a field of another type, or a struct
// without the method, is no error
#test("struct Cell<T> { get: T }\nimpl<T> Cell<T> { fun get(self, n: int) -> int { return -n } }\nfun main() { let c = Cell { get: (x: int) => x + 1 }\nlet y = c.get(5) }")[["'get' is a method of 'Cell<(int32) -> int32>' and its field 'get' holds a function here: bind the field first: let g = c.get"]]
#test("struct Cell<T> { get: T }\nimpl<T> Cell<T> { fun get(self, n: int) -> int { return -n } }\nfun main() { let c = Cell { get: 4 }\nlet y = c.get(5)\nlet z = c.get + 1 }")[[]]
#test("struct Cell<T> { get: T }\nfun main() { let c = Cell { get: (x: int) => x + 1 }\nlet g = c.get\nlet y = c.get(5) + g(1) }")[[]]
#test("struct Cell<T> { get: T }\nstruct W { c: Cell<(int) -> int> }\nimpl<T> Cell<T> { fun get(self, n: int) -> int { return -n } }\nfun f(w: W) -> int { return w.c.get(5) }")[["'get' is a method of 'Cell<(int32) -> int32>' and its field 'get' holds a function here: bind the field first: let g = w.c.get"]]
// `Tree.Leaf == t` types the variant by `t`, as `t == Tree.Leaf` does
// (MYLA-379's follow-up)
#test("#derive(Eq)\nenum Tree<T> { Leaf, Node(T) }\nfun f(t: Tree<int>) -> bool { return Tree.Leaf == t || Tree.Node(2) != t || t == Tree.Leaf }")[[]]
#test("#derive(Eq)\nenum Tree<T> { Leaf, Node(T) }\nfun f(t: Tree<int>) -> bool { return Tree.Node(\"a\") == t }")[["variant 'Tree.Node': expected 'int32', found 'str'"]]
// a hole no element filled is reported where it is (L6)
#test("enum Option<T> { Some(T), None }\nfun main() { let a = [(None, None), (Some(1), None)] }")[["cannot infer type argument(s) for 'None'; annotate the binding (e.g. ': Option<...>')"]]
// an enum's `var self` method assigns `self` (MYLA-380's follow-up); a
// struct's and a read-only one's can't
#test("enum L { A, B }\nimpl L { fun step(var self) { self = L.B } }")[[]]
#test("enum L { A, B }\nimpl L { fun step(self) { self = L.B } }")[["cannot reassign 'self'; mutate its fields or elements instead"]]
#test("struct P { x: int }\nimpl P { fun reset(var self) { self = P { x: 0 } } }")[["cannot reassign 'self'; mutate its fields or elements instead"]]
// a negative literal is no unsigned integer (L5)
#test("fun main() { let w: uint8 = -1 }")[["integer literal -1 does not fit in 'uint8'"]]
#test("fun main() { let w = -5u64 }")[["integer literal -5 does not fit in 'uint64'"]]
#test("fun f(x: uint32) -> uint32 { return x + -2 }")[["integer literal -2 does not fit in 'uint32'"]]
#test("fun main() { let w: uint8 = -0\nlet v: int8 = -128 }")[[]]
// a generic impl's operator gives the receiver's instance (M2, MYLA-367)
#test("struct Box<T> { v: T }\nimpl<T: Add> Add for Box<T> { fun add(self, other: Box<T>) -> Box<T> { return Box { v: self.v + other.v } } }\nfun main() { let c: Box<int> = Box { v: 1 } + Box { v: 2 }\nlet d = c + c + c\nlet e: int = d.v }")[[]]
#test("struct Box<T> { v: T }\nimpl<T: Add> Add for Box<T> { fun add(self, other: Box<T>) -> Box<T> { return Box { v: self.v + other.v } } }\nfun main() { let c: Box<int> = Box { v: 1 } + Box { v: 2 }\nlet e: str = (c + c).v }")[["cannot assign value of type 'int32' to binding of type 'str'"]]
fun errors_of(src: str) -> [str] {
    var out: [str] = []
    for e in checker_on(src).errs { out.push(e.msg) }
    return out
}

// D95's warnings of `src`: a mutator on a field of `self` changes it inside
// an expression too (MYLA-394)
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nstruct C { n: int }\nimpl C { fun bump(var self) -> int { self.n += 1\nreturn self.n } }\nactor S { items: [int], c: C }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 || self.c.n > 9 { return 0 }\nlet paid = await p.charge()\nlet x = self.items.pop()\nreturn x } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nstruct C { n: int }\nimpl C { fun bump(var self) -> int { self.n += 1\nreturn self.n } }\nactor S { items: [int], c: C }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 || self.c.n > 9 { return 0 }\nlet paid = await p.charge()\nreturn self.c.bump() + 1 } }")[["'self.c' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nstruct C { n: int }\nimpl C { fun bump(var self) -> int { self.n += 1\nreturn self.n } }\nactor S { items: [int], c: C }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 || self.c.n > 9 { return 0 }\nlet x = self.items.pop() + self.c.bump()\nlet paid = await p.charge()\nreturn x } }")[[]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nstruct C { n: int }\nimpl C { fun bump(var self) -> int { self.n += 1\nreturn self.n } }\nactor S { items: [int], c: C }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 || self.c.n > 9 { return 0 }\nlet paid = await p.charge()\nself.items.push(self.c.bump())\nreturn 1 } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile", "'self.c' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
// a mutator in the head of an `if`, a `while` or a `match` (MYLA-394)
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nactor S { items: [int] }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 { return 0 }\nlet paid = await p.charge()\nif self.items.pop() > 0 { return 1 }\nreturn 0 } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nactor S { items: [int] }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 { return 0 }\nlet paid = await p.charge()\nvar n = 0\nwhile self.items.pop() > 0 { n += 1 }\nreturn n } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nactor S { items: [int] }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 { return 0 }\nlet paid = await p.charge()\nreturn match self.items.pop() { 0 => 0, _ => 1 } } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nactor S { items: [int] }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 { return 0 }\nlet paid = await p.charge()\nreturn match 1 { 0 => 0, _ if self.items.pop() > 0 => 1, _ => 2 } } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nactor S { items: [int] }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 { return 0 }\nlet paid = await p.charge()\nif self.items.pop() > 0 { let q = await p.charge()\nself.items.push(1) }\nreturn 0 } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile", "'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
#test("actor P { n: int }\nimpl P { fun charge(var self) -> bool { return true } }\nactor S { items: [int] }\nimpl S { async fun sell(var self, p: P) -> int { if self.items.len() == 0 { return 0 }\nlet paid = await p.charge()\nlet x = match self.items.pop() { 0 => 0, _ => 1 }\nreturn x } }")[["'self.items' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile"]]
fun warnings_of(src: str) -> [str] {
    var out: [str] = []
    for w in checker_on(src).warnings { out.push(w.msg) }
    return out
}

#test(Type.TStr)[true]
#test(Type.TBool)[true]
#test(Type.TParam("T"))[false]
fun is_printable(t: Type) -> bool {
    return is_int(t) || is_float(t) || is_char(t) || is_bool(t) || is_str(t)
}

#test("{}", 7, 18)[Ok(1)]
#test("{} + {} = {}", 16, 12)[Ok(3)]
#test("a { b", 5, 18)[Err(CheckErr { line: 5, col: 18, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "format(): a single '{' must be a '{}' placeholder or an escaped '{{'", decl: -1, notes: [] })]
fun count_format_holes(fmt: str, line: int32, col: int32) -> Result<int32, CheckErr> {
    let cs = fmt.chars()
    let n = cs.len()
    var holes = 0
    var i = 0
    while i < n {
        let c = cs[i]
        if c == '{' {
            if i + 1 < n && cs[i + 1] == '{' { i = i + 2
            continue }
            if i + 1 < n && cs[i + 1] == '}' { holes = holes + 1
            i = i + 2
            continue }
            // `{:spec}` (D139)
            if i + 1 < n && cs[i + 1] == ':' {
                var j = i + 2
                while j < n && cs[j] != '}' && cs[j] != '{' { j = j + 1 }
                if j < n && cs[j] == '}' {
                    holes = holes + 1
                    i = j + 1
                    continue
                }
            }
            return Err(terr(line, col, "format(): a single '{' must be a '{}' placeholder or an escaped '{{'"))
        }
        if c == '}' {
            if i + 1 < n && cs[i + 1] == '}' { i = i + 2
            continue }
            return Err(terr(line, col, "format(): a single '}' must close a '{}' placeholder or be an escaped '}}'"))
        }
        i = i + 1
    }
    return Ok(holes)
}

// =========================================================================
// Calls
// =========================================================================

impl Checker {
    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), [Expr { id: 40, line: 23, col: 22, sp: SrcSpan { sline: 23, scol: 22, eline: 23, ecol: 23 }, kind: ExprKind.Name("s") }], None)[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    // explicit type arguments (D169): they fix what nothing else would, their
    // count is the function's, and only a generic function takes them
    #test(checker_on("fun mk<T>() -> [T] { return [] }"), expr_of("mk<int64>()"), expr_of("mk"), [], None)[Ok(Some(Type.TList(Type.TInt(64, true))))]
    #test(checker_on("fun mk<T>() -> [T] { return [] }"), expr_of("mk<int, str>()"), expr_of("mk"), [], None)[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 4, eline: 1, ecol: 12 }, msg: "function 'mk' expects 1 type argument(s), got 2", decl: -1, notes: [] })]
    #test(checker_on("fun two(x: int) -> int { return x }"), expr_of("two<int>(1)"), expr_of("two"), [expr_of("1")], None)[Err(CheckErr { line: 1, col: 5, sp: SrcSpan { sline: 1, scol: 5, eline: 1, ecol: 8 }, msg: "function 'two' is not generic (it takes no type arguments)", decl: -1, notes: [] })]
    fun infer_call(var self, e: Expr, callee: Expr, args: [Expr], expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        for a in args { match a.kind { ExprKind.Hole => { return Ok(Some(self.infer_partial(e, callee, args)?)) }, _ => {} } }
        // local binding shadows a global function: call as a value
        let as_method = self.builtin_as_method
        self.builtin_as_method = false
        match callee.kind {
            ExprKind.Name(nm) => {
                let shadowed = match self.lookup(nm) { Some(b) => !as_method, None => false }
                if shadowed { return self.infer_indirect_call(e, callee, args) }
            },
            _ => {},
        }
        match callee.kind {
            ExprKind.GetField(target, field) => {
                match self.enum_name_ref(target) {
                    Some(en) => {
                        // a function of the enum's (D172), where no variant has its name
                        let fun_of_enum = match self.method_sig(en, field) { Some(sg) => !self.enum_has_variant(en, field), None => false }
                        if !fun_of_enum { return Ok(Some(self.infer_variant_ctor(e, en, field, args, expected)?)) }
                    },
                    None => {},
                }
                // `T.f(args)`, `int.zero()`: a function without `self` (D172)
                match self.static_target(target)? {
                    Some(st) => { return self.infer_static_call(e, st, field, args, expected) },
                    None => {},
                }
                // a builtin function called as a method of its first argument
                // (`xs.push(v)` is `push(xs, v)`, D103, MYLA-221), unless the
                // type has a method of that name of its own
                if builtin_method_name(field) {
                    let rt = self.expect_value(target, None)?
                    let own = match self.type_key(rt) { Some(k) => match self.method_sig(k, field) { Some(sg) => true, None => false }, None => false }
                    if builtin_method(rt, field) && !own {
                        var all = [target]
                        for a in args { all.push(a) }
                        self.builtin_as_method = true
                        return self.infer_call(e, Expr { id: callee.id, line: callee.line, col: callee.col, sp: callee.sp, kind: ExprKind.Name(field) }, all, expected)
                    }
                }
                return self.infer_method_call(e, callee, target, field, args, expected)
            },
            _ => {},
        }
        let name = match callee.kind { ExprKind.Name(nm) => nm, _ => "" }
        if name == "" { return self.infer_indirect_call(e, callee, args) }
        if self.redefined.contains(name) { return Err(poisoned()) }   // written against the left-out redefinition (MYLA-110)
        if starts_with_dunder(name) && is_builtin_func(name) {
            // raw memory outside the standard library: an error (the review
            // of 2026-11-06, R4: natively a bare crash); the others warn (D100)
            if is_raw_memory_primitive(name) && !self.primitives && !self.in_std() { return Err(raw_memory_call(callee, name)) }
            self.warn_primitive(callee, name)
        }
        if !as_method && builtin_method_name(name) { return Err(function_form(callee, name)) }

        if name == "print" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "print() takes exactly one argument")) }
            let at = self.expect_value(args[0], None)?
            // a type with its own form prints as `{x}` would (D159)
            if self.has_format(at)? { return Ok(None) }
            if !is_printable(at) { return Err(terr_at(e.line, e.col, e.sp, format("print() cannot print a value of type '{}'", type_name(at)))) }
            return Ok(None)
        }
        if name == "__write" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__write() takes (fd: int32, s: str)")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let s_t = self.expect_value(args[1], Some(Type.TStr))?
            if !is_str(s_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write() expects a string, found '{}'", type_name(s_t)))) }
            return Ok(None)
        }
        if name == "__write_bytes" {
            // `__write` of a list of bytes, without a string between (D177)
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__write_bytes() takes (fd: int32, b: [uint8])")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write_bytes() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let b_t = self.expect_value(args[1], Some(Type.TList(t_byte())))?
            if !type_eq(b_t, Type.TList(t_byte())) { return Err(terr_at(args[1].line, args[1].col, args[1].sp, format("__write_bytes() takes (fd: int32, b: [uint8]): found '{}'", type_name(b_t)))) }
            return Ok(None)
        }
        if name == "__exit" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__exit() takes exactly one argument")) }
            let c_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(c_t) { return Err(terr_at(e.line, e.col, e.sp, format("__exit() code must be an integer, found '{}'", type_name(c_t)))) }
            return Ok(None)
        }
        if name == "__args" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "__args() takes no arguments")) }
            return Ok(Some(Type.TList(Type.TStr)))
        }
        if name == "__read_file" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__read_file() takes exactly one argument")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read_file() expects a string path, found '{}'", type_name(p_t)))) }
            return Ok(Some(Type.TStr))
        }
        if name == "__read" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__read() takes (fd: int32, n: int32)")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let n_t = self.expect_value(args[1], Some(t_int()))?
            if !is_int(n_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read() n must be an integer, found '{}'", type_name(n_t)))) }
            return Ok(Some(Type.TStr))
        }
        if name == "__read_bytes" {
            // `__read`'s bytes as a list, without a string between (D177)
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__read_bytes() takes (fd: int32, n: int32)")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read_bytes() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let n_t = self.expect_value(args[1], Some(t_int()))?
            if !is_int(n_t) { return Err(terr_at(e.line, e.col, e.sp, format("__read_bytes() n must be an integer, found '{}'", type_name(n_t)))) }
            return Ok(Some(Type.TList(t_byte())))
        }
        if name == "__poll" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__poll() takes (fd: int32, timeout_ms: int32)")) }
            let fd_t = self.expect_value(args[0], Some(t_int()))?
            if !is_int(fd_t) { return Err(terr_at(e.line, e.col, e.sp, format("__poll() fd must be an integer, found '{}'", type_name(fd_t)))) }
            let t_t = self.expect_value(args[1], Some(t_int()))?
            if !is_int(t_t) { return Err(terr_at(e.line, e.col, e.sp, format("__poll() timeout must be an integer, found '{}'", type_name(t_t)))) }
            return Ok(Some(t_int()))
        }
        if name == "__io_errno" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "__io_errno() takes no arguments")) }
            return Ok(Some(t_int()))
        }
        if name == "__getcwd" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "__getcwd() takes no arguments")) }
            return Ok(Some(Type.TStr))
        }
        // the running case's scratch root and the project's program under
        // test (std.test, D162), "" outside `myla test`
        if name == "__test_dir" || name == "__test_program" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes no arguments", name))) }
            return Ok(Some(Type.TStr))
        }
        // the monotonic clock in nanoseconds, and a sleep of the thread (D124,
        // `std.time`, the interpreter's sleeping tasks)
        if name == "__clock_ns" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "__clock_ns() takes no arguments")) }
            return Ok(Some(Type.TInt(64, true)))
        }
        if name == "__sleep_ns" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__sleep_ns() takes (n: int64)")) }
            let n_t = self.expect_value(args[0], Some(Type.TInt(64, true)))?
            if !type_eq(n_t, Type.TInt(64, true)) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("__sleep_ns() takes an 'int64', found '{}'", type_name(n_t)))) }
            return Ok(None)
        }
        // raw memory, for the runtime written in Myla (MYLA-162's prototype):
        // `__load8(p)`, `__load64(p)`, `__store8(p, v)`, `__store64(p, v)`,
        // `__alloc(n)` (a cell's address), `__addr_of(s)` (a string's cell,
        // borrowed), `__str_of(p)` (a cell taken over as a string),
        // `__copy_bytes(dst, src, n)` and `__equal_bytes(p, q, n)` (a bulk
        // copy and comparison each backend does natively), `__free(p)`; and
        // Linux's platform layer: `__syscall(n, a, b, c)` (the result, a
        // negative errno on a failure), `__set_io_errno(e)` and `__environ()`
        // (the environment the process started with: the address of its
        // NUL-terminated `name=value` strings' addresses, a null one last);
        // `__set_run_status(exit, signal, errno)` and `__set_run_stderr(bytes)`
        // (what `__run_exit_code`, `__run_signal`, `__run_errno` and
        // `__run_stderr` give next); `__argv()` (the program's arguments: the
        // address of their C strings' addresses, a null one last);
        // `__load32(p)`, `__store32(p, v)`; `__list_addr(xs)` (a list's cell,
        // borrowed: its length, its capacity, then its elements) and
        // `__list_of(p)` (a cell taken over as the list type its context
        // expects); `__rotl(x, k)` (`x` rotated left by `k` bits, a `rol`);
        // the allocator's: `__rt_addr("sym")` and `__rt_get("sym")` (the
        // address and the value of the runtime's variable `sym`, a worker's
        // own with tasks), `__bsr64(x)` (the highest set bit's index) and
        // `__trap_oom()` (the out-of-memory runtime error); with tasks,
        // `__rt_waddr("sym", w)` (worker `w`'s own of a runtime variable),
        // `__cas64(p, old, new)` (whether the 8 bytes at `p` were `old` and
        // are `new` now, at once), `__xchg64(p, v)` (the 8 bytes at `p`
        // before `v` replaced them, at once), `__fetch_add64(p, v)` (the 8
        // bytes at `p` before `v` was added to them, at once), `__pause()`
        // (a spinning loop's hint to the processor), `__run_frame(fr)` (the
        // executor resuming a frame, D90: until it suspends or ends) and
        // `__f64_round(x)` (a float64 rounded to the nearest int64, ties to
        // even, for formatting floats); `__load_acq64(p)` and
        // `__store_rel64(p, v)` (the 8 bytes at `p` read with acquire, written
        // with release ordering: nothing after the read is seen before it,
        // nothing before the write after it; MYLA-267)
        if is_raw_memory_primitive(name) {
            let i64 = Type.TInt(64, true)
            if name == "__rt_addr" || name == "__rt_get" || name == "__rt_waddr" {
                var want_n = 1
                if name == "__rt_waddr" { want_n = 2 }
                if args.len() != want_n { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes {} argument(s)", name, want_n))) }
                if name == "__rt_waddr" {
                    let w_t = self.expect_value(args[1], Some(i64))?
                    if !type_eq(w_t, i64) { return Err(terr_at(args[1].line, args[1].col, args[1].sp, format("__rt_waddr() takes a 'int64' here, found '{}'", type_name(w_t)))) }
                }
                let ok = match args[0].kind {
                    ExprKind.StrLit(sym) => sym.len() > 2 && sym[0] == '_' && sym[1] == '_',
                    _ => false,
                }
                if !ok { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() takes the name of a runtime variable as a string literal", name))) }
                return Ok(Some(i64))
            }
            if name == "__trap_oom" {
                if args.len() != 0 { return Err(terr_at(e.line, e.col, e.sp, "__trap_oom() takes no arguments")) }
                return Ok(None)
            }
            if name == "__list_addr" {
                if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__list_addr() takes 1 argument(s)")) }
                let l_t = self.expect_value(args[0], None)?
                match l_t {
                    Type.TList(el) => { return Ok(Some(i64)) },
                    _ => { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("__list_addr() takes a list, found '{}'", type_name(l_t)))) },
                }
            }
            if name == "__list_of" {
                if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__list_of() takes 1 argument(s)")) }
                let p_t = self.expect_value(args[0], Some(i64))?
                if !type_eq(p_t, i64) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("__list_of() takes a 'int64' here, found '{}'", type_name(p_t)))) }
                match expected {
                    Some(Type.TList(el)) => { return Ok(Some(Type.TList(el))) },
                    _ => { return Err(terr_at(e.line, e.col, e.sp, "__list_of() needs the list type from its context (an annotation, a parameter, a return type)")) },
                }
            }
            var want: [Type] = [i64]
            if name == "__store8" { want = [i64, Type.TInt(8, false)] }
            if name == "__store64" { want = [i64, i64] }
            if name == "__store32" { want = [i64, Type.TInt(32, false)] }
            if name == "__rotl" || name == "__call_code" { want = [i64, i64] }
            if name == "__cas64" { want = [i64, i64, i64] }
            if name == "__xchg64" || name == "__fetch_add64" || name == "__store_rel64" { want = [i64, i64] }
            if name == "__f64_round" { want = [Type.TFloat(64)] }
            if name == "__copy_bytes" || name == "__equal_bytes" { want = [i64, i64, i64] }
            if name == "__syscall" { want = [i64, i64, i64, i64] }
            if name == "__syscall5" { want = [i64, i64, i64, i64, i64, i64] }
            if name == "__addr_of" { want = [Type.TStr] }
            if name == "__environ" || name == "__argv" || name == "__pause" { want = [] }
            if name == "__set_run_status" { want = [i64, i64, i64] }
            if name == "__set_run_stderr" { want = [Type.TList(Type.TInt(8, false))] }
            if args.len() != want.len() { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes {} argument(s)", name, want.len()))) }
            var k = 0
            while k < want.len() {
                let a_t = self.expect_value(args[k], Some(want[k]))?
                if !type_eq(a_t, want[k]) { return Err(terr_at(args[k].line, args[k].col, args[k].sp, format("{}() takes a '{}' here, found '{}'", name, type_name(want[k]), type_name(a_t)))) }
                k = k + 1
            }
            if name == "__load8" { return Ok(Some(Type.TInt(8, false))) }
            if name == "__load32" { return Ok(Some(Type.TInt(32, false))) }
            if name == "__equal_bytes" || name == "__cas64" { return Ok(Some(Type.TBool)) }
            if name == "__store8" || name == "__store32" || name == "__store64" || name == "__store_rel64" || name == "__copy_bytes" || name == "__set_io_errno" || name == "__free" || name == "__set_run_status" || name == "__set_run_stderr" || name == "__pause" || name == "__run_frame" { return Ok(None) }
            if name == "__str_of" { return Ok(Some(Type.TStr)) }
            return Ok(Some(i64))
        }
        // std.math's primitives (MYLA-248)
        if name == "__sqrt" || name == "__f64_bits" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes (x: float64)", name))) }
            let x_t = self.expect_value(args[0], Some(Type.TFloat(64)))?
            if !type_eq(x_t, Type.TFloat(64)) { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes a float64, found '{}'", name, type_name(x_t)))) }
            if name == "__sqrt" { return Ok(Some(Type.TFloat(64))) }
            return Ok(Some(Type.TInt(64, false)))
        }
        if name == "__f64_from_bits" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__f64_from_bits() takes (bits: uint64)")) }
            let b_t = self.expect_value(args[0], Some(Type.TInt(64, false)))?
            if !type_eq(b_t, Type.TInt(64, false)) { return Err(terr_at(e.line, e.col, e.sp, format("__f64_from_bits() takes a uint64, found '{}'", type_name(b_t)))) }
            return Ok(Some(Type.TFloat(64)))
        }
        if name == "__getenv" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__getenv() takes (name: str)")) }
            let n_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(n_t) { return Err(terr_at(e.line, e.col, e.sp, format("__getenv() name must be a string, found '{}'", type_name(n_t)))) }
            return Ok(Some(Type.TStr))
        }
        if name == "__write_file" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__write_file() takes (path: str, contents: str)")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write_file() path must be a string, found '{}'", type_name(p_t)))) }
            let c_t = self.expect_value(args[1], Some(Type.TStr))?
            if !is_str(c_t) { return Err(terr_at(e.line, e.col, e.sp, format("__write_file() contents must be a string, found '{}'", type_name(c_t)))) }
            return Ok(None)
        }
        if name == "__list_dir" || name == "__stat" {
            if args.len() != 1 { return Err(terr(e.line, e.col, format("{}() takes (path: str)", name))) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr(e.line, e.col, format("{}() path must be a string, found '{}'", name, type_name(p_t)))) }
            if name == "__list_dir" { return Ok(Some(Type.TStr)) }
            return Ok(Some(t_int()))
        }
        if name == "__str_to_bytes" || name == "__bytes_to_str" {
            // a string's bytes as a list and back, in one copy (MYLA-369)
            var want = Type.TStr
            var result = Type.TList(t_byte())
            var shape = "s: str"
            if name == "__bytes_to_str" {
                want = Type.TList(t_byte())
                result = Type.TStr
                shape = "b: [uint8]"
            }
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes ({})", name, shape))) }
            let a_t = self.expect_value(args[0], Some(want))?
            if !type_eq(a_t, want) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() takes ({}): found '{}'", name, shape, type_name(a_t)))) }
            return Ok(Some(result))
        }
        if name == "__mkdir" {
            if args.len() != 2 { return Err(terr(e.line, e.col, "__mkdir() takes (path: str, mode: int32)")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr(e.line, e.col, format("__mkdir() path must be a string, found '{}'", type_name(p_t)))) }
            let m_t = self.expect_value(args[1], Some(t_int()))?
            if !is_int(m_t) { return Err(terr(e.line, e.col, format("__mkdir() mode must be an integer, found '{}'", type_name(m_t)))) }
            return Ok(None)
        }
        if name == "__unlink" || name == "__rmdir" || name == "__rename" {
            // unlink(2), rmdir(2), rename(2) (MYLA-96): paths, no result
            var want = "path: str"
            var nargs = 1
            if name == "__rename" {
                want = "from: str, to: str"
                nargs = 2
            }
            if args.len() != nargs { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes ({})", name, want))) }
            for a in args {
                let a_t = self.expect_value(a, Some(Type.TStr))?
                if !is_str(a_t) { return Err(terr_at(a.line, a.col, a.sp, format("{}() paths must be strings, found '{}'", name, type_name(a_t)))) }
            }
            return Ok(None)
        }
        if name == "__run" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__run() takes (program: str, argv: [str])")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("__run() program must be a string, found '{}'", type_name(p_t)))) }
            let a_t = self.expect_value(args[1], Some(Type.TList(Type.TStr)))?
            let a_ok = match a_t { Type.TList(el) => is_str(el), _ => false }
            if !a_ok { return Err(terr_at(e.line, e.col, e.sp, format("__run() argv must be a [str], found '{}'", type_name(a_t)))) }
            return Ok(Some(Type.TList(t_byte())))
        }
        // a child started and not waited for (D124, `std.process.run_async`):
        // `[errno, pid, out, err, exited]`; then reaped (its exit code, or
        // minus its signal), signalled, its descriptors closed
        if name == "__spawn" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__spawn() takes (program: str, argv: [str])")) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("__spawn() program must be a string, found '{}'", type_name(p_t)))) }
            let a_t = self.expect_value(args[1], Some(Type.TList(Type.TStr)))?
            let a_ok = match a_t { Type.TList(el) => is_str(el), _ => false }
            if !a_ok { return Err(terr_at(e.line, e.col, e.sp, format("__spawn() argv must be a [str], found '{}'", type_name(a_t)))) }
            return Ok(Some(Type.TList(t_int())))
        }
        // `__run` and `__spawn` with the options of D147 (`std.rt.run_with`):
        // the program looked for in PATH, a directory, stdin, an environment
        if name == "__run_with" || name == "__spawn_with" {
            if args.len() != 3 { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes (program: str, argv: [str], opts: [str])", name))) }
            let p_t = self.expect_value(args[0], Some(Type.TStr))?
            if !is_str(p_t) { return Err(terr_at(e.line, e.col, e.sp, format("{}() program must be a string, found '{}'", name, type_name(p_t)))) }
            var k = 1
            while k < 3 {
                let a_t = self.expect_value(args[k], Some(Type.TList(Type.TStr)))?
                let a_ok = match a_t { Type.TList(el) => is_str(el), _ => false }
                if !a_ok { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes a [str] for its argument {}, found '{}'", name, k + 1, type_name(a_t)))) }
                k += 1
            }
            if name == "__run_with" { return Ok(Some(Type.TList(t_byte()))) }
            return Ok(Some(Type.TList(t_int())))
        }
        if name == "__reap" || name == "__close" || name == "__kill" {
            var want = 1
            if name == "__kill" { want = 2 }
            if args.len() != want { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes {} int argument(s)", name, want))) }
            for a in args {
                let t = self.expect_value(a, Some(t_int()))?
                if !type_eq(t, t_int()) { return Err(terr_at(a.line, a.col, a.sp, format("{}() takes an 'int', found '{}'", name, type_name(t)))) }
            }
            if name == "__reap" { return Ok(Some(t_int())) }
            return Ok(None)
        }
        if is_platform_primitive(name) { return self.infer_platform_primitive(e, name, args) }
        if is_notify_primitive(name) { return self.infer_notify_primitive(e, name, args) }
        if name == "__run_stderr" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "__run_stderr() takes no arguments")) }
            return Ok(Some(Type.TList(t_byte())))
        }
        if name == "__task_cancelled" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "__task_cancelled() takes no arguments")) }
            return Ok(Some(Type.TBool))
        }
        // a turn for the other tasks (MYLA-228, `std.task.yield`): a call that
        // suspends, so it is awaited
        if name == "__yield" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "__yield() takes no arguments")) }
            self.suspended = e.id
            if !self.awaited.contains(e.id) { return Err(terr_at(e.line, e.col, e.sp, "a call to '__yield' needs 'await'")) }
            return Ok(None)
        }
        // until `a` or `b` is readable (a child's two pipes)
        if name == "__wait_either" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__wait_either() takes (a: int, b: int)")) }
            for a in args {
                let f_t = self.expect_value(a, Some(t_int()))?
                if !type_eq(f_t, t_int()) { return Err(terr_at(a.line, a.col, a.sp, format("__wait_either() takes an 'int', found '{}'", type_name(f_t)))) }
            }
            self.suspended = e.id
            if !self.awaited.contains(e.id) { return Err(terr_at(e.line, e.col, e.sp, "a call to '__wait_either' needs 'await'")) }
            return Ok(None)
        }
        // the running task waiting until the socket `h` is ready for
        // `events` (1 to receive, 2 to send; MYLA-346, `std.net`'s async
        // forms); without tasks, the thread waits in `__sock_poll`
        if name == "__wait_socket" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__wait_socket() takes (h: int, events: int)")) }
            for a in args {
                let a_t = self.expect_value(a, Some(t_int()))?
                if !type_eq(a_t, t_int()) { return Err(terr_at(a.line, a.col, a.sp, format("__wait_socket() takes an 'int', found '{}'", type_name(a_t)))) }
            }
            self.suspended = e.id
            if !self.awaited.contains(e.id) { return Err(terr_at(e.line, e.col, e.sp, "a call to '__wait_socket' needs 'await'")) }
            return Ok(None)
        }
        // the running task waiting until `fd` is readable (D124, `std.io`'s
        // async reads)
        if name == "__wait_readable" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__wait_readable() takes (fd: int)")) }
            let f_t = self.expect_value(args[0], Some(t_int()))?
            if !type_eq(f_t, t_int()) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("__wait_readable() takes an 'int', found '{}'", type_name(f_t)))) }
            self.suspended = e.id
            if !self.awaited.contains(e.id) { return Err(terr_at(e.line, e.col, e.sp, "a call to '__wait_readable' needs 'await'")) }
            return Ok(None)
        }
        // the running task asleep for `ms` milliseconds (D124, `std.task.sleep`)
        if name == "__sleep" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__sleep() takes (ms: int)")) }
            let m_t = self.expect_value(args[0], Some(t_int()))?
            if !type_eq(m_t, t_int()) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("__sleep() takes an 'int', found '{}'", type_name(m_t)))) }
            self.suspended = e.id
            if !self.awaited.contains(e.id) { return Err(terr_at(e.line, e.col, e.sp, "a call to '__sleep' needs 'await'")) }
            return Ok(None)
        }
        if name == "__run_exit_code" || name == "__run_signal" || name == "__run_errno" {
            if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes no arguments", name))) }
            return Ok(Some(t_int()))
        }
        if name == "len" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, method_arity("len", 0))) }
            let at = self.expect_value(args[0], None)?
            let ok = match at { Type.TList(x) => true, Type.TMap(k, v) => true, Type.TStr => true, Type.TSB => true, _ => false }
            if !ok { return Err(terr_at(e.line, e.col, e.sp, format("len() requires a list, map, string, or StringBuilder, found '{}'", type_name(at)))) }
            return Ok(Some(t_int()))
        }
        if name == "chars" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, method_arity("chars", 0))) }
            let at = self.expect_value(args[0], None)?
            if !is_str(at) { return Err(terr_at(e.line, e.col, e.sp, format("chars() requires a string, found '{}'", type_name(at)))) }
            return Ok(Some(Type.TList(Type.TChar)))
        }
        if self.is_task_cancel(name) {
            // what the back ends know it by, inside std.task too (MYLA-388)
            if name != "std$task$cancel" {
                self.renames[callee.id] = "std$task$cancel"
                self.fill_decls[self.cur_decl] = true
            }
            return self.infer_task_cancel(e, args)
        }
        // `__cancel_after(a, ms)` (D124, `task.timeout`): the child of the
        // `async let` named `a` cancelled after `ms` milliseconds; the cell
        // `__disarm(cell)` reads (whether that hadn't happened yet)
        if name == "__cancel_after" {
            if args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, "__cancel_after() takes (child, ms: int)")) }
            let c = self.infer_task_cancel(e, [args[0]])?
            let m_t = self.expect_value(args[1], Some(t_int()))?
            if !type_eq(m_t, t_int()) { return Err(terr_at(args[1].line, args[1].col, args[1].sp, format("__cancel_after() takes an 'int', found '{}'", type_name(m_t)))) }
            return Ok(Some(Type.TInt(64, true)))
        }
        if name == "__disarm" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "__disarm() takes (cell: int64)")) }
            let c_t = self.expect_value(args[0], Some(Type.TInt(64, true)))?
            if !type_eq(c_t, Type.TInt(64, true)) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("__disarm() takes an 'int64', found '{}'", type_name(c_t)))) }
            return Ok(Some(Type.TBool))
        }
        if name == "push" || name == "pop" { return self.infer_list_mutation(e, name, args) }
        if name == "contains" || name == "remove" || name == "keys" { return self.infer_map_builtin(e, name, args) }
        if name == "format" { return Ok(Some(self.infer_format(e, args)?)) }
        if name == "StringBuilder" || name == "append" || name == "append_byte" || name == "append_char" || name == "build" { return self.infer_string_builder(e, name, args) }
        if is_wrapping_method(name) { return self.infer_wrapping(e, name, args) }
        if is_builtin_func(name) { return self.infer_intrinsic(e, name, args) }

        let fi = self.func_idx(name)
        self.called[name] = true
        if fi < 0 {
            match prelude_variant_enum(name) {
                Some(en) => {
                    let shadowed = match self.lookup(name) { Some(b) => true, None => false }
                    if !shadowed { return Ok(Some(self.infer_variant_ctor(e, en, name, args, expected)?)) }
                },
                None => {},
            }
            return Err(with_notes(terr_at(e.line, e.col, e.sp, format("unknown function '{}'", name)), unknown_function_notes(name, self.callable_names())))
        }
        let sig = self.functions[fi]
        if sig.type_params.len() > 0 {
            let gr = self.infer_generic_call(e, name, sig, args, expected)?
            self.mark_call(e, "function", name, sig_mutates(sig), "", sig.decl.is_async)
            return Ok(gr)
        }
        if call_targs(e).len() > 0 { return Err(not_generic(e, format("function '{}'", name))) }
        self.call_arity(e, sig, 0, args.len(), format("function '{}'", name))?
        var i = 0
        while i < args.len() {
            if !has_error(sig.params[i]) {   // else the parameter's type failed (MYLA-110)
                let at = self.expect_value(args[i], Some(sig.params[i]))?
                if !type_eq(at, sig.params[i]) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", name, type_name(sig.params[i]), type_name(at)))) }
            }
            i = i + 1
        }
        self.mark_call(e, "function", name, sig_mutates(sig), "", sig.decl.is_async)
        return Ok(sig.ret)
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "pop", [Expr { id: 5, line: 7, col: 17, sp: SrcSpan { sline: 7, scol: 17, eline: 7, ecol: 19 }, kind: ExprKind.Name("xs") }])[Err(CheckErr { line: 7, col: 17, sp: SrcSpan { sline: 7, scol: 17, eline: 7, ecol: 19 }, msg: "unknown name 'xs'", decl: -1, notes: [] })]
    fun infer_list_mutation(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        var nargs = 1
        if name == "push" { nargs = 2 }
        if args.len() != nargs { return Err(terr_at(e.line, e.col, e.sp, method_arity(name, nargs - 1))) }
        let lv = self.check_lvalue(args[0])?
        let elem = match lv.ty { Type.TList(el) => el, _ => { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() requires a list, found '{}'", name, type_name(lv.ty)))) } }
        if !lv.mutable { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() needs a mutable list (declare it with 'var')", name))) }
        if name == "push" {
            self.expect_type(args[1], elem, "push value")?
            return Ok(None)
        }
        return Ok(Some(elem))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "contains", [Expr { id: 52, line: 4, col: 17, sp: SrcSpan { sline: 4, scol: 17, eline: 4, ecol: 18 }, kind: ExprKind.Name("m") }, Expr { id: 53, line: 4, col: 20, sp: SrcSpan { sline: 4, scol: 20, eline: 4, ecol: 21 }, kind: ExprKind.Name("k") }])[Err(CheckErr { line: 4, col: 17, sp: SrcSpan { sline: 4, scol: 17, eline: 4, ecol: 18 }, msg: "unknown name 'm'", decl: -1, notes: [] })]
    fun infer_map_builtin(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        var nargs = 2
        if name == "keys" { nargs = 1 }
        if args.len() != nargs { return Err(terr_at(e.line, e.col, e.sp, method_arity(name, nargs - 1))) }
        var map_t = Type.TStr
        var mutable = true
        if name == "remove" {
            let lv = self.check_lvalue(args[0])?
            map_t = lv.ty
            mutable = lv.mutable
        } else {
            map_t = self.expect_value(args[0], None)?
        }
        let kv: Option<Type> = match map_t { Type.TMap(k, v) => Some(Type.TTuple([k, v])), _ => None }
        match kv { Some(x) => {}, None => { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() requires a map, found '{}'", name, type_name(map_t)))) } }
        let mk = match map_t { Type.TMap(k, v) => k, _ => Type.TStr }
        let mv = match map_t { Type.TMap(k, v) => v, _ => Type.TStr }
        self.key_ok(mk, e.line, e.col, e.sp)?
        if name == "keys" { return Ok(Some(Type.TList(mk))) }
        self.expect_type(args[1], mk, "map key")?
        if name == "contains" { return Ok(Some(Type.TBool)) }
        if !mutable { return Err(terr_at(args[0].line, args[0].col, args[0].sp, "remove() needs a mutable map (declare it with 'var')")) }
        return Ok(None)
    }

    // Whether a value of type `t` has its own form: a type of the program's
    // implementing `Format`, or a type parameter bound by it (D139, D159).
    fun has_format(self, t: Type) -> Result<bool, CheckErr> {
        if is_struct_or_enum(t) { return self.type_implements(t, "Format") }
        return match t {
            Type.TParam(pn) => Ok(self.bound_has(pn, "Format")),
            _ => Ok(false),
        }
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), [Expr { id: 244, line: 126, col: 19, sp: SrcSpan { sline: 126, scol: 19, eline: 126, ecol: 45 }, kind: ExprKind.StrLit("braces {{}} stay literal") }])[Ok(Type.TStr)]
    fun infer_format(var self, e: Expr, args: [Expr]) -> Result<Type, CheckErr> {
        if args.len() == 0 { return Err(terr_at(e.line, e.col, e.sp, "format() needs a string literal format and its arguments")) }
        let fmt = args[0]
        let fval = match fmt.kind { ExprKind.StrLit(s) => s, _ => { return Err(terr_at(fmt.line, fmt.col, fmt.sp, "format()'s first argument must be a string literal")) } }
        let holes = count_format_holes(fval, fmt.line, fmt.col)?
        let rest = args.len() - 1
        if holes != rest { return Err(terr_at(e.line, e.col, e.sp, format("format() has {} placeholder(s) but {} argument(s)", holes, rest))) }
        let specs = format_specs(fval)
        var i = 1
        while i < args.len() {
            let at = self.expect_value(args[i], None)?
            let spec = specs[i - 1]
            // a type of the program's with its own form (D139): the spec is its
            // and a type parameter bound by it (MYLA-291)
            if self.has_format(at)? {
                i = i + 1
                continue
            }
            if !is_printable(at) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("format() cannot render a value of type '{}'", type_name(at)))) }
            if spec != "" {
                let sp = match parse_spec(spec) {
                    Ok(x) => x
                    Err(why) => { return Err(terr_at(args[i].line, args[i].col, args[i].sp, why)) }
                }
                var class = 2
                if is_int(at) { class = 0 } else if is_float(at) { class = 1 }
                let need = spec_need(sp, class)
                if need != "" { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("the format spec '{}' {}, found '{}'", spec, need, type_name(at)))) }
            }
            i = i + 1
        }
        return Ok(Type.TStr)
    }

    // `x.wrapping_add(y)`, `x.wrapping_sub(y)`, `x.wrapping_mul(y)` and
    // `x.wrapping_neg()` on an integer `x` (D175): of `x`'s type, `y` too.
    fun infer_wrapping(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        let n = if name == "wrapping_neg" { 0 } else { 1 }
        if args.len() != n + 1 { return Err(terr_at(e.line, e.col, e.sp, method_arity(name, n))) }
        let at = self.expect_value(args[0], None)?
        if !is_int(at) { return Err(terr_at(e.line, e.col, e.sp, format("{}() requires an integer, found '{}'", name, type_name(at)))) }
        if n == 1 {
            let bt = self.expect_value(args[1], Some(at))?
            if !type_eq(bt, at) { return Err(terr_at(args[1].line, args[1].col, args[1].sp, format("{}() takes a '{}', found '{}'", name, type_name(at), type_name(bt)))) }
        }
        return Ok(Some(at))
    }

    #test(checker_on("[int]"), Expr { id: 1, line: 5, col: 27, sp: SrcSpan { sline: 5, scol: 14, eline: 5, ecol: 29 }, kind: ExprKind.Call(Expr { id: 0, line: 5, col: 14, sp: SrcSpan { sline: 5, scol: 14, eline: 5, ecol: 27 }, kind: ExprKind.Name("StringBuilder") }, [], []) }, "StringBuilder", [])[Ok(Some(Type.TSB))]
    fun infer_string_builder(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if name == "StringBuilder" {
            // `StringBuilder(n)`: room for `n` bytes before it grows (MYLA-369)
            let shape = "StringBuilder() takes nothing or a capacity (capacity: int)"
            if args.len() > 1 { return Err(terr_at(e.line, e.col, e.sp, shape)) }
            if args.len() == 1 {
                let n_t = self.expect_value(args[0], Some(t_int()))?
                if !type_eq(n_t, t_int()) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}: found '{}'", shape, type_name(n_t)))) }
            }
            return Ok(Some(Type.TSB))
        }
        if name == "build" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, method_arity("build", 0))) }
            let at = self.expect_value(args[0], None)?
            if !is_sb(at) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("build() requires a StringBuilder, found '{}'", type_name(at)))) }
            return Ok(Some(Type.TStr))
        }
        // sb.append(s, start, end) appends the bytes s[start..end] (MYLA-85)
        if name == "append" && args.len() != 2 && args.len() != 4 { return Err(terr_at(e.line, e.col, e.sp, "append() takes 1 or 3 arguments (a string, or a string and the bytes from, to)")) }
        if (name == "append_byte" || name == "append_char") && args.len() != 2 { return Err(terr_at(e.line, e.col, e.sp, method_arity(name, 1))) }
        let lv = self.check_lvalue(args[0])?
        if !is_sb(lv.ty) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() requires a StringBuilder, found '{}'", name, type_name(lv.ty)))) }
        if !lv.mutable { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("{}() needs a mutable StringBuilder (declare it with 'var')", name))) }
        if name == "append" {
            self.expect_type(args[1], Type.TStr, "append value")?
            if args.len() == 4 {
                self.expect_type(args[2], t_int(), "append start")?
                self.expect_type(args[3], t_int(), "append end")?
            }
        } else if name == "append_char" {
            // a character's UTF-8 bytes (MYLA-390)
            self.expect_type(args[1], Type.TChar, "append_char value")?
        } else {
            self.expect_type(args[1], t_byte(), "append_byte value")?
        }
        return Ok(None)
    }

    // MYLA-336's primitives (`is_platform_primitive`): `__random_bytes(n)`,
    // `__open(path, flags, mode)`, `__seek(fd, offset, whence)`,
    // `__fstat(fd)`, `__spawn_piped(program, argv, opts)`, `__try_reap(pid)`,
    // MYLA-334's `__wall_ns()` and MYLA-378's `__path_stat(path, follow)`
    fun infer_platform_primitive(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        let i64 = Type.TInt(64, true)
        let strs = Type.TList(Type.TStr)
        var want: [Type] = [t_int()]
        var shape = "n: int"
        var result = Type.TList(t_byte())
        if is_net_primitive(name) {
            let sig = net_primitive_sig(name)
            shape = sig.0
            want = sig.1
            result = sig.2
        } else if is_term_primitive(name) {
            let sig = term_primitive_sig(name)
            shape = sig.0
            want = sig.1
            result = sig.2
        } else if name == "__open" {
            want = [Type.TStr, t_int(), t_int()]
            shape = "path: str, flags: int, mode: int"
            result = t_int()
        } else if name == "__seek" {
            want = [t_int(), i64, t_int()]
            shape = "fd: int, offset: int64, whence: int"
            result = i64
        } else if name == "__fstat" {
            shape = "fd: int"
            result = Type.TList(i64)
        } else if name == "__path_stat" {
            want = [Type.TStr, Type.TBool]
            shape = "path: str, follow: bool"
            result = Type.TList(i64)
        } else if name == "__spawn_piped" {
            want = [Type.TStr, strs, strs]
            shape = "program: str, argv: [str], opts: [str]"
            result = Type.TList(t_int())
        } else if name == "__try_reap" {
            shape = "pid: int"
            result = t_int()
        } else if name == "__wall_ns" {
            want = []
            shape = ""
            result = i64
        }
        if args.len() != want.len() { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes ({})", name, shape))) }
        var k = 0
        while k < want.len() {
            let a_t = self.expect_value(args[k], Some(want[k]))?
            if !type_eq(a_t, want[k]) { return Err(terr_at(args[k].line, args[k].col, args[k].sp, format("{}() takes ({}): a '{}' here, found '{}'", name, shape, type_name(want[k]), type_name(a_t)))) }
            k += 1
        }
        return Ok(Some(result))
    }

    // MYLA-387's primitives (`is_notify_primitive`): `__notifier()`,
    // `__notify(n, all)`, `__notify_gen(n)`, `__waiter(n, since, ms)`,
    // `await __park(w)` (it suspends) and `__woken(w)`
    fun infer_notify_primitive(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        let i64 = Type.TInt(64, true)
        var want: [Type] = [i64]
        var shape = "n: int64"
        var result: Option<Type> = Some(i64)
        if name == "__notifier" {
            want = []
            shape = ""
        } else if name == "__notify" {
            want = [i64, Type.TBool]
            shape = "n: int64, all: bool"
            result = None
        } else if name == "__waiter" {
            want = [i64, i64, t_int()]
            shape = "n: int64, since: int64, ms: int"
        } else if name == "__park" {
            shape = "w: int64"
            result = None
        } else if name == "__woken" {
            shape = "w: int64"
            result = Some(t_int())
        }
        if args.len() != want.len() { return Err(terr_at(e.line, e.col, e.sp, format("{}() takes ({})", name, shape))) }
        var k = 0
        while k < want.len() {
            let a_t = self.expect_value(args[k], Some(want[k]))?
            if !type_eq(a_t, want[k]) { return Err(terr_at(args[k].line, args[k].col, args[k].sp, format("{}() takes ({}): a '{}' here, found '{}'", name, shape, type_name(want[k]), type_name(a_t)))) }
            k += 1
        }
        // the running task parked until it is woken: a call that suspends
        if name == "__park" {
            self.suspended = e.id
            if !self.awaited.contains(e.id) { return Err(terr_at(e.line, e.col, e.sp, "a call to '__park' needs 'await'")) }
        }
        return Ok(result)
    }

    #test(checker_on("[int]"), Expr { id: 16, line: 7, col: 16, sp: SrcSpan { sline: 7, scol: 5, eline: 7, ecol: 18 }, kind: ExprKind.Call(Expr { id: 15, line: 7, col: 5, sp: SrcSpan { sline: 7, scol: 5, eline: 7, ecol: 16 }, kind: ExprKind.Name("unreachable") }, [], []) }, "unreachable", [])[Ok(None)]
    fun infer_intrinsic(var self, e: Expr, name: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        if name == "assert" {
            if !(args.len() == 1 || args.len() == 2) { return Err(terr_at(e.line, e.col, e.sp, "assert() takes a condition and an optional message")) }
            self.expect_type(args[0], Type.TBool, "assert condition")?
            if args.len() == 2 { self.expect_type(args[1], Type.TStr, "assert message")? }
            return Ok(None)
        }
        if name == "panic" {
            if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, "panic() takes exactly one message")) }
            self.expect_type(args[0], Type.TStr, "panic message")?
            return Ok(None)
        }
        // unreachable
        if args.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, "unreachable() takes no arguments")) }
        return Ok(None)
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), [Expr { id: 46, line: 32, col: 21, sp: SrcSpan { sline: 32, scol: 21, eline: 32, ecol: 22 }, kind: ExprKind.Name("x") }])[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun infer_indirect_call(var self, e: Expr, callee: Expr, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        let ft = self.expect_value(callee, None)?
        let ps = match strip_async(ft) { Type.TFunc(p, r) => p, _ => { return Err(terr_at(e.line, e.col, e.sp, format("cannot call a value of type '{}'", type_name(ft)))) } }
        let rr: Option<Type> = func_ret_of(ft)
        if args.len() != ps.len() { return Err(terr_at(e.line, e.col, e.sp, format("this function value expects {} argument(s), got {}", ps.len(), args.len()))) }
        var i = 0
        while i < args.len() {
            let at = self.expect_value(args[i], Some(ps[i]))?
            if !type_eq(at, ps[i]) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch: expected '{}', found '{}'", type_name(ps[i]), type_name(at)))) }
            i = i + 1
        }
        self.mark_call(e, "value", "", false, "", is_async_func(ft))
        return Ok(rr)
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "Maybe", "Just", [Expr { id: 118, line: 82, col: 33, sp: SrcSpan { sline: 82, scol: 33, eline: 82, ecol: 34 }, kind: ExprKind.IntLit(9, None, false, "") }], None)[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "enum 'Maybe' has no variant 'Just'", decl: -1, notes: [] })]
    fun infer_variant_ctor(var self, e: Expr, enum_name: str, variant: str, args: [Expr], expected: Option<Type>) -> Result<Type, CheckErr> {
        if !self.enum_has_variant(enum_name, variant) { return Err(terr_at(e.line, e.col, e.sp, format("enum '{}' has no variant '{}'", enum_name, variant))) }
        let payload = match self.enum_variant_payload(enum_name, [], variant) { Some(p) => p, None => empty_types() }
        if args.len() != payload.len() { return Err(terr_at(e.line, e.col, e.sp, format("variant '{}.{}' expects {} argument(s), got {}", enum_name, variant, payload.len(), args.len()))) }
        let ei = self.enum_idx(enum_name)
        let params = self.enums[ei].type_params
        if list_has_error(payload) && params.len() > 0 { return Err(poisoned()) }
        if params.len() == 0 {
            var i = 0
            while i < args.len() {
                if !has_error(payload[i]) {   // else the payload's type failed (MYLA-110)
                    let at = self.expect_value(args[i], Some(payload[i]))?
                    if !type_eq(at, payload[i]) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("variant '{}.{}': expected '{}', found '{}'", enum_name, variant, type_name(payload[i]), type_name(at)))) }
                }
                i = i + 1
            }
            return Ok(Type.TEnum(enum_name, []))
        }
        var exp_args: Option<[Type]> = enum_args_hint(expected, enum_name)
        let args_t = self.infer_type_args(params, payload, args, exp_args, e, format("variant '{}.{}'", enum_name, variant))?
        return Ok(Type.TEnum(enum_name, args_t))
    }

    // The substitution a call's explicit type arguments (D169) start from:
    // the last `sig.own_type_params` of its type parameters, a method's own
    // and not its impl's, which the receiver solves. Each argument's type is
    // kept with its node, where code generation reads the instance.
    fun explicit_subst(var self, e: Expr, sig: FuncSig, what: str) -> Result<[Subst], CheckErr> {
        let targs = call_targs(e)
        var out: [Subst] = []
        if targs.len() == 0 { return Ok(out) }
        let own = sig.own_type_params
        if own == 0 {
            if sig.type_params.len() > 0 { return Err(terr_at(targs[0].line, targs[0].col, targs_span(targs), format("{} takes no type arguments: it has no type parameters of its own, and its impl's come from the receiver", what))) }
            return Err(not_generic(e, what))
        }
        if targs.len() != own { return Err(terr_at(targs[0].line, targs[0].col, targs_span(targs), format("{} expects {} type argument(s), got {}", what, own, targs.len()))) }
        let base = sig.type_params.len() - own
        var i = 0
        while i < own {
            let t = self.resolve0(targs[i])?
            self.resolved[targs[i].id] = t
            out.push(Subst { name: sig.type_params[base + i], ty: t })
            i += 1
        }
        return Ok(out)
    }

    // The type parameters are solved from the explicit type arguments
    // (D169), then from the arguments, left to right, and
    // those they leave open from the call's `expected` type, which also
    // hints an argument whose parameter's type the arguments before it
    // don't solve (MYLA-315).
    fun infer_generic_call(var self, e: Expr, name: str, sig: FuncSig, args: [Expr], expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        if sig_has_error(sig.params, sig.ret) { return Err(poisoned()) }   // its type arguments can't be inferred (MYLA-110)
        var subst = self.explicit_subst(e, sig, format("function '{}'", name))?
        self.call_arity(e, sig, 0, args.len(), format("function '{}'", name))?
        let from_expected = expected_subst(sig.ret, expected)
        var arg_types: [Type] = []
        var i = 0
        while i < args.len() {
            let at = self.expect_value(args[i], arg_hint(sig.params[i], subst_then(subst, from_expected), is_lambda(args[i])))?
            arg_types.push(at)
            let r = unify_param(sig.params[i], at, subst)
            // what a bound fixes is known for the next argument's hint (D171)
            subst = self.solve_bounds(sig.bounds, r.subst)
            if sig.bounds.len() > 0 { self.check_generic_bounds(sig, subst, args[i])? }
            i = i + 1
        }
        subst = self.solve_bounds(sig.bounds, subst_then(subst, from_expected))
        var missing: [str] = []
        for tp in sig.type_params { if !subst_has(subst, tp) { missing.push(tp) } }
        if missing.len() > 0 {
            // the annotation is what's wrong, not missing (MYLA-315's follow-up)
            match result_clash(sig.ret, expected) {
                Some(c) => { return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {} for '{}': its result '{}' can't be the '{}' expected here", join_strs(missing, ", "), name, type_name(c.0), type_name(c.1)))) },
                None => {},
            }
            return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {} for '{}' from the arguments; add a type annotation to guide inference", join_strs(missing, ", "), name)))
        }
        var j = 0
        while j < args.len() {
            let want = subst_type(sig.params[j], subst)
            if !type_eq(arg_types[j], want) {
                if is_int(want) && is_flexible_int_lit(args[j]) { self.infer_int_lit(args[j], Some(want))? }
                else { return Err(terr_at(args[j].line, args[j].col, args[j].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", name, type_name(want), type_name(arg_types[j])))) }
            }
            j = j + 1
        }
        self.check_call_bounds(sig, subst, e)?
        self.prelude_need_all(subst)
        self.targs_taken = e.id
        self.call_types[e.id] = type_args_in(sig.type_params, subst)
        return Ok(opt_subst_type(sig.ret, subst))
    }

    // The bounds naming a generic trait with its arguments whose type
    // parameter `subst` knows, held to the trait, after the argument `arg`:
    // what such a bound solves the rest from, so its failure comes before
    // the type parameters it leaves unsolved (MYLA-383). A list where an
    // iterator is wanted gets a hint.
    fun check_generic_bounds(self, sig: FuncSig, subst: [Subst], arg: Expr) -> Result<int32, CheckErr> {
        for b in sig.bounds {
            match subst_get(subst, b.tp) {
                Some(concrete) => {
                    var j = 0
                    while j < b.traits.len() {
                        let tr = b.traits[j]
                        if b.args[j].len() > 0 {
                            let ok = match concrete { Type.TParam(pn) => self.bound_has(pn, tr), _ => self.type_implements(concrete, tr)? }
                            if !ok {
                                let msg = format("type '{}' does not satisfy the bound '{}: {}' required by '{}'", type_name(concrete), b.tp, generic_name(tr, subst_type_list(b.args[j], subst)), sig.decl.name)
                                return Err(CheckErr { line: arg.line, col: arg.col, sp: arg.sp, msg: msg, decl: -1, notes: self.iter_hint(concrete, tr, arg) })
                            }
                        }
                        j += 1
                    }
                },
                None => {},
            }
        }
        return Ok(0)
    }

    // A `help` for a value of type `t` given where an `Iterator` is wanted,
    // when `t` has an `iter()` method: a list's or a map's (MYLA-383).
    fun iter_hint(self, t: Type, tr: str, arg: Expr) -> [Note] {
        if tr != "Iterator" { return [] }
        let has = match self.type_key(t) {
            Some(k) => match self.method_sig(k, "iter") { Some(m) => true, None => false },
            None => false,
        }
        if !has { return [] }
        let how = match arg.kind {
            ExprKind.Name(n) => format("write '{}.iter()'", n),
            _ => "call its 'iter()'",
        }
        return [Note { label: "help", msg: format("'{}' is not an Iterator: {}", type_name(t), how), line: 0, col: 0, sp: no_span() }]
    }

    // The trait `tr` as a message names it: bare (`FromJson`, not
    // `std$json$FromJson`), unless another trait has that name, when its
    // module says which (`b.Show`, `unmangled` writes it; L6, MYLA-398).
    fun trait_text(self, tr: str) -> str {
        let bare = unqualified(tr)
        var n = 0
        for t in self.traits { if unqualified(t.name) == bare { n += 1 } }
        if n > 1 { return tr }
        return bare
    }

    fun check_call_bounds(self, sig: FuncSig, subst: [Subst], e: Expr) -> Result<int32, CheckErr> {
        for b in sig.bounds {
            match subst_get(subst, b.tp) {
                Some(concrete) => {
                    var j = 0
                    while j < b.traits.len() {
                        let tr = b.traits[j]
                        var ok = false
                        match concrete { Type.TParam(pn) => { ok = self.bound_has(pn, tr) }, _ => { ok = self.type_implements(concrete, tr)? } }
                        // a generic trait's arguments are its impl's (D171)
                        let want = subst_type_list(b.args[j], subst)
                        var have = want
                        if ok && want.len() > 0 {
                            match self.trait_args_of(concrete, tr) { Some(h) => { have = h }, None => {} }
                        }
                        if !ok || !type_list_eq(have, want) {
                            // a module's trait and function as a program writes them (`FromJson`, not `std$json$FromJson`)
                            var msg = format("type '{}' does not satisfy the bound '{}: {}' required by '{}'", type_name(concrete), b.tp, generic_name(self.trait_text(tr), want), unqualified(sig.decl.name))
                            if ok { msg = format("{}: it implements '{}'", msg, generic_name(self.trait_text(tr), have)) }
                            // its generic impl's bound unmet: the argument that isn't (MYLA-379)
                            var lacking = concrete
                            var lacks = tr
                            match self.failing_arg(concrete, tr) {
                                Some(ct) => {
                                    lacking = ct.0
                                    lacks = ct.1
                                    msg = format("{}: '{}' isn't {}", msg, type_name(lacking), unqualified(lacks))
                                },
                                None => {},
                            }
                            var err = terr_at(e.line, e.col, e.sp, msg)
                            if !ok { err.notes = self.json_help(lacking, lacks) }
                            return Err(err)
                        }
                        j += 1
                    }
                },
                None => {},
            }
        }
        return Ok(0)
    }

    // `callee` is the `target.field` node itself (a function-valued field is
    // typed through it, MYLA-33).
    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), expr_of("a.b[0]"), "total", [], None)[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun infer_method_call(var self, e: Expr, callee: Expr, target: Expr, field: str, args: [Expr], expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        let recv_type = self.expect_value(target, None)?
        // a type parameter's bounds give it their traits' methods (MYLA-291)
        match recv_type {
            Type.TParam(pn) => { return self.bound_method_call(e, target, pn, field, args) },
            // a tuple of `Hash` elements is `Hash` itself (D163): no impl can
            // name a tuple, so its `hash` is the language's
            Type.TTuple(es) => {
                if field == "hash" {
                    self.prelude_need(recv_type)
                    if !self.type_implements(recv_type, "Hash")? { return Err(terr_at(e.line, e.col, e.sp, format("type '{}' has no method 'hash': {}", type_name(recv_type), self.not_hash_why(recv_type)))) }
                    if args.len() != 1 { return Err(terr_at(e.line, e.col, e.sp, format("method 'hash' expects 1 argument(s), got {}", args.len()))) }
                    let hasher = Type.TStruct("Hasher", [])
                    let ht = self.expect_value(args[0], Some(hasher))?
                    if !type_eq(ht, hasher) { return Err(terr_at(args[0].line, args[0].col, args[0].sp, format("argument type mismatch in call to 'hash': expected 'Hasher', found '{}'", type_name(ht)))) }
                    return Ok(Some(hasher))
                }
            },
            _ => {},
        }
        let key_opt = self.type_key(recv_type)
        var sig_opt: Option<FuncSig> = None
        match key_opt { Some(k) => { sig_opt = self.method_sig(k, field) }, None => {} }
        match sig_opt {
            None => {
                // fallback: a struct field holding a function value
                match struct_view(recv_type) {
                    Type.TStruct(nm, sargs) => {
                        let fields = self.struct_field_types(nm, sargs)
                        let fopt = field_type_get(fields, field)
                        let is_func = match fopt {
                            Some(ft) => is_tfunc_type(ft),
                            None => false,
                        }
                        if is_func { return self.infer_indirect_call(e, callee, args) }
                        match fopt {
                            Some(ft) => {
                                if has_error(ft) { return Err(poisoned()) }   // the field's type failed (MYLA-110)
                                if !self.lost_methods.contains(field) {
                                    // a field that holds no function (MYLA-406)
                                    return Err(with_notes(terr_at(e.line, e.col, e.sp, format("type '{}' has no method '{}'", type_name(recv_type), field)), [Note { label: "help", msg: format("'{}' is a field of type '{}', not a function: read it without '()'", field, type_name(ft)), line: 0, col: 0, sp: no_span() }]))
                                }
                            },
                            None => {},
                        }
                    },
                    _ => {},
                }
                if self.lost_methods.contains(field) { return Err(poisoned()) }   // maybe a left-out impl's (MYLA-110)
                return Err(with_notes(terr_at(e.line, e.col, e.sp, format("type '{}' has no method '{}'", type_name(recv_type), field)), did_you_mean(field, self.method_names(key_opt))))
            },
            Some(sig) => {
                self.field_shadowed(e, target, recv_type, field)?
                self.called[sig.name] = true
                let recv = match sig.decl.receiver { Some(r) => r, None => "" }
                let mkey = match key_opt { Some(k) => k, None => "" }
                if recv == "" { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is a function of '{}' without 'self': call it on the type, '{}.{}(…)', not on a value", field, type_name(recv_type), type_name(recv_type), field))) }
                // an actor's handle needn't be mutable: its methods change the actor (D89)
                if recv == "var self" && !self.is_actor(mkey) {
                    if !is_lvalue_shape(target) { return Err(terr_at(e.line, e.col, e.sp, format("method '{}' mutates its receiver ('var self'); it needs a mutable variable (or one of its fields/elements), not a temporary", field))) }
                    let lv = self.check_lvalue(target)?
                    if !lv.mutable { return Err(with_notes(terr_at(e.line, e.col, e.sp, format("cannot call the mutating method '{}' on an immutable receiver (declare it with 'var')", field)), self.declared_at(target))) }
                }
                self.call_arity(e, sig, 1, args.len(), format("method '{}'", field))?
                // a list's or map's methods are keyed by its kind: an `impl
                // [int]`'s take only an `[int32]` (MYLA-221)
                if (mkey == "__list" || mkey == "__map") && sig.type_params.len() == 0 && !type_eq(recv_type, sig.params[0]) {
                    return Err(terr_at(e.line, e.col, e.sp, format("method '{}' is for '{}', not '{}'", field, type_name(sig.params[0]), type_name(recv_type))))
                }
                if sig.type_params.len() > 0 {
                    let gr = self.infer_generic_method(e, sig, field, recv_type, args, expected)?
                    self.mark_call(e, "method", sig.name, recv == "var self", mkey, sig.decl.is_async)
                    return Ok(gr)
                }
                if call_targs(e).len() > 0 { return Err(not_generic(e, format("method '{}'", field))) }
                var i = 0
                while i < args.len() {
                    let pt = sig.params[i + 1]
                    if !has_error(pt) {   // else the parameter's type failed (MYLA-110)
                        let at = self.expect_value(args[i], Some(pt))?
                        if !type_eq(at, pt) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", field, type_name(pt), type_name(at)))) }
                    }
                    i = i + 1
                }
                self.mark_call(e, "method", sig.name, recv == "var self", mkey, sig.decl.is_async)
                return Ok(sig.ret)
            },
        }
        return Err(terr_at(e.line, e.col, e.sp, format("type '{}' has no method '{}'", type_name(recv_type), field)))
    }

    // D178: `x.f(…)` finds the method `f`, and the receiver's field `f`
    // holds a function at this instantiation (`struct Cell<T> { get: T }`
    // with `T` a function type; a field declared with a function type
    // can't share a method's name): which one the call means is unclear, so
    // it is an error, the field reached through a binding.
    fun field_shadowed(var self, e: Expr, target: Expr, recv_type: Type, field: str) -> Result<int32, CheckErr> {
        let nm = match recv_type {
            Type.TStruct(n, a) => if a.len() > 0 { n } else { "" },
            Type.TActor(n, a) => if a.len() > 0 { n } else { "" },
            _ => "",
        }
        if nm == "" { return Ok(0) }
        if !self.tp_fields_ready {
            // the names of the fields whose types name a type parameter
            for st in self.structs { for f in st.fields { if contains_type_param(f.ty) { self.tp_fields[f.name] = true } } }
            self.tp_fields_ready = true
        }
        if !self.tp_fields.contains(field) { return Ok(0) }
        let args = match recv_type {
            Type.TStruct(n, a) => a,
            Type.TActor(n, a) => a,
            _ => [],
        }
        let si = self.struct_idx(nm)
        if si < 0 { return Ok(0) }
        for f in self.structs[si].fields {
            if f.name == field && contains_type_param(f.ty) {
                match field_type_get(self.struct_field_types(nm, args), field) {
                    Some(ft) => {
                        if is_tfunc_type(ft) {
                            let place = place_text(target)
                            return Err(terr_at(e.line, e.col, e.sp, format("'{}' is a method of '{}' and its field '{}' holds a function here: bind the field first: let g = {}.{}", field, type_name(recv_type), field, place, field)))
                        }
                    },
                    None => {},
                }
            }
        }
        return Ok(0)
    }

    // `x.m(args)` on a value of the type parameter `pn`: the method `m` of a
    // trait among its bounds, with `Self` the parameter (MYLA-291). The
    // backends call the concrete type's method, as they do for an operator
    // on a bounded parameter; the bound was checked where the function was
    // called.
    fun bound_method_call(var self, e: Expr, target: Expr, pn: str, field: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        let me = Type.TParam(pn)
        var bound_traits: [str] = []
        for b in self.bounds_cur {
            if b.tp != pn { continue }
            var bj = 0
            while bj < b.traits.len() {
                let tr = b.traits[bj]
                // a generic trait's methods with its arguments, `I: Iterator<T>` (D171)
                let targs = b.args[bj]
                bj += 1
                bound_traits.push(tr)
                let ti = self.trait_idx(tr)
                // an operator trait's (`Add`, `Ord`, ...) are its operators
                if ti < 0 || self.traits[ti].builtin || self.traits[ti].type_params.len() != targs.len() { continue }
                var pmap: [Subst] = []
                var k = 0
                while k < targs.len() {
                    pmap.push(Subst { name: self.traits[ti].type_params[k], ty: targs[k] })
                    k += 1
                }
                for m in self.traits[ti].methods {
                    if m.name != field { continue }
                    if m.receiver == "" { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is a function of trait '{}' without 'self': call it on the type, '{}.{}(…)', not on a value", field, tr, pn, field))) }
                    if m.receiver == "var self" {
                        if !is_lvalue_shape(target) { return Err(terr_at(e.line, e.col, e.sp, format("method '{}' mutates its receiver ('var self'); it needs a mutable variable (or one of its fields/elements), not a temporary", field))) }
                        let lv = self.check_lvalue(target)?
                        if !lv.mutable { return Err(with_notes(terr_at(e.line, e.col, e.sp, format("cannot call the mutating method '{}' on an immutable receiver (declare it with 'var')", field)), self.declared_at(target))) }
                    }
                    if args.len() != m.params.len() - 1 { return Err(terr_at(e.line, e.col, e.sp, format("method '{}' expects {} argument(s), got {}", field, m.params.len() - 1, args.len()))) }
                    var i = 0
                    while i < args.len() {
                        let pt = subst_self(m.params[i + 1], me, pmap)
                        let at = self.expect_value(args[i], Some(pt))?
                        if !type_eq(at, pt) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", field, type_name(pt), type_name(at)))) }
                        i += 1
                    }
                    self.mark_call(e, "method", "", m.receiver == "var self", "", false)
                    return Ok(match m.ret { Some(rt) => Some(subst_self(rt, me, pmap)), None => None })
                }
            }
        }
        if bound_traits.len() == 0 { return Err(terr_at(e.line, e.col, e.sp, format("type parameter '{}' has no method '{}': it has no bounds (write '{}: Trait' to call a trait's methods)", pn, field, pn))) }
        return Err(terr_at(e.line, e.col, e.sp, format("type parameter '{}' has no method '{}': none of its bounds ({}) declares one (an operator trait gives its operators)", pn, field, quoted_list(bound_traits))))
    }

    // The type `target` names when it is the type of a call `target.f(…)`
    // (D172): a type parameter in scope, a struct or enum (a generic one
    // without its arguments, which the call solves), a built-in type or an
    // alias; None for a variable, which a local of the name is.
    #test(checker_on("[int]"), expr_of("int"))[Ok(Some(Type.TInt(32, true)))]
    #test(checker_on("[int]"), expr_of("char"))[Ok(Some(Type.TChar))]
    #test(checker_on("struct Box<T> { v: T }"), expr_of("Box"))[Ok(Some(Type.TStruct("Box", [])))]
    #test(checker_on("[int]"), expr_of("x"))[Ok(None)]
    #test(checker_on("[int]"), expr_of("a.b"))[Ok(None)]
    fun static_target(var self, target: Expr) -> Result<Option<Type>, CheckErr> {
        let n = match target.kind { ExprKind.Name(x) => x, _ => "" }
        if n == "" { return Ok(None) }
        match self.lookup(n) { Some(b) => { return Ok(None) }, None => {} }
        if contains_str(self.type_params, n) { return Ok(Some(Type.TParam(n))) }
        if self.is_struct(n) {
            if self.is_actor(n) { return Ok(Some(Type.TActor(n, []))) }
            return Ok(Some(Type.TStruct(n, [])))
        }
        if self.is_enum(n) { return Ok(Some(Type.TEnum(n, []))) }
        let builtin = match prim_type(n) { Some(t) => true, None => n == "int" || n == "float" }
        if builtin || self.alias_idx(n) >= 0 { return Ok(Some(self.resolve_ref(n, [], target.line, target.col, target.sp, [])?)) }
        return Ok(None)
    }

    // `P.f(args)` on the type `st` (D172): its function `f` without `self`,
    // a generic impl's type parameters solved as a generic function's are,
    // from the arguments and the expected type; on a type parameter,
    // `bound_static_call`. The backends call the function of the type the
    // call is made for, by `static_calls`.
    #test(checker_on("trait Z { fun zero() -> Self }\nimpl Z for int { fun zero() -> int { return 0 } }"), expr_of("int.zero()"), Type.TInt(32, true), "zero", [], None)[Ok(Some(Type.TInt(32, true)))]
    #test(checker_on("[int]"), expr_of("int.zero()"), Type.TInt(32, true), "zero", [], None)[Err(CheckErr { line: 1, col: 9, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 11 }, msg: "type 'int32' has no function 'zero'", decl: -1, notes: [] })]
    fun infer_static_call(var self, e: Expr, st: Type, field: str, args: [Expr], expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        match st { Type.TParam(pn) => { return self.bound_static_call(e, pn, field, args) }, _ => {} }
        let tn = type_name(st)
        let key = match self.type_key(st) { Some(k) => k, None => "" }
        let sig = match self.method_sig(key, field) {
            Some(x) => x,
            None => {
                if self.lost_methods.contains(field) { return Err(poisoned()) }   // maybe a left-out impl's (MYLA-110)
                return Err(with_notes(terr_at(e.line, e.col, e.sp, format("type '{}' has no function '{}'", tn, field)), self.static_hint(field, tn, self.impl_head(st, tn))))
            },
        }
        self.called[sig.name] = true
        match sig.decl.receiver {
            Some(r) => { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is a method of '{}' (it takes '{}'): call it on a value, 'x.{}(…)'", field, tn, r, field))) },
            None => {},
        }
        self.static_calls[e.id] = st
        let what = format("{}.{}", tn, field)
        if sig.type_params.len() > 0 { return self.infer_generic_call(e, what, sig, args, expected) }
        self.call_arity(e, sig, 0, args.len(), format("function '{}'", what))?
        if call_targs(e).len() > 0 { return Err(not_generic(e, format("function '{}'", what))) }
        var i = 0
        while i < args.len() {
            let pt = sig.params[i]
            if !has_error(pt) {   // else the parameter's type failed (MYLA-110)
                let at = self.expect_value(args[i], Some(pt))?
                if !type_eq(at, pt) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", what, type_name(pt), type_name(at)))) }
            }
            i = i + 1
        }
        return Ok(sig.ret)
    }

    // `T.f(args)` on the type parameter `pn` (D172): the function `f`
    // without `self` of a trait among its bounds, with `Self` the parameter.
    #test(checker_on("[int]"), expr_of("T.zero()"), "T", "zero", [])[Err(CheckErr { line: 1, col: 7, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 9 }, msg: "type parameter 'T' has no function 'zero': it has no bounds (write 'T: Trait' to call a trait's functions)", decl: -1, notes: [] })]
    fun bound_static_call(var self, e: Expr, pn: str, field: str, args: [Expr]) -> Result<Option<Type>, CheckErr> {
        let me = Type.TParam(pn)
        var bound_traits: [str] = []
        for b in self.bounds_cur {
            if b.tp != pn { continue }
            var bj = 0
            while bj < b.traits.len() {
                let tr = b.traits[bj]
                let targs = b.args[bj]
                bj += 1
                bound_traits.push(tr)
                let ti = self.trait_idx(tr)
                if ti < 0 || self.traits[ti].builtin || self.traits[ti].type_params.len() != targs.len() { continue }
                var pmap: [Subst] = []
                var k = 0
                while k < targs.len() {
                    pmap.push(Subst { name: self.traits[ti].type_params[k], ty: targs[k] })
                    k += 1
                }
                for m in self.traits[ti].methods {
                    if m.name != field { continue }
                    if m.receiver != "" { return Err(terr_at(e.line, e.col, e.sp, format("'{}' is a method of trait '{}' (it takes '{}'): call it on a value of type '{}', 'x.{}(…)'", field, tr, m.receiver, pn, field))) }
                    if args.len() != m.params.len() { return Err(terr_at(e.line, e.col, e.sp, format("function '{}.{}' expects {} argument(s), got {}", pn, field, m.params.len(), args.len()))) }
                    if call_targs(e).len() > 0 { return Err(not_generic(e, format("function '{}.{}'", pn, field))) }
                    var i = 0
                    while i < args.len() {
                        let pt = subst_self(m.params[i], me, pmap)
                        let at = self.expect_value(args[i], Some(pt))?
                        if !type_eq(at, pt) { return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch in call to '{}.{}': expected '{}', found '{}'", pn, field, type_name(pt), type_name(at)))) }
                        i += 1
                    }
                    self.static_calls[e.id] = me
                    self.on_type_params = true
                    return Ok(match m.ret { Some(rt) => Some(subst_self(rt, me, pmap)), None => None })
                }
            }
        }
        if bound_traits.len() == 0 { return Err(terr_at(e.line, e.col, e.sp, format("type parameter '{}' has no function '{}': it has no bounds (write '{}: Trait' to call a trait's functions)", pn, field, pn))) }
        return Err(terr_at(e.line, e.col, e.sp, format("type parameter '{}' has no function '{}': none of its bounds ({}) declares one", pn, field, quoted_list(bound_traits))))
    }

    // Notes naming the traits that declare a function `field` without
    // `self`, for a type `tn` that has none (D172).
    #test(checker_on("trait Z { fun zero() -> Self }"), "zero", "str", ("", "str"))[[Note { label: "help", msg: "trait 'Z' declares it: 'impl Z for str' would give 'str' one", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }]]
    #test(checker_on("trait Z { fun zero(self) -> Self }"), "zero", "str", ("", "str"))[[]]
    #test(checker_on("trait Z { fun zero() -> Self }"), "zero", "Box", ("<T>", "Box<T>"))[[Note { label: "help", msg: "trait 'Z' declares it: 'impl<T> Z for Box<T>' would give 'Box' one", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }]]
    fun static_hint(self, field: str, tn: str, head: (str, str)) -> [Note] {
        var out: [Note] = []
        for t in self.traits {
            for m in t.methods {
                // `head`: the impl's type parameters and target
                if m.name == field && m.receiver == "" { out.push(Note { label: "help", msg: format("trait '{}' declares it: 'impl{} {} for {}' would give '{}' one", t.name, head.0, t.name, head.1, tn), line: 0, col: 0, sp: no_span() }) }
            }
        }
        return out
    }

    // The type parameters and the target of an impl for the type `st`
    // written `tn`: a generic type's with its parameters, `<T>` and
    // `Box<T>`, as `impl Z for Box` can't be written (MYLA-384's follow-up).
    #test(checker_on("struct Box<T> { v: T }"), Type.TStruct("Box", []), "Box")[("<T>", "Box<T>")]
    #test(checker_on("[int]"), Type.TStr, "str")[("", "str")]
    fun impl_head(self, st: Type, tn: str) -> (str, str) {
        let name = match st {
            Type.TStruct(n, a) => n,
            Type.TActor(n, a) => n,
            Type.TEnum(n, a) => n,
            _ => "",
        }
        let tps = if name == "" { [] } else { self.type_params_of(name) }
        if tps.len() == 0 { return ("", tn) }
        let ps = join_strs(tps, ", ")
        return (f"<{ps}>", f"{tn}<{ps}>")
    }

    // `infer_generic_call` for a method: its explicit type arguments give
    // its own type parameters, and the receiver solves the impl's first.
    fun infer_generic_method(var self, e: Expr, sig: FuncSig, method: str, recv_type: Type, args: [Expr], expected: Option<Type>) -> Result<Option<Type>, CheckErr> {
        if sig_has_error(sig.params, sig.ret) { return Err(poisoned()) }   // its type arguments can't be inferred (MYLA-110)
        let from_expected = expected_subst(sig.ret, expected)
        var subst = self.explicit_subst(e, sig, format("method '{}'", method))?
        let r0 = unify_param(sig.params[0], recv_type, subst)
        subst = self.solve_bounds(sig.bounds, r0.subst)
        var arg_types: [Type] = []
        var i = 0
        while i < args.len() {
            let pt = sig.params[i + 1]
            let at = self.expect_value(args[i], arg_hint(pt, subst_then(subst, from_expected), is_lambda(args[i])))?
            arg_types.push(at)
            let r = unify_param(pt, at, subst)
            subst = self.solve_bounds(sig.bounds, r.subst)
            i = i + 1
        }
        subst = self.solve_bounds(sig.bounds, subst_then(subst, from_expected))
        var missing: [str] = []
        for tp in sig.type_params { if !subst_has(subst, tp) { missing.push(tp) } }
        if missing.len() > 0 {
            match result_clash(sig.ret, expected) {
                Some(c) => { return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {} for method '{}': its result '{}' can't be the '{}' expected here", join_strs(missing, ", "), method, type_name(c.0), type_name(c.1)))) },
                None => {},
            }
            return Err(terr_at(e.line, e.col, e.sp, format("cannot infer type parameter(s) {} for method '{}'; add a type annotation to guide inference", join_strs(missing, ", "), method)))
        }
        var j = 0
        while j < args.len() {
            let pt = sig.params[j + 1]
            let want = subst_type(pt, subst)
            if !type_eq(arg_types[j], want) {
                if is_int(want) && is_flexible_int_lit(args[j]) { self.infer_int_lit(args[j], Some(want))? }
                else { return Err(terr_at(args[j].line, args[j].col, args[j].sp, format("argument type mismatch in call to '{}': expected '{}', found '{}'", method, type_name(want), type_name(arg_types[j])))) }
            }
            j = j + 1
        }
        self.check_call_bounds(sig, subst, e)?
        self.prelude_need_all(subst)
        self.targs_taken = e.id
        self.call_types[e.id] = type_args_in(sig.type_params, subst)
        return Ok(opt_subst_type(sig.ret, subst))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), None)[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun infer_try(var self, e: Expr, operand: Expr, expected: Option<Type>) -> Result<Type, CheckErr> {
        let ot = self.expect_value(operand, try_hint(expected, self.cur_ret))?
        if self.task_init { return Err(terr_at(e.line, e.col, e.sp, "'?' can't stand in an 'async let': its child task has no function to return from")) }
        if opt_has_error(self.cur_ret) { return Err(poisoned()) }   // the return type failed (MYLA-110)
        // `?` returns from the innermost function or lambda (MYLA-72)
        let where = if_str(self.lambda_depth > 0, "lambda", "function")
        if !self.has_cur_ret && self.lambda_depth > 0 {
            return Err(terr_at(e.line, e.col, e.sp, "'?' in a lambda needs the lambda's result type: pass the lambda where a function type is expected, or annotate the variable (e.g. 'let f: (int) -> Option<int> = …')"))
        }
        let ret_is = match self.cur_ret {
            Some(r) => match r {
                Type.TEnum(rn, rargs) => if_str(rn == "Result" && rargs.len() == 2, "Result", if_str(rn == "Option" && rargs.len() == 1, "Option", "")),
                _ => "",
            },
            None => "",
        }
        match ot {
            Type.TEnum(nm, oargs) => {
                if nm == "Result" && oargs.len() == 2 {
                    let err_t = oargs[1]
                    if ret_is != "Result" { return Err(terr_at(e.line, e.col, e.sp, format("'?' on a Result requires the enclosing {} to return a Result", where))) }
                    let ret_err = match self.cur_ret { Some(r) => match r { Type.TEnum(rn, rargs) => rargs[1], _ => err_t }, None => err_t }
                    if !type_eq(ret_err, err_t) {
                        return Err(terr_at(e.line, e.col, e.sp, format("'?' propagates an error of type '{}', but the {} returns 'Result<_, {}>' (there is no error conversion)", type_name(err_t), where, type_name(ret_err))))
                    }
                    return Ok(oargs[0])
                }
                if nm == "Option" && oargs.len() == 1 {
                    if ret_is != "Option" { return Err(terr_at(e.line, e.col, e.sp, format("'?' on an Option requires the enclosing {} to return an Option", where))) }
                    return Ok(oargs[0])
                }
            },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, format("'?' can only be applied to an Option or Result, not '{}'", type_name(ot))))
    }

    fun infer_lambda(var self, e: Expr, params: [Param], ret_ann: Option<TypeExpr>, body: ExprOrBlock, asy: bool, expected: Option<Type>) -> Result<Type, CheckErr> {
        var have_exp = false
        var exp_params: [Type] = []
        var exp_ret: Option<Type> = None
        match func_hint(expected, params.len()) {
            Some(ft) => {
                have_exp = true
                exp_params = func_params_of(ft)
                exp_ret = func_ret_of(ft)
            },
            None => {},
        }
        var ptypes: [Type] = []
        var i = 0
        while i < params.len() {
            match params[i].ty {
                Some(te) => ptypes.push(self.resolve0(te)?),
                None => { if have_exp { ptypes.push(exp_params[i]) } else { return Err(terr_at(params[i].line, params[i].col, params[i].sp, format("cannot infer the type of lambda parameter '{}'; annotate it (e.g. '{}: int')", params[i].name, params[i].name))) } },
            }
            i = i + 1
        }
        self.push_scope()
        var k = 0
        while k < params.len() {
            if !self.define_at(params[k].name, ptypes[k], false, params[k].line, params[k].col, params[k].sp) { self.pop_scope()
            return Err(terr_at(params[k].line, params[k].col, params[k].sp, format("duplicate lambda parameter '{}'", params[k].name))) }
            k = k + 1
        }
        var want_ret: Option<Type> = None
        if have_exp { want_ret = exp_ret }
        // a result with holes (`partial_result`) is only a hint, for an
        // expression body
        var ret_hint: Option<Type> = None
        match want_ret {
            Some(w) => {
                if has_hole(w) {
                    want_ret = None
                    match body { ExprOrBlock.EB_Expr(x) => { ret_hint = Some(w) }, _ => {} }
                }
            },
            None => {},
        }
        // save context
        let saved_ret = self.cur_ret
        let saved_has = self.has_cur_ret
        let saved_active = self.lambda_infer_active
        let saved_infer = self.lambda_infer
        let saved_async = self.in_async
        let saved_task_init = self.task_init
        let saved_guard = self.in_guard
        self.task_init = false
        self.in_guard = false
        self.lambda_depth = self.lambda_depth + 1
        self.lams.push(LamAt { base: self.frames.len() - 1, line: e.line, col: e.col, sp: e.sp, defer_at: self.defer_at })
        // a lambda in a deferred block is a function of its own (D135)
        self.defer_at = -1
        self.in_async = asy
        if asy { self.met_concurrency(e.line, e.col, e.sp, e.id) }
        var ret_t: Option<Type> = None
        match body {
            ExprOrBlock.EB_Block(bl) => {
                match want_ret {
                    Some(wr) => {
                        self.cur_ret = Some(wr)
                        self.has_cur_ret = true
                        self.check_block(bl)?
                        if !block_returns(bl) { self.restore_lambda(saved_ret, saved_has, saved_active, saved_infer, saved_async, saved_task_init, saved_guard)
            self.pop_scope()
            return Err(terr_at(e.line, e.col, e.sp, format("lambda may finish without returning a '{}'", type_name(wr)))) }
                        ret_t = Some(wr)
                    },
                    None => {
                        self.lambda_infer_active = true
                        self.lambda_infer = []
                        self.cur_ret = None
                        self.has_cur_ret = false
                        self.check_block(bl)?
                        let collected = self.lambda_infer
                        if collected.len() == 0 { ret_t = None }
                        else {
                            ret_t = Some(collected[0].ty)
                            var m = 1
                            while m < collected.len() {
                                if !type_eq(collected[m].ty, collected[0].ty) {
                                    self.restore_lambda(saved_ret, saved_has, saved_active, saved_infer, saved_async, saved_task_init, saved_guard)
                                    self.pop_scope()
                                    let ln = match collected[m].node { Some(nd) => nd.line, None => e.line }
                                    let cl = match collected[m].node { Some(nd) => nd.col, None => e.col }
                                    let sp = match collected[m].node { Some(nd) => nd.sp, None => e.sp }
                                    return Err(terr_at(ln, cl, sp, format("inconsistent lambda return types: '{}' vs '{}'", type_name(collected[0].ty), type_name(collected[m].ty))))
                                }
                                m = m + 1
                            }
                        }
                    },
                }
            },
            ExprOrBlock.EB_Expr(ex) => {
                // a `?` in the body returns from the lambda (MYLA-72)
                self.cur_ret = want_ret
                self.has_cur_ret = match want_ret { Some(w) => true, None => false }
                match ret_hint {
                    Some(h) => {
                        ret_t = self.infer(ex, Some(h))?
                        match ret_t {
                            Some(t) => {
                                if has_hole(t) {
                                    self.restore_lambda(saved_ret, saved_has, saved_active, saved_infer, saved_async, saved_task_init, saved_guard)
                                    self.pop_scope()
                                    return Err(terr_at(ex.line, ex.col, ex.sp, format("cannot infer the type '{}' of this lambda's result; add a type annotation to guide inference", open_type_name(t))))
                                }
                            },
                            None => {},
                        }
                    },
                    None => { ret_t = self.infer(ex, want_ret)? },
                }
            },
        }
        self.restore_lambda(saved_ret, saved_has, saved_active, saved_infer, saved_async, saved_task_init, saved_guard)
        self.pop_scope()
        return Ok(func_type(ptypes, ret_t, asy))
    }

    fun restore_lambda(var self, r: Option<Type>, h: bool, a: bool, inf: [MatchVal], asy: bool, ti: bool, ig: bool) {
        self.lambda_depth = self.lambda_depth - 1
        self.defer_at = self.lams[self.lams.len() - 1].defer_at
        self.lams.pop()
        self.in_async = asy
        self.task_init = ti
        self.in_guard = ig
        self.cur_ret = r
        self.has_cur_ret = h
        self.lambda_infer_active = a
        self.lambda_infer = inf
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), [Expr { id: 9, line: 6, col: 17, sp: SrcSpan { sline: 6, scol: 17, eline: 6, ecol: 18 }, kind: ExprKind.Hole }])[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "'_' partial application requires a function, method, or function value", decl: -1, notes: [] })]
    fun infer_partial(var self, e: Expr, callee: Expr, args: [Expr]) -> Result<Type, CheckErr> {
        let pt = self.partial_target(e, callee)?
        if sig_has_error(pt.params, pt.ret) { return Err(poisoned()) }
        let param_types = pt.params
        if args.len() != param_types.len() {
            return Err(terr_at(e.line, e.col, e.sp, format("partial application must list every argument position ({} expected, found {}); write '_' for each one to leave open (no implicit currying)", param_types.len(), args.len())))
        }
        var hole_types: [Type] = []
        var i = 0
        while i < args.len() {
            match args[i].kind {
                ExprKind.Hole => hole_types.push(param_types[i]),
                _ => {
                    let at = self.expect_value(args[i], Some(param_types[i]))?
                    if !type_eq(at, param_types[i]) {
                        // as the call in Python's synthesized lambda reports it
                        var call_to = ""
                        if pt.name != "" { call_to = format(" in call to '{}'", pt.name) }
                        return Err(terr_at(args[i].line, args[i].col, args[i].sp, format("argument type mismatch{}: expected '{}', found '{}'", call_to, type_name(param_types[i]), type_name(at))))
                    }
                },
            }
            i = i + 1
        }
        return Ok(Type.TFunc(hole_types, pt.ret))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"))[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "'_' partial application requires a function, method, or function value", decl: -1, notes: [] })]
    fun partial_target(var self, e: Expr, callee: Expr) -> Result<PartialTgt, CheckErr> {
        match callee.kind {
            ExprKind.Name(nm) => { return self.partial_name(e, nm) },
            ExprKind.GetField(target, field) => { return self.partial_field(e, callee, target, field) },
            _ => {},
        }
        return Err(terr_at(e.line, e.col, e.sp, "'_' partial application requires a function, method, or function value"))
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), "add")[Err(CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "cannot partially apply 'add' with '_' (only functions, methods, and function values are supported)", decl: -1, notes: [] })]
    fun partial_name(var self, e: Expr, nm: str) -> Result<PartialTgt, CheckErr> {
        match self.lookup(nm) {
            Some(b) => { return func_to_partial_res(b.ty, e) },
            None => {},
        }
        let fi = self.func_idx(nm)
        if fi < 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply '{}' with '_' (only functions, methods, and function values are supported)", nm))) }
        self.called[nm] = true
        let sig = self.functions[fi]
        if sig.type_params.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply the generic function '{}'", nm))) }
        if sig.decl.is_async { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be partially applied")) }
        return Ok(PartialTgt { params: sig.params, ret: sig.ret, name: nm })
    }

    #test(checker_on("enum E { A, B(int) }"), expr_of("a.b[0]"), expr_of("a.b[0]"), expr_of("a.b[0]"), "a")[Err(CheckErr { line: 1, col: 1, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 2 }, msg: "unknown name 'a'", decl: -1, notes: [] })]
    fun partial_field(var self, e: Expr, callee: Expr, target: Expr, field: str) -> Result<PartialTgt, CheckErr> {
        let recv = self.expect_value(target, None)?
        match self.method_partial(recv, field, e)? {
            Some(pt) => {
                match self.type_key(recv) { Some(k) => { self.called[format("{}.{}", k, field)] = true }, None => {} }
                return Ok(pt)
            },
            None => {},
        }
        match struct_view(recv) {
            Type.TStruct(nm, sargs) => {
                let fields = self.struct_field_types(nm, sargs)
                if match field_type_get(fields, field) { Some(x) => true, None => false } { self.check_isolation(nm, target, field, callee)? }
                let ft = match field_type_get(fields, field) { Some(x) => x, None => Type.TBool }
                let is_fn = is_tfunc_type(ft)
                if is_fn { return func_to_partial_res(ft, e) }
                if has_error(ft) { return Err(poisoned()) }   // the field's type failed (MYLA-110)
            },
            _ => {},
        }
        if self.lost_methods.contains(field) { return Err(poisoned()) }   // maybe a left-out impl's (MYLA-110)
        return Err(with_notes(terr_at(e.line, e.col, e.sp, format("type '{}' has no method '{}'", type_name(recv), field)), did_you_mean(field, self.method_names(self.type_key(recv)))))
    }

    #test(checker_on("enum E { A, B(int) }"), Type.TBool, "a", expr_of("a.b[0]"))[Ok(None)]
    fun method_partial(self, recv: Type, field: str, e: Expr) -> Result<Option<PartialTgt>, CheckErr> {
        match self.type_key(recv) {
            Some(k) => {
                match self.method_sig(k, field) {
                    Some(sig) => {
                        if sig.type_params.len() > 0 { return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply the generic method '{}'", field))) }
                        if sig.decl.is_async || self.is_actor(k) { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be partially applied")) }
                        var rest: [Type] = []
                        var i = 1
                        while i < sig.params.len() {
                            rest.push(sig.params[i])
                            i = i + 1
                        }
                        return Ok(Some(PartialTgt { params: rest, ret: sig.ret, name: field }))
                    },
                    None => {},
                }
                return Ok(None)
            },
            None => {},
        }
        return Ok(None)
    }
}

#test(Type.TFunc([Type.TInt(32, true)], Some(Type.TInt(32, true))), expr_of("-n * 2"))[Ok(PartialTgt { params: [Type.TInt(32, true)], ret: Some(Type.TInt(32, true)), name: "" })]
fun func_to_partial_res(t: Type, e: Expr) -> Result<PartialTgt, CheckErr> {
    match t {
        Type.TFunc(p, r) => { return Ok(PartialTgt { params: p, ret: r, name: "" }) },
        Type.TAsync(f) => { return Err(terr_at(e.line, e.col, e.sp, "an async function can't be partially applied")) },
        _ => {},
    }
    return Err(terr_at(e.line, e.col, e.sp, format("cannot partially apply a value of type '{}'", type_name(t))))
}

// The struct an actor's type is declared like, for its fields; any other type
// as it is.
#test(Type.TStruct("C", []))[Type.TStruct("C", [])]
#test(Type.TActor("Account", []))[Type.TStruct("Account", [])]
#test(Type.TActor("Cell", [Type.TStr]))[Type.TStruct("Cell", [Type.TStr])]
#test(Type.TStruct("Pair", [Type.TInt(32, true), Type.TBool]))[Type.TStruct("Pair", [Type.TInt(32, true), Type.TBool])]
fun struct_view(t: Type) -> Type {
    return match t { Type.TActor(n, a) => Type.TStruct(n, a), _ => t }
}

// Whether `t` is an async function type (D89).
#test(Type.TFunc([Type.TStr], Some(Type.TStr)))[false]
#test(Type.TAsync(Type.TFunc([], Some(Type.TParam("T")))))[true]
#test(Type.TFunc([Type.TInt(32, true)], Some(Type.TStr)))[false]
fun is_async_func(t: Type) -> bool {
    return match t { Type.TAsync(f) => true, _ => false }
}

// The function type `t` is, without its asyncness.
#test(Type.TInt(32, true))[Type.TInt(32, true)]
#test(Type.TFunc([Type.TInt(32, true)], Some(Type.TStr)))[Type.TFunc([Type.TInt(32, true)], Some(Type.TStr))]
#test(Type.TFunc([Type.TStruct("Point", [])], Some(Type.TInt(32, true))))[Type.TFunc([Type.TStruct("Point", [])], Some(Type.TInt(32, true)))]
fun strip_async(t: Type) -> Type {
    return match t { Type.TAsync(f) => f, _ => t }
}

// The function type with parameters `ps` and result `r`, async if `asy`.
#test([Type.TStr], Some(Type.TStr), false)[Type.TFunc([Type.TStr], Some(Type.TStr))]
#test([Type.TParam("T")], Some(Type.TParam("T")), false)[Type.TFunc([Type.TParam("T")], Some(Type.TParam("T")))]
#test([Type.TInt(32, true), Type.TInt(32, true)], Some(Type.TInt(32, true)), false)[Type.TFunc([Type.TInt(32, true), Type.TInt(32, true)], Some(Type.TInt(32, true)))]
fun func_type(ps: [Type], r0: Option<Type>, asy: bool) -> Type {
    // a result of `()` is no result (D140)
    let r: Option<Type> = match r0 { Some(t) => result_of(t), None => None }
    if asy { return Type.TAsync(Type.TFunc(ps, r)) }
    return Type.TFunc(ps, r)
}

// A partially applied callee: its parameter and return types, and the name a
// call to it reports ("" for a function value).
pub struct PartialTgt { params: [Type], ret: Option<Type>, name: str }



// The index `m` maps `name` to, or -1.
#test([:], "A")[-1]
#test(["get": 0, "fläche": 1, "crlf_len": 2, "accent": 3, "bytes_of": 4, "main": 5], "main")[5]
#test(["get": 0, "total": 1, "count": 2, "nth": 3, "doubled": 4, "last": 5, "set_first": 6, "copy_is_independent": 7, "grid_get": 8, "bump_cell": 9, "ysum": 10, "main": 11], "main")[11]
fun index_in(m: [str: int32], name: str) -> int32 {
    return match m.get(name) {
        Some(i) => i
        None => -1
    }
}

// -- reentrancy warnings (D95, MYLA-146; types.py: _Reentrancy) ------------

// What a local was read from: fields of `self`, and the epoch of the read.
struct Taint { fields: [str], epoch: int32 }

// What an expression reads: fields of `self`, the locals with a taint (in the
// order they appear), and its first `await`.
// `examines`: the fields each synchronous method of the actor examines
// (MYLA-171), which a call of it on `self` reads.
struct Reads { fields: [str], names: [str], awaits: [Expr], examines: [str: [str]] }

#test([], "balance")[["balance"]]
fun add_name(xs: [str], n: str) -> [str] {
    for x in xs { if x == n { return xs } }
    var out = xs
    out.push(n)
    return out
}

#test([], "y")[false]
#test(["x"], "a")[false]
#test(["d"], "d2")[false]
fun has_name(xs: [str], n: str) -> bool {
    for x in xs { if x == n { return true } }
    return false
}

// The field of `self` a place starts from (`stock` of `self.stock[0].n`), or "".
#test(expr_of("-n * 2"))[""]
fun self_field(e: Expr) -> str {
    match e.kind {
        ExprKind.GetField(t, f) => {
            match t.kind {
                ExprKind.Name(n) => {
                    if n == "self" { return f }
                    return ""
                },
                _ => { return self_field(t) },
            }
        },
        ExprKind.Index(t, i) => { return self_field(t) },
        _ => {},
    }
    return ""
}

// The method of `self` a call's callee names (`take` of `self.take`), or "".
#test(expr_of("self.take"))["take"]
#test(expr_of("other.take"))[""]
#test(expr_of("take"))[""]
fun self_method(c: Expr) -> str {
    match c.kind {
        ExprKind.GetField(t, m) => {
            match t.kind {
                ExprKind.Name(n) => { if n == "self" { return m } },
                _ => {},
            }
        },
        _ => {},
    }
    return ""
}

// The calls of methods of `self` and of its fields (`self.items.pop()`,
// MYLA-394) in `e`, innermost first, outside lambdas and the block arms of a
// `match` (statements of their own, MYLA-171).
#test(expr_of("f(1) + other.g(2)"))[[]]
#test(expr_of("() => self.a()"))[[]]
fun self_calls(e: Expr) -> [Expr] {
    var out: [Expr] = []
    var subs: [Expr] = []
    match e.kind {
        ExprKind.Lambda(ps, rt, body, asy) => { return [] },
        ExprKind.Call(c, args, _) => {
            subs.push(c)
            for a in args { subs.push(a) }
        },
        ExprKind.GetField(t, f) => { subs.push(t) },
        ExprKind.Await(x) => { subs.push(x) },
        ExprKind.Unary(op, x) => { subs.push(x) },
        ExprKind.Binary(op, l, r) => {
            subs.push(l)
            subs.push(r)
        },
        ExprKind.StructLit(n, fs) => { for fi in fs { subs.push(fi.value) } },
        ExprKind.TupleLit(es) => { for x in es { subs.push(x) } },
        ExprKind.ListLit(es) => { for x in es { subs.push(x) } },
        ExprKind.MapLit(ents) => {
            for en in ents {
                subs.push(en.key)
                subs.push(en.value)
            }
        },
        ExprKind.TupleIndex(t, i) => { subs.push(t) },
        ExprKind.Index(t, i) => {
            subs.push(t)
            subs.push(i)
        },
        ExprKind.MatchE(sc, arms) => {
            subs.push(sc)
            for arm in arms {
                match arm.guard { Some(g) => { subs.push(g) }, None => {} }
                match arm.body { ExprOrBlock.EB_Expr(x) => { subs.push(x) }, ExprOrBlock.EB_Block(b) => {} }
            }
        },
        ExprKind.Try(x) => { subs.push(x) },
        ExprKind.Cast(x, ty) => { subs.push(x) },
        _ => {},
    }
    for x in subs { for c in self_calls(x) { out.push(c) } }
    match e.kind {
        ExprKind.Call(c, args, _) => {
            let on_field = match c.kind { ExprKind.GetField(recv, m) => self_field(recv) != "", _ => false }
            if self_method(c) != "" || on_field { out.push(e) }
        },
        _ => {},
    }
    return out
}

// What the body of a synchronous method of an actor does to the actor's
// fields itself (MYLA-171): the fields it changes (assigned, or changed by
// `push`, `pop`, `remove` or `append` or a `var self` method, the calls of
// one in `mutators`), those it examines, and the methods of `self` it calls,
// each in the order first met.
struct Effects { changes: [str], examines: [str], calls: [str], mutators: [int32: bool] }

impl Effects {
    fun block(var self, b: Block) {
        for s in b.stmts { self.stmt(s) }
    }

    fun opt(var self, e: Option<Expr>) {
        match e { Some(x) => { self.expr(x) }, None => {} }
    }

    fun stmt(var self, s: Stmt) {
        match s.kind {
            StmtKind.VarDecl(k, n, ty, init) => { self.expr(init) },
            StmtKind.DestructDecl(k, b, ty, init) => { self.expr(init) },
            StmtKind.Assign(t, v) => {
                let f = self_field(t)
                if f != "" { self.changes = add_name(self.changes, f) }
                self.expr(t)
                self.expr(v)
            },
            StmtKind.IfS(c, th, el) => {
                self.expr(c)
                self.block(th)
                match el {
                    Some(ElseTail.ElseBlock(b)) => { self.block(b) },
                    Some(ElseTail.ElseIf(x)) => { self.stmt(x) },
                    None => {},
                }
            },
            StmtKind.WhileS(c, b) => {
                self.expr(c)
                self.block(b)
            },
            StmtKind.ForS(v, st, en, body, it) => {
                self.opt(st)
                self.opt(en)
                self.opt(it)
                self.block(body)
            },
            StmtKind.ReturnS(v, t) => { self.opt(v) },
            StmtKind.ExprStmt(x) => { self.expr(x) },
            StmtKind.DeferS(b) => { self.block(b) },
            _ => {},
        }
    }

    fun expr(var self, e: Expr) {
        match e.kind {
            ExprKind.Lambda(ps, rt, body, asy) => { return },
            ExprKind.GetField(t, f) => {
                match t.kind {
                    ExprKind.Name(n) => {
                        if n == "self" {
                            self.examines = add_name(self.examines, f)
                            return
                        }
                    },
                    _ => {},
                }
                self.expr(t)
            },
            ExprKind.Call(c, args, _) => {
                let m = self_method(c)
                if m != "" { self.calls = add_name(self.calls, m) } else { self.expr(c) }
                match c.kind {
                    ExprKind.GetField(recv, bm) => {
                        let root = self_field(recv)
                        if root != "" && (mutating_builtin(bm) || self.mutators.contains(e.id)) { self.changes = add_name(self.changes, root) }
                    },
                    _ => {},
                }
                match c.kind {
                    ExprKind.Name(f) => {
                        if (f == "push" || f == "pop" || f == "remove" || f == "append") && args.len() > 0 {
                            let root = self_field(args[0])
                            if root != "" { self.changes = add_name(self.changes, root) }
                        }
                    },
                    _ => {},
                }
                for a in args { self.expr(a) }
            },
            ExprKind.Await(x) => { self.expr(x) },
            ExprKind.Unary(op, x) => { self.expr(x) },
            ExprKind.Binary(op, l, r) => {
                self.expr(l)
                self.expr(r)
            },
            ExprKind.StructLit(n, fs) => { for fi in fs { self.expr(fi.value) } },
            ExprKind.TupleLit(es) => { for x in es { self.expr(x) } },
            ExprKind.ListLit(es) => { for x in es { self.expr(x) } },
            ExprKind.MapLit(ents) => {
                for en in ents {
                    self.expr(en.key)
                    self.expr(en.value)
                }
            },
            ExprKind.TupleIndex(t, i) => { self.expr(t) },
            ExprKind.Index(t, i) => {
                self.expr(t)
                self.expr(i)
            },
            ExprKind.MatchE(sc, arms) => {
                self.expr(sc)
                for arm in arms {
                    match arm.guard { Some(g) => { self.expr(g) }, None => {} }
                    match arm.body {
                        ExprOrBlock.EB_Expr(x) => { self.expr(x) },
                        ExprOrBlock.EB_Block(b) => { self.block(b) },
                    }
                }
            },
            ExprKind.Try(x) => { self.expr(x) },
            ExprKind.Cast(x, ty) => { self.expr(x) },
            _ => {},
        }
    }
}

// `ws` in the order of their places (line, then column), stable.
#test([])[[]]
fun sort_by_place(ws: [CheckErr]) -> [CheckErr] {
    var out: [CheckErr] = []
    for w in ws {
        var i = out.len()
        out.push(w)
        while i > 0 && (out[i - 1].line > w.line || (out[i - 1].line == w.line && out[i - 1].col > w.col)) {
            out[i] = out[i - 1]
            i = i - 1
        }
        out[i] = w
    }
    return out
}

impl Reads {
    fun expr(var self, e: Expr, locals: [str: Taint]) {
        match e.kind {
            ExprKind.Lambda(ps, rt, body, asy) => { return },
            ExprKind.GetField(t, f) => {
                match t.kind {
                    ExprKind.Name(n) => {
                        if n == "self" {
                            self.fields = add_name(self.fields, f)
                            return
                        }
                    },
                    _ => {},
                }
                self.expr(t, locals)
            },
            ExprKind.Name(n) => { if locals.contains(n) { self.names = add_name(self.names, n) } },
            ExprKind.Await(x) => {
                if self.awaits.len() == 0 { self.awaits.push(e) }
                self.expr(x, locals)
            },
            ExprKind.Unary(op, x) => { self.expr(x, locals) },
            ExprKind.Binary(op, l, r) => {
                self.expr(l, locals)
                self.expr(r, locals)
            },
            ExprKind.Call(c, args, _) => {
                // `self.m(…)`: the fields `m` examines (MYLA-171)
                let m = self_method(c)
                if m != "" {
                    match self.examines.get(m) {
                        Some(fs) => { for f in fs { self.fields = add_name(self.fields, f) } },
                        None => {},
                    }
                } else {
                    self.expr(c, locals)
                }
                for a in args { self.expr(a, locals) }
            },
            ExprKind.StructLit(n, fs) => { for fi in fs { self.expr(fi.value, locals) } },
            ExprKind.TupleLit(es) => { for x in es { self.expr(x, locals) } },
            ExprKind.ListLit(es) => { for x in es { self.expr(x, locals) } },
            ExprKind.MapLit(ents) => {
                for en in ents {
                    self.expr(en.key, locals)
                    self.expr(en.value, locals)
                }
            },
            ExprKind.TupleIndex(t, i) => { self.expr(t, locals) },
            ExprKind.Index(t, i) => {
                self.expr(t, locals)
                self.expr(i, locals)
            },
            ExprKind.MatchE(sc, arms) => {
                self.expr(sc, locals)
                for arm in arms {
                    match arm.guard { Some(g) => { self.expr(g, locals) }, None => {} }
                    match arm.body {
                        ExprOrBlock.EB_Expr(x) => { self.expr(x, locals) },
                        ExprOrBlock.EB_Block(b) => { self.block(b, locals) },
                    }
                }
            },
            ExprKind.Try(x) => { self.expr(x, locals) },
            ExprKind.Cast(x, ty) => { self.expr(x, locals) },
            _ => {},
        }
    }

    fun opt(var self, e: Option<Expr>, locals: [str: Taint]) {
        match e { Some(x) => { self.expr(x, locals) }, None => {} }
    }

    fun block(var self, b: Block, locals: [str: Taint]) {
        for s in b.stmts { self.stmt(s, locals) }
    }

    fun stmt(var self, s: Stmt, locals: [str: Taint]) {
        match s.kind {
            StmtKind.VarDecl(k, n, ty, init) => { self.expr(init, locals) },
            StmtKind.DestructDecl(k, b, ty, init) => { self.expr(init, locals) },
            StmtKind.Assign(t, v) => {
                self.expr(t, locals)
                self.expr(v, locals)
            },
            StmtKind.IfS(c, th, el) => {
                self.expr(c, locals)
                self.block(th, locals)
                match el {
                    Some(ElseTail.ElseBlock(b)) => { self.block(b, locals) },
                    Some(ElseTail.ElseIf(x)) => { self.stmt(x, locals) },
                    None => {},
                }
            },
            StmtKind.WhileS(c, b) => {
                self.expr(c, locals)
                self.block(b, locals)
            },
            StmtKind.ForS(v, st, en, body, it) => {
                self.opt(st, locals)
                self.opt(en, locals)
                self.block(body, locals)
                self.opt(it, locals)
            },
            StmtKind.ReturnS(v, t) => { self.opt(v, locals) },
            StmtKind.ExprStmt(x) => { self.expr(x, locals) },
            StmtKind.DeferS(b) => { self.block(b, locals) },
            _ => {},
        }
    }
}

// Whether the builtin method `m` changes its receiver (`push`, `pop`,
// `remove`, `append`, `append_byte`, `append_char`).
#test("push")[true]
#test("len")[false]
#test("append_char")[true]
pub fun mutating_builtin(m: str) -> bool {
    return m == "push" || m == "pop" || m == "remove" || m == "append" || m == "append_byte" || m == "append_char"
}

// A builtin that is a method called as a function (`push(xs, v)`): its
// function form went (D103, MYLA-221); the error names the method.
fun function_form(at: Expr, name: str) -> CheckErr {
    var msg = format("'{}' is a method: call it as 'x.{}(…)'", name, name)
    if receiver_only(name) { msg = format("'{}' is a method: call it as 'x.{}()'", name, name) }
    return with_notes(terr_at(at.line, at.col, at.sp, msg), [Note { label: "help", msg: "`scripts/to_methods.py FILE` rewrites a file's calls", line: 0, col: 0, sp: no_span() }])
}

// The error for a builtin method called with other than its `n` arguments
// (the receiver not counted).
#test("pop", 0)["pop() takes no arguments"]
#test("push", 1)["push() takes 1 argument"]
fun method_arity(name: str, n: int32) -> str {
    if n == 0 { return format("{}() takes no arguments", name) }
    if n == 1 { return format("{}() takes 1 argument", name) }
    return format("{}() takes {} arguments", name, n)
}

// Whether the builtin method `m` takes nothing but its receiver.
#test("len")[true]
#test("push")[false]
fun receiver_only(m: str) -> bool {
    return m == "len" || m == "pop" || m == "keys" || m == "chars" || m == "build" || m == "wrapping_neg"
}

// Whether `m` names a builtin function that is also a method (D103,
// MYLA-221).
#test("push")[true]
#test("print")[false]
pub fun builtin_method_name(m: str) -> bool {
    return m == "len" || m == "push" || m == "pop" || m == "contains" || m == "remove" || m == "keys" || m == "chars" || m == "append" || m == "append_byte" || m == "append_char" || m == "build" || is_wrapping_method(m)
}

// Whether the builtin function `m` is a method of a receiver of type `t`:
// `len` of lists, maps, strings and builders, `push` and `pop` of lists,
// `contains`, `remove` and `keys` of maps, `chars` of strings, `append`,
// `append_byte`, `append_char` and `build` of builders (D103, MYLA-221,
// MYLA-390), `wrapping_add`, `wrapping_sub`, `wrapping_mul` and
// `wrapping_neg` of integers (D175).
#test(Type.TList(Type.TStr), "push")[true]
#test(Type.TStr, "push")[false]
#test(Type.TSB, "len")[true]
#test(Type.TInt(8, false), "wrapping_mul")[true]
#test(Type.TChar, "wrapping_add")[false]
pub fun builtin_method(t: Type, m: str) -> bool {
    return match t {
        Type.TInt(w, s) => is_wrapping_method(m),
        Type.TList(el) => m == "len" || m == "push" || m == "pop",
        Type.TMap(k, v) => m == "len" || m == "contains" || m == "remove" || m == "keys",
        Type.TStr => m == "len" || m == "chars",
        Type.TSB => m == "len" || m == "append" || m == "append_byte" || m == "append_char" || m == "build",
        _ => false,
    }
}

// `err`, about a match, in the words of the `if` it came from (D104 (1),
// MYLA-222: the parser makes an `if` used as a value a match whose second
// arm binds `%else`).
#test(CheckErr { line: 1, col: 1, sp: no_span(), msg: "match arms have incompatible types 'a' and 'b'", decl: -1, notes: [] }, [])[CheckErr { line: 1, col: 1, sp: no_span(), msg: "match arms have incompatible types 'a' and 'b'", decl: -1, notes: [] }]
fun if_worded(err: CheckErr, arms: [MatchArm]) -> CheckErr {
    if arms.len() != 2 { return err }
    // `%else`: an `if` used as a value; `%iflet`, `%whilelet`: an `if let`, a
    // `while let` (MYLA-226), whose pattern must be able to fail
    let marker = match arms[1].pattern.kind { PatternKind.PBind(n) => n, _ => "" }
    if marker != "%else" && marker != "%iflet" && marker != "%whilelet" && marker != "%letelse" { return err }
    if err.msg == "unreachable match arm (a previous arm already matches everything)" && marker != "%else" {
        let pat = arms[0].pattern
        var advice = "use 'let' instead"
        var what = "'if let'"
        if marker == "%whilelet" {
            advice = "use 'while true' and 'let'"
            what = "'while let'"
        }
        if marker == "%letelse" {
            advice = "use 'let' instead, or 'match'"
            what = "let-else"
        }
        return CheckErr { line: pat.line, col: pat.col, sp: pat.sp, msg: format("the pattern of this {} always matches: {}", what, advice), decl: err.decl, notes: err.notes }
    }
    var msg = err.msg
    let types = "match arms have incompatible types "
    if msg.len() > types.len() && starts(msg, types) {
        var sb = StringBuilder()
        sb.append(msg, types.len(), msg.len())
        msg = "the branches of an 'if' have incompatible types " + sb.build()
    } else if msg == "this match is used as a value, so every arm must produce one" {
        msg = "this 'if' is used as a value, so every branch must produce one"
    } else if msg == "this match is used as a value, but every arm diverges" {
        msg = "this 'if' is used as a value, but every branch diverges"
    }
    return CheckErr { line: err.line, col: err.col, sp: err.sp, msg: msg, decl: err.decl, notes: err.notes }
}

// Whether `s` begins with `prefix`.
#test("abc", "ab")[true]
#test("abc", "b")[false]
fun starts(s: str, prefix: str) -> bool {
    if prefix.len() > s.len() { return false }
    var i = 0
    while i < prefix.len() {
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    return true
}

// The walk of an actor's async method (types.py: _Reentrancy): `epoch`
// counts the statements with an `await` so far, `checked` the epoch each
// field was last examined in by a condition, `locals` what each local was read
// from, `awaits` the `await` that started each epoch after the first.
// `changes` and `examines`: the fields each synchronous method of the actor
// changes and examines, through the methods it calls (MYLA-171); `mutators`
// the calls of `var self` methods, by node id (MYLA-394).
struct Reentrancy { epoch: int32, checked: [str: int32], locals: [str: Taint], awaits: [Expr], out: [CheckErr], changes: [str: [str]], examines: [str: [str]], mutators: [int32: bool] }

impl Reentrancy {
    #test(Reentrancy { epoch: 0, checked: [:], locals: [:], awaits: [], out: [], changes: [:], examines: [:], mutators: [:] }, expr_of("-n * 2"))[Reads { fields: [], names: [], awaits: [], examines: [:] }]
    fun scan(self, e: Expr) -> Reads {
        var r = Reads { fields: [], names: [], awaits: [], examines: self.examines }
        r.expr(e, self.locals)
        return r
    }

    fun taint(self, r: Reads) -> [str] {
        var out = r.fields
        for n in r.names {
            match self.locals.get(n) {
                Some(t) => { for f in t.fields { out = add_name(out, f) } },
                None => {},
            }
        }
        return out
    }

    // `e` examined as a condition; its awaits.
    #test(Reentrancy { epoch: 0, checked: [:], locals: [:], awaits: [], out: [], changes: [:], examines: [:], mutators: [:] }, expr_of("-n * 2"))[[]]
    fun check(var self, e: Expr) -> [Expr] {
        let r = self.scan(e)
        for n in r.names {
            match self.locals.get(n) {
                Some(t) => {
                    for f in t.fields {
                        var prev = -1
                        match self.checked.get(f) { Some(p) => { prev = p }, None => {} }
                        if t.epoch > prev { self.checked[f] = t.epoch } else { self.checked[f] = prev }
                    }
                },
                None => {},
            }
        }
        for f in r.fields { self.checked[f] = self.epoch }
        return r.awaits
    }

    fun suspend(var self, awaits: [Expr]) {
        if awaits.len() > 0 {
            self.awaits.push(awaits[0])
            self.epoch = self.epoch + 1
        }
    }

    fun block(var self, b: Block) {
        for s in b.stmts { self.stmt(s) }
    }

    // A statement's value: a `match`'s scrutinee and guards are conditions and
    // its block arms statements; its awaits.
    #test(Reentrancy { epoch: 0, checked: ["balance": 0], locals: [:], awaits: [], out: [], changes: [:], examines: [:], mutators: [:] }, Expr { id: 26, line: 22, col: 20, sp: SrcSpan { sline: 22, scol: 20, eline: 22, ecol: 25 }, kind: ExprKind.BoolLit(false) })[[]]
    fun value(var self, e: Expr) -> [Expr] {
        match e.kind {
            ExprKind.MatchE(sc, arms) => {
                // a mutator in the scrutinee or a guard changes its field
                // before the match examines it (MYLA-394)
                self.call_changes(sc)
                var awaits = self.check(sc)
                for arm in arms {
                    match arm.guard {
                        Some(g) => {
                            self.call_changes(g)
                            for a in self.check(g) { awaits.push(a) }
                        },
                        None => {},
                    }
                    match arm.body {
                        ExprOrBlock.EB_Block(b) => { self.block(b) },
                        ExprOrBlock.EB_Expr(x) => { for a in self.scan(x).awaits { awaits.push(a) } },
                    }
                }
                return awaits
            },
            _ => {},
        }
        return self.scan(e).awaits
    }

    // The head `c` of an `if` or a `while`: its calls' changes (a mutator's
    // on a field of `self` a change of the field, MYLA-394) before it is
    // examined, then its awaits.
    fun head(var self, c: Expr) {
        self.call_changes(c)
        let aw = self.check(c)
        self.suspend(aw)
    }

    // The changes of `e`'s calls that `value` hasn't made: all of them but
    // a match's scrutinee's and guards'.
    fun value_changes(var self, e: Expr) {
        match e.kind {
            ExprKind.MatchE(sc, arms) => {
                for arm in arms {
                    match arm.body {
                        ExprOrBlock.EB_Expr(x) => { self.call_changes(x) },
                        ExprOrBlock.EB_Block(b) => {},
                    }
                }
            },
            _ => { self.call_changes(e) },
        }
    }

    fun stmt(var self, s: Stmt) {
        match s.kind {
            StmtKind.VarDecl(k, name, ty, init) => {
                if k == "async" { return }
                let r = self.scan(init)
                let before = self.epoch
                let awaits = self.value(init)
                self.locals[name] = Taint { fields: self.taint(r), epoch: before }
                self.suspend(awaits)
                self.value_changes(init)
            },
            StmtKind.Assign(target, v) => {
                let r = self.scan(v)
                let before = self.epoch
                let awaits = self.value(v)
                self.suspend(awaits)
                self.value_changes(v)
                let root = self_field(target)
                if root != "" {
                    self.write(root, r.names, target)
                } else {
                    match target.kind {
                        ExprKind.Name(n) => { self.locals[n] = Taint { fields: self.taint(r), epoch: before } },
                        _ => {},
                    }
                }
            },
            StmtKind.IfS(c, th, el) => {
                // the head's mutators change their fields before it is
                // examined (MYLA-394); its awaits come after
                self.head(c)
                self.block(th)
                match el {
                    Some(ElseTail.ElseBlock(b)) => { self.block(b) },
                    Some(ElseTail.ElseIf(x)) => { self.stmt(x) },
                    None => {},
                }
            },
            StmtKind.WhileS(c, b) => {
                self.head(c)
                self.block(b)
            },
            StmtKind.ForS(v, st, en, body, it) => {
                var awaits: [Expr] = []
                match st { Some(x) => { for a in self.scan(x).awaits { awaits.push(a) } }, None => {} }
                match en { Some(x) => { for a in self.scan(x).awaits { awaits.push(a) } }, None => {} }
                match it { Some(x) => { for a in self.scan(x).awaits { awaits.push(a) } }, None => {} }
                self.suspend(awaits)
                for x in [st, en, it] { match x { Some(y) => { self.call_changes(y) }, None => {} } }
                self.block(body)
            },
            StmtKind.ReturnS(v, t) => {
                match v {
                    Some(x) => {
                        let aw = self.value(x)
                        self.suspend(aw)
                        self.value_changes(x)
                    },
                    None => {},
                }
            },
            StmtKind.ExprStmt(e) => {
                match e.kind {
                    ExprKind.Call(c, args, _) => {
                        // `self.f.push(x)`: the builtin as a method (D103)
                        match c.kind {
                            ExprKind.GetField(recv, m) => {
                                let root = self_field(recv)
                                if root != "" && (mutating_builtin(m) || self.mutators.contains(e.id)) {
                                    var names: [str] = []
                                    var awaits: [Expr] = []
                                    for a in args {
                                        let r = self.scan(a)
                                        for n in r.names { names = add_name(names, n) }
                                        for aw in r.awaits { awaits.push(aw) }
                                    }
                                    self.suspend(awaits)
                                    // its arguments' own changes first (MYLA-394)
                                    for a in args { self.call_changes(a) }
                                    self.write(root, names, e)
                                    return
                                }
                            },
                            _ => {},
                        }
                        match c.kind {
                            ExprKind.Name(f) => {
                                if (f == "push" || f == "pop" || f == "remove" || f == "append") && args.len() > 0 {
                                    let root = self_field(args[0])
                                    var names: [str] = []
                                    var awaits: [Expr] = []
                                    var i = 1
                                    while i < args.len() {
                                        let r = self.scan(args[i])
                                        for n in r.names { names = add_name(names, n) }
                                        for a in r.awaits { awaits.push(a) }
                                        i = i + 1
                                    }
                                    self.suspend(awaits)
                                    self.call_changes(e)
                                    if root != "" { self.write(root, names, e) }
                                    return
                                }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
                let aw = self.value(e)
                self.suspend(aw)
                self.value_changes(e)
            },
            StmtKind.DestructDecl(k, b, ty, init) => {
                let aw = self.scan(init).awaits
                self.suspend(aw)
                self.call_changes(init)
            },
            // without an `await`, read as where it stands (D135)
            StmtKind.DeferS(b) => { self.block(b) },
            _ => {},
        }
    }

    // The calls of methods of `self` in `e` change what those methods change
    // (MYLA-171), and a mutator on a field of `self` that field, wherever it
    // stands (MYLA-394): each with the locals its arguments read.
    fun call_changes(var self, e: Expr) {
        for c in self_calls(e) {
            match c.kind {
                ExprKind.Call(callee, args, _) => {
                    var fs: [str] = []
                    match self.changes.get(self_method(callee)) {
                        Some(x) => { fs = x },
                        None => {
                            match callee.kind {
                                ExprKind.GetField(recv, m) => {
                                    let root = self_field(recv)
                                    if root != "" && (mutating_builtin(m) || self.mutators.contains(c.id)) { fs = [root] }
                                },
                                _ => {},
                            }
                        },
                    }
                    if fs.len() > 0 {
                        var names: [str] = []
                        for a in args { for n in self.scan(a).names { names = add_name(names, n) } }
                        for f in fs { self.write(f, names, c) }
                    }
                },
                _ => {},
            }
        }
    }

    fun write(var self, f: str, names: [str], at: Expr) {
        // a change settles the field's check: what comes after depends on it
        match self.checked.get(f) {
            Some(c) => {
                self.checked.remove(f)
                if c < self.epoch {
                    self.warn(format("'self.{}' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile", f), at, self.awaits[c], "check it again after the 'await', or change it before")
                    return
                }
            },
            None => {},
        }
        for n in names {
            match self.locals.get(n) {
                Some(t) => {
                    if has_name(t.fields, f) && t.epoch < self.epoch {
                        self.warn(format("'self.{}' is set from a value read before an 'await': another call to this actor may have changed it meanwhile", f), at, self.awaits[t.epoch], "read it again after the 'await'")
                        return
                    }
                },
                None => {},
            }
        }
    }

    fun warn(var self, msg: str, at: Expr, aw: Expr, help: str) {
        self.out.push(CheckErr { line: at.line, col: at.col, sp: at.sp, msg: msg, decl: -1, notes: [note_at("other calls to the actor may run at this 'await'", aw.line, aw.col, aw.sp), Note { label: "help", msg: help, line: 0, col: 0, sp: no_span() }] })
    }
}

// An `async let`'s initializer in an actor's method reads a field of `self`
// or calls one of its synchronous methods: the child task would do it off the
// actor (MYLA-168; types.py: _child_reaches_self).
#test(expr_of("-n * 2"))[CheckErr { line: 1, col: 4, sp: SrcSpan { sline: 1, scol: 1, eline: 1, ecol: 7 }, msg: "an 'async let' can't reach the actor's state through 'self': its child task runs off the actor", decl: -1, notes: [Note { label: "help", msg: "read what the child needs into a 'let' before the 'async let'", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } }] }]
fun child_reaches_self(e: Expr) -> CheckErr {
    return with_notes(terr_at(e.line, e.col, e.sp, "an 'async let' can't reach the actor's state through 'self': its child task runs off the actor"), [Note { label: "help", msg: "read what the child needs into a 'let' before the 'async let'", line: 0, col: 0, sp: no_span() }])
}

// Whether `name` starts with `__`, as the standard library's primitives do.
#test("f")[false]
#test("g")[false]
#test("__task_cancelled")[true]
fun starts_with_dunder(name: str) -> bool {
    return name.len() >= 2 && name[0] == '_' && name[1] == '_'
}

// `msg` with each name a module qualified (`std$iter$sum`, the loader's)
// as a program writes it, by the module's last segment: `iter.sum`
// (MYLA-383). No name of a program's own has a `$`.
#test("function 'std$iter$sum' expects 2 argument(s), got 1")["function 'iter.sum' expects 2 argument(s), got 1"]
#test("type 'std$deque$Deque<std$deque$Deque<int32>>' has no method 'pop'")["type 'deque.Deque<deque.Deque<int32>>' has no method 'pop'"]
#test("'std$deque$Deque.push_back', 'geo$area'")["'deque.Deque.push_back', 'geo.area'"]
#test("a 'b' of $5 and x$ and $y")["a 'b' of $5 and x$ and $y"]
#test("größe$wert")["größe.wert"]
fun unmangled(msg: str) -> str {
    return unmangled_in(msg, [:], true)
}

// `unmangled`, a run rewritten only when `all` or `known` has it: the
// program's own text in a message (a format spec, a string) keeps its `$`
// (MYLA-383). A list's and a map's method key, `__list` and `__map`, is
// the type a program writes, `[T]` and `[K: V]` (MYLA-320).
#test("invalid format spec 'std$iter$sum'", [:], false)["invalid format spec 'std$iter$sum'"]
#test("function 'std$iter$sum' and 'a$b'", ["std$iter$sum": true], false)["function 'iter.sum' and 'a$b'"]
#test("duplicate method 'map' for type '__list', not '__map' or '__lists'", [:], false)["duplicate method 'map' for type '[T]', not '[K: V]' or '__lists'"]
#test("method '__list.sorted'", [:], false)["method '[T].sorted'"]
fun unmangled_in(msg: str, known: [str: bool], all: bool) -> str {
    var has = false
    var i0 = 0
    while i0 < msg.len() {
        if msg[i0] == '$' || (msg[i0] == '_' && i0 + 1 < msg.len() && msg[i0 + 1] == '_') { has = true }
        i0 += 1
    }
    if !has { return msg }
    var sb = StringBuilder()
    let n = msg.len()
    var i = 0
    while i < n {
        if !is_name_byte(msg[i]) {
            sb.append_byte(msg[i])
            i += 1
            continue
        }
        // a run of name bytes and `$`: its last two segments, when every
        // segment is a name
        var j = i
        while j < n && (is_name_byte(msg[j]) || msg[j] == '$') { j += 1 }
        let run = msg[i:j]
        if run == "__list" || run == "__map" {
            sb.append(if run == "__list" { "[T]" } else { "[K: V]" })
            i = j
            continue
        }
        let segs = run.split("$")
        var ok = segs.len() >= 2 && (all || known.contains(run))
        for g in segs { if g.len() == 0 || (g[0] >= '0' && g[0] <= '9') { ok = false } }
        if ok { sb.append(segs[segs.len() - 2] + "." + segs[segs.len() - 1]) } else { sb.append(run) }
        i = j
    }
    return sb.build()
}

// `es` with their messages and their notes' `unmangled_in` the names
// `known`.
fun unmangled_all(es: [CheckErr], known: [str: bool]) -> [CheckErr] {
    var out: [CheckErr] = []
    for e in es {
        var f = e
        f.msg = unmangled_in(e.msg, known, false)
        var ns: [Note] = []
        for n in e.notes {
            var m = n
            m.msg = unmangled_in(n.msg, known, false)
            ns.push(m)
        }
        f.notes = ns
        out.push(f)
    }
    return out
}

// Whether `b` is a byte of a name: an ASCII letter, digit or `_`, or a
// byte of a character past ASCII (D72).
#test(97u8)[true]
#test(36u8)[false]
#test(46u8)[false]
fun is_name_byte(b: uint8) -> bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_' || b >= 128
}

// =========================================================================
// Default arguments (D136, MYLA-255) and loops over iterators (D171): filled
// in once the program is checked
// =========================================================================
//
// The checker records, for each call that leaves trailing parameters out,
// the defaults of those parameters (`call_defaults`, keyed by the call's node
// id), and for each `for` over an iterator the loop it stands for
// (`for_iters`, keyed by the `for`'s id), each callee that stands for
// another name (`renames`: std.task's `cancel` in its own module is
// `std$task$cancel`, MYLA-388), and the declaration each was met in
// (`fill_decls`: a function, a const, or the impl of a method). `fill_in`
// rewrites the bodies of those declarations, so that call carries them as
// arguments of its own and the `for` is that loop: the interpreter, the
// lowering and everything after them see each call with all its arguments,
// and a loop over an iterator as one written with `while`. The rest stay as
// they are, the standard library's mostly (MYLA-382: rebuilding every body
// cost a hello world 8 ms). The rebuilt nodes keep their ids, so the side
// tables (types, the calls' targets) still apply; a default's nodes are
// shared by the calls it fills, as they have one type.

pub struct Fills { defaults: [int32: [Expr]], fors: [int32: Stmt], renames: [int32: str] }

impl Checker {
    // Every recorded call given its defaults and every loop over an iterator
    // made the loop it stands for, in the declarations, the functions' and
    // methods' signatures and the method bodies the checker keeps apart: in
    // those of the declarations that hold one (`fill_decls`).
    fun fill_in(var self) {
        if self.fill_decls.len() == 0 { return }
        let t = Fills { defaults: self.call_defaults, fors: self.for_iters, renames: self.renames }
        let at = self.fill_decls
        var i = 0
        while i < self.decls.len() {
            if at.contains(self.decls[i].id) { self.decls[i] = fd_decl(self.decls[i], t) }
            i += 1
        }
        i = 0
        while i < self.functions.len() {
            if at.contains(self.functions[i].decl_id) {
                var f = self.functions[i]
                f.decl = fd_fun(f.decl, t)
                self.functions[i] = f
            }
            i += 1
        }
        i = 0
        while i < self.method_decls.len() {
            if at.contains(self.method_decl_ids[i]) { self.method_decls[i] = fd_fun(self.method_decls[i], t) }
            i += 1
        }
    }
}

// The declarations of `src` whose bodies `fill_in` rewrites: a function's
// or const's name, "impl" for an impl's methods (MYLA-382).
#test("fun f(a: int, b: int = 1) -> int { return a + b }\nfun g() -> int { return f(1) }\nfun h() -> int { return f(1, 2) }")[["g"]]
#test("enum Option<T> { Some(T), None }\ntrait Iterator<T> { fun next(var self) -> Option<T> }\nstruct U { i: int }\nimpl Iterator<int> for U { fun next(var self) -> Option<int> { return None } }\nfun f(a: int = 2) -> int { return a }\nconst K: int = 1\nimpl U { fun m(self) -> int { for x in self { return x }\nreturn 0 } }\nfun main() { for x in [1] { print(x) } }")[["impl"]]
#test("fun main() { print(1) }")[[]]
fun filled_in(src: str) -> [str] {
    let c = checker_on(src)
    var out: [str] = []
    for d in c.decls {
        if c.fill_decls.contains(d.id) {
            match d.kind {
                DeclKind.FunDecl(f) => { out.push(f.name) },
                DeclKind.ConstDecl(n, te, e, attrs, p) => { out.push(n) },
                DeclKind.ImplDecl(target, ms, tps, tr, targs, dattrs) => { out.push("impl") },
                _ => { out.push("?") },
            }
        }
    }
    return out
}

fun fd_decl(d: Decl, t: Fills) -> Decl {
    let k = match d.kind {
        DeclKind.FunDecl(f) => DeclKind.FunDecl(fd_fun(f, t)),
        DeclKind.ImplDecl(target, ms, tps, tr, targs, dattrs) => DeclKind.ImplDecl(target, fd_funs(ms, t), tps, tr, targs, dattrs),
        DeclKind.TraitDecl(n, ms, tps, p, dattrs) => DeclKind.TraitDecl(n, fd_funs(ms, t), tps, p, dattrs),
        DeclKind.ConstDecl(n, te, e, attrs, p) => DeclKind.ConstDecl(n, te, fd_expr(e, t), attrs, p),
        _ => d.kind,
    }
    return Decl { id: d.id, line: d.line, col: d.col, sp: d.sp, kind: k }
}

fun fd_funs(ms: [FunData], t: Fills) -> [FunData] {
    var out: [FunData] = []
    for m in ms { out.push(fd_fun(m, t)) }
    return out
}

fun fd_fun(f: FunData, t: Fills) -> FunData {
    var g = f
    g.body = match f.body { Some(b) => Some(fd_block(b, t)), None => None }
    return g
}

fun fd_block(b: Block, t: Fills) -> Block {
    var ss: [Stmt] = []
    for s in b.stmts { ss.push(fd_stmt(s, t)) }
    return Block { line: b.line, col: b.col, sp: b.sp, stmts: ss }
}

fun fd_stmt(s: Stmt, t: Fills) -> Stmt {
    let k = match s.kind {
        StmtKind.VarDecl(kind, name, te, init) => StmtKind.VarDecl(kind, name, te, fd_expr(init, t)),
        StmtKind.DestructDecl(kind, b, te, init) => StmtKind.DestructDecl(kind, b, te, fd_expr(init, t)),
        StmtKind.Assign(place, value) => StmtKind.Assign(fd_expr(place, t), fd_expr(value, t)),
        StmtKind.IfS(c, then, el) => StmtKind.IfS(fd_expr(c, t), fd_block(then, t), fd_else(el, t)),
        StmtKind.WhileS(c, body) => StmtKind.WhileS(fd_expr(c, t), fd_block(body, t)),
        StmtKind.ForS(v, start, end, body, iter) => {
            // over an iterator: the loop the checker built (D171)
            if t.fors.contains(s.id) { return fd_stmt(t.fors[s.id], t) }
            StmtKind.ForS(v, fd_opt(start, t), fd_opt(end, t), fd_block(body, t), fd_opt(iter, t))
        },
        StmtKind.ReturnS(v, tail) => StmtKind.ReturnS(fd_opt(v, t), tail),
        StmtKind.ExprStmt(e) => StmtKind.ExprStmt(fd_expr(e, t)),
        StmtKind.DeferS(b) => StmtKind.DeferS(fd_block(b, t)),
        _ => s.kind,
    }
    return Stmt { id: s.id, line: s.line, col: s.col, sp: s.sp, kind: k }
}

fun fd_else(el: Option<ElseTail>, t: Fills) -> Option<ElseTail> {
    return match el {
        Some(ElseTail.ElseBlock(b)) => Some(ElseTail.ElseBlock(fd_block(b, t))),
        Some(ElseTail.ElseIf(s)) => Some(ElseTail.ElseIf(fd_stmt(s, t))),
        None => None,
    }
}

fun fd_opt(e: Option<Expr>, t: Fills) -> Option<Expr> {
    return match e { Some(x) => Some(fd_expr(x, t)), None => None }
}

fun fd_exprs(es: [Expr], t: Fills) -> [Expr] {
    var out: [Expr] = []
    for e in es { out.push(fd_expr(e, t)) }
    return out
}

fun fd_body(b: ExprOrBlock, t: Fills) -> ExprOrBlock {
    return match b {
        ExprOrBlock.EB_Expr(x) => ExprOrBlock.EB_Expr(fd_expr(x, t)),
        ExprOrBlock.EB_Block(bl) => ExprOrBlock.EB_Block(fd_block(bl, t)),
    }
}

fun fd_expr(e: Expr, t: Fills) -> Expr {
    let k = match e.kind {
        ExprKind.Unary(op, a) => ExprKind.Unary(op, fd_expr(a, t)),
        ExprKind.Binary(op, a, b) => ExprKind.Binary(op, fd_expr(a, t), fd_expr(b, t)),
        ExprKind.Call(c, args, targs) => {
            var all = fd_exprs(args, t)
            // the defaults this call leaves to its trailing parameters, which
            // may themselves call something with defaults
            if t.defaults.contains(e.id) {
                for d in t.defaults[e.id] { all.push(fd_expr(d, t)) }
            }
            ExprKind.Call(fd_expr(c, t), all, targs)
        },
        ExprKind.GetField(a, f) => ExprKind.GetField(fd_expr(a, t), f),
        ExprKind.StructLit(n, fs) => {
            var fs2: [FieldInit] = []
            for f in fs { fs2.push(FieldInit { line: f.line, col: f.col, sp: f.sp, name: f.name, value: fd_expr(f.value, t) }) }
            ExprKind.StructLit(n, fs2)
        },
        ExprKind.TupleLit(es) => ExprKind.TupleLit(fd_exprs(es, t)),
        ExprKind.TupleIndex(a, i) => ExprKind.TupleIndex(fd_expr(a, t), i),
        ExprKind.ListLit(es) => ExprKind.ListLit(fd_exprs(es, t)),
        ExprKind.MapLit(ms) => {
            var ms2: [MapEntry] = []
            for m in ms { ms2.push(MapEntry { key: fd_expr(m.key, t), value: fd_expr(m.value, t) }) }
            ExprKind.MapLit(ms2)
        },
        ExprKind.Index(a, i) => ExprKind.Index(fd_expr(a, t), fd_expr(i, t)),
        ExprKind.MatchE(s, arms) => {
            var arms2: [MatchArm] = []
            for a in arms { arms2.push(MatchArm { line: a.line, col: a.col, sp: a.sp, pattern: a.pattern, guard: fd_opt(a.guard, t), body: fd_body(a.body, t) }) }
            ExprKind.MatchE(fd_expr(s, t), arms2)
        },
        ExprKind.Try(a) => ExprKind.Try(fd_expr(a, t)),
        ExprKind.Cast(a, te) => ExprKind.Cast(fd_expr(a, t), te),
        ExprKind.Name(n) => if t.renames.contains(e.id) { ExprKind.Name(t.renames[e.id]) } else { e.kind },
        ExprKind.Lambda(ps, rt, body, asy) => ExprKind.Lambda(ps, rt, fd_body(body, t), asy),
        ExprKind.Await(a) => ExprKind.Await(fd_expr(a, t)),
        _ => e.kind,
    }
    return Expr { id: e.id, line: e.line, col: e.col, sp: e.sp, kind: k }
}

// How many of `ps`, from the last, have a default (D136).
#test([])[0]
fun trailing_defaults(ps: [Param]) -> int32 {
    var n = 0
    var i = ps.len() - 1
    while i >= 0 {
        match ps[i].default { Some(d) => { n += 1 }, None => { return n } }
        i -= 1
    }
    return n
}
