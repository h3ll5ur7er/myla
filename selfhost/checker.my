fun int_width(t: Type) -> int32 { return match t { Type.TInt(w, s) => w, _ => 0 } }

#test(Type.TStr)[true]
#test(Type.TChar)[true]
#test(Type.TParam("K"))[false]
fun is_map_key(t: Type) -> bool {
    return match t {
        Type.TInt(w, s) => true,
        Type.TChar => true,
        Type.TBool => true,
        Type.TStr => true,
        _ => false,
    }
}

#test("A")[None]
#test("int8")[Some(Type.TInt(8, true))]
#test("uint32")[Some(Type.TInt(32, false))]
fun prim_type(name: str) -> Option<Type> {
    if name == "bool" { return Some(Type.TBool) }
    if name == "str" { return Some(Type.TStr) }
    if name == "StringBuilder" { return Some(Type.TSB) }
    if name == "int8" { return Some(Type.TInt(8, true)) }
    if name == "int16" { return Some(Type.TInt(16, true)) }
    if name == "int32" { return Some(Type.TInt(32, true)) }
    if name == "int64" { return Some(Type.TInt(64, true)) }
    if name == "uint8" { return Some(Type.TInt(8, false)) }
    if name == "uint16" { return Some(Type.TInt(16, false)) }
    if name == "uint32" { return Some(Type.TInt(32, false)) }
    if name == "uint64" { return Some(Type.TInt(64, false)) }
    if name == "float32" { return Some(Type.TFloat(32)) }
    if name == "float64" { return Some(Type.TFloat(64)) }
    if name == "char" { return Some(Type.TChar) }
    return None
}

#test("i8")[Some(Type.TInt(8, true))]
#test("u8")[Some(Type.TInt(8, false))]
fun int_suffix_type(s: str) -> Option<Type> {
    if s == "i8" { return Some(Type.TInt(8, true)) }
    if s == "i16" { return Some(Type.TInt(16, true)) }
    if s == "i32" { return Some(Type.TInt(32, true)) }
    if s == "i64" { return Some(Type.TInt(64, true)) }
    if s == "u8" { return Some(Type.TInt(8, false)) }
    if s == "u16" { return Some(Type.TInt(16, false)) }
    if s == "u32" { return Some(Type.TInt(32, false)) }
    if s == "u64" { return Some(Type.TInt(64, false)) }
    return None
}

#test("f32")[Some(Type.TFloat(32))]
#test("f64")[Some(Type.TFloat(64))]
fun float_suffix_type(s: str) -> Option<Type> {
    if s == "f32" { return Some(Type.TFloat(32)) }
    if s == "f64" { return Some(Type.TFloat(64)) }
    return None
}

// half-open: signed permits magnitude up to 2**(width-1) (negation handled
// separately); unsigned permits up to 2**width - 1.
// Whether a literal fits a type, as types.int_fits: `big` is its decimal text
// when it is 2^63 or more (`value` then holds only its low bits). A signed
// type admits the magnitude 2^(w-1), so that `-128i8` is accepted.
#test(1, "", 32, true, true)[true]
#test(1, "", 8, true, false)[true]
#test(128, "", 8, true, false)[false]
fun lit_fits(value: int64, big: str, w: int32, signed: bool, negated: bool) -> bool {
    if big == "" { return int_fits(value, w, signed, negated) }
    if w < 64 { return false }
    if signed { return negated && big == "9223372036854775808" }
    return big.len() < 20 || (big.len() == 20 && !text_greater(big, "18446744073709551615"))
}

// `a > b` for decimal texts of the same length.
#test("a", "a")[false]
#test("x", "x")[false]
#test("y", "y")[false]
fun text_greater(a: str, b: str) -> bool {
    var i = 0
    while i < a.len() {
        if a[i] != b[i] { return a[i] > b[i] }
        i = i + 1
    }
    return false
}

// A signed type takes magnitudes up to 2^(w-1) - 1, and 2^(w-1) only under a
// unary minus (MYLA-175; types.py: int_fits).
#test(1, 32, true, true)[true]
#test(1, 8, true, false)[true]
#test(128, 8, true, false)[false]
fun int_fits(value: int64, w: int32, signed: bool, negated: bool) -> bool {
    if value < 0 { return false }
    if signed {
        if w >= 64 { return true }
        var lim: int64 = 1
        lim = lim << (w - 1)
        if !negated { lim = lim - 1 }
        return value <= lim
    }
    if w >= 64 { return true }
    var lim2: int64 = 1
    lim2 = lim2 << w
    return value <= lim2 - 1
}

#test("&")[None]
#test("+")[Some("Add")]
#test("/")[Some("Div")]
fun arith_trait(op: str) -> Option<str> {
    if op == "+" { return Some("Add") }
    if op == "-" { return Some("Sub") }
    if op == "*" { return Some("Mul") }
    if op == "/" { return Some("Div") }
    if op == "%" { return Some("Rem") }
    return None
}

#test("%")[true]
#test("*")[true]
#test("&")[false]
fun is_arith_op(op: str) -> bool {
    return match arith_trait(op) { Some(x) => true, None => false }
}

// implicit primitive operator-trait defaults (D52); the printable
// primitives are `Format` too, as a format hole shows them (D162)
#test(Type.TInt(32, true), "Format")[true]
#test(Type.TInt(32, true), "Eq")[true]
#test(Type.TInt(32, true), "Add")[true]
#test(Type.TStruct("P", []), "Eq")[false]
fun primitive_default_trait(t: Type, trnm: str) -> bool {
    return match t {
        Type.TInt(w, s) => trnm == "Add" || trnm == "Sub" || trnm == "Mul" || trnm == "Div" || trnm == "Rem" || trnm == "Eq" || trnm == "Ord" || trnm == "Format" || trnm == "Hash",
        // a float isn't `Hash`: NaN is unequal to itself (D163)
        Type.TFloat(w) => trnm == "Add" || trnm == "Sub" || trnm == "Mul" || trnm == "Div" || trnm == "Rem" || trnm == "Eq" || trnm == "Ord" || trnm == "Format",
        Type.TChar => trnm == "Eq" || trnm == "Ord" || trnm == "Format" || trnm == "Hash",
        Type.TBool => trnm == "Eq" || trnm == "Format" || trnm == "Hash",
        // a string's `<` is byte-wise (MYLA-318)
        Type.TStr => trnm == "Add" || trnm == "Eq" || trnm == "Ord" || trnm == "Format" || trnm == "Hash",
        _ => false,
    }
}

#test("Add")[true]
#test("Two")[false]
#test("Show")[false]
fun is_builtin_op_trait(name: str) -> bool {
    return name == "Add" || name == "Sub" || name == "Mul" || name == "Div" || name == "Rem" || name == "Eq" || name == "Ord"
}

#test("A")[false]
#test("B")[false]
#test("len")[true]
fun is_builtin_func(name: str) -> bool {
    return name == "print" || name == "assert" || name == "panic" || name == "unreachable" || name == "len" || name == "push" || name == "pop" || name == "contains" || name == "remove" || name == "keys" || name == "format" || name == "chars" || name == "StringBuilder" || name == "append" || name == "append_byte" || name == "append_char" || name == "build" || name == "__write" || name == "__exit" || name == "__args" || name == "__read_file" || name == "__io_errno" || name == "__run" || name == "__run_stderr" || name == "__run_exit_code" || name == "__run_signal" || name == "__run_errno" || name == "__write_file" || name == "__read" || name == "__poll" || name == "__list_dir" || name == "__mkdir" || name == "__stat" || name == "__getcwd" || name == "__getenv" || name == "__test_dir" || name == "__test_program" || name == "__sqrt" || name == "__f64_bits" || name == "__f64_from_bits" || name == "__unlink" || name == "__rmdir" || name == "__rename" || name == "__task_cancelled" || name == "__yield" || name == "__sleep" || name == "__clock_ns" || name == "__sleep_ns" || name == "__cancel_after" || name == "__disarm" || name == "__wait_readable" || name == "__wait_either" || name == "__wait_socket" || name == "__spawn" || name == "__run_with" || name == "__spawn_with" || name == "__reap" || name == "__kill" || name == "__close" || name == "__str_to_bytes" || name == "__bytes_to_str" || name == "__read_bytes" || name == "__write_bytes" || is_platform_primitive(name) || is_raw_memory_primitive(name) || is_notify_primitive(name) || is_wrapping_method(name)
}

// Whether `name` is one of the integers' builtin methods that wrap on purpose
// (D175, MYLA-395): `wrapping_add`, `wrapping_sub`, `wrapping_mul` and
// `wrapping_neg`, one instruction natively and never checked for overflow.
#test("wrapping_add")[true]
#test("wrapping_neg")[true]
#test("wrapping_pow")[false]
pub fun is_wrapping_method(name: str) -> bool {
    return name == "wrapping_add" || name == "wrapping_sub" || name == "wrapping_mul" || name == "wrapping_neg"
}

// The primitives of std.task's notifiers (MYLA-387): a notifier, a wake of
// one or all of its waiters, its generation, and a wait (`__waiter`, then
// `__park`, awaited, then `__woken`), each a function of std.rt and in the
// interpreter its scheduler's.
#test("__park")[true]
#test("__notify")[true]
#test("__sleep")[false]
pub fun is_notify_primitive(name: str) -> bool {
    return name == "__notifier" || name == "__notify" || name == "__notify_gen" || name == "__waiter" || name == "__park" || name == "__woken"
}

// The platform primitives of MYLA-336: entropy, file descriptors and
// children with pipes, MYLA-334's wall clock and MYLA-378's stat of a path,
// each a function of std.rt (`__open` is `std.rt.open`) over std.platform,
// and in the interpreter the host's own.
#test("__open")[true]
#test("__wall_ns")[true]
#test("__path_stat")[true]
#test("__read")[false]
pub fun is_platform_primitive(name: str) -> bool {
    return name == "__random_bytes" || name == "__open" || name == "__seek" || name == "__fstat" || name == "__path_stat" || name == "__spawn_piped" || name == "__try_reap" || name == "__wall_ns" || is_net_primitive(name) || is_term_primitive(name)
}

// The terminal and signal primitives of MYLA-350 (std.term's and
// std.signal's), platform primitives too: each a function of std.rt over
// std.platform's, and in the interpreter the host's own.
#test("__term_raw")[true]
#test("__signal_take")[true]
#test("__term_vt")[true]
#test("__terminal")[false]
pub fun is_term_primitive(name: str) -> bool {
    if name.len() < 9 || name[0] != '_' || name[1] != '_' { return false }
    return name == "__term_is_tty" || name == "__term_size" || name == "__term_get" || name == "__term_set" || name == "__term_raw" || name == "__term_vt" || name == "__signal_listen" || name == "__signal_take"
}

// A terminal or signal primitive's parameters, as its messages show them
// and as types, and its result type.
#test("__term_get")[("fd: int", [Type.TInt(32, true)], Type.TStr)]
#test("__signal_listen")[("on: int", [Type.TInt(32, true)], Type.TInt(32, true))]
fun term_primitive_sig(name: str) -> (str, [Type], Type) {
    let i = t_int()
    if name == "__term_get" { return ("fd: int", [i], Type.TStr) }
    if name == "__term_set" { return ("fd: int, mode: str", [i, Type.TStr], i) }
    if name == "__signal_listen" { return ("on: int", [i], i) }
    if name == "__signal_take" { return ("h: int", [i], i) }
    return ("fd: int", [i], i)
}

// The socket primitives of MYLA-346 (std.net's), platform primitives too:
// each a function of std.rt over std.platform's socket functions, and in
// the interpreter the host's own. The reactor's wait for a socket,
// `__wait_socket`, is awaited, as `__wait_readable` is.
#test("__sock_open")[true]
#test("__net_config")[true]
#test("__wait_socket")[false]
pub fun is_net_primitive(name: str) -> bool {
    if name.len() < 7 || name[0] != '_' || name[1] != '_' { return false }
    return name == "__sock_open" || name == "__sock_set_nonblocking" || name == "__sock_bind" || name == "__sock_listen" || name == "__sock_accept" || name == "__sock_connect" || name == "__sock_error" || name == "__sock_send" || name == "__sock_recv" || name == "__sock_send_to" || name == "__sock_recv_from" || name == "__sock_addr" || name == "__sock_shutdown" || name == "__sock_option" || name == "__sock_poll" || name == "__sock_close" || name == "__net_config"
}

// A socket primitive's parameters, as its messages show them and as types,
// and its result type.
#test("__sock_close")[("h: int", [Type.TInt(32, true)], Type.TInt(32, true))]
#test("__net_config")[("which: int", [Type.TInt(32, true)], Type.TStr)]
fun net_primitive_sig(name: str) -> (str, [Type], Type) {
    let i = t_int()
    let s = Type.TStr
    if name == "__sock_open" { return ("family: int, kind: int", [i, i], i) }
    if name == "__sock_set_nonblocking" { return ("h: int, on: int", [i, i], i) }
    if name == "__sock_bind" || name == "__sock_connect" { return ("h: int, addr: str", [i, s], i) }
    if name == "__sock_listen" { return ("h: int, backlog: int", [i, i], i) }
    if name == "__sock_accept" || name == "__sock_error" || name == "__sock_close" { return ("h: int", [i], i) }
    if name == "__sock_send" { return ("h: int, s: str, start: int", [i, s, i], i) }
    if name == "__sock_recv" || name == "__sock_recv_from" { return ("h: int, n: int", [i, i], s) }
    if name == "__sock_send_to" { return ("h: int, s: str, addr: str", [i, s, s], i) }
    if name == "__sock_addr" { return ("h: int, peer: int", [i, i], s) }
    if name == "__sock_shutdown" { return ("h: int, how: int", [i, i], i) }
    if name == "__sock_option" { return ("h: int, opt: int, value: int", [i, i, i], i) }
    if name == "__sock_poll" { return ("h: int, events: int, timeout_ms: int", [i, i, i], i) }
    return ("which: int", [i], s)
}

// The raw-memory primitives the runtime written in Myla needs (MYLA-162's
// prototype, D117): addresses as `int64`, in native code only.
#test("__load8")[true]
#test("__load")[false]
pub fun is_raw_memory_primitive(name: str) -> bool {
    return name == "__load8" || name == "__load64" || name == "__store8" || name == "__store64" || name == "__alloc" || name == "__addr_of" || name == "__str_of" || name == "__copy_bytes" || name == "__equal_bytes" || name == "__syscall" || name == "__syscall5" || name == "__set_io_errno" || name == "__free" || name == "__environ" || name == "__set_run_status" || name == "__set_run_stderr" || name == "__argv" || name == "__load32" || name == "__store32" || name == "__list_addr" || name == "__list_of" || name == "__rotl" || name == "__rt_addr" || name == "__rt_get" || name == "__bsr64" || name == "__trap_oom" || name == "__rt_waddr" || name == "__cas64" || name == "__xchg64" || name == "__fetch_add64" || name == "__pause" || name == "__run_frame" || name == "__f64_round" || name == "__load_acq64" || name == "__store_rel64" || name == "__call_code"
}

// The error for a program's call of the raw-memory primitive `name`.
fun raw_memory_call(at: Expr, name: str) -> CheckErr {
    return CheckErr { line: at.line, col: at.col, sp: at.sp, msg: format("'{}' reads or writes raw memory: only the standard library may call it", name), decl: -1, notes: [Note { label: "help", msg: "the standard library's types and functions do what it does, safely", line: 0, col: 0, sp: no_span() }] }
}

// Whether a test function may have the result `r` (D162): none, `()`, or
// a `Result<(), E>`.
#test(None)[true]
#test(Some(Type.TInt(32, true)))[false]
#test(Some(Type.TEnum("Result", [Type.TTuple([]), Type.TStr])))[true]
#test(Some(Type.TEnum("Result", [Type.TInt(32, true), Type.TStr])))[false]
fun is_test_result(r: Option<Type>) -> bool {
    return match r {
        None => true,
        Some(Type.TTuple(ts)) => ts.len() == 0,
        Some(Type.TEnum(n, args)) => n == "Result" && args.len() == 2 && is_unit(args[0]),
        Some(x) => false,
    }
}

#test("sum")[false]
#test("panic")[true]
#test("push")[false]
fun is_diverging_builtin(name: str) -> bool {
    return name == "panic" || name == "unreachable" || name == "__exit" || name == "std$process$exit"
}

#test("y")[None]
#test("Ok")[Some("Result")]
#test("None")[Some("Option")]
fun prelude_variant_enum(name: str) -> Option<str> {
    if name == "Some" { return Some("Option") }
    if name == "None" { return Some("Option") }
    if name == "Ok" { return Some("Result") }
    if name == "Err" { return Some("Result") }
    return None
}

#test([], "A")[false]
#test([], "B")[false]
#test(["S"], "S")[true]
fun contains_str(xs: [str], s: str) -> bool {
    for x in xs { if x == s { return true } }
    return false
}

