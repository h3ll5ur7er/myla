// parser.my — the Myla parser (mirror of src/myla/parser.py).
//
// Recursive descent with a layered precedence grammar. A syntax error is
// Python's ParseError: `fail` keeps it as pending (message and position as in
// parser.py) and jumps to EOF, where every loop ends, so the parse unwinds as
// Python's exception does. A block, an impl or trait body and the program are
// where Python catches it: after the statement, member or declaration, they
// record the pending error, go back to where it was found and skip to the next
// one (`recovered`, `sync`), up to MAX_ERRORS errors (MYLA-65, D80). Every node is stamped with a unique NodeId and the
// 1-based source position of the token Python's `.at(...)` uses, so the checker
// reproduces diagnostic positions byte-for-byte, and with the range of the
// tokens consumed for it (MYLA-65): from its position, or from where its left
// operand began, to the end of the last token consumed when it is built.
// Parser desugarings are preserved exactly: `|>` -> Call, `return a, b` -> Return(TupleLit), adjacent
// `<`/`>` -> shift Binary, char literal -> IntLit(is_char=true).

from .tokens import Token, TokenKind, Diag, SrcSpan, MAX_ERRORS
from .lexer import lex
from .ast import TypeExpr, TypeKind, Expr, ExprKind, Stmt, StmtKind
from .ast import Pattern, PatternKind, Decl, DeclKind, Block, ExprOrBlock, ElseTail
from .ast import BindElem, FieldInit, MapEntry, MatchArm, FieldPat, Param
from .ast import TypeParam, Field, Variant, Attribute, ImportPath, ImportItem
from .ast import FunData, Program

pub struct Parser {
    toks: [Token],
    pos: int32,
    allow_struct_lit: bool,
    next_id: int32,
    errs: [Diag],               // the errors recorded (MYLA-65, D80)
    pending: Option<Diag>,      // an error the parse is unwinding from (at EOF)
    resume: int32,              // where it, or the unwinding, left off
    unwinding: bool,            // leaving a declaration without an error (Python's _Unwind)
    stopped: bool,              // MAX_ERRORS were recorded (Python's _Stop)
    depth: int32,               // nesting, up to MAX_NESTING (MYLA-182)
}

// How deep expressions, types, blocks and patterns may nest (MYLA-182; the
// Python parser's MAX_NESTING): past it, a parse error, not a stack overflow.
const MAX_NESTING: int32 = 256

pub fun new_parser(toks: [Token]) -> Parser {
    return Parser { toks: toks, pos: 0, allow_struct_lit: true, next_id: 0, errs: [], pending: None, resume: 0, unwinding: false, stopped: false, depth: 0 }
}

// What `sync` skips to: the next statement of a block, the next member of an
// impl or trait body, the next top-level declaration.
const SYNC_STMT: int32 = 0
const SYNC_MEMBER: int32 = 1
const SYNC_DECL: int32 = 2

// The tokens that begin a declaration.
#test(TokenKind.HASH)[true]
#test(TokenKind.LET)[false]
fun is_decl_start(k: TokenKind) -> bool {
    return k == TokenKind.FUN || k == TokenKind.ACTOR || k == TokenKind.ASYNC || k == TokenKind.STRUCT || k == TokenKind.ENUM || k == TokenKind.IMPL || k == TokenKind.TRAIT || k == TokenKind.TYPEALIAS || k == TokenKind.CONST || k == TokenKind.IMPORT || k == TokenKind.FROM || k == TokenKind.PUB || k == TokenKind.HASH
}

// The tokens that begin a statement other than an expression.
#test(TokenKind.RETURN)[true]
#test(TokenKind.IDENT)[false]
fun is_stmt_start(k: TokenKind) -> bool {
    return k == TokenKind.LET || k == TokenKind.VAR || k == TokenKind.IF || k == TokenKind.WHILE || k == TokenKind.FOR || k == TokenKind.RETURN || k == TokenKind.BECOME || k == TokenKind.BREAK || k == TokenKind.CONTINUE || k == TokenKind.ASYNC
}

#test([TokenKind.LPAREN], TokenKind.LBRACE)[false]
#test([TokenKind.LBRACE, TokenKind.LPAREN], TokenKind.LBRACE)[true]
fun has_kind(ks: [TokenKind], k: TokenKind) -> bool {
    for x in ks { if x == k { return true } }
    return false
}

// `opens`, the brackets open while skipping tokens, after `k`: an opening
// one is pushed; a closing one pops back to its partner, or is ignored
// without one (parser.py: _nest).
#test([TokenKind.LBRACE], TokenKind.LPAREN)[[TokenKind.LBRACE, TokenKind.LPAREN]]
#test([TokenKind.LBRACE, TokenKind.LPAREN], TokenKind.RBRACE)[[]]
#test([TokenKind.LBRACE], TokenKind.RPAREN)[[TokenKind.LBRACE]]
fun nest(opens: [TokenKind], k: TokenKind) -> [TokenKind] {
    var out = opens
    if k == TokenKind.LPAREN || k == TokenKind.LBRACKET || k == TokenKind.LBRACE {
        push(out, k)
        return out
    }
    var partner = TokenKind.EOF
    if k == TokenKind.RPAREN { partner = TokenKind.LPAREN }
    if k == TokenKind.RBRACKET { partner = TokenKind.LBRACKET }
    if k == TokenKind.RBRACE { partner = TokenKind.LBRACE }
    if partner != TokenKind.EOF && has_kind(out, partner) {
        while pop(out) != partner {}
    }
    return out
}

// Whether `d` is after `last`; one that is not follows from it.
#test(Diag { kind: "", line: 2, col: 1, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "" }, Diag { kind: "", line: 1, col: 9, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "" })[true]
#test(Diag { kind: "", line: 1, col: 9, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "" }, Diag { kind: "", line: 1, col: 9, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, msg: "" })[false]
fun is_after(d: Diag, last: Diag) -> bool {
    return d.line > last.line || (d.line == last.line && d.col > last.col)
}

#test("")[None]
#test("u8")[Some("u8")]
#test("f64")[Some("f64")]
fun suffix_opt(s: str) -> Option<str> {
    if s == "" { return None }
    return Some(s)
}

fun cons_expr(head: Expr, tail: [Expr]) -> [Expr] {
    var out: [Expr] = [head]
    for x in tail {
        push(out, x)
    }
    return out
}

#test(Expr { id: 2, line: 6, col: 5, sp: SrcSpan { sline: 6, scol: 5, eline: 6, ecol: 6 }, kind: ExprKind.Name("s") })[true]
#test(Expr { id: 2, line: 9, col: 5, sp: SrcSpan { sline: 9, scol: 5, eline: 9, ecol: 6 }, kind: ExprKind.Name("x") })[true]
#test(Expr { id: 0, line: 4, col: 5, sp: SrcSpan { sline: 4, scol: 5, eline: 4, ecol: 6 }, kind: ExprKind.IntLit(1, None, false, "") })[false]
fun is_lvalue(e: Expr) -> bool {
    return match e.kind {
        ExprKind.Name(n) => true,
        ExprKind.GetField(t, f) => is_lvalue(t),
        ExprKind.Index(t, i) => is_lvalue(t),
        _ => false,
    }
}

impl Parser {
    // -- node constructors (assign a NodeId + position) --------------------

    fun fresh(var self) -> int32 {
        let i = self.next_id
        self.next_id = self.next_id + 1
        return i
    }

    // From `sline`:`scol` to the end of the last token consumed.
    fun span_from(self, sline: int32, scol: int32) -> SrcSpan {
        var i = self.pos - 1
        if i < 0 { i = 0 }
        return SrcSpan { sline: sline, scol: scol, eline: self.toks[i].eline, ecol: self.toks[i].ecol }
    }

    fun mk_expr(var self, line: int32, col: int32, k: ExprKind) -> Expr {
        return Expr { id: self.fresh(), line: line, col: col, sp: self.span_from(line, col), kind: k }
    }

    // A node whose range starts at `st` rather than at its position (a binary
    // expression, a call, a field access, … begins with its left operand).
    fun mk_expr_from(var self, st: Token, line: int32, col: int32, k: ExprKind) -> Expr {
        return Expr { id: self.fresh(), line: line, col: col, sp: self.span_from(st.line, st.column), kind: k }
    }

    fun mk_stmt(var self, line: int32, col: int32, k: StmtKind) -> Stmt {
        return Stmt { id: self.fresh(), line: line, col: col, sp: self.span_from(line, col), kind: k }
    }

    fun mk_stmt_from(var self, st: Token, line: int32, col: int32, k: StmtKind) -> Stmt {
        return Stmt { id: self.fresh(), line: line, col: col, sp: self.span_from(st.line, st.column), kind: k }
    }

    fun mk_pat(var self, line: int32, col: int32, k: PatternKind) -> Pattern {
        return Pattern { id: self.fresh(), line: line, col: col, sp: self.span_from(line, col), kind: k }
    }

    fun mk_pat_from(var self, sline: int32, scol: int32, line: int32, col: int32, k: PatternKind) -> Pattern {
        return Pattern { id: self.fresh(), line: line, col: col, sp: self.span_from(sline, scol), kind: k }
    }

    fun mk_type(var self, line: int32, col: int32, k: TypeKind) -> TypeExpr {
        return TypeExpr { id: self.fresh(), line: line, col: col, sp: self.span_from(line, col), kind: k }
    }

    fun mk_decl(var self, line: int32, col: int32, k: DeclKind) -> Decl {
        return Decl { id: self.fresh(), line: line, col: col, sp: self.span_from(line, col), kind: k }
    }

    // -- cursor helpers ----------------------------------------------------

    fun peek(self) -> Token {
        if self.pos >= len(self.toks) {
            return self.toks[len(self.toks) - 1]
        }
        return self.toks[self.pos]
    }

    fun peek_at(self, offset: int32) -> Token {
        let idx = self.pos + offset
        if idx >= len(self.toks) {
            return self.toks[len(self.toks) - 1]
        }
        return self.toks[idx]
    }

    // The kind of the current token, or of the one `offset` further, read in
    // place: `peek` copies the token and its strings (MYLA-124).
    fun peek_kind(self) -> TokenKind {
        if self.pos >= len(self.toks) { return self.toks[len(self.toks) - 1].kind }
        return self.toks[self.pos].kind
    }

    fun peek_kind_at(self, offset: int32) -> TokenKind {
        let idx = self.pos + offset
        if idx >= len(self.toks) { return self.toks[len(self.toks) - 1].kind }
        return self.toks[idx].kind
    }

    fun at_end(self) -> bool {
        return self.peek_kind() == TokenKind.EOF
    }

    fun check(self, k: TokenKind) -> bool {
        return self.peek_kind() == k
    }

    fun advance(var self) -> Token {
        let tok = self.peek()
        self.skip()
        return tok
    }

    // Past the current token, unless it is the end (`advance` without the
    // copy of the token).
    fun skip(var self) {
        if self.peek_kind() != TokenKind.EOF {
            self.pos = self.pos + 1
        }
    }

    fun match1(var self, k: TokenKind) -> bool {
        if self.peek_kind() == k {
            self.skip()
            return true
        }
        return false
    }

    // Raise a parse error: keep it as pending, unless one is (or the parse is
    // unwinding or stopped), and skip to EOF (the callers carry on with
    // placeholder nodes, which are discarded) until a recovery point
    // (`recovered`) records it and goes back to where it was found.
    fun fail(var self, line: int32, col: int32, sp: SrcSpan, msg: str) {
        if !self.unwinding && !self.stopped {
            match self.pending {
                None => {
                    self.pending = Some(Diag { kind: "parse error", line: line, col: col, sp: sp, msg: msg })
                    self.resume = self.pos
                },
                Some(e) => {},
            }
        }
        self.pos = len(self.toks) - 1
    }

    // Python's _Unwind: leave the declaration without an error, to go on at
    // the current token.
    fun unwind(var self) {
        self.unwinding = true
        self.resume = self.pos
        self.pos = len(self.toks) - 1
    }

    // A recovery point after parsing from token `start` (parser.py: the
    // `except ParseError` around a statement, member or declaration and
    // _recover): record the pending error, unless it is not after the last
    // one, go back to where it was found and skip to where a `mode` can begin
    // (`sync`), past `start` unless a block or body ends there. Whether the
    // parse went wrong: also while unwinding or stopped.
    fun recovered(var self, start: int32, mode: int32) -> bool {
        match self.pending {
            Some(d) => {
                self.pending = None
                self.pos = self.resume
                let n = len(self.errs)
                if n == 0 || is_after(d, self.errs[n - 1]) {
                    push(self.errs, d)
                    if len(self.errs) >= MAX_ERRORS {
                        self.stopped = true
                        self.pos = len(self.toks) - 1
                        return true
                    }
                }
                self.sync(start, mode)
                if self.pos == start && (mode == SYNC_DECL || !(self.check(TokenKind.RBRACE) || self.resuming_at_declaration())) {
                    self.skip()
                }
                return true
            },
            None => {},
        }
        return self.unwinding || self.stopped
    }

    fun at_line_start(self) -> bool {
        if self.pos == 0 { return true }
        let k = self.toks[self.pos - 1].kind
        return k == TokenKind.NEWLINE || k == TokenKind.SEMI
    }

    // Skip from the error to where a `mode` can begin (parser.py: _sync). The
    // brackets opened since `start` and not closed are tracked, so a
    // construct spanning lines is skipped whole. It stops at EOF; at a line
    // starting a declaration (for a member or a declaration only with no
    // brace open, or at column 1); at a `}` closing the enclosing block or
    // body; for a statement, at a newline or `;` with no brace open, when no
    // bracket is open either or the next line starts a statement, a
    // declaration or with `}`.
    fun sync(var self, start: int32, mode: int32) {
        var opens: [TokenKind] = []
        var i = start
        while i < self.pos {
            opens = nest(opens, self.toks[i].kind)
            i = i + 1
        }
        while !self.at_end() {
            let tok = self.peek()
            let k = tok.kind
            let brace = has_kind(opens, TokenKind.LBRACE)
            if is_decl_start(k) && self.at_line_start() {
                if mode == SYNC_STMT || !brace || tok.column == 1 { return }
            }
            if k == TokenKind.RBRACE && !brace && mode != SYNC_DECL { return }
            if mode == SYNC_STMT && (k == TokenKind.NEWLINE || k == TokenKind.SEMI) && !brace {
                let nxt = self.peek_kind_at(1)
                if len(opens) == 0 || is_stmt_start(nxt) || is_decl_start(nxt) || nxt == TokenKind.RBRACE { return }
            }
            opens = nest(opens, k)
            self.skip()
        }
    }

    // Whether the last error is at the next token, which starts a declaration
    // on its line: then the block or body being parsed is missing its `}`,
    // and the parse resumes at the declaration.
    fun resuming_at_declaration(self) -> bool {
        let tok = self.peek()
        let n = len(self.errs)
        if n == 0 || !is_decl_start(tok.kind) || !self.at_line_start() { return false }
        return self.errs[n - 1].line == tok.line && self.errs[n - 1].col == tok.column
    }

    // An error about the token `tok`, which it underlines.
    // One level deeper (the caller leaves it after); past MAX_NESTING a parse
    // error at the current token, which sends the parse to the end, so the
    // levels unwind at once (Python: _enter).
    fun enter(var self, what: str) {
        self.depth = self.depth + 1
        if self.depth > MAX_NESTING { self.fail_at(self.peek(), format("{} nested too deeply", what)) }
    }

    fun fail_at(var self, tok: Token, msg: str) {
        self.fail(tok.line, tok.column, SrcSpan { sline: tok.line, scol: tok.column, eline: tok.eline, ecol: tok.ecol }, msg)
    }

    fun expect(var self, k: TokenKind, what: str) -> Token {
        let tok = self.peek()
        if tok.kind != k {
            self.fail_at(tok, format("expected {}, found '{}'", what, tok.lexeme))
            return tok
        }
        return self.advance()
    }

    fun skip_newlines(var self) {
        while self.check(TokenKind.NEWLINE) {
            self.skip()
        }
    }

    // Skip the newlines and `;` between statements or declarations (D61).
    fun skip_separators(var self) {
        while self.at_separator() {
            self.skip()
        }
    }

    fun at_separator(self) -> bool {
        return self.check(TokenKind.NEWLINE) || self.check(TokenKind.SEMI)
    }

    // -- entry point -------------------------------------------------------

    fun parse_program(var self) -> Program {
        var decls: [Decl] = []
        self.skip_separators()
        while !self.at_end() {
            let start = self.pos
            let d = self.declaration()
            if !self.recovered(start, SYNC_DECL) {
                push(decls, d)
                self.terminate("declaration")
                self.recovered(start, SYNC_DECL)
            }
            if self.unwinding && !self.stopped {
                self.unwinding = false
                self.pos = self.resume
            }
            self.skip_separators()
        }
        return Program { decls: decls }
    }

    fun terminate(var self, what: str) {
        if self.at_separator() {
            self.skip_separators()
        } else if self.check(TokenKind.RBRACE) || self.at_end() {
            return
        } else {
            let tok = self.peek()
            self.fail_at(tok, format("expected end of {} (newline or ';'), found '{}'", what, tok.lexeme))
        }
    }

    // -- declarations ------------------------------------------------------

    fun declaration(var self) -> Decl {
        let attrs = self.attributes()
        var is_pub = false
        let pub_tok = self.peek()
        if self.check(TokenKind.PUB) {
            self.skip()
            is_pub = true
        }
        let tok = self.peek()
        let k = tok.kind
        if k == TokenKind.STRUCT || k == TokenKind.ACTOR {
            return self.struct_decl(attrs, is_pub)
        } else if k == TokenKind.FUN || (k == TokenKind.ASYNC && self.peek_kind_at(1) == TokenKind.FUN) {
            return self.fun_decl(attrs, is_pub)
        } else if k == TokenKind.ENUM {
            return self.enum_decl(attrs, is_pub)
        } else if k == TokenKind.IMPL {
            let d = self.impl_decl()
            if len(attrs) > 0 {
                self.fail_at(tok, "attributes are not allowed on an 'impl' block")
            } else if is_pub {
                self.fail_at(pub_tok, "'pub' is not allowed on an 'impl' block (visibility follows the implemented type)")
            }
            return d
        } else if k == TokenKind.TRAIT {
            return self.trait_decl(attrs, is_pub)
        } else if k == TokenKind.TYPEALIAS {
            return self.typealias_decl(attrs, is_pub)
        } else if k == TokenKind.CONST {
            return self.const_decl(attrs, is_pub)
        } else if k == TokenKind.IMPORT || k == TokenKind.FROM {
            let d = self.import_decl(is_pub)
            if len(attrs) > 0 {
                self.fail_at(tok, "attributes are not allowed on an import statement")
            }
            return d
        }
        self.fail_at(tok, format("expected a declaration (struct/actor/fun/enum/typealias/const/trait/impl/import), found '{}'", tok.lexeme))
        return self.mk_decl(0, 0, DeclKind.ImportDecl(ImportPath { line: 0, col: 0, sp: self.span_from(0, 0), dots: 0, segments: [] }, None, None, false))
    }

    fun import_decl(var self, is_pub: bool) -> Decl {
        let start = self.peek()
        if self.match1(TokenKind.FROM) {
            let path = self.import_path()
            self.expect(TokenKind.IMPORT, "'import' after the path in a 'from' import")
            var items: [ImportItem] = [self.import_item()]
            while self.match1(TokenKind.COMMA) {
                push(items, self.import_item())
            }
            return self.mk_decl(start.line, start.column, DeclKind.ImportDecl(path, Some(items), None, is_pub))
        }
        self.expect(TokenKind.IMPORT, "'import' or 'from'")
        let path = self.import_path()
        var alias: Option<str> = None
        if self.match1(TokenKind.AS) {
            alias = Some(self.expect(TokenKind.IDENT, "an alias name after 'as'").lexeme)
        }
        let no_alias = match alias { Some(a) => false, None => true }
        if is_pub && no_alias {
            self.fail_at(start, "a 'pub import' must bind a simple name: add 'as <name>' (the full path cannot be re-exported directly)")
        }
        return self.mk_decl(start.line, start.column, DeclKind.ImportDecl(path, None, alias, is_pub))
    }

    fun import_path(var self) -> ImportPath {
        let tok = self.peek()
        var dots = 0
        while self.check(TokenKind.DOT) || self.check(TokenKind.DOTDOT) {
            if self.peek_kind() == TokenKind.DOTDOT {
                dots = dots + 2
            } else {
                dots = dots + 1
            }
            self.skip()
        }
        var segments: [str] = [self.expect(TokenKind.IDENT, "a module path segment").lexeme]
        while self.match1(TokenKind.DOT) {
            push(segments, self.expect(TokenKind.IDENT, "a path segment after '.'").lexeme)
        }
        return ImportPath { line: tok.line, col: tok.column, sp: self.span_from(tok.line, tok.column), dots: dots, segments: segments }
    }

    fun import_item(var self) -> ImportItem {
        let tok = self.expect(TokenKind.IDENT, "an imported name")
        var alias: Option<str> = None
        if self.match1(TokenKind.AS) {
            alias = Some(self.expect(TokenKind.IDENT, "an alias name after 'as'").lexeme)
        }
        return ImportItem { line: tok.line, col: tok.column, sp: self.span_from(tok.line, tok.column), name: tok.lexeme, alias: alias }
    }

    fun attributes(var self) -> [Attribute] {
        var attrs: [Attribute] = []
        while self.check(TokenKind.HASH) {
            let hash_tok = self.advance()
            let name = self.expect(TokenKind.IDENT, "attribute name after '#'").lexeme
            var args: [Expr] = []
            var outputs: Option<[Expr]> = None
            if self.match1(TokenKind.LPAREN) {
                args = self.expr_list(TokenKind.RPAREN)
                self.expect(TokenKind.RPAREN, "')'")
            }
            if self.match1(TokenKind.LBRACKET) {
                outputs = Some(self.expr_list(TokenKind.RBRACKET))
                self.expect(TokenKind.RBRACKET, "']'")
            }
            push(attrs, Attribute { line: hash_tok.line, col: hash_tok.column, sp: self.span_from(hash_tok.line, hash_tok.column), name: name, args: args, outputs: outputs })
            self.skip_newlines()
        }
        return attrs
    }

    fun generics(var self) -> [TypeParam] {
        var params: [TypeParam] = []
        if !self.check(TokenKind.LT) {
            return params
        }
        self.skip()
        while true {
            let tok = self.expect(TokenKind.IDENT, "type parameter name")
            var bounds: [str] = []
            if self.match1(TokenKind.COLON) {
                push(bounds, self.expect(TokenKind.IDENT, "trait name in type-parameter bound").lexeme)
                while self.match1(TokenKind.PLUS) {
                    push(bounds, self.expect(TokenKind.IDENT, "trait name after '+'").lexeme)
                }
            }
            push(params, TypeParam { line: tok.line, col: tok.column, sp: self.span_from(tok.line, tok.column), name: tok.lexeme, bounds: bounds })
            if !self.match1(TokenKind.COMMA) {
                break
            }
        }
        self.expect(TokenKind.GT, "'>' to close type parameters")
        if len(params) == 0 {
            self.fail_at(self.peek(), "empty type-parameter list")    // unreachable: a name is expected first
        }
        return params
    }

    fun generics_no_bounds(var self, where: str) -> [TypeParam] {
        let ps = self.generics()
        for p in ps {
            if len(p.bounds) > 0 {
                self.fail_at(self.peek(), format("type-parameter bounds are not supported on {}", where))
            }
        }
        return ps
    }

    fun struct_decl(var self, attrs: [Attribute], is_pub: bool) -> Decl {
        let kw = self.advance()    // struct / actor
        let is_actor = kw.kind == TokenKind.ACTOR
        var what = "struct name"
        if is_actor { what = "actor name" }
        let name = self.expect(TokenKind.IDENT, what).lexeme
        let tps = self.generics_no_bounds("a struct")
        self.expect(TokenKind.LBRACE, "'{'")
        self.skip_newlines()
        var fields: [Field] = []
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            let fname = self.expect(TokenKind.IDENT, "field name")
            self.expect(TokenKind.COLON, "':'")
            let ftype = self.parse_type()
            push(fields, Field { line: fname.line, col: fname.column, sp: self.span_from(fname.line, fname.column), name: fname.lexeme, ty: ftype })
            if !self.match1(TokenKind.COMMA) {
                self.skip_newlines()
                break
            }
            self.skip_newlines()
        }
        self.expect(TokenKind.RBRACE, "'}'")
        return self.mk_decl(kw.line, kw.column, DeclKind.StructDecl(name, fields, attrs, tps, is_pub, is_actor))
    }

    fun enum_decl(var self, attrs: [Attribute], is_pub: bool) -> Decl {
        let kw = self.advance()
        let name = self.expect(TokenKind.IDENT, "enum name").lexeme
        let tps = self.generics_no_bounds("an enum")
        self.expect(TokenKind.LBRACE, "'{'")
        self.skip_newlines()
        var variants: [Variant] = []
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            let vname = self.expect(TokenKind.IDENT, "variant name")
            var payload: [TypeExpr] = []
            if self.match1(TokenKind.LPAREN) {
                push(payload, self.parse_type())
                while self.match1(TokenKind.COMMA) {
                    if self.check(TokenKind.RPAREN) {
                        break
                    }
                    push(payload, self.parse_type())
                }
                self.expect(TokenKind.RPAREN, "')'")
            }
            push(variants, Variant { line: vname.line, col: vname.column, sp: self.span_from(vname.line, vname.column), name: vname.lexeme, payload: payload })
            if self.match1(TokenKind.COMMA) {
                self.skip_newlines()
            } else {
                self.skip_newlines()
            }
        }
        self.expect(TokenKind.RBRACE, "'}'")
        return self.mk_decl(kw.line, kw.column, DeclKind.EnumDecl(name, variants, attrs, tps, is_pub))
    }

    fun fun_decl(var self, attrs: [Attribute], is_pub: bool) -> Decl {
        let kw = self.advance()    // fun, or async before it
        let is_async = kw.kind == TokenKind.ASYNC
        if is_async { self.skip() }
        let name = self.expect(TokenKind.IDENT, "function name").lexeme
        let tps = self.generics()
        self.expect(TokenKind.LPAREN, "'('")
        var params: [Param] = []
        if !self.check(TokenKind.RPAREN) {
            while true {
                let pname = self.expect(TokenKind.IDENT, "parameter name")
                self.expect(TokenKind.COLON, "':'")
                let ptype = self.parse_type()
                push(params, Param { line: pname.line, col: pname.column, sp: self.span_from(pname.line, pname.column), name: pname.lexeme, ty: Some(ptype) })
                if !self.match1(TokenKind.COMMA) {
                    break
                }
            }
        }
        self.expect(TokenKind.RPAREN, "')'")
        var ret: Option<TypeExpr> = None
        if self.match1(TokenKind.ARROW) {
            ret = Some(self.parse_type())
        }
        let body = self.block()
        let fd = FunData {
            line: kw.line, col: kw.column, sp: self.span_from(kw.line, kw.column), name: name, params: params,
            ret_type: ret, body: Some(body), attributes: attrs,
            type_params: tps, receiver: None, is_pub: is_pub, is_async: is_async,
        }
        return self.mk_decl(kw.line, kw.column, DeclKind.FunDecl(fd))
    }

    fun impl_decl(var self) -> Decl {
        let kw = self.advance()
        let tps = self.generics()
        let first = self.parse_type()
        var trait_name: Option<str> = None
        var trait_args: [TypeExpr] = []
        var target = first
        if self.match1(TokenKind.FOR) {
            match first.kind {
                TypeKind.TRef(nm, args) => {
                    trait_name = Some(nm)
                    trait_args = args
                },
                _ => { self.fail_at(kw, "the trait in 'impl Trait for T' must be a (possibly generic) trait name") },
            }
            target = self.parse_type()
        }
        self.expect(TokenKind.LBRACE, "'{' to begin impl block")
        self.skip_separators()
        var methods: [FunData] = []
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            if self.leaves_body(true) { break }
            let start = self.pos
            let attrs = self.attributes()     // `#test` cases of a method (D116)
            if self.at_method() {
                push(methods, self.method_decl(attrs))
            } else {
                let tok = self.peek()
                self.fail_at(tok, format("expected a method ('fun ...') in impl block, found '{}'", tok.lexeme))
            }
            self.member_recovered(start, true)
            self.skip_separators()
        }
        self.expect(TokenKind.RBRACE, "'}' to close impl block")
        return self.mk_decl(kw.line, kw.column, DeclKind.ImplDecl(target, methods, tps, trait_name, trait_args))
    }

    fun trait_decl(var self, attrs: [Attribute], is_pub: bool) -> Decl {
        let kw = self.advance()
        let name = self.expect(TokenKind.IDENT, "trait name").lexeme
        let tps = self.generics_no_bounds("a trait")
        self.expect(TokenKind.LBRACE, "'{' to begin trait body")
        self.skip_separators()
        var methods: [FunData] = []
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            if self.leaves_body(false) { break }
            let start = self.pos
            if self.at_method() {
                push(methods, self.method_sig())
            } else {
                let tok = self.peek()
                self.fail_at(tok, format("expected a method signature ('fun ...') in trait body, found '{}'", tok.lexeme))
            }
            self.member_recovered(start, false)
            self.skip_separators()
        }
        self.expect(TokenKind.RBRACE, "'}' to close trait body")
        return self.mk_decl(kw.line, kw.column, DeclKind.TraitDecl(name, methods, tps, is_pub))
    }

    // Before a member of an impl or trait body (parser.py: _member): after an
    // error, a line starting another declaration, or one at column 1, leaves
    // the body (unwinding). In an impl body a member may start with `#`.
    fun leaves_body(var self, attributes: bool) -> bool {
        let tok = self.peek()
        if self.resuming_at_declaration() && (!starts_member(tok.kind, attributes) || tok.column == 1) {
            self.unwind()
            return true
        }
        return false
    }

    // After a member parsed from `start`: recover from its error; a method
    // whose block unwound to a `fun` (not at column 1) is followed by the next
    // member.
    fun member_recovered(var self, start: int32, attributes: bool) {
        self.recovered(start, SYNC_MEMBER)
        if self.unwinding && !self.stopped {
            let at = self.toks[self.resume]
            if starts_member(at.kind, attributes) && at.column > 1 {
                self.unwinding = false
                self.pos = self.resume
            }
        }
    }

    // At `fun`, or `async fun` (D89).
    fun at_method(self) -> bool {
        let k = self.peek_kind()
        return k == TokenKind.FUN || (k == TokenKind.ASYNC && self.peek_kind_at(1) == TokenKind.FUN)
    }

    // Returns a FunData with body filled by the caller (method vs signature).
    fun method_header(var self) -> FunData {
        let kw = self.advance()    // fun, or async before it
        let is_async = kw.kind == TokenKind.ASYNC
        if is_async { self.skip() }
        let name = self.expect(TokenKind.IDENT, "method name").lexeme
        let tps = self.generics()
        self.expect(TokenKind.LPAREN, "'('")
        var receiver: Option<str> = None
        if self.match1(TokenKind.VAR) {
            self.expect(TokenKind.SELF, "'self' after 'var' in method receiver")
            receiver = Some("var self")
        } else if self.match1(TokenKind.SELF) {
            receiver = Some("self")
        } else {
            self.fail_at(self.peek(), "a method's first parameter must be 'self' or 'var self'")
        }
        var params: [Param] = []
        // no trailing comma, as in a function's parameter list (MYLA-180)
        while self.match1(TokenKind.COMMA) {
            let pname = self.expect(TokenKind.IDENT, "parameter name")
            self.expect(TokenKind.COLON, "':'")
            let ptype = self.parse_type()
            push(params, Param { line: pname.line, col: pname.column, sp: self.span_from(pname.line, pname.column), name: pname.lexeme, ty: Some(ptype) })
        }
        self.expect(TokenKind.RPAREN, "')'")
        var ret: Option<TypeExpr> = None
        if self.match1(TokenKind.ARROW) {
            ret = Some(self.parse_type())
        }
        return FunData {
            line: kw.line, col: kw.column, sp: self.span_from(kw.line, kw.column), name: name, params: params,
            ret_type: ret, body: None, attributes: [],
            type_params: tps, receiver: receiver, is_pub: false, is_async: is_async,
        }
    }

    fun method_decl(var self, attrs: [Attribute]) -> FunData {
        let h = self.method_header()
        let body = self.block()
        // Rebuild rather than mutate `h.body`: the native backend does not yet
        // support assigning a ref-counted aggregate into a struct field.
        return FunData {
            line: h.line, col: h.col, sp: self.span_from(h.line, h.col), name: h.name, params: h.params,
            ret_type: h.ret_type, body: Some(body), attributes: attrs,
            type_params: h.type_params, receiver: h.receiver, is_pub: h.is_pub, is_async: h.is_async,
        }
    }

    fun method_sig(var self) -> FunData {
        return self.method_header()
    }

    fun typealias_decl(var self, attrs: [Attribute], is_pub: bool) -> Decl {
        let kw = self.advance()
        let name = self.expect(TokenKind.IDENT, "alias name").lexeme
        self.expect(TokenKind.ASSIGN, "'='")
        let target = self.parse_type()
        return self.mk_decl(kw.line, kw.column, DeclKind.TypeAliasDecl(name, target, attrs, is_pub))
    }

    fun const_decl(var self, attrs: [Attribute], is_pub: bool) -> Decl {
        let kw = self.advance()
        let name = self.expect(TokenKind.IDENT, "constant name").lexeme
        self.expect(TokenKind.COLON, "':' (a const requires an explicit type)")
        let declared = self.parse_type()
        self.expect(TokenKind.ASSIGN, "'=' in const declaration")
        let value = self.expression()
        return self.mk_decl(kw.line, kw.column, DeclKind.ConstDecl(name, declared, value, attrs, is_pub))
    }

    // -- types -------------------------------------------------------------

    fun parse_type(var self) -> TypeExpr {
        self.enter("type")
        let t = self.parse_type_inner()
        self.depth = self.depth - 1
        return t
    }

    fun parse_type_inner(var self) -> TypeExpr {
        let tok = self.peek()
        let k = tok.kind
        if k == TokenKind.ASYNC {
            // `async (T, …) -> R` (D89)
            self.skip()
            if !self.check(TokenKind.LPAREN) {
                let at = self.peek()
                self.fail_at(at, format("expected a function type after 'async', found '{}'", at.lexeme))
                return self.mk_type(tok.line, tok.column, TypeKind.TRef("", []))
            }
            let ft = self.paren_type()
            match ft.kind {
                TypeKind.TFn(ps, r, a) => { return self.mk_type(tok.line, tok.column, TypeKind.TFn(ps, r, true)) },
                _ => {
                    self.fail_at(tok, "only a function type can be 'async'")
                    return ft
                },
            }
        }
        if k == TokenKind.LPAREN {
            return self.paren_type()
        }
        if k == TokenKind.LBRACKET {
            self.skip()
            let first = self.parse_type()
            if self.match1(TokenKind.COLON) {
                let value = self.parse_type()
                self.expect(TokenKind.RBRACKET, "']' to close map type")
                return self.mk_type(tok.line, tok.column, TypeKind.TMap(first, value))
            }
            self.expect(TokenKind.RBRACKET, "']' to close list type")
            return self.mk_type(tok.line, tok.column, TypeKind.TList(first))
        }
        if self.is_prim_type(k) {
            self.skip()
            return self.mk_type(tok.line, tok.column, TypeKind.TRef(tok.lexeme, []))
        }
        if k == TokenKind.IDENT {
            self.skip()
            let args = self.type_args()
            return self.mk_type(tok.line, tok.column, TypeKind.TRef(tok.lexeme, args))
        }
        self.fail_at(tok, format("expected a type, found '{}'", tok.lexeme))
        return self.mk_type(tok.line, tok.column, TypeKind.TRef("", []))
    }

    fun is_prim_type(self, k: TokenKind) -> bool {
        return k == TokenKind.BOOL || k == TokenKind.STR || k == TokenKind.INT8 || k == TokenKind.INT16 || k == TokenKind.INT32 || k == TokenKind.INT64 || k == TokenKind.UINT8 || k == TokenKind.UINT16 || k == TokenKind.UINT32 || k == TokenKind.UINT64
    }

    fun type_args(var self) -> [TypeExpr] {
        var args: [TypeExpr] = []
        if !self.check(TokenKind.LT) {
            return args
        }
        self.skip()
        push(args, self.parse_type())
        while self.match1(TokenKind.COMMA) {
            push(args, self.parse_type())
        }
        if self.check(TokenKind.GE) {
            // `Option<int>= x`: the `>=` token closes the list and leaves its
            // `=` behind (MYLA-15)
            let ge = self.peek()
            self.toks[self.pos] = Token { kind: TokenKind.ASSIGN, lexeme: "=", line: ge.line, column: ge.column + 1, eline: ge.eline, ecol: ge.ecol, ival: 0, suffix: "", big: "" }
            return args
        }
        self.expect(TokenKind.GT, "'>' to close type arguments")
        return args
    }

    fun paren_type(var self) -> TypeExpr {
        let lp = self.advance()
        var params: [TypeExpr] = []
        var saw_comma = false
        if !self.check(TokenKind.RPAREN) {
            push(params, self.parse_type())
            while self.match1(TokenKind.COMMA) {
                saw_comma = true
                if self.check(TokenKind.RPAREN) {
                    break
                }
                push(params, self.parse_type())
            }
        }
        self.expect(TokenKind.RPAREN, "')'")
        if self.match1(TokenKind.ARROW) {
            let ret = self.parse_type()
            return self.mk_type(lp.line, lp.column, TypeKind.TFn(params, ret, false))
        }
        if len(params) == 0 {
            self.fail_at(lp, "'()' is only valid as a function type '() -> R'")
        }
        if !saw_comma {
            self.fail_at(self.peek(), "expected ',' in tuple type (use '(T,)' for a 1-tuple)")
        }
        return self.mk_type(lp.line, lp.column, TypeKind.TTuple(params))
    }

    // -- statements --------------------------------------------------------

    fun block(var self) -> Block {
        self.enter("block")
        let b = self.block_inner()
        self.depth = self.depth - 1
        return b
    }

    fun block_inner(var self) -> Block {
        let lbrace = self.expect(TokenKind.LBRACE, "'{'")
        var stmts: [Stmt] = []
        self.skip_separators()
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            if self.resuming_at_declaration() {
                self.unwind()
                break
            }
            let start = self.pos
            let st = self.statement()
            if !self.recovered(start, SYNC_STMT) {
                push(stmts, st)
                if self.at_separator() {
                    self.skip_separators()
                } else if self.check(TokenKind.RBRACE) {
                    break
                } else {
                    let tok = self.peek()
                    self.fail_at(tok, format("expected newline, ';' or '}}', found '{}'", tok.lexeme))
                    self.recovered(start, SYNC_STMT)
                }
            }
            self.skip_separators()
        }
        self.expect(TokenKind.RBRACE, "'}'")
        return Block { line: lbrace.line, col: lbrace.column, sp: self.span_from(lbrace.line, lbrace.column), stmts: stmts }
    }

    fun statement(var self) -> Stmt {
        let k = self.peek_kind()
        if k == TokenKind.LET || k == TokenKind.VAR {
            return self.var_decl()
        }
        if k == TokenKind.IF {
            return self.if_stmt()
        }
        if k == TokenKind.WHILE {
            return self.while_stmt()
        }
        if k == TokenKind.FOR {
            return self.for_stmt()
        }
        if k == TokenKind.RETURN {
            return self.return_stmt()
        }
        if k == TokenKind.ASYNC && self.peek_kind_at(1) == TokenKind.LET {
            return self.async_let()
        }
        if k == TokenKind.BECOME {
            let kw = self.advance()
            let value = self.expression()
            return self.mk_stmt(kw.line, kw.column, StmtKind.ReturnS(Some(value), true))
        }
        if k == TokenKind.BREAK {
            let tok = self.advance()
            return self.mk_stmt(tok.line, tok.column, StmtKind.BreakS)
        }
        if k == TokenKind.CONTINUE {
            let tok = self.advance()
            return self.mk_stmt(tok.line, tok.column, StmtKind.ContinueS)
        }
        return self.assign_or_expr()
    }

    fun var_decl(var self) -> Stmt {
        let kw = self.advance()
        let kind = kw.lexeme
        if self.check(TokenKind.LPAREN) {
            let lp = self.peek()
            let elems = self.tuple_binding()
            let binding = BindElem.BTuple(elems, lp.line, lp.column, self.span_from(lp.line, lp.column))
            var ty: Option<TypeExpr> = None
            if self.match1(TokenKind.COLON) {
                ty = Some(self.parse_type())
            }
            self.expect(TokenKind.ASSIGN, "'=' in variable declaration")
            let init = self.expression()
            return self.mk_stmt(kw.line, kw.column, StmtKind.DestructDecl(kind, binding, ty, init))
        }
        let name = self.expect(TokenKind.IDENT, "variable name").lexeme
        var ty: Option<TypeExpr> = None
        if self.match1(TokenKind.COLON) {
            ty = Some(self.parse_type())
        }
        self.expect(TokenKind.ASSIGN, "'=' in variable declaration")
        let init = self.expression()
        return self.mk_stmt(kw.line, kw.column, StmtKind.VarDecl(kind, name, ty, init))
    }

    // `async let name = e` (D89): a child task, its result read with `await name`.
    fun async_let(var self) -> Stmt {
        let kw = self.advance()    // async
        self.skip()                // let
        let name = self.expect(TokenKind.IDENT, "name of the 'async let'").lexeme
        var ty: Option<TypeExpr> = None
        if self.match1(TokenKind.COLON) {
            ty = Some(self.parse_type())
        }
        self.expect(TokenKind.ASSIGN, "'=' in 'async let'")
        let init = self.expression()
        return self.mk_stmt(kw.line, kw.column, StmtKind.VarDecl("async", name, ty, init))
    }

    fun tuple_binding(var self) -> [BindElem] {
        self.skip()
        var elems: [BindElem] = [self.binding_elem()]
        if !self.match1(TokenKind.COMMA) {
            self.fail_at(self.peek(), "expected ',' in destructuring binding (use '(x,)' for a 1-tuple)")
        }
        while !self.check(TokenKind.RPAREN) {
            push(elems, self.binding_elem())
            if !self.match1(TokenKind.COMMA) {
                break
            }
        }
        self.expect(TokenKind.RPAREN, "')'")
        return elems
    }

    fun binding_elem(var self) -> BindElem {
        let tok = self.peek()
        if tok.kind == TokenKind.LPAREN {
            let elems = self.tuple_binding()
            return BindElem.BTuple(elems, tok.line, tok.column, self.span_from(tok.line, tok.column))
        }
        if tok.kind == TokenKind.IDENT {
            self.skip()
            if tok.lexeme == "_" {
                return BindElem.BWild
            }
            return BindElem.BName(tok.lexeme, tok.line, tok.column, self.span_from(tok.line, tok.column))
        }
        self.fail_at(tok, format("expected a binding name, '_', or '(', found '{}'", tok.lexeme))
        return BindElem.BWild
    }

    fun if_stmt(var self) -> Stmt {
        let kw = self.advance()
        let cond = self.expression_ns()
        let then = self.block()
        var otherwise: Option<ElseTail> = None
        let saved = self.pos
        self.skip_newlines()
        if self.match1(TokenKind.ELSE) {
            if self.check(TokenKind.IF) {
                otherwise = Some(ElseTail.ElseIf(self.if_stmt()))
            } else {
                otherwise = Some(ElseTail.ElseBlock(self.block()))
            }
        } else {
            self.pos = saved
        }
        return self.mk_stmt(kw.line, kw.column, StmtKind.IfS(cond, then, otherwise))
    }

    fun while_stmt(var self) -> Stmt {
        let kw = self.advance()
        let cond = self.expression_ns()
        let body = self.block()
        return self.mk_stmt(kw.line, kw.column, StmtKind.WhileS(cond, body))
    }

    fun for_stmt(var self) -> Stmt {
        let kw = self.advance()
        let v = self.expect(TokenKind.IDENT, "loop variable name").lexeme
        self.expect(TokenKind.IN, "'in'")
        let first = self.expression_ns()
        if self.match1(TokenKind.DOTDOT) {
            let end = self.expression_ns()
            let body = self.block()
            return self.mk_stmt(kw.line, kw.column, StmtKind.ForS(v, Some(first), Some(end), body, None))
        }
        let body = self.block()
        return self.mk_stmt(kw.line, kw.column, StmtKind.ForS(v, None, None, body, Some(first)))
    }

    fun return_stmt(var self) -> Stmt {
        let kw = self.advance()
        if self.at_separator() || self.check(TokenKind.RBRACE) || self.at_end() {
            return self.mk_stmt(kw.line, kw.column, StmtKind.ReturnS(None, false))
        }
        let st = self.peek()
        var value = self.expression()
        if self.check(TokenKind.COMMA) {
            let vl = value.line
            let vc = value.col
            var elems: [Expr] = [value]
            while self.match1(TokenKind.COMMA) {
                push(elems, self.expression())
            }
            value = self.mk_expr_from(st, vl, vc, ExprKind.TupleLit(elems))
        }
        return self.mk_stmt(kw.line, kw.column, StmtKind.ReturnS(Some(value), false))
    }

    fun assign_or_expr(var self) -> Stmt {
        let st = self.peek()
        let expr = self.expression()
        if self.check(TokenKind.ASSIGN) {
            let eq = self.advance()
            if !is_lvalue(expr) {
                self.fail(expr.line, expr.col, expr.sp, "invalid assignment target")
            }
            let value = self.expression()
            return self.mk_stmt_from(st, eq.line, eq.column, StmtKind.Assign(expr, value))
        }
        return self.mk_stmt_from(st, expr.line, expr.col, StmtKind.ExprStmt(expr))
    }

    // -- expressions (precedence climbing) ---------------------------------

    fun expression(var self) -> Expr {
        return self.expression_with(true)
    }

    fun expression_ns(var self) -> Expr {
        return self.expression_with(false)
    }

    fun expression_with(var self, allow: bool) -> Expr {
        let prev = self.allow_struct_lit
        self.allow_struct_lit = allow
        self.enter("expression")
        let e = self.pipe()
        self.depth = self.depth - 1
        self.allow_struct_lit = prev
        return e
    }

    fun pipe(var self) -> Expr {
        let st = self.peek()
        var expr = self.logic_or()
        while self.check(TokenKind.PIPEGT) {
            let op = self.advance()
            let rhs = self.logic_or()
            let spliced = match rhs.kind {
                ExprKind.Call(callee, args) => ExprKind.Call(callee, cons_expr(expr, args)),
                _ => ExprKind.Call(rhs, [expr]),
            }
            expr = self.mk_expr_from(st, op.line, op.column, spliced)
        }
        return expr
    }

    fun logic_or(var self) -> Expr {
        let st = self.peek()
        var expr = self.logic_and()
        while self.check(TokenKind.OR) {
            let op = self.advance()
            let right = self.logic_and()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun logic_and(var self) -> Expr {
        let st = self.peek()
        var expr = self.equality()
        while self.check(TokenKind.AND) {
            let op = self.advance()
            let right = self.equality()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun equality(var self) -> Expr {
        let st = self.peek()
        var expr = self.comparison()
        while self.check(TokenKind.EQ) || self.check(TokenKind.NE) {
            let op = self.advance()
            let right = self.comparison()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun comparison(var self) -> Expr {
        let st = self.peek()
        var expr = self.bit_or()
        while self.check(TokenKind.LT) || self.check(TokenKind.LE) || self.check(TokenKind.GT) || self.check(TokenKind.GE) {
            let op = self.advance()
            let right = self.bit_or()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun bit_or(var self) -> Expr {
        let st = self.peek()
        var expr = self.bit_xor()
        while self.check(TokenKind.PIPE) {
            let op = self.advance()
            let right = self.bit_xor()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun bit_xor(var self) -> Expr {
        let st = self.peek()
        var expr = self.bit_and()
        while self.check(TokenKind.CARET) {
            let op = self.advance()
            let right = self.bit_and()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun bit_and(var self) -> Expr {
        let st = self.peek()
        var expr = self.shift()
        while self.check(TokenKind.AMP) {
            let op = self.advance()
            let right = self.shift()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun adjacent_shift(self) -> str {
        let a = self.peek()
        let b = self.peek_at(1)
        if a.line != b.line || b.column != a.column + 1 {
            return ""
        }
        if a.kind == TokenKind.LT && b.kind == TokenKind.LT {
            return "<<"
        }
        if a.kind == TokenKind.GT && b.kind == TokenKind.GT {
            return ">>"
        }
        return ""
    }

    fun shift(var self) -> Expr {
        let st = self.peek()
        var expr = self.term()
        while true {
            let op = self.adjacent_shift()
            if op == "" {
                return expr
            }
            let a = self.peek()
            self.skip()
            self.skip()
            let right = self.term()
            expr = self.mk_expr_from(st, a.line, a.column, ExprKind.Binary(op, expr, right))
        }
        return expr
    }

    fun term(var self) -> Expr {
        let st = self.peek()
        var expr = self.factor()
        while self.check(TokenKind.PLUS) || self.check(TokenKind.MINUS) {
            let op = self.advance()
            let right = self.factor()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun factor(var self) -> Expr {
        let st = self.peek()
        var expr = self.cast()
        while self.check(TokenKind.STAR) || self.check(TokenKind.SLASH) || self.check(TokenKind.PERCENT) {
            let op = self.advance()
            let right = self.cast()
            expr = self.mk_expr_from(st, op.line, op.column, ExprKind.Binary(op.lexeme, expr, right))
        }
        return expr
    }

    fun cast(var self) -> Expr {
        let st = self.peek()
        var expr = self.unary()
        while self.check(TokenKind.AS) {
            let kw = self.advance()
            let target = self.parse_type()
            expr = self.mk_expr_from(st, kw.line, kw.column, ExprKind.Cast(expr, target))
        }
        return expr
    }

    fun unary(var self) -> Expr {
        let k = self.peek_kind()
        if k == TokenKind.AWAIT {
            let kw = self.advance()
            self.enter("expression")
            let operand = self.unary()
            self.depth = self.depth - 1
            return self.mk_expr(kw.line, kw.column, ExprKind.Await(operand))
        }
        if k == TokenKind.MINUS || k == TokenKind.BANG || k == TokenKind.TILDE {
            let op = self.advance()
            self.enter("expression")
            let operand = self.unary()
            self.depth = self.depth - 1
            return self.mk_expr(op.line, op.column, ExprKind.Unary(op.lexeme, operand))
        }
        return self.postfix()
    }

    fun postfix(var self) -> Expr {
        let st = self.peek()
        var expr = self.primary()
        while true {
            if self.check(TokenKind.LPAREN) {
                let lp = self.advance()
                let args = self.call_args()
                self.expect(TokenKind.RPAREN, "')'")
                expr = self.mk_expr_from(st, lp.line, lp.column, ExprKind.Call(expr, args))
            } else if self.check(TokenKind.LBRACKET) {
                let lb = self.advance()
                let index = self.expression()
                self.expect(TokenKind.RBRACKET, "']' to close index")
                expr = self.mk_expr_from(st, lb.line, lb.column, ExprKind.Index(expr, index))
            } else if self.check(TokenKind.DOT) {
                let dot = self.advance()
                if self.check(TokenKind.INT) {
                    let idx_tok = self.advance()
                    if idx_tok.suffix != "" {
                        self.fail_at(idx_tok, "tuple index may not have a type suffix")
                    }
                    expr = self.mk_expr_from(st, dot.line, dot.column, ExprKind.TupleIndex(expr, idx_tok.ival))
                } else {
                    let name = self.expect(TokenKind.IDENT, "field name or tuple index after '.'").lexeme
                    expr = self.mk_expr_from(st, dot.line, dot.column, ExprKind.GetField(expr, name))
                }
            } else if self.check(TokenKind.QUESTION) {
                let q = self.advance()
                expr = self.mk_expr_from(st, q.line, q.column, ExprKind.Try(expr))
            } else {
                break
            }
        }
        return expr
    }

    fun primary(var self) -> Expr {
        let tok = self.peek()
        let k = tok.kind
        if k == TokenKind.INT {
            self.skip()
            return self.mk_expr(tok.line, tok.column, ExprKind.IntLit(tok.ival, suffix_opt(tok.suffix), false, tok.big))
        }
        if k == TokenKind.FLOAT {
            self.skip()
            return self.mk_expr(tok.line, tok.column, ExprKind.FloatLit(tok.lexeme, suffix_opt(tok.suffix)))
        }
        if k == TokenKind.CHAR {
            self.skip()
            return self.mk_expr(tok.line, tok.column, ExprKind.IntLit(tok.ival, None, true, ""))
        }
        if k == TokenKind.STRING {
            self.skip()
            return self.mk_expr(tok.line, tok.column, ExprKind.StrLit(tok.lexeme))
        }
        if k == TokenKind.TRUE {
            self.skip()
            return self.mk_expr(tok.line, tok.column, ExprKind.BoolLit(true))
        }
        if k == TokenKind.FALSE {
            self.skip()
            return self.mk_expr(tok.line, tok.column, ExprKind.BoolLit(false))
        }
        if k == TokenKind.IDENT {
            self.skip()
            if self.allow_struct_lit && self.check(TokenKind.LBRACE) {
                return self.struct_lit(tok)
            }
            return self.mk_expr(tok.line, tok.column, ExprKind.Name(tok.lexeme))
        }
        if k == TokenKind.SELF {
            self.skip()
            return self.mk_expr(tok.line, tok.column, ExprKind.Name("self"))
        }
        if k == TokenKind.MATCH {
            return self.match_expr()
        }
        if k == TokenKind.LPAREN {
            if self.lambda_ahead() {
                return self.lambda_expr()
            }
            return self.paren_or_tuple()
        }
        if k == TokenKind.ASYNC && self.peek_kind_at(1) == TokenKind.LPAREN {
            // `async (params) => body` (D89)
            self.skip()
            if !self.lambda_ahead() {
                self.fail_at(self.peek(), "expected a lambda after 'async'")
                return self.mk_expr(tok.line, tok.column, ExprKind.Hole)
            }
            let lam = self.lambda_expr()
            match lam.kind {
                ExprKind.Lambda(ps, r, body, a) => { return self.mk_expr(tok.line, tok.column, ExprKind.Lambda(ps, r, body, true)) },
                _ => { return lam },
            }
        }
        if k == TokenKind.LBRACKET {
            return self.list_or_map_lit()
        }
        self.fail_at(tok, format("expected an expression, found '{}'", tok.lexeme))
        return self.mk_expr(tok.line, tok.column, ExprKind.Hole)
    }

    fun list_or_map_lit(var self) -> Expr {
        let lb = self.advance()
        self.skip_newlines()
        if self.match1(TokenKind.COLON) {
            self.expect(TokenKind.RBRACKET, "']' to close empty map literal")
            return self.mk_expr(lb.line, lb.column, ExprKind.MapLit([]))
        }
        if self.check(TokenKind.RBRACKET) {
            self.skip()
            return self.mk_expr(lb.line, lb.column, ExprKind.ListLit([]))
        }
        let first = self.expression()
        if self.match1(TokenKind.COLON) {
            return self.map_lit_tail(lb, first)
        }
        return self.list_lit_tail(lb, first)
    }

    fun list_lit_tail(var self, lb: Token, first: Expr) -> Expr {
        var elems: [Expr] = [first]
        self.skip_newlines()
        while self.match1(TokenKind.COMMA) {
            self.skip_newlines()
            if self.check(TokenKind.RBRACKET) {
                break
            }
            push(elems, self.expression())
            self.skip_newlines()
        }
        self.expect(TokenKind.RBRACKET, "']' to close list literal")
        return self.mk_expr(lb.line, lb.column, ExprKind.ListLit(elems))
    }

    fun map_lit_tail(var self, lb: Token, first_key: Expr) -> Expr {
        let first_val = self.expression()
        var entries: [MapEntry] = [MapEntry { key: first_key, value: first_val }]
        self.skip_newlines()
        while self.match1(TokenKind.COMMA) {
            self.skip_newlines()
            if self.check(TokenKind.RBRACKET) {
                break
            }
            let key = self.expression()
            self.expect(TokenKind.COLON, "':' between map key and value")
            let val = self.expression()
            push(entries, MapEntry { key: key, value: val })
            self.skip_newlines()
        }
        self.expect(TokenKind.RBRACKET, "']' to close map literal")
        return self.mk_expr(lb.line, lb.column, ExprKind.MapLit(entries))
    }

    fun match_expr(var self) -> Expr {
        let kw = self.advance()
        let scrutinee = self.expression_ns()
        self.expect(TokenKind.LBRACE, "'{' to begin match arms")
        self.skip_newlines()
        var arms: [MatchArm] = []
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            let arm = self.match_arm()
            push(arms, arm)
            if self.match1(TokenKind.COMMA) {
                self.skip_newlines()
            } else if self.check(TokenKind.NEWLINE) {
                self.skip_newlines()
            } else {
                let is_block = match arm.body {
                    ExprOrBlock.EB_Block(b) => true,
                    _ => false,
                }
                if !is_block {
                    break
                }
            }
        }
        self.expect(TokenKind.RBRACE, "'}' to end match")
        if len(arms) == 0 {
            self.fail_at(kw, "match expression needs at least one arm")
        }
        return self.mk_expr(kw.line, kw.column, ExprKind.MatchE(scrutinee, arms))
    }

    fun match_arm(var self) -> MatchArm {
        let st = self.peek()
        let pattern = self.pattern()
        var guard: Option<Expr> = None
        if self.match1(TokenKind.IF) {
            guard = Some(self.expression_ns())
        }
        let arrow = self.expect(TokenKind.FATARROW, "'=>' after match pattern")
        var body: ExprOrBlock = ExprOrBlock.EB_Expr(self.mk_expr(0, 0, ExprKind.Hole))
        if self.check(TokenKind.LBRACE) {
            body = ExprOrBlock.EB_Block(self.block())
        } else {
            body = ExprOrBlock.EB_Expr(self.expression())
        }
        return MatchArm { line: arrow.line, col: arrow.column, sp: self.span_from(st.line, st.column), pattern: pattern, guard: guard, body: body }
    }

    fun pattern(var self) -> Pattern {
        self.enter("pattern")
        let p = self.pattern_inner()
        self.depth = self.depth - 1
        return p
    }

    fun pattern_inner(var self) -> Pattern {
        let first = self.base_pattern()
        if !self.check(TokenKind.PIPE) {
            return first
        }
        let pl = first.line
        let pc = first.col
        var alts: [Pattern] = [first]
        while self.match1(TokenKind.PIPE) {
            push(alts, self.base_pattern())
        }
        return self.mk_pat_from(first.sp.sline, first.sp.scol, pl, pc, PatternKind.POr(alts))
    }

    fun base_pattern(var self) -> Pattern {
        let tok = self.peek()
        let k = tok.kind
        if k == TokenKind.INT || k == TokenKind.CHAR || k == TokenKind.STRING || k == TokenKind.TRUE || k == TokenKind.FALSE {
            let lit = self.primary()
            return self.mk_pat(tok.line, tok.column, PatternKind.PLit(lit))
        }
        if k == TokenKind.MINUS {
            self.skip()
            let int_tok = self.expect(TokenKind.INT, "integer literal after '-' in pattern")
            let inner = self.mk_expr(int_tok.line, int_tok.column, ExprKind.IntLit(int_tok.ival, suffix_opt(int_tok.suffix), false, int_tok.big))
            let lit = self.mk_expr(tok.line, tok.column, ExprKind.Unary("-", inner))
            return self.mk_pat(tok.line, tok.column, PatternKind.PLit(lit))
        }
        if k == TokenKind.DOT {
            self.skip()
            let vtok = self.expect(TokenKind.IDENT, "variant name after '.'")
            return self.enum_pattern_tail(None, vtok, tok)
        }
        if k == TokenKind.LPAREN {
            return self.tuple_pattern()
        }
        if k == TokenKind.IDENT {
            return self.ident_pattern(tok)
        }
        self.fail_at(tok, format("expected a pattern, found '{}'", tok.lexeme))
        return self.mk_pat(tok.line, tok.column, PatternKind.PWild)
    }

    fun ident_pattern(var self, first: Token) -> Pattern {
        self.skip()
        if first.lexeme == "_" {
            return self.mk_pat(first.line, first.column, PatternKind.PWild)
        }
        if self.check(TokenKind.LBRACE) {
            return self.struct_pattern(first)
        }
        if self.check(TokenKind.DOT) {
            self.skip()
            let vtok = self.expect(TokenKind.IDENT, "variant name after '.'")
            return self.enum_pattern_tail(Some(first.lexeme), vtok, first)
        }
        if self.check(TokenKind.LPAREN) {
            return self.enum_pattern_tail(None, first, first)
        }
        return self.mk_pat(first.line, first.column, PatternKind.PBind(first.lexeme))
    }

    // The rest of an enum pattern whose variant name is `variant_tok`; it
    // started at `st` (`Enum`, `.` or the variant).
    fun enum_pattern_tail(var self, enum_name: Option<str>, variant_tok: Token, st: Token) -> Pattern {
        var elems: [Pattern] = []
        var has_payload = false
        if self.match1(TokenKind.LPAREN) {
            has_payload = true
            if !self.check(TokenKind.RPAREN) {
                push(elems, self.pattern())
                while self.match1(TokenKind.COMMA) {
                    if self.check(TokenKind.RPAREN) {
                        break
                    }
                    push(elems, self.pattern())
                }
            }
            self.expect(TokenKind.RPAREN, "')'")
        }
        return self.mk_pat_from(st.line, st.column, variant_tok.line, variant_tok.column, PatternKind.PEnum(enum_name, variant_tok.lexeme, elems, has_payload))
    }

    fun tuple_pattern(var self) -> Pattern {
        let lp = self.advance()
        var elems: [Pattern] = [self.pattern()]
        if !self.match1(TokenKind.COMMA) {
            self.fail_at(self.peek(), "expected ',' in tuple pattern (use '(p,)' for a 1-tuple)")
        }
        while !self.check(TokenKind.RPAREN) {
            push(elems, self.pattern())
            if !self.match1(TokenKind.COMMA) {
                break
            }
        }
        self.expect(TokenKind.RPAREN, "')'")
        return self.mk_pat(lp.line, lp.column, PatternKind.PTuple(elems))
    }

    fun struct_pattern(var self, name_tok: Token) -> Pattern {
        self.expect(TokenKind.LBRACE, "'{'")
        self.skip_newlines()
        var fields: [FieldPat] = []
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            let fname = self.expect(TokenKind.IDENT, "field name in struct pattern")
            var pat: Pattern = self.mk_pat(0, 0, PatternKind.PWild)
            if self.match1(TokenKind.COLON) {
                pat = self.pattern()
            } else {
                pat = self.mk_pat(fname.line, fname.column, PatternKind.PBind(fname.lexeme))
            }
            push(fields, FieldPat { line: fname.line, col: fname.column, sp: self.span_from(fname.line, fname.column), name: fname.lexeme, pattern: pat })
            if self.match1(TokenKind.COMMA) {
                self.skip_newlines()
            } else {
                self.skip_newlines()
                break
            }
        }
        self.expect(TokenKind.RBRACE, "'}'")
        return self.mk_pat(name_tok.line, name_tok.column, PatternKind.PStruct(name_tok.lexeme, fields))
    }

    fun lambda_ahead(self) -> bool {
        var depth = 0
        var i = self.pos
        let n = len(self.toks)
        while i < n {
            let k = self.toks[i].kind
            if k == TokenKind.LPAREN || k == TokenKind.LBRACKET || k == TokenKind.LBRACE {
                depth = depth + 1
            } else if k == TokenKind.RPAREN || k == TokenKind.RBRACKET || k == TokenKind.RBRACE {
                depth = depth - 1
                if depth == 0 {
                    let j = i + 1
                    return j < n && self.toks[j].kind == TokenKind.FATARROW
                }
            } else if k == TokenKind.EOF {
                return false
            }
            i = i + 1
        }
        return false
    }

    fun lambda_expr(var self) -> Expr {
        let lp = self.advance()
        var params: [Param] = []
        if !self.check(TokenKind.RPAREN) {
            while true {
                let pname = self.expect(TokenKind.IDENT, "lambda parameter name")
                var pty: Option<TypeExpr> = None
                if self.match1(TokenKind.COLON) {
                    pty = Some(self.parse_type())
                }
                push(params, Param { line: pname.line, col: pname.column, sp: self.span_from(pname.line, pname.column), name: pname.lexeme, ty: pty })
                if !self.match1(TokenKind.COMMA) {
                    break
                }
            }
        }
        self.expect(TokenKind.RPAREN, "')'")
        self.expect(TokenKind.FATARROW, "'=>' in lambda")
        var body: ExprOrBlock = ExprOrBlock.EB_Expr(self.mk_expr(0, 0, ExprKind.Hole))
        if self.check(TokenKind.LBRACE) {
            body = ExprOrBlock.EB_Block(self.block())
        } else {
            body = ExprOrBlock.EB_Expr(self.expression())
        }
        return self.mk_expr(lp.line, lp.column, ExprKind.Lambda(params, None, body, false))
    }

    fun paren_or_tuple(var self) -> Expr {
        let lp = self.advance()
        let first = self.expression()
        if !self.check(TokenKind.COMMA) {
            self.expect(TokenKind.RPAREN, "')'")
            return first
        }
        var elems: [Expr] = [first]
        self.skip()
        while !self.check(TokenKind.RPAREN) {
            push(elems, self.expression())
            if !self.match1(TokenKind.COMMA) {
                break
            }
        }
        self.expect(TokenKind.RPAREN, "')'")
        return self.mk_expr(lp.line, lp.column, ExprKind.TupleLit(elems))
    }

    fun struct_lit(var self, name_tok: Token) -> Expr {
        self.expect(TokenKind.LBRACE, "'{'")
        self.skip_newlines()
        var fields: [FieldInit] = []
        while !self.check(TokenKind.RBRACE) && !self.at_end() {
            let fname = self.expect(TokenKind.IDENT, "field name")
            self.expect(TokenKind.COLON, "':'")
            let value = self.expression()
            push(fields, FieldInit { line: fname.line, col: fname.column, sp: self.span_from(fname.line, fname.column), name: fname.lexeme, value: value })
            if !self.match1(TokenKind.COMMA) {
                self.skip_newlines()
                break
            }
            self.skip_newlines()
        }
        self.expect(TokenKind.RBRACE, "'}'")
        return self.mk_expr(name_tok.line, name_tok.column, ExprKind.StructLit(name_tok.lexeme, fields))
    }

    fun expr_list(var self, closing: TokenKind) -> [Expr] {
        var args: [Expr] = []
        self.skip_newlines()
        if self.check(closing) {
            return args
        }
        while true {
            push(args, self.expression())
            self.skip_newlines()
            if self.match1(TokenKind.COMMA) {
                self.skip_newlines()
            } else {
                break
            }
        }
        return args
    }

    fun call_args(var self) -> [Expr] {
        var args: [Expr] = []
        self.skip_newlines()
        if self.check(TokenKind.RPAREN) {
            return args
        }
        while true {
            if self.hole_ahead() {
                let tok = self.advance()
                push(args, self.mk_expr(tok.line, tok.column, ExprKind.Hole))
            } else {
                push(args, self.expression())
            }
            self.skip_newlines()
            if self.match1(TokenKind.COMMA) {
                self.skip_newlines()
            } else {
                break
            }
        }
        return args
    }

    fun hole_ahead(self) -> bool {
        let t = self.peek()
        if !(t.kind == TokenKind.IDENT && t.lexeme == "_") {
            return false
        }
        let k1 = self.peek_kind_at(1)
        return k1 == TokenKind.COMMA || k1 == TokenKind.RPAREN
    }
}

// The program `toks` spell, or its first parse error.
pub fun parse(toks: [Token]) -> Result<Program, Diag> {
    return match parse_ids(toks, 0) {
        Ok(parsed) => Ok(parsed.program),
        Err(ds) => Err(ds[0]),
    }
}

// A parsed module and the next unused node id.
pub struct Parsed { program: Program, next_id: int32 }

// Parse with node ids starting at `first_id`, so separately parsed modules
// (and the prelude) get ids unique across the whole program: the checker's
// type tables are keyed by node id (MYLA-30).
// Err: the parse errors, in the order found (MYLA-65, D80).
pub fun parse_ids(toks: [Token], first_id: int32) -> Result<Parsed, [Diag]> {
    var p = new_parser(toks)
    p.next_id = first_id
    let prog = p.parse_program()
    if len(p.errs) > 0 { return Err(p.errs) }
    return Ok(Parsed { program: prog, next_id: p.next_id })
}

// Lex and parse `src` (node ids from `first_id`): its lex error, or its parse
// errors.
pub fun parse_source_all(src: str, first_id: int32) -> Result<Parsed, [Diag]> {
    return match lex(src) {
        Ok(toks) => parse_ids(toks, first_id),
        Err(d) => Err([d]),
    }
}

// Lex and parse `src` (node ids from `first_id`): its first lex or parse error.
pub fun parse_source(src: str, first_id: int32) -> Result<Parsed, Diag> {
    return match parse_source_all(src, first_id) {
        Ok(p) => Ok(p),
        Err(ds) => Err(ds[0]),
    }
}

// Whether a token kind starts a member of an impl body (`fun`, or `#` before
// a method's `#test` cases, D116) or of a trait body (`fun`).
#test(TokenKind.HASH, true)[true]
#test(TokenKind.HASH, false)[false]
#test(TokenKind.FUN, false)[true]
fun starts_member(k: TokenKind, attributes: bool) -> bool {
    return k == TokenKind.FUN || (attributes && k == TokenKind.HASH)
}
