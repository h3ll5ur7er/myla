// diag.my -- diagnostics as the Python CLI prints them (MYLA-28):
//
//     type error: cannot concatenate 'str' with 'int32'
//       --> examples/bad.my:3:17
//       |
//     3 |     let x = "a" + 1
//       |             ^^^^^^^
//
// (src/myla/errors.py: MylaError.render). The carets underline the error's
// range on its line, to the end of the line when the range goes on (MYLA-65).
// The file is read again for the source line; without a position only the
// first line is printed. A report may carry the errors found after it (`more`,
// MYLA-65, D80): each is printed the same way, a blank line apart, then
// `error: aborting due to <n> previous errors` (src/myla/cli.py: report_text).
// An error's notes (MYLA-65) follow it: a note with the line it is about, a
// help line on its own.

from std.fs import read_to_string
from .tokens import Diag, Note, SrcSpan

// An error with the file it is in (`line` 0: no position; `sp` with `eline` 0:
// no range, one caret), the errors the same stage found after it (only the
// first error of a run has any) and its notes.
pub struct Report { kind: str, msg: str, path: str, line: int32, col: int32, sp: SrcSpan, more: [Report], notes: [Note] }

// The first of `rs` (not empty), with the others as its `more`.
pub fun chain(rs: [Report]) -> Report {
    var first = rs[0]
    var i = 1
    while i < rs.len() {
        first.more.push(rs[i])
        i = i + 1
    }
    return first
}

// `r` and its `more`, in order.
pub fun all_reports(r: Report) -> [Report] {
    var out = [r]
    for m in r.more { out.push(m) }
    return out
}

// `d` as `err <line> <col> <span> <kind>: <message>`, the line the differential
// test drivers print (the Python side builds it from its exception with
// canon.canonical_error).
pub fun canonical_err(d: Diag) -> str {
    return canonical(d.line, d.col, d.sp, split_kind(d.kind), d.msg)
}

#test(3, 7, SrcSpan { sline: 3, scol: 5, eline: 3, ecol: 9 }, "type", "m")["err 3 7 3:5-3:9 type: m"]
#test(3, 7, SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, "type", "m")["err 3 7 - type: m"]
pub fun canonical(line: int32, col: int32, sp: SrcSpan, kind: str, msg: str) -> str {
    var span = "-"
    if sp.eline > 0 { span = format("{}:{}-{}:{}", sp.sline, sp.scol, sp.eline, sp.ecol) }
    return format("err {} {} {} {}: {}", line, col, span, kind, msg)
}

// A note as the differential test drivers print it after its error:
// `<label> <line> <col> <span>: <message>`, `-` for a missing position or range
// (canon.canonical_note).
#test(Note { label: "note", msg: "here", line: 2, col: 5, sp: SrcSpan { sline: 2, scol: 5, eline: 2, ecol: 9 } })["note 2 5 2:5-2:9: here"]
#test(Note { label: "help", msg: "did you mean 'abc'?", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 } })["help - - -: did you mean 'abc'?"]
pub fun canonical_note(n: Note) -> str {
    if n.line == 0 { return format("{} - - -: {}", n.label, n.msg) }
    var span = "-"
    if n.sp.eline > 0 { span = format("{}:{}-{}:{}", n.sp.sline, n.sp.scol, n.sp.eline, n.sp.ecol) }
    return format("{} {} {} {}: {}", n.label, n.line, n.col, span, n.msg)
}

// The first word of `kind` ("parse" of "parse error").
#test("parse error")["parse"]
fun split_kind(kind: str) -> str {
    var sb = StringBuilder()
    for c in kind.chars() {
        if c == ' ' { return sb.build() }
        sb.append_byte(c as uint8)
    }
    return sb.build()
}

pub fun type_report(line: int32, col: int32, sp: SrcSpan, msg: str, path: str) -> Report {
    return Report { kind: "type error", msg: msg, path: path, line: line, col: col, sp: sp, more: [], notes: [] }
}

pub fun report(d: Diag, path: str) -> Report {
    return Report { kind: d.kind, msg: d.msg, path: path, line: d.line, col: d.col, sp: d.sp, more: [], notes: [] }
}

// Lex or parse errors `ds` (not empty) in the file `path`, as one report.
pub fun reports(ds: [Diag], path: str) -> Report {
    var rs: [Report] = []
    for d in ds { rs.push(report(d, path)) }
    return chain(rs)
}

// Line `n` (1-based) of `src`, if it has one.
#test("//~ type error: unknown name\nfun main() {\n    let x = y\n}\n", 3)[Some("    let x = y")]
#test("//~ type error: expects\nenum Shape { Circle(int), Rect(int, int), Empty }\nfun f() -> Shape {\n    return Shape.Rect(1)\n}\nfun main() {\n}\n", 4)[Some("    return Shape.Rect(1)")]
#test("//~ type error: string index must be an integer\n// Byte indexing uses an integer position, not a string.\n#main\nfun main() {\n    let s = \"ab\"\n    print(s[\"x\"] as int)\n}\n", 6)[Some("    print(s[\"x\"] as int)")]
fun source_line(src: str, n: int32) -> Option<str> {
    var line = 1
    var sb = StringBuilder()
    var i = 0
    // a byte-order mark the lexer skipped isn't shown (MYLA-178)
    if src.len() >= 3 && src[0] == 0xEFu8 && src[1] == 0xBBu8 && src[2] == 0xBFu8 { i = 3 }
    while i < src.len() {
        let c = src[i]
        if c == '\n' {
            if line == n { return Some(sb.build()) }
            line = line + 1
        } else if line == n {
            sb.append_byte(c)
        }
        i = i + 1
    }
    if line == n && sb.build().len() > 0 { return Some(sb.build()) }
    return None
}

// The columns to underline on `text`, line `line` of a diagnostic at column
// `col` with range `sp`: (first, one past the last). The range's part on that
// line, to the line's end when the range goes on, and always `col`
// (MylaError.caret_range).
#test("    x = 1 + y", 1, 7, SrcSpan { sline: 1, scol: 5, eline: 1, ecol: 14 })[(5, 14)]
#test("[1,\n    2] + y", 2, 8, SrcSpan { sline: 1, scol: 1, eline: 2, ecol: 11 })[(8, 11)]
#test("fun größe() {", 1, 1, SrcSpan { sline: 1, scol: 1, eline: 3, ecol: 2 })[(1, 14)]
#test("abc", 1, 2, SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 })[(2, 3)]
pub fun caret_range(text: str, line: int32, col: int32, sp: SrcSpan) -> (int32, int32) {
    var first = col
    var end = col + 1
    if sp.eline > 0 {
        if sp.sline == line { first = sp.scol }
        if sp.eline == line { end = sp.ecol } else { end = text.chars().len() as int32 + 1 }
    }
    if first > col { first = col }
    if end < col + 1 { end = col + 1 }
    return (first, end)
}

// The caret line under `text` (see caret_range).
#test("let x = 1", 1, 5, SrcSpan { sline: 1, scol: 5, eline: 1, ecol: 6 })["    ^"]
#test("    x = 1 + y", 1, 7, SrcSpan { sline: 1, scol: 5, eline: 1, ecol: 14 })["    ^^^^^^^^^"]
#test("fun größe() {", 1, 1, SrcSpan { sline: 1, scol: 1, eline: 3, ecol: 2 })["^^^^^^^^^^^^^"]
#test("abc", 1, 2, SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 })[" ^"]
pub fun carets(text: str, line: int32, col: int32, sp: SrcSpan) -> str {
    let (first, end) = caret_range(text, line, col, sp)
    var sb = StringBuilder()
    var k = 1
    while k < end {
        if k < first { sb.append_byte(' ') } else { sb.append_byte('^') }
        k = k + 1
    }
    return sb.build()
}

// What the CLI prints for `r`: it and its `more`, a blank line apart, then a
// summary line when there are several.
#test(Report { kind: "type error", msg: "a", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] })["type error: a"]
#test(Report { kind: "parse error", msg: "a", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [Report { kind: "parse error", msg: "b", path: "", line: 0, col: 0, sp: SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }, more: [], notes: [] }], notes: [] })["parse error: a\n\nparse error: b\n\nerror: aborting due to 2 previous errors"]
pub fun render(r: Report) -> str {
    if r.more.len() == 0 { return render_one(r) }
    var sb = StringBuilder()
    sb.append(render_one(r))
    for m in r.more { sb.append("\n\n" + render_one(m)) }
    sb.append(format("\n\nerror: aborting due to {} previous errors", r.more.len() + 1))
    return sb.build()
}

// One error, with the line it points at, then its notes.
pub fun render_one(r: Report) -> str {
    var src: Option<str> = None
    if r.line > 0 {
        match read_to_string(r.path) {
            Ok(s) => { src = Some(s) },
            Err(e) => {},
        }
    }
    var sb = StringBuilder()
    sb.append(located(format("{}: {}", kind_shown(r.kind, r.msg), r.msg), r.path, r.line, r.col, r.sp, src))
    for n in r.notes {
        sb.append("\n" + located(format("{}: {}", n.label, n.msg), r.path, n.line, n.col, n.sp, src))
    }
    return sb.build()
}

// `header`, then the place in `path` (`line` 0: none) and the line of `src`
// it points at with its carets.
fun located(header: str, path: str, line: int32, col: int32, sp: SrcSpan, src: Option<str>) -> str {
    var sb = StringBuilder()
    sb.append(header)
    if line == 0 { return sb.build() }
    sb.append(format("\n  --> {}:{}:{}", path, line, col))
    var src_line: Option<str> = None
    match src {
        Some(s) => { src_line = source_line(s, line) },
        None => {},
    }
    match src_line {
        Some(l) => {
            let gutter = format("{}", line)
            var pad = StringBuilder()
            for c in gutter.chars() { pad.append_byte(' ') }
            let p = pad.build()
            sb.append(format("\n{} |\n{} | {}\n{} | {}", p, gutter, l, p, carets(l, line, col, sp)))
        },
        None => {},
    }
    return sb.build()
}

// A report's kind as it is shown: a warning with its name, the one
// `#allow(…)` takes (D161), `warning[primitive]`.
#test("warning", "'__poll' is a primitive of the standard library, not meant to be called from a program")["warning[primitive]"]
#test("type error", "x")["type error"]
pub fun kind_shown(kind: str, msg: str) -> str {
    if kind != "warning" { return kind }
    let name = warning_name(msg)
    return if name == "" { kind } else { f"warning[{name}]" }
}

// The name of the warning whose message is `msg` (D161): the one place that
// maps the checker's warnings to the names `#allow` takes ("" for none).
#test("'__poll' is a primitive of the standard library, not meant to be called from a program")["primitive"]
#test("'self.n' was checked before an 'await' and is changed after it: another call to this actor may have changed it meanwhile")["reentrancy"]
#test("'self.n' is set from a value read before an 'await': another call to this actor may have changed it meanwhile")["reentrancy"]
#test("'unused' is no warning's name: '#allow' takes 'primitive' and 'reentrancy'")[""]
pub fun warning_name(msg: str) -> str {
    if has_text(msg, "is a primitive of the standard library") { return "primitive" }
    if has_text(msg, "another call to this actor may have changed it meanwhile") { return "reentrancy" }
    return ""
}

// Whether `s` holds `part`.
#test("abc", "bc")[true]
#test("abc", "cb")[false]
fun has_text(s: str, part: str) -> bool {
    var i = 0
    while i + part.len() <= s.len() {
        var j = 0
        while j < part.len() && s[i + j] == part[j] { j += 1 }
        if j == part.len() { return true }
        i += 1
    }
    return false
}
