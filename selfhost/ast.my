// ast.my — the Myla AST (mirror of src/myla/ast.py) plus the canonical dump
// (mirror of src/myla/canon.py:canonical_ast).
//
// Node families (Expr/Stmt/Pattern/TypeExpr/Decl) are wrapper structs
// `{ id, line, col, sp, kind }`: the `*Kind` enum carries the variant data, while
// the wrapper carries a unique NodeId and 1-based source position. This is the
// locked AST-metadata model (plan: "NodeId + side tables"): the checker reads
// `.line`/`.col` for diagnostics, and `.id` will key a resolved-type side table
// for the interpreter/codegen (v0.8+). `sp` is the source range of the tokens
// the parser consumed for the node (MYLA-65), which a diagnostic underlines;
// the smaller records with a position have one too. The canonical dump is
// *structural*: it matches on `.kind` and ignores id/position (token parity
// already pins positions), so the v0.6b AST-dump gate stays byte-identical.

from .util import escape
from .tokens import SrcSpan
from .parser import expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of  // AST values for #test cases (MYLA-184)

// --- types ---------------------------------------------------------------

pub struct TypeExpr { id: int32, line: int32, col: int32, sp: SrcSpan, kind: TypeKind }

pub enum TypeKind {
    TRef(str, [TypeExpr]),        // name, type arguments
    TTuple([TypeExpr]),
    TList(TypeExpr),
    TMap(TypeExpr, TypeExpr),
    TFn([TypeExpr], TypeExpr, bool),    // params, return, async (D89)
}

// --- expressions ---------------------------------------------------------

pub struct Expr { id: int32, line: int32, col: int32, sp: SrcSpan, kind: ExprKind }

pub struct FieldInit { line: int32, col: int32, sp: SrcSpan, name: str, value: Expr }
pub struct MapEntry { key: Expr, value: Expr }
// `default`: the value a call that leaves the parameter out gets (D136)
pub struct Param { line: int32, col: int32, sp: SrcSpan, name: str, ty: Option<TypeExpr>, default: Option<Expr> }

pub enum ExprOrBlock {
    EB_Expr(Expr),
    EB_Block(Block),
}

pub enum ExprKind {
    IntLit(int64, Option<str>, bool, str),   // value (64 low bits), suffix, is_char, big (lexer.my)
    FloatLit(str, Option<str>),         // lexeme (value: floatlit.my), suffix
    StrLit(str),
    BoolLit(bool),
    Name(str),
    Unary(str, Expr),
    Binary(str, Expr, Expr),
    Call(Expr, [Expr], [TypeExpr]),    // callee, arguments, explicit type arguments (`mk<int>()`, D169)
    GetField(Expr, str),
    StructLit(str, [FieldInit]),
    TupleLit([Expr]),
    TupleIndex(Expr, int64),
    ListLit([Expr]),
    MapLit([MapEntry]),
    Index(Expr, Expr),
    MatchE(Expr, [MatchArm]),
    Try(Expr),
    Cast(Expr, TypeExpr),
    Lambda([Param], Option<TypeExpr>, ExprOrBlock, bool),    // params, return, body, async (D89)
    Await(Expr),                                              // D89
    Hole,
}

// The explicit type arguments of the call `e` (D169), none for anything else.
#test(expr_of("f<int, str>(x)"))[[TypeExpr { id: 1, line: 1, col: 3, sp: SrcSpan { sline: 1, scol: 3, eline: 1, ecol: 6 }, kind: TypeKind.TRef("int", []) }, TypeExpr { id: 2, line: 1, col: 8, sp: SrcSpan { sline: 1, scol: 8, eline: 1, ecol: 11 }, kind: TypeKind.TRef("str", []) }]]
#test(expr_of("f(x)"))[[]]
#test(expr_of("x"))[[]]
pub fun call_targs(e: Expr) -> [TypeExpr] {
    return match e.kind {
        ExprKind.Call(c, args, targs) => targs,
        _ => [],
    }
}

// --- patterns ------------------------------------------------------------

pub struct Pattern { id: int32, line: int32, col: int32, sp: SrcSpan, kind: PatternKind }

pub struct FieldPat { line: int32, col: int32, sp: SrcSpan, name: str, pattern: Pattern }

pub enum PatternKind {
    PWild,
    PBind(str),
    PLit(Expr),
    PEnum(Option<str>, str, [Pattern], bool),   // enum_name, variant, elems, has_payload
    PTuple([Pattern]),
    PStruct(str, [FieldPat]),
    POr([Pattern]),
}

pub struct MatchArm { line: int32, col: int32, sp: SrcSpan, pattern: Pattern, guard: Option<Expr>, body: ExprOrBlock }

// --- bindings (destructuring) --------------------------------------------

pub enum BindElem {
    BName(str, int32, int32, SrcSpan),     // name, line, col, range
    BWild,
    BTuple([BindElem], int32, int32, SrcSpan),   // elements, position of the '(', range
}

// The elements of a destructuring binding (always a tuple at the top).
pub fun bind_elems(b: BindElem) -> [BindElem] {
    return match b {
        BindElem.BTuple(es, l, c, sp) => es,
        _ => [b],
    }
}

// --- statements ----------------------------------------------------------

pub struct Stmt { id: int32, line: int32, col: int32, sp: SrcSpan, kind: StmtKind }

pub struct Block { line: int32, col: int32, sp: SrcSpan, stmts: [Stmt] }

pub enum ElseTail {
    ElseBlock(Block),
    ElseIf(Stmt),       // always an IfS
}

pub enum StmtKind {
    VarDecl(str, str, Option<TypeExpr>, Expr),          // kind, name, type, init
    DestructDecl(str, BindElem, Option<TypeExpr>, Expr),    // kind, tuple binding, type, init
    Assign(Expr, Expr),
    IfS(Expr, Block, Option<ElseTail>),
    WhileS(Expr, Block),
    ForS(str, Option<Expr>, Option<Expr>, Block, Option<Expr>),  // var,start,end,body,iter
    ReturnS(Option<Expr>, bool),                         // value, `become` (D87)
    BreakS,
    ContinueS,
    ExprStmt(Expr),
    DeferS(Block),                                       // `defer { … }` (D135)
}

// --- declarations --------------------------------------------------------

// `bound_args`: each bound's type arguments, `I: Iterator<T>` (D171), [] for
// a trait without them
pub struct TypeParam { line: int32, col: int32, sp: SrcSpan, name: str, bounds: [str], bound_args: [[TypeExpr]] }
pub struct Field { line: int32, col: int32, sp: SrcSpan, name: str, ty: TypeExpr }
pub struct Variant { line: int32, col: int32, sp: SrcSpan, name: str, payload: [TypeExpr] }
pub struct ImportPath { line: int32, col: int32, sp: SrcSpan, dots: int32, segments: [str] }
pub struct ImportItem { line: int32, col: int32, sp: SrcSpan, name: str, alias: Option<str> }
// `label`: the name a comment after it on its line gives a `#test` case
// (MYLA-239), "" for none.
pub struct Attribute { line: int32, col: int32, sp: SrcSpan, name: str, args: [Expr], outputs: Option<[Expr]>, label: str }

pub struct FunData {
    line: int32,
    col: int32,
    sp: SrcSpan,
    name: str,
    params: [Param],
    ret_type: Option<TypeExpr>,
    body: Option<Block>,
    attributes: [Attribute],
    type_params: [TypeParam],
    receiver: Option<str>,
    is_pub: bool,
    is_async: bool,    // D89
}

pub struct Decl { id: int32, line: int32, col: int32, sp: SrcSpan, kind: DeclKind }

pub enum DeclKind {
    StructDecl(str, [Field], [Attribute], [TypeParam], bool, bool),      // name,fields,attrs,typarams,pub,actor (D89)
    FunDecl(FunData),
    EnumDecl(str, [Variant], [Attribute], [TypeParam], bool),
    TypeAliasDecl(str, TypeExpr, [Attribute], bool),
    ImplDecl(TypeExpr, [FunData], [TypeParam], Option<str>, [TypeExpr], [Attribute]),  // target,methods,typarams,trait,trait_args,attrs (D161)
    TraitDecl(str, [FunData], [TypeParam], bool, [Attribute]),          // name,methods,typarams,pub,attrs (D161)
    ConstDecl(str, TypeExpr, Expr, [Attribute], bool),
    ImportDecl(ImportPath, Option<[ImportItem]>, Option<str>, bool),      // path,items,alias,pub
}

pub struct Program { decls: [Decl] }

// =========================================================================
// Canonical dump (mirror of src/myla/canon.py) — structural, ignores id/pos.
// =========================================================================

#test([])["[]"]
#test(["s"])["[s]"]
#test(["n", "d"])["[n d]"]
fun wrap_list(parts: [str]) -> str {
    var sb = StringBuilder()
    sb.append_byte('[')
    var i = 0
    while i < parts.len() {
        if i > 0 { sb.append_byte(' ') }
        sb.append(parts[i])
        i = i + 1
    }
    sb.append_byte(']')
    return sb.build()
}

fun join_map<T>(xs: [T], f: (T) -> str) -> str {
    var parts: [str] = []
    for x in xs {
        parts.push(f(x))
    }
    return wrap_list(parts)
}

#test("a")["\"a\""]
#test("d2")["\"d2\""]
#test("right")["\"right\""]
fun sstr(s: str) -> str {
    return format("\"{}\"", escape(s))
}

// An integer literal's value: its decimal text when it is 2^63 or more.
#test(0, "")["0"]
#test(128, "")["128"]
#test(2147483648, "")["2147483648"]
pub fun int_text(v: int64, big: str) -> str {
    if big != "" { return big }
    return format("{}", v)
}

#test(true)["true"]
#test(false)["false"]
fun bstr(b: bool) -> str {
    if b { return "true" }
    return "false"
}

#test(Some("Shape"))["\"Shape\""]
#test(Some("Direction"))["\"Direction\""]
fun opt_sstr(o: Option<str>) -> str {
    return match o {
        Some(s) => sstr(s),
        None => "nil",
    }
}

#test(None)["nil"]
fun opt_type(o: Option<TypeExpr>) -> str {
    return match o {
        Some(t) => dump_type(t),
        None => "nil",
    }
}

#test(None)["nil"]
#test(Some(Expr { id: 55, line: 35, col: 17, sp: SrcSpan { sline: 35, scol: 17, eline: 35, ecol: 18 }, kind: ExprKind.Name("n") }))["(name \"n\")"]
#test(Some(Expr { id: 54, line: 35, col: 14, sp: SrcSpan { sline: 35, scol: 14, eline: 35, ecol: 15 }, kind: ExprKind.IntLit(0, None, false, "") }))["(int 0 nil false)"]
fun opt_expr(o: Option<Expr>) -> str {
    return match o {
        Some(e) => dump_expr(e),
        None => "nil",
    }
}

#test(true, "a", "a")["a"]
#test(false, "d2", "d2")["d2"]
#test(true, "right", "right")["right"]
fun choose(c: bool, a: str, b: str) -> str {
    if c { return a }
    return b
}

// `(async X)` for an async function type or lambda (D89).
#test(false, "y")["y"]
#test(true, "a")["(async a)"]
#test(true, "right")["(async right)"]
fun async_wrap(asy: bool, inner: str) -> str {
    if asy { return format("(async {})", inner) }
    return inner
}

#test(type_expr_of("int"))["(tref \"int\" [])"]
pub fun dump_type(t: TypeExpr) -> str {
    return match t.kind {
        TypeKind.TRef(name, args) => format("(tref {} {})", sstr(name), join_map(args, dump_type)),
        TypeKind.TTuple(elems) => format("(ttype {})", join_map(elems, dump_type)),
        TypeKind.TList(elem) => format("(ltype {})", dump_type(elem)),
        TypeKind.TMap(k, v) => format("(mtype {} {})", dump_type(k), dump_type(v)),
        TypeKind.TFn(params, ret, asy) => async_wrap(asy, format("(ftype {} {})", join_map(params, dump_type), dump_type(ret))),
    }
}

fun dump_finit(f: FieldInit) -> str {
    return format("(finit {} {})", sstr(f.name), dump_expr(f.value))
}

fun dump_pair(e: MapEntry) -> str {
    return format("(pair {} {})", dump_expr(e.key), dump_expr(e.value))
}

fun dump_param(p: Param) -> str {
    return format("(param {} {})", sstr(p.name), opt_type(p.ty))
}

#test(ExprOrBlock.EB_Expr(Expr { id: 57, line: 29, col: 25, sp: SrcSpan { sline: 29, scol: 25, eline: 29, ecol: 31 }, kind: ExprKind.StrLit("warm") }))["(str \"warm\")"]
#test(ExprOrBlock.EB_Expr(Expr { id: 39, line: 20, col: 29, sp: SrcSpan { sline: 20, scol: 29, eline: 20, ecol: 30 }, kind: ExprKind.IntLit(0, None, false, "") }))["(int 0 nil false)"]
#test(ExprOrBlock.EB_Expr(Expr { id: 119, line: 51, col: 28, sp: SrcSpan { sline: 51, scol: 28, eline: 51, ecol: 29 }, kind: ExprKind.IntLit(1, None, false, "") }))["(int 1 nil false)"]
fun dump_eb(b: ExprOrBlock) -> str {
    return match b {
        ExprOrBlock.EB_Expr(e) => dump_expr(e),
        ExprOrBlock.EB_Block(bl) => dump_block(bl),
    }
}

fun dump_arm(a: MatchArm) -> str {
    let g = match a.guard {
        Some(e) => dump_expr(e),
        None => "nil",
    }
    return format("(arm {} {} {})", dump_pattern(a.pattern), g, dump_eb(a.body))
}

#test(expr_of("Some(n)"))["(call (name \"Some\") [(name \"n\")])"]
#test(expr_of("f<int>(x)"))["(call (name \"f\") [(name \"x\")] [(tref \"int\" [])])"] // explicit type arguments, D169
#test(expr_of("m.f<[A], B<C>>()"))["(call (getfield (name \"m\") \"f\") [] [(ltype (tref \"A\" [])) (tref \"B\" [(tref \"C\" [])])])"]
#test(expr_of("a < b > c"))["(binary \">\" (binary \"<\" (name \"a\") (name \"b\")) (name \"c\"))"] // no `(` after the `>`
#test(expr_of("f(a < b, c > d)"))["(call (name \"f\") [(binary \"<\" (name \"a\") (name \"b\")) (binary \">\" (name \"c\") (name \"d\"))])"]
#test(expr_of("f(a < b, c > (d))"))["(call (name \"f\") [(call (name \"a\") [(name \"d\")] [(tref \"b\" []) (tref \"c\" [])])])"] // C#'s reading: one generic call
#test(expr_of("(a) < b > (c)"))["(binary \">\" (binary \"<\" (name \"a\") (name \"b\")) (name \"c\"))"] // a parenthesized callee compares
#test(expr_of("a < b >= (c)"))["(binary \">=\" (binary \"<\" (name \"a\") (name \"b\")) (name \"c\"))"]
pub fun dump_expr(e: Expr) -> str {
    return match e.kind {
        ExprKind.IntLit(v, suf, isc, big) => format("(int {} {} {})", int_text(v, big), opt_sstr(suf), bstr(isc)),
        ExprKind.FloatLit(lex, suf) => format("(float {})", opt_sstr(suf)),
        ExprKind.StrLit(s) => format("(str {})", sstr(s)),
        ExprKind.BoolLit(b) => format("(bool {})", bstr(b)),
        ExprKind.Name(n) => format("(name {})", sstr(n)),
        ExprKind.Unary(op, x) => format("(unary {} {})", sstr(op), dump_expr(x)),
        ExprKind.Await(x) => format("(await {})", dump_expr(x)),
        ExprKind.Binary(op, l, r) => format("(binary {} {} {})", sstr(op), dump_expr(l), dump_expr(r)),
        ExprKind.Call(c, args, targs) => {
            // explicit type arguments (D169) only when there are some, so the
            // recorded dumps of the retired parser still hold
            if targs.len() == 0 { format("(call {} {})", dump_expr(c), join_map(args, dump_expr)) }
            else { format("(call {} {} {})", dump_expr(c), join_map(args, dump_expr), join_map(targs, dump_type)) }
        },
        ExprKind.GetField(t, name) => format("(getfield {} {})", dump_expr(t), sstr(name)),
        ExprKind.StructLit(name, fields) => format("(structlit {} {})", sstr(name), join_map(fields, dump_finit)),
        ExprKind.TupleLit(elems) => format("(tuple {})", join_map(elems, dump_expr)),
        ExprKind.TupleIndex(t, idx) => format("(tindex {} {})", dump_expr(t), idx),
        ExprKind.ListLit(elems) => format("(list {})", join_map(elems, dump_expr)),
        ExprKind.MapLit(entries) => format("(map {})", join_map(entries, dump_pair)),
        ExprKind.Index(t, i) => format("(index {} {})", dump_expr(t), dump_expr(i)),
        ExprKind.MatchE(s, arms) => format("(match {} {})", dump_expr(s), join_map(arms, dump_arm)),
        ExprKind.Try(x) => format("(try {})", dump_expr(x)),
        ExprKind.Cast(x, ty) => format("(cast {} {})", dump_expr(x), dump_type(ty)),
        ExprKind.Lambda(params, ret, body, asy) => async_wrap(asy, format("(lambda {} {} {})", join_map(params, dump_param), opt_type(ret), dump_eb(body))),
        ExprKind.Hole => "(hole)",
    }
}

fun dump_fpat(fp: FieldPat) -> str {
    return format("(fpat {} {})", sstr(fp.name), dump_pattern(fp.pattern))
}

#test(pattern_of("_"))["(pwild)"]
pub fun dump_pattern(p: Pattern) -> str {
    return match p.kind {
        PatternKind.PWild => "(pwild)",
        PatternKind.PBind(n) => format("(pbind {})", sstr(n)),
        PatternKind.PLit(e) => format("(plit {})", dump_expr(e)),
        PatternKind.PEnum(en, v, elems, hp) => format("(penum {} {} {} {})", opt_sstr(en), sstr(v), join_map(elems, dump_pattern), bstr(hp)),
        PatternKind.PTuple(elems) => format("(ptuple {})", join_map(elems, dump_pattern)),
        PatternKind.PStruct(name, fields) => format("(pstruct {} {})", sstr(name), join_map(fields, dump_fpat)),
        PatternKind.POr(alts) => format("(por {})", join_map(alts, dump_pattern)),
    }
}

fun dump_bindelem(b: BindElem) -> str {
    return match b {
        BindElem.BName(n, l, c, sp) => format("(bname {})", sstr(n)),
        BindElem.BWild => "(bwild)",
        BindElem.BTuple(elems, l, c, sp) => format("(btuple {})", join_map(elems, dump_bindelem)),
    }
}

fun dump_else(t: ElseTail) -> str {
    return match t {
        ElseTail.ElseBlock(b) => dump_block(b),
        ElseTail.ElseIf(s) => dump_stmt(s),
    }
}

#test(block_of("{ }"))["(block [])"]
pub fun dump_block(b: Block) -> str {
    return format("(block {})", join_map(b.stmts, dump_stmt))
}

// The keyword of a return statement: `become` for a tail call (D87).
#test(true)["become"]
#test(false)["return"]
fun return_word(tail: bool) -> str {
    if tail { return "become" }
    return "return"
}

#test(stmt_of("return a"))["(return (name \"a\"))"]
pub fun dump_stmt(s: Stmt) -> str {
    return match s.kind {
        StmtKind.VarDecl(kind, name, ty, init) => format("(vardecl {} {} {} {})", sstr(kind), sstr(name), opt_type(ty), dump_expr(init)),
        StmtKind.DestructDecl(kind, binding, ty, init) => format("(destruct {} {} {} {})", sstr(kind), dump_bindelem(binding), opt_type(ty), dump_expr(init)),
        StmtKind.Assign(t, v) => format("(assign {} {})", dump_expr(t), dump_expr(v)),
        StmtKind.IfS(cond, then, otherwise) => {
            let ot = match otherwise {
                Some(e) => dump_else(e),
                None => "nil",
            }
            format("(if {} {} {})", dump_expr(cond), dump_block(then), ot)
        },
        StmtKind.WhileS(cond, body) => format("(while {} {})", dump_expr(cond), dump_block(body)),
        StmtKind.ForS(v, start, end, body, iter) => format("(for {} {} {} {} {})", sstr(v), opt_expr(start), opt_expr(end), dump_block(body), opt_expr(iter)),
        StmtKind.ReturnS(v, tail) => format("({} {})", return_word(tail), opt_expr(v)),
        StmtKind.BreakS => "(break)",
        StmtKind.ContinueS => "(continue)",
        StmtKind.ExprStmt(e) => format("(exprstmt {})", dump_expr(e)),
        StmtKind.DeferS(b) => format("(defer {})", dump_block(b)),
    }
}

fun dump_typaram(tp: TypeParam) -> str {
    var bs: [str] = []
    var i = 0
    while i < tp.bounds.len() {
        var b = sstr(tp.bounds[i])
        if i < tp.bound_args.len() && tp.bound_args[i].len() > 0 { b = format("(bound {} {})", b, join_map(tp.bound_args[i], dump_type)) }
        bs.push(b)
        i += 1
    }
    return format("(tp {} {})", sstr(tp.name), wrap_list(bs))
}

fun dump_field(f: Field) -> str {
    return format("(field {} {})", sstr(f.name), dump_type(f.ty))
}

fun dump_variant(v: Variant) -> str {
    return format("(variant {} {})", sstr(v.name), join_map(v.payload, dump_type))
}

// An impl's or trait's attributes (D161) in the dump: nothing when there
// are none, so a dump of a program without them is what it was before.
fun dump_extra_attrs(attrs: [Attribute]) -> str {
    if attrs.len() == 0 { return "" }
    return " " + join_map(attrs, dump_attr)
}

#test(Attribute { line: 36, col: 1, sp: SrcSpan { sline: 36, scol: 1, eline: 36, ecol: 14 }, name: "test", args: [], outputs: Some([Expr { id: 53, line: 36, col: 9, sp: SrcSpan { sline: 36, scol: 9, eline: 36, ecol: 13 }, kind: ExprKind.BoolLit(true) }]) , label: ""})["(attr \"test\" [] [(bool true)])"]
fun dump_attr(a: Attribute) -> str {
    let outs = match a.outputs {
        Some(xs) => join_map(xs, dump_expr),
        None => "nil",
    }
    return format("(attr {} {} {})", sstr(a.name), join_map(a.args, dump_expr), outs)
}

fun dump_importitem(it: ImportItem) -> str {
    return format("(iitem {} {})", sstr(it.name), opt_sstr(it.alias))
}

#test(fun_of("fun g() { print(1) }"))["(fun \"g\" [] nil (block [(exprstmt (call (name \"print\") [(int 1 nil false)]))]) [] [] nil false)"]
fun dump_fun(f: FunData) -> str {
    let body = match f.body {
        Some(b) => dump_block(b),
        None => "nil",
    }
    return format("({} {} {} {} {} {} {} {} {})", choose(f.is_async, "async-fun", "fun"), sstr(f.name), join_map(f.params, dump_param), opt_type(f.ret_type), body, join_map(f.attributes, dump_attr), join_map(f.type_params, dump_typaram), opt_sstr(f.receiver), bstr(f.is_pub))
}

pub fun dump_decl(d: Decl) -> str {
    return match d.kind {
        DeclKind.StructDecl(name, fields, attrs, tps, isp, act) => format("({} {} {} {} {} {})", choose(act, "actor", "struct"), sstr(name), join_map(fields, dump_field), join_map(attrs, dump_attr), join_map(tps, dump_typaram), bstr(isp)),
        DeclKind.FunDecl(f) => dump_fun(f),
        DeclKind.EnumDecl(name, variants, attrs, tps, isp) => format("(enum {} {} {} {} {})", sstr(name), join_map(variants, dump_variant), join_map(attrs, dump_attr), join_map(tps, dump_typaram), bstr(isp)),
        DeclKind.TypeAliasDecl(name, target, attrs, isp) => format("(typealias {} {} {} {})", sstr(name), dump_type(target), join_map(attrs, dump_attr), bstr(isp)),
        DeclKind.ImplDecl(target, methods, tps, trait_name, trait_args, dattrs) => format("(impl {} {} {} {} {}{})", dump_type(target), join_map(methods, dump_fun), join_map(tps, dump_typaram), opt_sstr(trait_name), join_map(trait_args, dump_type), dump_extra_attrs(dattrs)),
        DeclKind.TraitDecl(name, methods, tps, isp, dattrs) => format("(trait {} {} {} {}{})", sstr(name), join_map(methods, dump_fun), join_map(tps, dump_typaram), bstr(isp), dump_extra_attrs(dattrs)),
        DeclKind.ConstDecl(name, ty, value, attrs, isp) => format("(const {} {} {} {} {})", sstr(name), dump_type(ty), dump_expr(value), join_map(attrs, dump_attr), bstr(isp)),
        DeclKind.ImportDecl(path, items, alias, isp) => {
            let p = format("(ipath {} {})", path.dots, join_map(path.segments, sstr))
            let its = match items {
                Some(xs) => join_map(xs, dump_importitem),
                None => "nil",
            }
            format("(import {} {} {} {})", p, its, opt_sstr(alias), bstr(isp))
        },
    }
}

pub fun dump_program(p: Program) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < p.decls.len() {
        if i > 0 { sb.append_byte(10) }
        sb.append(dump_decl(p.decls[i]))
        i = i + 1
    }
    return sb.build()
}

// --- names read ---------------------------------------------------------

// `acc` with the name `e` is, when it is a variable's (MYLA-127).
fun with_name(e: Expr, acc: [str]) -> [str] {
    return match e.kind {
        ExprKind.Name(n) => {
            for a in acc { if a == n { return acc } }
            var out = acc
            out.push(n)
            out
        },
        _ => acc,
    }
}

// `acc` with every name the expression or block reads: what a lambda
// captures, natively (MYLA-127) and in the interpreter (MYLA-296).
pub fun names_in_expr(e: Expr, acc: [str]) -> [str] {
    var out = with_name(e, acc)
    match e.kind {
        ExprKind.Unary(op, x) => { out = names_in_expr(x, out) },
        ExprKind.Await(x) => { out = names_in_expr(x, out) },
        ExprKind.Binary(op, l, r) => { out = names_in_expr(r, names_in_expr(l, out)) },
        ExprKind.Call(c, args, _) => {
            out = names_in_expr(c, out)
            for a in args { out = names_in_expr(a, out) }
        },
        ExprKind.GetField(t, f) => { out = names_in_expr(t, out) },
        ExprKind.StructLit(n, fields) => { for fi in fields { out = names_in_expr(fi.value, out) } },
        ExprKind.TupleLit(es) => { for x in es { out = names_in_expr(x, out) } },
        ExprKind.ListLit(es) => { for x in es { out = names_in_expr(x, out) } },
        ExprKind.MapLit(entries) => {
            for en in entries { out = names_in_expr(en.value, names_in_expr(en.key, out)) }
        },
        ExprKind.TupleIndex(t, i) => { out = names_in_expr(t, out) },
        ExprKind.Index(t, i) => { out = names_in_expr(i, names_in_expr(t, out)) },
        ExprKind.MatchE(sc, arms) => {
            out = names_in_expr(sc, out)
            for arm in arms {
                match arm.guard { Some(g) => { out = names_in_expr(g, out) }, None => {} }
                match arm.body {
                    ExprOrBlock.EB_Expr(x) => { out = names_in_expr(x, out) },
                    ExprOrBlock.EB_Block(blk) => { out = names_in_block(blk, out) },
                }
            }
        },
        ExprKind.Try(x) => { out = names_in_expr(x, out) },
        ExprKind.Cast(x, ty) => { out = names_in_expr(x, out) },
        ExprKind.Lambda(ps, rt, body, asy) => {
            match body {
                ExprOrBlock.EB_Expr(x) => { out = names_in_expr(x, out) },
                ExprOrBlock.EB_Block(blk) => { out = names_in_block(blk, out) },
            }
        },
        _ => {},
    }
    return out
}

pub fun names_in_block(b: Block, acc: [str]) -> [str] {
    var out = acc
    for st in b.stmts {
        match st.kind {
            StmtKind.ExprStmt(e) => { out = names_in_expr(e, out) },
            StmtKind.VarDecl(k, n, ty, init) => { out = names_in_expr(init, out) },
            StmtKind.DestructDecl(k, bs, ty, init) => { out = names_in_expr(init, out) },
            StmtKind.Assign(target, value) => { out = names_in_expr(value, names_in_expr(target, out)) },
            StmtKind.ReturnS(ov, tail) => { match ov { Some(e) => { out = names_in_expr(e, out) }, None => {} } },
            StmtKind.IfS(c, then, otherwise) => {
                out = names_in_block(then, names_in_expr(c, out))
                match otherwise {
                    Some(ElseTail.ElseBlock(eb)) => { out = names_in_block(eb, out) },
                    Some(ElseTail.ElseIf(es)) => { out = names_in_block(Block { line: 0, col: 0, sp: es.sp, stmts: [es] }, out) },
                    None => {},
                }
            },
            StmtKind.WhileS(c, body) => { out = names_in_block(body, names_in_expr(c, out)) },
            StmtKind.ForS(v, start, end, body, iter) => {
                match start { Some(e) => { out = names_in_expr(e, out) }, None => {} }
                match end { Some(e) => { out = names_in_expr(e, out) }, None => {} }
                match iter { Some(e) => { out = names_in_expr(e, out) }, None => {} }
                out = names_in_block(body, out)
            },
            StmtKind.DeferS(body) => { out = names_in_block(body, out) },
            _ => {},
        }
    }
    return out
}

// --- `#test` expectations (D162, MYLA-304) --------------------------------

// What a case expects of the call: a value, `[panic("message")]` (the call
// ends in a runtime error with that message), `[exit(n)]` (it ends with
// that status). The last two are read from the expression's shape, before
// it is typed; the message and the status are literals.
pub enum Expected {
    Value,
    Panics(str),
    Exits(int64),
}

// A call of `panic` or `exit` (`std.process.exit`, by whatever name it is
// imported) in a case's `[...]`: `Some(name)` of the callee.
#test(expr_of("panic(\"boom\")"))[Some("panic")]
#test(expr_of("exit(3)"))[Some("exit")]
#test(expr_of("div(1, 0)"))[None]
#test(expr_of("3"))[None]
pub fun failure_callee(e: Expr) -> Option<str> {
    match e.kind {
        ExprKind.Call(callee, args, _) => {
            match callee.kind {
                ExprKind.Name(n) => {
                    if n == "panic" { return Some("panic") }
                    if n == "exit" || ends_with_segment(n, "exit") { return Some("exit") }
                    return None
                },
                _ => { return None },
            }
        },
        _ => { return None },
    }
}

// Whether the qualified name `n` (`std$process$exit`) ends in the segment `last`.
#test("std$process$exit", "exit")[true]
#test("exit", "exit")[false]
#test("my$exits", "exit")[false]
fun ends_with_segment(n: str, last: str) -> bool {
    if n.len() <= last.len() + 1 { return false }
    let cut = n.len() - last.len()
    if n[cut - 1] != '$' { return false }
    var i = 0
    while i < last.len() {
        if n[cut + i] != last[i] { return false }
        i = i + 1
    }
    return true
}

// The expectation an expected value states: `panic("…")` and `exit(n)` with
// their literal; anything else, a call of `panic` or `exit` with something
// else included, is a value (the checker refuses the latter).
#test(expr_of("panic(\"boom\")"))[Expected.Panics("boom")]
#test(expr_of("exit(3)"))[Expected.Exits(3)]
#test(expr_of("panic(x)"))[Expected.Value]
#test(expr_of("Ok(())"))[Expected.Value]
pub fun expected_failure(e: Expr) -> Expected {
    let callee = match failure_callee(e) { Some(c) => c, None => { return Expected.Value } }
    let args = match e.kind { ExprKind.Call(c, xs, _) => xs, _ => [] }
    if args.len() != 1 { return Expected.Value }
    if callee == "panic" {
        return match args[0].kind { ExprKind.StrLit(m) => Expected.Panics(m), _ => Expected.Value }
    }
    return match args[0].kind { ExprKind.IntLit(v, sfx, isc, big) => { if isc { Expected.Value } else { Expected.Exits(v) } }, _ => Expected.Value }
}
