// tokens.my — token kinds and the Token record (mirror of src/myla/tokens.py).

#derive(Eq)
pub enum TokenKind {
    INT, FLOAT, STRING, CHAR,
    IDENT,
    LET, VAR, FUN, RETURN, BECOME, ACTOR, ASYNC, AWAIT, STRUCT, ENUM, IMPL, TRAIT, SELF, MATCH,
    TYPEALIAS, AS, PUB, IMPORT, FROM, CONST, BREAK, CONTINUE,
    IF, ELSE, WHILE, FOR, IN, TRUE, FALSE,
    BOOL, STR, INT8, INT16, INT32, INT64, UINT8, UINT16, UINT32, UINT64,
    ARROW, FATARROW, PIPEGT, PIPE, DOTDOT, EQ, NE, LE, GE, AND, OR,
    PLUS, MINUS, STAR, SLASH, PERCENT, AMP, CARET, TILDE,
    LT, GT, BANG, ASSIGN,
    LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    COMMA, COLON, DOT, HASH, QUESTION,
    NEWLINE, SEMI, EOF,
}

// A source range (MYLA-65): from `sline`:`scol` to just before `eline`:`ecol`
// (1-based, columns in code points); `eline` 0 means there is none. Tokens and
// syntax nodes know theirs, and a diagnostic underlines it.
pub struct SrcSpan { sline: int32, scol: int32, eline: int32, ecol: int32 }

#test()[SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }]
pub fun no_span() -> SrcSpan {
    return SrcSpan { sline: 0, scol: 0, eline: 0, ecol: 0 }
}

// A lex or parse error (`kind` is "lex error" or "parse error"), with the
// message, 1-based position and range the Python front end reports.
pub struct Diag { kind: str, line: int32, col: int32, sp: SrcSpan, msg: str }

// A note on an error (MYLA-65): `label` "note", about the place `line`, `col`
// and `sp` give in the error's file, or "help", without a place (`line` 0)
// (src/myla/errors.py: Note).
pub struct Note { label: str, msg: str, line: int32, col: int32, sp: SrcSpan }

// At most this many errors per run (MYLA-65, D80): the parser and the checker
// stop at the limit (src/myla/errors.py: MAX_ERRORS).
pub const MAX_ERRORS: int32 = 20

pub struct Token {
    kind: TokenKind,
    lexeme: str,
    line: int32,
    column: int32,
    eline: int32,    // just past the token's last character (MYLA-65); the
    ecol: int32,     // tokens an f-string lowers to end where it ends
    ival: int64,     // INT value (its 64 low bits) or CHAR codepoint; 0 otherwise
    suffix: str,     // "" when there is no suffix
    big: str,        // an INT value of 2^63 or more in decimal (MYLA-73); "" otherwise
}

// The reserved words, as keyword_kind recognises them (the grammar tool
// checks that grammar/myla.ebnf uses each of them, MYLA-77).
#test()[["let", "var", "fun", "return", "become", "actor", "async", "await", "struct", "enum", "impl", "trait", "self", "match", "typealias", "as", "pub", "import", "from", "const", "break", "continue", "if", "else", "while", "for", "in", "true", "false", "bool", "str", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]]
pub fun keywords() -> [str] {
    return ["let", "var", "fun", "return", "become", "actor", "async", "await", "struct", "enum", "impl", "trait", "self", "match",
            "typealias", "as", "pub", "import", "from", "const", "break", "continue", "if", "else",
            "while", "for", "in", "true", "false", "bool", "str", "int8", "int16", "int32",
            "int64", "uint8", "uint16", "uint32", "uint64"]
}

// Whether keywords() and keyword_kind agree: each word is a keyword whose
// kind is named after it.
#test()[true]
pub fun keywords_agree() -> bool {
    for k in keywords() {
        let kind = keyword_kind(k)
        if kind == TokenKind.IDENT || kind_name(kind) != upper_ascii(k) { return false }
    }
    return true
}

#test("int8")["INT8"]
fun upper_ascii(s: str) -> str {
    var sb = StringBuilder()
    for c in s.chars() {
        var b = c as uint8
        if b >= 'a' && b <= 'z' { b = b - 32 }
        sb.append_byte(b)
    }
    return sb.build()
}

#test("as")[TokenKind.AS]
#test("actor")[TokenKind.ACTOR]
#test("typealias")[TokenKind.TYPEALIAS]
#test("uint64")[TokenKind.UINT64]
#test("while")[TokenKind.WHILE]
#test("x")[TokenKind.IDENT]
#test("typealiases")[TokenKind.IDENT]
#test("lets")[TokenKind.IDENT]
#test("zip")[TokenKind.IDENT]
pub fun keyword_kind(text: str) -> TokenKind {
    // by the first byte, so that a name is compared with the keywords that
    // start as it does, not all 39 (MYLA-359: every identifier of every
    // module comes here)
    let n = text.len()
    if n < 2 || n > 9 { return TokenKind.IDENT }
    let c = text[0]
    if c == 'a' {
        if text == "as" { return TokenKind.AS }
        if text == "actor" { return TokenKind.ACTOR }
        if text == "async" { return TokenKind.ASYNC }
        if text == "await" { return TokenKind.AWAIT }
    } else if c == 'b' {
        if text == "become" { return TokenKind.BECOME }
        if text == "break" { return TokenKind.BREAK }
        if text == "bool" { return TokenKind.BOOL }
    } else if c == 'c' {
        if text == "const" { return TokenKind.CONST }
        if text == "continue" { return TokenKind.CONTINUE }
    } else if c == 'e' {
        if text == "enum" { return TokenKind.ENUM }
        if text == "else" { return TokenKind.ELSE }
    } else if c == 'f' {
        if text == "fun" { return TokenKind.FUN }
        if text == "from" { return TokenKind.FROM }
        if text == "for" { return TokenKind.FOR }
        if text == "false" { return TokenKind.FALSE }
    } else if c == 'i' {
        if text == "impl" { return TokenKind.IMPL }
        if text == "import" { return TokenKind.IMPORT }
        if text == "if" { return TokenKind.IF }
        if text == "in" { return TokenKind.IN }
        if text == "int8" { return TokenKind.INT8 }
        if text == "int16" { return TokenKind.INT16 }
        if text == "int32" { return TokenKind.INT32 }
        if text == "int64" { return TokenKind.INT64 }
    } else if c == 'l' {
        if text == "let" { return TokenKind.LET }
    } else if c == 'm' {
        if text == "match" { return TokenKind.MATCH }
    } else if c == 'p' {
        if text == "pub" { return TokenKind.PUB }
    } else if c == 'r' {
        if text == "return" { return TokenKind.RETURN }
    } else if c == 's' {
        if text == "struct" { return TokenKind.STRUCT }
        if text == "self" { return TokenKind.SELF }
        if text == "str" { return TokenKind.STR }
    } else if c == 't' {
        if text == "trait" { return TokenKind.TRAIT }
        if text == "typealias" { return TokenKind.TYPEALIAS }
        if text == "true" { return TokenKind.TRUE }
    } else if c == 'u' {
        if text == "uint8" { return TokenKind.UINT8 }
        if text == "uint16" { return TokenKind.UINT16 }
        if text == "uint32" { return TokenKind.UINT32 }
        if text == "uint64" { return TokenKind.UINT64 }
    } else if c == 'v' {
        if text == "var" { return TokenKind.VAR }
    } else if c == 'w' {
        if text == "while" { return TokenKind.WHILE }
    }
    return TokenKind.IDENT
}

#test("i8")[true]
#test("u8")[true]
#test("i9")[false]
pub fun is_int_suffix(s: str) -> bool {
    return s == "i8" || s == "i16" || s == "i32" || s == "i64" || s == "u8" || s == "u16" || s == "u32" || s == "u64"
}

#test("f32")[true]
#test("f64")[true]
pub fun is_float_suffix(s: str) -> bool {
    return s == "f32" || s == "f64"
}

#test(TokenKind.INT)["INT"]
#test(TokenKind.FLOAT)["FLOAT"]
#test(TokenKind.STRING)["STRING"]
pub fun kind_name(k: TokenKind) -> str {
    return match k {
        TokenKind.INT => "INT",
        TokenKind.FLOAT => "FLOAT",
        TokenKind.STRING => "STRING",
        TokenKind.CHAR => "CHAR",
        TokenKind.IDENT => "IDENT",
        TokenKind.LET => "LET",
        TokenKind.VAR => "VAR",
        TokenKind.FUN => "FUN",
        TokenKind.RETURN => "RETURN",
        TokenKind.BECOME => "BECOME",
        TokenKind.ACTOR => "ACTOR",
        TokenKind.ASYNC => "ASYNC",
        TokenKind.AWAIT => "AWAIT",
        TokenKind.STRUCT => "STRUCT",
        TokenKind.ENUM => "ENUM",
        TokenKind.IMPL => "IMPL",
        TokenKind.TRAIT => "TRAIT",
        TokenKind.SELF => "SELF",
        TokenKind.MATCH => "MATCH",
        TokenKind.TYPEALIAS => "TYPEALIAS",
        TokenKind.AS => "AS",
        TokenKind.PUB => "PUB",
        TokenKind.IMPORT => "IMPORT",
        TokenKind.FROM => "FROM",
        TokenKind.CONST => "CONST",
        TokenKind.BREAK => "BREAK",
        TokenKind.CONTINUE => "CONTINUE",
        TokenKind.IF => "IF",
        TokenKind.ELSE => "ELSE",
        TokenKind.WHILE => "WHILE",
        TokenKind.FOR => "FOR",
        TokenKind.IN => "IN",
        TokenKind.TRUE => "TRUE",
        TokenKind.FALSE => "FALSE",
        TokenKind.BOOL => "BOOL",
        TokenKind.STR => "STR",
        TokenKind.INT8 => "INT8",
        TokenKind.INT16 => "INT16",
        TokenKind.INT32 => "INT32",
        TokenKind.INT64 => "INT64",
        TokenKind.UINT8 => "UINT8",
        TokenKind.UINT16 => "UINT16",
        TokenKind.UINT32 => "UINT32",
        TokenKind.UINT64 => "UINT64",
        TokenKind.ARROW => "ARROW",
        TokenKind.FATARROW => "FATARROW",
        TokenKind.PIPEGT => "PIPEGT",
        TokenKind.PIPE => "PIPE",
        TokenKind.DOTDOT => "DOTDOT",
        TokenKind.EQ => "EQ",
        TokenKind.NE => "NE",
        TokenKind.LE => "LE",
        TokenKind.GE => "GE",
        TokenKind.AND => "AND",
        TokenKind.OR => "OR",
        TokenKind.PLUS => "PLUS",
        TokenKind.MINUS => "MINUS",
        TokenKind.STAR => "STAR",
        TokenKind.SLASH => "SLASH",
        TokenKind.PERCENT => "PERCENT",
        TokenKind.AMP => "AMP",
        TokenKind.CARET => "CARET",
        TokenKind.TILDE => "TILDE",
        TokenKind.LT => "LT",
        TokenKind.GT => "GT",
        TokenKind.BANG => "BANG",
        TokenKind.ASSIGN => "ASSIGN",
        TokenKind.LPAREN => "LPAREN",
        TokenKind.RPAREN => "RPAREN",
        TokenKind.LBRACE => "LBRACE",
        TokenKind.RBRACE => "RBRACE",
        TokenKind.LBRACKET => "LBRACKET",
        TokenKind.RBRACKET => "RBRACKET",
        TokenKind.COMMA => "COMMA",
        TokenKind.COLON => "COLON",
        TokenKind.DOT => "DOT",
        TokenKind.HASH => "HASH",
        TokenKind.QUESTION => "QUESTION",
        TokenKind.NEWLINE => "NEWLINE",
        TokenKind.SEMI => "SEMI",
        TokenKind.EOF => "EOF",
    }
}
