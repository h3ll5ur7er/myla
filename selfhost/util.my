// util.my — shared low-level helpers for the self-hosted toolchain (v0.6).
//
// These exist because value semantics means a helper can't mutate a
// StringBuilder passed by value, so byte/codepoint assembly returns fresh
// strings; and because there are no module-level maps, so classification is
// done arithmetically on codepoints (identifier characters beyond ASCII by
// the generated ranges of unicode.my).

from .unicode import is_xid_start, is_xid_continue

// One Unicode scalar as a UTF-8 string (returned, since a passed-in
// StringBuilder couldn't be mutated through a call).
#test(0)["\0"]
#test(93)["]"]
#test(128512)["😀"]
pub fun cp_utf8(cp: int32) -> str {
    var sb = StringBuilder()
    if cp < 128 {
        sb.append_byte(cp as uint8)
    } else if cp < 2048 {
        sb.append_byte((192 | (cp >> 6)) as uint8)
        sb.append_byte((128 | (cp & 63)) as uint8)
    } else if cp < 65536 {
        sb.append_byte((224 | (cp >> 12)) as uint8)
        sb.append_byte((128 | ((cp >> 6) & 63)) as uint8)
        sb.append_byte((128 | (cp & 63)) as uint8)
    } else {
        sb.append_byte((240 | (cp >> 18)) as uint8)
        sb.append_byte((128 | ((cp >> 12) & 63)) as uint8)
        sb.append_byte((128 | ((cp >> 6) & 63)) as uint8)
        sb.append_byte((128 | (cp & 63)) as uint8)
    }
    return sb.build()
}

// Escape a string for the canonical dumps (only \ \n \t \r " are special;
// every other byte, including multi-byte UTF-8, passes through verbatim).
#test("a")["a"]
#test("d2")["d2"]
#test("right")["right"]
pub fun escape(s: str) -> str {
    var sb = StringBuilder()
    for ch in s.chars() {
        let c = ch as int32
        if c == 92 {
            sb.append("\\\\")
        } else if c == 10 {
            sb.append("\\n")
        } else if c == 9 {
            sb.append("\\t")
        } else if c == 13 {
            sb.append("\\r")
        } else if c == 34 {
            sb.append("\\\"")
        } else {
            sb.append(cp_utf8(c))
        }
    }
    return sb.build()
}

#test(48)[true]
#test(49)[true]
#test(10)[false]
pub fun is_digit(c: int32) -> bool {
    return c >= 48 && c <= 57
}

// Identifiers are `_` or XID_Start, then XID_Continue (D72, MYLA-84).
#test(65)[true]
#test(66)[true]
#test(33)[false]
pub fun is_ident_start(c: int32) -> bool {
    return is_xid_start(c)
}

#test(0)[false]
#test(48)[true]
#test(49)[true]
pub fun is_ident_continue(c: int32) -> bool {
    return is_xid_continue(c)
}

// Hex/decimal digit value, or -1 for a non-digit.
#test(48)[0]
#test(56)[8]
#test(101)[14]
pub fun digit_value(c: int32) -> int32 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 97 + 10
    }
    if c >= 65 && c <= 70 {
        return c - 65 + 10
    }
    return -1
}

#test("0", 10)[0]
#test("64", 10)[64]
#test("2147483648", 10)[2147483648]
pub fun parse_value(digits: str, base: int64) -> int64 {
    var v: int64 = 0
    for ch in digits.chars() {
        let dv = digit_value(ch as int32)
        v = v * base + (dv as int64)
    }
    return v
}

#test("")[true]
#test("a")[false]
#test("b")[false]
pub fun is_blank(s: str) -> bool {
    for ch in s.chars() {
        let c = ch as int32
        if c != 32 && c != 9 && c != 13 && c != 10 {
            return false
        }
    }
    return true
}

// The spec of each hole of a constant format string, "" for `{}` and the
// text after the `:` for `{:spec}` (D139); escaped braces are no holes.
#test("a {} b {:>8} c {{}}")[["", ">8"]]
#test("{:.2}")[[".2"]]
pub fun format_specs(fmt: str) -> [str] {
    var out: [str] = []
    let n = fmt.len()
    var i = 0
    while i < n {
        if fmt[i] == '{' && i + 1 < n && fmt[i + 1] == '{' { i = i + 2 }
        else if fmt[i] == '}' && i + 1 < n && fmt[i + 1] == '}' { i = i + 2 }
        else if fmt[i] == '{' {
            var j = i + 1
            while j < n && fmt[j] != '}' { j = j + 1 }
            var sb = StringBuilder()
            if j > i + 1 { sb.append(fmt, i + 2, j) }
            out.push(sb.build())
            i = j + 1
        } else {
            i = i + 1
        }
    }
    return out
}
