from std.process import args, exit
from std.fs import read_to_string
from std.io import println, eprintln
from .checker import build_checker_src
from .loader import amalgamate

fun main() {
    let argv = args()
    var stdlib = ""
    if len(argv) >= 3 { stdlib = argv[2] }
    match amalgamate(argv[1], stdlib) {
        Ok(src) => {
            match build_checker_src(src) {
                Ok(c) => { println("checked ok") },
                Err(e) => { eprintln(format("check failed {}:{}", e.line, e.col)) },
            }
        },
        Err(e) => { eprintln("amalg: " + e) },
    }
}
