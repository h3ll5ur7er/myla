from std.process import args, exit
from std.io import println, eprintln
from .checker import build_checker_decls
from .loader import load_program, Loaded

fun check(prog: Loaded) {
    match build_checker_decls(prog.decls, prog.next_id) {
        Ok(c) => { println("checked ok") },
        Err(e) => { eprintln(format("check failed {}:{}", e.line, e.col)) },
    }
}

fun main() {
    let argv = args()
    var stdlib = ""
    if len(argv) >= 3 { stdlib = argv[2] }
    match load_program(argv[1], stdlib) {
        Ok(prog) => { check(prog) },
        Err(e) => { eprintln("load: " + e) },
    }
}
