// ir_x86.my -- IR → x86-64 assembly (MYLA-103, D79; wiki: Architecture/IR).
//
// `emit_ir` is a method of the code generator, so every function is emitted
// with its pools (string literals, runtime-error positions, helper flags), its
// debug information, calling convention and runtime. The frame gives every
// slot that isn't an argument word, and every temporary, an 8-byte slot of
// its own; the instruction sequences for operations, casts, `print` and the
// like are shared with the code generator (`emit_int_op`, `emit_float_op`,
// `emit_cast`, `emit_unary`, `emit_print`, …), which kept the old one-pass
// path and the IR alike while both existed (MYLA-103 to MYLA-107).

from .ast import FunData
from .checker import Type
from .codegen import CodeGen, CgBinding, int_signed, takes_operand, is_cmp, fold_load, is_aggregate, is_actor_t, is_tfloat32, REG_WORDS, arg_reg, spilled_word, SPILLED_ENV, narrow_operand
from .ir import IrFunc, Inst, Term, Touches, ENV_WORD, touches, use_counts, def_counts, inst_uses, term_uses, successors, ends_in_call
from .parser import expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of  // AST values for #test cases (MYLA-184)

impl CodeGen {
    // Emit `f`, the IR of the function `fd`, as `myla_<mangled>`.
    fun emit_ir(var self, f: IrFunc, fd: FunData, mangled: str) {
        self.emit_ir_at(f, self.sig_of(fd.name).decl_id, fd.line, fd.col, mangled)
    }

    // Emit `f` as `myla_<mangled>`: a function or lambda declared by the node
    // `decl_id` (its file) at `line:col`.
    fun emit_ir_at(var self, f: IrFunc, decl_id: int32, line: int32, col: int32, mangled: str) {
        let tc = touches(f)
        self.temp_uses = use_counts(f, tc)
        self.ret_type = f.ret
        let reach = reachable_blocks(f)
        // the frame: the temporaries' cells next to %rbp (the most used, so
        // the most reached with 1-byte offsets), then each slot that isn't an
        // argument word, then the saved registers. Which temporaries need a
        // cell or get a register depends on what is recomputed, which
        // depends on the slots' offsets and registers: laid out twice.
        self.clear_regs(f)
        // an async function's frame function: its slots in the heap frame
        // %r15 holds (D90)
        self.in_frame = f.frame
        self.resume_blocks = []
        if f.frame {
            // the points reachable code resumes at
            var bi = 0
            while bi < f.blocks.len() {
                if reach[bi] {
                    match f.blocks[bi].term { Term.Suspend(rb) => { if !contains_int(self.resume_blocks, rb) { self.resume_blocks.push(rb) } }, _ => {} }
                }
                bi = bi + 1
            }
        }
        let defs = def_counts(f, tc)
        self.temp_remat = self.remat_texts(f, slots_at(f, 0), defs)
        self.alloc_regs(f, reach, tc)
        if f.frame { self.saved_regs.push("r15") }
        let cells = self.alloc_temps(f, tc)
        let slot_off = slots_at(f, 8 * cells)
        self.temp_remat = self.remat_texts(f, slot_off, defs)
        var cursor = 8 * cells
        if !f.frame {
            let (pos, extent) = slot_positions(f, true)
            cursor = cursor + extent
        }
        let saves = cursor
        cursor = cursor + 8 * self.saved_regs.len()
        // what a tail call needs (MYLA-126): the argument words the caller
        // pushed on the stack (D119), where the saved registers are, and
        // (worked out for the first candidate) the temporaries holding an
        // address in this frame
        var words = 0
        for s in f.slots {
            // a parameter passed by value takes as many words as it has (D88)
            if s.word >= 0 && s.word + s.size / 8 > words { words = s.word + s.size / 8 }
        }
        // a frame function's one argument is its frame, in %rdi
        if f.frame { words = 1 }
        var in_frame: [bool] = []
        self.save_base = saves
        self.arg_words = 0
        if words > REG_WORDS { self.arg_words = words - REG_WORDS }
        let temp_base = 0
        let frame = (cursor + 15) / 16 * 16
        self.epilogue = format(".Lret_{}", mangled)
        var labels: [str] = []
        for b in f.blocks { labels.push(self.label()) }

        self.cur_file = self.file_number(decl_id)
        self.cur_path = self.path_of(decl_id)
        self.emit(format("myla_{}:", mangled))
        self.dbg_begin_function(format("myla_{}", mangled))
        self.emit_loc(line, col)
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        if frame > 0 { self.emit(format("subq ${}, %rsp", frame)) }
        // the callee-saved registers it uses, and the parameters living in
        // registers (MYLA-121)
        var r = 0
        while r < self.saved_regs.len() {
            self.emit(format("movq %{}, {}(%rbp)", self.saved_regs[r], -saves - 8 * (r + 1)))
            r = r + 1
        }
        if !f.frame { self.emit_params(f, slot_off) }
        if f.frame {
            // the frame, and the point it resumes at (state 0: the start)
            self.emit("movq %rdi, %r15")
            if self.resume_blocks.len() > 0 {
                self.emit("movq 16(%r15), %rax")
                var ri = 0
                while ri < self.resume_blocks.len() {
                    self.emit(format("cmpq ${}, %rax", ri + 1))
                    self.emit(format("je {}", labels[self.resume_blocks[ri]]))
                    ri = ri + 1
                }
            }
        }
        self.dbg_push_scope()

        // a block nothing reaches (after a `return`, MYLA-120) has no code; its
        // debug scopes and variables stay, so the scopes stay nested
        var k = 0
        while k < f.order.len() {
            let b = f.order[k]
            if !reach[b] {
                for inst in f.blocks[b].insts {
                    match inst {
                        Inst.Scope(open) => { self.emit_inst(f, inst, slot_off, temp_base) },
                        Inst.Bind(name, s) => { self.emit_inst(f, inst, slot_off, temp_base) },
                        _ => {},
                    }
                }
                k = k + 1
                continue
            }
            self.emit(format("{}:", labels[b]))
            let insts = f.blocks[b].insts
            let fused = self.fused_compare(insts, f.blocks[b].term)
            var tail = -1
            let becomes = match f.blocks[b].term { Term.Become => true, _ => false }
            // `suspend` after a call: the call replaces the function (D90)
            let suspend_call = match f.blocks[b].term { Term.Suspend(sb) => ends_in_call(insts), _ => false }
            // `become`'s call always replaces the function (D87), under -g too
            if becomes || suspend_call { tail = insts.len() - 1 }
            else {
                if !self.debug && !f.frame { tail = tail_call_at(insts, f.blocks[b].term) }
                if tail >= 0 && !drops_after_free(f, insts, tail) { tail = -1 }
                if tail >= 0 && stack_words(insts[tail]) > self.arg_words { tail = -1 }
                if tail >= 0 {
                    if in_frame.len() == 0 { in_frame = frame_addresses(f) }
                    if passes_frame_address(insts[tail], in_frame) { tail = -1 }
                }
            }
            var stop = insts.len()
            if tail >= 0 { stop = tail }
            var i = 0
            while i < stop {
                if i + 1 < stop && i + 1 != fused && self.emit_elem_load(f, insts[i], insts[i + 1], temp_base) { i = i + 2 }
                else {
                    if i != fused { self.emit_inst(f, insts[i], slot_off, temp_base) }
                    i = i + 1
                }
            }
            // the next block with code, which a jump to it falls through to
            var next = -1
            var nk = k + 1
            while nk < f.order.len() && next < 0 {
                if reach[f.order[nk]] { next = f.order[nk] }
                nk = nk + 1
            }
            if tail >= 0 {
                // the owners dropped after the call go before the jump
                var j = tail + 1
                while j < insts.len() {
                    match insts[j] {
                        Inst.DropSlot(t, s) => { self.emit_inst(f, insts[j], slot_off, temp_base) },
                        _ => {},
                    }
                    j = j + 1
                }
                match f.blocks[b].term { Term.Suspend(sb) => { self.emit_state(sb) }, _ => {} }
                self.emit_tail_call(f, insts[tail], slot_off, labels[0], temp_base)
            }
            else if fused >= 0 { self.emit_compare_branch(insts[fused], f.blocks[b].term, labels, next, temp_base) }
            else { self.emit_term(f.blocks[b].term, labels, next, temp_base) }
            k = k + 1
        }

        self.emit(format("{}:", self.epilogue))
        self.restore_regs()
        self.emit("leave")
        // the caller pops the argument words it pushed (D119)
        self.emit("ret")
        self.end_loc()
        self.dbg_pop_scope()
        self.dbg_end_function()
        self.emit("")
        if f.frame { self.emit_frame_new(f, mangled, slot_off) }
        self.in_frame = false
    }

    // The load of the `width`-byte scalar at `src` into %rax (D120); a
    // `float32` element, 4 bytes, widened to the double a temporary holds.
    fun emit_load(var self, width: int32, t: Type, src: str) {
        if width == 4 && is_tfloat32(t) {
            self.uses_float = true
            self.emit(format("cvtss2sd {}, %xmm0", src))
            self.emit("movq %xmm0, %rax")
            return
        }
        self.emit(load_insn(width, t, src))
    }

    // The store of the low `width` bytes of `v` (an immediate or a
    // register), of type `t`, at `dst` (D120); a `float32` element narrowed
    // from the double a temporary holds.
    fun emit_store(var self, width: int32, t: Type, v: str, dst: str) {
        if width == 4 && is_tfloat32(t) {
            self.uses_float = true
            if text_has_xmm(v) { self.emit(format("cvtsd2ss {}, %xmm0", v)) }
            else {
                self.emit(format("movq {}, %xmm0", v))
                self.emit("cvtsd2ss %xmm0, %xmm0")
            }
            self.emit(format("movss %xmm0, {}", dst))
            return
        }
        self.emit(store_insn(width, v, dst))
    }

    // The parameters into their homes (D119): the words that came in
    // registers (and a lambda's environment, in %r10) stored into their
    // frame cells, those living in registers moved there all at once, then
    // the registers of those that came on the stack loaded. One nothing
    // reads is left where it came (but under -g, for the debugger).
    fun emit_params(var self, f: IrFunc, slot_off: [int32]) {
        let read = read_slots(f)
        var dst: [str] = []
        var src: [str] = []
        var si = 0
        while si < f.slots.len() {
            let s = f.slots[si]
            if (s.word == ENV_WORD || (s.word >= 0 && s.word < REG_WORDS)) && (read[si] || self.debug) {
                var source = "%r10"
                if s.word >= 0 { source = "%" + arg_reg(s.word) }
                if self.slot_reg[si] != "" {
                    dst.push("%" + self.slot_reg[si])
                    src.push(source)
                } else if s.inline {
                    // passed by value (D88): each word into its cell, one
                    // past the registers from the stack
                    var k = 0
                    while k < s.size / 8 {
                        let w = s.word + k
                        if w < REG_WORDS { self.emit(format("movq %{}, {}(%rbp)", arg_reg(w), slot_off[si] + 8 * k)) }
                        else {
                            self.emit(format("movq {}, %rax", spilled_word(w)))
                            self.emit(format("movq %rax, {}(%rbp)", slot_off[si] + 8 * k))
                        }
                        k = k + 1
                    }
                } else { self.emit(format("movq {}, {}(%rbp)", source, slot_off[si])) }
            }
            si = si + 1
        }
        self.emit_moves(dst, src)
        si = 0
        while si < f.slots.len() {
            if f.slots[si].word >= REG_WORDS && self.slot_reg[si] != "" { self.emit(format("movq {}(%rbp), %{}", slot_off[si], self.slot_reg[si])) }
            si = si + 1
        }
    }

    // The register moves `src[i]` into `dst[i]`, as if all at once: a move
    // whose destination no other move still reads goes first; in a cycle,
    // a destination's value is saved in %rax and read from there.
    fun emit_moves(var self, dst: [str], src: [str]) {
        var source = src
        var done: [bool] = []
        var left = 0
        var i = 0
        while i < dst.len() {
            done.push(dst[i] == source[i])
            if !done[i] { left = left + 1 }
            i = i + 1
        }
        while left > 0 {
            var moved = false
            i = 0
            while i < dst.len() {
                if !done[i] {
                    var read = false
                    var j = 0
                    while j < dst.len() {
                        if !done[j] && j != i && source[j] == dst[i] { read = true }
                        j = j + 1
                    }
                    if !read {
                        self.emit(format("movq {}, {}", source[i], dst[i]))
                        done[i] = true
                        left = left - 1
                        moved = true
                    }
                }
                i = i + 1
            }
            if !moved {
                i = 0
                while done[i] { i = i + 1 }
                self.emit(format("movq {}, %rax", dst[i]))
                var j = 0
                while j < dst.len() {
                    if !done[j] && source[j] == dst[i] { source[j] = "%rax" }
                    j = j + 1
                }
            }
        }
    }

    // A call's argument words `ws` (D119): the first `REG_WORDS` into their
    // registers, the rest pushed, the last first; how many were pushed,
    // which the caller pops after the call. Nothing an argument is read
    // from lives in an argument register (a value living across a call is
    // in a callee-saved one), so the registers are loaded in turn.
    fun pass_words(var self, ws: [int32], temp_base: int32) -> int32 {
        var i = ws.len() - 1
        while i >= REG_WORDS {
            self.push_temp(ws[i], temp_base)
            i = i - 1
        }
        i = 0
        while i < ws.len() && i < REG_WORDS {
            self.load_temp(ws[i], arg_reg(i), temp_base)
            i = i + 1
        }
        if ws.len() > REG_WORDS { return ws.len() - REG_WORDS }
        return 0
    }

    // The `n` argument words a call pushed, popped.
    fun pop_words(var self, n: int32) {
        if n > 0 { self.emit(format("addq ${}, %rsp", 8 * n)) }
    }

    // -- async functions' frames (D90) -------------------------------------

    // `suspend L`: the state that resumes at L, into the frame.
    fun emit_state(var self, b: int32) {
        var k = 0
        while k < self.resume_blocks.len() && self.resume_blocks[k] != b { k = k + 1 }
        self.emit(format("movq ${}, 16(%r15)", k + 1))
    }

    // `suspend L` with no call before it: back to the executor.
    fun emit_suspend(var self, b: int32, labels: [str]) {
        self.emit_state(b)
        self.emit(format("jmp {}", self.epilogue))
    }

    // `myla_<f>__new(args…)`: a new heap frame for the frame function `f`
    // (`[resume fn][caller][state][task]`, then the slots, zeroed), each
    // argument copied into its parameter's slot with references of its own
    // (an aggregate from the address passed; a lambda's environment from
    // %r10); the frame in %rax. The argument registers are kept below the
    // frame base across the allocation.
    fun emit_frame_new(var self, f: IrFunc, mangled: str, slot_off: [int32]) {
        let size = frame_size(f)
        var words = 0
        for s in f.slots { if s.word >= 0 && s.word + 1 > words { words = s.word + 1 } }
        self.emit(format("myla_{}__new:", mangled))
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        let rbx_at = -8 * (self.spill_args(words) + 1)
        self.emit("pushq %rbx")
        self.emit(format("movq ${}, %rdi", size))
        self.emit("call __alloc")
        self.emit("movq %rax, %rbx")
        self.emit("movq %rax, %rdi")
        self.emit(format("movq ${}, %rcx", size / 8))
        self.emit("xorl %eax, %eax")
        self.emit("rep stosq")
        self.emit(format("leaq myla_{}(%rip), %rax", mangled))
        self.emit("movq %rax, 0(%rbx)")
        var i = 0
        while i < f.slots.len() {
            let s = f.slots[i]
            if s.word >= 0 || s.word == ENV_WORD {
                var at = SPILLED_ENV
                if s.word >= 0 { at = spilled_word(s.word) }
                if is_aggregate(s.ty) {
                    self.emit(format("movq {}, %rsi", at))
                    var w = 0
                    while w < s.size {
                        self.emit(format("movq {}(%rsi), %rax", w))
                        self.emit(format("movq %rax, {}(%rbx)", slot_off[i] + w))
                        w = w + 8
                    }
                } else {
                    self.emit(format("movq {}, %rax", at))
                    self.emit(format("movq %rax, {}(%rbx)", slot_off[i]))
                }
                if self.owns_heap(s.ty) { self.retain("rbx", slot_off[i], s.ty) }
                // a lambda's environment, held until its captures are copied
                if s.word == ENV_WORD {
                    self.emit(format("movq {}(%rbx), %rdi", slot_off[i]))
                    self.emit("call __func_retain")
                }
            }
            i = i + 1
        }
        self.emit("movq %rbx, %rax")
        self.emit(format("movq {}(%rbp), %rbx", rbx_at))
        self.emit("leave")
        self.emit("ret")
        self.emit("")
    }

    fun emit_inst(var self, f: IrFunc, inst: Inst, slot_off: [int32], temp_base: int32) {
        match inst {
            // a constant or an address is recomputed where it is read
            // (`remat_texts`), unless its temporary is written elsewhere too
            Inst.Const(d, t, v) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Str(d, text) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Load(d, s) => {
                // read where it is used instead (`remat_texts`)
                if self.temp_remat[d] == "" {
                    if self.slot_reg[s] != "" { self.emit(format("movq %{}, %rax", self.slot_reg[s])) }
                    else if self.in_frame { self.emit(format("movq {}(%r15), %rax", slot_off[s])) }
                    else { self.emit(format("movq {}(%rbp), %rax", slot_off[s])) }
                    self.store_temp(d, temp_base)
                }
            },
            Inst.Store(s, v) => {
                let sr = self.slot_reg[s]
                if sr.len() > 3 && sr[0] == 'x' && sr[1] == 'm' && sr[2] == 'm' {
                    // into an %xmm home (MYLA-249): from another, or through %rax
                    let home = self.xmm_home(v)
                    if home != "" {
                        if self.pend_store != "" { self.flush_temp_in_rax() }
                        if home != "%" + sr { self.emit(format("movapd {}, %{}", home, sr)) }
                    } else {
                        self.load_temp(v, "rax", temp_base)
                        self.emit(format("movq %rax, %{}", sr))
                    }
                } else if sr != "" { self.load_temp(v, sr, temp_base) }
                else if self.in_frame { self.emit(format("movq {}, {}(%r15)", self.value_operand(v, temp_base), slot_off[s])) }
                else { self.emit(format("movq {}, {}(%rbp)", self.value_operand(v, temp_base), slot_off[s])) }
            },
            Inst.Addr(d, s) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Offset(d, p, off) => {
                let base = self.reg_of(p)
                if base != "" { self.emit(format("leaq {}({}), %rax", off, base)) }
                else {
                    self.load_temp(p, "rax", temp_base)
                    if off != 0 { self.emit(format("addq ${}, %rax", off)) }
                }
                self.store_temp(d, temp_base)
            },
            Inst.LoadAt(d, p, off, width) => {
                // through a slot's address: straight from the frame (MYLA-120)
                // or through a register (MYLA-121); as wide as the IR says
                // (D120)
                let base = self.reg_of(p)
                let t = f.temps[d]
                if self.temp_frame[p] != 0 && self.in_frame { self.emit_load(width, t, format("{}(%r15)", self.temp_frame[p] + off)) }
                else if self.temp_frame[p] != 0 { self.emit_load(width, t, format("{}(%rbp)", self.temp_frame[p] + off)) }
                else if base != "" { self.emit_load(width, t, format("{}({})", off, base)) }
                else {
                    self.load_temp(p, "rax", temp_base)
                    self.emit_load(width, t, format("{}(%rax)", off))
                }
                self.store_temp(d, temp_base)
            },
            Inst.StoreAt(p, off, v, width) => {
                let base = self.reg_of(p)
                if self.temp_frame[p] != 0 && self.in_frame { self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}(%r15)", self.temp_frame[p] + off)) }
                else if self.temp_frame[p] != 0 { self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}(%rbp)", self.temp_frame[p] + off)) }
                else if base != "" { self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}({})", off, base)) }
                else {
                    self.load_temp(p, "rcx", temp_base)
                    self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}(%rcx)", off))
                }
            },
            Inst.Copy(d, src, size) => {
                self.load_temp(src, "rsi", temp_base)
                self.load_temp(d, "rdi", temp_base)
                self.emit_copy(size)
            },
            Inst.Bin(d, op, t, rt, a, b, pos) => {
                match t {
                    Type.TFloat(w) => {
                        if op == "%" {
                            self.load_temp(a, "rax", temp_base)
                            self.load_temp(b, "rcx", temp_base)
                            self.emit_float_op(op, rt)
                        } else {
                            // the operands where they are, %xmm homes included (MYLA-249)
                            self.uses_float = true
                            let ra = self.xmm_in(a, "rax", "xmm0", temp_base)
                            let rb = self.xmm_in(b, "rcx", "xmm1", temp_base)
                            // computed in the destination's home when the second
                            // operand isn't there, else in %xmm0
                            var target = self.xmm_home(d)
                            if target == "" || target == rb { target = "%xmm0" }
                            if self.pend_store != "" { self.flush_temp_in_rax() }
                            if ra != target { self.emit(format("movapd {}, {}", ra, target)) }
                            self.emit(format("{} {}, {}", float_insn(op), rb, target))
                            if is_tfloat32(rt) {
                                self.emit(format("cvtsd2ss {}, {}", target, target))
                                self.emit(format("cvtss2sd {}, {}", target, target))
                            }
                            if target == "%xmm0" { self.xmm_result(d, temp_base) }
                            return
                        }
                    },
                    _ => {
                        // the operands swapped when the second is still in
                        // %rax and the order doesn't matter (MYLA-121)
                        if self.swap_operands(op, a, b) {
                            self.load_temp(b, "rax", temp_base)
                            self.emit_int_op(op, t, rt, pos.line, pos.col, self.second_operand(op, a, temp_base))
                        } else if (op == "/" || op == "%") && self.temp_imm[b] != "" && self.temp_imm[b] != "$0" && self.temp_imm[b] != "$-1" {
                            // a constant divisor: neither 0 nor -1 to test
                            // for; an unsigned power of two is a shift or a
                            // mask (MYLA-125)
                            self.load_temp(a, "rax", temp_base)
                            let k = power_of_two(self.temp_imm[b])
                            if k > 0 && !int_signed(t) {
                                if op == "/" { self.emit(format("shrq ${}, %rax", k)) }
                                else {
                                    let one: int64 = 1
                                    self.emit(format("andq ${}, %rax", (one << (k as int64)) - 1))
                                }
                                self.wrap(rt)
                            } else {
                                self.load_temp(b, "rcx", temp_base)
                                self.emit_int_op(op, t, rt, pos.line, pos.col, self.temp_imm[b])
                            }
                        } else {
                            self.load_temp(a, "rax", temp_base)
                            self.emit_int_op(op, t, rt, pos.line, pos.col, self.second_operand(op, b, temp_base))
                        }
                    },
                }
                self.store_temp(d, temp_base)
            },
            Inst.Cmp(d, op, t, a, b) => {
                match t {
                    Type.TFloat(w) => {
                        self.uses_float = true
                        let ra = self.xmm_in(a, "rax", "xmm0", temp_base)
                        let rb = self.xmm_in(b, "rcx", "xmm1", temp_base)
                        self.emit(format("ucomisd {}, {}", rb, ra))
                        self.emit_float_cmp_result(op)
                    },
                    _ => {
                        if self.swap_operands(op, a, b) {
                            self.load_temp(b, "rax", temp_base)
                            self.emit_int_op(swapped_cmp(op), t, Type.TBool, 0, 0, self.second_operand(op, a, temp_base))
                        } else {
                            self.load_temp(a, "rax", temp_base)
                            self.emit_int_op(op, t, Type.TBool, 0, 0, self.second_operand(op, b, temp_base))
                        }
                    },
                }
                self.store_temp(d, temp_base)
            },
            Inst.Un(d, op, t, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_unary(op, t)
                self.store_temp(d, temp_base)
            },
            Inst.Cast(d, src, tgt, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_cast(src, tgt)
                self.store_temp(d, temp_base)
            },
            Inst.Call(d, name, args) => {
                let n = self.pass_words(args, temp_base)
                self.emit(format("call myla_{}", name))
                self.pop_words(n)
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.CallSret(name, r, args) => {
                // the result's address is the first word (%rdi)
                let n = self.pass_words(sret_words(r, args), temp_base)
                self.emit(format("call myla_{}", name))
                self.pop_words(n)
            },
            Inst.Label(d, sym) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.CallInd(d, fv, args) => {
                // the arguments, the environment in %r10, then the call
                let n = self.pass_words(args, temp_base)
                self.load_temp(fv, "rax", temp_base)
                self.emit("movq 8(%rax), %r10")
                self.emit("call *(%rax)")
                self.pop_words(n)
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.CallIndSret(fv, r, args) => {
                let n = self.pass_words(sret_words(r, args), temp_base)
                self.load_temp(fv, "rax", temp_base)
                self.emit("movq 8(%rax), %r10")
                self.emit("call *(%rax)")
                self.pop_words(n)
            },
            Inst.Rt(d, name, args) => {
                // std.math's primitives inline (MYLA-249): no call
                if name == "__sqrt" {
                    self.uses_float = true
                    let ra = self.xmm_in(args[0], "rax", "xmm0", temp_base)
                    self.emit(format("sqrtsd {}, %xmm0", ra))
                    self.xmm_result(d, temp_base)
                    return
                }
                if name == "__f64_bits" || name == "__f64_from_bits" {
                    self.load_temp(args[0], "rax", temp_base)
                    self.store_temp(d, temp_base)
                    return
                }
                self.load_args(args, temp_base)
                if name == "__float_to_str" { self.uses_float = true }
                self.emit(format("call {}", name))
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.RetainVal(t, v) => {
                // an actor handle may be shared between threads (D92)
                var inc = "incq"
                if self.frames && is_actor_t(t) { inc = "lock incq" }
                let at = self.reg_of(v)
                if at != "" { self.emit(format("{} -8({})", inc, at)) }
                else {
                    self.load_temp(v, "rax", temp_base)
                    self.emit(format("{} -8(%rax)", inc))
                }
            },
            Inst.Retain(t, p) => {
                self.load_temp(p, "r8", temp_base)
                self.retain("r8", 0, t)
            },
            Inst.DropSlot(t, s) => {
                if self.in_frame { self.drop_value("r15", slot_off[s], t) } else { self.drop_value("rbp", slot_off[s], t) }
            },
            Inst.Frame(d) => {
                self.emit("movq %r15, %rax")
                self.store_temp(d, temp_base)
            },
            Inst.DropAt(t, p) => {
                // the walk keeps the address in callee-saved %rbx across the
                // drop calls
                self.emit("pushq %rbx")
                self.load_temp(p, "rbx", temp_base)
                self.walk_member("rbx", 0, t, false)
                self.emit("popq %rbx")
            },
            Inst.Deep(t, p) => {
                // the type's deep walk, the value's address in %rdi
                self.load_temp(p, "rdi", temp_base)
                self.emit("call " + self.register_deep(t, false))
            },
            Inst.CloneDeep(t, p) => {
                self.load_temp(p, "rdi", temp_base)
                self.emit("call " + self.register_deep(t, true))
            },
            Inst.Init(s) => {},
            Inst.Moved(s) => {},
            Inst.RtPair(d, d2, name, args) => {
                self.load_args(args, temp_base)
                self.emit(format("call {}", name))
                self.store_temp(d, temp_base)
                self.emit("movq %rdx, %rax")
                self.store_temp(d2, temp_base)
            },
            Inst.Check(v, kind, p) => {
                self.emit_test(v, temp_base)
                self.trap("jz", "__trap_" + kind, p.line, p.col)
            },
            Inst.SbAppend(h, v) => {
                // the string's length and bytes
                self.load_temp(v, "rsi", temp_base)
                self.emit("movq (%rsi), %rdx")
                self.emit("addq $8, %rsi")
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
            },
            Inst.SbAppendRange(h, v, a, b, p) => {
                // a range: 0 <= start <= end <= len
                self.load_temp(b, "rcx", temp_base)
                self.emit("movslq %ecx, %rcx")
                self.load_temp(a, "rdx", temp_base)
                self.emit("movslq %edx, %rdx")
                self.load_temp(v, "rsi", temp_base)
                self.emit_sb_range(p.line, p.col)
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
            },
            Inst.SbAppendByte(h, b) => {
                // the byte on the stack
                self.load_temp(b, "rax", temp_base)
                self.emit("pushq %rax")
                self.emit("movq %rsp, %rsi")
                self.emit("movq $1, %rdx")
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
                self.emit("addq $8, %rsp")
            },
            Inst.SbBuild(d, c) => {
                self.load_temp(c, "rax", temp_base)
                self.emit_sb_build()
                self.store_temp(d, temp_base)
            },
            Inst.Global(d, sym, w) => {
                if w == 4 { self.emit(format("movslq {}, %rax", self.tv(sym))) } else { self.emit(format("movq {}, %rax", self.tv(sym))) }
                self.store_temp(d, temp_base)
            },
            Inst.Exit(v) => {
                // exit_group (every thread ends); when tasks take turns, held for the
                // parent if a task other than the entry's exits
                self.load_temp(v, "rax", temp_base)
                self.emit("movl %eax, %edi")
                if self.frames { self.emit("call __task_exit") }
                else {
                    self.emit("movq $231, %rax")
                    self.emit("syscall")
                }
            },
            Inst.MapRemove(mt, h, c, k) => {
                // the holder, then the cell, below the key
                self.load_temp(h, "rax", temp_base)
                self.emit("pushq %rax")
                self.load_temp(c, "rax", temp_base)
                self.emit("pushq %rax")
                self.load_temp(k, "rsi", temp_base)
                self.emit_map_remove(mt)
            },
            Inst.Elem(d, c, i, stride, is_str, p) => {
                self.load_temp(c, "rax", temp_base)
                self.load_temp(i, "rcx", temp_base)
                self.emit_elem_addr(is_str, stride, p.line, p.col)
                self.store_temp(d, temp_base)
            },
            Inst.Load8(d, p) => {
                self.load_temp(p, "rax", temp_base)
                self.emit("movzbl (%rax), %eax")
                self.store_temp(d, temp_base)
            },
            Inst.Cow(d, t, h) => {
                // the holder's address straight into %rcx (MYLA-251)
                self.load_temp(h, "rcx", temp_base)
                self.cow_unique_at_rcx(t)
                self.store_temp(d, temp_base)
            },
            Inst.Append(d, h, c, stride) => {
                // grow when full (publishing the new cell), then
                // count the element and point at its slot
                let have = self.label()
                self.load_temp(c, "rax", temp_base)
                self.emit("movq (%rax), %rdx")
                self.emit("movq 8(%rax), %rcx")
                self.emit("cmpq %rcx, %rdx")
                self.emit(format("jb {}", have))
                self.emit("movq %rax, %rdi")
                self.emit(format("movq ${}, %rsi", stride))
                self.emit("call __list_grow")
                self.load_temp(h, "rcx", temp_base)
                self.emit("movq %rax, (%rcx)")
                self.emit(format("{}:", have))
                self.emit("movq (%rax), %rdx")
                self.emit("leaq 1(%rdx), %rcx")
                self.emit("movq %rcx, (%rax)")
                self.emit(format("imulq ${}, %rdx", stride))
                self.emit("leaq 16(%rax,%rdx), %rax")
                self.store_temp(d, temp_base)
            },
            Inst.Pop(d, c, stride, p) => {
                // trap when empty, else uncount the last element
                self.load_temp(c, "rax", temp_base)
                self.emit("movq (%rax), %rcx")
                self.emit("testq %rcx, %rcx")
                self.trap("jz", "__trap_pop", p.line, p.col)
                self.emit("decq %rcx")
                self.emit("movq %rcx, (%rax)")
                self.emit(format("imulq ${}, %rcx", stride))
                self.emit("leaq 16(%rax,%rcx), %rax")
                self.store_temp(d, temp_base)
            },
            Inst.Print(t, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_print(t)
            },
            Inst.Loc(p) => { self.emit_loc(p.line, p.col) },
            Inst.Bind(name, s) => {
                let slot = f.slots[s]
                // a frame function's variables are in its heap frame (D90,
                // MYLA-141); its parameters, owned copies there, are visible
                // in the whole function
                if f.frame {
                    let b = CgBinding { name: name, kind: "frame", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, slot.word >= 0, slot.word >= 0)
                    return
                }
                // a parameter passed by value lives in its argument words as a
                // local in its slot (D88)
                if slot.word >= 0 && !slot.inline {
                    let b = CgBinding { name: name, kind: "param", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, true, true)
                } else {
                    let b = CgBinding { name: name, kind: "local", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, false, false)
                }
            },
            Inst.Scope(open) => {
                if open { self.dbg_push_scope() } else { self.dbg_pop_scope() }
            },
        }
    }

    // The index of the instruction of `insts` that the branch `term` can fuse
    // with (MYLA-120): a comparison ending the block whose result only the
    // branch reads, an integer one or a float `<`, `<=`, `>`, `>=` (MYLA-249;
    // a float `==` or `!=` needs the parity flag too); -1 when there is none.
    fun fused_compare(self, insts: [Inst], term: Term) -> int32 {
        if insts.len() == 0 { return -1 }
        let last = insts.len() - 1
        return match term {
            Term.Br(c, a, b) => match insts[last] {
                // a negated flag only the branch reads: the inverted jump (MYLA-251)
                Inst.Un(d, op, t, x) => {
                    if d != c || self.temp_uses[d] != 1 || op != "!" { return -1 }
                    last
                },
                Inst.Cmp(d, op, t, x, y) => {
                    if d != c || self.temp_uses[d] != 1 { return -1 }
                    match t {
                        Type.TFloat(w) => { if !(op == "<" || op == "<=" || op == ">" || op == ">=") { return -1 } },
                        _ => {},
                    }
                    last
                },
                _ => -1,
            },
            _ => -1,
        }
    }

    // The call `c`, whose result the function `f` returns at once, as a
    // jump reusing this frame (MYLA-126; `become`'s, D87): its words passed
    // as a call passes them (D119), those on the stack moved into the words
    // this function received there (its caller pops them; never more of
    // them), a function value's environment in %r10 and its code in %r11,
    // the saved registers restored, the frame left, and the callee jumped
    // to. A call of `f` itself keeps the frame and the saved registers: the
    // parameters take the new words, and it jumps to the entry block
    // (`entry`), a loop.
    fun emit_tail_call(var self, f: IrFunc, c: Inst, slot_off: [int32], entry: str, temp_base: int32) {
        var target = ""
        var ws: [int32] = []
        var fv = -1
        var again = false
        match c {
            Inst.Call(d, name, args) => {
                ws = args
                target = format("myla_{}", name)
                again = format(".Lret_{}", name) == self.epilogue
            },
            Inst.CallSret(name, res, args) => {
                ws = sret_words(res, args)
                target = format("myla_{}", name)
                again = format(".Lret_{}", name) == self.epilogue
            },
            Inst.CallInd(d, fn, args) => {
                ws = args
                fv = fn
                target = "*%r11"
            },
            Inst.CallIndSret(fn, res, args) => {
                ws = sret_words(res, args)
                fv = fn
                target = "*%r11"
            },
            _ => { return },
        }
        let m = ws.len() - REG_WORDS
        if m > self.arg_words { panic(format("internal error: a tail call with {} argument words on the stack in a function that received {}", m, self.arg_words)) }
        // the stack words, pushed the last first (but one already where it
        // goes, a parameter passed on in its place); the registers loaded
        // before anything is written over the words received
        var in_place: [bool] = []
        var k = 0
        while k < m {
            in_place.push(self.temp_src[ws[REG_WORDS + k]] == format("{}(%rbp)", 16 + 8 * k))
            k = k + 1
        }
        var i = m - 1
        while i >= 0 {
            if !in_place[i] { self.push_temp(ws[REG_WORDS + i], temp_base) }
            i = i - 1
        }
        i = 0
        while i < ws.len() && i < REG_WORDS {
            self.load_temp(ws[i], arg_reg(i), temp_base)
            i = i + 1
        }
        if fv >= 0 {
            self.load_temp(fv, "rax", temp_base)
            self.emit("movq 8(%rax), %r10")
            self.emit("movq (%rax), %r11")
        }
        i = 0
        while i < m {
            if !in_place[i] { self.emit(format("popq {}(%rbp)", 16 + 8 * i)) }
            i = i + 1
        }
        if again && !f.frame {
            self.emit_params(f, slot_off)
            self.emit(format("jmp {}", entry))
            return
        }
        self.restore_regs()
        self.emit("leave")
        self.emit(format("jmp {}", target))
    }

    // The callee-saved registers the function saved, restored (MYLA-121).
    fun restore_regs(var self) {
        var r = 0
        while r < self.saved_regs.len() {
            self.emit(format("movq {}(%rbp), %{}", -self.save_base - 8 * (r + 1), self.saved_regs[r]))
            r = r + 1
        }
    }

    // The comparison `cmp` and the branch `term` on it as a compare and a
    // conditional jump; the successor emitted next is fallen through to.
    fun emit_compare_branch(var self, cmp: Inst, term: Term, labels: [str], next: int32, temp_base: int32) {
        match cmp {
            Inst.Un(d, op, t, x) => {
                // `br !x, yes, no` is `br x, no, yes`
                self.emit_test(x, temp_base)
                match term {
                    Term.Br(c, yes, no) => {
                        if no == next { self.emit(format("je {}", labels[yes])) }
                        else {
                            self.emit(format("jne {}", labels[no]))
                            if yes != next { self.emit(format("jmp {}", labels[yes])) }
                        }
                    },
                    _ => {},
                }
                return
            },
            Inst.Cmp(d, op, t, x, y) => {
                match t {
                    Type.TFloat(w) => {
                        // `ucomisd b, a` gives a's order against b in the
                        // unsigned flags; unordered (NaN) sets CF and ZF, so
                        // `ja`/`jae` are false for it and their negations
                        // true, as the comparison is false (MYLA-249)
                        self.uses_float = true
                        let gt = op == ">" || op == ">="
                        let ra = self.xmm_in(x, "rax", "xmm0", temp_base)
                        let rb = self.xmm_in(y, "rcx", "xmm1", temp_base)
                        if gt { self.emit(format("ucomisd {}, {}", rb, ra)) } else { self.emit(format("ucomisd {}, {}", ra, rb)) }
                        let cond = if op == ">" || op == "<" { "a" } else { "ae" }
                        match term {
                            Term.Br(c, yes, no) => {
                                if no == next { self.emit(format("j{} {}", cond, labels[yes])) }
                                else {
                                    self.emit(format("j{} {}", negated_cond(cond), labels[no]))
                                    if yes != next { self.emit(format("jmp {}", labels[yes])) }
                                }
                            },
                            _ => {},
                        }
                        return
                    },
                    _ => {},
                }
                // the first operand where it is when that is a register; the
                // two swapped when the second is still in %rax
                var cop = op
                var left = self.reg_of(x)
                if left == "" && self.swap_operands(op, x, y) {
                    self.load_temp(y, "rax", temp_base)
                    left = "%rax"
                    cop = swapped_cmp(op)
                    self.emit(format("cmpq {}, {}", self.second_operand(op, x, temp_base), left))
                } else {
                    if left == "" {
                        self.load_temp(x, "rax", temp_base)
                        left = "%rax"
                    }
                    self.emit(format("cmpq {}, {}", self.second_operand(op, y, temp_base), left))
                }
                let cond = jump_cond(cop, int_signed(t))
                match term {
                    Term.Br(c, yes, no) => {
                        if no == next { self.emit(format("j{} {}", cond, labels[yes])) }
                        else {
                            self.emit(format("j{} {}", negated_cond(cond), labels[no]))
                            if yes != next { self.emit(format("jmp {}", labels[yes])) }
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
    }

    // A block's terminator; `next` is the block emitted after it (-1: none),
    // which a jump to it can fall through to.
    fun emit_term(var self, t: Term, labels: [str], next: int32, temp_base: int32) {
        match t {
            Term.Open => {},
            Term.Jmp(b) => {
                if b != next { self.emit(format("jmp {}", labels[b])) }
            },
            Term.Br(c, a, b) => {
                self.emit_test(c, temp_base)
                if b == next { self.emit(format("jnz {}", labels[a])) }
                else {
                    self.emit(format("jz {}", labels[b]))
                    if a != next { self.emit(format("jmp {}", labels[a])) }
                }
            },
            Term.Ret(v) => {
                if v >= 0 { self.load_temp(v, "rax", temp_base) }
                // the last block falls into the epilogue (MYLA-251)
                if next >= 0 { self.emit(format("jmp {}", self.epilogue)) }
            },
            // the call before it is the jump (`emit_tail_call`)
            Term.Become => {},
            Term.Suspend(b) => { self.emit_suspend(b, labels) },
            Term.Trap(kind, p) => { self.trap("jmp", "__trap_" + kind, p.line, p.col) },
            Term.Panic(m, p) => {
                self.load_temp(m, "rdi", temp_base)
                self.load_position(p.line, p.col, "rsi")
                self.emit("call __panic")
            },
        }
    }

    // An element's address and the load of it that follows, as one
    // addressing mode (MYLA-120); false when `a` and `b` aren't such a pair.
    fun emit_elem_load(var self, f: IrFunc, a: Inst, b: Inst, temp_base: int32) -> bool {
        return match a {
            Inst.Elem(e, c, i, stride, is_str, p) => {
                if self.temp_uses[e] != 1 { return false }
                let ok = match b {
                    Inst.LoadAt(d, q, off, width) => q == e && off == 0 && !is_str,
                    Inst.Load8(d, q) => q == e && is_str,
                    _ => false,
                }
                if !ok { return false }
                self.load_temp(c, "rax", temp_base)
                self.load_temp(i, "rcx", temp_base)
                self.emit_elem_check(p.line, p.col)
                let at = self.elem_operand(is_str, stride)
                match b {
                    Inst.LoadAt(d, q, off, width) => {
                        self.emit_load(width, f.temps[d], at)
                        self.store_temp(d, temp_base)
                    },
                    Inst.Load8(d, q) => {
                        self.emit(format("movzbl {}, %eax", at))
                        self.store_temp(d, temp_base)
                    },
                    _ => {},
                }
                true
            },
            _ => false,
        }
    }

    // The second operand of the integer operator `op`, the first being in
    // %rax already (MYLA-120): an immediate, a variable's slot or the
    // temporary's cell where `op` takes one (`takes_operand`), else the
    // temporary loaded into %rcx. With %rax loaded no store of another
    // temporary is held back, so a cell holds its value.
    fun second_operand(var self, op: str, t: int32, temp_base: int32) -> str {
        if takes_operand(op) {
            if self.temp_imm[t] != "" { return self.temp_imm[t] }
            if self.temp_src[t] != "" { return self.temp_src[t] }
            if self.temp_remat[t] == "" && !(self.pend_store != "" && self.pend_temp == t) {
                if self.temp_reg[t] != "" { return "%" + self.temp_reg[t] }
                return format("{}(%rbp)", self.temp_off[t])
            }
        }
        self.load_temp(t, "rcx", temp_base)
        return "%rcx"
    }

    // The arguments of a runtime helper into the calling registers.
    fun load_args(var self, args: [int32], temp_base: int32) {
        let regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
        var i = 0
        while i < args.len() {
            self.load_temp(args[i], regs[i], temp_base)
            i = i + 1
        }
    }

    // How each temporary defined once, by a constant, a string's or symbol's
    // address or a slot's address, is recomputed where it is read instead of
    // being kept in a slot: the instruction up to its register's name
    // (MYLA-108); "" for the other temporaries.
    fun remat_texts(var self, f: IrFunc, slot_off: [int32], defs: [int32]) -> [str] {
        var out: [str] = []
        var src: [str] = []
        var imm: [str] = []
        var frame: [int32] = []
        for t in f.temps {
            out.push("")
            src.push("")
            imm.push("")
            frame.push(0)
        }
        for b in f.blocks {
            var i = 0
            while i < b.insts.len() {
                let inst = b.insts[i]
                match inst {
                    Inst.Const(d, t, v) => { if defs[d] == 1 { out[d] = self.def_text(inst, slot_off) } },
                    Inst.Str(d, text) => { if defs[d] == 1 { out[d] = self.def_text(inst, slot_off) } },
                    Inst.Addr(d, sl) => { if defs[d] == 1 { out[d] = self.def_text(inst, slot_off) } },
                    Inst.Label(d, sym) => { if defs[d] == 1 { out[d] = self.def_text(inst, slot_off) } },
                    _ => {},
                }
                // a slot's address: its offset from %rbp (never 0), for loads
                // and stores through it
                match inst {
                    Inst.Addr(d, s) => { if defs[d] == 1 { frame[d] = slot_off[s] } },
                    _ => {},
                }
                // an integer constant that fits a sign-extended 32-bit immediate
                match inst {
                    Inst.Const(d, t, v) => {
                        match t {
                            Type.TInt(w, sg) => {
                                let x = wrapped(v, w, sg)
                                if defs[d] == 1 && x >= -2147483648 && x <= 2147483647 { imm[d] = format("${}", x) }
                            },
                            Type.TBool => { if defs[d] == 1 { imm[d] = format("${}", v) } },
                            // a null address (D121)
                            Type.TPtr => { if defs[d] == 1 && v == 0 { imm[d] = "$0" } },
                            Type.TChar => { if defs[d] == 1 && v <= 2147483647 { imm[d] = format("${}", v) } },
                            _ => {},
                        }
                    },
                    _ => {},
                }
                // a variable's value read where every read of it follows,
                // in this block, with nothing in between that writes a slot
                match inst {
                    Inst.Load(d, s) => {
                        if defs[d] == 1 && reads_before_writes(b.insts, b.term, i, d, self.temp_uses[d]) {
                            if self.slot_reg[s] != "" { src[d] = "%" + self.slot_reg[s] } else if self.in_frame { src[d] = format("{}(%r15)", slot_off[s]) } else { src[d] = format("{}(%rbp)", slot_off[s]) }
                            out[d] = format("movq {}, %", src[d])
                        }
                    },
                    _ => {},
                }
                i = i + 1
            }
        }
        self.temp_src = src
        self.temp_imm = imm
        self.temp_frame = frame
        return out
    }

    // The code computing a constant, a string's or symbol's address or a
    // slot's address, up to its register's name; "" for other instructions.
    fun def_text(var self, inst: Inst, slot_off: [int32]) -> str {
        return match inst {
            Inst.Const(d, t, v) => match t {
                Type.TFloat(w) => {
                    self.uses_float = true
                    format("movabsq ${}, %", v)
                }
                Type.TInt(w, s) => int_const_text(wrapped(v, w, s))
                _ => format("movq ${}, %", v)
            }
            Inst.Str(d, text) => format("leaq {}(%rip), %", self.string_label(text))
            Inst.Addr(d, s) => self.slot_addr_text(slot_off[s])
            Inst.Label(d, sym) => format("leaq {}(%rip), %", sym)
            _ => ""
        }
    }

    // The code computing the address of the slot at `off`, up to its
    // register's name: in the stack frame, or a frame function's heap frame.
    fun slot_addr_text(self, off: int32) -> str {
        if self.in_frame { return format("leaq {}(%r15), %", off) }
        return format("leaq {}(%rbp), %", off)
    }

    // A constant or an address whose temporary is kept in its slot: computed
    // into %rax and stored.
    fun def_into_temp(var self, inst: Inst, d: int32, slot_off: [int32], temp_base: int32) {
        if self.temp_remat[d] != "" { return }
        self.emit(self.def_text(inst, slot_off) + "rax")
        self.store_temp(d, temp_base)
    }

    // Give each temporary that needs one a frame cell (`temp_off`), sharing
    // cells between temporaries whose lives don't overlap (MYLA-108): one
    // read and written within a single block gets a cell from its first
    // write to its last read (freed only after the instruction of that read,
    // which may still write its own result), by a linear scan in emission
    // order; one living in several blocks keeps a cell of its own. Returns
    // the number of cells.
    fun alloc_temps(var self, f: IrFunc, tc: Touches) -> int32 {
        let n = f.temps.len()
        var home: [int32] = []
        var cross: [bool] = []
        var last: [int32] = []
        var cell: [int32] = []
        var i = 0
        while i < n {
            home.push(-1)
            cross.push(false)
            last.push(-1)
            cell.push(-1)
            i = i + 1
        }
        // where each temporary lives and is last read
        var pos = 0
        for b in f.order {
            var i = tc.at[b]
            while i < tc.at[b] + f.blocks[b].insts.len() {
                var k = tc.wat[i]
                while k < tc.wat[i + 1] {
                    let t = tc.writes[k]
                    if home[t] < 0 { home[t] = b } else if home[t] != b { cross[t] = true }
                    k = k + 1
                }
                k = tc.rat[i]
                while k < tc.rat[i + 1] {
                    let t = tc.reads[k]
                    if home[t] < 0 { home[t] = b } else if home[t] != b { cross[t] = true }
                    last[t] = pos
                    k = k + 1
                }
                pos = pos + 1
                i = i + 1
            }
            for t in term_uses(f.blocks[b].term) {
                if home[t] < 0 { home[t] = b } else if home[t] != b { cross[t] = true }
                last[t] = pos
            }
            pos = pos + 1
        }
        var cells = 0
        i = 0
        while i < n {
            if cross[i] && self.temp_remat[i] == "" && self.temp_uses[i] > 0 && self.temp_reg[i] == "" {
                cell[i] = cells
                cells = cells + 1
            }
            i = i + 1
        }
        // the others, block by block
        var free: [int32] = []
        var active: [int32] = []
        pos = 0
        for b in f.order {
            var i = tc.at[b]
            while i < tc.at[b] + f.blocks[b].insts.len() {
                // the cells of the temporaries read for the last time freed,
                // the list rebuilt only then (MYLA-124)
                var ended = false
                for t in active {
                    if last[t] < pos { ended = true }
                }
                if ended {
                    var still: [int32] = []
                    for t in active {
                        if last[t] < pos { free.push(cell[t]) } else { still.push(t) }
                    }
                    active = still
                }
                var k = tc.wat[i]
                while k < tc.wat[i + 1] {
                    let t = tc.writes[k]
                    if !cross[t] && cell[t] < 0 && self.temp_remat[t] == "" && self.temp_uses[t] > 0 && self.temp_reg[t] == "" {
                        if free.len() > 0 { cell[t] = free.pop() } else {
                            cell[t] = cells
                            cells = cells + 1
                        }
                        active.push(t)
                    }
                    k = k + 1
                }
                pos = pos + 1
                i = i + 1
            }
            pos = pos + 1
        }
        var off: [int32] = []
        for c in cell { off.push(-8 * (c + 1)) }
        self.temp_off = off
        return cells
    }

    // No temporary or slot in a register (yet).
    fun clear_regs(var self, f: IrFunc) {
        var treg: [str] = []
        for t in f.temps { treg.push("") }
        var sreg: [str] = []
        for s in f.slots { sreg.push("") }
        self.temp_reg = treg
        self.slot_reg = sreg
        self.saved_regs = []
    }

    // Which temporaries and slots live in a callee-saved register (MYLA-121;
    // `temp_reg`, `slot_reg`) and which of them the function saves
    // (`saved_regs`). The candidates are the temporaries that would need a
    // frame cell and the scalar slots (8 bytes, owning nothing) that only
    // `load` and `store` touch, parameters included. Each has one live
    // interval over the reachable blocks in emission order (liveness across
    // blocks by backward dataflow); a linear scan hands out %rbx and
    // %r12-%r15, and when they run out the value with fewer reads and writes
    // (weighted by loop depth) gives way. Not under `-g`, whose variables
    // live in the frame. `clear_regs` has emptied the tables.
    fun alloc_regs(var self, f: IrFunc, reach: [bool], tc: Touches) {
        if self.debug { return }
        let nt = f.temps.len()
        let nv = nt + f.slots.len()
        // value v: the temporary v below nt, else the slot v - nt
        var cand: [bool] = []
        var i = 0
        while i < nt {
            cand.push(self.temp_remat[i] == "" && self.temp_uses[i] > 0)
            i = i + 1
        }
        // a frame function's slots are in its frame, never in a register
        for sl in f.slots { cand.push(sl.size == 8 && !sl.owns && !f.frame) }
        for b in f.blocks {
            for inst in b.insts {
                match inst {
                    Inst.Addr(d, s) => { cand[nt + s] = false },
                    Inst.DropSlot(t, s) => { cand[nt + s] = false },
                    Inst.Init(s) => { cand[nt + s] = false },
                    Inst.Moved(s) => { cand[nt + s] = false },
                    _ => {},
                }
            }
        }
        let depth = loop_depths(f, reach)

        // what each reachable instruction and terminator reads and writes, in
        // emission order (`tv[tat[p]]` up to `tv[tat[p + 1]]` at position p:
        // v read, -1 - v written); and per candidate its first and last
        // position, its weight, and whether liveness has to follow it across
        // blocks (used in two blocks, or read before written in its block)
        var tv: [int32] = []
        var tat: [int32] = []
        var first: [int32] = []
        var last: [int32] = []
        var weight: [int64] = []
        var home: [int32] = []
        var global: [bool] = []
        var src_slot: [int32] = []
        i = 0
        while i < nv {
            first.push(-1)
            last.push(-1)
            weight.push(0)
            home.push(-1)
            global.push(false)
            if i < nt { src_slot.push(-1) }
            i = i + 1
        }
        var bstart: [int32] = []
        var bend: [int32] = []
        for b in f.blocks {
            bstart.push(-1)
            bend.push(-1)
        }
        // per position, how many before it call something or use %r8-%r11
        // (`clobbers`), which values in those registers can't live across
        var cpre: [int32] = [0]
        var pos = 0
        for b in f.order {
            if !reach[b] { continue }
            bstart[b] = pos
            var w: int64 = 1
            var d = 0
            while d < depth[b] && d < 3 {
                w = w * 10
                d = d + 1
            }
            var ii = tc.at[b]
            for inst in f.blocks[b].insts {
                tat.push(tv.len())
                var c = cpre[cpre.len() - 1]
                if clobbers(inst) { c = c + 1 }
                cpre.push(c)
                // a variable read where it is used is read there (`temp_src`)
                var k = tc.rat[ii]
                while k < tc.rat[ii + 1] {
                    let u = tc.reads[k]
                    if cand[u] { tv.push(u) }
                    if src_slot[u] >= 0 && cand[nt + src_slot[u]] { tv.push(nt + src_slot[u]) }
                    k = k + 1
                }
                match inst {
                    Inst.Load(t, sl) => {
                        if cand[nt + sl] { tv.push(nt + sl) }
                        if self.temp_src[t] != "" { src_slot[t] = sl }
                    },
                    Inst.Store(sl, v) => { if cand[nt + sl] { tv.push(-1 - (nt + sl)) } },
                    _ => {},
                }
                k = tc.wat[ii]
                while k < tc.wat[ii + 1] {
                    if cand[tc.writes[k]] { tv.push(-1 - tc.writes[k]) }
                    k = k + 1
                }
                pos = pos + 1
                ii = ii + 1
            }
            tat.push(tv.len())
            cpre.push(cpre[cpre.len() - 1])
            for u in term_uses(f.blocks[b].term) {
                if cand[u] { tv.push(u) }
                if src_slot[u] >= 0 && cand[nt + src_slot[u]] { tv.push(nt + src_slot[u]) }
            }
            bend[b] = pos
            pos = pos + 1
            // the block's positions, read before written
            var p = bstart[b]
            while p < pos {
                var k = tat[p]
                let end = match p + 1 < pos { true => tat[p + 1], false => tv.len() }
                while k < end {
                    var v = tv[k]
                    let read = v >= 0
                    if !read { v = -1 - v }
                    if first[v] < 0 {
                        first[v] = p
                        if read { global[v] = true }
                    }
                    last[v] = p
                    weight[v] = weight[v] + w
                    if home[v] < 0 { home[v] = b } else if home[v] != b { global[v] = true }
                    k = k + 1
                }
                p = p + 1
            }
        }
        tat.push(tv.len())
        let spans = self.live_spans(f, reach, cand, global, tv, tat, bstart, bend, first, last)
        first = spans.0
        last = spans.1

        // float temporaries whose interval holds no call (nothing clobbers
        // there) live in %xmm2..%xmm15, which need no save (MYLA-249); the
        // rest go through the scan below like any other value
        self.alloc_xmm(f, nt, cand, first, last, weight, cpre, pos)
        i = 0
        while i < nv {
            if (i < nt && self.temp_reg[i] != "") || (i >= nt && self.slot_reg[i - nt] != "") { cand[i] = false }
            i = i + 1
        }

        // the linear scan, intervals by their start
        var head: [int32] = []
        i = 0
        while i < pos {
            head.push(-1)
            i = i + 1
        }
        var link: [int32] = []
        var reg: [int32] = []
        i = 0
        while i < nv {
            link.push(-1)
            reg.push(-1)
            if cand[i] && first[i] >= 0 {
                link[i] = head[first[i]]
                head[first[i]] = i
            }
            i = i + 1
        }
        // the callee-saved registers, then %r8-%r11 for a value no position
        // of its interval clobbers (MYLA-134), which cost no save
        var names = ["rbx", "r12", "r13", "r14", "r15", "r8", "r9", "r10", "r11"]
        // the callee-saved registers come first; %r15 holds a frame
        // function's frame (D90)
        var ncallee = 5
        if f.frame {
            names = ["rbx", "r12", "r13", "r14", "r8", "r9", "r10", "r11"]
            ncallee = 4
        }
        let nr = names.len()
        var owner: [int32] = []
        while owner.len() < nr { owner.push(-1) }
        var p = 0
        while p < pos {
            var v = head[p]
            while v >= 0 {
                var r = 0
                while r < nr {
                    // read for the last time where v is written: an
                    // instruction reads its operands before it writes
                    if owner[r] >= 0 && last[owner[r]] <= p { owner[r] = -1 }
                    r = r + 1
                }
                var top = ncallee
                if cpre[last[v] + 1] - cpre[first[v]] == 0 { top = nr }
                // a free register, a caller-saved one first
                var pick = -1
                r = top - 1
                while r >= 0 && pick < 0 {
                    if owner[r] < 0 { pick = r }
                    r = r - 1
                }
                if pick < 0 {
                    // the lightest holder gives way to a heavier value
                    var low = 0
                    r = 1
                    while r < top {
                        if weight[owner[r]] < weight[owner[low]] { low = r }
                        r = r + 1
                    }
                    if weight[owner[low]] < weight[v] {
                        reg[owner[low]] = -1
                        pick = low
                    }
                }
                if pick >= 0 {
                    owner[pick] = v
                    reg[v] = pick
                }
                v = link[v]
            }
            p = p + 1
        }

        // a callee-saved register is worth its save and restore only with
        // enough use
        var used: [int64] = []
        while used.len() < nr { used.push(0) }
        i = 0
        while i < nv {
            if reg[i] >= 0 { used[reg[i]] = used[reg[i]] + weight[i] }
            i = i + 1
        }
        i = 0
        while i < nv {
            if reg[i] >= 0 && (reg[i] >= ncallee || used[reg[i]] >= REG_MIN_USE) {
                if i < nt { self.temp_reg[i] = names[reg[i]] } else { self.slot_reg[i - nt] = names[reg[i]] }
            }
            i = i + 1
        }
        var r = 0
        while r < ncallee {
            if used[r] >= REG_MIN_USE { self.saved_regs.push(names[r]) }
            r = r + 1
        }
    }

    // %xmm2..%xmm15 for the float values (temporaries, and variables' slots,
    // value v the slot v - nt from nt on) among `cand` whose interval
    // `first`..`last` no position clobbers (`cpre`), by a linear scan in
    // which a lighter value gives way to a heavier one (MYLA-249).
    fun alloc_xmm(var self, f: IrFunc, nt: int32, cand: [bool], first: [int32], last: [int32], weight: [int64], cpre: [int32], pos: int32) {
        let nv = nt + f.slots.len()
        var head: [int32] = []
        while head.len() < pos { head.push(-1) }
        var link: [int32] = []
        var i = 0
        while i < nv {
            link.push(-1)
            let ty = if i < nt { f.temps[i] } else { f.slots[i - nt].ty }
            let float = match ty { Type.TFloat(w) => true, _ => false }
            if cand[i] && float && first[i] >= 0 && cpre[last[i] + 1] - cpre[first[i]] == 0 {
                link[i] = head[first[i]]
                head[first[i]] = i
            }
            i = i + 1
        }
        let nr = 14
        var owner: [int32] = []
        var reg: [int32] = []
        while owner.len() < nr { owner.push(-1) }
        while reg.len() < nv { reg.push(-1) }
        var p = 0
        while p < pos {
            var v = head[p]
            while v >= 0 {
                var r = 0
                while r < nr {
                    if owner[r] >= 0 && last[owner[r]] <= p { owner[r] = -1 }
                    r = r + 1
                }
                var pick = -1
                r = 0
                while r < nr && pick < 0 {
                    if owner[r] < 0 { pick = r }
                    r = r + 1
                }
                if pick < 0 {
                    var low = 0
                    r = 1
                    while r < nr {
                        if weight[owner[r]] < weight[owner[low]] { low = r }
                        r = r + 1
                    }
                    if weight[owner[low]] < weight[v] {
                        reg[owner[low]] = -1
                        pick = low
                    }
                }
                if pick >= 0 {
                    owner[pick] = v
                    reg[v] = pick
                }
                v = link[v]
            }
            p = p + 1
        }
        i = 0
        while i < nv {
            if reg[i] >= 0 {
                let name = format("xmm{}", reg[i] + 2)
                if i < nt { self.temp_reg[i] = name } else { self.slot_reg[i - nt] = name }
            }
            i = i + 1
        }
    }

    // The %xmm register the temporary `t` lives in, or "".
    fun xmm_home(self, t: int32) -> str {
        let r = self.reg_of(t)
        if r.len() > 4 && r[1] == 'x' && r[2] == 'm' && r[3] == 'm' { return r }
        return ""
    }

    // The float temporary `t` in an %xmm register: its home, or loaded into
    // `gpr` and moved into `xmm`.
    fun xmm_in(var self, t: int32, gpr: str, xmm: str, temp_base: int32) -> str {
        let home = self.xmm_home(t)
        if home != "" { return home }
        let r = self.reg_of(t)
        if r != "" && self.temp_remat[t] == "" {
            self.emit(format("movq {}, %{}", r, xmm))   // a general-purpose register
            return "%" + xmm
        }
        self.load_temp(t, gpr, temp_base)
        self.emit(format("movq %{}, %{}", gpr, xmm))
        return "%" + xmm
    }

    // %xmm0, a float result, into the temporary `d`: moved into its %xmm
    // home, else through %rax as any value.
    fun xmm_result(var self, d: int32, temp_base: int32) {
        let home = self.xmm_home(d)
        if home != "" {
            if self.pend_store != "" { self.flush_temp_in_rax() }
            self.emit(format("movapd %xmm0, {}", home))
        } else {
            self.emit("movq %xmm0, %rax")
            self.store_temp(d, temp_base)
        }
    }

    // The intervals `first`..`last` (`alloc_regs`) stretched over each
    // reachable block that a value liveness follows across blocks is live
    // into or out of.
    fun live_spans(self, f: IrFunc, reach: [bool], cand: [bool], global: [bool], tv: [int32], tat: [int32], bstart: [int32], bend: [int32], first: [int32], last: [int32]) -> ([int32], [int32]) {
        var lo = first
        var hi = last
        // the values liveness follows, numbered densely
        var gid: [int32] = []
        var gval: [int32] = []
        var i = 0
        while i < cand.len() {
            if cand[i] && global[i] {
                gid.push(gval.len())
                gval.push(i)
            } else { gid.push(-1) }
            i = i + 1
        }
        let ng = gval.len()
        if ng == 0 { return (lo, hi) }
        let nw = (ng + 63) / 64
        let nb = f.blocks.len()
        // what each block reads before writing it (use) and writes (def)
        var use_bits: [int64] = []
        var def_bits: [int64] = []
        var live_in: [int64] = []
        var live_out: [int64] = []
        i = 0
        while i < nb * nw {
            use_bits.push(0)
            def_bits.push(0)
            live_in.push(0)
            live_out.push(0)
            i = i + 1
        }
        // and its successors (-1: none)
        var succ1: [int32] = []
        var succ2: [int32] = []
        for b in f.blocks {
            let ss = successors(b.term)
            succ1.push(match ss.len() > 0 { true => ss[0], false => -1 })
            succ2.push(match ss.len() > 1 { true => ss[1], false => -1 })
        }
        let one: int64 = 1
        for b in f.order {
            if !reach[b] { continue }
            let base = b * nw
            var k = tat[bstart[b]]
            while k < tat[bend[b] + 1] {
                var v = tv[k]
                let read = v >= 0
                if !read { v = -1 - v }
                let g = gid[v]
                if g >= 0 {
                    let at = base + g / 64
                    let bit = one << ((g % 64) as int64)
                    if read {
                        if def_bits[at] & bit == 0 { use_bits[at] = use_bits[at] | bit }
                    } else { def_bits[at] = def_bits[at] | bit }
                }
                k = k + 1
            }
        }
        // live in = use | (live out & ~def), live out = the successors' live in
        var changed = true
        while changed {
            changed = false
            var k = f.order.len() - 1
            while k >= 0 {
                let b = f.order[k]
                if reach[b] {
                    let base = b * nw
                    let s1 = succ1[b]
                    let s2 = succ2[b]
                    var j = 0
                    while j < nw {
                        var out: int64 = 0
                        if s1 >= 0 { out = live_in[s1 * nw + j] }
                        if s2 >= 0 { out = out | live_in[s2 * nw + j] }
                        live_out[base + j] = out
                        let inn = use_bits[base + j] | (out & ~def_bits[base + j])
                        if inn != live_in[base + j] {
                            live_in[base + j] = inn
                            changed = true
                        }
                        j = j + 1
                    }
                }
                k = k - 1
            }
        }
        for b in f.order {
            if !reach[b] { continue }
            let base = b * nw
            var g = 0
            while g < ng {
                let v = gval[g]
                let bit = one << ((g % 64) as int64)
                let at = base + g / 64
                if live_in[at] & bit != 0 {
                    if bstart[b] < lo[v] { lo[v] = bstart[b] }
                    if bstart[b] > hi[v] { hi[v] = bstart[b] }
                }
                if live_out[at] & bit != 0 {
                    if bend[b] < lo[v] { lo[v] = bend[b] }
                    if bend[b] > hi[v] { hi[v] = bend[b] }
                }
                g = g + 1
            }
        }
        return (lo, hi)
    }

    // Push the temporary `t` (a call's argument): straight from its slot, or
    // from the variable it was read from.
    fun push_temp(var self, t: int32, temp_base: int32) {
        if self.temp_src[t] != "" {
            self.emit("pushq " + self.temp_src[t])
            return
        }
        if self.temp_remat[t] != "" || (self.pend_store != "" && self.pend_temp == t) {
            self.load_temp(t, "rax", temp_base)
            self.emit("pushq %rax")
            return
        }
        if self.temp_reg[t] != "" { self.emit("pushq %" + self.temp_reg[t]) }
        else { self.emit(format("pushq {}(%rbp)", self.temp_off[t])) }
    }

    // The temporary `t` into `reg`. Read right after it was computed, it is
    // still in %rax: moved from there, and stored first only when something
    // else reads it too (MYLA-108).
    fun load_temp(var self, t: int32, reg: str, temp_base: int32) {
        if self.temp_remat[t] != "" {
            self.emit(self.temp_remat[t] + reg)
            return
        }
        if self.pend_store != "" && self.pend_temp == t {
            if self.temp_uses[t] > 1 { self.flush_temp_in_rax() } else {
                self.pend_store = ""
                self.pend_temp = -1
                // read once, by this: loaded straight into `reg` (MYLA-125)
                if reg != "rax" {
                    let n = self.text.len()
                    let folded = fold_load(self.text[n - 1], "%" + reg)
                    if folded != "" {
                        self.text[n - 1] = folded
                        return
                    }
                }
            }
            if reg != "rax" { self.emit(format("movq %rax, %{}", reg)) }
            return
        }
        if self.temp_reg[t] != "" {
            if self.temp_reg[t] != reg { self.emit(format("movq %{}, %{}", self.temp_reg[t], reg)) }
            return
        }
        self.emit(format("movq {}(%rbp), %{}", self.temp_off[t], reg))
    }

    // %rax into the temporary `t`: the store is held back until the next
    // line, which may read `t` (see `load_temp`); a temporary nothing reads
    // isn't stored.
    fun store_temp(var self, t: int32, temp_base: int32) {
        if self.pend_store != "" { self.flush_temp_in_rax() }
        if self.temp_uses[t] == 0 { return }
        if self.temp_reg[t] != "" { self.pend_store = "movq %rax, %" + self.temp_reg[t] }
        else { self.pend_store = format("movq %rax, {}(%rbp)", self.temp_off[t]) }
        self.pend_temp = t
    }

    // Whether the integer operation `op` on `a` and `b` is better done as
    // `b op' a` (`swapped_cmp`): `b` is still in %rax, `a` isn't.
    fun swap_operands(self, op: str, a: int32, b: int32) -> bool {
        if !(self.pend_store != "" && self.pend_temp == b) || a == b { return false }
        return op == "+" || op == "*" || op == "&" || op == "|" || op == "^" || op == "==" || op == "!=" || is_cmp(op)
    }

    // The register holding the temporary `t` now (MYLA-121): its own, or the
    // variable's it is read from; "" when it isn't in one (its store into
    // its register still held back, its value is in %rax).
    fun reg_of(self, t: int32) -> str {
        if self.pend_store != "" && self.pend_temp == t { return "" }
        if self.temp_reg[t] != "" { return "%" + self.temp_reg[t] }
        let src = self.temp_src[t]
        if src.len() > 0 && src[0] == '%' { return src }
        return ""
    }

    // The temporary `t` as the source of a store: an immediate, its
    // register, else loaded into %rax.
    fun value_operand(var self, t: int32, temp_base: int32) -> str {
        if self.temp_imm[t] != "" { return self.temp_imm[t] }
        let r = self.reg_of(t)
        if r != "" { return r }
        self.load_temp(t, "rax", temp_base)
        return "%rax"
    }

    // The flags of the temporary `t` against zero, for a jump.
    fun emit_test(var self, t: int32, temp_base: int32) {
        var r = self.reg_of(t)
        if r == "" {
            self.load_temp(t, "rax", temp_base)
            r = "%rax"
        }
        self.emit(format("testq {}, {}", r, r))
    }
}

// The least loop-weighted reads and writes of the values in a callee-saved
// register that pay for saving and restoring it (MYLA-121; on the compiler
// compiling itself, 4 and 12 ran equally fast and 12 ran 1.6% fewer
// instructions, 40 was slower).
const REG_MIN_USE: int64 = 12

// How many loops each reachable block of `f` is in: a jump back to a block
// emitted earlier closes a loop over the blocks emitted from there to it.
fun loop_depths(f: IrFunc, reach: [bool]) -> [int32] {
    var at: [int32] = []
    var depth: [int32] = []
    for b in f.blocks {
        at.push(-1)
        depth.push(0)
    }
    var k = 0
    while k < f.order.len() {
        at[f.order[k]] = k
        k = k + 1
    }
    k = 0
    while k < f.order.len() {
        let b = f.order[k]
        if reach[b] {
            for s in successors(f.blocks[b].term) {
                if at[s] <= k {
                    var j = at[s]
                    while j <= k {
                        depth[f.order[j]] = depth[f.order[j]] + 1
                        j = j + 1
                    }
                }
            }
        }
        k = k + 1
    }
    return depth
}

// The condition code of a conditional jump taken when `op` holds between
// two integers (signed or not), as `cmpq %rcx, %rax` compares them.
#test("<", true)["l"]
#test("<", false)["b"]
#test(">=", false)["ae"]
#test("!=", true)["ne"]
fun jump_cond(op: str, signed: bool) -> str {
    if op == "==" { return "e" }
    if op == "!=" { return "ne" }
    if op == "<" { if signed { return "l" } else { return "b" } }
    if op == "<=" { if signed { return "le" } else { return "be" } }
    if op == ">" { if signed { return "g" } else { return "a" } }
    if signed { return "ge" }
    return "ae"
}

// The index of the call in `insts` that the terminator `term` returns the
// result of at once, so it can be a tail call (`emit_tail_call`); -1 when
// there is none. After the call only a `moved`, debug information, the
// result stored into an owning slot that is then moved, or drops may follow;
// the drops go before the jump, so no argument may depend on what they drop
// (`drops_after_free`). No argument may be an address in this frame either,
// which the jump leaves (`passes_frame_address`).
#test([], Term.Jmp(6))[-1]
#test([], Term.Ret(0))[-1]
#test([], Term.Br(5, 5, 7))[-1]
fun tail_call_at(insts: [Inst], term: Term) -> int32 {
    let v = match term {
        Term.Ret(x) => x,
        _ => -2,
    }
    if v == -2 { return -1 }
    var i = insts.len() - 1
    var moved = -1
    while i >= 0 {
        match insts[i] {
            Inst.Call(d, name, args) => {
                if d != v { return -1 }
                return i
            },
            Inst.Moved(s) => { moved = s },
            Inst.Store(s, x) => {
                // the result kept in an owning slot only to be moved out
                if x != v || s != moved { return -1 }
            },
            // dropped before the jump when no argument depends on it
            // (`drops_after_free`)
            Inst.DropSlot(t, s) => {},
            Inst.Loc(p) => {},
            Inst.Scope(open) => {},
            Inst.Bind(n, s) => {},
            _ => { return -1 },
        }
        i = i - 1
    }
    return -1
}

// Whether no argument of the call `insts[at]` depends on a slot dropped
// after it (MYLA-126), so those drops can go before a tail call: an argument
// read from the slot, through it, or kept in it (a call's result held by a
// statement's temporary) depends on it, and so does one read from a slot
// that owns nothing (a borrowing `let`, a match's copy) whatever was put
// into that slot depends on (a parameter's slot excepted: the caller keeps
// its value alive); one taken from another block may depend on anything.
fun drops_after_free(f: IrFunc, insts: [Inst], at: int32) -> bool {
    var dropped: [int32] = []
    var j = at + 1
    while j < insts.len() {
        match insts[j] {
            Inst.DropSlot(t, s) => { dropped.push(s) },
            _ => {},
        }
        j = j + 1
    }
    if dropped.len() == 0 { return true }
    var none: [int32] = []
    let args = match insts[at] {
        Inst.Call(d, name, a) => a,
        _ => none,
    }
    for a in args {
        var work = [a]
        var seen: [int32] = []
        while work.len() > 0 {
            let t = work.pop()
            if contains_int(seen, t) { continue }
            seen.push(t)
            // kept in a dropped slot
            var k = 0
            while k < at {
                match insts[k] {
                    Inst.Store(s, x) => { if x == t && contains_int(dropped, s) { return false } },
                    _ => {},
                }
                k = k + 1
            }
            // where it comes from
            var found = false
            k = at - 1
            while k >= 0 && !found {
                match insts[k] {
                    Inst.Load(d, s) => {
                        if d == t {
                            found = true
                            if contains_int(dropped, s) { return false }
                            if !f.slots[s].owns && f.slots[s].word == -1 {
                                let src = filled_from(insts, k, s)
                                if src.len() == 0 { return false }
                                for u in src { work.push(u) }
                            }
                        }
                    },
                    Inst.Addr(d, s) => {
                        if d == t {
                            found = true
                            if contains_int(dropped, s) { return false }
                            if !f.slots[s].owns && f.slots[s].word == -1 {
                                let src = filled_from(insts, k, s)
                                if src.len() == 0 { return false }
                                for u in src { work.push(u) }
                            }
                        }
                    },
                    Inst.LoadAt(d, p, off, width) => { if d == t { found = true; work.push(p) } },
                    Inst.Offset(d, p, off) => { if d == t { found = true; work.push(p) } },
                    Inst.Elem(d, c, i, stride, is_str, pos) => { if d == t { found = true; work.push(c) } },
                    Inst.Const(d, ty, v) => { if d == t { found = true } },
                    Inst.Str(d, text) => { if d == t { found = true } },
                    Inst.Bin(d, op, lt, rt, x, y, pos) => { if d == t { found = true } },
                    Inst.Cmp(d, op, ty, x, y) => { if d == t { found = true } },
                    Inst.Un(d, op, ty, x) => { if d == t { found = true } },
                    Inst.Cast(d, ft, tt, x) => { if d == t { found = true } },
                    Inst.Call(d, name, xs) => { if d == t { found = true } },
                    Inst.Rt(d, name, xs) => { if d == t { found = true } },
                    _ => {},
                }
                k = k - 1
            }
            if !found { return false }
        }
    }
    return true
}

// The temporaries stored or copied into the slot `s` before `insts[at]`, in
// this block (`drops_after_free`); none when it isn't filled here.
fun filled_from(insts: [Inst], at: int32, s: int32) -> [int32] {
    var out: [int32] = []
    var addrs: [int32] = []
    var k = 0
    while k < at {
        match insts[k] {
            Inst.Store(x, v) => { if x == s { out.push(v) } },
            Inst.Addr(d, x) => { if x == s { addrs.push(d) } },
            Inst.Copy(d, src, size) => { if contains_int(addrs, d) { out.push(src) } },
            _ => {},
        }
        k = k + 1
    }
    return out
}

// Whether the code of `inst` calls something (a function, a runtime helper,
// a retain or drop walk) or uses %r8-%r11 itself: a value in one of those
// registers can't live across it (MYLA-134). A trap never returns.
#test(Inst.Frame(2))[true]
#test(Inst.Init(0))[false]
#test(Inst.Init(1))[false]
fun clobbers(inst: Inst) -> bool {
    return match inst {
        Inst.Const(d, t, v) => false,
        Inst.Str(d, text) => false,
        Inst.Load(d, s) => false,
        Inst.Store(s, v) => false,
        Inst.Addr(d, s) => false,
        Inst.Offset(d, p, off) => false,
        Inst.LoadAt(d, p, off, width) => false,
        Inst.StoreAt(p, off, v, width) => false,
        Inst.Copy(d, src, size) => false,
        Inst.Bin(d, op, lt, rt, a, b, pos) => float_rem(op, lt),
        Inst.Cmp(d, op, t, a, b) => false,
        Inst.Un(d, op, t, a) => false,
        Inst.Cast(d, from_t, to_t, a) => false,
        Inst.Init(s) => false,
        Inst.Elem(d, c, i, stride, is_str, pos) => false,
        Inst.Load8(d, p) => false,
        Inst.Check(v, kind, pos) => false,
        Inst.Global(d, sym, width) => false,
        Inst.Moved(s) => false,
        Inst.Label(d, sym) => false,
        Inst.Loc(p) => false,
        Inst.Bind(name, s) => false,
        Inst.Scope(open) => false,
        Inst.Rt(d, name, args) => !(name == "__sqrt" || name == "__f64_bits" || name == "__f64_from_bits"),
        _ => true,
    }
}

// The SSE instruction of a float arithmetic operator.
#test("+")["addsd"]
#test("/")["divsd"]
fun float_insn(op: str) -> str {
    if op == "+" { return "addsd" }
    if op == "-" { return "subsd" }
    if op == "*" { return "mulsd" }
    return "divsd"
}

// Whether a binary operation is a float `%`, which calls `__fmod`.
#test("%", Type.TFloat(64))[true]
#test("+", Type.TFloat(32))[false]
#test("+", Type.TFloat(64))[false]
fun float_rem(op: str, t: Type) -> bool {
    if op != "%" { return false }
    return match t {
        Type.TFloat(w) => true,
        _ => false,
    }
}

#test([1, 2], 2)[true]
#test([1, 2], 3)[false]
fun contains_int(xs: [int32], x: int32) -> bool {
    for y in xs {
        if y == x { return true }
    }
    return false
}

// Whether the call `c` passes an argument that may be an address in the
// caller's frame (`frame_addresses`).
#test(Inst.Call(1, "Shape.area", [0]), [false, false])[false]
#test(Inst.Call(2, "inc", [1]), [false, false, false])[false]
#test(Inst.Call(4, "Money.compare", [2, 3]), [true, false, true, false, false])[true]
fun passes_frame_address(c: Inst, in_frame: [bool]) -> bool {
    return match c {
        Inst.Call(d, name, args) => {
            for a in args {
                if in_frame[a] { return true }
            }
            false
        },
        _ => false,
    }
}

// Which temporaries of `f` may hold an address in its frame: a slot's
// address, or one computed from such an address.
fun frame_addresses(f: IrFunc) -> [bool] {
    var out: [bool] = []
    for t in f.temps { out.push(false) }
    var changed = true
    while changed {
        changed = false
        for b in f.blocks {
            for inst in b.insts {
                match inst {
                    Inst.Addr(d, s) => { if !out[d] { out[d] = true; changed = true } },
                    Inst.Offset(d, p, off) => { if out[p] && !out[d] { out[d] = true; changed = true } },
                    _ => {},
                }
            }
        }
    }
    return out
}

// k when the immediate `imm` is `$2^k` (0 < k < 32), else 0.
#test("$8")[3]
#test("$2")[1]
#test("$6")[0]
#test("$1")[0]
#test("$-8")[0]
fun power_of_two(imm: str) -> int32 {
    let one: int64 = 1
    var k = 1
    while k < 32 {
        if imm == format("${}", one << (k as int64)) { return k }
        k = k + 1
    }
    return 0
}

// The comparison that holds for `b, a` exactly when `op` holds for `a, b`;
// any other operator is the same both ways.
#test("<")[">"]
#test(">=")["<="]
#test("==")["=="]
#test("+")["+"]
fun swapped_cmp(op: str) -> str {
    if op == "<" { return ">" }
    if op == ">" { return "<" }
    if op == "<=" { return ">=" }
    if op == ">=" { return "<=" }
    return op
}

// The condition code that holds exactly when `cond` doesn't.
#test("l")["ge"]
#test("be")["a"]
#test("e")["ne"]
fun negated_cond(cond: str) -> str {
    let pairs = [("e", "ne"), ("l", "ge"), ("le", "g"), ("b", "ae"), ("be", "a")]
    for p in pairs {
        if cond == p.0 { return p.1 }
        if cond == p.1 { return p.0 }
    }
    return cond
}

// Which blocks of `f` the entry block reaches.
fun reachable_blocks(f: IrFunc) -> [bool] {
    var reach: [bool] = []
    for b in f.blocks { reach.push(false) }
    if f.blocks.len() == 0 { return reach }
    var work: [int32] = [0]
    reach[0] = true
    while work.len() > 0 {
        let b = work[work.len() - 1]
        work.pop()
        for s in successors(f.blocks[b].term) {
            if !reach[s] {
                reach[s] = true
                work.push(s)
            }
        }
    }
    return reach
}

// The instruction loading the integer `v` into a register, up to its name:
// `movq` sign-extends a 32-bit immediate, shorter than `movabsq` (MYLA-120).
#test(5)["movq $5, %"]
#test(-1)["movq $-1, %"]
#test(4294967295)["movabsq $4294967295, %"]
fun int_const_text(v: int64) -> str {
    if v >= -2147483648 && v <= 2147483647 { return format("movq ${}, %", v) }
    return format("movabsq ${}, %", v)
}

// The constant `v` as a `w`-bit integer (signed or not) holds it in 64 bits,
// as `wrap` leaves it in %rax.
#test(0, 32, true)[0]
#test(41, 32, true)[41]
#test(1114111, 64, false)[1114111]
fun wrapped(v: int64, w: int32, signed: bool) -> int64 {
    if w == 64 { return v }
    if signed {
        let shift = 64 - w
        return (v << shift) >> shift
    }
    let one: int64 = 1
    return v & ((one << w) - 1)
}

// Whether all `n` reads of the temporary `t`, written by `insts[at]`, come
// later in the same block (its terminator included) with only instructions
// in between that write no slot, so the slot still holds what was read.
#test([Inst.Load(11, 2)], Term.Ret(11), 0, 11, 1)[true]
#test([Inst.Load(16, 1)], Term.Ret(16), 0, 16, 1)[true]
#test([Inst.Load(12, 1), Inst.Moved(1)], Term.Ret(12), 0, 12, 1)[false]
fun reads_before_writes(insts: [Inst], term: Term, at: int32, t: int32, n: int32) -> bool {
    var seen = 0
    var j = at + 1
    while j < insts.len() && seen < n {
        for u in inst_uses(insts[j]) {
            if u == t { seen = seen + 1 }
        }
        if seen < n && !writes_no_slot(insts[j]) { return false }
        j = j + 1
    }
    if seen < n {
        for u in term_uses(term) {
            if u == t { seen = seen + 1 }
        }
    }
    return seen == n
}

// Whether `inst` writes no frame slot, directly or through an address.
#test(Inst.Moved(1))[false]
#test(Inst.Moved(2))[false]
#test(Inst.Addr(1, 2))[true]
fun writes_no_slot(inst: Inst) -> bool {
    return match inst {
        Inst.Const(d, t, v) => true
        Inst.Str(d, text) => true
        Inst.Load(d, s) => true
        Inst.Addr(d, s) => true
        Inst.Offset(d, p, off) => true
        Inst.LoadAt(d, p, off, width) => true
        Inst.Bin(d, op, lt, rt, a, b, pos) => true
        Inst.Cmp(d, op, t, a, b) => true
        Inst.Un(d, op, t, a) => true
        Inst.Cast(d, from_t, to_t, a) => true
        Inst.Elem(d, c, i, stride, is_str, pos) => true
        Inst.Load8(d, p) => true
        Inst.Check(v, kind, pos) => true
        Inst.Global(d, sym, w) => true
        Inst.Label(d, sym) => true
        Inst.Loc(p) => true
        Inst.Bind(name, s) => true
        Inst.Scope(open) => true
        _ => false
    }
}


// The offsets of `f`'s slots: in its heap frame after the header (D90) for a
// frame function, else `layout_slots`'.
fun slots_at(f: IrFunc, below: int32) -> [int32] {
    if !f.frame { return layout_slots(f, below) }
    let (pos, extent) = slot_positions(f, false)
    var off: [int32] = []
    for p in pos { off.push(FRAME_HEADER + p) }
    return off
}

// The size of a frame function's heap frame: the header, then its slots.
fun frame_size(f: IrFunc) -> int32 {
    let (pos, extent) = slot_positions(f, false)
    return FRAME_HEADER + extent
}

// Where each slot of `f` goes in its area of the frame, from its start, and
// the area's size (MYLA-183): first the slots that aren't the local of an
// inner scope, one after the other; then each inner scope's locals, after
// those of the scopes around it, so the locals of two scopes that are never
// open at once (two blocks, two match arms) share cells. With `words`, a
// parameter that came on the stack (D119) takes no room here (-1); one that
// came in registers has a cell, as a local has.
fun slot_positions(f: IrFunc, words: bool) -> ([int32], int32) {
    var pos: [int32] = []
    var cursor = 0
    for s in f.slots {
        if (words && s.word >= REG_WORDS) || s.scope > 0 { pos.push(-1) } else {
            pos.push(cursor)
            cursor = cursor + (s.size + 7) / 8 * 8
        }
    }
    let n = f.scope_parent.len()
    var own: [int32] = []
    var i = 0
    while i < n {
        own.push(0)
        i = i + 1
    }
    for s in f.slots {
        if s.scope > 0 && !(words && s.word >= REG_WORDS) { own[s.scope] = own[s.scope] + (s.size + 7) / 8 * 8 }
    }
    // a scope's area starts where its parent's locals end (a scope's index
    // is greater than its parent's)
    var start: [int32] = []
    var extent = cursor
    i = 0
    while i < n {
        let parent = f.scope_parent[i]
        var at = cursor
        if parent > 0 { at = start[parent] + own[parent] }
        start.push(at)
        if at + own[i] > extent { extent = at + own[i] }
        i = i + 1
    }
    var fill = start
    var k = 0
    while k < f.slots.len() {
        let s = f.slots[k]
        if s.scope > 0 && !(words && s.word >= REG_WORDS) {
            pos[k] = fill[s.scope]
            fill[s.scope] = fill[s.scope] + (s.size + 7) / 8 * 8
        }
        k = k + 1
    }
    return pos, extent
}

// An async function's frame begins `[resume fn][caller frame][state][task]
// [link][its task's first frame][flags][parent task][actor handed]` (D90;
// the link chains the frames waiting for an actor or a task, D92; the next
// three serve cancelling by asking, D96, the last dropping frames once a
// task has failed, D94, D97); its first slot, its result when it has one,
// follows.
const FRAME_HEADER: int32 = 72

// The frame offset of each slot of `f`: a parameter that came on the stack
// above %rbp (D119), the others below the first `below` bytes.
fun layout_slots(f: IrFunc, below: int32) -> [int32] {
    let (pos, extent) = slot_positions(f, true)
    var off: [int32] = []
    var k = 0
    while k < f.slots.len() {
        let s = f.slots[k]
        if s.word >= REG_WORDS { off.push(16 + 8 * (s.word - REG_WORDS)) } else { off.push(-(below + pos[k] + (s.size + 7) / 8 * 8)) }
        k = k + 1
    }
    return off
}

// A call's argument words with an aggregate result's address first.
#test(4, [5, 6])[[4, 5, 6]]
fun sret_words(r: int32, args: [int32]) -> [int32] {
    var ws = [r]
    for a in args { ws.push(a) }
    return ws
}

// How many argument words the call `c` passes on the stack (D119).
fun stack_words(c: Inst) -> int32 {
    let n = match c {
        Inst.Call(d, name, args) => args.len(),
        Inst.CallSret(name, r, args) => args.len() + 1,
        Inst.CallInd(d, fv, args) => args.len(),
        Inst.CallIndSret(fv, r, args) => args.len() + 1,
        _ => 0,
    }
    if n > REG_WORDS { return n - REG_WORDS }
    return 0
}

// Which slots of `f` an instruction reads: loads it, takes its address or
// drops it.
fun read_slots(f: IrFunc) -> [bool] {
    var read: [bool] = []
    for s in f.slots { read.push(false) }
    for b in f.blocks {
        for inst in b.insts {
            match inst {
                Inst.Load(d, s) => { read[s] = true },
                Inst.Addr(d, s) => { read[s] = true },
                Inst.DropSlot(t, s) => { read[s] = true },
                _ => {},
            }
        }
    }
    return read
}

// The load of the `width`-byte scalar at `src` into %rax, zero- or
// sign-extended as the type `t` of what it loads says (D120).
#test(8, Type.TBool, "(%rax)")["movq (%rax), %rax"]
#test(1, Type.TBool, "(%rax)")["movzbl (%rax), %eax"]
#test(4, Type.TInt(32, true), "(%rax)")["movslq (%rax), %rax"]
fun load_insn(width: int32, t: Type, src: str) -> str {
    if width == 8 { return format("movq {}, %rax", src) }
    let signed = match t {
        Type.TInt(w, sg) => sg,
        _ => false,
    }
    if width == 4 {
        if signed { return format("movslq {}, %rax", src) }
        return format("movl {}, %eax", src)
    }
    if width == 2 {
        if signed { return format("movswq {}, %rax", src) }
        return format("movzwl {}, %eax", src)
    }
    if signed { return format("movsbq {}, %rax", src) }
    return format("movzbl {}, %eax", src)
}

// The store of the low `width` bytes of `v` (an immediate or a register)
// at `dst` (D120).
#test(8, "%rbx", "(%rcx)")["movq %rbx, (%rcx)"]
#test(1, "%r12", "(%rcx)")["movb %r12b, (%rcx)"]
#test(1, "$1", "(%rcx)")["movb $1, (%rcx)"]
fun store_insn(width: int32, v: str, dst: str) -> str {
    if width == 8 { return format("movq {}, {}", v, dst) }
    var suffix = "l"
    if width == 1 { suffix = "b" }
    if width == 2 { suffix = "w" }
    return format("mov{} {}, {}", suffix, narrow_operand(v, width), dst)
}

// Whether the operand `v` is an %xmm register.
#test("%xmm3")[true]
#test("%rax")[false]
fun text_has_xmm(v: str) -> bool {
    return v.len() > 4 && v[1] == 'x' && v[2] == 'm' && v[3] == 'm'
}
