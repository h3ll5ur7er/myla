// ir_x86.my -- IR → x86-64 assembly (MYLA-103, D79; wiki: Architecture/IR).
//
// `emit_ir` is a method of the code generator, so every function is emitted
// with its pools (string literals, runtime-error positions, helper flags), its
// debug information, calling convention and runtime. The frame gives every
// slot that isn't an argument word, and every temporary, an 8-byte slot of
// its own; the instruction sequences for operations, casts, `print` and the
// like are shared with the code generator (`emit_int_op`, `emit_float_op`,
// `emit_cast`, `emit_unary`, `emit_print`, …), which kept the old one-pass
// path and the IR alike while both existed (MYLA-103 to MYLA-107).

from .ast import FunData
from .checker import Type
from .codegen import CodeGen, CgBinding
from .ir import IrFunc, Inst, Term, use_counts, def_counts, inst_defs

impl CodeGen {
    // Emit `f`, the IR of the function `fd`, as `myla_<mangled>`.
    fun emit_ir(var self, f: IrFunc, fd: FunData, mangled: str) {
        self.emit_ir_at(f, self.sig_of(fd.name).decl_id, fd.line, fd.col, mangled)
    }

    // Emit `f` as `myla_<mangled>`: a function or lambda declared by the node
    // `decl_id` (its file) at `line:col`.
    fun emit_ir_at(var self, f: IrFunc, decl_id: int32, line: int32, col: int32, mangled: str) {
        self.temp_uses = use_counts(f)
        self.ret_type = f.ret
        // the frame: each slot that isn't an argument word, then each temporary
        var slot_off: [int32] = []
        var cursor = 0
        for s in f.slots {
            if s.word >= 0 {
                push(slot_off, 16 + 8 * s.word)
            } else {
                cursor = cursor + (s.size + 7) / 8 * 8
                push(slot_off, -cursor)
            }
        }
        let temp_base = cursor
        cursor = cursor + 8 * len(f.temps)
        self.temp_remat = self.remat_texts(f, slot_off)
        let frame = (cursor + 15) / 16 * 16
        self.epilogue = format(".Lret_{}", mangled)
        var labels: [str] = []
        for b in f.blocks { push(labels, self.label()) }

        self.cur_file = self.file_number(decl_id)
        self.cur_path = self.path_of(decl_id)
        self.emit(format("myla_{}:", mangled))
        self.dbg_begin_function(format("myla_{}", mangled))
        self.emit_loc(line, col)
        self.emit("pushq %rbp")
        self.emit("movq %rsp, %rbp")
        if frame > 0 { self.emit(format("subq ${}, %rsp", frame)) }
        self.dbg_push_scope()

        var k = 0
        while k < len(f.order) {
            let b = f.order[k]
            self.emit(format("{}:", labels[b]))
            for inst in f.blocks[b].insts { self.emit_inst(f, inst, slot_off, temp_base) }
            var next = -1
            if k + 1 < len(f.order) { next = f.order[k + 1] }
            self.emit_term(f.blocks[b].term, labels, next, temp_base)
            k = k + 1
        }

        self.emit(format("{}:", self.epilogue))
        self.emit("leave")
        self.emit("ret")
        self.end_loc()
        self.dbg_pop_scope()
        self.dbg_end_function()
        self.emit("")
    }

    fun emit_inst(var self, f: IrFunc, inst: Inst, slot_off: [int32], temp_base: int32) {
        match inst {
            // a constant or an address is recomputed where it is read
            // (`remat_texts`), unless its temporary is written elsewhere too
            Inst.Const(d, t, v) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Str(d, text) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Load(d, s) => {
                self.emit(format("movq {}(%rbp), %rax", slot_off[s]))
                self.store_temp(d, temp_base)
            },
            Inst.Store(s, v) => {
                self.load_temp(v, "rax", temp_base)
                self.emit(format("movq %rax, {}(%rbp)", slot_off[s]))
            },
            Inst.Addr(d, s) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Offset(d, p, off) => {
                self.load_temp(p, "rax", temp_base)
                if off != 0 { self.emit(format("addq ${}, %rax", off)) }
                self.store_temp(d, temp_base)
            },
            Inst.LoadAt(d, p, off) => {
                self.load_temp(p, "rax", temp_base)
                self.emit(format("movq {}(%rax), %rax", off))
                self.store_temp(d, temp_base)
            },
            Inst.StoreAt(p, off, v) => {
                self.load_temp(p, "rcx", temp_base)
                self.load_temp(v, "rax", temp_base)
                self.emit(format("movq %rax, {}(%rcx)", off))
            },
            Inst.Copy(d, src, size) => {
                self.load_temp(src, "rsi", temp_base)
                self.load_temp(d, "rdi", temp_base)
                self.emit_copy(size)
            },
            Inst.Bin(d, op, t, rt, a, b, pos) => {
                self.load_temp(a, "rax", temp_base)
                self.load_temp(b, "rcx", temp_base)
                match t {
                    Type.TFloat(w) => { self.emit_float_op(op, rt) },
                    _ => { self.emit_int_op(op, t, rt, pos.line, pos.col) },
                }
                self.store_temp(d, temp_base)
            },
            Inst.Cmp(d, op, t, a, b) => {
                self.load_temp(a, "rax", temp_base)
                self.load_temp(b, "rcx", temp_base)
                match t {
                    Type.TFloat(w) => { self.emit_float_op(op, t) },
                    _ => { self.emit_int_op(op, t, Type.TBool, 0, 0) },
                }
                self.store_temp(d, temp_base)
            },
            Inst.Un(d, op, t, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_unary(op, t)
                self.store_temp(d, temp_base)
            },
            Inst.Cast(d, src, tgt, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_cast(src, tgt)
                self.store_temp(d, temp_base)
            },
            Inst.Call(d, name, args) => {
                // the first argument at the lowest address: push the last first
                var i = len(args) - 1
                while i >= 0 {
                    self.push_temp(args[i], temp_base)
                    i = i - 1
                }
                self.emit(format("call myla_{}", name))
                if len(args) > 0 { self.emit(format("addq ${}, %rsp", 8 * len(args))) }
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.CallSret(name, r, args) => {
                // the result's address is the first word, below the arguments
                var i = len(args) - 1
                while i >= 0 {
                    self.push_temp(args[i], temp_base)
                    i = i - 1
                }
                self.push_temp(r, temp_base)
                self.emit(format("call myla_{}", name))
                self.emit(format("addq ${}, %rsp", 8 * (len(args) + 1)))
            },
            Inst.Label(d, sym) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.CallInd(d, fv, args) => {
                // the arguments, then the environment, then the call
                var i = len(args) - 1
                while i >= 0 {
                    self.push_temp(args[i], temp_base)
                    i = i - 1
                }
                self.load_temp(fv, "rax", temp_base)
                self.emit("pushq 8(%rax)")
                self.emit("call *(%rax)")
                self.emit(format("addq ${}, %rsp", 8 * (len(args) + 1)))
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.CallIndSret(fv, r, args) => {
                var i = len(args) - 1
                while i >= 0 {
                    self.push_temp(args[i], temp_base)
                    i = i - 1
                }
                self.load_temp(fv, "rax", temp_base)
                self.emit("pushq 8(%rax)")
                self.load_temp(r, "rcx", temp_base)
                self.emit("pushq %rcx")
                self.emit("call *(%rax)")
                self.emit(format("addq ${}, %rsp", 8 * (len(args) + 2)))
            },
            Inst.Rt(d, name, args) => {
                self.load_args(args, temp_base)
                if name == "__float_to_str" { self.uses_float = true }
                self.emit(format("call {}", name))
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.RetainVal(t, v) => {
                self.load_temp(v, "rax", temp_base)
                self.emit("incq -8(%rax)")
            },
            Inst.Retain(t, p) => {
                self.load_temp(p, "r8", temp_base)
                self.retain("r8", 0, t)
            },
            Inst.DropSlot(t, s) => { self.drop_value("rbp", slot_off[s], t) },
            Inst.DropAt(t, p) => {
                // the walk keeps the address in callee-saved %rbx across the
                // drop calls
                self.emit("pushq %rbx")
                self.load_temp(p, "rbx", temp_base)
                self.walk_member("rbx", 0, t, false)
                self.emit("popq %rbx")
            },
            Inst.Init(s) => {},
            Inst.Moved(s) => {},
            Inst.RtPair(d, d2, name, args) => {
                self.load_args(args, temp_base)
                self.emit(format("call {}", name))
                self.store_temp(d, temp_base)
                self.emit("movq %rdx, %rax")
                self.store_temp(d2, temp_base)
            },
            Inst.Check(v, kind, p) => {
                self.load_temp(v, "rax", temp_base)
                self.emit("testq %rax, %rax")
                self.trap("jz", "__trap_" + kind, p.line, p.col)
            },
            Inst.SbAppend(h, v) => {
                // the string's length and bytes
                self.load_temp(v, "rsi", temp_base)
                self.emit("movq (%rsi), %rdx")
                self.emit("addq $8, %rsi")
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
            },
            Inst.SbAppendRange(h, v, a, b, p) => {
                // a range: 0 <= start <= end <= len
                self.load_temp(b, "rcx", temp_base)
                self.emit("movslq %ecx, %rcx")
                self.load_temp(a, "rdx", temp_base)
                self.emit("movslq %edx, %rdx")
                self.load_temp(v, "rsi", temp_base)
                self.emit_sb_range(p.line, p.col)
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
            },
            Inst.SbAppendByte(h, b) => {
                // the byte on the stack
                self.load_temp(b, "rax", temp_base)
                self.emit("pushq %rax")
                self.emit("movq %rsp, %rsi")
                self.emit("movq $1, %rdx")
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
                self.emit("addq $8, %rsp")
            },
            Inst.SbBuild(d, c) => {
                self.load_temp(c, "rax", temp_base)
                self.emit_sb_build()
                self.store_temp(d, temp_base)
            },
            Inst.Global(d, sym, w) => {
                if w == 4 { self.emit(format("movslq {}(%rip), %rax", sym)) } else { self.emit(format("movq {}(%rip), %rax", sym)) }
                self.store_temp(d, temp_base)
            },
            Inst.Exit(v) => {
                // the exit system call
                self.load_temp(v, "rax", temp_base)
                self.emit("movl %eax, %edi")
                self.emit("movq $60, %rax")
                self.emit("syscall")
            },
            Inst.MapRemove(mt, h, c, k) => {
                // the holder, then the cell, below the key
                self.load_temp(h, "rax", temp_base)
                self.emit("pushq %rax")
                self.load_temp(c, "rax", temp_base)
                self.emit("pushq %rax")
                self.load_temp(k, "rsi", temp_base)
                self.emit_map_remove(mt)
            },
            Inst.Elem(d, c, i, stride, is_str, p) => {
                self.load_temp(c, "rax", temp_base)
                self.load_temp(i, "rcx", temp_base)
                self.emit_elem_addr(is_str, stride, p.line, p.col)
                self.store_temp(d, temp_base)
            },
            Inst.Load8(d, p) => {
                self.load_temp(p, "rax", temp_base)
                self.emit("movzbl (%rax), %eax")
                self.store_temp(d, temp_base)
            },
            Inst.Cow(d, t, h) => {
                self.load_temp(h, "rax", temp_base)
                self.cow_unique(t)
                self.store_temp(d, temp_base)
            },
            Inst.Append(d, h, c, stride) => {
                // grow when full (publishing the new cell), then
                // count the element and point at its slot
                let have = self.label()
                self.load_temp(c, "rax", temp_base)
                self.emit("movq (%rax), %rdx")
                self.emit("movq 8(%rax), %rcx")
                self.emit("cmpq %rcx, %rdx")
                self.emit(format("jb {}", have))
                self.emit("movq %rax, %rdi")
                self.emit(format("movq ${}, %rsi", stride))
                self.emit("call __list_grow")
                self.load_temp(h, "rcx", temp_base)
                self.emit("movq %rax, (%rcx)")
                self.emit(format("{}:", have))
                self.emit("movq (%rax), %rdx")
                self.emit("leaq 1(%rdx), %rcx")
                self.emit("movq %rcx, (%rax)")
                self.emit(format("imulq ${}, %rdx", stride))
                self.emit("leaq 16(%rax,%rdx), %rax")
                self.store_temp(d, temp_base)
            },
            Inst.Pop(d, c, stride, p) => {
                // trap when empty, else uncount the last element
                self.load_temp(c, "rax", temp_base)
                self.emit("movq (%rax), %rcx")
                self.emit("testq %rcx, %rcx")
                self.trap("jz", "__trap_pop", p.line, p.col)
                self.emit("decq %rcx")
                self.emit("movq %rcx, (%rax)")
                self.emit(format("imulq ${}, %rcx", stride))
                self.emit("leaq 16(%rax,%rcx), %rax")
                self.store_temp(d, temp_base)
            },
            Inst.Print(t, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_print(t)
            },
            Inst.Loc(p) => { self.emit_loc(p.line, p.col) },
            Inst.Bind(name, s) => {
                let slot = f.slots[s]
                if slot.word >= 0 {
                    let b = CgBinding { name: name, kind: "param", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, true, true)
                } else {
                    let b = CgBinding { name: name, kind: "local", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, false, false)
                }
            },
            Inst.Scope(open) => {
                if open { self.dbg_push_scope() } else { self.dbg_pop_scope() }
            },
        }
    }

    // A block's terminator; `next` is the block emitted after it (-1: none),
    // which a jump to it can fall through to.
    fun emit_term(var self, t: Term, labels: [str], next: int32, temp_base: int32) {
        match t {
            Term.Open => {},
            Term.Jmp(b) => {
                if b != next { self.emit(format("jmp {}", labels[b])) }
            },
            Term.Br(c, a, b) => {
                self.load_temp(c, "rax", temp_base)
                self.emit("testq %rax, %rax")
                self.emit(format("jz {}", labels[b]))
                if a != next { self.emit(format("jmp {}", labels[a])) }
            },
            Term.Ret(v) => {
                if v >= 0 { self.load_temp(v, "rax", temp_base) }
                self.emit(format("jmp {}", self.epilogue))
            },
            Term.Trap(kind, p) => { self.trap("jmp", "__trap_" + kind, p.line, p.col) },
            Term.Panic(m, p) => {
                self.load_temp(m, "rdi", temp_base)
                self.load_position(p.line, p.col, "rsi")
                self.emit("call __panic")
            },
        }
    }

    // The arguments of a runtime helper into the calling registers.
    fun load_args(var self, args: [int32], temp_base: int32) {
        let regs = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
        var i = 0
        while i < len(args) {
            self.load_temp(args[i], regs[i], temp_base)
            i = i + 1
        }
    }

    // How each temporary defined once, by a constant, a string's or symbol's
    // address or a slot's address, is recomputed where it is read instead of
    // being kept in a slot: the instruction up to its register's name
    // (MYLA-108); "" for the other temporaries.
    fun remat_texts(var self, f: IrFunc, slot_off: [int32]) -> [str] {
        var out: [str] = []
        for t in f.temps { push(out, "") }
        let defs = def_counts(f)
        for b in f.blocks {
            for inst in b.insts {
                let text = self.def_text(inst, slot_off)
                for d in inst_defs(inst) {
                    if defs[d] == 1 { out[d] = text }
                }
            }
        }
        return out
    }

    // The code computing a constant, a string's or symbol's address or a
    // slot's address, up to its register's name; "" for other instructions.
    fun def_text(var self, inst: Inst, slot_off: [int32]) -> str {
        return match inst {
            Inst.Const(d, t, v) => match t {
                Type.TFloat(w) => {
                    self.uses_float = true
                    format("movabsq ${}, %", v)
                }
                Type.TInt(w, s) => format("movabsq ${}, %", wrapped(v, w, s))
                _ => format("movq ${}, %", v)
            }
            Inst.Str(d, text) => format("leaq {}(%rip), %", self.string_label(text))
            Inst.Addr(d, s) => format("leaq {}(%rbp), %", slot_off[s])
            Inst.Label(d, sym) => format("leaq {}(%rip), %", sym)
            _ => ""
        }
    }

    // A constant or an address whose temporary is kept in its slot: computed
    // into %rax and stored.
    fun def_into_temp(var self, inst: Inst, d: int32, slot_off: [int32], temp_base: int32) {
        if self.temp_remat[d] != "" { return }
        self.emit(self.def_text(inst, slot_off) + "rax")
        self.store_temp(d, temp_base)
    }

    // Push the temporary `t` (a call's argument): straight from its slot.
    fun push_temp(var self, t: int32, temp_base: int32) {
        if self.temp_remat[t] != "" || (self.pend_store != "" && self.pend_temp == t) {
            self.load_temp(t, "rax", temp_base)
            self.emit("pushq %rax")
            return
        }
        self.emit(format("pushq {}(%rbp)", -(temp_base + 8 * (t + 1))))
    }

    // The temporary `t` into `reg`. Read right after it was computed, it is
    // still in %rax: moved from there, and stored first only when something
    // else reads it too (MYLA-108).
    fun load_temp(var self, t: int32, reg: str, temp_base: int32) {
        if self.temp_remat[t] != "" {
            self.emit(self.temp_remat[t] + reg)
            return
        }
        if self.pend_store != "" && self.pend_temp == t {
            if self.temp_uses[t] > 1 { self.flush_temp() } else {
                self.pend_store = ""
                self.pend_temp = -1
            }
            if reg != "rax" { self.emit(format("movq %rax, %{}", reg)) }
            return
        }
        self.emit(format("movq {}(%rbp), %{}", -(temp_base + 8 * (t + 1)), reg))
    }

    // %rax into the temporary `t`: the store is held back until the next
    // line, which may read `t` (see `load_temp`); a temporary nothing reads
    // isn't stored.
    fun store_temp(var self, t: int32, temp_base: int32) {
        if self.pend_store != "" { self.flush_temp() }
        if self.temp_uses[t] == 0 { return }
        self.pend_store = format("movq %rax, {}(%rbp)", -(temp_base + 8 * (t + 1)))
        self.pend_temp = t
    }
}

// The constant `v` as a `w`-bit integer (signed or not) holds it in 64 bits,
// as `wrap` leaves it in %rax.
fun wrapped(v: int64, w: int32, signed: bool) -> int64 {
    if w == 64 { return v }
    if signed {
        let shift = 64 - w
        return (v << shift) >> shift
    }
    let one: int64 = 1
    return v & ((one << w) - 1)
}
