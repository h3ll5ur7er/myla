// ir_x86.my -- IR → x86-64 assembly (MYLA-103, D79; wiki: Architecture/IR).
//
// `emit_ir` is a method of the code generator, so every function is emitted
// with its pools (string literals, runtime-error positions, helper flags), its
// debug information, calling convention and runtime. The frame gives every
// slot that isn't an argument word, and every temporary, an 8-byte slot of
// its own; the instruction sequences for operations, casts, `print` and the
// like are shared with the code generator (`emit_int_op`, `emit_float_op`,
// `emit_cast`, `emit_unary`, `emit_print`, …), which kept the old one-pass
// path and the IR alike while both existed (MYLA-103 to MYLA-107).

from .ast import FunData
from .checker import Type
from .codegen import CodeGen, CgBinding, int_signed, same_int, takes_operand, is_cmp, fold_load, fold_load_for_reader, text_at, has_text, is_aggregate, is_actor_t, is_tfloat32, REG_WORDS, arg_reg, spilled_word, narrow_operand, int_width_cg, tls_offset, TLS_SIZE
from .ir import IrFunc, Inst, Term, Touches, Slot, ENV_WORD, Intrinsic, is_rc_dec, is_rc_atomic, is_cas, is_atomic_at, render_func, touches, use_counts, def_counts, inst_uses, term_uses, successors, ends_in_call, Pos
from .ir_util import reachable_blocks, wrapped
from .ssa import promote, add_ssa_stats
from .parser import expr_of, stmt_of, type_expr_of, block_of, pattern_of, fun_of  // AST values for #test cases (MYLA-184)

impl CodeGen {
    // Emit `f`, the IR of the function `fd`, as `myla_<mangled>`.
    fun emit_ir(var self, f: IrFunc, fd: FunData, mangled: str) {
        self.emit_ir_at(f, self.sig_of(fd.name).decl_id, fd.line, fd.col, mangled)
    }

    // An ownership instruction reaching the translation, which
    // `expand_ownership` makes plain first.
    fun unplain(self) {
        panic("internal error: an ownership instruction reached the x86 translation")
    }

    // `f` with the owners a block drops after a call that replaces the
    // function (a tail call: MYLA-126) dropped before it instead, where the
    // translation emits them: when no argument of the call depends on them
    // and the call is made in place of the function (as the block's
    // translation decides it).
    fun hoist_tail_drops(self, f0: IrFunc) -> IrFunc {
        if self.debug || f0.frame { return f0 }
        var f = f0
        var words = 0
        for s in f.slots {
            if s.word >= 0 && s.word + s.size / 8 > words { words = s.word + s.size / 8 }
        }
        var arg_words = 0
        if words > REG_WORDS { arg_words = words - REG_WORDS }
        var in_frame: [bool] = []
        var b = 0
        while b < f.blocks.len() {
            let insts = f.blocks[b].insts
            let tail = tail_call_at(insts, f.blocks[b].term)
            var moves = tail >= 0 && tail + 1 < insts.len() && drops_after_free(f, insts, tail) && stack_words(insts[tail]) <= arg_words
            if moves {
                if in_frame.len() == 0 { in_frame = frame_addresses(f) }
                moves = !passes_frame_address(insts[tail], in_frame)
            }
            if moves {
                var out: [Inst] = []
                var j = 0
                while j < tail {
                    out.push(insts[j])
                    j = j + 1
                }
                var rest: [Inst] = []
                j = tail + 1
                while j < insts.len() {
                    match insts[j] {
                        Inst.DropSlot(t, sl) => { out.push(insts[j]) },
                        _ => { rest.push(insts[j]) },
                    }
                    j = j + 1
                }
                out.push(insts[tail])
                for x in rest { out.push(x) }
                f.blocks[b].insts = out
            }
            b = b + 1
        }
        return f
    }

    // Emit `f` as `myla_<mangled>`: a function or lambda declared by the node
    // `decl_id` (its file) at `line:col`.
    fun emit_ir_at(var self, f0: IrFunc, decl_id: int32, line: int32, col: int32, mangled: str) {
        // a program refused for a `become` of an instance (MYLA-272) builds
        // nothing more: its type errors are what it gets
        if self.refused.len() > 0 { return }
        // its labels its own (MYLA-552): wasm32's code has none
        if !self.wasm { self.begin_labels(mangled) }
        // D123's prototype: the scalar slots promoted first (`--ssa`; not
        // under -g, whose debugger reads variables from their slots)
        var f = f0
        if self.ssa && !self.debug && !f0.frame {
            let promoted = promote(f0, loop_depths(f0, reachable_blocks(f0)))
            f = promoted.0
            self.ssa_stats = add_ssa_stats(self.ssa_stats, promoted.1)
        }
        if self.keep_ir && self.ssa { self.ir_texts.push(render_func(f)) }
        // the ownership instructions as plain operations and calls
        // (MYLA-162), the owners a tail call drops after it first moved
        // before it
        if self.wasm {
            // wasm's (MYLA-158), calls in tail position `return_call`s too
            // (MYLA-283)
            self.emit_wasm(self.expand_ownership(self.hoist_tail_drops(f)), decl_id, line, col, mangled)
            return
        }
        if self.a64 {
            // aarch64's translation, calls in tail position jumps too
            // (MYLA-283)
            self.emit_a64(self.expand_ownership(self.hoist_tail_drops(f)), decl_id, line, col, mangled)
            self.begin_labels("")
            return
        }
        f = self.expand_ownership(self.hoist_tail_drops(f))
        let tc = touches(f)
        self.temp_uses = use_counts(f, tc)
        self.ret_type = f.ret
        let reach = reachable_blocks(f)
        // the frame: the temporaries' cells next to %rbp (the most used, so
        // the most reached with 1-byte offsets), then each slot that isn't an
        // argument word, then the saved registers. Which temporaries need a
        // cell or get a register depends on what is recomputed, which
        // depends on the slots' offsets and registers: laid out twice.
        self.clear_regs(f)
        // an async function's frame function: its slots in the heap frame
        // %r15 holds (D90)
        self.in_frame = f.frame
        self.resume_blocks = []
        if f.frame {
            // the points reachable code resumes at
            var bi = 0
            while bi < f.blocks.len() {
                if reach[bi] {
                    match f.blocks[bi].term { Term.Suspend(rb) => { if !contains_int(self.resume_blocks, rb) { self.resume_blocks.push(rb) } }, _ => {} }
                }
                bi = bi + 1
            }
        }
        let defs = def_counts(f, tc)
        self.temp_remat = self.remat_texts(f, slots_at(f, 0, []), defs)
        self.alloc_regs(f, reach, tc)
        if f.frame { self.saved_regs.push("r15") }
        let cells = self.alloc_temps(f, tc)
        // a slot living in a register all its life has no cell
        var inreg: [bool] = []
        for r in self.slot_reg { inreg.push(r != "") }
        let slot_off = slots_at(f, 8 * cells, inreg)
        self.temp_remat = self.remat_texts(f, slot_off, defs)
        var cursor = 8 * cells
        if !f.frame {
            let (pos, extent) = slot_positions(f, true, inreg)
            cursor = cursor + extent
        }
        let saves = cursor
        cursor = cursor + 8 * self.saved_regs.len()
        // what a tail call needs (MYLA-126): the argument words the caller
        // pushed on the stack (D119), where the saved registers are, and
        // (worked out for the first candidate) the temporaries holding an
        // address in this frame
        var words = 0
        for s in f.slots {
            // a parameter passed by value takes as many words as it has (D88)
            if s.word >= 0 && s.word + s.size / 8 > words { words = s.word + s.size / 8 }
        }
        // a frame function's one argument is its frame, in %rdi
        if f.frame { words = 1 }
        var in_frame: [bool] = []
        self.save_base = saves
        self.arg_words = 0
        if words > REG_WORDS { self.arg_words = words - REG_WORDS }
        let temp_base = 0
        let frame = (cursor + 15) / 16 * 16
        self.epilogue = self.epilogue_label(mangled)
        var labels: [str] = []
        for b in f.blocks { labels.push(self.label()) }

        self.cur_file = self.file_number(decl_id)
        self.cur_path = self.path_of(decl_id)
        self.emit(format("myla_{}:", mangled))
        self.dbg_begin_function(format("myla_{}", mangled))
        self.emit_loc(line, col)
        // a function with nothing in its frame (no cells, no saved
        // registers, no arguments on the stack) sets up none, but under -g,
        // whose debugger finds frames by %rbp
        self.frameless = frame == 0 && self.saved_regs.len() == 0 && self.arg_words == 0 && !self.debug && !f.frame
        let prologue_at = self.text.len()
        if !self.frameless {
            self.emit("pushq %rbp")
            self.emit("movq %rsp, %rbp")
        }
        if frame > 0 { self.emit(format("subq ${}, %rsp", frame)) }
        // the callee-saved registers it uses, and the parameters living in
        // registers (MYLA-121)
        var r = 0
        while r < self.saved_regs.len() {
            self.emit(format("movq %{}, {}(%rbp)", self.saved_regs[r], -saves - 8 * (r + 1)))
            r = r + 1
        }
        if !f.frame { self.emit_params(f, slot_off) }
        if f.frame {
            // the frame, and the point it resumes at (state 0: the start)
            self.emit("movq %rdi, %r15")
            if self.resume_blocks.len() > 0 {
                self.emit("movq 16(%r15), %rax")
                var ri = 0
                while ri < self.resume_blocks.len() {
                    self.emit(format("cmpq ${}, %rax", ri + 1))
                    self.emit(format("je {}", labels[self.resume_blocks[ri]]))
                    ri = ri + 1
                }
            }
        }
        self.dbg_push_scope()

        // a block nothing reaches (after a `return`, MYLA-120) has no code; its
        // debug scopes and variables stay, so the scopes stay nested
        var k = 0
        while k < f.order.len() {
            let b = f.order[k]
            if !reach[b] {
                for inst in f.blocks[b].insts {
                    match inst {
                        Inst.Scope(open) => { self.emit_inst(f, inst, slot_off, temp_base) },
                        Inst.Bind(name, s) => { self.emit_inst(f, inst, slot_off, temp_base) },
                        _ => {},
                    }
                }
                k = k + 1
                continue
            }
            self.emit(format("{}:", labels[b]))
            let insts = f.blocks[b].insts
            let fused = self.fused_compare(insts, f.blocks[b].term)
            var tail = -1
            let becomes = match f.blocks[b].term { Term.Become => true, _ => false }
            // `suspend` after a call: the call replaces the function (D90)
            let suspend_call = match f.blocks[b].term { Term.Suspend(sb) => ends_in_call(insts), _ => false }
            // `become`'s call always replaces the function (D87), under -g too
            if becomes || suspend_call { tail = insts.len() - 1 }
            else {
                if !self.debug && !f.frame { tail = tail_call_at(insts, f.blocks[b].term) }
                if tail >= 0 && !drops_after_free(f, insts, tail) { tail = -1 }
                if tail >= 0 && stack_words(insts[tail]) > self.arg_words { tail = -1 }
                if tail >= 0 {
                    if in_frame.len() == 0 { in_frame = frame_addresses(f) }
                    if passes_frame_address(insts[tail], in_frame) { tail = -1 }
                }
            }
            var stop = insts.len()
            if tail >= 0 { stop = tail }
            var i = 0
            while i < stop {
                let shift = match insts[i] { Inst.Bin(d, op, lt, rt, x, y, pos) => op == "<<", _ => false }
                var checked = 0
                if !shift && i + 2 < stop && i + 2 != fused { checked = self.emit_checked_op(insts, i, if i + 3 != fused { stop } else { i + 3 }, temp_base) }
                if checked > 0 { i = i + checked }
                else if shift && i + 2 < stop && i + 2 != fused && self.emit_scaled(f, insts[i], insts[i + 1], insts[i + 2], temp_base) { i = i + 3 }
                else if i + 1 < stop && i + 1 != fused && self.emit_pair(f, insts[i], insts[i + 1], temp_base) { i = i + 2 }
                else {
                    if i != fused { self.emit_inst(f, insts[i], slot_off, temp_base) }
                    i = i + 1
                }
            }
            // the next block with code, which a jump to it falls through to
            var next = -1
            var nk = k + 1
            while nk < f.order.len() && next < 0 {
                if reach[f.order[nk]] { next = f.order[nk] }
                nk = nk + 1
            }
            if tail >= 0 {
                match f.blocks[b].term { Term.Suspend(sb) => { self.emit_state(sb) }, _ => {} }
                self.emit_tail_call(f, insts[tail], slot_off, labels[0], temp_base)
            }
            else if fused >= 0 { self.emit_compare_branch(insts[fused], f.blocks[b].term, labels, next, temp_base) }
            else { self.emit_term(f.blocks[b].term, labels, next, temp_base) }
            k = k + 1
        }

        self.emit(format("{}:", self.epilogue))
        self.restore_regs()
        if !self.frameless { self.emit("leave") }
        // the caller pops the argument words it pushed (D119)
        self.emit("ret")
        self.emit_cold_traps()
        // cells reserved for temporaries whose values never left %rax: a
        // body that doesn't reach its frame after all sets up none either
        if !self.frameless && self.saved_regs.len() == 0 && self.arg_words == 0 && !self.debug && !f.frame { self.drop_unused_frame(prologue_at) }
        self.end_loc()
        self.dbg_pop_scope()
        self.dbg_end_function()
        self.emit("")
        if f.frame { self.emit_frame_new_ir(f, mangled) }
        self.in_frame = false
        self.begin_labels("")
    }

    // The load of the `width`-byte scalar at `src` into %rax (D120); a
    // `float32` element, 4 bytes, widened to the double a temporary holds.
    fun emit_load(var self, width: int32, t: Type, src: str) {
        if width == 4 && is_tfloat32(t) {
            self.uses_float = true
            self.emit(format("cvtss2sd {}, %xmm0", src))
            self.emit("movq %xmm0, %rax")
            return
        }
        self.emit(load_insn(width, t, src))
    }

    // The store of the low `width` bytes of `v` (an immediate or a
    // register), of type `t`, at `dst` (D120); a `float32` element narrowed
    // from the double a temporary holds.
    fun emit_store(var self, width: int32, t: Type, v: str, dst: str) {
        if width == 4 && is_tfloat32(t) {
            self.uses_float = true
            if text_has_xmm(v) { self.emit(format("cvtsd2ss {}, %xmm0", v)) }
            else {
                self.emit(format("movq {}, %xmm0", v))
                self.emit("cvtsd2ss %xmm0, %xmm0")
            }
            self.emit(format("movss %xmm0, {}", dst))
            return
        }
        self.emit(store_insn(width, v, dst))
    }

    // The parameters into their homes (D119): the words that came in
    // registers (and a lambda's environment, in %r10) stored into their
    // frame cells, those living in registers moved there all at once, then
    // the registers of those that came on the stack loaded. One nothing
    // reads is left where it came (but under -g, for the debugger).
    fun emit_params(var self, f: IrFunc, slot_off: [int32]) {
        let read = read_slots(f)
        var dst: [str] = []
        var src: [str] = []
        var si = 0
        while si < f.slots.len() {
            let s = f.slots[si]
            if (s.word == ENV_WORD || (s.word >= 0 && s.word < REG_WORDS)) && (read[si] || self.debug) {
                var source = "%r10"
                if s.word >= 0 { source = "%" + arg_reg(s.word) }
                if self.slot_reg[si] != "" {
                    dst.push("%" + self.slot_reg[si])
                    src.push(source)
                } else if s.inline {
                    // passed by value (D88): each word into its cell, one
                    // past the registers from the stack
                    var k = 0
                    while k < s.size / 8 {
                        let w = s.word + k
                        if w < REG_WORDS { self.emit(format("movq %{}, {}(%rbp)", arg_reg(w), slot_off[si] + 8 * k)) }
                        else {
                            self.emit(format("movq {}, %rax", spilled_word(w)))
                            self.emit(format("movq %rax, {}(%rbp)", slot_off[si] + 8 * k))
                        }
                        k = k + 1
                    }
                } else { self.emit(format("movq {}, {}(%rbp)", source, slot_off[si])) }
            }
            si = si + 1
        }
        self.emit_moves(dst, src)
        si = 0
        while si < f.slots.len() {
            if f.slots[si].word >= REG_WORDS && self.slot_reg[si] != "" { self.emit(format("movq {}(%rbp), %{}", slot_off[si], self.slot_reg[si])) }
            si = si + 1
        }
    }

    // The register moves `src[i]` into `dst[i]`, as if all at once: a move
    // whose destination no other move still reads goes first; in a cycle,
    // a destination's value is saved in %rax and read from there.
    fun emit_moves(var self, dst: [str], src: [str]) {
        var source = src
        var done: [bool] = []
        var left = 0
        var i = 0
        while i < dst.len() {
            done.push(dst[i] == source[i])
            if !done[i] { left = left + 1 }
            i = i + 1
        }
        while left > 0 {
            var moved = false
            i = 0
            while i < dst.len() {
                if !done[i] {
                    var read = false
                    var j = 0
                    while j < dst.len() {
                        if !done[j] && j != i && source[j] == dst[i] { read = true }
                        j = j + 1
                    }
                    if !read {
                        self.emit(format("movq {}, {}", source[i], dst[i]))
                        done[i] = true
                        left = left - 1
                        moved = true
                    }
                }
                i = i + 1
            }
            if !moved {
                i = 0
                while done[i] { i = i + 1 }
                self.emit(format("movq {}, %rax", dst[i]))
                var j = 0
                while j < dst.len() {
                    if !done[j] && source[j] == dst[i] { source[j] = "%rax" }
                    j = j + 1
                }
            }
        }
    }

    // A call's argument words `ws` (D119): the first `REG_WORDS` into their
    // registers, the rest pushed, the last first; how many were pushed,
    // which the caller pops after the call. Nothing an argument is read
    // from lives in an argument register (a value living across a call is
    // in a callee-saved one), so the registers are loaded in turn.
    fun pass_words(var self, ws: [int32], temp_base: int32) -> int32 {
        var i = ws.len() - 1
        while i >= REG_WORDS {
            self.push_temp(ws[i], temp_base)
            i = i - 1
        }
        self.load_words(ws, temp_base)
        if ws.len() > REG_WORDS { return ws.len() - REG_WORDS }
        return 0
    }

    // The first REG_WORDS words of `ws` into the argument registers as if all
    // at once (MYLA-162): those in registers by one parallel move, then the
    // others loaded; so a value may sit in any caller-saved register up to
    // the call that reads it, an argument register included.
    fun load_words(var self, ws: [int32], temp_base: int32) {
        let n = match ws.len() < REG_WORDS { true => ws.len(), false => REG_WORDS }
        // one by one when no word sits in the register of one loaded before
        // it (the usual case, which keeps a value held back in %rax going
        // straight into its register)
        var safe = true
        var i = 0
        while i < n && safe {
            let r = self.reg_of(ws[i])
            var j = 0
            while j < i {
                if r == "%" + arg_reg(j) { safe = false }
                j = j + 1
            }
            i = i + 1
        }
        if safe {
            i = 0
            while i < n {
                self.load_temp(ws[i], arg_reg(i), temp_base)
                i = i + 1
            }
            return
        }
        // a value held back in %rax goes home first: the moves may pass
        // through %rax
        if self.pend_store != "" { self.flush_temp() }
        var dst: [str] = []
        var src: [str] = []
        i = 0
        while i < n {
            let r = self.reg_of(ws[i])
            if r != "" {
                dst.push("%" + arg_reg(i))
                src.push(r)
            }
            i = i + 1
        }
        if dst.len() > 0 { self.emit_moves(dst, src) }
        i = 0
        while i < n {
            if self.reg_of(ws[i]) == "" { self.load_temp(ws[i], arg_reg(i), temp_base) }
            i = i + 1
        }
    }

    // The `n` argument words a call pushed, popped.
    fun pop_words(var self, n: int32) {
        if n > 0 { self.emit(format("addq ${}, %rsp", 8 * n)) }
    }

    // -- async functions' frames (D90) -------------------------------------

    // `suspend L`: the state that resumes at L, into the frame.
    fun emit_state(var self, b: int32) {
        var k = 0
        while k < self.resume_blocks.len() && self.resume_blocks[k] != b { k = k + 1 }
        self.emit(format("movq ${}, 16(%r15)", k + 1))
    }

    // `suspend L` with no call before it: back to the executor.
    fun emit_suspend(var self, b: int32, labels: [str]) {
        self.emit_state(b)
        self.emit(format("jmp {}", self.epilogue))
    }

    // An intrinsic, done in place (`Intrinsic` says what each means).
    //
    // The registers each uses besides its operands' (MYLA-294): `sqrt`,
    // `f64_round` %rax and %xmm0; `f64_bits`, `f64_from_bits`, `rt_addr`,
    // the atomics but `cas64`, `rc_inc`, `rc_dec` and `bsr64` %rax; `cas64`
    // %rax and %rdx; `rt_waddr`, `rotl` and `fits` %rax and %rcx (and %rdx,
    // `fits` of an unsigned `*`); `unique` %rcx and
    // its clone's call; `run_frame` %rax, %rdi and %r11 and the call;
    // `call_code` %rdi and %r11 and the call. None of %rax, %rcx, %rdx and
    // %xmm0 is one the allocator hands out (`alloc_regs`), and the three
    // that touch %rdi or %r11 call, which `clobber_kind` counts (2), so no
    // value the allocator keeps in a register is lost across one. An
    // intrinsic that would use %rsi, %rdi or %r8-%r11 without calling has to
    // be added to `clobber_kind`.
    fun emit_intr(var self, d: int32, op: Intrinsic, args: [int32], temp_base: int32) {
        match op {
            // std.math's primitives inline (MYLA-249): no call
            Intrinsic.Sqrt => {
                self.uses_float = true
                let ra = self.xmm_in(args[0], "rax", "xmm0", temp_base)
                self.emit(format("sqrtsd {}, %xmm0", ra))
                self.xmm_result(d, temp_base)
            },
            Intrinsic.F64Bits | Intrinsic.F64FromBits => {
                self.load_temp(args[0], "rax", temp_base)
                self.store_temp(d, temp_base)
            },
            // to the nearest integer (the default rounding, ties to even)
            Intrinsic.F64Round => {
                self.uses_float = true
                let ra = self.xmm_in(args[0], "rax", "xmm0", temp_base)
                self.emit(format("cvtsd2si {}, %rax", ra))
                self.store_temp(d, temp_base)
            },
            // the address of a runtime variable (MYLA-162): next to %rip,
            // or in the worker's block with tasks
            Intrinsic.RtAddr(sym) => {
                // the loads and stores reading it name the variable
                if self.temp_mem[d] != "" { return }
                if self.frames && tls_offset(sym) != 0 {
                    self.emit("movq %fs:0, %rax")
                    self.emit(format("leaq {}(%rax), %rax", tls_offset(sym)))
                } else { self.emit(format("leaq {}(%rip), %rax", sym)) }
                self.store_temp(d, temp_base)
            },
            // another worker's own of a runtime variable: its block in
            // `__tls_blocks` (with tasks)
            Intrinsic.RtWaddr(sym) => {
                self.load_temp(args[0], "rax", temp_base)
                self.emit(format("imulq ${}, %rax, %rax", TLS_SIZE))
                self.emit("leaq __tls_blocks(%rip), %rcx")
                self.emit(format("leaq {}(%rcx,%rax), %rax", tls_offset(sym)))
                self.store_temp(d, temp_base)
            },
            // atomics (MYLA-162), through the scratch registers
            Intrinsic.Cas64 => {
                let at = self.atomic_at(args[0], temp_base)
                self.load_temp(args[2], "rdx", temp_base)
                self.load_temp(args[1], "rax", temp_base)
                self.emit("lock cmpxchgq %rdx, " + at)
                self.emit("sete %al")
                self.emit("movzbl %al, %eax")
                self.store_temp(d, temp_base)
            },
            // x86-64's loads and stores are ordered as acquire and
            // release by themselves (MYLA-267)
            Intrinsic.LoadAcq64 => {
                let at = self.atomic_at(args[0], temp_base)
                self.emit("movq " + at + ", %rax")
                self.store_temp(d, temp_base)
            },
            Intrinsic.StoreRel64 => {
                let at = self.atomic_at(args[0], temp_base)
                self.load_temp(args[1], "rax", temp_base)
                self.emit("movq %rax, " + at)
            },
            Intrinsic.Xchg64 => {
                let at = self.atomic_at(args[0], temp_base)
                self.load_temp(args[1], "rax", temp_base)
                self.emit("xchgq %rax, " + at)
                self.store_temp(d, temp_base)
            },
            Intrinsic.FetchAdd64 => {
                // the value before unused, the addend a constant: one add
                if (d < 0 || self.temp_uses[d] == 0) && self.temp_imm[args[1]] != "" {
                    let at = self.atomic_at(args[0], temp_base)
                    self.emit(format("lock addq {}, {}", self.temp_imm[args[1]], at))
                    return
                }
                let at = self.atomic_at(args[0], temp_base)
                self.load_temp(args[1], "rax", temp_base)
                self.emit("lock xaddq %rax, " + at)
                self.store_temp(d, temp_base)
            },
            Intrinsic.Pause => {
                self.emit("pause")
            },
            // one more reference to a cell (`lock`: an actor handle
            // threads share, D92)
            Intrinsic.RcInc | Intrinsic.RcIncAtomic => {
                var inc = "incq"
                if is_rc_atomic(op) { inc = "lock incq" }
                let at = self.reg_of(args[0])
                if at != "" { self.emit(format("{} -8({})", inc, at)) }
                else {
                    self.load_temp(args[0], "rax", temp_base)
                    self.emit(format("{} -8(%rax)", inc))
                }
            },
            // the cell the holder at the argument points at made unique
            // by the clone routine the intrinsic names (MYLA-251)
            Intrinsic.Unique(clone) => {
                self.load_temp(args[0], "rcx", temp_base)
                self.cow_unique_at_rcx(clone)
                self.store_temp(d, temp_base)
            },
            // a cell's count down by one, whether it reached 0 (the
            // per-type drop routines' fast path, MYLA-162)
            Intrinsic.RcDec | Intrinsic.RcDecAtomic => {
                let at = self.rc_dec(is_rc_atomic(op), args[0], temp_base)
                if d >= 0 && self.temp_uses[d] > 0 {
                    self.emit("sete %al")
                    self.emit("movzbl %al, %eax")
                    self.store_temp(d, temp_base)
                }
            },
            // a frame resumed (its resume function the frame's first
            // word): a call, the callee-saved registers kept
            Intrinsic.RunFrame => {
                self.load_temp(args[0], "rdi", temp_base)
                self.emit("call *(%rdi)")
            },
            // a call through a code address with one word (MYLA-263)
            // (the code first: whichever operand is in %rax, the other's load
            // can't overwrite it; nothing lives in %r11 across a call)
            Intrinsic.CallCode => {
                self.load_temp(args[0], "r11", temp_base)
                self.load_temp(args[1], "rdi", temp_base)
                self.emit("call *%r11")
                self.store_temp(d, temp_base)
            },
            // whether a 64-bit `+`, `-` or `*` fits (MYLA-430): the
            // operation again in %rax, and its overflow or carry flag
            Intrinsic.Fits(o, signed) => {
                let flag = self.emit_flagged_op(o, signed, args[0], args[1], temp_base)
                self.emit(format("setn{} %al", flag))
                self.emit("movzbl %al, %eax")
                self.store_temp(d, temp_base)
            },
            Intrinsic.Bsr64 => {
                self.load_temp(args[0], "rax", temp_base)
                self.emit("bsrq %rax, %rax")
                self.store_temp(d, temp_base)
            },
            // a rotation (MYLA-162): one `rol`, by an immediate when the
            // count is a constant
            Intrinsic.Rotl => {
                // in place when the result's register holds the value
                if self.temp_imm[args[1]] != "" && d >= 0 && self.temp_reg[d] != "" && self.temp_uses[d] > 0 && self.reg_of(args[0]) == "%" + self.temp_reg[d] && !text_has_xmm("%" + self.temp_reg[d]) {
                    self.emit(format("rolq {}, %{}", self.temp_imm[args[1]], self.temp_reg[d]))
                    return
                }
                if self.temp_imm[args[1]] != "" {
                    self.load_temp(args[0], "rax", temp_base)
                    self.emit(format("rolq {}, %rax", self.temp_imm[args[1]]))
                } else {
                    self.load_temp(args[1], "rcx", temp_base)
                    self.load_temp(args[0], "rax", temp_base)
                    self.emit("rolq %cl, %rax")
                }
                self.store_temp(d, temp_base)
            },
        }
    }

    fun emit_inst(var self, f: IrFunc, inst: Inst, slot_off: [int32], temp_base: int32) {
        match inst {
            // a constant or an address is recomputed where it is read
            // (`remat_texts`), unless its temporary is written elsewhere too
            Inst.Const(d, t, v) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Str(d, text) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Load(d, s) => {
                // read where it is used instead (`remat_texts`)
                if self.temp_remat[d] == "" {
                    // from one register into another (MYLA-257): one move,
                    // none when they are the same
                    let sr = self.slot_reg[s]
                    let dr = self.temp_reg[d]
                    if sr != "" && dr != "" && !text_has_xmm("%" + sr) && !text_has_xmm("%" + dr) {
                        if self.temp_uses[d] > 0 && sr != dr { self.emit(format("movq %{}, %{}", sr, dr)) }
                        return
                    }
                    if self.slot_reg[s] != "" { self.emit(format("movq %{}, %rax", self.slot_reg[s])) }
                    else if self.in_frame { self.emit(format("movq {}(%r15), %rax", slot_off[s])) }
                    else { self.emit(format("movq {}(%rbp), %rax", slot_off[s])) }
                    self.store_temp(d, temp_base)
                }
            },
            Inst.Store(s, v) => {
                let sr = self.slot_reg[s]
                if sr.len() > 3 && sr[0] == 'x' && sr[1] == 'm' && sr[2] == 'm' {
                    // into an %xmm home (MYLA-249): from another, or through %rax
                    let home = self.xmm_home(v)
                    if home != "" {
                        if self.pend_store != "" { self.flush_temp_in_rax() }
                        if home != "%" + sr { self.emit(format("movapd {}, %{}", home, sr)) }
                    } else if self.float_const_into(v, "%" + sr) {
                        // a constant straight from the pool (MYLA-249)
                    } else {
                        self.load_temp(v, "rax", temp_base)
                        self.emit(format("movq %rax, %{}", sr))
                    }
                } else if sr != "" { self.load_temp(v, sr, temp_base) }
                else if self.in_frame { self.emit(format("movq {}, {}(%r15)", self.value_operand(v, temp_base), slot_off[s])) }
                else { self.emit(format("movq {}, {}(%rbp)", self.value_operand(v, temp_base), slot_off[s])) }
            },
            Inst.Addr(d, s) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.Offset(d, p, off) => {
                // read by nothing (a retain or drop loads through its base)
                if self.temp_uses[d] == 0 { return }
                let base = self.reg_of(p)
                if base != "" { self.emit(format("leaq {}({}), %rax", off, base)) }
                else {
                    self.load_temp(p, "rax", temp_base)
                    if off != 0 { self.emit(format("addq ${}, %rax", off)) }
                }
                self.store_temp(d, temp_base)
            },
            Inst.LoadAt(d, p, off, width) => {
                // through a slot's address: straight from the frame (MYLA-120)
                // or through a register (MYLA-121); as wide as the IR says
                // (D120)
                let t = f.temps[d]
                if self.temp_mem[p] != "" {
                    self.emit_load(width, t, self.rt_var_at(self.temp_mem[p], off))
                    self.store_temp(d, temp_base)
                    return
                }
                let base = self.reg_of(p)
                if self.temp_frame[p] != 0 && self.in_frame { self.emit_load(width, t, format("{}(%r15)", self.temp_frame[p] + off)) }
                else if self.temp_frame[p] != 0 { self.emit_load(width, t, format("{}(%rbp)", self.temp_frame[p] + off)) }
                else if base != "" { self.emit_load(width, t, format("{}({})", off, base)) }
                else {
                    self.load_temp(p, "rax", temp_base)
                    self.emit_load(width, t, format("{}(%rax)", off))
                }
                self.store_temp(d, temp_base)
            },
            Inst.StoreAt(p, off, v, width) => {
                if self.temp_mem[p] != "" {
                    self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), self.rt_var_at(self.temp_mem[p], off))
                    return
                }
                let base = self.reg_of(p)
                if self.temp_frame[p] != 0 && self.in_frame { self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}(%r15)", self.temp_frame[p] + off)) }
                else if self.temp_frame[p] != 0 { self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}(%rbp)", self.temp_frame[p] + off)) }
                else if base != "" { self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}({})", off, base)) }
                else {
                    self.load_temp(p, "rcx", temp_base)
                    self.emit_store(width, f.temps[v], self.value_operand(v, temp_base), format("{}(%rcx)", off))
                }
            },
            Inst.Copy(d, src, size) => {
                self.load_temp(src, "rsi", temp_base)
                self.load_temp(d, "rdi", temp_base)
                self.emit_copy(size)
            },
            Inst.Bin(d, op, t, rt, a, b, pos) => {
                match t {
                    Type.TFloat(w) => {
                        if op == "%" {
                            self.load_temp(a, "rax", temp_base)
                            self.load_temp(b, "rcx", temp_base)
                            self.emit_float_op(op, rt)
                        } else {
                            // the operands where they are, %xmm homes included (MYLA-249)
                            self.uses_float = true
                            let ra = self.xmm_in(a, "rax", "xmm0", temp_base)
                            let rb = self.xmm_in(b, "rcx", "xmm1", temp_base)
                            // computed in the destination's home when the second
                            // operand isn't there, else in %xmm0
                            var target = self.xmm_home(d)
                            if target == "" || target == rb { target = "%xmm0" }
                            if self.pend_store != "" { self.flush_temp_in_rax() }
                            if ra != target { self.emit(format("movapd {}, {}", ra, target)) }
                            self.emit(format("{} {}, {}", float_insn(op), rb, target))
                            if is_tfloat32(rt) {
                                self.emit(format("cvtsd2ss {}, {}", target, target))
                                self.emit(format("cvtss2sd {}, {}", target, target))
                            }
                            if target == "%xmm0" { self.xmm_result(d, temp_base) }
                            return
                        }
                    },
                    _ => {
                        // `a + k`, `a - k` or `a + b` from registers into a
                        // register: one `lea` (MYLA-162)
                        if self.emit_lea(d, op, rt, a, b) { return }
                        // `a * k` from a register into a register: one
                        // three-operand `imul`
                        if self.emit_imul_const(d, op, rt, a, b, temp_base) || self.emit_imul_const(d, op, rt, b, a, temp_base) { return }
                        // the result's register an operand's already: in
                        // place, without going through %rax
                        if self.emit_bin_in_reg(d, op, rt, a, b, temp_base) { return }
                        // the operands swapped when the second is still in
                        // %rax and the order doesn't matter (MYLA-121)
                        if self.swap_operands(op, a, b) {
                            self.load_temp(b, "rax", temp_base)
                            self.emit_int_op(op, t, rt, pos.line, pos.col, self.second_operand(op, a, temp_base))
                        } else if (op == "/" || op == "%") && self.temp_imm[b] != "" && self.temp_imm[b] != "$0" && self.temp_imm[b] != "$-1" {
                            // a constant divisor: neither 0 nor -1 to test
                            // for; an unsigned power of two is a shift or a
                            // mask (MYLA-125)
                            self.load_temp(a, "rax", temp_base)
                            let k = power_of_two(self.temp_imm[b])
                            if k > 0 && !int_signed(t) {
                                if op == "/" { self.emit(format("shrq ${}, %rax", k)) }
                                else {
                                    let one: int64 = 1
                                    self.emit(format("andq ${}, %rax", (one << (k as int64)) - 1))
                                }
                                // in range already, as `emit_int_op`'s (MYLA-251)
                                if !same_int(t, rt) { self.wrap(rt) }
                            } else {
                                self.load_temp(b, "rcx", temp_base)
                                self.emit_int_op(op, t, rt, pos.line, pos.col, self.temp_imm[b])
                            }
                        } else if (op == "<<" || op == ">>") && self.temp_imm[b] != "" {
                            // a constant count, masked to the width as the
                            // language does: an immediate, not through %cl
                            self.load_temp(a, "rax", temp_base)
                            let c = imm_int(self.temp_imm[b]) & ((int_width_cg(rt) - 1) as int64)
                            if c != 0 {
                                if op == "<<" { self.emit(format("shlq ${}, %rax", c)) }
                                else if int_signed(t) { self.emit(format("sarq ${}, %rax", c)) }
                                else { self.emit(format("shrq ${}, %rax", c)) }
                            }
                            if op == "<<" || !same_int(t, rt) { self.wrap(rt) }
                        } else {
                            self.load_temp(a, "rax", temp_base)
                            self.emit_int_op(op, t, rt, pos.line, pos.col, self.second_operand(op, b, temp_base))
                        }
                    },
                }
                self.store_temp(d, temp_base)
            },
            Inst.Cmp(d, op, t, a, b) => {
                match t {
                    Type.TFloat(w) => {
                        self.uses_float = true
                        let ra = self.xmm_in(a, "rax", "xmm0", temp_base)
                        let rb = self.xmm_in(b, "rcx", "xmm1", temp_base)
                        self.emit(format("ucomisd {}, {}", rb, ra))
                        self.emit_float_cmp_result(op)
                    },
                    _ => {
                        if self.swap_operands(op, a, b) {
                            self.load_temp(b, "rax", temp_base)
                            self.emit_int_op(swapped_cmp(op), t, Type.TBool, 0, 0, self.second_operand(op, a, temp_base))
                        } else {
                            self.load_temp(a, "rax", temp_base)
                            self.emit_int_op(op, t, Type.TBool, 0, 0, self.second_operand(op, b, temp_base))
                        }
                    },
                }
                self.store_temp(d, temp_base)
            },
            Inst.Mov(d, a) => {
                // a copy (D123): nothing between one register and itself,
                // one move between two registers, else through %rax, which
                // the held-back store folds into a move between the homes
                if self.temp_uses[d] == 0 { return }
                let ra = self.reg_of(a)
                if ra != "" && self.temp_reg[d] != "" && !text_has_xmm(ra) && !text_has_xmm("%" + self.temp_reg[d]) {
                    if ra != "%" + self.temp_reg[d] { self.emit(format("movq {}, %{}", ra, self.temp_reg[d])) }
                    return
                }
                self.load_temp(a, "rax", temp_base)
                self.store_temp(d, temp_base)
            },
            Inst.Un(d, op, t, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_unary(op, t)
                self.store_temp(d, temp_base)
            },
            Inst.Cast(d, src, tgt, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_cast(src, tgt)
                self.store_temp(d, temp_base)
            },
            Inst.Call(d, name, args) => {
                let n = self.pass_words(args, temp_base)
                self.emit(format("call myla_{}", name))
                self.pop_words(n)
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.CallSret(name, r, args) => {
                // the result's address is the first word (%rdi)
                let n = self.pass_words(sret_words(r, args), temp_base)
                self.emit(format("call myla_{}", name))
                self.pop_words(n)
            },
            Inst.Label(d, sym) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            // (never rematerialized: its record is named for the function's
            // file, which is known only from here on)
            Inst.Position(d, p) => { self.def_into_temp(inst, d, slot_off, temp_base) },
            Inst.CallInd(d, fv, args) => {
                // the arguments, the environment in %r10, then the call
                let n = self.pass_words(args, temp_base)
                self.load_temp(fv, "rax", temp_base)
                self.emit("movq 8(%rax), %r10")
                self.emit("call *(%rax)")
                self.pop_words(n)
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.CallIndSret(fv, r, args) => {
                let n = self.pass_words(sret_words(r, args), temp_base)
                self.load_temp(fv, "rax", temp_base)
                self.emit("movq 8(%rax), %r10")
                self.emit("call *(%rax)")
                self.pop_words(n)
            },
            Inst.Rt(d, name, args) => {
                self.load_args(args, temp_base)
                if name == "__float_to_str" {
                    self.uses_float = true
                    self.wants_ftoa = true
                }
                self.emit(format("call {}", name))
                if d >= 0 { self.store_temp(d, temp_base) }
            },
            Inst.Intr(d, op, args) => { self.emit_intr(d, op, args, temp_base) },
            Inst.RetainVal(t, v) => { self.unplain() },
            Inst.Retain(t, p) => { self.unplain() },
            Inst.DropSlot(t, s) => { self.unplain() },
            Inst.Frame(d) => {
                self.emit("movq %r15, %rax")
                self.store_temp(d, temp_base)
            },
            Inst.DropVal(t, v) => { self.unplain() },
            Inst.DropAt(t, p) => { self.unplain() },
            Inst.Deep(t, p) => { self.unplain() },
            Inst.CloneDeep(t, p) => { self.unplain() },
            Inst.Init(s) => {},
            Inst.Moved(s) => {},
            Inst.Check(v, kind, p) => {
                self.emit_test(v, temp_base)
                if kind == "overflow" || kind == "shift" { self.cold_trap("z", kind, p) }
                else { self.trap("jz", "__trap_" + kind, p.line, p.col) }
            },
            Inst.SbAppend(h, v) => {
                // the string's length and bytes
                self.load_temp(v, "rsi", temp_base)
                self.emit("movq (%rsi), %rdx")
                self.emit("addq $8, %rsi")
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
            },
            Inst.SbAppendRange(h, v, a, b, p) => {
                // a range: 0 <= start <= end <= len
                self.load_temp(b, "rcx", temp_base)
                self.emit("movslq %ecx, %rcx")
                self.load_temp(a, "rdx", temp_base)
                self.emit("movslq %edx, %rdx")
                self.load_temp(v, "rsi", temp_base)
                self.emit_sb_range(p.line, p.col)
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
            },
            Inst.SbAppendByte(h, b) => {
                // the byte on the stack
                self.load_temp(b, "rax", temp_base)
                self.emit("pushq %rax")
                self.emit("movq %rsp, %rsi")
                self.emit("movq $1, %rdx")
                self.load_temp(h, "rdi", temp_base)
                self.emit("call __sb_append_bytes")
                self.emit("addq $8, %rsp")
            },
            Inst.SbBuild(d, c) => {
                self.load_temp(c, "rax", temp_base)
                self.emit_sb_build()
                self.store_temp(d, temp_base)
            },
            Inst.Global(d, sym, w) => {
                if w == 4 { self.emit(format("movslq {}, %rax", self.tv(sym))) } else { self.emit(format("movq {}, %rax", self.tv(sym))) }
                self.store_temp(d, temp_base)
            },
            Inst.Exit(v) => {
                // the exit hook, then exit_group (every thread ends, D187); when
                // tasks take turns, held for the parent if a task other than the
                // entry's exits. The `int` sign-extended, as every argument
                // of its type (MYLA-588: `exit(-1)` reached `exit_program`
                // as 4294967295)
                self.load_temp(v, "rax", temp_base)
                self.emit("movslq %eax, %rdi")
                if self.frames { self.emit("call __task_exit") } else { self.emit("call __exit_program") }
            },
            Inst.Elem(d, c, i, stride, is_str, checked, p) => {
                self.load_temp(c, "rax", temp_base)
                self.load_temp(i, "rcx", temp_base)
                if checked { self.emit_elem_check(p.line, p.col, is_str, f.temps[i]) }
                self.emit(format("leaq {}, %rax", self.elem_operand(is_str, stride)))
                self.store_temp(d, temp_base)
            },
            Inst.Load8(d, p) => {
                self.load_temp(p, "rax", temp_base)
                self.emit("movzbl (%rax), %eax")
                self.store_temp(d, temp_base)
            },
            Inst.Cow(d, t, h) => { self.unplain() },
            Inst.Append(d, h, c, stride) => {
                // grow when full (publishing the new cell), then
                // count the element and point at its slot
                let have = self.label()
                self.load_temp(c, "rax", temp_base)
                self.emit("movq (%rax), %rdx")
                self.emit("movq 8(%rax), %rcx")
                self.emit("cmpq %rcx, %rdx")
                self.emit(format("jb {}", have))
                self.emit("movq %rax, %rdi")
                self.emit(format("movq ${}, %rsi", stride))
                self.emit("call __list_grow")
                self.load_temp(h, "rcx", temp_base)
                self.emit("movq %rax, (%rcx)")
                self.emit(format("{}:", have))
                self.emit("movq (%rax), %rdx")
                self.emit("leaq 1(%rdx), %rcx")
                self.emit("movq %rcx, (%rax)")
                self.emit(format("imulq ${}, %rdx", stride))
                self.emit("leaq 16(%rax,%rdx), %rax")
                self.store_temp(d, temp_base)
            },
            Inst.Pop(d, c, stride, p) => {
                // trap when empty, else uncount the last element
                self.load_temp(c, "rax", temp_base)
                self.emit("movq (%rax), %rcx")
                self.emit("testq %rcx, %rcx")
                self.trap("jz", "__trap_pop", p.line, p.col)
                self.emit("decq %rcx")
                self.emit("movq %rcx, (%rax)")
                self.emit(format("imulq ${}, %rcx", stride))
                self.emit("leaq 16(%rax,%rcx), %rax")
                self.store_temp(d, temp_base)
            },
            Inst.Print(t, a) => {
                self.load_temp(a, "rax", temp_base)
                self.emit_print(t)
            },
            Inst.Loc(p) => { self.emit_loc(p.line, p.col) },
            Inst.Bind(name, s) => {
                let slot = f.slots[s]
                // a frame function's variables are in its heap frame (D90,
                // MYLA-141); its parameters, owned copies there, are visible
                // in the whole function
                if f.frame {
                    let b = CgBinding { name: name, kind: "frame", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, slot.word >= 0, slot.word >= 0)
                    return
                }
                // a parameter passed by value lives in its argument words as a
                // local in its slot (D88)
                if slot.word >= 0 && !slot.inline {
                    let b = CgBinding { name: name, kind: "param", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, true, true)
                } else {
                    let b = CgBinding { name: name, kind: "local", offset: slot_off[s], ty: slot.ty, capoff: 0 }
                    self.dbg_variable(b, false, false)
                }
            },
            Inst.Scope(open) => {
                if open { self.dbg_push_scope() } else { self.dbg_pop_scope() }
            },
        }
    }

    // The index of the instruction of `insts` that the branch `term` can fuse
    // with (MYLA-120): a comparison ending the block whose result only the
    // branch reads, an integer one or a float `<`, `<=`, `>`, `>=` (MYLA-249;
    // a float `==` or `!=` needs the parity flag too); -1 when there is none.
    fun fused_compare(self, insts: [Inst], term: Term) -> int32 {
        if insts.len() == 0 { return -1 }
        let last = insts.len() - 1
        return match term {
            Term.Br(c, a, b) => match insts[last] {
                // a compare-and-swap only the branch reads: its flag (MYLA-162)
                Inst.Intr(d, op, args) => {
                    if d != c || self.temp_uses[d] != 1 || !(is_rc_dec(op) || is_cas(op)) { return -1 }
                    last
                },
                // a negated flag only the branch reads: the inverted jump (MYLA-251)
                Inst.Un(d, op, t, x) => {
                    if d != c || self.temp_uses[d] != 1 || op != "!" { return -1 }
                    last
                },
                Inst.Cmp(d, op, t, x, y) => {
                    if d != c || self.temp_uses[d] != 1 { return -1 }
                    match t {
                        Type.TFloat(w) => { if !(op == "<" || op == "<=" || op == ">" || op == ">=") { return -1 } },
                        _ => {},
                    }
                    last
                },
                _ => -1,
            },
            _ => -1,
        }
    }

    // The call `c`, whose result the function `f` returns at once, as a
    // jump reusing this frame (MYLA-126; `become`'s, D87): its words passed
    // as a call passes them (D119), those on the stack moved into the words
    // this function received there (its caller pops them; never more of
    // them), a function value's environment in %r10 and its code in %r11,
    // the saved registers restored, the frame left, and the callee jumped
    // to. A call of `f` itself keeps the frame and the saved registers: the
    // parameters take the new words, and it jumps to the entry block
    // (`entry`), a loop.
    fun emit_tail_call(var self, f: IrFunc, c: Inst, slot_off: [int32], entry: str, temp_base: int32) {
        var target = ""
        var ws: [int32] = []
        var fv = -1
        var again = false
        match c {
            Inst.Call(d, name, args) => {
                ws = args
                target = format("myla_{}", name)
                again = self.epilogue_label(name) == self.epilogue
            },
            Inst.CallSret(name, res, args) => {
                ws = sret_words(res, args)
                target = format("myla_{}", name)
                again = self.epilogue_label(name) == self.epilogue
            },
            Inst.CallInd(d, fn, args) => {
                ws = args
                fv = fn
                target = "*%r11"
            },
            Inst.CallIndSret(fn, res, args) => {
                ws = sret_words(res, args)
                fv = fn
                target = "*%r11"
            },
            _ => { return },
        }
        let m = ws.len() - REG_WORDS
        if m > self.arg_words { panic(format("internal error: a tail call with {} argument words on the stack in a function that received {}", m, self.arg_words)) }
        // the stack words, pushed the last first (but one already where it
        // goes, a parameter passed on in its place); the registers loaded
        // before anything is written over the words received
        var in_place: [bool] = []
        var k = 0
        while k < m {
            in_place.push(self.temp_src[ws[REG_WORDS + k]] == format("{}(%rbp)", 16 + 8 * k))
            k = k + 1
        }
        var i = m - 1
        while i >= 0 {
            if !in_place[i] { self.push_temp(ws[REG_WORDS + i], temp_base) }
            i = i - 1
        }
        self.load_words(ws, temp_base)
        if fv >= 0 {
            self.load_temp(fv, "rax", temp_base)
            self.emit("movq 8(%rax), %r10")
            self.emit("movq (%rax), %r11")
        }
        i = 0
        while i < m {
            if !in_place[i] { self.emit(format("popq {}(%rbp)", 16 + 8 * i)) }
            i = i + 1
        }
        if again && !f.frame {
            self.emit_params(f, slot_off)
            self.emit(format("jmp {}", entry))
            return
        }
        self.restore_regs()
        if !self.frameless { self.emit("leave") }
        self.emit(format("jmp {}", target))
    }

    // The callee-saved registers the function saved, restored (MYLA-121).
    fun restore_regs(var self) {
        var r = 0
        while r < self.saved_regs.len() {
            self.emit(format("movq {}(%rbp), %{}", -self.save_base - 8 * (r + 1), self.saved_regs[r]))
            r = r + 1
        }
    }

    // The comparison `cmp` and the branch `term` on it as a compare and a
    // conditional jump; the successor emitted next is fallen through to.
    fun emit_compare_branch(var self, cmp: Inst, term: Term, labels: [str], next: int32, temp_base: int32) {
        match cmp {
            Inst.Intr(d, op, args) => {
                // a count down: ZF set when it reached 0
                if is_rc_dec(op) {
                    let rc = self.rc_dec(is_rc_atomic(op), args[0], temp_base)
                    match term {
                        Term.Br(c, yes, no) => {
                            if no == next { self.emit(format("je {}", labels[yes])) }
                            else {
                                self.emit(format("jne {}", labels[no]))
                                if yes != next { self.emit(format("jmp {}", labels[yes])) }
                            }
                        },
                        _ => {},
                    }
                    return
                }
                // `lock cmpxchg` sets ZF when it swapped
                let at = self.atomic_at(args[0], temp_base)
                self.load_temp(args[2], "rdx", temp_base)
                self.load_temp(args[1], "rax", temp_base)
                self.emit("lock cmpxchgq %rdx, " + at)
                match term {
                    Term.Br(c, yes, no) => {
                        if no == next { self.emit(format("je {}", labels[yes])) }
                        else {
                            self.emit(format("jne {}", labels[no]))
                            if yes != next { self.emit(format("jmp {}", labels[yes])) }
                        }
                    },
                    _ => {},
                }
                return
            },
            Inst.Un(d, op, t, x) => {
                // `br !x, yes, no` is `br x, no, yes`
                self.emit_test(x, temp_base)
                match term {
                    Term.Br(c, yes, no) => {
                        if no == next { self.emit(format("je {}", labels[yes])) }
                        else {
                            self.emit(format("jne {}", labels[no]))
                            if yes != next { self.emit(format("jmp {}", labels[yes])) }
                        }
                    },
                    _ => {},
                }
                return
            },
            Inst.Cmp(d, op, t, x, y) => {
                match t {
                    Type.TFloat(w) => {
                        // `ucomisd b, a` gives a's order against b in the
                        // unsigned flags; unordered (NaN) sets CF and ZF, so
                        // `ja`/`jae` are false for it and their negations
                        // true, as the comparison is false (MYLA-249)
                        self.uses_float = true
                        let gt = op == ">" || op == ">="
                        let ra = self.xmm_in(x, "rax", "xmm0", temp_base)
                        let rb = self.xmm_in(y, "rcx", "xmm1", temp_base)
                        if gt { self.emit(format("ucomisd {}, {}", rb, ra)) } else { self.emit(format("ucomisd {}, {}", ra, rb)) }
                        let cond = if op == ">" || op == "<" { "a" } else { "ae" }
                        match term {
                            Term.Br(c, yes, no) => {
                                if no == next { self.emit(format("j{} {}", cond, labels[yes])) }
                                else {
                                    self.emit(format("j{} {}", negated_cond(cond), labels[no]))
                                    if yes != next { self.emit(format("jmp {}", labels[yes])) }
                                }
                            },
                            _ => {},
                        }
                        return
                    },
                    _ => {},
                }
                let cond = self.emit_int_compare(op, t, x, y, temp_base)
                match term {
                    Term.Br(c, yes, no) => {
                        if no == next { self.emit(format("j{} {}", cond, labels[yes])) }
                        else {
                            self.emit(format("j{} {}", negated_cond(cond), labels[no]))
                            if yes != next { self.emit(format("jmp {}", labels[yes])) }
                        }
                    },
                    _ => {},
                }
            },
            _ => {},
        }
    }

    // The `cmpq` of the integer comparison `x op t y`; the condition of the
    // jump taken when it holds.
    fun emit_int_compare(var self, op: str, t: Type, x: int32, y: int32, temp_base: int32) -> str {
        // the first operand where it is when that is a register; the
        // two swapped when the second is still in %rax
        var cop = op
        var left = self.reg_of(x)
        if left == "" && self.swap_operands(op, x, y) {
            self.load_temp(y, "rax", temp_base)
            left = "%rax"
            cop = swapped_cmp(op)
            self.emit(format("cmpq {}, {}", self.second_operand(op, x, temp_base), left))
        } else {
            // a value just loaded, compared with a constant or a
            // register: the memory itself
            if left == "" && (self.temp_imm[y] != "" || (self.temp_reg[y] != "" && self.temp_remat[y] == "" && !(self.pend_store != "" && self.pend_temp == y))) {
                left = self.take_load(x)
            }
            if left == "" {
                self.load_temp(x, "rax", temp_base)
                left = "%rax"
            }
            self.emit(format("cmpq {}, {}", self.second_operand(op, y, temp_base), left))
        }
        return jump_cond(cop, int_signed(t))
    }

    // An integer comparison that only the `check` after it reads, of an
    // overflow or a shift's count (D175's checked build): the `cmpq` and a
    // jump to the trap, out of line, when it doesn't hold (MYLA-551). False
    // for any other pair; the other checks keep their code (a plain build's
    // is unchanged).
    fun emit_compare_check(var self, a: Inst, b: Inst, temp_base: int32) -> bool {
        match a {
            Inst.Cmp(d, op, t, x, y) => {
                match t { Type.TFloat(w) => { return false }, _ => {} }
                match b {
                    Inst.Check(v, kind, p) => {
                        if v != d || self.temp_uses[d] != 1 || (kind != "overflow" && kind != "shift") { return false }
                        let cond = self.emit_int_compare(op, t, x, y, temp_base)
                        self.cold_trap(negated_cond(cond), kind, p)
                        return true
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        return false
    }

    // `ok = fits op (x, y)` that only the `check ok overflow` after it reads
    // (D175's checked build, MYLA-430): the operation in %rax, its result
    // unused, and a jump to the trap on its flag. False for any other pair.
    fun emit_fits_check(var self, a: Inst, b: Inst, temp_base: int32) -> bool {
        match a {
            Inst.Intr(ok, op, args) => {
                match op {
                    Intrinsic.Fits(o, signed) => {
                        if !self.only_check_reads(ok, b) { return false }
                        let flag = self.emit_flagged_op(o, signed, args[0], args[1], temp_base)
                        self.emit_trap_on_flag(flag, b)
                        return true
                    },
                    _ => {},
                }
            },
            _ => {},
        }
        return false
    }

    // `ok = fits op (x, y)`, the `check ok overflow` that alone reads it and
    // `d = x op y` at `i` (the lowering's checked `+`, `-` and `*` on 64-bit
    // integers, MYLA-430): the operation once and a jump to the trap on its
    // overflow or carry flag. In place, as the plain operation is, where
    // `d`'s register holds an operand already (`emit_bin_in_reg`), or where
    // only a store into a variable living in the register of `x` (or, the
    // order not mattering, of `y`) reads `d` (`emit_in_place`), the store
    // included; else in %rax. How many instructions it took: 4, 3, or 0 for
    // any other sequence (nothing emitted).
    fun emit_checked_op(var self, insts: [Inst], i: int32, stop: int32, temp_base: int32) -> int32 {
        var op = ""
        var signed = false
        var ok = -1
        var args: [int32] = []
        match insts[i] {
            Inst.Intr(t, fop, xs) => {
                match fop {
                    Intrinsic.Fits(o, sg) => {
                        op = o
                        signed = sg
                        ok = t
                        args = xs
                    },
                    _ => { return 0 },
                }
            },
            _ => { return 0 },
        }
        if !self.only_check_reads(ok, insts[i + 1]) { return 0 }
        return match insts[i + 2] {
            Inst.Bin(d, bop, lt, rt, x, y, pos) => {
                if bop != op || x != args[0] || y != args[1] { return 0 }
                // the operands read once here, not twice: one just computed
                // in %rax needn't be stored
                self.temp_uses[x] -= 1
                self.temp_uses[y] -= 1
                var n = 3
                var reg = ""
                if !(op == "*" && !signed) {
                    if i + 3 < stop { reg = self.stored_in_reg(d, insts[i + 3]) }
                    if reg != "" { n = 4 }
                    else if self.temp_reg[d] != "" && self.temp_uses[d] > 0 && !text_has_xmm("%" + self.temp_reg[d]) { reg = "%" + self.temp_reg[d] }
                }
                var other = -1
                if reg != "" && self.reg_of(x) == reg { other = y }
                else if reg != "" && op != "-" && self.reg_of(y) == reg { other = x }
                if other >= 0 {
                    let src = self.second_operand(op, other, temp_base)
                    if op == "+" { self.emit(format("addq {}, {}", src, reg)) }
                    else if op == "-" { self.emit(format("subq {}, {}", src, reg)) }
                    else if is_immediate(src) { self.emit(format("imulq {}, {}, {}", src, reg, reg)) }
                    else { self.emit(format("imulq {}, {}", src, reg)) }
                    self.emit_trap_on_flag(if signed || op == "*" { "o" } else { "c" }, insts[i + 1])
                    return n
                }
                let flag = self.emit_flagged_op(op, signed, x, y, temp_base)
                self.emit_trap_on_flag(flag, insts[i + 1])
                self.store_temp(d, temp_base)
                3
            },
            _ => 0,
        }
    }

    // The register of the variable `s` when `st` is `store [$s], %d`, the
    // only reader of `d`, and `s` lives in a general register; else "".
    fun stored_in_reg(self, d: int32, st: Inst) -> str {
        if self.temp_uses[d] != 1 { return "" }
        return match st {
            Inst.Store(s, v) => if v == d && self.slot_reg[s] != "" && !text_has_xmm("%" + self.slot_reg[s]) { "%" + self.slot_reg[s] } else { "" }
            _ => ""
        }
    }

    // Whether `c` is `check ok overflow` and the only reader of `ok`.
    fun only_check_reads(self, ok: int32, c: Inst) -> bool {
        return match c {
            Inst.Check(v, kind, p) => v == ok && kind == "overflow" && self.temp_uses[ok] == 1
            _ => false
        }
    }

    // The 64-bit `x op y` (`+`, `-` or `*`) into %rax, setting the flag
    // its overflow sets: `o` (signed; an unsigned `*`, `mulq`, whose high
    // half in %rdx isn't 0) or `c` (an unsigned `+` or `-`) (MYLA-430). The
    // operands as the plain operation takes them (`second_operand`).
    fun emit_flagged_op(var self, op: str, signed: bool, x: int32, y: int32, temp_base: int32) -> str {
        var src = ""
        if self.swap_operands(op, x, y) {
            self.load_temp(y, "rax", temp_base)
            src = self.second_operand(op, x, temp_base)
        } else {
            self.load_temp(x, "rax", temp_base)
            src = self.second_operand(op, y, temp_base)
        }
        if op == "*" && !signed {
            if is_immediate(src) {
                self.emit(format("movq {}, %rcx", src))
                src = "%rcx"
            }
            self.emit("mulq " + src)
            return "o"
        }
        if op == "+" { self.emit(format("addq {}, %rax", src)) }
        else if op == "-" { self.emit(format("subq {}, %rax", src)) }
        else if is_immediate(src) { self.emit(format("imulq {}, %rax, %rax", src)) }
        else { self.emit(format("imulq {}, %rax", src)) }
        return if signed { "o" } else { "c" }
    }

    // A jump to the trap of the `check` `c` when the flag (`o` or `c`) is
    // set (out of line, `cold_trap`); %rax keeps the result.
    fun emit_trap_on_flag(var self, flag: str, c: Inst) {
        match c {
            Inst.Check(v, kind, p) => { self.cold_trap(flag, kind, p) },
            _ => {},
        }
    }

    // A jump on the condition `cond` (`o`, `z`, `ae`, ...) to the call of
    // `__trap_<kind>` reporting `p`, out of line (MYLA-551): a checked
    // build's overflow and shift checks are a `jcc` the code that doesn't
    // trap falls through, not a jump over the call. The call, made the first
    // time the function traps with that kind at that position, follows the
    // function's `ret` (`emit_cold_traps`); under -g it has the position's
    // line, so a backtrace from the trap shows it.
    fun cold_trap(var self, cond: str, kind: str, p: Pos) {
        let key = format("{}:{}:{}", kind, p.line, p.col)
        var lab = ""
        match self.cold_keys.get(key) {
            Some(l) => { lab = l },
            None => {
                lab = self.label()
                self.cold_keys[key] = lab
                self.cold_traps.push(lab + ":")
                if self.cur_file != 0 && p.line > 0 { self.cold_traps.push(format("\t.loc {} {} {}", self.cur_file, p.line, p.col)) }
                if p.line > 0 { self.cold_traps.push(format("\tleaq {}(%rip), %rsi", self.position_label(p.line, p.col))) }
                else { self.cold_traps.push("\tmovq $0, %rsi") }
                self.cold_traps.push("\tcall __trap_" + kind)
            },
        }
        self.emit(format("j{} {}", cond, lab))
    }

    // The function's out-of-line traps (`cold_trap`), after its code.
    fun emit_cold_traps(var self) {
        for line in self.cold_traps { self.text.push(line) }
        self.cold_traps = []
        self.cold_keys = [:]
        // the line that follows isn't the last trap's
        self.last_loc = ""
    }

    // A block's terminator; `next` is the block emitted after it (-1: none),
    // which a jump to it can fall through to.
    fun emit_term(var self, t: Term, labels: [str], next: int32, temp_base: int32) {
        match t {
            Term.Open => {},
            Term.Jmp(b) => {
                if b != next { self.emit(format("jmp {}", labels[b])) }
            },
            Term.Br(c, a, b) => {
                self.emit_test(c, temp_base)
                if b == next { self.emit(format("jnz {}", labels[a])) }
                else {
                    self.emit(format("jz {}", labels[b]))
                    if a != next { self.emit(format("jmp {}", labels[a])) }
                }
            },
            Term.Ret(v) => {
                if v >= 0 { self.load_temp(v, "rax", temp_base) }
                // the last block falls into the epilogue (MYLA-251)
                if next >= 0 { self.emit(format("jmp {}", self.epilogue)) }
            },
            // the call before it is the jump (`emit_tail_call`)
            Term.Become => {},
            Term.Suspend(b) => { self.emit_suspend(b, labels) },
            Term.Trap(kind, p) => { self.trap("jmp", "__trap_" + kind, p.line, p.col) },
            Term.Panic(m, p) => {
                self.load_temp(m, "rdi", temp_base)
                self.load_position(p.line, p.col, "rsi")
                self.emit("call __panic")
            },
            Term.PanicAt(m, p) => {
                self.load_temp(m, "rdi", temp_base)
                self.load_temp(p, "rsi", temp_base)
                self.emit("call __panic")
            },
        }
    }

    // The function emitted from text line `start` on, its frame set up by the
    // lines there: when no other line reaches %rbp, those lines and every
    // `leave` blanked (MYLA-162).
    fun drop_unused_frame(var self, start: int32) {
        var setup: [int32] = []
        var k = start
        while k < self.text.len() && setup.len() < 3 {
            let line = self.text[k]
            if line == "\tpushq %rbp" || line == "\tmovq %rsp, %rbp" || text_starts(line, "\tsubq $") { setup.push(k) }
            else if line != "" && !ends_with_colon(line) { k = self.text.len() }
            k = k + 1
        }
        if setup.len() < 2 { return }
        var leaves: [int32] = []
        k = start
        while k < self.text.len() {
            let line = self.text[k]
            if line == "\tleave" { leaves.push(k) }
            else if !has_index(setup, k) && text_mentions(line, "%rbp") { return }
            k = k + 1
        }
        for i in setup { self.text[i] = "" }
        for i in leaves { self.text[i] = "" }
    }

    // `d = a + k`, `a - k` or `a + b` for a 64- or 32-bit integer, `a` (and
    // `b`) in a general-purpose register and `d` in one: a `lea` into `d`,
    // re-extended for a signed 32-bit result; false when it isn't such a sum.
    fun emit_lea(var self, d: int32, op: str, rt: Type, a: int32, b: int32) -> bool {
        if !(op == "+" || op == "-") || self.temp_reg[d] == "" || text_has_xmm("%" + self.temp_reg[d]) { return false }
        let (w, sg) = match rt {
            Type.TInt(bits, s) => (bits, s),
            _ => (0, false),
        }
        if w != 64 && w != 32 { return false }
        let ra = self.reg_of(a)
        if ra == "" || text_has_xmm(ra) { return false }
        let dst = "%" + self.temp_reg[d]
        var addr = ""
        let imm = self.temp_imm[b]
        if imm != "" {
            // the constant's text without its `$`, negated for `-`
            var sb = StringBuilder()
            sb.append(imm, 1, imm.len())
            var k = sb.build()
            if op == "-" {
                if k == "-2147483648" { return false }
                if k.len() > 0 && k[0] == '-' {
                    var nb = StringBuilder()
                    nb.append(k, 1, k.len())
                    k = nb.build()
                } else { k = "-" + k }
            }
            addr = format("{}({})", k, ra)
        } else {
            let rb = self.reg_of(b)
            if op != "+" || rb == "" || text_has_xmm(rb) { return false }
            addr = format("({},{})", ra, rb)
        }
        if w == 64 { self.emit(format("leaq {}, {}", addr, dst)) }
        else {
            self.emit(format("leal {}, {}", addr, narrow_operand(dst, 4)))
            if sg { self.emit(format("movslq {}, {}", narrow_operand(dst, 4), dst)) }
        }
        return true
    }

    // `d = a * k` for a 64- or 32-bit integer and a constant `k`, `a` in a
    // general-purpose register: `imul $k, a, d` into `d`'s register, or into
    // %rax for a `d` held elsewhere (the low bits are the same signed or
    // not), re-extended for a signed 32-bit result; false when it isn't such
    // a product.
    fun emit_imul_const(var self, d: int32, op: str, rt: Type, a: int32, b: int32, temp_base: int32) -> bool {
        if op != "*" || text_has_xmm("%" + self.temp_reg[d]) || self.temp_imm[b] == "" { return false }
        let (w, sg) = match rt {
            Type.TInt(bits, s) => (bits, s),
            _ => (0, false),
        }
        if w != 64 && w != 32 { return false }
        let ra = self.reg_of(a)
        if ra == "" || text_has_xmm(ra) { return false }
        var dst = "%rax"
        if self.temp_reg[d] != "" { dst = "%" + self.temp_reg[d] }
        if w == 64 { self.emit(format("imulq {}, {}, {}", self.temp_imm[b], ra, dst)) }
        else {
            self.emit(format("imull {}, {}, {}", self.temp_imm[b], narrow_operand(ra, 4), narrow_operand(dst, 4)))
            if sg { self.emit(format("movslq {}, {}", narrow_operand(dst, 4), dst)) }
        }
        if dst == "%rax" { self.store_temp(d, temp_base) }
        return true
    }

    // `x = x op y` on a variable living in a register, for an integer `+`,
    // `-`, `&`, `|` or `^` whose result only the store into that variable
    // reads: one instruction on the register (and the result's
    // re-canonicalisation for a narrow `+` or `-`) instead of a round trip
    // through %rax; false when `a` and `b` aren't such a pair.
    fun emit_in_place(var self, a: Inst, b: Inst, temp_base: int32) -> bool {
        return match a {
            Inst.Bin(d, op, lt, rt, x, y, pos) => {
                var insn = ""
                if op == "+" { insn = "addq" }
                if op == "-" { insn = "subq" }
                if op == "&" { insn = "andq" }
                if op == "|" { insn = "orq" }
                if op == "^" { insn = "xorq" }
                // `x = x * k`: a three-operand `imul` on the register
                if op == "*" && self.temp_imm[y] != "" { insn = "imulq" }
                let w = match rt {
                    Type.TInt(bits, sg) => bits,
                    _ => 0,
                }
                if insn == "" || w == 0 || self.temp_uses[d] != 1 { return false }
                let s = match b {
                    Inst.Store(sl, v) => { if v == d { sl } else { -1 } },
                    _ => -1,
                }
                if s < 0 || self.slot_reg[s] == "" || text_has_xmm("%" + self.slot_reg[s]) { return false }
                let reg = "%" + self.slot_reg[s]
                if self.reg_of(x) != reg { return false }
                if insn == "imulq" {
                    self.emit(format("imulq {}, {}, {}", self.temp_imm[y], reg, reg))
                    if w < 64 { self.emit(canonical_insn(rt, reg)) }
                    return true
                }
                let src = self.second_operand(op, y, temp_base)
                self.emit(format("{} {}, {}", insn, src, reg))
                if (op == "+" || op == "-") && w < 64 { self.emit(canonical_insn(rt, reg)) }
                true
            },
            _ => false,
        }
    }

    // `d = a op b` (64-bit `+ - & | ^ *`) when `d`'s register holds `a` (or,
    // the order not mattering, `b`) already: the allocator gave it to `d`, so
    // that operand ends here, and the operation works on it in place.
    fun emit_bin_in_reg(var self, d: int32, op: str, rt: Type, a: int32, b: int32, temp_base: int32) -> bool {
        var insn = ""
        if op == "+" { insn = "addq" }
        if op == "-" { insn = "subq" }
        if op == "&" { insn = "andq" }
        if op == "|" { insn = "orq" }
        if op == "^" { insn = "xorq" }
        if op == "*" { insn = "imulq" }
        if insn == "" || !is_wide(rt) || self.temp_reg[d] == "" || self.temp_uses[d] == 0 { return false }
        let rd = "%" + self.temp_reg[d]
        if text_has_xmm(rd) { return false }
        var other = -1
        if self.reg_of(a) == rd { other = b }
        else if op != "-" && self.reg_of(b) == rd { other = a }
        if other < 0 { return false }
        self.emit(format("{} {}, {}", insn, self.second_operand(op, other, temp_base), rd))
        return true
    }

    // Two instructions emitted as one where a pattern allows (an element's
    // or a sum's address folded into the load after it, `x = x op y` in
    // place); false when none does. One match of `a` picks the candidates.
    fun emit_pair(var self, f: IrFunc, a: Inst, b: Inst, temp_base: int32) -> bool {
        return match a {
            Inst.Elem(e, c, i, stride, is_str, checked, p) => self.emit_elem_load(f, a, b, temp_base),
            Inst.Bin(d, op, lt, rt, x, y, pos) => self.emit_add_load(f, a, b, temp_base) || self.emit_in_place(a, b, temp_base),
            Inst.Cmp(d, op, t, x, y) => self.emit_compare_check(a, b, temp_base),
            Inst.Intr(d, op, args) => self.emit_fits_check(a, b, temp_base),
            _ => false,
        }
    }

    // `y = z << k` (k 1 to 3), `t = x + y` and the load or store through `t`
    // right after, each read only by the next: one addressing mode,
    // `off(x,z,2^k)`; nothing is written in between, so `x` and `z` still hold
    // their values (MYLA-162). False when they aren't such a triple.
    fun emit_scaled(var self, f: IrFunc, a: Inst, b: Inst, c: Inst, temp_base: int32) -> bool {
        var y = -1
        var z = -1
        var scale = 0
        match a {
            Inst.Bin(d, op, lt, rt, x1, k1, pos) => {
                if op == "<<" && is_wide(rt) && self.temp_uses[d] == 1 {
                    let k = self.temp_imm[k1]
                    if k == "$1" { scale = 2 }
                    if k == "$2" { scale = 4 }
                    if k == "$3" { scale = 8 }
                    y = d
                    z = x1
                }
            },
            _ => {},
        }
        if scale == 0 { return false }
        var t = -1
        var x = -1
        match b {
            Inst.Bin(d, op, lt, rt, x1, y1, pos) => {
                if op == "+" && is_wide(rt) && self.temp_uses[d] == 1 && y1 == y && x1 != y {
                    t = d
                    x = x1
                }
            },
            _ => {},
        }
        if t < 0 { return false }
        var d = -1
        var off = 0
        var width = 0
        var sv = -1
        match c {
            Inst.LoadAt(d2, q, o, w) => {
                if q == t {
                    d = d2
                    off = o
                    width = w
                }
            },
            Inst.StoreAt(q, o, v2, w) => {
                if q == t && v2 != t && v2 != y {
                    d = 0
                    sv = v2
                    off = o
                    width = w
                }
            },
            _ => {},
        }
        if d < 0 || x == z { return false }
        let rx = self.reg_of(x)
        if rx == "" || text_has_xmm(rx) { return false }
        // `z` just computed and read only here: still in %rax, its store
        // into its register not made
        let held = self.pend_store != "" && self.pend_temp == z && self.temp_uses[z] == 1
        var rz = "%rax"
        if !held { rz = self.reg_of(z) }
        if rz == "" || text_has_xmm(rz) { return false }
        // a stored value already where it is (loading it could take %rax)
        var vo = ""
        if sv >= 0 {
            vo = self.temp_imm[sv]
            if vo == "" { vo = self.reg_of(sv) }
            if vo == "" || text_has_xmm(vo) { return false }
        }
        if held {
            self.pend_store = ""
            self.pend_temp = -1
        }
        let at = format("{}({},{},{})", off, rx, rz, scale)
        if sv >= 0 {
            self.emit_store(width, f.temps[sv], vo, at)
            return true
        }
        self.emit_load(width, f.temps[d], at)
        self.store_temp(d, temp_base)
        return true
    }

    // `t = x + y` (64-bit) read only by the load through `t` right after it,
    // as that load's addressing mode, `off(x,y)` or `k+off(x)`: nothing is
    // written in between, so `x` and `y` still hold their values (MYLA-162);
    // false when `a` and `b` aren't such a pair.
    fun emit_add_load(var self, f: IrFunc, a: Inst, b: Inst, temp_base: int32) -> bool {
        return match a {
            Inst.Bin(t, op, lt, rt, x, y, pos) => {
                let wide = match rt {
                    Type.TInt(bits, sg) => bits == 64,
                    _ => false,
                }
                if !(op == "+" || op == "-") || !wide || self.temp_uses[t] != 1 { return false }
                // `x - k` only with a constant
                if op == "-" && self.temp_imm[y] == "" { return false }
                var d = -1
                var off = 0
                var width = 0
                // or the store through it: the value it stores (-1: a load)
                var sv = -1
                match b {
                    Inst.LoadAt(d2, q, o, w) => {
                        if q == t {
                            d = d2
                            off = o
                            width = w
                        }
                    },
                    Inst.StoreAt(q, o, v2, w) => {
                        if q == t && v2 != t {
                            d = 0
                            sv = v2
                            off = o
                            width = w
                        }
                    },
                    _ => {},
                }
                if d < 0 { return false }
                let rx = self.reg_of(x)
                if rx == "" || text_has_xmm(rx) { return false }
                var at = ""
                let k = self.temp_imm[y]
                if k != "" {
                    var sb = StringBuilder()
                    sb.append(k, 1, k.len())
                    // `x - k` is `-k+off(x)`, the sign written out
                    if op == "-" { at = format("{}-({})({})", off, sb.build(), rx) } else { at = format("{}+{}({})", sb.build(), off, rx) }
                } else {
                    let ry = self.reg_of(y)
                    if ry == "" || text_has_xmm(ry) { return false }
                    at = format("{}({},{})", off, rx, ry)
                }
                if sv >= 0 {
                    self.emit_store(width, f.temps[sv], self.value_operand(sv, temp_base), at)
                    return true
                }
                self.emit_load(width, f.temps[d], at)
                self.store_temp(d, temp_base)
                true
            },
            _ => false,
        }
    }

    // An element's address and the load of it that follows, as one
    // addressing mode (MYLA-120); false when `a` and `b` aren't such a pair.
    fun emit_elem_load(var self, f: IrFunc, a: Inst, b: Inst, temp_base: int32) -> bool {
        return match a {
            Inst.Elem(e, c, i, stride, is_str, checked, p) => {
                if self.temp_uses[e] != 1 { return false }
                let ok = match b {
                    Inst.LoadAt(d, q, off, width) => q == e && off == 0 && !is_str,
                    Inst.Load8(d, q) => q == e && is_str,
                    _ => false,
                }
                if !ok { return false }
                self.load_temp(c, "rax", temp_base)
                self.load_temp(i, "rcx", temp_base)
                if checked { self.emit_elem_check(p.line, p.col, is_str, f.temps[i]) }
                let at = self.elem_operand(is_str, stride)
                match b {
                    Inst.LoadAt(d, q, off, width) => {
                        self.emit_load(width, f.temps[d], at)
                        self.store_temp(d, temp_base)
                    },
                    Inst.Load8(d, q) => {
                        self.emit(format("movzbl {}, %eax", at))
                        self.store_temp(d, temp_base)
                    },
                    _ => {},
                }
                true
            },
            _ => false,
        }
    }

    // The second operand of the integer operator `op`, the first being in
    // %rax already (MYLA-120): an immediate, a variable's slot or the
    // temporary's cell where `op` takes one (`takes_operand`), else the
    // temporary loaded into %rcx. With %rax loaded no store of another
    // temporary is held back, so a cell holds its value.
    fun second_operand(var self, op: str, t: int32, temp_base: int32) -> str {
        if takes_operand(op) {
            if self.temp_imm[t] != "" { return self.temp_imm[t] }
            let m = self.take_load(t)
            if m != "" { return m }
            // just computed in %rax and read only here: from there
            if self.pend_store != "" && self.pend_temp == t && self.temp_uses[t] == 1 {
                self.pend_store = ""
                self.pend_temp = -1
                return "%rax"
            }
            if self.temp_src[t] != "" { return self.temp_src[t] }
            if self.temp_remat[t] == "" && !(self.pend_store != "" && self.pend_temp == t) {
                if self.temp_reg[t] != "" { return "%" + self.temp_reg[t] }
                return format("{}(%rbp)", self.temp_off[t])
            }
        }
        self.load_temp(t, "rcx", temp_base)
        return "%rcx"
    }

    // When the temporary `t` was just loaded from memory into %rax (8 bytes)
    // and only one instruction reads it: that load taken back and its memory
    // operand, for the reader to use in place of a register (MYLA-162);
    // "" otherwise.
    fun take_load(var self, t: int32) -> str {
        if !(self.pend_store != "" && self.pend_temp == t && self.temp_uses[t] == 1) { return "" }
        let n = self.text.len()
        if n == 0 { return "" }
        let line = self.text[n - 1]
        if !text_at(line, 0, "\tmovq ") || line.len() < 13 || !text_at(line, line.len() - 6, ", %rax") { return "" }
        var sb = StringBuilder()
        sb.append(line, 6, line.len() - 6)
        let src = sb.build()
        if !has_text(src, "(") || has_text(src, "%rax") || has_text(src, "%eax") { return "" }
        let gone = self.text.pop()
        self.pend_store = ""
        self.pend_temp = -1
        return src
    }

    // `decq` (atomic: `lock decq`) of the count before the cell at `p`.
    fun rc_dec(var self, atomic: bool, p: int32, temp_base: int32) -> str {
        var base = self.reg_of(p)
        if base == "" || text_has_xmm(base) {
            self.load_temp(p, "rcx", temp_base)
            base = "%rcx"
        }
        var insn = "decq"
        if atomic { insn = "lock decq" }
        self.emit(format("{} -8({})", insn, base))
        return base
    }

    // The memory operand of an atomic operation on the address `p`: the
    // runtime variable it names (`temp_mem`), else through %rcx.
    fun atomic_at(var self, p: int32, temp_base: int32) -> str {
        if self.temp_mem[p] != "" { return self.rt_var_at(self.temp_mem[p], 0) }
        self.load_temp(p, "rcx", temp_base)
        return "(%rcx)"
    }

    // The memory operand of the runtime variable `sym`, `off` bytes in: in
    // the worker's block with tasks (a worker's own), else next to %rip.
    fun rt_var_at(self, sym: str, off: int32) -> str {
        if self.frames && tls_offset(sym) != 0 { return format("%fs:{}", tls_offset(sym) + off) }
        if off == 0 { return format("{}(%rip)", sym) }
        return format("{}+{}(%rip)", sym, off)
    }

    // The arguments of a runtime helper into the calling registers.
    fun load_args(var self, args: [int32], temp_base: int32) {
        self.load_words(args, temp_base)
    }

    // How each temporary defined once, by a constant, a string's or symbol's
    // address or a slot's address, is recomputed where it is read instead of
    // being kept in a slot: the instruction up to its register's name
    // (MYLA-108); "" for the other temporaries.
    fun remat_texts(var self, f: IrFunc, slot_off: [int32], defs: [int32]) -> [str] {
        var out: [str] = []
        self.temp_fconst = [:]
        var src: [str] = []
        var imm: [str] = []
        var frame: [int32] = []
        var mem: [str] = []
        // how many reads of each temporary are the address of a load or store
        var at_uses: [int32] = []
        for t in f.temps {
            out.push("")
            src.push("")
            imm.push("")
            frame.push(0)
            mem.push("")
            at_uses.push(0)
        }
        for b in f.blocks {
            for inst in b.insts {
                match inst {
                    Inst.LoadAt(d, p, off, w) => { at_uses[p] += 1 },
                    Inst.StoreAt(p, off, v, w) => { if v != p { at_uses[p] += 1 } },
                    // an atomic's address
                    Inst.Intr(d, op, args) => {
                        if is_atomic_at(op) {
                            var k = 1
                            var again = false
                            while k < args.len() {
                                if args[k] == args[0] { again = true }
                                k += 1
                            }
                            if !again { at_uses[args[0]] += 1 }
                        }
                    },
                    _ => {},
                }
            }
        }
        for b in f.blocks {
            var i = 0
            while i < b.insts.len() {
                let inst = b.insts[i]
                match inst {
                    Inst.Const(d, t, v) => {
                        if defs[d] == 1 {
                            out[d] = self.def_text(inst, slot_off)
                            match t {
                                Type.TFloat(w) => { self.temp_fconst[d] = v },
                                _ => {},
                            }
                        }
                    },
                    Inst.Str(d, text) => { if defs[d] == 1 { out[d] = self.def_text(inst, slot_off) } },
                    Inst.Addr(d, sl) => { if defs[d] == 1 { out[d] = self.def_text(inst, slot_off) } },
                    Inst.Label(d, sym) => { if defs[d] == 1 { out[d] = self.def_text(inst, slot_off) } },
                    _ => {},
                }
                // a slot's address: its offset from %rbp (never 0), for loads
                // and stores through it
                match inst {
                    Inst.Addr(d, s) => { if defs[d] == 1 { frame[d] = slot_off[s] } },
                    // a runtime variable's address only loads and stores read:
                    // the variable itself their operand, nothing computed
                    Inst.Intr(d, op, args) => {
                        match op {
                            Intrinsic.RtAddr(sym) => {
                                if d >= 0 && defs[d] == 1 && self.temp_uses[d] > 0 && at_uses[d] == self.temp_uses[d] { mem[d] = sym }
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
                // an integer constant that fits a sign-extended 32-bit immediate
                match inst {
                    Inst.Const(d, t, v) => {
                        match t {
                            Type.TInt(w, sg) => {
                                let x = wrapped(v, w, sg)
                                if defs[d] == 1 && x >= -2147483648 && x <= 2147483647 { imm[d] = format("${}", x) }
                            },
                            Type.TBool => { if defs[d] == 1 { imm[d] = format("${}", v) } },
                            // a null address (D121)
                            Type.TPtr => { if defs[d] == 1 && v == 0 { imm[d] = "$0" } },
                            Type.TChar => { if defs[d] == 1 && v <= 2147483647 { imm[d] = format("${}", v) } },
                            _ => {},
                        }
                    },
                    _ => {},
                }
                // a variable's value read where every read of it follows,
                // in this block, with nothing in between that writes a slot
                match inst {
                    Inst.Load(d, s) => {
                        if defs[d] == 1 && reads_before_writes(b.insts, b.term, i, d, self.temp_uses[d]) {
                            if self.slot_reg[s] != "" { src[d] = "%" + self.slot_reg[s] } else if self.in_frame { src[d] = format("{}(%r15)", slot_off[s]) } else { src[d] = format("{}(%rbp)", slot_off[s]) }
                            out[d] = format("movq {}, %", src[d])
                        }
                    },
                    _ => {},
                }
                i = i + 1
            }
        }
        self.temp_src = src
        self.temp_imm = imm
        self.temp_frame = frame
        self.temp_mem = mem
        return out
    }

    // The code computing a constant, a string's or symbol's address or a
    // slot's address, up to its register's name; "" for other instructions.
    fun def_text(var self, inst: Inst, slot_off: [int32]) -> str {
        return match inst {
            Inst.Const(d, t, v) => match t {
                Type.TFloat(w) => {
                    self.uses_float = true
                    format("movabsq ${}, %", v)
                }
                Type.TInt(w, s) => int_const_text(wrapped(v, w, s))
                _ => format("movq ${}, %", v)
            }
            Inst.Str(d, text) => format("leaq {}(%rip), %", self.string_label(text))
            Inst.Addr(d, s) => self.slot_addr_text(slot_off[s])
            Inst.Label(d, sym) => format("leaq {}(%rip), %", sym)
            Inst.Position(d, p) => format("leaq {}(%rip), %", self.position_label(p.line, p.col))
            _ => ""
        }
    }

    // The code computing the address of the slot at `off`, up to its
    // register's name: in the stack frame, or a frame function's heap frame.
    fun slot_addr_text(self, off: int32) -> str {
        if self.in_frame { return format("leaq {}(%r15), %", off) }
        return format("leaq {}(%rbp), %", off)
    }

    // A constant or an address whose temporary is kept in its slot: computed
    // into %rax and stored.
    fun def_into_temp(var self, inst: Inst, d: int32, slot_off: [int32], temp_base: int32) {
        if self.temp_remat[d] != "" { return }
        self.emit(self.def_text(inst, slot_off) + "rax")
        self.store_temp(d, temp_base)
    }

    // Give each temporary that needs one a frame cell (`temp_off`), sharing
    // cells between temporaries whose lives don't overlap (MYLA-108): one
    // read and written within a single block gets a cell from its first
    // write to its last read (freed only after the instruction of that read,
    // which may still write its own result), by a linear scan in emission
    // order; one living in several blocks keeps a cell of its own. Returns
    // the number of cells.
    fun alloc_temps(var self, f: IrFunc, tc: Touches) -> int32 {
        let n = f.temps.len()
        var home: [int32] = []
        var cross: [bool] = []
        var last: [int32] = []
        var cell: [int32] = []
        var i = 0
        while i < n {
            home.push(-1)
            cross.push(false)
            last.push(-1)
            cell.push(-1)
            i = i + 1
        }
        // where each temporary lives and is last read
        var pos = 0
        for b in f.order {
            var i = tc.at[b]
            while i < tc.at[b] + f.blocks[b].insts.len() {
                var k = tc.wat[i]
                while k < tc.wat[i + 1] {
                    let t = tc.writes[k]
                    if home[t] < 0 { home[t] = b } else if home[t] != b { cross[t] = true }
                    k = k + 1
                }
                k = tc.rat[i]
                while k < tc.rat[i + 1] {
                    let t = tc.reads[k]
                    if home[t] < 0 { home[t] = b } else if home[t] != b { cross[t] = true }
                    last[t] = pos
                    k = k + 1
                }
                pos = pos + 1
                i = i + 1
            }
            for t in term_uses(f.blocks[b].term) {
                if home[t] < 0 { home[t] = b } else if home[t] != b { cross[t] = true }
                last[t] = pos
            }
            pos = pos + 1
        }
        var cells = 0
        i = 0
        while i < n {
            if cross[i] && self.temp_remat[i] == "" && self.temp_uses[i] > 0 && self.temp_reg[i] == "" {
                cell[i] = cells
                cells = cells + 1
            }
            i = i + 1
        }
        // the others, block by block
        var free: [int32] = []
        var active: [int32] = []
        pos = 0
        for b in f.order {
            var i = tc.at[b]
            while i < tc.at[b] + f.blocks[b].insts.len() {
                // the cells of the temporaries read for the last time freed,
                // the list rebuilt only then (MYLA-124)
                var ended = false
                for t in active {
                    if last[t] < pos { ended = true }
                }
                if ended {
                    var still: [int32] = []
                    for t in active {
                        if last[t] < pos { free.push(cell[t]) } else { still.push(t) }
                    }
                    active = still
                }
                var k = tc.wat[i]
                while k < tc.wat[i + 1] {
                    let t = tc.writes[k]
                    if !cross[t] && cell[t] < 0 && self.temp_remat[t] == "" && self.temp_uses[t] > 0 && self.temp_reg[t] == "" {
                        if free.len() > 0 { cell[t] = free.pop() } else {
                            cell[t] = cells
                            cells = cells + 1
                        }
                        active.push(t)
                    }
                    k = k + 1
                }
                pos = pos + 1
                i = i + 1
            }
            pos = pos + 1
        }
        var off: [int32] = []
        for c in cell { off.push(-8 * (c + 1)) }
        self.temp_off = off
        return cells
    }

    // No temporary or slot in a register (yet).
    fun clear_regs(var self, f: IrFunc) {
        var treg: [str] = []
        for t in f.temps { treg.push("") }
        var sreg: [str] = []
        for s in f.slots { sreg.push("") }
        self.temp_reg = treg
        self.slot_reg = sreg
        self.saved_regs = []
    }

    // Which temporaries and slots live in a callee-saved register (MYLA-121;
    // `temp_reg`, `slot_reg`) and which of them the function saves
    // (`saved_regs`). The candidates are the temporaries that would need a
    // frame cell and the scalar slots (8 bytes, owning nothing) that only
    // `load` and `store` touch, parameters included. Each has one live
    // interval over the reachable blocks in emission order (liveness across
    // blocks by backward dataflow); a linear scan hands out %rbx and
    // %r12-%r15, and when they run out the value with fewer reads and writes
    // (weighted by loop depth) gives way. Not under `-g`, whose variables
    // live in the frame. `clear_regs` has emptied the tables.
    fun alloc_regs(var self, f: IrFunc, reach: [bool], tc: Touches) {
        if self.debug { return }
        let nt = f.temps.len()
        let nv = nt + f.slots.len()
        // value v: the temporary v below nt, else the slot v - nt
        var cand: [bool] = []
        var i = 0
        while i < nt {
            cand.push(self.temp_remat[i] == "" && self.temp_uses[i] > 0)
            i = i + 1
        }
        // a frame function's slots are in its frame, never in a register
        for sl in f.slots { cand.push(sl.size == 8 && !sl.owns && !f.frame) }
        for b in f.blocks {
            var ii = 0
            for inst in b.insts {
                match inst {
                    Inst.Addr(d, s) => { cand[nt + s] = false },
                    Inst.Init(s) => { cand[nt + s] = false },
                    Inst.Moved(s) => { cand[nt + s] = false },
                    _ => {},
                }
                ii = ii + 1
            }
        }
        let depth = loop_depths(f, reach)

        // what each reachable instruction and terminator reads and writes, in
        // emission order (`tv[tat[p]]` up to `tv[tat[p + 1]]` at position p:
        // v read, -1 - v written); and per candidate its first and last
        // position, its weight, and whether liveness has to follow it across
        // blocks (used in two blocks, or read before written in its block)
        var tv: [int32] = []
        var tat: [int32] = []
        var first: [int32] = []
        var last: [int32] = []
        var weight: [int64] = []
        var home: [int32] = []
        var global: [bool] = []
        var src_slot: [int32] = []
        i = 0
        while i < nv {
            first.push(-1)
            last.push(-1)
            weight.push(0)
            home.push(-1)
            global.push(false)
            if i < nt { src_slot.push(-1) }
            i = i + 1
        }
        var bstart: [int32] = []
        var bend: [int32] = []
        for b in f.blocks {
            bstart.push(-1)
            bend.push(-1)
        }
        // per position, how many before it call something or use %r8-%r11
        // (`clobbers`), which values in those registers can't live across
        var cpre: [int32] = [0]
        // the same with the copies, whose `rep movs` uses %rsi and %rdi too
        var spre: [int32] = [0]
        // per position, whether it is a call reading all its operands before
        // it clobbers anything (`reads_then_calls`), and the instruction
        var callpos: [bool] = []
        var callinst: [Inst] = []
        // per value, whether a call reads it as its function value, after
        // its arguments are in their registers: no argument register for it
        // anywhere, not only where it is last read (the review of 2026-11-06,
        // R2: a parameter the `become` after it passes on wanted %rdi)
        var read_late: [bool] = []
        while read_late.len() < nv { read_late.push(false) }
        var pos = 0
        for b in f.order {
            if !reach[b] { continue }
            bstart[b] = pos
            var w: int64 = 1
            var d = 0
            while d < depth[b] && d < 3 {
                w = w * 10
                d = d + 1
            }
            var ii = tc.at[b]
            for inst in f.blocks[b].insts {
                tat.push(tv.len())
                var c = cpre[cpre.len() - 1]
                var sc = spre[spre.len() - 1]
                let kind = clobber_kind(inst)
                if kind == 2 {
                    c = c + 1
                    sc = sc + 1
                } else if kind == 1 { sc = sc + 1 }
                cpre.push(c)
                spre.push(sc)
                callpos.push(reads_then_calls(inst))
                callinst.push(inst)
                // a variable read where it is used is read there (`temp_src`)
                var k = tc.rat[ii]
                while k < tc.rat[ii + 1] {
                    let u = tc.reads[k]
                    if cand[u] { tv.push(u) }
                    if src_slot[u] >= 0 && cand[nt + src_slot[u]] { tv.push(nt + src_slot[u]) }
                    k = k + 1
                }
                match inst {
                    Inst.Load(t, sl) => {
                        if cand[nt + sl] { tv.push(nt + sl) }
                        if self.temp_src[t] != "" { src_slot[t] = sl }
                    },
                    Inst.Store(sl, v) => { if cand[nt + sl] { tv.push(-1 - (nt + sl)) } },
                    _ => {},
                }
                let fv = called_value(inst)
                if fv >= 0 {
                    if fv < nv { read_late[fv] = true }
                    if src_slot[fv] >= 0 && nt + src_slot[fv] < nv { read_late[nt + src_slot[fv]] = true }
                }
                k = tc.wat[ii]
                while k < tc.wat[ii + 1] {
                    if cand[tc.writes[k]] { tv.push(-1 - tc.writes[k]) }
                    k = k + 1
                }
                pos = pos + 1
                ii = ii + 1
            }
            tat.push(tv.len())
            cpre.push(cpre[cpre.len() - 1])
            spre.push(spre[spre.len() - 1])
            callpos.push(false)
            callinst.push(Inst.Init(-1))
            for u in term_uses(f.blocks[b].term) {
                if cand[u] { tv.push(u) }
                if src_slot[u] >= 0 && cand[nt + src_slot[u]] { tv.push(nt + src_slot[u]) }
            }
            bend[b] = pos
            pos = pos + 1
            // the block's positions, read before written
            var p = bstart[b]
            while p < pos {
                var k = tat[p]
                let end = match p + 1 < pos { true => tat[p + 1], false => tv.len() }
                while k < end {
                    var v = tv[k]
                    let read = v >= 0
                    if !read { v = -1 - v }
                    if first[v] < 0 {
                        first[v] = p
                        if read { global[v] = true }
                    }
                    last[v] = p
                    weight[v] = weight[v] + w
                    if home[v] < 0 { home[v] = b } else if home[v] != b { global[v] = true }
                    k = k + 1
                }
                p = p + 1
            }
        }
        tat.push(tv.len())
        let spans = self.live_spans(f, reach, cand, global, tv, tat, bstart, bend, first, last)
        // each value's lifetime as ranges of points, with the holes where it
        // isn't live (MYLA-257): position p is the points 2p (its reads) and
        // 2p + 1 (its writes), so a value read last at p and one written
        // there may share a register; its first and last position from them
        let lr = live_ranges(f, reach, cand, tv, tat, bstart, bend, spans.2, spans.3, spans.4)
        let rhead = lr.0
        let rlo = lr.1
        let rhi = lr.2
        let rnext = lr.3
        var rlast: [int32] = []
        i = 0
        while i < nv {
            rlast.push(-1)
            if rhead[i] >= 0 {
                first[i] = rlo[rhead[i]] / 2
                var r = rhead[i]
                while rnext[r] >= 0 { r = rnext[r] }
                rlast[i] = rhi[r]
                last[i] = rhi[r] / 2
            }
            i = i + 1
        }

        // float temporaries whose interval holds no call (nothing clobbers
        // there) live in %xmm2..%xmm15, which need no save (MYLA-249); the
        // rest go through the scan below like any other value
        self.alloc_xmm(f, nt, cand, first, last, weight, cpre, pos, tv, tat)
        i = 0
        while i < nv {
            if (i < nt && self.temp_reg[i] != "") || (i >= nt && self.slot_reg[i - nt] != "") { cand[i] = false }
            i = i + 1
        }

        // the linear scan, intervals by their start
        var head: [int32] = []
        i = 0
        while i <= pos {
            head.push(-1)
            i = i + 1
        }
        var link: [int32] = []
        var reg: [int32] = []
        i = 0
        while i < nv {
            link.push(-1)
            reg.push(-1)
            if cand[i] && rhead[i] >= 0 {
                let at = rlo[rhead[i]] / 2
                link[i] = head[at]
                head[at] = i
            }
            i = i + 1
        }
        // the callee-saved registers, then %rsi, %rdi and %r8-%r11 for a
        // value no call clobbers in its ranges (MYLA-134; for %rsi and %rdi
        // no copy either, MYLA-162), which cost no save
        var names = ["rbx", "r12", "r13", "r14", "r15", "rsi", "rdi", "r8", "r9", "r10", "r11"]
        // the callee-saved registers come first; %r15 holds a frame
        // function's frame (D90)
        var ncallee = 5
        if f.frame {
            names = ["rbx", "r12", "r13", "r14", "rsi", "rdi", "r8", "r9", "r10", "r11"]
            ncallee = 4
        }
        let si = ncallee      // %rsi's place, %rdi's after it
        let nr = names.len()
        // per register, the values holding it: a list through `hnext` from
        // `hfirst`, those whose last range is over unlinked as they are met
        var hfirst: [int32] = []
        while hfirst.len() < nr { hfirst.push(-1) }
        // per value, the other side of a copy it is in (a `mov`, a store of a
        // temporary into a slot): taking that one's register makes the copy
        // nothing (MYLA-257)
        var hint: [int32] = []
        i = 0
        while i < nv {
            hint.push(-1)
            i = i + 1
        }
        for b in f.order {
            if !reach[b] { continue }
            for inst in f.blocks[b].insts {
                match inst {
                    Inst.Mov(d, a) => {
                        if cand[d] && cand[a] {
                            hint[d] = a
                            if hint[a] < 0 { hint[a] = d }
                        }
                    },
                    Inst.Store(sl, x) => {
                        if cand[nt + sl] && cand[x] {
                            if hint[nt + sl] < 0 { hint[nt + sl] = x }
                            hint[x] = nt + sl
                        }
                    },
                    _ => {},
                }
            }
        }
        var hnext: [int32] = []
        // per holder, its first range not over yet at the scan's point
        var hcur: [int32] = []
        i = 0
        while i < nv {
            hnext.push(-1)
            hcur.push(rhead[i])
            i = i + 1
        }
        // by position, a value live into its block (from the point 2p) before
        // one written there (2p + 1)
        var pp = 0
        while pp <= pos {
            var odd = 0
            while odd < 2 {
                var v = head[pp]
                while v >= 0 {
                    let pt = rlo[rhead[v]]
                    if pt % 2 == odd {
                        // which registers v may take: a caller-saved one only when
                        // no call clobbers it in its ranges, %rsi and %rdi only when
                        // no copy does either, an argument register not for a
                        // function value read after the arguments
                        let cls = range_clobbers(rhead[v], rlo, rhi, rnext, cpre, spre, callpos)
                        var top = ncallee
                        if cls.0 == 0 { top = nr }
                        let si_ok = cls.1 == 0
                        // v in one range (most temporaries): a holder meets it when
                        // its first range not over yet starts before v's end
                        let single = rnext[rhead[v]] < 0
                        let vend = rlast[v]
                        var want = ""
                        var late = read_late[v]
                        if rlast[v] % 2 == 0 && callpos[rlast[v] / 2] {
                            let k = call_arg_index(callinst[rlast[v] / 2], v, nt, src_slot)
                            if k == 99 { late = true } else if k >= 0 && k < REG_WORDS { want = arg_reg(k) }
                        }
                        // the registers v may take, in the order it prefers them: its
                        // own argument register, then a caller-saved one, then a
                        // callee-saved one; the first none of whose holders is in
                        // its way, the holders done before v unlinked on the way and
                        // each one's cursor moved to its first range not over; when
                        // none is free, the one whose holders in the way weigh
                        // least, if less than v
                        var want_at = -1
                        if want != "" {
                            var x = top - 1
                            while x >= ncallee {
                                if names[x] == want { want_at = x }
                                x = x - 1
                            }
                        }
                        // the register of the other side of its copy first
                        if hint[v] >= 0 && reg[hint[v]] >= 0 && reg[hint[v]] < top { want_at = reg[hint[v]] }
                        var pick = -1
                        var best = -1
                        var best_w: int64 = 0
                        var pass = 0
                        while pass < 2 && pick < 0 {
                            // pass 0: the first free register; pass 1: the lightest
                            var q = -1
                            while q < top && pick < 0 {
                                var r = want_at
                                if q >= 0 { r = top - 1 - q }
                                q = q + 1
                                if r < 0 { continue }
                                // %rsi and %rdi only when no copy clobbers v; no
                                // argument register for a late function value
                                if r == si || r == si + 1 {
                                    if !si_ok || late { continue }
                                } else if late && r >= nr - 4 && r < nr - 2 { continue }
                                var wsum: int64 = 0
                                var prev = -1
                                var h = hfirst[r]
                                while h >= 0 && (pass == 1 || wsum == 0) {
                                    let nx = hnext[h]
                                    if rlast[h] < pt || reg[h] != r {
                                        if prev < 0 { hfirst[r] = nx } else { hnext[prev] = nx }
                                    } else {
                                        var c = hcur[h]
                                        while rhi[c] < pt { c = rnext[c] }
                                        hcur[h] = c
                                        var meets = false
                                        if single { meets = rlo[c] <= vend } else { meets = ranges_meet(c, rhead[v], rlo, rhi, rnext) }
                                        if meets { wsum = wsum + weight[h] + 1 }
                                        prev = h
                                    }
                                    h = nx
                                }
                                if pass == 0 && wsum == 0 { pick = r }
                                if pass == 1 && wsum > 0 && wsum <= weight[v] && (best < 0 || wsum < best_w) {
                                    best = r
                                    best_w = wsum
                                }
                            }
                            pass = pass + 1
                        }
                        if pick < 0 && best >= 0 {
                            var h = hfirst[best]
                            while h >= 0 {
                                if reg[h] == best && rlast[h] >= pt && ranges_meet(hcur[h], rhead[v], rlo, rhi, rnext) { reg[h] = -1 }
                                h = hnext[h]
                            }
                            pick = best
                        }
                        if pick >= 0 {
                            hnext[v] = hfirst[pick]
                            hfirst[pick] = v
                            reg[v] = pick
                        }
                    }
                    v = link[v]
                }
                odd = odd + 1
            }
            pp = pp + 1
        }

        // a callee-saved register is worth its save and restore only with
        // enough use
        var used: [int64] = []
        while used.len() < nr { used.push(0) }
        i = 0
        while i < nv {
            if reg[i] >= 0 { used[reg[i]] = used[reg[i]] + weight[i] }
            i = i + 1
        }
        i = 0
        while i < nv {
            if reg[i] >= 0 && (reg[i] >= ncallee || used[reg[i]] >= REG_MIN_USE) {
                if i < nt { self.temp_reg[i] = names[reg[i]] } else { self.slot_reg[i - nt] = names[reg[i]] }
            }
            i = i + 1
        }
        var r = 0
        while r < ncallee {
            if used[r] >= REG_MIN_USE { self.saved_regs.push(names[r]) }
            r = r + 1
        }
    }

    // %xmm2..%xmm15 for the float values (temporaries, and variables' slots,
    // value v the slot v - nt from nt on) among `cand` whose interval
    // `first`..`last` no position clobbers (`cpre`), by a linear scan in
    // which a lighter value gives way to a heavier one (MYLA-249).
    fun alloc_xmm(var self, f: IrFunc, nt: int32, cand: [bool], first: [int32], last: [int32], weight: [int64], cpre: [int32], pos: int32, tv: [int32], tat: [int32]) {
        let nv = nt + f.slots.len()
        var head: [int32] = []
        while head.len() < pos { head.push(-1) }
        var link: [int32] = []
        var i = 0
        while i < nv {
            link.push(-1)
            let ty = if i < nt { f.temps[i] } else { f.slots[i - nt].ty }
            let float = match ty { Type.TFloat(w) => true, _ => false }
            if cand[i] && float && first[i] >= 0 && cpre[last[i] + 1] - cpre[first[i]] == 0 {
                link[i] = head[first[i]]
                head[first[i]] = i
            }
            i = i + 1
        }
        let nr = 14
        var owner: [int32] = []
        var reg: [int32] = []
        while owner.len() < nr { owner.push(-1) }
        while reg.len() < nv { reg.push(-1) }
        var p = 0
        while p < pos {
            var v = head[p]
            while v >= 0 {
                var r = 0
                while r < nr {
                    if owner[r] >= 0 && (last[owner[r]] < p || (last[owner[r]] == p && written_at(tv, tat, p, v))) { owner[r] = -1 }
                    r = r + 1
                }
                var pick = -1
                r = 0
                while r < nr && pick < 0 {
                    if owner[r] < 0 { pick = r }
                    r = r + 1
                }
                if pick < 0 {
                    var low = 0
                    r = 1
                    while r < nr {
                        if weight[owner[r]] < weight[owner[low]] { low = r }
                        r = r + 1
                    }
                    if weight[owner[low]] < weight[v] {
                        reg[owner[low]] = -1
                        pick = low
                    }
                }
                if pick >= 0 {
                    owner[pick] = v
                    reg[v] = pick
                }
                v = link[v]
            }
            p = p + 1
        }
        i = 0
        while i < nv {
            if reg[i] >= 0 {
                let name = format("xmm{}", reg[i] + 2)
                if i < nt { self.temp_reg[i] = name } else { self.slot_reg[i - nt] = name }
            }
            i = i + 1
        }
    }

    // The %xmm register the temporary `t` lives in, or "".
    fun xmm_home(var self, t: int32) -> str {
        let r = self.reg_of(t)
        if r.len() > 4 && r[1] == 'x' && r[2] == 'm' && r[3] == 'm' { return r }
        return ""
    }

    // The float temporary `t` in an %xmm register: its home, or loaded into
    // `gpr` and moved into `xmm`.
    fun xmm_in(var self, t: int32, gpr: str, xmm: str, temp_base: int32) -> str {
        let home = self.xmm_home(t)
        if home != "" { return home }
        if self.float_const_into(t, "%" + xmm) { return "%" + xmm }
        let r = self.reg_of(t)
        if r != "" && self.temp_remat[t] == "" {
            self.emit(format("movq {}, %{}", r, xmm))   // a general-purpose register
            return "%" + xmm
        }
        self.load_temp(t, gpr, temp_base)
        self.emit(format("movq %{}, %{}", gpr, xmm))
        return "%" + xmm
    }

    // The float constant `t` (one recomputed where it is read) into the
    // %xmm register `xmm` (MYLA-249): +0.0 by `xorpd`, any other from the
    // constant pool, instead of through a general-purpose register; false
    // when `t` is no such constant.
    fun float_const_into(var self, t: int32, xmm: str) -> bool {
        if self.temp_remat[t] == "" || !self.temp_fconst.contains(t) { return false }
        let bits = self.temp_fconst[t]
        if self.pend_store != "" { self.flush_temp_in_rax() }
        if bits == 0 {
            self.emit(format("xorpd {}, {}", xmm, xmm))
            return true
        }
        self.emit(format("movsd {}(%rip), {}", self.fconst_label(bits), xmm))
        return true
    }

    // The constant pool's label for the float bits `bits`, made the first
    // time, in .rodata: named by the bits, so that a constant added renames
    // no other (MYLA-552).
    fun fconst_label(var self, bits: int64) -> str {
        if self.fconst_labels.contains(bits) { return self.fconst_labels[bits] }
        let lab = format(".Lfc{:x}", bits as uint64)
        self.fconst_labels[bits] = lab
        self.rodata.push(format("\t.p2align 3\n{}:\n\t.quad {}", lab, bits))
        return lab
    }

    // %xmm0, a float result, into the temporary `d`: moved into its %xmm
    // home, else through %rax as any value.
    fun xmm_result(var self, d: int32, temp_base: int32) {
        let home = self.xmm_home(d)
        if home != "" {
            if self.pend_store != "" { self.flush_temp_in_rax() }
            self.emit(format("movapd %xmm0, {}", home))
        } else {
            self.emit("movq %xmm0, %rax")
            self.store_temp(d, temp_base)
        }
    }

    // The intervals `first`..`last` (`alloc_regs`) stretched over each
    // reachable block that a value liveness follows across blocks is live
    // into or out of.
    fun live_spans(self, f: IrFunc, reach: [bool], cand: [bool], global: [bool], tv: [int32], tat: [int32], bstart: [int32], bend: [int32], first: [int32], last: [int32]) -> ([int32], [int32], [int64], [int32], int32) {
        var lo = first
        var hi = last
        // the values liveness follows, numbered densely
        var gid: [int32] = []
        var gval: [int32] = []
        var i = 0
        while i < cand.len() {
            if cand[i] && global[i] {
                gid.push(gval.len())
                gval.push(i)
            } else { gid.push(-1) }
            i = i + 1
        }
        let ng = gval.len()
        if ng == 0 { return (lo, hi, [], gid, 0) }
        let nw = (ng + 63) / 64
        let nb = f.blocks.len()
        // what each block reads before writing it (use) and writes (def)
        var use_bits: [int64] = []
        var def_bits: [int64] = []
        var live_in: [int64] = []
        var live_out: [int64] = []
        i = 0
        while i < nb * nw {
            use_bits.push(0)
            def_bits.push(0)
            live_in.push(0)
            live_out.push(0)
            i = i + 1
        }
        // and its successors (-1: none)
        var succ1: [int32] = []
        var succ2: [int32] = []
        for b in f.blocks {
            let ss = successors(b.term)
            succ1.push(match ss.len() > 0 { true => ss[0], false => -1 })
            succ2.push(match ss.len() > 1 { true => ss[1], false => -1 })
        }
        let one: int64 = 1
        for b in f.order {
            if !reach[b] { continue }
            let base = b * nw
            var k = tat[bstart[b]]
            while k < tat[bend[b] + 1] {
                var v = tv[k]
                let read = v >= 0
                if !read { v = -1 - v }
                let g = gid[v]
                if g >= 0 {
                    let at = base + g / 64
                    let bit = one << ((g % 64) as int64)
                    if read {
                        if def_bits[at] & bit == 0 { use_bits[at] = use_bits[at] | bit }
                    } else { def_bits[at] = def_bits[at] | bit }
                }
                k = k + 1
            }
        }
        // live in = use | (live out & ~def), live out = the successors' live in
        var changed = true
        while changed {
            changed = false
            var k = f.order.len() - 1
            while k >= 0 {
                let b = f.order[k]
                if reach[b] {
                    let base = b * nw
                    let s1 = succ1[b]
                    let s2 = succ2[b]
                    var j = 0
                    while j < nw {
                        var out: int64 = 0
                        if s1 >= 0 { out = live_in[s1 * nw + j] }
                        if s2 >= 0 { out = out | live_in[s2 * nw + j] }
                        live_out[base + j] = out
                        let inn = use_bits[base + j] | (out & ~def_bits[base + j])
                        if inn != live_in[base + j] {
                            live_in[base + j] = inn
                            changed = true
                        }
                        j = j + 1
                    }
                }
                k = k - 1
            }
        }
        // (each value's ranges come from these sets: `live_ranges`)
        return (lo, hi, live_out, gid, nw)
    }

    // Push the temporary `t` (a call's argument): straight from its slot, or
    // from the variable it was read from.
    fun push_temp(var self, t: int32, temp_base: int32) {
        if self.temp_src[t] != "" {
            self.emit("pushq " + self.temp_src[t])
            return
        }
        if self.temp_remat[t] != "" || (self.pend_store != "" && self.pend_temp == t) {
            self.load_temp(t, "rax", temp_base)
            self.emit("pushq %rax")
            return
        }
        if self.temp_reg[t] != "" { self.emit("pushq %" + self.temp_reg[t]) }
        else { self.emit(format("pushq {}(%rbp)", self.temp_off[t])) }
    }

    // The temporary `t` into `reg`. Read right after it was computed, it is
    // still in %rax: moved from there, and stored first only when something
    // else reads it too (MYLA-108).
    fun load_temp(var self, t: int32, reg: str, temp_base: int32) {
        if self.temp_remat[t] != "" {
            // (a variable's register read into itself: nothing to do)
            if !names_reg(self.temp_src[t], reg) { self.emit(self.temp_remat[t] + reg) }
            return
        }
        if self.pend_store != "" && self.pend_temp == t {
            if self.temp_uses[t] > 1 { self.flush_temp_in_rax() } else {
                self.pend_store = ""
                self.pend_temp = -1
                // read once, by this: loaded straight into `reg` (MYLA-125)
                if reg != "rax" {
                    let n = self.text.len()
                    let folded = fold_load_for_reader(self.text[n - 1], "%" + reg)
                    if folded != "" {
                        self.text[n - 1] = folded
                        return
                    }
                }
            }
            if reg != "rax" { self.emit(format("movq %rax, %{}", reg)) }
            return
        }
        if self.temp_reg[t] != "" {
            if self.temp_reg[t] != reg { self.emit(format("movq %{}, %{}", self.temp_reg[t], reg)) }
            return
        }
        self.emit(format("movq {}(%rbp), %{}", self.temp_off[t], reg))
    }

    // %rax into the temporary `t`: the store is held back until the next
    // line, which may read `t` (see `load_temp`); a temporary nothing reads
    // isn't stored.
    fun store_temp(var self, t: int32, temp_base: int32) {
        if self.pend_store != "" { self.flush_temp_in_rax() }
        if self.temp_uses[t] == 0 { return }
        if self.temp_reg[t] != "" { self.pend_store = "movq %rax, %" + self.temp_reg[t] }
        else { self.pend_store = format("movq %rax, {}(%rbp)", self.temp_off[t]) }
        self.pend_temp = t
    }

    // Whether the integer operation `op` on `a` and `b` is better done as
    // `b op' a` (`swapped_cmp`): `b` is still in %rax, `a` isn't.
    fun swap_operands(self, op: str, a: int32, b: int32) -> bool {
        if !(self.pend_store != "" && self.pend_temp == b) || a == b { return false }
        return op == "+" || op == "*" || op == "&" || op == "|" || op == "^" || op == "==" || op == "!=" || is_cmp(op)
    }

    // The register holding the temporary `t` now (MYLA-121): its own, or the
    // variable's it is read from; "" when it isn't in one (its store into
    // its register still held back, its value is in %rax).
    fun reg_of(var self, t: int32) -> str {
        if self.pend_store != "" && self.pend_temp == t {
            // held back in %rax: stored into its register now when it has
            // one and is read again later (the instruction that computed it
            // writing there instead, `flush_temp`), so this reader takes it
            // from there (MYLA-257)
            if self.temp_reg[t] != "" && self.temp_uses[t] > 1 && !text_has_xmm("%" + self.temp_reg[t]) {
                self.flush_temp()
                return "%" + self.temp_reg[t]
            }
            return ""
        }
        if self.temp_reg[t] != "" { return "%" + self.temp_reg[t] }
        let src = self.temp_src[t]
        if src.len() > 0 && src[0] == '%' { return src }
        return ""
    }

    // The temporary `t` as the source of a store: an immediate, its
    // register, else loaded into %rax.
    fun value_operand(var self, t: int32, temp_base: int32) -> str {
        if self.temp_imm[t] != "" { return self.temp_imm[t] }
        let r = self.reg_of(t)
        if r != "" { return r }
        self.load_temp(t, "rax", temp_base)
        return "%rax"
    }

    // The flags of the temporary `t` against zero, for a jump.
    fun emit_test(var self, t: int32, temp_base: int32) {
        var r = self.reg_of(t)
        if r == "" {
            self.load_temp(t, "rax", temp_base)
            r = "%rax"
        }
        self.emit(format("testq {}, {}", r, r))
    }
}

// The least loop-weighted reads and writes of the values in a callee-saved
// register that pay for saving and restoring it (MYLA-121; on the compiler
// compiling itself, 4 and 12 ran equally fast and 12 ran 1.6% fewer
// instructions, 40 was slower).
const REG_MIN_USE: int64 = 4

// How many loops each reachable block of `f` is in: a jump back to a block
// emitted earlier closes a loop over the blocks emitted from there to it.
fun loop_depths(f: IrFunc, reach: [bool]) -> [int32] {
    var at: [int32] = []
    var depth: [int32] = []
    for b in f.blocks {
        at.push(-1)
        depth.push(0)
    }
    var k = 0
    while k < f.order.len() {
        at[f.order[k]] = k
        k = k + 1
    }
    k = 0
    while k < f.order.len() {
        let b = f.order[k]
        if reach[b] {
            for s in successors(f.blocks[b].term) {
                if at[s] <= k {
                    var j = at[s]
                    while j <= k {
                        depth[f.order[j]] = depth[f.order[j]] + 1
                        j = j + 1
                    }
                }
            }
        }
        k = k + 1
    }
    return depth
}

// The condition code of a conditional jump taken when `op` holds between
// two integers (signed or not), as `cmpq %rcx, %rax` compares them.
#test("<", true)["l"]
#test("<", false)["b"]
#test(">=", false)["ae"]
#test("!=", true)["ne"]
fun jump_cond(op: str, signed: bool) -> str {
    if op == "==" { return "e" }
    if op == "!=" { return "ne" }
    if op == "<" { if signed { return "l" } else { return "b" } }
    if op == "<=" { if signed { return "le" } else { return "be" } }
    if op == ">" { if signed { return "g" } else { return "a" } }
    if signed { return "ge" }
    return "ae"
}

// The index of the call in `insts` that the terminator `term` returns the
// result of at once, so it can be a tail call (`emit_tail_call`); -1 when
// there is none. After the call only a `moved`, debug information, the
// result stored into an owning slot that is then moved, or drops may follow;
// the drops go before the call (`hoist_tail_drops`), so no argument may
// depend on what they drop (`drops_after_free`). No argument may be an address in this frame either,
// which the jump leaves (`passes_frame_address`).
#test([], Term.Jmp(6))[-1]
#test([], Term.Ret(0))[-1]
#test([], Term.Br(5, 5, 7))[-1]
pub fun tail_call_at(insts: [Inst], term: Term) -> int32 {
    let v = match term {
        Term.Ret(x) => x,
        _ => -2,
    }
    if v == -2 { return -1 }
    var i = insts.len() - 1
    var moved = -1
    while i >= 0 {
        match insts[i] {
            Inst.Call(d, name, args) => {
                if d != v { return -1 }
                return i
            },
            Inst.Moved(s) => { moved = s },
            Inst.Store(s, x) => {
                // the result kept in an owning slot only to be moved out
                if x != v || s != moved { return -1 }
            },
            // dropped before the jump when no argument depends on it
            // (`drops_after_free`)
            Inst.DropSlot(t, s) => {},
            Inst.Loc(p) => {},
            Inst.Scope(open) => {},
            Inst.Bind(n, s) => {},
            _ => { return -1 },
        }
        i = i - 1
    }
    return -1
}

// Whether no argument of the call `insts[at]` depends on a slot dropped
// after it (MYLA-126), so those drops can go before a tail call: an argument
// read from the slot, through it, or kept in it (a call's result held by a
// statement's temporary) depends on it, and so does one read from a slot
// that owns nothing (a borrowing `let`, a match's copy) whatever was put
// into that slot depends on (a parameter's slot excepted: the caller keeps
// its value alive); one taken from another block may depend on anything.
pub fun drops_after_free(f: IrFunc, insts: [Inst], at: int32) -> bool {
    var dropped: [int32] = []
    var j = at + 1
    while j < insts.len() {
        match insts[j] {
            Inst.DropSlot(t, s) => { dropped.push(s) },
            _ => {},
        }
        j = j + 1
    }
    if dropped.len() == 0 { return true }
    var none: [int32] = []
    let args = match insts[at] {
        Inst.Call(d, name, a) => a,
        _ => none,
    }
    for a in args {
        var work = [a]
        var seen: [int32] = []
        while work.len() > 0 {
            let t = work.pop()
            if contains_int(seen, t) { continue }
            seen.push(t)
            // kept in a dropped slot
            var k = 0
            while k < at {
                match insts[k] {
                    Inst.Store(s, x) => { if x == t && contains_int(dropped, s) { return false } },
                    _ => {},
                }
                k = k + 1
            }
            // where it comes from
            var found = false
            k = at - 1
            while k >= 0 && !found {
                match insts[k] {
                    Inst.Load(d, s) => {
                        if d == t {
                            found = true
                            if contains_int(dropped, s) { return false }
                            if !f.slots[s].owns && f.slots[s].word == -1 {
                                let src = filled_from(insts, k, s)
                                if src.len() == 0 { return false }
                                for u in src { work.push(u) }
                            }
                        }
                    },
                    Inst.Addr(d, s) => {
                        if d == t {
                            found = true
                            if contains_int(dropped, s) { return false }
                            if !f.slots[s].owns && f.slots[s].word == -1 {
                                let src = filled_from(insts, k, s)
                                if src.len() == 0 { return false }
                                for u in src { work.push(u) }
                            }
                        }
                    },
                    Inst.LoadAt(d, p, off, width) => { if d == t { found = true; work.push(p) } },
                    Inst.Offset(d, p, off) => { if d == t { found = true; work.push(p) } },
                    Inst.Elem(d, c, i, stride, is_str, checked, pos) => { if d == t { found = true; work.push(c) } },
                    Inst.Const(d, ty, v) => { if d == t { found = true } },
                    Inst.Str(d, text) => { if d == t { found = true } },
                    Inst.Bin(d, op, lt, rt, x, y, pos) => { if d == t { found = true } },
                    Inst.Cmp(d, op, ty, x, y) => { if d == t { found = true } },
                    Inst.Un(d, op, ty, x) => { if d == t { found = true } },
                    Inst.Mov(d, x) => { if d == t { found = true; work.push(x) } },
                    Inst.Cast(d, ft, tt, x) => { if d == t { found = true } },
                    Inst.Call(d, name, xs) => { if d == t { found = true } },
                    Inst.Rt(d, name, xs) => { if d == t { found = true } },
                    Inst.Intr(d, op, xs) => { if d == t { found = true } },
                    _ => {},
                }
                k = k - 1
            }
            if !found { return false }
        }
    }
    return true
}

// The temporaries stored or copied into the slot `s` before `insts[at]`, in
// this block (`drops_after_free`); none when it isn't filled here.
fun filled_from(insts: [Inst], at: int32, s: int32) -> [int32] {
    var out: [int32] = []
    var addrs: [int32] = []
    var k = 0
    while k < at {
        match insts[k] {
            Inst.Store(x, v) => { if x == s { out.push(v) } },
            Inst.Addr(d, x) => { if x == s { addrs.push(d) } },
            Inst.Copy(d, src, size) => { if contains_int(addrs, d) { out.push(src) } },
            _ => {},
        }
        k = k + 1
    }
    return out
}


// Whether the code of `inst` calls something (a function, a runtime helper,
// a retain or drop walk) or uses %r8-%r11 itself: a value in one of those
// registers can't live across it (MYLA-134). A trap never returns.
#test(Inst.Frame(2))[true]
#test(Inst.Init(0))[false]
#test(Inst.Init(1))[false]
fun clobbers(inst: Inst) -> bool {
    return clobber_kind(inst) == 2
}

// 2 when `inst` clobbers the caller-saved registers (`clobbers`), 1 when it
// is a copy between memory blocks, whose `rep movs` or moves go through %rsi
// and %rdi, else 0 (one match: passing an instruction copies it).
#test(Inst.Intr(-1, Intrinsic.RunFrame, [1]))[2]
#test(Inst.Intr(1, Intrinsic.CallCode, [2, 3]))[2]
#test(Inst.Intr(1, Intrinsic.Cas64, [2, 3, 4]))[0]
fun clobber_kind(inst: Inst) -> int32 {
    return match inst {
        Inst.Const(d, t, v) => 0,
        Inst.Str(d, text) => 0,
        Inst.Load(d, s) => 0,
        Inst.Store(s, v) => 0,
        Inst.Addr(d, s) => 0,
        Inst.Offset(d, p, off) => 0,
        Inst.LoadAt(d, p, off, width) => 0,
        Inst.StoreAt(p, off, v, width) => 0,
        Inst.Copy(d, src, size) => 1,
        Inst.Bin(d, op, lt, rt, a, b, pos) => if float_rem(op, lt) { 2 } else { 0 },
        Inst.Cmp(d, op, t, a, b) => 0,
        Inst.Un(d, op, t, a) => 0,
        Inst.Mov(d, a) => 0,
        Inst.Cast(d, from_t, to_t, a) => 0,
        Inst.Init(s) => 0,
        Inst.Elem(d, c, i, stride, is_str, checked, pos) => 0,
        Inst.Load8(d, p) => 0,
        Inst.Check(v, kind, pos) => 0,
        Inst.Global(d, sym, width) => 0,
        Inst.Moved(s) => 0,
        Inst.Label(d, sym) => 0,
        Inst.Position(d, p) => 0,
        Inst.Loc(p) => 0,
        Inst.Bind(name, s) => 0,
        Inst.Scope(open) => 0,
        // an intrinsic calls nothing but `unique`'s clone and `run_frame`'s
        // resume function
        Inst.Intr(d, op, args) => match op {
            Intrinsic.Unique(clone) => 2
            Intrinsic.RunFrame => 2
            Intrinsic.CallCode => 2
            _ => 0
        },
        _ => 2,
    }
}

// The SSE instruction of a float arithmetic operator.
#test("+")["addsd"]
#test("/")["divsd"]
fun float_insn(op: str) -> str {
    if op == "+" { return "addsd" }
    if op == "-" { return "subsd" }
    if op == "*" { return "mulsd" }
    return "divsd"
}

// Whether a binary operation is a float `%`, which calls `__fmod`.
#test("%", Type.TFloat(64))[true]
#test("+", Type.TFloat(32))[false]
#test("+", Type.TFloat(64))[false]
fun float_rem(op: str, t: Type) -> bool {
    if op != "%" { return false }
    return match t {
        Type.TFloat(w) => true,
        _ => false,
    }
}

#test([1, 2], 2)[true]
#test([1, 2], 3)[false]
fun contains_int(xs: [int32], x: int32) -> bool {
    for y in xs {
        if y == x { return true }
    }
    return false
}

// Whether the call `c` passes an argument that may be an address in the
// caller's frame (`frame_addresses`).
#test(Inst.Call(1, "Shape.area", [0]), [false, false])[false]
#test(Inst.Call(2, "inc", [1]), [false, false, false])[false]
#test(Inst.Call(4, "Money.compare", [2, 3]), [true, false, true, false, false])[true]
pub fun passes_frame_address(c: Inst, in_frame: [bool]) -> bool {
    return match c {
        Inst.Call(d, name, args) => {
            for a in args {
                if in_frame[a] { return true }
            }
            false
        },
        _ => false,
    }
}

// Which temporaries of `f` may hold an address in its frame: a slot's
// address, or one computed from such an address.
pub fun frame_addresses(f: IrFunc) -> [bool] {
    var out: [bool] = []
    for t in f.temps { out.push(false) }
    var changed = true
    while changed {
        changed = false
        for b in f.blocks {
            for inst in b.insts {
                match inst {
                    Inst.Addr(d, s) => { if !out[d] { out[d] = true; changed = true } },
                    Inst.Offset(d, p, off) => { if out[p] && !out[d] { out[d] = true; changed = true } },
                    _ => {},
                }
            }
        }
    }
    return out
}

// The value of an immediate operand's text (`$-12` is -12).
#test("$32")[32]
#test("$-12")[-12]
#test("$0")[0]
fun imm_int(imm: str) -> int64 {
    var v: int64 = 0
    var i = 1
    var neg = false
    if i < imm.len() && imm[i] == '-' {
        neg = true
        i = 2
    }
    while i < imm.len() {
        v = v * 10 + ((imm[i] as int64) - 48)
        i = i + 1
    }
    if neg { return -v }
    return v
}

// k when the immediate `imm` is `$2^k` (0 < k < 32), else 0.
#test("$8")[3]
#test("$2")[1]
#test("$6")[0]
#test("$1")[0]
#test("$-8")[0]
fun power_of_two(imm: str) -> int32 {
    let one: int64 = 1
    var k = 1
    while k < 32 {
        if imm == format("${}", one << (k as int64)) { return k }
        k = k + 1
    }
    return 0
}

// The comparison that holds for `b, a` exactly when `op` holds for `a, b`;
// any other operator is the same both ways.
#test("<")[">"]
#test(">=")["<="]
#test("==")["=="]
#test("+")["+"]
fun swapped_cmp(op: str) -> str {
    if op == "<" { return ">" }
    if op == ">" { return "<" }
    if op == "<=" { return ">=" }
    if op == ">=" { return "<=" }
    return op
}

// The condition code that holds exactly when `cond` doesn't.
#test("l")["ge"]
#test("be")["a"]
#test("e")["ne"]
fun negated_cond(cond: str) -> str {
    let pairs = [("e", "ne"), ("l", "ge"), ("le", "g"), ("b", "ae"), ("be", "a")]
    for p in pairs {
        if cond == p.0 { return p.1 }
        if cond == p.1 { return p.0 }
    }
    return cond
}

// The instruction loading the integer `v` into a register, up to its name:
// `movq` sign-extends a 32-bit immediate, shorter than `movabsq` (MYLA-120).
#test(5)["movq $5, %"]
#test(-1)["movq $-1, %"]
#test(4294967295)["movabsq $4294967295, %"]
fun int_const_text(v: int64) -> str {
    if v >= -2147483648 && v <= 2147483647 { return format("movq ${}, %", v) }
    return format("movabsq ${}, %", v)
}

// Whether all `n` reads of the temporary `t`, written by `insts[at]`, come
// later in the same block (its terminator included) with only instructions
// in between that write no slot, so the slot still holds what was read.
#test([Inst.Load(11, 2)], Term.Ret(11), 0, 11, 1)[true]
#test([Inst.Load(16, 1)], Term.Ret(16), 0, 16, 1)[true]
#test([Inst.Load(12, 1), Inst.Moved(1)], Term.Ret(12), 0, 12, 1)[false]
fun reads_before_writes(insts: [Inst], term: Term, at: int32, t: int32, n: int32) -> bool {
    var seen = 0
    var j = at + 1
    while j < insts.len() && seen < n {
        for u in inst_uses(insts[j]) {
            if u == t { seen = seen + 1 }
        }
        if seen < n && !writes_no_slot(insts[j]) { return false }
        j = j + 1
    }
    if seen < n {
        for u in term_uses(term) {
            if u == t { seen = seen + 1 }
        }
    }
    return seen == n
}

// Whether `inst` writes no frame slot, directly or through an address.
#test(Inst.Moved(1))[false]
#test(Inst.Moved(2))[false]
#test(Inst.Addr(1, 2))[true]
fun writes_no_slot(inst: Inst) -> bool {
    return match inst {
        Inst.Const(d, t, v) => true
        Inst.Str(d, text) => true
        Inst.Load(d, s) => true
        Inst.Addr(d, s) => true
        Inst.Offset(d, p, off) => true
        Inst.LoadAt(d, p, off, width) => true
        Inst.Bin(d, op, lt, rt, a, b, pos) => true
        Inst.Cmp(d, op, t, a, b) => true
        Inst.Un(d, op, t, a) => true
        Inst.Mov(d, a) => true
        Inst.Cast(d, from_t, to_t, a) => true
        Inst.Elem(d, c, i, stride, is_str, checked, pos) => true
        Inst.Load8(d, p) => true
        Inst.Check(v, kind, pos) => true
        Inst.Global(d, sym, w) => true
        Inst.Label(d, sym) => true
        Inst.Position(d, p) => true
        Inst.Loc(p) => true
        Inst.Bind(name, s) => true
        Inst.Scope(open) => true
        // the intrinsics that compute a value and write nothing
        Inst.Intr(d, op, args) => match op {
            Intrinsic.Rotl | Intrinsic.Bsr64 | Intrinsic.Sqrt | Intrinsic.F64Bits | Intrinsic.F64FromBits | Intrinsic.F64Round => true
            Intrinsic.RtAddr(sym) | Intrinsic.RtWaddr(sym) => true
            Intrinsic.Fits(o, signed) => true
            _ => false
        }
        _ => false
    }
}


// The offsets of `f`'s slots: in its heap frame after the header (D90) for a
// frame function, else `layout_slots`'.
pub fun slots_at(f: IrFunc, below: int32, inreg: [bool]) -> [int32] {
    if !f.frame { return layout_slots(f, below, inreg) }
    let (pos, extent) = slot_positions(f, false, [])
    var off: [int32] = []
    for p in pos { off.push(FRAME_HEADER + p) }
    return off
}

// The size of a frame function's heap frame: the header, then its slots.
pub fun frame_size(f: IrFunc) -> int32 {
    let (pos, extent) = slot_positions(f, false, [])
    return FRAME_HEADER + extent
}

// Where each slot of `f` goes in its area of the frame, from its start, and
// the area's size (MYLA-183): first the slots that aren't the local of an
// inner scope, one after the other; then each inner scope's locals, after
// those of the scopes around it, so the locals of two scopes that are never
// open at once (two blocks, two match arms) share cells. With `words`, a
// parameter that came on the stack (D119) takes no room here (-1); one that
// came in registers has a cell, as a local has; a slot living in a register
// all its life (`inreg`) has none.
fun slot_positions(f: IrFunc, words: bool, inreg: [bool]) -> ([int32], int32) {
    var pos: [int32] = []
    var cursor = 0
    var k = 0
    for s in f.slots {
        if no_cell(s, k, words, inreg) || s.scope > 0 { pos.push(-1) } else {
            pos.push(cursor)
            cursor = cursor + (s.size + 7) / 8 * 8
        }
        k = k + 1
    }
    let n = f.scope_parent.len()
    var own: [int32] = []
    var i = 0
    while i < n {
        own.push(0)
        i = i + 1
    }
    k = 0
    for s in f.slots {
        if s.scope > 0 && !no_cell(s, k, words, inreg) { own[s.scope] = own[s.scope] + (s.size + 7) / 8 * 8 }
        k = k + 1
    }
    // a scope's area starts where its parent's locals end (a scope's index
    // is greater than its parent's)
    var start: [int32] = []
    var extent = cursor
    i = 0
    while i < n {
        let parent = f.scope_parent[i]
        var at = cursor
        if parent > 0 { at = start[parent] + own[parent] }
        start.push(at)
        if at + own[i] > extent { extent = at + own[i] }
        i = i + 1
    }
    var fill = start
    k = 0
    while k < f.slots.len() {
        let s = f.slots[k]
        if s.scope > 0 && !no_cell(s, k, words, inreg) {
            pos[k] = fill[s.scope]
            fill[s.scope] = fill[s.scope] + (s.size + 7) / 8 * 8
        }
        k = k + 1
    }
    return pos, extent
}

// An async function's frame begins `[resume fn][caller frame][state][task]
// [link][its task's first frame][flags][parent task][actor handed]` (D90;
// the link chains the frames waiting for an actor or a task, D92; the next
// three serve cancelling by asking, D96, the last dropping frames once a
// task has failed, D94, D97); its first slot, its result when it has one,
// follows.
const FRAME_HEADER: int32 = 72

// The frame offset of each slot of `f`: a parameter that came on the stack
// above %rbp (D119), the others below the first `below` bytes.
fun layout_slots(f: IrFunc, below: int32, inreg: [bool]) -> [int32] {
    let (pos, extent) = slot_positions(f, true, inreg)
    var off: [int32] = []
    var k = 0
    while k < f.slots.len() {
        let s = f.slots[k]
        if s.word >= REG_WORDS { off.push(16 + 8 * (s.word - REG_WORDS)) }
        else if pos[k] < 0 { off.push(0) }
        else { off.push(-(below + pos[k] + (s.size + 7) / 8 * 8)) }
        k = k + 1
    }
    return off
}

// A call's argument words with an aggregate result's address first.
#test(4, [5, 6])[[4, 5, 6]]
fun sret_words(r: int32, args: [int32]) -> [int32] {
    var ws = [r]
    for a in args { ws.push(a) }
    return ws
}

// How many argument words the call `c` passes on the stack (D119).
fun stack_words(c: Inst) -> int32 {
    let n = match c {
        Inst.Call(d, name, args) => args.len(),
        Inst.CallSret(name, r, args) => args.len() + 1,
        Inst.CallInd(d, fv, args) => args.len(),
        Inst.CallIndSret(fv, r, args) => args.len() + 1,
        _ => 0,
    }
    if n > REG_WORDS { return n - REG_WORDS }
    return 0
}

// Which slots of `f` an instruction reads: loads it or takes its address
// (a slot's drop is one of those by then, `expand_ownership`).
fun read_slots(f: IrFunc) -> [bool] {
    var read: [bool] = []
    for s in f.slots { read.push(false) }
    for b in f.blocks {
        for inst in b.insts {
            match inst {
                Inst.Load(d, s) => { read[s] = true },
                Inst.Addr(d, s) => { read[s] = true },
                _ => {},
            }
        }
    }
    return read
}

// The load of the `width`-byte scalar at `src` into %rax, zero- or
// sign-extended as the type `t` of what it loads says (D120).
#test(8, Type.TBool, "(%rax)")["movq (%rax), %rax"]
#test(1, Type.TBool, "(%rax)")["movzbl (%rax), %eax"]
#test(4, Type.TInt(32, true), "(%rax)")["movslq (%rax), %rax"]
fun load_insn(width: int32, t: Type, src: str) -> str {
    if width == 8 { return format("movq {}, %rax", src) }
    let signed = match t {
        Type.TInt(w, sg) => sg,
        _ => false,
    }
    if width == 4 {
        if signed { return format("movslq {}, %rax", src) }
        return format("movl {}, %eax", src)
    }
    if width == 2 {
        if signed { return format("movswq {}, %rax", src) }
        return format("movzwl {}, %eax", src)
    }
    if signed { return format("movsbq {}, %rax", src) }
    return format("movzbl {}, %eax", src)
}

// The store of the low `width` bytes of `v` (an immediate or a register)
// at `dst` (D120).
#test(8, "%rbx", "(%rcx)")["movq %rbx, (%rcx)"]
#test(1, "%r12", "(%rcx)")["movb %r12b, (%rcx)"]
#test(1, "$1", "(%rcx)")["movb $1, (%rcx)"]
fun store_insn(width: int32, v: str, dst: str) -> str {
    if width == 8 { return format("movq {}, {}", v, dst) }
    var suffix = "l"
    if width == 1 { suffix = "b" }
    if width == 2 { suffix = "w" }
    return format("mov{} {}, {}", suffix, narrow_operand(v, width), dst)
}

// Whether the operand `v` is an %xmm register.
#test("%xmm3")[true]
#test("%rax")[false]
fun text_has_xmm(v: str) -> bool {
    return v.len() > 4 && v[1] == 'x' && v[2] == 'm' && v[3] == 'm'
}

// Whether the instruction at position `p` writes the value `v` (`tv` and
// `tat` as `alloc_regs` builds them: a write is -1 - v).
fun written_at(tv: [int32], tat: [int32], p: int32, v: int32) -> bool {
    if p + 1 >= tat.len() { return false }
    var k = tat[p]
    while k < tat[p + 1] {
        if tv[k] == -1 - v { return true }
        k = k + 1
    }
    return false
}

// Each candidate value's lifetime (MYLA-257) as ranges of points, position
// p being the points 2p (where it reads) and 2p + 1 (where it writes): a
// list per value (`rhead`, `rnext`) of `[rlo, rhi]` in ascending order, the
// holes between them where nothing will read the value. From the blocks'
// live-out sets (`live_spans`: `live_out`, `gid`, `nw` words a block) and a
// backward walk of each block's reads and writes (`tv`, `tat`); a value
// written and never read holds its register at that write all the same.
fun live_ranges(f: IrFunc, reach: [bool], cand: [bool], tv: [int32], tat: [int32], bstart: [int32], bend: [int32], live_out: [int64], gid: [int32], nw: int32) -> ([int32], [int32], [int32], [int32]) {
    let nv = cand.len()
    var rhead: [int32] = []
    var open: [int32] = []
    var gval: [int32] = []
    var i = 0
    while i < nv {
        rhead.push(-1)
        open.push(-1)
        i = i + 1
    }
    i = 0
    while i < gid.len() {
        if gid[i] >= 0 {
            while gval.len() <= gid[i] { gval.push(-1) }
            gval[gid[i]] = i
        }
        i = i + 1
    }
    var rlo: [int32] = []
    var rhi: [int32] = []
    var rnext: [int32] = []
    let one: int64 = 1
    var opened: [int32] = []
    var k = f.order.len() - 1
    while k >= 0 {
        let b = f.order[k]
        k = k - 1
        if !reach[b] { continue }
        let s = bstart[b]
        let e = bend[b]
        while opened.len() > 0 { opened.pop() }
        // what is live out of the block: open through its end
        var w = 0
        while w < nw {
            let bits = live_out[b * nw + w]
            if bits != 0 {
                var g = 0
                while g < 64 {
                    if (bits >> (g as int64)) & 255 == 0 { g = g + 8 }
                    else {
                        if bits & (one << (g as int64)) != 0 {
                            let v = gval[w * 64 + g]
                            open[v] = 2 * e + 1
                            opened.push(v)
                        }
                        g = g + 1
                    }
                }
            }
            w = w + 1
        }
        var p = e
        while p >= s {
            // the writes, then the reads (an instruction reads first)
            var j = tat[p]
            while j < tat[p + 1] {
                let x = tv[j]
                if x < 0 {
                    let v = -1 - x
                    var hi = 2 * p + 1
                    if open[v] >= 0 {
                        hi = open[v]
                        open[v] = -1
                    }
                    // prepended, as the ranges come last first; merged with
                    // the next one when they touch
                    let h = rhead[v]
                    if h >= 0 && hi + 1 >= rlo[h] {
                        if 2 * p + 1 < rlo[h] { rlo[h] = 2 * p + 1 }
                    } else {
                        rlo.push(2 * p + 1)
                        rhi.push(hi)
                        rnext.push(h)
                        rhead[v] = rlo.len() - 1
                    }
                }
                j = j + 1
            }
            j = tat[p]
            while j < tat[p + 1] {
                let x = tv[j]
                if x >= 0 && open[x] < 0 {
                    open[x] = 2 * p
                    opened.push(x)
                }
                j = j + 1
            }
            p = p - 1
        }
        // what is still open is live into the block
        for v in opened {
            if open[v] >= 0 {
                let hi = open[v]
                open[v] = -1
                let h = rhead[v]
                if h >= 0 && hi + 1 >= rlo[h] {
                    if 2 * s < rlo[h] { rlo[h] = 2 * s }
                } else {
                    rlo.push(2 * s)
                    rhi.push(hi)
                    rnext.push(h)
                    rhead[v] = rlo.len() - 1
                }
            }
        }
    }
    return (rhead, rlo, rhi, rnext)
}

// How many clobbering positions (`pre`, and with the copies `spre`: prefix
// counts per position) a value
// with the ranges from `h` is clobbered at: each it is live across (it holds
// both of the position's points), and each where it is read last unless
// the position reads its operands before it clobbers (`callpos`).
fun range_clobbers(h: int32, rlo: [int32], rhi: [int32], rnext: [int32], pre: [int32], spre: [int32], callpos: [bool]) -> (int32, int32) {
    var n = 0
    var sn = 0
    var r = h
    while r >= 0 {
        let lo = rlo[r]
        let hi = rhi[r]
        let pa = (lo + 1) / 2
        var pb = -1
        if hi >= 1 { pb = (hi - 1) / 2 }
        if pb >= pa {
            n = n + pre[pb + 1] - pre[pa]
            sn = sn + spre[pb + 1] - spre[pa]
        }
        if hi % 2 == 0 {
            let p = hi / 2
            if !callpos[p] {
                n = n + pre[p + 1] - pre[p]
                sn = sn + spre[p + 1] - spre[p]
            }
        }
        r = rnext[r]
    }
    return (n, sn)
}

// Whether two values' ranges (from `a` and from `b`) share a point.
fun ranges_meet(a: int32, b: int32, rlo: [int32], rhi: [int32], rnext: [int32]) -> bool {
    var x = a
    var y = b
    while x >= 0 && y >= 0 {
        if rhi[x] < rlo[y] { x = rnext[x] }
        else if rhi[y] < rlo[x] { y = rnext[y] }
        else { return true }
    }
    return false
}

// Whether a holder of a register (`hs`) is in the way of value `v`.
fun reg_conflicts(hs: [int32], v: int32, rhead: [int32], rlo: [int32], rhi: [int32], rnext: [int32]) -> bool {
    for h in hs {
        if ranges_meet(rhead[h], rhead[v], rlo, rhi, rnext) { return true }
    }
    return false
}

// Whether `inst` is a call that reads every operand before the call
// clobbers a register (its arguments loaded first): a value it reads last
// may live in %r10 or %r11 up to it.
#test(Inst.Call(-1, "f", [1]))[true]
#test(Inst.Append(1, 2, 3, 8))[false]
fun reads_then_calls(inst: Inst) -> bool {
    return match inst {
        Inst.Call(d, name, args) => true,
        Inst.CallSret(name, r, args) => true,
        Inst.CallInd(d, fv, args) => true,
        Inst.CallIndSret(fv, r, args) => true,
        Inst.Rt(d, name, args) => true,
        Inst.Intr(d, op, args) => match op {
            Intrinsic.RunFrame => true
            Intrinsic.CallCode => true
            _ => false
        },
        _ => false,
    }
}

// The temporary holding the function value an indirect call calls, or -1.
#test(Inst.CallInd(-1, 4, [3]))[4]
#test(Inst.Call(-1, "f", [3]))[-1]
fun called_value(inst: Inst) -> int32 {
    return match inst {
        Inst.CallInd(d, fv, args) => fv,
        Inst.CallIndSret(fv, r, args) => fv,
        _ => -1,
    }
}

// The highest argument word in which the call `inst` reads the value `v`
// (a temporary below `nt`, else the slot v - nt, read through a temporary
// whose `src_slot` it is), counting the words that go in registers (a word
// pushed on the stack counts -1: it is read before any register is loaded);
// 99 when it reads `v` after its arguments (a function value) or not as one.
#test(Inst.Call(-1, "f", [3, 4, 5]), 4, 10, [])[1]
#test(Inst.CallInd(-1, 4, [3]), 4, 10, [])[99]
fun call_arg_index(inst: Inst, v: int32, nt: int32, src_slot: [int32]) -> int32 {
    var ws: [int32] = []
    var late = false
    match inst {
        Inst.Call(d, name, args) => { ws = args },
        Inst.CallSret(name, r, args) => { ws = sret_words(r, args) },
        Inst.CallInd(d, fv, args) => {
            ws = args
            late = reads_value(fv, v, nt, src_slot)
        },
        Inst.CallIndSret(fv, r, args) => {
            ws = sret_words(r, args)
            late = reads_value(fv, v, nt, src_slot)
        },
        Inst.Rt(d, name, args) => { ws = args },
        Inst.Intr(d, op, args) => { ws = args },
        _ => { return 99 },
    }
    if late { return 99 }
    var k = -2
    var i = 0
    while i < ws.len() {
        if reads_value(ws[i], v, nt, src_slot) {
            if i < REG_WORDS { if i > k { k = i } } else if k < -1 { k = -1 }
        }
        i = i + 1
    }
    if k == -2 { return 99 }
    return k
}

// Whether reading the temporary `t` reads the value `v` (itself, or the slot
// v - nt it is read from).
fun reads_value(t: int32, v: int32, nt: int32, src_slot: [int32]) -> bool {
    if t == v { return true }
    return v >= nt && t >= 0 && t < src_slot.len() && src_slot[t] == v - nt
}

// Whether slot `s` (the k-th) takes no cell in the frame: a parameter that
// came on the stack (with `words`), or one living in a register (`inreg`).
fun no_cell(s: Slot, k: int32, words: bool, inreg: [bool]) -> bool {
    return (words && s.word >= REG_WORDS) || (k < inreg.len() && inreg[k])
}

// The instruction re-canonicalising the integer of type `t` (narrower than
// 64 bits) in `reg`: sign- or zero-extended from its low bits, as `wrap`
// does in %rax.
#test(Type.TInt(32, true), "%rbx")["movslq %ebx, %rbx"]
#test(Type.TInt(8, false), "%r12")["movzbl %r12b, %r12d"]
fun canonical_insn(t: Type, reg: str) -> str {
    let (w, sg) = match t {
        Type.TInt(bits, s) => (bits, s),
        _ => (64, false),
    }
    if w == 32 {
        if sg { return format("movslq {}, {}", narrow_operand(reg, 4), reg) }
        return format("movl {}, {}", narrow_operand(reg, 4), narrow_operand(reg, 4))
    }
    if w == 16 {
        if sg { return format("movswq {}, {}", narrow_operand(reg, 2), reg) }
        return format("movzwl {}, {}", narrow_operand(reg, 2), narrow_operand(reg, 4))
    }
    if sg { return format("movsbq {}, {}", narrow_operand(reg, 1), reg) }
    return format("movzbl {}, {}", narrow_operand(reg, 1), narrow_operand(reg, 4))
}

fun text_starts(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() { return false }
    var i = 0
    while i < prefix.len() {
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    return true
}

fun text_mentions(s: str, part: str) -> bool {
    var i = 0
    while i + part.len() <= s.len() {
        var j = 0
        while j < part.len() && s[i + j] == part[j] { j = j + 1 }
        if j == part.len() { return true }
        i = i + 1
    }
    return false
}

fun ends_with_colon(s: str) -> bool {
    return s.len() > 0 && s[s.len() - 1] == ':'
}

fun has_index(xs: [int32], x: int32) -> bool {
    for y in xs { if y == x { return true } }
    return false
}

// Whether the operand text is an immediate (`$5`).
#test("$-3")[true]
#test("%rcx")[false]
fun is_immediate(src: str) -> bool {
    return src.len() > 0 && src[0] == '$'
}

// Whether `t` is a 64-bit integer type.
#test(Type.TInt(64, false))[true]
#test(Type.TInt(32, true))[false]
fun is_wide(t: Type) -> bool {
    return match t {
        Type.TInt(bits, sg) => bits == 64,
        _ => false,
    }
}

// Whether `src` is `%` and the register `reg` (a variable's register a
// temporary is read from).
#test("%r10", "r10")[true]
#test("%r10", "r11")[false]
#test("8(%rbp)", "rbp")[false]
fun names_reg(src: str, reg: str) -> bool {
    if src.len() != reg.len() + 1 || src.len() == 0 || src[0] != '%' {
        return false
    }
    var k = 0
    while k < reg.len() {
        if src[k + 1] != reg[k] {
            return false
        }
        k += 1
    }
    return true
}
