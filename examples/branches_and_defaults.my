// `if` as a value, `if let`, `while let`, let-else, `+=`, `defer` and
// default parameter values. See docs/Language/Statements.md and
// docs/Language/Functions-and-closures.md.

// The position of `x` in `xs`, if it is there.
#test([4, 7, 9], 7)[Some(1)]
#test([4, 7, 9], 5)[None]
fun find(xs: [int], x: int) -> Option<int> {
    var i = 0
    while i < xs.len() {
        if xs[i] == x {
            return Some(i)
        }
        i += 1
    }
    return None
}

// A port number from text, or an error saying why not.
#test("8080")[Ok(8080)]
#test("")[Err("empty")]
fun parse_port(text: str) -> Result<int, str> {
    if text.len() == 0 {
        return Err("empty")
    }
    var n = 0
    for c in text.chars() {
        let d = (c as int) - ('0' as int)
        if d < 0 || d > 9 {
            return Err(f"not a digit: {c}")
        }
        n = n * 10 + d
    }
    return Ok(n)
}

// let-else keeps the expected case unindented; the `else` must leave.
#test("80")["port 80"]
#test("x")["bad port: not a digit: x"]
fun describe(text: str) -> str {
    let Ok(port) = parse_port(text) else {
        return match parse_port(text) {
            Err(why) => f"bad port: {why}",
            Ok(p) => "unreachable",
        }
    }
    return f"port {port}"
}

// A greeting, the punctuation left to its default.
#test("Ann", "!")["Hello, Ann!"]
fun greet(name: str, end: str = "!") -> str {
    return f"Hello, {name}{end}"
}

fun count_down(n: int) {
    defer {
        print("lift-off")
    }
    var left = n
    while left > 0 {
        print(left)
        left -= 1
    }
}

fun main() {
    let at = if let Some(i) = find([4, 7, 9], 9) { i } else { -1 }
    print(at)
    let sign = if at > 0 { "positive" } else if at == 0 { "zero" } else { "negative" }
    print(sign)
    // every 3 crossed out, one at a time
    var marks = [3, 1, 3, 2, 3]
    var crossed = 0
    while let Some(i) = find(marks, 3) {
        marks[i] = 0
        crossed += 1
    }
    print(crossed)
    print(describe("443"))
    print(describe("44x"))
    print(greet("Myla"))
    print(greet("Myla", "?"))
    count_down(2)
}
