// A small JSON API with std.http's router (D202, MYLA-613): typed path
// parameters, a query parameter, a JSON body decoded into a struct, a
// sub-router under /api with a middleware, and 404/405/422 for the rest.
// The API's logic is plain functions of plain values, tested with `#test`;
// the routes are small closures over them. `myla run examples/book_api.my`
// calls the router directly; `await http.serve(addr, h)` would serve it.
import std.http as http
from std.http import Request, Response

#derive(Json, Eq)
struct Book {
    id: int,
    title: str,
    year: int,
}

#derive(Json, Eq)
struct Search {
    query: str,
    found: [Book],
}

#derive(Json)
struct NewBook {
    title: str,
    year: int,
}

#test()[[Book { id: 1, title: "The Left Hand of Darkness", year: 1969 }, Book { id: 2, title: "The Dispossessed", year: 1974 }, Book { id: 3, title: "A Wizard of Earthsea", year: 1968 }]]
fun books() -> [Book] {
    return [
        Book { id: 1, title: "The Left Hand of Darkness", year: 1969 },
        Book { id: 2, title: "The Dispossessed", year: 1974 },
        Book { id: 3, title: "A Wizard of Earthsea", year: 1968 },
    ]
}

// The book `id`, or a JSON 404.
#test(2)[Ok(Book { id: 2, title: "The Dispossessed", year: 1974 })]
#test(9)[Err(http.json_error(404, "no book 9"))]
fun find(id: int) -> Result<Book, Response> {
    for b in books() {
        if b.id == id { return Ok(b) }
    }
    return Err(http.json_error(404, f"no book {id}"))
}

// The books whose title has `q` in it, ignoring case.
#test("DARK")[Search { query: "dark", found: [Book { id: 1, title: "The Left Hand of Darkness", year: 1969 }] }]
#test("zz")[Search { query: "zz", found: [] }]
fun search_for(q: str) -> Search {
    let lower = q.to_lower()
    var found: [Book] = []
    for b in books() {
        if b.title.to_lower().contains(lower) { found.push(b) }
    }
    return Search { query: lower, found: found }
}

// A new book checked and given the next id. Handlers are values and can't
// keep state between requests, so it is answered, not stored.
#test(NewBook { title: "The Lathe of Heaven", year: 1971 })[Ok(Book { id: 4, title: "The Lathe of Heaven", year: 1971 })]
#test(NewBook { title: "", year: 1971 })[Err(http.json_error(400, "a book needs a title"))]
fun add_book(b: NewBook) -> Result<Book, Response> {
    if b.title == "" { return Err(http.json_error(400, "a book needs a title")) }
    return Ok(Book { id: books().len() + 1, title: b.title, year: b.year })
}

fun main() {
    var api = http.router("/api")
    api.get("/books/{id:int}", http.json((req: Request) => find(req.param_int("id").unwrap_or(0))))
    api.get("/books/search", http.json((req: Request) => Ok(search_for(req.query_param("q").unwrap_or("")))))
    api.post("/books", http.json_body((req: Request, b: NewBook) => add_book(b)))
    // middleware: every response of the API says which version answered
    api.wrap((next: (Request) -> Response) => (req: Request) => next(req).with_header("Api-Version", "1"))
    var app = http.router("")
    app.get("/", (req: Request) => http.response(200, "see /api/books/{id}"))
    app.mount(api)
    let h = app.handler()
    let calls = [
        http.request("GET", "/api/books/2"),
        http.request("GET", "/api/books/search?q=dark"),
        http.request("GET", "/api/books/9"),
        http.request("POST", "/api/books").with_body("{\"title\": \"The Lathe of Heaven\", \"year\": 1971}"),
        http.request("POST", "/api/books").with_body("{\"year\": 1971}"),
        http.request("DELETE", "/api/books/2"),
        http.request("GET", "/"),
    ]
    for req in calls {
        let resp = h(req)
        let version = resp.header("Api-Version").unwrap_or("-")
        print(f"{req.method} {req.url} -> {resp.status} {resp.text()} (version {version})")
    }
}
