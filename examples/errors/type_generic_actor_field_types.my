//~ type error: actor 'Pair': expected 'int32', found 'str'
// The fields of a generic actor's literal fix its type arguments together,
// as a generic struct's do; the error names the actor (MYLA-386)
actor Pair<T> {
    a: T,
    b: T,
}

#main
async fun main() {
    let p = Pair { a: 1, b: "two" }
}
