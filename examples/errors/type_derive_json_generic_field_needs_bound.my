//~ type error: cannot derive Json for struct 'Page': field 'items' has type '[W<T>]', which is ToJson only where 'T: Ord'
//~ help: write both impls instead (a derive writes them together), this one as 'impl<T: json.ToJson + Ord> json.ToJson for Page<T>'
// `#derive(Json)` bounds `T` by `ToJson` and `FromJson` alone (MYLA-379);
// `W<T>`'s written `ToJson` needs `T: Ord` too, so the derive is refused at
// the struct, not in the impl it writes (MYLA-507).
import std.json as json

struct W<T> {
    v: T,
}

impl<T: json.ToJson + Ord> json.ToJson for W<T> {
    fun to_json(self) -> json.Json {
        return self.v.to_json()
    }
}

impl<T: json.FromJson> json.FromJson for W<T> {
    fun from_json(j: json.Json) -> Result<W<T>, json.JsonError> {
        return Ok(W { v: T.from_json(j)? })
    }
}

#derive(Json)
struct Page<T> {
    items: [W<T>],
}

fun main() {
    print(json.encode(Page { items: [W { v: 1 }] }))
}
