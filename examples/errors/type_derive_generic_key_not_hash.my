//~ type error: map key type must be Eq and Hash, found 'Cell<Tag>': 'Tag' isn't Hash (it needs 'impl Hash for Tag' or '#derive(Hash)')
// A generic type's derived `Hash` is bounded by `T: Hash` (MYLA-379): a
// `Cell<Tag>` is no map key while `Tag` is only `Eq`.
#derive(Eq)
struct Tag {
    n: int,
}

#derive(Eq, Hash)
struct Cell<T> {
    at: (int, int),
    value: T,
}

fun main() {
    var seen: [Cell<Tag>: bool] = [:]
    print(seen.len())
}
