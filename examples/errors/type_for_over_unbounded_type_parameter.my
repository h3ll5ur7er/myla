//~ type error: `for ... in` requires a list, a map, a string, a range or an Iterator, found 'I' (it needs the bound 'I: Iterator<T>')
// A type parameter is an iterator when its bound says so (D171).
fun count<I>(it: I) -> int {
    var n = 0
    for x in it { n += 1 }
    return n
}

fun main() {
    print(count([1, 2]))
}
