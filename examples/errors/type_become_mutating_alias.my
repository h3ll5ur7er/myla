//~ type error: 'become' can't pass a part of 'self' to the method that changes it
//~ span: self.start
// A call passes a copy of a part of the receiver of a `var self` method
// (MYLA-123), which would live in the frame that `become` leaves (D87).
struct Point { x: int, y: int }
struct Walk { start: Point, at: Point }
impl Walk {
    fun step(var self, origin: Point) {
        self.at = Point { x: origin.x + 1, y: origin.y }
    }
    fun restart(var self) {
        become self.step(self.start)
    }
}
fun main() {
    var w = Walk { start: Point { x: 0, y: 0 }, at: Point { x: 5, y: 5 } }
    w.restart()
    print(w.at.x)
}
