//~ type error: 'become' can only call a function value that is (a part of) a parameter
//~ span: f
// A function value made in the function lives in its frame (D87).
fun double(n: int) -> int {
    return n * 2
}
fun apply(n: int) -> int {
    let f = double
    become f(n)
}
fun main() {
    print(apply(2))
}
