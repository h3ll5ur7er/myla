//~ type error: '#test' can't run an actor method (its receiver is an actor, not a value)
//~ span: #test(Tally { n: 1 })[1]
// A method's `#test` cases take the receiver as their first argument (D116),
// and an actor's receiver is a running actor, not a value.
actor Tally {
    n: int,
}

impl Tally {
    #test(Tally { n: 1 })[1]
    fun count(self) -> int {
        return self.n
    }
}

fun main() {}
