//~ type error: operator '*' is not defined for 'V' and 'int32': it needs 'impl Mul<int32, …> for V'
//~ span: v * 2
//~ note: 'V' implements Mul<float64, V>
// An integer literal never becomes a float, beside an operator either: with
// only `Mul<float>`, `v * 2` asks for `Mul<int32, …>`; write `2.0` (D198).
struct V {
    x: float,
}

impl Mul<float> for V {
    fun mul(self, k: float) -> V {
        return V { x: self.x * k }
    }
}

fun main() {
    let v = V { x: 1.0 }
    let w = v * 2
    print(w.x)
}
