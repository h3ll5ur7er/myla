//~ type error: cannot derive Hash for struct 'Sample': field 'value' has type 'float64', which isn't Hash (a float isn't: NaN is unequal to itself; a hand-written 'impl Hash' may add 'math.to_bits(x)')
// A float isn't `Hash` (D163): NaN is unequal to itself, so no hash of it
// keeps `a == b` and equal hashes together.
#derive(Eq, Hash)
struct Sample {
    at: int,
    value: float,
}

#main
fun main() {
    print(Sample { at: 1, value: 0.5 } == Sample { at: 1, value: 0.5 })
}
