//~ type error: operator '==' is not defined for 'Pair<int32, Pos>': 'Pos' isn't Eq (it needs 'impl Eq for Pos' or '#derive(Eq)')
// A generic type's derived `Eq` is bounded by `T: Eq` (MYLA-379): `Pair<int,
// Pos>` has no `==` while `Pos` isn't `Eq`.
#derive(Eq)
struct Pair<A, B> {
    a: A,
    b: B,
}

struct Pos {
    x: int,
}

fun main() {
    let p = Pair { a: 1, b: Pos { x: 2 } }
    print(p == p)
}
