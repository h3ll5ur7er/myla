//~ type error: type 'P' does not satisfy the bound 'T: Eq' required by 'one'
// With the bound written (D167), a caller must give a type that is
// `Eq + Hash`: `P` is neither. Before MYLA-313 the checker passed this and
// native code stopped on it.
struct P {
    a: int,
}

fun one<T: Eq + Hash>(x: T) -> [T: int] {
    var m: [T: int] = [:]
    m[x] = 1
    return m
}

#main
fun main() {
    print(one(P { a: 1 }).len())
}
