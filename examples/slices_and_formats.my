// Slices, indexes from the end, format specs and a type's own form.
// See docs/Language/Collections-and-strings.md.

struct Money {
    cents: int,
}

// `{m}` and `{m:spec}` call this (D139); `std.fmt.pad` would apply a width
impl Format for Money {
    fun format(self, spec: str) -> str {
        let units = self.cents / 100
        let rest = self.cents % 100
        return if spec == "short" { f"{units}" } else { f"{units}.{rest:02}" }
    }
}

// The middle of a list: everything but its first and last element.
#test([1, 2, 3, 4])[[2, 3]]
#test([1])[[]]
fun middle(xs: [int]) -> [int] {
    return xs[1:^1]
}

// A word read backwards, by slicing with a negative step.
#test("myla")["alym"]
fun backwards(s: str) -> str {
    return s[::-1]
}

fun main() {
    let xs = [10, 20, 30, 40, 50]
    print(xs[^1])
    print(middle(xs).len())
    print(xs[::2][1])
    print(backwards("myla"))
    let pi = 3.14159265
    print(f"{pi:.2} [{42:>5}] [{7:03}] {255:#x}")
    let price = Money { cents: 1999 }
    print(f"{price} or about {price:short}")
    // a float prints in the fewest digits that read back as it (D155)
    print(0.1 + 0.2)
    print(1.0 / 4.0)
}
