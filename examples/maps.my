// Maps `[K: V]`: a reference-counted, copy-on-write hash table with
// value semantics (D38, D39). Keys are integers, `char`, `bool` or `str`;
// values may be any type.
//
// Like lists, a map is a *value*: binding, passing, returning, or assigning it
// produces an independent value, so mutating one binding never affects another.
// The backing table is shared on copy (a refcount bump) and cloned lazily on the
// first mutation through a shared binding (D14). Iteration order is unspecified.
//
// Built-in (not user-shadowable): `len`, indexing `m[k]` (read and as an
// assignment target), `contains`, `remove`, `keys`, and `for k in m`. The
// prelude adds `get(m, k) -> Option<V>`. A read `m[k]` of an absent key traps
// (see examples/errors/); use `get` or `contains` to probe safely.

#test([1, 2, 3])[6]
#test([])[0]
fun sum_values(xs: [int]) -> int {
    var m: [int: int] = [:]
    var i = 0
    for x in xs {
        m[i] = x
        i = i + 1
    }
    var t = 0
    let ks = m.keys()
    for k in ks {
        t = t + m[k]
    }
    return t
}

// Literal with entries, `len`, and indexed read.
#test("b")[2]
#test("a")[1]
fun lookup(key: str) -> int {
    let m: [str: int] = ["a": 1, "b": 2, "c": 3]
    return m[key]
}

#test[3]
fun count_entries() -> int {
    let m = [10: 100, 20: 200, 30: 300]
    return m.len()
}

#test[0]
fun empty_len() -> int {
    let m: [int: int] = [:]
    return m.len()
}

// `get` returns Option<V>: Some(v) for a present key, None otherwise.
#test[2]
fun get_present() -> int {
    let m = [1: 2, 3: 4]
    var r = -1
    match get(m, 1) {
        Some(v) => { r = v }
        None => { r = -1 }
    }
    return r
}

#test[-1]
fun get_absent() -> int {
    let m = [1: 2, 3: 4]
    var r = 0
    match get(m, 99) {
        Some(v) => { r = v }
        None => { r = -1 }
    }
    return r
}

// `contains` probes membership without trapping.
#test("a")[1]
#test("z")[0]
fun has(key: str) -> int {
    let m = ["a": 1, "b": 2]
    if m.contains(key) {
        return 1
    }
    return 0
}

// `remove` deletes a key in place; removing a missing key is a no-op.
#test[2]
fun remove_one() -> int {
    var m = [1: 10, 2: 20, 3: 30]
    m.remove(2)
    m.remove(999)        // no-op
    return m.len()
}

// Remove then reinsert: the slot is reusable and the new value wins.
#test[42]
fun remove_then_set() -> int {
    var m = [1: 10, 2: 20]
    m.remove(1)
    m[1] = 42
    return m[1]
}

// Indexed assignment overwrites an existing key (len unchanged) and inserts new
// keys (len grows).
#test[1]
fun overwrite() -> int {
    var m = [7: 1]
    m[7] = 2
    m[7] = 3
    return m.len()         // still one key
}

// Value semantics: mutating a copy must not affect the original.
#test[10]
fun copy_is_independent() -> int {
    var a = [1: 10, 2: 20]
    var b = a
    b[1] = 99
    b.remove(2)
    b[3] = 30
    return a[1]           // still 10
}

// Growth past the load factor: many inserts force rehash; all keys survive.
#test[100]
fun grows() -> int {
    var m: [int: int] = [:]
    var i = 0
    while i < 100 {
        m[i] = i
        i = i + 1
    }
    var seen = 0
    for k in m {
        if m.contains(k) {
            seen = seen + 1
        }
    }
    return seen
}

// `keys` returns a `[K]` list; summing it is order-independent.
#test[60]
fun key_total() -> int {
    let m = [10: 0, 20: 0, 30: 0]
    var s = 0
    for k in m.keys() {
        s = s + k
    }
    return s
}

struct Point { x: int, y: int }

// Maps of structs (inline aggregate values) with copy-on-write through a copy.
#test[7]
fun struct_values() -> int {
    var m: [int: Point] = [:]
    m[1] = Point { x: 3, y: 4 }
    var n = m
    n[1].x = 99           // clones the shared table; m untouched
    return m[1].x + m[1].y
}

// Maps whose values are lists: heap-owning values are retained/dropped correctly
// across copy and remove.
#test[6]
fun list_values() -> int {
    var m: [int: [int]] = [:]
    m[1] = [2, 3]
    m[1].push(4)         // m[1] == [2, 3, 4]
    var c = m
    c.remove(1)          // drops c's list; m's stays alive
    return m[1][0] + m[1][2]   // 2 + 4
}

#main
fun main() {
    print(sum_values([1, 2, 3]))     // 6
    print(lookup("b"))               // 2
    print(count_entries())           // 3

    var m: [str: int] = ["a": 1, "b": 2, "c": 3]
    print(m.len())                    // 3
    print(m["a"])                    // 1
    m["a"] = 10
    m["d"] = 4
    print(m["a"])                    // 10
    print(m.len())                    // 4
    m.remove("b")
    print(m.len())                    // 3
    print(m.contains("b"))          // 0 (false)
    print(m.contains("c"))          // 1 (true)

    match get(m, "c") {
        Some(v) => { print(v) }      // 3
        None => { print(-1) }
    }

    var total = 0
    for k in m.keys() {
        total = total + m[k]
    }
    print(total)                     // 10 + 3 + 4 = 17

    // value semantics
    var a = [1: 100, 2: 200]
    var b = a
    b[1] = 999
    b.remove(2)
    print(a[1])                      // 100  (a untouched)
    print(a.len())                    // 2
}
