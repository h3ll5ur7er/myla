// An agentic AI harness: Claude works on a directory with three tools,
// through the Messages API's tool-use loop.
//
//   myla run examples/agent.my "Summarise the notes into summary.md" notes/
//
// sends the task to Claude (ANTHROPIC_API_KEY), runs each tool it asks for
// inside the directory, sends the results back, and repeats until it is
// done. ANTHROPIC_BASE_URL=http://localhost:8080 talks to a model served
// locally that speaks the Messages API instead (AGENT_MODEL names it; no
// key needed). std.http speaks plain HTTP only, so an https URL goes
// through curl until std has TLS (roadmap #40). Without a task it runs offline:
// a scripted stand-in for the API on a local port (`mock_reply`) plays one
// conversation, so the whole loop runs and is checked by the example tests.
import std.bytes as bytes
import std.fs as fs
import std.http as http
import std.json as json
import std.net as net
import std.process as process
from std.http import Request
from std.json import Json

const MODEL: str = "claude-opus-5-5"
const ANTHROPIC: str = "https://api.anthropic.com"
const API_VERSION: str = "2026-10-21"
// on a refusal, Anthropic's API answers with a fallback model in the same
// call; a local server wouldn't know the field, so it gets neither
const FALLBACK_BETA: str = "server-side-fallback-2026-07-01"
const MAX_TURNS: int = 20
const SYSTEM: str = "You work in a directory through the tools. Paths are relative to it. When the task is done, say in one sentence what you did."

// A tool call from Claude: its input is JSON text.
#derive(Eq)
struct Call {
    id: str,
    name: str,
    input: str,
}

// One reply: why it stopped, its text, its tool calls, and its content as
// JSON text, sent back unchanged in the next request.
#derive(Eq)
struct Turn {
    stop: str,
    text: str,
    calls: [Call],
    content: str,
}

// --- the tools ---------------------------------------------------------------

// A tool whose parameters are all required strings.
#test("read_file", "Read a file.", ["path"])["{\"name\":\"read_file\",\"description\":\"Read a file.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}"]
fun tool(name: str, description: str, params: [str]) -> str {
    let props = params.map((p: str) => (p, json.obj([("type", json.text("string"))])))
    let schema = json.obj([
        ("type", json.text("object")),
        ("properties", json.obj(props)),
        ("required", json.arr(params.map((p: str) => json.text(p)))),
    ])
    return json.to_string(json.obj([("name", json.text(name)), ("description", json.text(description)), ("input_schema", schema)]))
}

#test()[["{\"name\":\"list_files\",\"description\":\"List the names in a directory of the workspace; directories end with /.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}", "{\"name\":\"read_file\",\"description\":\"Read a text file of the workspace.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}", "{\"name\":\"write_file\",\"description\":\"Create or replace a text file of the workspace.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}}"]]
fun tools() -> [str] {
    return [
        tool("list_files", "List the names in a directory of the workspace; directories end with /.", ["path"]),
        tool("read_file", "Read a text file of the workspace.", ["path"]),
        tool("write_file", "Create or replace a text file of the workspace.", ["path", "content"]),
    ]
}

// A path inside the workspace `root`, or why not: tools never leave it
// (by the path's text; a symbolic link inside could still point out).
#test("/w", "notes/a.txt")[Ok("/w/notes/a.txt")]
#test("/w", ".")[Ok("/w")]
#test("/w", "../secrets")[Err("'../secrets' is outside the workspace")]
#test("/w", "/etc/passwd")[Err("'/etc/passwd' is outside the workspace")]
fun inside(root: str, path: str) -> Result<str, str> {
    if path.starts_with("/") || path.split("/").contains("..") {
        return Err(f"'{path}' is outside the workspace")
    }
    if path == "." || path == "" {
        return Ok(root)
    }
    return Ok(f"{root}/{path}")
}

// A string argument of a call.
#test("{\"path\": \"a.txt\"}", "path")[Ok("a.txt")]
#test("{}", "path")[Err("missing 'path'")]
#test("nope", "path")[Err("the input isn't JSON")]
fun arg(input: str, name: str) -> Result<str, str> {
    let j = match json.parse(input) {
        Ok(j) => j
        Err(e) => {
            return Err("the input isn't JSON")
        }
    }
    return json.field(j, name).and_then((v: Json) => v.as_str()).ok_or(f"missing '{name}'")
}

// What a tool call gives back, and whether it failed.
#test("/no/such/dir", Call { id: "t1", name: "read_file", input: "{\"path\": \"a.txt\"}" })[("not found (NotFound)", true)]
#test("/w", Call { id: "t2", name: "write_file", input: "{\"path\": \"../x\", \"content\": \"\"}" })[("'../x' is outside the workspace", true)]
#test("/w", Call { id: "t3", name: "delete_everything", input: "{}" })[("there is no tool 'delete_everything'", true)]
fun run_tool(root: str, call: Call) -> (str, bool) {
    let result = match call.name {
        "list_files" => list_files(root, call.input)
        "read_file" => read_file(root, call.input)
        "write_file" => write_file(root, call.input)
        _ => Err(f"there is no tool '{call.name}'")
    }
    return match result {
        Ok(out) => (out, false)
        Err(e) => (e, true)
    }
}

#test("/no/such/dir", "{\"path\": \".\"}")[Err("not found (NotFound)")]
fun list_files(root: str, input: str) -> Result<str, str> {
    let dir = inside(root, arg(input, "path")?)?
    let names = fs.list_dir(dir).map_err((e: fs.IoError) => f"{e}")?
    return Ok(names.map((n: str) => if fs.is_dir(f"{dir}/{n}") { n + "/" } else { n }).join("\n"))
}

#test("/no/such/dir", "{\"path\": \"a.txt\"}")[Err("not found (NotFound)")]
fun read_file(root: str, input: str) -> Result<str, str> {
    let file = inside(root, arg(input, "path")?)?
    return fs.read_to_string(file).map_err((e: fs.IoError) => f"{e}")
}

#test("/no/such/dir", "{\"path\": \"a.txt\", \"content\": \"hi\"}")[Err("not found (NotFound)")]
#test("/w", "{\"path\": \"a.txt\"}")[Err("missing 'content'")]
fun write_file(root: str, input: str) -> Result<str, str> {
    let file = inside(root, arg(input, "path")?)?
    let content = arg(input, "content")?
    fs.write_to_file(file, content).map_err((e: fs.IoError) => f"{e}")?
    return Ok(f"wrote {content.len()} bytes")
}

// --- the Messages API ---------------------------------------------------------

#test("Hi")["{\"role\":\"user\",\"content\":\"Hi\"}"]
fun user_message(text: str) -> str {
    return json.to_string(json.obj([("role", json.text("user")), ("content", json.text(text))]))
}

#test("[{\"type\":\"text\",\"text\":\"Hello\"}]")["{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Hello\"}]}"]
fun assistant_message(content: str) -> str {
    return json.to_string(json.obj([("role", json.text("assistant")), ("content", json.parse(content).unwrap_or(Json.Null))]))
}

// The results of a turn's calls, all in one user message.
#test([Call { id: "t1", name: "read_file", input: "{}" }], [("missing 'path'", true)])["{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"t1\",\"content\":\"missing 'path'\",\"is_error\":true}]}"]
fun results_message(calls: [Call], results: [(str, bool)]) -> str {
    var blocks: [Json] = []
    for (call, result) in calls.zip(results) {
        blocks.push(json.obj([
            ("type", json.text("tool_result")),
            ("tool_use_id", json.text(call.id)),
            ("content", json.text(result.0)),
            ("is_error", Json.Bool(result.1)),
        ]))
    }
    return json.to_string(json.obj([("role", json.text("user")), ("content", json.arr(blocks))]))
}

// The request: the model, the tools and the whole conversation so far.
#test("claude-opus-5-5", true, ["{\"role\":\"user\",\"content\":\"Hi\"}"])["{\"model\":\"claude-opus-5-5\",\"max_tokens\":16000,\"system\":\"You work in a directory through the tools. Paths are relative to it. When the task is done, say in one sentence what you did.\",\"tools\":[{\"name\":\"list_files\",\"description\":\"List the names in a directory of the workspace; directories end with /.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}},{\"name\":\"read_file\",\"description\":\"Read a text file of the workspace.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}},{\"name\":\"write_file\",\"description\":\"Create or replace a text file of the workspace.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}}],\"fallbacks\":\"default\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"]
#test("llama3", false, ["{\"role\":\"user\",\"content\":\"Hi\"}"])["{\"model\":\"llama3\",\"max_tokens\":16000,\"system\":\"You work in a directory through the tools. Paths are relative to it. When the task is done, say in one sentence what you did.\",\"tools\":[{\"name\":\"list_files\",\"description\":\"List the names in a directory of the workspace; directories end with /.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}},{\"name\":\"read_file\",\"description\":\"Read a text file of the workspace.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}},{\"name\":\"write_file\",\"description\":\"Create or replace a text file of the workspace.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}}],\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"]
fun request_body(model: str, fallbacks: bool, messages: [str]) -> str {
    var fields = [
        ("model", json.text(model)),
        ("max_tokens", Json.Int(16000)),
        ("system", json.text(SYSTEM)),
        ("tools", json.arr(tools().map((t: str) => json.parse(t).unwrap_or(Json.Null)))),
    ]
    if fallbacks {
        fields.push(("fallbacks", json.text("default")))
    }
    fields.push(("messages", json.arr(messages.map((m: str) => json.parse(m).unwrap_or(Json.Null)))))
    return json.to_string(json.obj(fields))
}

// A reply read: its stop reason, text and tool calls, or the API's error.
#test("{\"stop_reason\":\"tool_use\",\"content\":[{\"type\":\"text\",\"text\":\"Looking.\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"list_files\",\"input\":{\"path\":\".\"}}]}")[Ok(Turn { stop: "tool_use", text: "Looking.", calls: [Call { id: "t1", name: "list_files", input: "{\"path\":\".\"}" }], content: "[{\"type\":\"text\",\"text\":\"Looking.\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"list_files\",\"input\":{\"path\":\".\"}}]" })]
#test("{\"type\":\"error\",\"error\":{\"type\":\"authentication_error\",\"message\":\"invalid x-api-key\"}}")[Err("authentication_error: invalid x-api-key")]
#test("<html>")[Err("not a JSON reply: 1:1: Expecting value")]
fun read_turn(text: str) -> Result<Turn, str> {
    let j = match json.parse(text) {
        Ok(j) => j
        Err(e) => {
            return Err(f"not a JSON reply: {e}")
        }
    }
    let s = (path: str) => json.at(j, path).and_then((v: Json) => v.as_str()).unwrap_or("")
    if s("type") == "error" {
        return Err(f"{s("error.type")}: {s("error.message")}")
    }
    let blocks = json.at(j, "content").and_then((v: Json) => v.as_list()).unwrap_or([])
    var text_out: [str] = []
    var calls: [Call] = []
    for b in blocks {
        let field = (name: str) => json.field(b, name).and_then((v: Json) => v.as_str()).unwrap_or("")
        match field("type") {
            "text" => text_out.push(field("text"))
            "tool_use" => calls.push(Call { id: field("id"), name: field("name"), input: json.to_string(json.field(b, "input").unwrap_or(json.obj([]))) })
            _ => {}
        }
    }
    return Ok(Turn { stop: s("stop_reason"), text: text_out.join("\n"), calls: calls, content: json.to_string(Json.Array(blocks)) })
}

// One request, to a plain-HTTP host with std.http, otherwise through curl
// (TLS); the key goes in a header file, never in the command line.
async fun post(base: str, key: str, body: str) -> Result<str, str> {
    let url = f"{base}/v1/messages"
    if base.starts_with("http://") {
        let req = (http.request("POST", url)
            .with_header("content-type", "application/json")
            .with_header("x-api-key", key)
            .with_header("anthropic-version", API_VERSION)
            .with_body(body))
        return match await http.send_async(req) {
            Ok(resp) => Ok(resp.text())
            Err(e) => Err(f"{e}")
        }
    }
    let (path, f) = fs.make_temp_file().map_err((e: fs.IoError) => f"{e}")?
    var file = f
    let closed = file.close()
    let beta = if base == ANTHROPIC { f"anthropic-beta: {FALLBACK_BETA}\n" } else { "" }
    let headers = f"content-type: application/json\nx-api-key: {key}\nanthropic-version: {API_VERSION}\n{beta}"
    fs.write_to_file(path, headers).map_err((e: fs.IoError) => f"{e}")?
    let out = await process.command("curl").args(["-sS", "-X", "POST", url, "-H", f"@{path}", "--data-binary", "@-"]).stdin(body).output_async()
    let removed = fs.remove_file(path)
    return match out {
        Ok(o) => if o.status == process.ExitStatus.Exited(0) { Ok(bytes.to_str(o.stdout)) } else { Err(bytes.to_str(o.stderr).trim()) }
        Err(e) => Err(f"curl: {e}")
    }
}

// The loop: ask, run the tools Claude asks for, answer, until it's done.
async fun run_agent(base: str, key: str, model: str, root: str, task: str) -> Result<str, str> {
    var messages = [user_message(task)]
    for n in 0..MAX_TURNS {
        let reply = await post(base, key, request_body(model, base == ANTHROPIC, messages))
        let turn = read_turn(reply?)?
        messages.push(assistant_message(turn.content))
        if turn.text != "" {
            print(f"claude: {turn.text}")
        }
        match turn.stop {
            "tool_use" => {
                var results: [(str, bool)] = []
                for call in turn.calls {
                    let r = run_tool(root, call)
                    print(f"  {call.name} {call.input} -> {summary(r)}")
                    results.push(r)
                }
                messages.push(results_message(turn.calls, results))
            }
            "end_turn" => {
                return Ok(turn.text)
            }
            "refusal" => {
                return Err("Claude declined the task")
            }
            "max_tokens" => {
                return Err("the reply was cut off at max_tokens")
            }
            _ => {
                return Err(f"stopped: {turn.stop}")
            }
        }
    }
    return Err(f"no answer after {MAX_TURNS} turns")
}

// A tool result in one line, for the log.
#test(("a\nb\n", false))["2 lines"]
#test(("wrote 5 bytes", false))["wrote 5 bytes"]
#test(("not found (NotFound)", true))["error: not found (NotFound)"]
fun summary(r: (str, bool)) -> str {
    let (out, failed) = r
    if failed {
        return f"error: {out}"
    }
    let lines = out.lines().len()
    return if lines > 1 { f"{lines} lines" } else { out }
}

// --- offline: a stand-in for the API ------------------------------------------

// The reply the mock API gives: it plays one conversation, by how many
// messages the request has, and builds the summary from the results it got.
#test("{\"messages\":[{\"role\":\"user\",\"content\":\"Go\"}]}")["{\"stop_reason\":\"tool_use\",\"content\":[{\"type\":\"text\",\"text\":\"Let me look at the notes.\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"list_files\",\"input\":{\"path\":\".\"}}]}"]
#test("{}")["{\"type\":\"error\",\"error\":{\"type\":\"invalid_request_error\",\"message\":\"unexpected request\"}}"]
fun mock_reply(request: str) -> str {
    let j = json.parse(request).unwrap_or(Json.Null)
    let messages = json.at(j, "messages").and_then((v: Json) => v.as_list()).unwrap_or([])
    let say = (text: str) => json.obj([("type", json.text("text")), ("text", json.text(text))])
    let call = (id: str, name: str, input: [(str, Json)]) => json.obj([("type", json.text("tool_use")), ("id", json.text(id)), ("name", json.text(name)), ("input", json.obj(input))])
    let reply = (stop: str, content: [Json]) => json.to_string(json.obj([("stop_reason", json.text(stop)), ("content", json.arr(content))]))
    let result = (i: int) => json.at(j, f"messages[{messages.len() - 1}].content[{i}].content").and_then((v: Json) => v.as_str()).unwrap_or("")
    return match messages.len() {
        1 => reply("tool_use", [say("Let me look at the notes."), call("t1", "list_files", [("path", json.text("."))])])
        3 => {
            let names = result(0).lines().filter((n: str) => n.ends_with(".txt"))
            let calls = names.enumerate().map((p: (int, str)) => call(f"t{p.0 + 2}", "read_file", [("path", json.text(p.1))]))
            reply("tool_use", calls)
        }
        5 => {
            let parts = json.at(j, "messages[4].content").and_then((v: Json) => v.as_list()).unwrap_or([])
            let firsts = parts.map((b: Json) => "- " + json.field(b, "content").and_then((v: Json) => v.as_str()).unwrap_or("").lines()[0])
            let content = "# Summary\n\n" + firsts.join("\n") + "\n"
            reply("tool_use", [say("Writing the summary."), call("t9", "write_file", [("path", json.text("summary.md")), ("content", json.text(content))])])
        }
        7 => reply("end_turn", [say(f"Done: summary.md has the first line of each note ({result(0)}).")])
        _ => json.to_string(json.obj([("type", json.text("error")), ("error", json.obj([("type", json.text("invalid_request_error")), ("message", json.text("unexpected request"))]))]))
    }
}

async fun demo() -> Result<str, str> {
    let root = fs.make_temp_dir().map_err((e: fs.IoError) => f"{e}")?
    let notes = [("ideas.txt", "Teach the toaster to compile.\nAlso: towels."), ("todo.txt", "Buy a towel.\nDon't panic."), ("photo.png", "not a note")]
    for (name, text) in notes {
        fs.write_to_file(f"{root}/{name}", text).map_err((e: fs.IoError) => f"{e}")?
    }
    var l = net.listen(net.addr(net.loopback(), 0)).map_err((e: fs.IoError) => f"{e}")?
    let port = l.local_addr().map_err((e: fs.IoError) => f"{e}")?.port
    async let server = http.serve_n(l, 4, (r: Request) => http.response(200, mock_reply(r.text())).with_header("content-type", "application/json"))
    let answer = await run_agent(f"http://127.0.0.1:{port}", "demo", MODEL, root, "Summarise the notes into summary.md.")
    let served = await server
    let closed = l.close()
    let written = fs.read_to_string(f"{root}/summary.md").unwrap_or("(nothing)")
    let removed = fs.remove_dir_all(root)
    print("summary.md:")
    print(written.trim_end())
    return answer
}

#main
async fun main() {
    let argv = process.args()
    if argv.len() < 2 {
        match await demo() {
            Ok(a) => print("done")
            Err(e) => print(f"failed: {e}")
        }
        return
    }
    let base = process.env("ANTHROPIC_BASE_URL").unwrap_or(ANTHROPIC)
    let model = process.env("AGENT_MODEL").unwrap_or(MODEL)
    // a local server usually takes any key
    let key = match process.env("ANTHROPIC_API_KEY") {
        Some(k) => k
        None => {
            if base == ANTHROPIC {
                print("set ANTHROPIC_API_KEY first")
                process.exit(2)
                return
            }
            "local"
        }
    }
    let root = if argv.len() > 2 { argv[2] } else { "." }
    match await run_agent(base, key, model, root, argv[1]) {
        Ok(a) => print("done")
        Err(e) => {
            print(f"failed: {e}")
            process.exit(1)
        }
    }
}
