// An agentic AI harness: a model works on a directory with three tools, in
// a loop: it asks for a tool, the harness runs it and sends the result
// back, until the model answers without one.
//
//   myla run examples/agent.my "Summarise the notes into summary.md" notes/
//
// It talks to a model served on your network with the OpenAI-style chat
// completions API (vLLM, llama.cpp's server, Ollama, ...), configured by the
// constants below. vLLM calls tools only when started with
// `--enable-auto-tool-choice --tool-call-parser <the model's parser>`.
// Without a task it runs offline: a scripted stand-in for the server on a
// local port (`mock_reply`) plays one conversation, so the whole loop runs
// and is checked by the example tests.
import std.fs as fs
import std.http as http
import std.json as json
import std.net as net
import std.process as process
from std.http import Request
from std.json import Json

// Where the model is. std.http speaks plain HTTP; the host's name goes
// through /etc/hosts and DNS (without search domains), so an IP always works.
const SERVER: str = "http://jarvis:9293"
const MODEL: str = "nvidia/Qwen3.6-35B-A3B-NVFP4"
// the server's --api-key, if it has one
const API_KEY: str = ""
// what one reply may take of the model's 32,768-token context
const MAX_TOKENS: int = 4096
const MAX_TURNS: int = 20
const SYSTEM: str = "You work in a directory through the tools. Paths are relative to it. When the task is done, say in one sentence what you did."

// A tool call: its arguments are JSON text, as the model wrote them.
#derive(Eq)
struct Call {
    id: str,
    name: str,
    input: str,
}

// One reply: its text, its tool calls, why it ended, and the message that
// goes back into the conversation.
#derive(Eq)
struct Turn {
    text: str,
    calls: [Call],
    finish: str,
    message: str,
}

// --- the tools ---------------------------------------------------------------

// A tool whose parameters are all required strings.
#test("read_file", "Read a file.", ["path"])["{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read a file.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}}"]
fun tool(name: str, description: str, params: [str]) -> str {
    let props = params.map((p: str) => (p, json.obj([("type", json.text("string"))])))
    let schema = json.obj([
        ("type", json.text("object")),
        ("properties", json.obj(props)),
        ("required", json.arr(params.map((p: str) => json.text(p)))),
    ])
    let function = json.obj([("name", json.text(name)), ("description", json.text(description)), ("parameters", schema)])
    return json.to_string(json.obj([("type", json.text("function")), ("function", function)]))
}

#test()[["{\"type\":\"function\",\"function\":{\"name\":\"list_files\",\"description\":\"List the names in a directory of the workspace; directories end with /.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}}", "{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read a text file of the workspace.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}}", "{\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"description\":\"Create or replace a text file of the workspace.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}}}"]]
fun tools() -> [str] {
    return [
        tool("list_files", "List the names in a directory of the workspace; directories end with /.", ["path"]),
        tool("read_file", "Read a text file of the workspace.", ["path"]),
        tool("write_file", "Create or replace a text file of the workspace.", ["path", "content"]),
    ]
}

// A path inside the workspace `root`, or why not: tools never leave it
// (by the path's text; a symbolic link inside could still point out).
#test("/w", "notes/a.txt")[Ok("/w/notes/a.txt")]
#test("/w", ".")[Ok("/w")]
#test("/w", "../secrets")[Err("'../secrets' is outside the workspace")]
#test("/w", "/etc/passwd")[Err("'/etc/passwd' is outside the workspace")]
fun inside(root: str, path: str) -> Result<str, str> {
    if path.starts_with("/") || path.split("/").contains("..") {
        return Err(f"'{path}' is outside the workspace")
    }
    if path == "." || path == "" {
        return Ok(root)
    }
    return Ok(f"{root}/{path}")
}

// A string argument of a call.
#test("{\"path\": \"a.txt\"}", "path")[Ok("a.txt")]
#test("{}", "path")[Err("missing 'path'")]
#test("nope", "path")[Err("the arguments aren't JSON")]
fun arg(input: str, name: str) -> Result<str, str> {
    let j = match json.parse(input) {
        Ok(j) => j
        Err(e) => {
            return Err("the arguments aren't JSON")
        }
    }
    return json.field(j, name).and_then((v: Json) => v.as_str()).ok_or(f"missing '{name}'")
}

// What a tool call gives back, and whether it failed.
#test("/no/such/dir", Call { id: "c1", name: "read_file", input: "{\"path\": \"a.txt\"}" })[("not found (NotFound)", true)]
#test("/w", Call { id: "c2", name: "write_file", input: "{\"path\": \"../x\", \"content\": \"\"}" })[("'../x' is outside the workspace", true)]
#test("/w", Call { id: "c3", name: "delete_everything", input: "{}" })[("there is no tool 'delete_everything'", true)]
fun run_tool(root: str, call: Call) -> (str, bool) {
    let result = match call.name {
        "list_files" => list_files(root, call.input)
        "read_file" => read_file(root, call.input)
        "write_file" => write_file(root, call.input)
        _ => Err(f"there is no tool '{call.name}'")
    }
    return match result {
        Ok(out) => (out, false)
        Err(e) => (e, true)
    }
}

#test("/no/such/dir", "{\"path\": \".\"}")[Err("not found (NotFound)")]
fun list_files(root: str, input: str) -> Result<str, str> {
    let dir = inside(root, arg(input, "path")?)?
    let names = fs.list_dir(dir).map_err((e: fs.IoError) => f"{e}")?
    return Ok(names.map((n: str) => if fs.is_dir(f"{dir}/{n}") { n + "/" } else { n }).join("\n"))
}

#test("/no/such/dir", "{\"path\": \"a.txt\"}")[Err("not found (NotFound)")]
fun read_file(root: str, input: str) -> Result<str, str> {
    let file = inside(root, arg(input, "path")?)?
    return fs.read_to_string(file).map_err((e: fs.IoError) => f"{e}")
}

#test("/no/such/dir", "{\"path\": \"a.txt\", \"content\": \"hi\"}")[Err("not found (NotFound)")]
#test("/w", "{\"path\": \"a.txt\"}")[Err("missing 'content'")]
fun write_file(root: str, input: str) -> Result<str, str> {
    let file = inside(root, arg(input, "path")?)?
    let content = arg(input, "content")?
    fs.write_to_file(file, content).map_err((e: fs.IoError) => f"{e}")?
    return Ok(f"wrote {content.len()} bytes")
}

// --- the chat completions API --------------------------------------------------

#test("user", "Hi")["{\"role\":\"user\",\"content\":\"Hi\"}"]
fun message(role: str, text: str) -> str {
    return json.to_string(json.obj([("role", json.text(role)), ("content", json.text(text))]))
}

// A tool's result, as the message that answers its call.
#test("c1", ("missing 'path'", true))["{\"role\":\"tool\",\"tool_call_id\":\"c1\",\"content\":\"error: missing 'path'\"}"]
#test("c2", ("hello", false))["{\"role\":\"tool\",\"tool_call_id\":\"c2\",\"content\":\"hello\"}"]
fun tool_message(id: str, result: (str, bool)) -> str {
    let content = if result.1 { "error: " + result.0 } else { result.0 }
    return json.to_string(json.obj([("role", json.text("tool")), ("tool_call_id", json.text(id)), ("content", json.text(content))]))
}

// The request: the model, the tools and the whole conversation so far.
#test("m", ["{\"role\":\"user\",\"content\":\"Hi\"}"])["{\"model\":\"m\",\"max_tokens\":4096,\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"list_files\",\"description\":\"List the names in a directory of the workspace; directories end with /.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read a text file of the workspace.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}},{\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"description\":\"Create or replace a text file of the workspace.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}}}],\"tool_choice\":\"auto\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]}"]
fun request_body(model: str, messages: [str]) -> str {
    return json.to_string(json.obj([
        ("model", json.text(model)),
        ("max_tokens", Json.Int(MAX_TOKENS as int64)),
        ("tools", json.arr(tools().map((t: str) => json.parse(t).unwrap_or(Json.Null)))),
        ("tool_choice", json.text("auto")),
        ("messages", json.arr(messages.map((m: str) => json.parse(m).unwrap_or(Json.Null)))),
    ]))
}

// A reply read: its text, tool calls and finish reason, or the server's
// error (OpenAI's `{"error": {...}}` or vLLM's `{"object": "error", ...}`).
#test("{\"choices\":[{\"finish_reason\":\"tool_calls\",\"message\":{\"role\":\"assistant\",\"content\":\"Looking.\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"list_files\",\"arguments\":\"{\\\"path\\\": \\\".\\\"}\"}}]}}]}")[Ok(Turn { text: "Looking.", calls: [Call { id: "c1", name: "list_files", input: "{\"path\": \".\"}" }], finish: "tool_calls", message: "{\"role\":\"assistant\",\"content\":\"Looking.\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"list_files\",\"arguments\":\"{\\\"path\\\": \\\".\\\"}\"}}]}" })]
#test("{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"Done.\"}}]}")[Ok(Turn { text: "Done.", calls: [], finish: "stop", message: "{\"role\":\"assistant\",\"content\":\"Done.\"}" })]
#test("{\"object\":\"error\",\"message\":\"\\\"auto\\\" tool choice requires --enable-auto-tool-choice\",\"code\":400}")[Err("the server says: \"auto\" tool choice requires --enable-auto-tool-choice")]
#test("{\"error\":{\"message\":\"model not found\"}}")[Err("the server says: model not found")]
#test("<html>")[Err("not a JSON reply: 1:1: Expecting value")]
fun read_turn(text: str) -> Result<Turn, str> {
    let j = match json.parse(text) {
        Ok(j) => j
        Err(e) => {
            return Err(f"not a JSON reply: {e}")
        }
    }
    let s = (v: Json, path: str) => json.at(v, path).and_then((x: Json) => x.as_str()).unwrap_or("")
    let problem = if s(j, "object") == "error" { s(j, "message") } else { s(j, "error.message") }
    if problem != "" {
        return Err(f"the server says: {problem}")
    }
    let Some(msg) = json.at(j, "choices[0].message") else {
        return Err("a reply without a message")
    }
    let raw = json.field(msg, "tool_calls").and_then((v: Json) => v.as_list()).unwrap_or([])
    var calls: [Call] = []
    for c in raw {
        // the arguments are a JSON string, though some servers send an object
        let args = json.at(c, "function.arguments").unwrap_or(json.obj([]))
        let input = args.as_str().unwrap_or(json.to_string(args))
        calls.push(Call { id: s(c, "id"), name: s(c, "function.name"), input: input })
    }
    let text = s(msg, "content")
    var back = [("role", json.text("assistant")), ("content", json.text(text))]
    if raw.len() > 0 {
        back.push(("tool_calls", Json.Array(raw)))
    }
    return Ok(Turn { text: text, calls: calls, finish: s(j, "choices[0].finish_reason"), message: json.to_string(json.obj(back)) })
}

// What a reply says, without the reasoning a model like Qwen3 writes
// first between <think> tags (when the server doesn't take it out).
#test("<think>Hmm.</think>\n\nDone.")["Done."]
#test("Done.")["Done."]
fun visible(text: str) -> str {
    let parts = text.split("</think>")
    return parts[^1].trim()
}

// One request to the server.
async fun post(server: str, body: str) -> Result<str, str> {
    var req = http.request("POST", f"{server}/v1/chat/completions").with_header("content-type", "application/json").with_body(body)
    if API_KEY != "" {
        req = req.with_header("authorization", f"Bearer {API_KEY}")
    }
    return match await http.send_async(req) {
        Ok(resp) => if resp.is_success() || json.parse(resp.text()).is_ok() { Ok(resp.text()) } else { Err(f"HTTP {resp.status} {resp.reason}") }
        Err(e) => Err(f"{server}: {e}")
    }
}

// The loop: ask, run the tools the model asks for, answer, until it
// answers without a tool call.
async fun run_agent(server: str, model: str, root: str, task: str) -> Result<str, str> {
    var messages = [message("system", SYSTEM), message("user", task)]
    for n in 0..MAX_TURNS {
        let reply = await post(server, request_body(model, messages))
        let turn = read_turn(reply?)?
        messages.push(turn.message)
        let said = visible(turn.text)
        if said != "" {
            print(f"model: {said}")
        }
        if turn.calls.len() == 0 {
            if turn.finish == "length" {
                return Err(f"the reply was cut off at {MAX_TOKENS} tokens")
            }
            return Ok(said)
        }
        for call in turn.calls {
            let r = run_tool(root, call)
            print(f"  {call.name} {call.input} -> {summary(r)}")
            messages.push(tool_message(call.id, r))
        }
    }
    return Err(f"no answer after {MAX_TURNS} turns")
}

// A tool result in one line, for the log.
#test(("a\nb\n", false))["2 lines"]
#test(("wrote 5 bytes", false))["wrote 5 bytes"]
#test(("not found (NotFound)", true))["error: not found (NotFound)"]
fun summary(r: (str, bool)) -> str {
    let (out, failed) = r
    if failed {
        return f"error: {out}"
    }
    let lines = out.lines().len()
    return if lines > 1 { f"{lines} lines" } else { out }
}

// --- offline: a stand-in for the server ---------------------------------------

// The reply the stand-in gives: it plays one conversation, by how many
// answers the model has given so far, and builds the summary from the tool
// results it got.
#test("{\"messages\":[{\"role\":\"user\",\"content\":\"Go\"}]}")["{\"choices\":[{\"finish_reason\":\"tool_calls\",\"message\":{\"role\":\"assistant\",\"content\":\"<think>A summary of notes: first see what there is.</think>\\n\\nLet me look at the notes.\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"list_files\",\"arguments\":\"{\\\"path\\\":\\\".\\\"}\"}}]}}]}"]
#test("{\"messages\":[{\"role\":\"assistant\",\"content\":\"\"},{\"role\":\"assistant\",\"content\":\"\"},{\"role\":\"assistant\",\"content\":\"\"},{\"role\":\"assistant\",\"content\":\"\"}]}")["{\"object\":\"error\",\"message\":\"unexpected request\",\"code\":400}"]
fun mock_reply(request: str) -> str {
    let j = json.parse(request).unwrap_or(Json.Null)
    let messages = json.at(j, "messages").and_then((v: Json) => v.as_list()).unwrap_or([])
    let role = (m: Json) => json.field(m, "role").and_then((v: Json) => v.as_str()).unwrap_or("")
    let answered = messages.count((m: Json) => role(m) == "assistant")
    // the contents of the tool messages since the model's last answer
    var results: [str] = []
    for m in messages {
        if role(m) == "assistant" {
            results = []
        } else if role(m) == "tool" {
            results.push(json.field(m, "content").and_then((v: Json) => v.as_str()).unwrap_or(""))
        }
    }
    let call = (id: str, name: str, args: [(str, Json)]) => json.obj([
        ("id", json.text(id)),
        ("type", json.text("function")),
        ("function", json.obj([("name", json.text(name)), ("arguments", json.text(json.to_string(json.obj(args))))])),
    ])
    let reply = (text: str, calls: [Json]) => {
        var msg = [("role", json.text("assistant")), ("content", json.text(text))]
        if calls.len() > 0 {
            msg.push(("tool_calls", json.arr(calls)))
        }
        let finish = if calls.len() > 0 { "tool_calls" } else { "stop" }
        return json.to_string(json.obj([("choices", json.arr([json.obj([("finish_reason", json.text(finish)), ("message", json.obj(msg))])]))]))
    }
    return match answered {
        0 => reply("<think>A summary of notes: first see what there is.</think>\n\nLet me look at the notes.", [call("c1", "list_files", [("path", json.text("."))])])
        1 => {
            let names = results[0].lines().filter((n: str) => n.ends_with(".txt"))
            reply("", names.enumerate().map((p: (int, str)) => call(f"c{p.0 + 2}", "read_file", [("path", json.text(p.1))])))
        }
        2 => {
            let content = "# Summary\n\n" + results.map((r: str) => "- " + r.lines()[0]).join("\n") + "\n"
            reply("Writing the summary.", [call("c9", "write_file", [("path", json.text("summary.md")), ("content", json.text(content))])])
        }
        3 => reply(f"Done: summary.md has the first line of each note ({results[0]}).", [])
        _ => "{\"object\":\"error\",\"message\":\"unexpected request\",\"code\":400}"
    }
}

async fun demo() -> Result<str, str> {
    let root = fs.make_temp_dir().map_err((e: fs.IoError) => f"{e}")?
    let notes = [("ideas.txt", "Teach the toaster to compile.\nAlso: towels."), ("todo.txt", "Buy a towel.\nDon't panic."), ("photo.png", "not a note")]
    for (name, text) in notes {
        fs.write_to_file(f"{root}/{name}", text).map_err((e: fs.IoError) => f"{e}")?
    }
    var l = net.listen(net.addr(net.loopback(), 0)).map_err((e: fs.IoError) => f"{e}")?
    let port = l.local_addr().map_err((e: fs.IoError) => f"{e}")?.port
    async let server = http.serve_n(l, 4, (r: Request) => http.response(200, mock_reply(r.text())).with_header("content-type", "application/json"))
    let answer = await run_agent(f"http://127.0.0.1:{port}", MODEL, root, "Summarise the notes into summary.md.")
    let served = await server
    let closed = l.close()
    let written = fs.read_to_string(f"{root}/summary.md").unwrap_or("(nothing)")
    let removed = fs.remove_dir_all(root)
    print("summary.md:")
    print(written.trim_end())
    return answer
}

#main
async fun main() {
    let argv = process.args()
    if argv.len() < 2 {
        match await demo() {
            Ok(a) => print("done")
            Err(e) => print(f"failed: {e}")
        }
        return
    }
    let root = if argv.len() > 2 { argv[2] } else { "." }
    match await run_agent(SERVER, MODEL, root, argv[1]) {
        Ok(a) => print("done")
        Err(e) => {
            print(f"failed: {e}")
            process.exit(1)
        }
    }
}
