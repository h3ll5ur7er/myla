// control_flow.my — if / else if / else and boolean logic.

#test(-3)["negative"]
#test(0)["zero"]
#test(7)["positive"]
fun classify(n: int) -> str {
    if n < 0 {
        return "negative"
    } else if n == 0 {
        return "zero"
    } else {
        return "positive"
    }
}

fun main() {
    print(classify(-3))     // negative
    print(classify(0))      // zero
    print(classify(7))      // positive

    let a = true
    let b = false
    print(a && !b)          // true
    print(a || b)           // true
    print(!(a && b))        // true
}
