// regressions.my — accepted-program edge cases and previously-fixed bugs.
//
// The negative corpus (examples/errors/) pins down what must be *rejected*;
// this file pins down subtle things that must keep *working*. Every case is a
// #test so a regression fails the suite (see CONVENTIONS in the README).

struct Box {
    v: int,
}

// Fixed bug: a block-bodied match arm could not be followed by another arm
// (the parser wrongly demanded a separator after the closing `}`).
#test(0)["zero"]
#test(1)["one"]
#test(9)["many"]
fun describe(n: int) -> str {
    return match n {
        0 => {
            let s = "zero"
            s
        }
        1 => "one",
        _ => "many",
    }
}

// `(x)` is a grouped expression, not a 1-tuple — only `(x,)` is a tuple.
#test(4)[5]
fun grouped(x: int) -> int {
    return (x + 1)
}

// The 1-tuple round-trips through construction and `.0` indexing.
#test(5)[(5,)]
fun wrap(x: int) -> (int,) {
    return (x,)
}

#test((7,))[7]
fun unwrap(t: (int,)) -> int {
    return t.0
}

// Negative integer literals are valid match patterns.
#test(-1)["minus one"]
#test(0)["zero"]
#test(2)["other"]
fun classify_small(n: int) -> str {
    return match n {
        -1 => "minus one",
        0  => "zero",
        1  => "one",
        _  => "other",
    }
}

// Value semantics: copying a tuple element and mutating the copy must leave the
// original untouched (the returned 1 proves `orig` was not aliased).
#test()[1]
fun isolated_original() -> int {
    let orig = Box { v: 1 }
    let t = (orig, 2)
    var c = t.0
    c.v = 99
    return orig.v
}

fun main() {
    print(describe(0))          // zero
    print(grouped(4))           // 5
    print(unwrap(wrap(5)))      // 5
    print(classify_small(-1))   // minus one
    print(isolated_original())  // 1
}
