trait Garbage<T> {
    fun combine_with_seven(self) -> T
}
trait Parsable<S> {
    fun parse(self) -> S
}
trait Describe {
    fun describe(self) -> str
}

impl Garbage<int32> for int32 {
    fun combine_with_seven(self) -> int32 {
        if self == 6 {
            print("haha 67")
        }
        return self * 7
    }
}


enum ErrorCode {
    Unauthorized,
    Success,
    NotFound,
    ImATeapot,
    InternalServerError,
    ParseError(int),
}

impl ErrorCode {
    fun resolve(var self) -> ErrorCode {
        return ErrorCode.Success
    }
}

impl Parsable<ErrorCode> for int {
    fun parse(self) -> ErrorCode {
        return match self {
            200 => ErrorCode.Success,
            401 => ErrorCode.Unauthorized,
404 => ErrorCode.NotFound,
            418 => ErrorCode.ImATeapot,
            500 => ErrorCode.InternalServerError,
            _ => ErrorCode.ParseError(self),
        }
    }
}

impl Describe for ErrorCode {
    fun describe(self) -> str {
        return match self {
            ErrorCode.Success => "Success",
            ErrorCode.Unauthorized => "Unauthorized",
            ErrorCode.NotFound => "Not Found",
            ErrorCode.ImATeapot => "I'm a teapot",
            ErrorCode.InternalServerError => "Internal Server Error",
            ErrorCode.ParseError(42) => f"This is not the error you are looking for. It is the answer to life, the universe, and everything.",
            ErrorCode.ParseError(code) => f"This is not the error you are looking for. It is {code}",
        }
    }
}

#main
fun someentry() {
    let y: int32= 7
    print(y.combine_with_seven())
    let x: int32 = 6
    print(x.combine_with_seven())
    print(418.parse().describe())
    print(42.parse().describe())
    print(13.parse().describe())
    var z: int = 15
    var zE = z.parse()
    var zD = zE.describe()
    print(zD)
    var zR = zE.resolve()
    print(zR.describe())
}
