// functions.my — declarations, parameters, return values, recursion, tail calls.
//
// Every value-returning function carries #test cases (run with `myla test`), so
// the example doubles as a regression suite — see CONVENTIONS in the README.

#test(2, 3)[5]
#test(0, 0)[0]
#test(-1, 1)[0]
fun add(a: int, b: int) -> int {
    return a + b
}

#test(0)[1]
#test(1)[1]
#test(5)[120]
fun factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

// `become` ends the function with a call that takes over its stack frame
// (D87): however deep it goes, the stack doesn't grow.
#test(0, 1)[1]
#test(5, 1)[120]
fun factorial_acc(n: int, acc: int) -> int {
    if n <= 1 {
        return acc
    }
    become factorial_acc(n - 1, acc * n)
}

#test(10)[true]
#test(7)[false]
fun is_even(n: int) -> bool {
    if n == 0 {
        return true
    }
    become is_odd(n - 1)
}

#test(7)[true]
fun is_odd(n: int) -> bool {
    if n == 0 {
        return false
    }
    become is_even(n - 1)
}

fun main() {
    print(add(2, 3))                // 5
    print(factorial(5))             // 120
    print(factorial_acc(5, 1))      // 120
    print(is_even(100000))          // true, a hundred thousand calls deep
}
