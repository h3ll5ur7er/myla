// functions.my — declarations, parameters, return values, recursion.
//
// Every value-returning function carries #test cases (run with `myla test`), so
// the example doubles as a regression suite — see CONVENTIONS in the README.

#test(2, 3)[5]
#test(0, 0)[0]
#test(-1, 1)[0]
fun add(a: int, b: int) -> int {
    return a + b
}

#test(0)[1]
#test(1)[1]
#test(5)[120]
fun factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fun main() {
    print(add(2, 3))        // 5
    print(factorial(5))     // 120
}
