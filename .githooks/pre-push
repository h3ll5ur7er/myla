#!/usr/bin/env bash
#
# pre-push — before a push, check that the seed (bootstrap/seed*.s) bootstraps
# the sources and the embedded library is current (scripts/check-seed.sh,
# MYLA-218, D207) when the commits pushed change the compiler's sources or the
# seed. Optional: scripts/install-hooks.sh turns it
# on for a clone. MYLA_SKIP_SEED_CHECK=1 git push skips it once.
#
# It checks the working tree's sources, so commit (or stash) changes to
# selfhost/ and lib/std/ first. A seed that can't bootstrap the sources, or a
# stale embedded library, stops a push to master or main; on another branch
# it is a reminder, since a branch's commits may leave them behind until the
# pull request is ready (D207).

set -euo pipefail

[ "${MYLA_SKIP_SEED_CHECK:-}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
relevant=0
to_default=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # a deletion
    case "$remote_ref" in refs/heads/master|refs/heads/main) to_default=1 ;; esac
    if [ "$remote_sha" = "$zero" ]; then              # a new branch: against what the remote has
        base="$(git merge-base "$local_sha" "origin/HEAD" 2>/dev/null || true)"
    else
        base="$remote_sha"
    fi
    if [ -z "$base" ] || [ -n "$(git diff --name-only "$base" "$local_sha" -- selfhost lib/std bootstrap)" ]; then
        relevant=1
    fi
done
[ "$relevant" = 1 ] || exit 0

if [ -n "$(git status --porcelain -- selfhost lib/std bootstrap)" ]; then
    echo "pre-push: uncommitted changes in selfhost/, lib/std/ or the seed are checked as they are" >&2
fi
echo "pre-push: checking that the seed bootstraps the sources"
if [ "$to_default" = 1 ]; then
    scripts/check-seed.sh
elif ! scripts/check-seed.sh; then
    echo "pre-push: the seed can't bootstrap the sources or the embedded library is behind lib/: see check-seed's message above (D207)" >&2
fi
