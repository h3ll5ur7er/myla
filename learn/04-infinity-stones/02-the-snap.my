// title: The Snap
// xp: 20
// hidden: snap #test([10, 15, 20])[[10, 20]]
// hint: There's a list method that keeps only the values a function approves of.
// hint: `filter` takes a lambda that gives a `bool`; even numbers leave no remainder when divided by 2.
//
// *Snap.* Half of everything disappears: in this simulation, every odd
// number. `snap` should keep only the even numbers, in their order.
//
// Use `filter` with a lambda `(n: int) => …` that says which ones stay.
#test([1, 2, 3, 4, 5, 6])[[2, 4, 6]]
#test([7, 9])[[]]
#test([42])[[42]]
fun snap(population: [int]) -> [int] {
    return population
}
