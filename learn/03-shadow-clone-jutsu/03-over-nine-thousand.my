// title: Over Nine Thousand
// xp: 15
// hint: A parameter gets a default with `= value` after its type.
// hint: `fun power_level(name: str, level: int = 9001) -> str`
//
// Scouters everywhere agree: unless told otherwise, a power level is over
// nine thousand. Give `level` a default of `9001`, so `power_level("Goku")`
// works without the second argument, as `goku` calls it.
#test()["Goku: 9001"]
fun goku() -> str {
    return power_level("Goku")
}

#test("Krillin", 1770)["Krillin: 1770"]
fun power_level(name: str, level: int) -> str {
    return f"{name}: {level}"
}
