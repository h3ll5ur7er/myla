#test(3, 1)[8]
#test(0, 5)[5]
fun doubled(times: int, start: int) -> int {
    return train((x: int) => x * 2, times, start)
}

#test(4, 10)[14]
fun plus_one(times: int, start: int) -> int {
    return train((x: int) => x + 1, times, start)
}

fun train(f: (int) -> int, times: int, start: int) -> int {
    var x = start
    for i in 0..times {
        x = f(x)
    }
    return x
}
