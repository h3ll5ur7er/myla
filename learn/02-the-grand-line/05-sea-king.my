// title: Sea King Ahead
// xp: 20
// hidden: safe_depth #test([5, -1, 9000, 9001])[9005]
// hint: Two situations: one means "skip this reading", the other "stop reading now".
// hint: Myla has a keyword for each: one goes on with the next round, the other leaves the loop. Test for them before adding.
//
// The ship's sonar reports depths. A negative reading is noise: skip it. A
// reading over 9000 means a Sea King: stop reading at once. Add up the depths
// read before that.
//
// `safe_depth` adds every reading. Use `continue` and `break` to fix it.
#test([10, -5, 20, 9001, 30])[30]
#test([1, 2, 3])[6]
#test([9500, 1])[0]
#test([-1, -2])[0]
fun safe_depth(readings: [int]) -> int {
    var total = 0
    for depth in readings {
        total += depth
    }
    return total
}
