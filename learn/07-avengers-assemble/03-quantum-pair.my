// title: Quantum Pair
// xp: 25
// hint: The struct only holds `int`s. Make it generic: `struct Pair<T> { first: T, second: T }`.
// hint: Its methods then live in `impl<T> Pair<T> { … }`, and `swap` gives a `Pair<T>`.
//
// The quantum realm swaps things around. `Pair` holds two values and `swap`
// exchanges them, but it only works for `int`s, and the tests swap strings
// too. Make `Pair` and its `impl` generic over the type `T` of the values.
struct Pair {
    first: int,
    second: int,
}

impl Pair {
    fun swap(self) -> Pair {
        return Pair { first: self.second, second: self.first }
    }
}

#test(1, 2)[(2, 1)]
fun swap_ints(a: int, b: int) -> (int, int) {
    let p = Pair { first: a, second: b }.swap()
    return (p.first, p.second)
}

#test("Scott", "Hope")[("Hope", "Scott")]
fun swap_names(a: str, b: str) -> (str, str) {
    let p = Pair { first: a, second: b }.swap()
    return (p.first, p.second)
}
