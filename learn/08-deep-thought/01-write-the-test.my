//
// This time the code is right and the tests are missing: the exercise passes
// when `question` has test cases, and they all pass.
//
// `question(a, b)` multiplies its arguments. Write at least two `#test`
// cases for it, one of them `question(6, 7)` giving `42`. (Run **Test** to
// see them run.)
fun question(a: int, b: int) -> int {
    return a * b
}
