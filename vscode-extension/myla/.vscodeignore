# Everything is left out except what the extension runs: the bundles in out/
# (esbuild inlines vscode-languageclient, so no node_modules), the manifest,
# grammar, snippets, language configuration, icon, README, CHANGELOG and LICENSE.
**
!package.json
!out/extension.js
!out/debugAdapter.js
!syntaxes/myla.tmLanguage.json
!snippets/myla.code-snippets
!language-configuration.json
!images/icon.png
!README.md
!CHANGELOG.md
!LICENSE
