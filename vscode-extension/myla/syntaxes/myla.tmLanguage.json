{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Myla",
  "scopeName": "source.myla",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#fields"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.myla",
          "match": "//.*$"
        },
        {
          "name": "comment.block.myla",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.annotation.myla",
          "begin": "(#)([_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.annotation.myla"
            },
            "2": {
              "name": "entity.name.function.attribute.myla"
            }
          },
          "end": "(?=$|\\{|fun\\b|struct\\b|enum\\b|trait\\b|impl\\b|typealias\\b|const\\b|import\\b|from\\b)",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#chars"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fstring.myla",
          "begin": "f\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.myla"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.myla"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.myla",
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.double.myla",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.myla"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.myla"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.myla",
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.char.myla",
          "match": "'([^'\\\\]|\\\\u\\{[0-9a-fA-F]+\\}|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.myla",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)(?:f32|f64)?\\b|\\b[0-9][0-9_]*(?:f32|f64)\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.myla",
          "match": "\\b0x[0-9a-fA-F_]+(?:[iu](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.integer.binary.myla",
          "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.integer.octal.myla",
          "match": "\\b0o[0-7_]+(?:[iu](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.integer.myla",
          "match": "\\b[0-9][0-9_]*(?:[iu](?:8|16|32|64))?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.myla",
          "match": "\\b(fun)\\s+([_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.myla"
            },
            "2": {
              "name": "entity.name.function.myla"
            }
          }
        },
        {
          "name": "meta.struct.myla",
          "match": "\\b(struct)\\s+([_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*)",
          "captures": {
            "1": {
              "name": "storage.type.struct.myla"
            },
            "2": {
              "name": "entity.name.type.struct.myla"
            }
          }
        },
        {
          "name": "meta.enum.myla",
          "match": "\\b(enum)\\s+([_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.myla"
            },
            "2": {
              "name": "entity.name.type.enum.myla"
            }
          }
        },
        {
          "name": "meta.trait.myla",
          "match": "\\b(trait)\\s+([_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*)",
          "captures": {
            "1": {
              "name": "storage.type.trait.myla"
            },
            "2": {
              "name": "entity.name.type.trait.myla"
            }
          }
        },
        {
          "name": "meta.typealias.myla",
          "match": "\\b(typealias)\\s+([_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*)",
          "captures": {
            "1": {
              "name": "storage.type.alias.myla"
            },
            "2": {
              "name": "entity.name.type.alias.myla"
            }
          }
        },
        {
          "name": "meta.impl.myla",
          "match": "\\b(impl)\\b",
          "captures": {
            "1": {
              "name": "storage.type.impl.myla"
            }
          }
        },
        {
          "name": "meta.const.myla",
          "match": "\\b(const)\\s+([_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.const.myla"
            },
            "2": {
              "name": "variable.other.constant.myla"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.myla",
          "match": "\\b(int|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|float32|float64|bool|str|char)\\b"
        },
        {
          "name": "entity.name.type.myla",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.myla",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.myla",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.placeholder.myla",
          "match": "\\b_\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.myla",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.myla",
          "match": "\\b(while|for|in|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.myla",
          "match": "\\b(return)\\b"
        },
        {
          "name": "storage.modifier.visibility.myla",
          "match": "\\b(pub)\\b"
        },
        {
          "name": "storage.type.variable.myla",
          "match": "\\b(let|var)\\b"
        },
        {
          "name": "keyword.control.import.myla",
          "match": "\\b(import|from|as)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.myla",
          "match": "\\|>|>>"
        },
        {
          "name": "keyword.operator.shift.myla",
          "match": "<<"
        },
        {
          "name": "storage.type.function.arrow.myla",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.myla",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.myla",
          "match": "\\|\\||&&|!"
        },
        {
          "name": "keyword.operator.bitwise.myla",
          "match": "\\||\\^|&|~"
        },
        {
          "name": "keyword.operator.assignment.myla",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.myla",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.try.myla",
          "match": "\\?"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.myla",
          "match": "\\b[a-zA-Z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.other.member.myla",
          "match": "(?<=\\.)[_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*"
        },
        {
          "name": "variable.other.field.myla",
          "match": "\\b[_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*(?=\\s*:)",
          "captures": {
            "0": {
              "name": "variable.other.field.myla"
            }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.myla",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.myla",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.myla",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.myla",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.block.myla",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.myla",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.brackets.myla",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
