{
  "name": "myla-language-support",
  "displayName": "Myla Language Support",
  "description": "Syntax highlighting and basic editor support for the Myla programming language.",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "myla",
        "aliases": [
          "Myla",
          "myla"
        ],
        "extensions": [
          ".my"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "myla",
        "scopeName": "source.myla",
        "path": "./syntaxes/myla.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "myla",
        "path": "./snippets/myla.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "myla.showExtensionInfo",
        "title": "Myla: Show Extension Info"
      },
      {
        "command": "myla.formatFile",
        "title": "Myla: Format File"
      },
      {
        "command": "myla.restartLanguageServer",
        "title": "Myla: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Myla",
      "properties": {
        "myla.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter used to run the Myla language server. Leave empty to auto-detect the project's `.venv` (created by `uv`), falling back to `python` on PATH."
        },
        "myla.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Myla repository root (the folder containing `myla.py`) or directly to `myla.py`. Leave empty to auto-detect from the workspace root."
        },
        "myla.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Myla compiler diagnostics from the language server."
        },
        "myla.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Myla language server."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:myla"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
