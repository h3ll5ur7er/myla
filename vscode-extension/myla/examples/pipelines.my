// pipelines.my — functional pipelines, composition & partial application
// (v0.4.3). All three are pure desugaring over v0.4.2 lambdas/calls:
//
//   x |> f        ≡  f(x)              (pipeline: splice left as the 1st arg)
//   x |> f(a)     ≡  f(x, a)
//   a >> b        ≡  (x) => b(a(x))    (compose two one-argument functions)
//   f(a, _)       ≡  (b) => f(a, b)    (partial application; `_` is a hole)
//
// `|>` has the loosest precedence (left-associative); `>>` is operand-typed
// (D24) — two function values compose, two integers shift.

#test(4)[8]
fun double(n: int) -> int { return n * 2 }

#test(4)[5]
fun inc(n: int) -> int { return n + 1 }

#test(2, 3)[5]
fun add(a: int, b: int) -> int { return a + b }

#test(2, 3)[6]
fun mul(a: int, b: int) -> int { return a * b }

// A generic higher-order helper (generic functions can't carry a `#test`; it is
// covered through the tested wrappers below).
fun map_list<T>(xs: [T], f: (T) -> T) -> [T] {
    var out: [T] = []
    for x in xs {
        push(out, f(x))
    }
    return out
}

#test(5)[11]
#test(0)[1]
fun piped(n: int) -> int {
    return n |> double |> inc           // inc(double(n))
}

#test(5)[8]
fun piped_with_args(n: int) -> int {
    return n |> add(3)                  // add(n, 3) — left value is the 1st arg
}

#test(10)[21]
fun composed(n: int) -> int {
    let f = double >> inc               // (x) => inc(double(x))
    return f(n)
}

#test(3)[14]
fun composed_chain(n: int) -> int {
    let f = double >> inc >> double     // double(inc(double(n)))
    return f(n)
}

#test(10)[15]
fun partial_first(n: int) -> int {
    let add5 = add(5, _)                // (b) => add(5, b)
    return add5(n)
}

#test(40)[42]
fun partial_second(n: int) -> int {
    let plus2 = add(_, 2)               // (a) => add(a, 2)
    return plus2(n)
}

#test(4)[18]
fun sum_pipeline(n: int) -> int {
    var xs: [int] = []
    push(xs, n)
    push(xs, n + 1)
    let doubled = map_list(xs, mul(2, _))   // (x) => mul(2, x)
    var total = 0
    for v in doubled {
        total = total + v
    }
    return total                            // (n + (n+1)) * 2
}

fun main() {
    print(piped(5))             // 11
    print(piped_with_args(5))   // 8
    print(composed(10))         // 21
    print(composed_chain(3))    // 14
    print(partial_first(10))    // 15
    print(partial_second(40))   // 42
    print(sum_pipeline(4))      // 18

    // Pipelines flow free functions left-to-right — the case method chaining
    // can't express (there is no receiver).
    let r = 3 |> double |> add(4) |> inc    // inc(add(double(3), 4)) = 11
    print(r)                    // 11

    // A composed function value, stored and reused.
    let process = inc >> double             // (x) => double(inc(x))
    print(process(5))           // 12
    print(process(9))           // 20
}
