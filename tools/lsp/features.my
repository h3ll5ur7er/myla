// features.my: identifiers under the cursor, their occurrences, hover text
// and the completion context (MYLA-80), by name as src/myla/lsp/lookup.py,
// hover.py and completion.py do: no scopes or types yet. Lexing the buffer
// with the compiler's lexer means comments, strings and keywords never match.

from ...selfhost.lexer import lex
from ...selfhost.tokens import Token, TokenKind
from .symbols import Symbol, SymKind, Range
from .text import lines_of, to_lsp, code_points, Pos

// A range in a file.
pub struct Location { path: str, range: Range }

fun token_range(lines: [str], t: Token) -> Range {
    return Range { start: to_lsp(lines, t.line, t.column), end: to_lsp(lines, t.line, t.column + code_points(t.lexeme)) }
}

// Whether `source` lexes.
pub fun lexes(source: str) -> bool {
    return match lex(source) {
        Ok(t) => true,
        Err(d) => false,
    }
}

// The identifier covering the 0-based UTF-16 position, if any.
pub fun identifier_at(source: str, line: int32, character: int32) -> Option<str> {
    let toks = match lex(source) {
        Ok(t) => t,
        Err(d) => { return None },
    }
    let lines = lines_of(source)
    for t in toks {
        if t.kind == TokenKind.IDENT && t.line - 1 == line {
            let r = token_range(lines, t)
            if r.start.character <= character && character <= r.end.character { return Some(t.lexeme) }
        }
    }
    return None
}

// The range of every identifier token `name`.
pub fun identifier_ranges(source: str, name: str) -> [Range] {
    var out: [Range] = []
    let toks = match lex(source) {
        Ok(t) => t,
        Err(d) => { return out },
    }
    let lines = lines_of(source)
    for t in toks {
        if t.kind == TokenKind.IDENT && t.lexeme == name { push(out, token_range(lines, t)) }
    }
    return out
}

// The ranges of the identifiers among `toks` (of a text with `lines`), by name.
pub fun index_identifiers(lines: [str], toks: [Token]) -> [str: [Range]] {
    var out: [str: [Range]] = [:]
    for t in toks {
        if t.kind == TokenKind.IDENT {
            if !contains(out, t.lexeme) {
                var empty: [Range] = []
                out[t.lexeme] = empty
            }
            push(out[t.lexeme], token_range(lines, t))
        }
    }
    return out
}

// A declaration as hover shows it.
#test("get", SymKind.Function, "fun get() -> int")["fun get() -> int"]
#test("x", SymKind.Field, "int")["x: int"]
#test("B", SymKind.EnumMember, "(int)")["B(int)"]
pub fun render(name: str, kind: SymKind, detail: str) -> str {
    return match kind {
        SymKind.Function => detail,
        SymKind.Method => detail,
        SymKind.Struct => "struct " + name,
        SymKind.Enum => "enum " + name,
        SymKind.Interface => "trait " + name,
        SymKind.Impl => "impl " + name,
        SymKind.EnumMember => name + detail,
        SymKind.Field => name + ": " + detail,
        SymKind.Constant => "const " + name + ": " + detail,
        SymKind.TypeAlias => "typealias " + name + " = " + detail,
    }
}

// The index of the code point at the 0-based UTF-16 offset `character` of
// `cps` (inside a surrogate pair: the code point it belongs to), clamped.
#test("ab", 1)[1]
#test("a😀b", 2)[1]
#test("a😀b", 3)[2]
#test("ab", 9)[2]
pub fun from_lsp_character(text: str, character: int32) -> int32 {
    let cps = chars(text)
    var units = 0
    var i = 0
    while i < len(cps) {
        if (cps[i] as uint32) > 65535u32 { units = units + 2 } else { units = units + 1 }
        if units > character { return i }
        i = i + 1
    }
    return len(cps)
}

fun is_word(c: char) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// Whether the cursor is in a member name: after a `.` and word characters.
#test("p.x", 0, 3)[true]
#test("p.", 0, 2)[true]
#test("p x", 0, 3)[false]
pub fun is_member_access(source: str, line: int32, character: int32) -> bool {
    let lines = lines_of(source)
    if line < 0 || line >= len(lines) { return false }
    let cps = chars(lines[line])
    var i = from_lsp_character(lines[line], character)
    while i > 0 && is_word(cps[i - 1]) { i = i - 1 }
    return i > 0 && cps[i - 1] == '.'
}

// The reserved words and built-in type names completion offers.
pub fun completion_keywords() -> [str] {
    return ["fun", "struct", "enum", "trait", "impl", "typealias", "const",
            "import", "from", "as", "pub", "let", "var", "return", "if", "else",
            "match", "while", "for", "in", "break", "continue", "self", "true", "false",
            "bool", "str", "char", "int", "int8", "int16", "int32", "int64",
            "uint8", "uint16", "uint32", "uint64", "float", "float32", "float64"]
}
