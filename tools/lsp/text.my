// text.my: positions and URIs for the language server (MYLA-80).
//
// The compiler counts lines and columns from 1, a column in code points; LSP
// counts from 0, a character in UTF-16 code units (a code point above U+FFFF
// is two).

from ...selfhost.util import is_ident_continue
from ...selfhost.stdroot import EMBEDDED_ROOT

// The lines of `text`, split at "\n", "\r\n" and "\r" (without them).
#test("a\nb\nc")[["a", "b", "c"]]
#test("a\n")[["a"]]
#test("")[[]]
#test("a\r\nb\rc")[["a", "b", "c"]]
pub fun lines_of(text: str) -> [str] {
    var out: [str] = []
    var start = 0
    var i = 0
    while i < text.len() {
        let c = text[i]
        if c == '\n' || c == 13u8 {
            out.push(part(text, start, i))
            if c == 13u8 && i + 1 < text.len() && text[i + 1] == '\n' { i = i + 1 }
            start = i + 1
        }
        i = i + 1
    }
    if start < text.len() { out.push(part(text, start, text.len())) }
    return out
}

// The bytes of `s` from `start` up to `end`.
pub fun part(s: str, start: int32, end: int32) -> str {
    var sb = StringBuilder()
    sb.append(s, start, end)
    return sb.build()
}

// The UTF-16 length of the first `n` code points of `line`.
#test("a😀b", 2)[3]
#test("é", 5)[1]
pub fun utf16_units(line: str, n: int32) -> int32 {
    var units = 0
    var seen = 0
    var i = 0
    while i < line.len() && seen < n {
        let c = line[i]
        if c < 128u8 || c >= 192u8 {           // the first byte of a code point
            seen = seen + 1
            if c >= 240u8 { units = units + 2 } else { units = units + 1 }
        }
        i = i + 1
    }
    // past the end of the line (a caret after it): one unit per code point
    return units
}

// The number of code points of `line`.
pub fun code_points(line: str) -> int32 {
    var n = 0
    for b in 0..line.len() {
        let c = line[b]
        if c < 128u8 || c >= 192u8 { n = n + 1 }
    }
    return n
}

// A 0-based UTF-16 (line, character) for the compiler's 1-based (line, col),
// clamped to the document; the start of the document when it's empty.
pub struct Pos { line: int32, character: int32 }

pub fun to_lsp(lines: [str], line: int32, col: int32) -> Pos {
    if lines.len() == 0 { return Pos { line: 0, character: 0 } }
    var l = line - 1
    if l < 0 { l = 0 }
    if l > lines.len() - 1 { l = lines.len() - 1 }
    let text = lines[l]
    var c = col - 1
    if c < 0 { c = 0 }
    let n = code_points(text)
    if c > n { c = n }
    return Pos { line: l, character: utf16_units(text, c) }
}

// The lines of a text and which of them are ASCII, for converting many
// positions: on an ASCII line a column is the character.
pub struct LineIndex { lines: [str], ascii: [bool] }

pub fun line_index(text: str) -> LineIndex {
    let lines = lines_of(text)
    var ascii: [bool] = []
    for l in lines {
        var plain = true
        for b in 0..l.len() {
            if l[b] >= 128u8 { plain = false }
        }
        ascii.push(plain)
    }
    return LineIndex { lines: lines, ascii: ascii }
}

impl LineIndex {
    // to_lsp(self.lines, line, col)
    fun pos(self, line: int32, col: int32) -> Pos {
        let l = line - 1
        if l >= 0 && l < self.lines.len() && self.ascii[l] && col >= 1 && col - 1 <= self.lines[l].len() {
            return Pos { line: l, character: col - 1 }
        }
        return to_lsp(self.lines, line, col)
    }
}

// LineIndex.pos agrees with to_lsp, on ASCII and other lines and out of range.
#test()[true]
fun line_index_agrees() -> bool {
    let text = "ab\na😀b\n"
    let ix = line_index(text)
    let lines = lines_of(text)
    for line in 0..5 {
        for col in 0..6 {
            let a = ix.pos(line, col)
            let b = to_lsp(lines, line, col)
            if a.line != b.line || a.character != b.character { return false }
        }
    }
    return true
}

// The 1-based column just past the identifier or number starting at `col`
// (a squiggle as wide as the word), or col + 1.
#test("  return x", 3)[9]
#test("a + b", 2)[3]
#test("ab", 5)[6]
#test("let größe = 1", 5)[10]
pub fun word_end(line: str, col: int32) -> int32 {
    let cps = line.chars()
    var i = col - 1
    if i < 0 { i = 0 }
    if i >= cps.len() || !is_word(cps[i]) { return col + 1 }
    while i < cps.len() && is_word(cps[i]) { i = i + 1 }
    return i + 1
}

// A character of an identifier (or a number), as the compiler's lexer has it.
pub fun is_word(c: char) -> bool {
    return is_ident_continue(c as int32)
}

// --- URIs -----------------------------------------------------------------------

// The path of a `file://` URI, percent-decoded; for a `myla-std:` URI, the
// path of an embedded standard library file (`<myla>/std/io.my`, MYLA-243);
// "" for another scheme.
#test("file:///tmp/a%20b/c.my")["/tmp/a b/c.my"]
#test("myla-std:/std/io.my")["<myla>/std/io.my"]
#test("untitled:1")[""]
pub fun uri_path(uri: str) -> str {
    var prefix = "file://"
    var sb = StringBuilder()
    if uri.len() > STD_SCHEME.len() && part(uri, 0, STD_SCHEME.len()) == STD_SCHEME {
        prefix = STD_SCHEME
        sb.append(EMBEDDED_ROOT)
    }
    if uri.len() < prefix.len() || part(uri, 0, prefix.len()) != prefix { return "" }
    var i = prefix.len()
    while i < uri.len() {
        let c = uri[i]
        if c == '%' && i + 2 < uri.len() && hex(uri[i + 1]) >= 0 && hex(uri[i + 2]) >= 0 {
            sb.append_byte((hex(uri[i + 1]) * 16 + hex(uri[i + 2])) as uint8)
            i = i + 3
        } else {
            sb.append_byte(c)
            i = i + 1
        }
    }
    return sb.build()
}

fun hex(c: uint8) -> int32 {
    if c >= '0' && c <= '9' { return (c - '0') as int32 }
    if c >= 'a' && c <= 'f' { return (c - 'a') as int32 + 10 }
    if c >= 'A' && c <= 'F' { return (c - 'A') as int32 + 10 }
    return -1
}

const HEX_DIGITS: str = "0123456789ABCDEF"

// The scheme of the embedded standard library's documents: `myla-std:/std/io.my`
// is `<myla>/std/io.my` (MYLA-243), whose text an editor asks the server for
// (`myla/stdSource`).
pub const STD_SCHEME: str = "myla-std:"

// The `file://` URI of an absolute path, percent-encoding all but letters,
// digits, "-._~" and "/" (as Python's urllib.parse.quote does); a `myla-std:`
// one for a file of the embedded standard library.
#test("/tmp/a b/é.my")["file:///tmp/a%20b/%C3%A9.my"]
#test("<myla>/std/io.my")["myla-std:/std/io.my"]
pub fun path_uri(path: str) -> str {
    var sb = StringBuilder()
    var start = 0
    let root = EMBEDDED_ROOT + "/"
    if path.len() > root.len() && part(path, 0, root.len()) == root {
        sb.append(STD_SCHEME)
        start = EMBEDDED_ROOT.len()
    } else {
        sb.append("file://")
    }
    for i in start..path.len() {
        let c = path[i]
        let alnum = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
        if alnum || c == '-' || c == '.' || c == '_' || c == '~' || c == '/' {
            sb.append_byte(c)
        } else {
            sb.append_byte('%')
            sb.append_byte(HEX_DIGITS[(c >> 4u8) as int32])
            sb.append_byte(HEX_DIGITS[(c & 15u8) as int32])
        }
    }
    return sb.build()
}
