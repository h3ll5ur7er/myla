// main.my: the Myla language server (MYLA-80), speaking the language server
// protocol over stdin and stdout.
//
//   lsp [--stdlib <dir>]
//
// The standard library is found next to the build/ directory the binary is
// in, as for build/myla, unless --stdlib names it.

from std.process import args, exit
from ...selfhost.loader import default_stdlib_root
from .server import new_server

fun main() {
    let argv = args()
    var stdlib = default_stdlib_root(argv[0])
    var i = 1
    while i < len(argv) {
        if argv[i] == "--stdlib" && i + 1 < len(argv) {
            stdlib = argv[i + 1]
            i = i + 1
        }
        i = i + 1
    }
    var server = new_server(stdlib)
    exit(server.run())
}
