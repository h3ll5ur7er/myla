// main.my: the Myla language server (MYLA-80), speaking the language server
// protocol over stdin and stdout.
//
//   lsp [--stdlib <dir>]
//   lsp [--stdlib <dir>] --resolve <file>...
//
// The standard library is the one the binary carries, as for build/myla,
// unless --stdlib or MYLA_STDLIB name a directory (MYLA-243). --resolve
// prints what each identifier of the files refers to (see resolve.my) instead
// of serving; a file inside a project is resolved with its packages
// (projects.my).

from std.process import args, exit
from std.fs import read_to_string
from std.io import eprintln
from std.rt import heap_huge_pages
from ...selfhost.loader import normalize
from ...selfhost.stdroot import default_stdlib_root
from .server import new_server
from .resolve import resolve, describe
from .projects import context_of

fun main() {
    // huge pages for the heap: each check touches megabytes of it (MYLA-608)
    heap_huge_pages()
    let argv = args()
    var stdlib = default_stdlib_root()
    var files: [str] = []
    var resolving = false
    var i = 1
    while i < argv.len() {
        if argv[i] == "--stdlib" && i + 1 < argv.len() {
            stdlib = argv[i + 1]
            i = i + 1
        } else if argv[i] == "--resolve" {
            resolving = true
        } else if resolving {
            files.push(argv[i])
        }
        i = i + 1
    }
    if resolving {
        var status = 0
        for f in files {
            let path = normalize(f)
            match read_to_string(path) {
                Ok(text) => {
                    print(f"file {path}")
                    for line in describe(resolve(path, text, context_of(path, stdlib, [:]).opts, [:])) { print(line) }
                },
                Err(e) => {
                    eprintln(f"cannot read {path}")
                    status = 1
                },
            }
        }
        exit(status)
    }
    var server = new_server(stdlib)
    exit(server.run())
}
