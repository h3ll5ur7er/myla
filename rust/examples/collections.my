// Lists and maps with arbitrary (struct/tuple) keys — no scalar-key limit.

struct Point { x: int, y: int }

fun main() {
    var xs = [1, 2, 3]
    xs.push(4)
    var sum = 0
    for x in xs { sum = sum + x }
    print(sum)

    // tuple keys
    var grid = [(0, 0): "origin"]
    grid[(1, 2)] = "somewhere"
    print(grid[(1, 2)])
    print(grid.contains((0, 0)))

    // struct keys
    var labels = [:]
    labels[Point { x: 1, y: 1 }] = "diagonal"
    print(labels[Point { x: 1, y: 1 }])
}
