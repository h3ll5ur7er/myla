// Floats are first-class in both backends (fixes the original's codegen gap).

#test(3.0, 4.0)[5.0]
fun hypot(a: float, b: float) -> float {
    return sqrt_approx(a * a + b * b)
}

// Newton's method square root (no stdlib dependency needed).
fun sqrt_approx(x: float) -> float {
    var guess = x
    var i = 0
    while i < 30 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

fun main() {
    print(hypot(3.0, 4.0))
    print(1.0 / 3.0)
    print(2.5 as int)
}
