// Rich I/O: file write/read/append, process spawning, args, env.

fun main() {
    let path = "/tmp/myla_io_demo.txt"
    match write_file(path, "line one\n") {
        Ok(_) => print("wrote file"),
        Err(e) => print(e),
    }
    let _ = append_file(path, "line two\n")
    match read_file(path) {
        Ok(contents) => print(contents),
        Err(e) => print(e),
    }
    let _ = remove_file(path)

    // run a subprocess and capture its stdout
    match run("echo", ["hello", "subprocess"]) {
        Ok(out) => print(out),
        Err(e) => print(e),
    }
}
