{
  "name": "tree-sitter-myla",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Myla, generated from grammar/myla.ebnf (editor tooling)",
  "private": true,
  "keywords": [
    "tree-sitter",
    "parser",
    "myla"
  ],
  "license": "MIT",
  "devDependencies": {
    "tree-sitter-cli": "0.25.10"
  },
  "scripts": {
    "generate": "tree-sitter generate --abi 14",
    "test": "cd ../.. && python3 -m unittest tests.burn.test_grammar",
    "ts": "tree-sitter",
    "build": "tree-sitter build --wasm"
  },
  "tree-sitter": [
    {
      "scope": "source.myla",
      "file-types": [
        "my"
      ],
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ]
}
