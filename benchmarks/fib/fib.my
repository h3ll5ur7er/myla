// Benchmark (MYLA-242): the naive recursive Fibonacci number, two calls per
// level, so the time goes into calls and integer arithmetic.
//
//   fib [n]        prints fib(n)

from std.process import args
from std.num import parse_int

#test(0)[0]
#test(10)[55]
fun fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// The size given as the first argument, or `fallback`.
fun size(fallback: int) -> int {
    let argv = args()
    if argv.len() < 2 {
        return fallback
    }
    return match parse_int(argv[1]) {
        Some(v) => v as int,
        None => fallback,
    }
}

fun main() {
    print(fib(size(32)))
}
