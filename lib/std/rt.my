// std.rt — the runtime written in Myla (MYLA-162, D117).
//
// A native build loads this module with every program (the copy the tools
// carry when a standard library folder lacks it); a function here is
// compiled where the code generator calls it in place of the assembly
// routine it replaced (`myla_runtime_function` in selfhost/lower.my). The
// routines move here one by one; until a routine's assembly callers move
// too, both versions exist.
//
// Raw memory goes through the primitives `__load8`, `__load64`, `__store8`,
// `__store64`, `__alloc`, `__free`, `__addr_of`, `__str_of`, `__rotl`, and the bulk
// copy and comparison `__copy_bytes` and `__equal_bytes`, which each backend
// does natively; addresses are `int64`. A string's cell holds its length
// (8 bytes), then its bytes. What it needs from the operating system goes
// through the platform layer, `std.platform` (`os.`); `__set_io_errno`
// records the errno `std.io` reports and `__environ()` gives the
// environment.

import .platform as os
// format specs (D139): the code generator calls std.fmt's functions, which
// every program carries this way
import .fmt as fmt
// slices (D142): the code generator calls std.slice's functions
import .slice as slice

// `a + b` (`__str_concat`): a new cell holding both strings' bytes.
pub fun str_concat(a: str, b: str) -> str {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    let na = __load64(pa)
    let nb = __load64(pb)
    let p = __alloc(na + nb + 8)
    __store64(p, na + nb)
    __copy_bytes(p + 8, pa + 8, na)
    __copy_bytes(p + 8 + na, pb + 8, nb)
    return __str_of(p)
}

// An f-string's pieces joined three or four at a time (MYLA-252): a new
// cell holding their bytes, made once.
pub fun str_concat3(a: str, b: str, c: str) -> str {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    let pc = __addr_of(c)
    let na = __load64(pa)
    let nb = __load64(pb)
    let nc = __load64(pc)
    let p = __alloc(na + nb + nc + 8)
    __store64(p, na + nb + nc)
    __copy_bytes(p + 8, pa + 8, na)
    __copy_bytes(p + 8 + na, pb + 8, nb)
    __copy_bytes(p + 8 + na + nb, pc + 8, nc)
    return __str_of(p)
}

pub fun str_concat4(a: str, b: str, c: str, d: str) -> str {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    let pc = __addr_of(c)
    let pd = __addr_of(d)
    let na = __load64(pa)
    let nb = __load64(pb)
    let nc = __load64(pc)
    let nd = __load64(pd)
    let p = __alloc(na + nb + nc + nd + 8)
    __store64(p, na + nb + nc + nd)
    __copy_bytes(p + 8, pa + 8, na)
    __copy_bytes(p + 8 + na, pb + 8, nb)
    __copy_bytes(p + 8 + na + nb, pc + 8, nc)
    __copy_bytes(p + 8 + na + nb + nc, pd + 8, nd)
    return __str_of(p)
}

// `a == b` (`__str_eq`): the same cell, or equal lengths and bytes.
pub fun str_eq(a: str, b: str) -> bool {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    if pa == pb {
        return true
    }
    let n = __load64(pa)
    if n != __load64(pb) {
        return false
    }
    return __equal_bytes(pa + 8, pb + 8, n)
}

// --- files and directories (the platform's, `std.platform`) ----------------
//
// Each sets the errno `std.io` reports: 0, or the failed call's.

// The errno of `r`, a result of the platform's (0 when it is none).
fun record(r: int64) {
    if r < 0 {
        __set_io_errno(-r)
    } else {
        __set_io_errno(0)
    }
}

// `__stat`: the mode of what `path` names (the type bits and permissions),
// or -1.
pub fun stat(path: str) -> int {
    let r = os.mode_of(path)
    record(r)
    if r < 0 {
        return -1
    }
    return r as int
}

// `__mkdir`: a directory with the permissions `mode`.
pub fun mkdir(path: str, mode: int) {
    record(os.make_dir(path, mode as int64))
}

pub fun unlink(path: str) {
    record(os.remove_file(path))
}

pub fun rmdir(path: str) {
    record(os.remove_dir(path))
}

pub fun rename(from_path: str, to_path: str) {
    record(os.rename(from_path, to_path))
}

// `__getcwd`: the working directory, or "" with the errno (ENOENT for a
// removed directory, ERANGE for one longer than 4 KB).
pub fun getcwd() -> str {
    let buf = __alloc(4096)
    let r = os.cwd(buf, 4096)
    record(r)
    var n: int64 = 0
    if r > 0 {
        n = r
    }
    let p = __alloc(n + 8)
    __store64(p, n)
    __copy_bytes(p + 8, buf, n)
    __free(buf)
    return __str_of(p)
}

// `__read_file`: the bytes of the file at `path`, or "" with the errno. A
// file that reports no size (/proc, a pipe) is read into a cell that doubles
// until the end.
pub fun read_file(path: str) -> str {
    __set_io_errno(0)
    let fd = os.open_read(path)
    if fd < 0 {
        __set_io_errno(-fd)
        return ""
    }
    var cap = os.file_size(fd)
    let grows = cap == 0
    if grows {
        cap = 4096
    }
    var cell = __alloc(cap + 8)
    var n: int64 = 0
    while true {
        if n == cap {
            if !grows {
                break
            }
            let bigger = __alloc(cap + cap + 8)
            __copy_bytes(bigger + 8, cell + 8, n)
            __free(cell)
            cell = bigger
            cap = cap + cap
        }
        let r = os.read(fd, cell + 8 + n, cap - n)
        if r < 0 {
            __set_io_errno(-r)
            break
        }
        if r == 0 {
            break
        }
        n = n + r
    }
    __store64(cell, n)
    os.close(fd)
    return __str_of(cell)
}

// `__write_file`: `contents` as the whole file at `path` (created with the
// permissions 0644), the errno recorded.
pub fun write_file(path: str, contents: str) {
    __set_io_errno(0)
    let fd = os.open_write(path)
    if fd < 0 {
        __set_io_errno(-fd)
        return
    }
    let c = __addr_of(contents)
    let n = __load64(c)
    var done: int64 = 0
    while done < n {
        let r = os.write(fd, c + 8 + done, n - done)
        if r < 0 {
            __set_io_errno(-r)
            break
        }
        done = done + r
    }
    os.close(fd)
}

// `__list_dir`: the name of every entry of the directory at `path`, each
// followed by a NUL byte, in the file system's order ("." and ".." included),
// or "" with the errno.
pub fun list_dir(path: str) -> str {
    __set_io_errno(0)
    let fd = os.open_dir(path)
    if fd < 0 {
        __set_io_errno(-fd)
        return ""
    }
    let records = __alloc(4096)
    var cap: int64 = 4088
    var cell = __alloc(cap + 8)
    var n: int64 = 0
    while true {
        let got = os.dir_read(fd, records, 4096)
        if got == os.EINTR {
            continue
        }
        if got < 0 {
            __set_io_errno(-got)
            n = 0
            break
        }
        if got == 0 {
            break
        }
        var at: int64 = 0
        while at < got {
            let name = os.dir_entry_name(records + at)
            var len: int64 = 0
            while __load8(name + len) != 0u8 {
                len += 1
            }
            if n + len + 1 > cap {
                var bigger_cap = cap + cap
                while n + len + 1 > bigger_cap {
                    bigger_cap += bigger_cap
                }
                let bigger = __alloc(bigger_cap + 8)
                __copy_bytes(bigger + 8, cell + 8, n)
                __free(cell)
                cell = bigger
                cap = bigger_cap
            }
            __copy_bytes(cell + 8 + n, name, len + 1)
            n += len + 1
            at += os.dir_entry_size(records + at)
        }
    }
    __free(records)
    __store64(cell, n)
    os.close(fd)
    return __str_of(cell)
}

// --- the environment ---------------------------------------------------------

// `__getenv`: the value of the first `name=value` entry of the environment
// the process started with, or "" with the errno ENOENT.
pub fun getenv(name: str) -> str {
    __set_io_errno(0)
    let np = __addr_of(name)
    let n = __load64(np)
    var entry = __environ()
    while true {
        let e = __load64(entry)
        if e == 0 {
            break
        }
        if __equal_bytes(e, np + 8, n) && __load8(e + n) == 61u8 {  // '='
            let v = e + n + 1
            var len: int64 = 0
            while __load8(v + len) != 0u8 {
                len += 1
            }
            let p = __alloc(len + 8)
            __store64(p, len)
            __copy_bytes(p + 8, v, len)
            return __str_of(p)
        }
        entry += 8
    }
    __set_io_errno(2)
    return ""
}

// --- processes ---------------------------------------------------------------

const LOW32: int64 = 4294967295i64

// `__run`: runs `program` (its path, not searched for) with the argument
// vector `argv` and the environment the process started with, reads its
// stdout and stderr as they come, and waits for it (the platform's). Gives
// what it wrote to stdout; `__run_stderr`, `__run_exit_code`, `__run_signal`
// (a signal that ended it, exit code -1) and `__run_errno` (the errno of a
// failed spawn) give the rest.
pub fun run(program: str, argv: [str]) -> [uint8] {
    return os.run(program, argv)
}

// `__spawn`, `__reap`, `__kill`, `__close`: a child started and not waited
// for, then waited for, signalled, its descriptors closed (D124,
// `std.process.run_async`; the platform's).
pub fun spawn(program: str, argv: [str]) -> [int] {
    return os.spawn(program, argv)
}

pub fun reap(pid: int) -> int {
    return os.reap(pid as int64) as int
}

pub fun kill(pid: int, sig: int) {
    os.kill(pid as int64, sig as int64)
}

pub fun close(fd: int) {
    if fd >= 0 {
        os.close(fd as int64)
    }
}

// --- standard input ----------------------------------------------------------

// `__read`: what one read of at most `n` bytes of `fd` gives (retried on
// EINTR): empty at the end of the input, for `n <= 0`, or with the errno.
pub fun read(fd: int, n: int) -> str {
    __set_io_errno(0)
    var want = n as int64
    if want < 0 {
        want = 0
    }
    let cell = __alloc(want + 8)
    var got: int64 = 0
    if want > 0 {
        got = os.read(fd as int64, cell + 8, want)
        while got == os.EINTR {
            got = os.read(fd as int64, cell + 8, want)
        }
        if got < 0 {
            __set_io_errno(-got)
            got = 0
        }
    }
    __store64(cell, got)
    return __str_of(cell)
}

// `__poll`: 1 when a read of `fd` won't block (input, its end, or an error),
// 0 when `timeout_ms` (negative: none) ran out, -1 with the errno when poll
// failed; retried on EINTR.
pub fun poll(fd: int, timeout_ms: int) -> int {
    __set_io_errno(0)
    var r = os.poll_read(fd as int64, timeout_ms as int64)
    while r == os.EINTR {
        r = os.poll_read(fd as int64, timeout_ms as int64)
    }
    if r < 0 {
        __set_io_errno(-r)
        return -1
    }
    return r as int
}

// --- the program's arguments -------------------------------------------------

// `__args`: the program's arguments, its own path first.
pub fun args() -> [str] {
    var out: [str] = []
    var at = __argv()
    while true {
        let c = __load64(at)
        if c == 0 {
            break
        }
        var len: int64 = 0
        while __load8(c + len) != 0u8 {
            len += 1
        }
        let p = __alloc(len + 8)
        __store64(p, len)
        __copy_bytes(p + 8, c, len)
        out.push(__str_of(p))
        at += 8
    }
    return out
}

// --- numbers as text ---------------------------------------------------------

// How many decimal digits `u` has.
fun digit_count(u: uint64) -> int64 {
    var n: int64 = 1
    var p: uint64 = 10
    while n < 20 && u >= p {
        n += 1
        p *= 10
    }
    return n
}

// `u`'s `n` digits written to `at`, the last first.
fun put_digits(u0: uint64, at: int64, n: int64) {
    var u = u0
    var i = n - 1
    while i >= 0 {
        let q = u / 10  // one division a digit: the remainder from the quotient
        __store8(at + i, ((u - q * 10) as uint8) + 48u8)
        u = q
        i -= 1
    }
}

// `__uint_to_str`: an unsigned integer in decimal.
pub fun uint_to_str(u: uint64) -> str {
    let n = digit_count(u)
    let p = __alloc(n + 8)
    __store64(p, n)
    put_digits(u, p + 8, n)
    return __str_of(p)
}

// `__bool_to_str`: `true` or `false`.
pub fun bool_to_str(b: bool) -> str {
    if b {
        return "true"
    }
    return "false"
}

// `__char_to_str`: a character as the string of its UTF-8 bytes.
pub fun char_to_str(c: char) -> str {
    let u = c as int64
    if u < 128 {
        let p = __alloc(9)
        __store64(p, 1)
        __store8(p + 8, u as uint8)
        return __str_of(p)
    }
    if u < 2048 {
        let p = __alloc(10)
        __store64(p, 2)
        __store8(p + 8, (192 | (u >> 6)) as uint8)
        __store8(p + 9, (128 | (u & 63)) as uint8)
        return __str_of(p)
    }
    if u < 65536 {
        let p = __alloc(11)
        __store64(p, 3)
        __store8(p + 8, (224 | (u >> 12)) as uint8)
        __store8(p + 9, (128 | ((u >> 6) & 63)) as uint8)
        __store8(p + 10, (128 | (u & 63)) as uint8)
        return __str_of(p)
    }
    let p = __alloc(12)
    __store64(p, 4)
    __store8(p + 8, (240 | ((u >> 18) & 7)) as uint8)
    __store8(p + 9, (128 | ((u >> 12) & 63)) as uint8)
    __store8(p + 10, (128 | ((u >> 6) & 63)) as uint8)
    __store8(p + 11, (128 | (u & 63)) as uint8)
    return __str_of(p)
}

// `__int_to_str`: a signed integer in decimal, a `-` before a negative one.
pub fun int_to_str(v: int64) -> str {
    if v >= 0 {
        return uint_to_str(v as uint64)
    }
    let u = 0u64 - (v as uint64)
    let n = digit_count(u)
    let p = __alloc(n + 9)
    __store64(p, n + 1)
    __store8(p + 8, 45u8)  // '-'
    put_digits(u, p + 9, n)
    return __str_of(p)
}

// --- lists -------------------------------------------------------------------
//
// A list's cell holds its length, its capacity (8 bytes each), then its
// elements, each as wide as its type keeps it (D120: a `char` 4 bytes).

// The scalar the UTF-8 sequence led by the byte at `p + i` encodes (of `n`
// bytes in all), with its length above bit 32: `cp | len << 32`; U+FFFD and
// 1 for a byte that isn't part of a well-formed sequence (an overlong form,
// a surrogate, beyond U+10FFFF, cut short). Out of `str_chars`' loop, which
// keeps its few values in registers so.
fun decode_at(p: int64, i: int64, n: int64) -> int64 {
    let b = __load8(p + i) as int64
    // the sequence's length, its payload bits, and the least scalar of that
    // length (a smaller one is overlong)
    var need: int64 = 0
    var cp: int64 = 0
    var least: int64 = 0
    if b >= 0xC2 && b < 0xE0 {
        need = 2
        cp = b & 0x1F
        least = 0x80
    } else if b >= 0xE0 && b < 0xF0 {
        need = 3
        cp = b & 0x0F
        least = 0x800
    } else if b >= 0xF0 && b < 0xF5 {
        need = 4
        cp = b & 0x07
        least = 0x10000
    }
    if need == 0 || i + need > n {
        return 0xFFFD | (1i64 << 32)
    }
    var k: int64 = 1
    while k < need {
        let c = __load8(p + i + k) as int64
        if (c & 0xC0) != 0x80 {
            return 0xFFFD | (1i64 << 32)
        }
        cp = (cp << 6) | (c & 0x3F)
        k += 1
    }
    if cp < least || cp > 0x10FFFF || (cp & -2048) == 0xD800 {
        return 0xFFFD | (1i64 << 32)
    }
    return cp | (need << 32)
}

// `__str_chars` (`s.chars()`): the code points of `s`, U+FFFD for each byte
// that isn't part of a well-formed UTF-8 sequence.
pub fun str_chars(s: str) -> [char] {
    let p = __addr_of(s) + 8
    let n = __load64(p - 8)
    let cell = __alloc(n * 4 + 16)
    var at = cell + 16
    var i: int64 = 0
    while i < n {
        let b = __load8(p + i)
        if b < 128u8 {
            __store32(at, b as uint32)
            i += 1
        } else {
            let r = decode_at(p, i, n)
            __store32(at, (r & LOW32) as uint32)
            i += r >> 32
        }
        at += 4
    }
    __store64(cell, (at - cell - 16) >> 2)
    __store64(cell + 8, n)
    return __list_of(cell)
}

// --- maps --------------------------------------------------------------------
//
// A map's cell holds its count and its capacity (a power of two), then the
// slots `[state:8][key:8][value][rank:8]`, `slot_size` bytes each: state 0
// empty, 1 full, 2 a removed key's tombstone; a key is a value, or a string's
// cell (`is_str` 1). The slot of a key is found by its hash and linear
// probing.

const PHI: int64 = -7046029254386353131  // 2^64 / the golden ratio

// The hash of a string's cell: its length and its bytes, eight at a time,
// mixed in with a multiply by 2^64/phi and a rotation, the high half folded
// into the low one, which picks the slot. A value's hash is the value
// multiplied by 2^64/phi, folded the same way. The assembly's `__map_hash`
// computes the same, which the other map routines still use.
fun str_hash(key: int64) -> int64 {
    var n = __load64(key)
    var p = key + 8
    var h = n * PHI
    while n >= 8 {
        h = (h ^ __load64(p)) * PHI
        h = __rotl(h, 29)
        p += 8
        n -= 8
    }
    while n > 0 {
        h = (h ^ (__load8(p) as int64)) * PHI
        p += 1
        n -= 1
    }
    h = h * PHI
    return h ^ (((h as uint64) >> 32) as int64)
}

// `__map_lookup`: the slot holding `key` in the map `cell`, or 0. A value's
// probe loop makes no call, so its values stay in registers.
pub fun map_lookup(cell: int64, key: int64, slot_size: int64, is_str: int64) -> int64 {
    let mask = __load64(cell + 8) - 1
    let slots = cell + 16
    if is_str == 0 {
        let h = key * PHI
        var i = (h ^ (((h as uint64) >> 32) as int64)) & mask
        while true {
            let slot = slots + i * slot_size
            let state = __load64(slot)
            if state == 0 {
                return 0
            }
            if state != 2 && __load64(slot + 8) == key {
                return slot
            }
            i = (i + 1) & mask
        }
    }
    var i = str_hash(key) & mask
    let n = __load64(key)
    while true {
        let slot = slots + i * slot_size
        let state = __load64(slot)
        if state == 0 {
            return 0
        }
        if state != 2 {
            let k = __load64(slot + 8)
            if k == key || (__load64(k) == n && __equal_bytes(k + 8, key + 8, n)) {
                return slot
            }
        }
        i = (i + 1) & mask
    }
    return 0
}

// `n` bytes at `p` zeroed.
fun zero_bytes(p: int64, n: int64) {
    var at = p
    var left = n
    while left >= 8 {
        __store64(at, 0)
        at += 8
        left -= 8
    }
    while left > 0 {
        __store8(at, 0u8)
        at += 1
        left -= 1
    }
}

// `__map_new`: an empty map of `cap` slots of `slot_size` bytes.
pub fun map_new(cap: int64, slot_size: int64) -> int64 {
    let cell = __alloc(cap * slot_size + 16)
    __store64(cell, 0)
    __store64(cell + 8, cap)
    zero_bytes(cell + 16, cap * slot_size)
    return cell
}

// The slot of `key` in the map `cell` (which has room), found or made: its
// address, plus 1 when the key was there (its value is then replaced; slots
// are 8-byte aligned). A new key takes the first tombstone on its way, else
// the empty slot it ends at, ranked last, with a reference to a string key.
fun map_set_slot(cell: int64, key: int64, slot_size: int64, is_str: int64) -> int64 {
    let mask = __load64(cell + 8) - 1
    let slots = cell + 16
    var i: int64 = 0
    var n: int64 = 0
    if is_str == 0 {
        let h = key * PHI
        i = (h ^ (((h as uint64) >> 32) as int64)) & mask
    } else {
        i = str_hash(key) & mask
        n = __load64(key)
    }
    var tomb: int64 = 0
    while true {
        let slot = slots + i * slot_size
        let state = __load64(slot)
        if state == 0 {
            var at = slot
            if tomb != 0 {
                at = tomb
            }
            let count = __load64(cell)
            __store64(at, 1)
            __store64(at + 8, key)
            __store64(at + slot_size - 8, count)
            __store64(cell, count + 1)
            if is_str != 0 {
                __store64(key - 8, __load64(key - 8) + 1)
            }
            return at
        }
        if state == 1 {
            let k = __load64(slot + 8)
            if k == key || (is_str != 0 && __load64(k) == n && __equal_bytes(k + 8, key + 8, n)) {
                return slot + 1
            }
        } else if tomb == 0 {
            tomb = slot
        }
        i = (i + 1) & mask
    }
    return 0
}

// `m[key] = v`'s slot (`__map_reserve` and `__map_set_slot` in one): room
// made in the map at `holder` (grown when empty or 3/4 full, the new cell
// stored back), then `key`'s slot as `map_set_slot` gives it.
pub fun map_put_slot(holder: int64, key: int64, slot_size: int64, is_str: int64) -> int64 {
    var cell = __load64(holder)
    let cap = __load64(cell + 8)
    if cap == 0 || (__load64(cell) + 1) * 4 >= cap * 3 {
        var bigger: int64 = 8
        if cap != 0 {
            bigger = cap * 2
        }
        cell = map_rehash(cell, slot_size, is_str, bigger, -1)
        __store64(holder, cell)
    }
    return map_set_slot(cell, key, slot_size, is_str)
}

// The keys and values of the map `cell` moved into a new one of `cap` slots
// (in their order: the ranks copied, those after a key just removed, of rank
// `removed`, one up), the old cell freed.
fun map_rehash(cell: int64, slot_size: int64, is_str: int64, cap: int64, removed: int64) -> int64 {
    let fresh = map_new(cap, slot_size)
    var slot = cell + 16
    let end = slot + __load64(cell + 8) * slot_size
    while slot < end {
        if __load64(slot) == 1 {
            let k = __load64(slot + 8)
            let at = map_set_slot(fresh, k, slot_size, is_str)
            if is_str != 0 {
                // the key moved: the new cell's reference is the old one's
                __store64(k - 8, __load64(k - 8) - 1)
            }
            __copy_bytes(at + 16, slot + 16, slot_size - 16)
            let rank = at + slot_size - 8
            if (__load64(rank) as uint64) > (removed as uint64) {
                __store64(rank, __load64(rank) - 1)
            }
        }
        slot += slot_size
    }
    __free(cell)
    return fresh
}

// `__map_rebuild`: the map `cell` after `remove` made a tombstone, rebuilt at
// its capacity without tombstones (so a probe always ends at an empty slot),
// the keys ranked after the removed one's `rank` moved up (D105).
pub fun map_rebuild(cell: int64, slot_size: int64, rank: int64, is_str: int64) -> int64 {
    return map_rehash(cell, slot_size, is_str, __load64(cell + 8), rank)
}

// `keys(m)` (`__map_keys`): a new list of the keys of the map `cell` in the
// order they were inserted (each at its rank), as wide as the list's
// elements are (`stride` bytes), with a reference to each string key.
pub fun map_keys(cell: int64, slot_size: int64, stride: int64, is_str: int64) -> int64 {
    let count = __load64(cell)
    let list = __alloc(count * stride + 16)
    __store64(list, count)
    __store64(list + 8, count)
    let cap = __load64(cell + 8)
    var slot = cell + 16
    let end = slot + cap * slot_size
    while slot < end {
        if __load64(slot) == 1 {
            let k = __load64(slot + 8)
            if is_str != 0 {
                let rc = k - 8
                __store64(rc, __load64(rc) + 1)
            }
            let at = list + 16 + __load64(slot + slot_size - 8) * stride
            if stride == 8 {
                __store64(at, k)
            } else if stride == 4 {
                __store32(at, k as uint32)
            } else if stride == 2 {
                __store8(at, k as uint8)
                __store8(at + 1, (k >> 8) as uint8)
            } else {
                __store8(at, k as uint8)
            }
        }
        slot += slot_size
    }
    return list
}

// --- string builders ---------------------------------------------------------
//
// A builder's cell holds its length and its capacity in bytes, then its
// bytes; a builder variable holds its cell, unique when appended to.

// `append(sb, s)`: `s`'s bytes after the builder's (the builder at the
// address `holder`). The fast paths call nothing, so their values stay in
// registers; a full builder is the business of a tail call.
pub fun sb_append(holder: int64, s: str) {
    let src = __addr_of(s)
    let count = __load64(src)
    let cell = __load64(holder)
    let len = __load64(cell)
    let need = len + count
    if need > __load64(cell + 8) {
        sb_append_grown(holder, cell, src + 8, count)
        return
    }
    __store64(cell, need)
    __copy_bytes(cell + 16 + len, src + 8, count)
}

// `append_byte(sb, b)`: one byte after the builder's.
pub fun sb_append_byte(holder: int64, b: uint8) {
    let cell = __load64(holder)
    let len = __load64(cell)
    if len >= __load64(cell + 8) {
        sb_byte_grown(holder, cell, b)
        return
    }
    __store8(cell + 16 + len, b)
    __store64(cell, len + 1)
}

// `__sb_append_bytes`: the `count` bytes at `src` after the builder's (a
// range of a string).
pub fun sb_append_bytes(holder: int64, src: int64, count: int64) {
    let cell = __load64(holder)
    let len = __load64(cell)
    let need = len + count
    if need > __load64(cell + 8) {
        sb_append_grown(holder, cell, src, count)
        return
    }
    __store64(cell, need)
    __copy_bytes(cell + 16 + len, src, count)
}

// The appends to a full builder: the `count` bytes at `src`, or the byte `b`.
fun sb_append_grown(holder: int64, cell: int64, src: int64, count: int64) {
    let len = __load64(cell)
    let bigger = sb_bigger(holder, cell, len + count)
    __copy_bytes(bigger + 16 + len, src, count)
    __store64(bigger, len + count)
}

fun sb_byte_grown(holder: int64, cell: int64, b: uint8) {
    let len = __load64(cell)
    let bigger = sb_bigger(holder, cell, len + 1)
    __store8(bigger + 16 + len, b)
    __store64(bigger, len + 1)
}

// The full builder `cell` at the address `holder` replaced by one twice as
// large (or as large as `need`), so building a long text piece by piece
// stays linear: its bytes copied, the old cell freed, the new one returned.
fun sb_bigger(holder: int64, cell: int64, need: int64) -> int64 {
    let len = __load64(cell)
    var cap = __load64(cell + 8) * 2
    if cap < need {
        cap = need
    }
    let bigger = __alloc(cap + 16)
    __store64(bigger, len)
    __store64(bigger + 8, cap)
    __copy_bytes(bigger + 16, cell + 16, len)
    __free(cell)
    __store64(holder, bigger)
    return bigger
}

// --- printing ----------------------------------------------------------------


// `print(s)` (`__print_str`) and `print` of the other scalars but floats.
pub fun print_str(s: str) {
    let c = __addr_of(s)
    os.write_line(c + 8, __load64(c))
}

pub fun print_int(v: int64) {
    print_str(int_to_str(v))
}

pub fun print_uint(v: uint64) {
    print_str(uint_to_str(v))
}

pub fun print_bool(b: bool) {
    if b {
        print_str("true")
    } else {
        print_str("false")
    }
}

pub fun print_char(c: char) {
    print_str(format("{}", c))
}

// `__write(fd, s)`: `s`'s bytes to the file descriptor `fd`.
pub fun write(fd: int, s: str) {
    let c = __addr_of(s)
    os.write_all(fd as int64, c + 8, __load64(c))
}

// --- runtime errors ------------------------------------------------------------

// `__panic`'s report (a trap, `panic`, a failed `assert`; MYLA-17, MYLA-65):
// `runtime error: <msg>` on stderr (`msg` a string's cell), with a position
// record `pos` (a file name's cell, then the line and the column as 32-bit
// numbers) `  --> file:line:col` after it, then the process ends with 1.
// It allocates nothing: a heap that ran out reports through it too.
pub fun panic_report(msg: int64, pos: int64) {
    report_error(msg, pos)
    os.exit(1)
}

// `panic_report` with tasks: the end waits for the other workers (D97).
pub fun panic_report_tasks(msg: int64, pos: int64) {
    report_error(msg, pos)
    failed_wait()
    os.exit(1)
}

fun report_error(msg: int64, pos: int64) {
    write_err(__addr_of("runtime error: "))
    write_err(msg)
    if pos != 0 {
        write_err(__addr_of("\n  --> "))
        write_err(__load64(pos))
        write_err_num(__load32(pos + 8) as int64)
        write_err_num(__load32(pos + 12) as int64)
    }
    write_err(__addr_of("\n"))
}

// The string whose cell is at `cell` on stderr.
fun write_err(cell: int64) {
    os.write_all(2, cell + 8, __load64(cell))
}

// `:` and `n` in decimal on stderr (its digits in `__panic_buf`).
fun write_err_num(n: int64) {
    let end = __rt_addr("__panic_buf") + 32
    var at = end
    var v = n
    while true {
        at -= 1
        __store8(at, (48 + v % 10) as uint8)
        v = v / 10
        if v == 0 {
            break
        }
    }
    at -= 1
    __store8(at, 58u8)  // ':'
    os.write_all(2, at, end - at)
}

// --- the allocator -----------------------------------------------------------
//
// A cell is `[size:8][count:8]` and then what the program sees, the size a
// multiple of 8 up to 4 KB and a power of two above. A freed cell goes on
// the list for its size (its first word the next cell): the small sizes'
// heads at `__free_buckets + size`, the large ones' at `+ 4104 + 8k` for
// 2^k bytes. A new one comes off that list, else from the arena between
// `__heap_ptr` and `__heap_end`: a chunk of CHUNK bytes the platform maps
// when the last one is full (none before the first cell, D106 (B)); a cell
// bigger than a chunk gets a mapping of its own. So a program holds about
// as much address space as it uses.

const CHUNK: int64 = 16777216  // 16 MiB, a power of two

// `__alloc`: a cell of at least `n` bytes, its count 1.
pub fun alloc(n: int64) -> int64 {
    var size = (n + 7) & -8
    var slot = __rt_addr("__free_buckets") + size
    if size > 4096 {
        let k = __bsr64(size - 1) + 1
        size = 1i64 << k
        slot = __rt_addr("__free_buckets") + 4104 + k * 8
    }
    let p = __load64(slot)
    if p != 0 {
        __store64(slot, __load64(p))
        __store64(p - 8, 1)
        return p
    }
    let at = __rt_get("__heap_ptr")
    let next = at + 16 + size
    if next <= __rt_get("__heap_end") {
        __store64(__rt_addr("__heap_ptr"), next)
        __store64(at, size)
        __store64(at + 8, 1)
        return at + 16
    }
    return alloc_mapped(size)
}

// A cell of `size` bytes when the arena is full: mapped on its own when it
// is bigger than a chunk, else the first of a new chunk, which becomes the
// arena (the rest of the old one stays unused).
fun alloc_mapped(size: int64) -> int64 {
    if size + 16 > CHUNK {
        let m = os.map_memory(size + 16)
        if m < 0 {
            __trap_oom()
        }
        __store64(m, size)
        __store64(m + 8, 1)
        return m + 16
    }
    let m = os.map_memory(CHUNK)
    if m < 0 {
        __trap_oom()
    }
    __store64(__rt_addr("__heap_ptr"), m + 16 + size)
    __store64(__rt_addr("__heap_end"), m + CHUNK)
    __store64(m, size)
    __store64(m + 8, 1)
    return m + 16
}

// `__free`: the cell `p` back on the list for its size.
pub fun free(p: int64) {
    let size = __load64(p - 16)
    var slot = __rt_addr("__free_buckets") + size
    if size > 4096 {
        slot = __rt_addr("__free_buckets") + 4104 + __bsr64(size) * 8
    }
    __store64(p, __load64(slot))
    __store64(slot, p)
}

// With tasks (D92): each worker allocates from chunks of its own, with its
// own lists; a cell freed on another worker goes on its owner's
// `__remote_free` list, which the owner takes back whole before it bumps its
// arena. Many push onto a list, one takes all of it: no lock, and no ABA. A
// worker's chunk is aligned to its size and its first word is the worker's
// number, so a cell's owner is the word at its address rounded down to a
// chunk; a cell bigger than a chunk gets an aligned mapping of its own with
// the same word, the cell in its first chunk.

// `__alloc` with tasks.
pub fun alloc_tasks(n: int64) -> int64 {
    var size = (n + 7) & -8
    var slot = __rt_addr("__free_buckets") + size
    if size > 4096 {
        let k = __bsr64(size - 1) + 1
        size = 1i64 << k
        slot = __rt_addr("__free_buckets") + 4104 + k * 8
    }
    let p = __load64(slot)
    if p != 0 {
        __store64(slot, __load64(p))
        __store64(p - 8, 1)
        return p
    }
    if __rt_get("__remote_free") != 0 {
        return alloc_drained(n)
    }
    let at = __rt_get("__heap_ptr")
    let next = at + 16 + size
    if next <= __rt_get("__heap_end") {
        __store64(__rt_addr("__heap_ptr"), next)
        __store64(at, size)
        __store64(at + 8, 1)
        return at + 16
    }
    return alloc_tasks_mapped(size)
}

// `alloc_mapped` with tasks: the chunk (or the big cell's mapping) aligned,
// its first word this worker's number, the cell after it.
fun alloc_tasks_mapped(size: int64) -> int64 {
    var span = CHUNK
    if size + 32 > CHUNK {
        span = (size + 32 + CHUNK - 1) & -CHUNK
    }
    let m = map_aligned(span)
    __store64(m, __rt_get("__worker_id"))
    if span == CHUNK {
        __store64(__rt_addr("__heap_ptr"), m + 32 + size)
        __store64(__rt_addr("__heap_end"), m + CHUNK)
    }
    __store64(m + 16, size)
    __store64(m + 24, 1)
    return m + 32
}

// `span` bytes (a multiple of CHUNK) mapped at an address that is a
// multiple of CHUNK: more mapped, the ends given back.
fun map_aligned(span: int64) -> int64 {
    let m = os.map_memory(span + CHUNK)
    if m < 0 {
        __trap_oom()
    }
    let start = (m + CHUNK - 1) & -CHUNK
    if start > m {
        os.unmap_memory(m, start - m)
    }
    let end = m + span + CHUNK
    if end > start + span {
        os.unmap_memory(start + span, end - start - span)
    }
    return start
}

// The cells other workers freed taken back onto this worker's lists, then
// `alloc_tasks` again.
fun alloc_drained(n: int64) -> int64 {
    var c = __xchg64(__rt_addr("__remote_free"), 0)
    while c != 0 {
        let next = __load64(c)
        free(c)
        c = next
    }
    return alloc_tasks(n)
}

// `__free` with tasks: another worker's cell onto its owner's list.
pub fun free_tasks(p: int64) {
    let owner = __load64(p & -CHUNK)
    if owner != __rt_get("__worker_id") {
        let slot = __rt_waddr("__remote_free", owner)
        while true {
            let head = __load64(slot)
            __store64(p, head)
            if __cas64(slot, head, p) {
                return
            }
        }
    }
    let size = __load64(p - 16)
    var slot = __rt_addr("__free_buckets") + size
    if size > 4096 {
        slot = __rt_addr("__free_buckets") + 4104 + __bsr64(size) * 8
    }
    __store64(p, __load64(slot))
    __store64(slot, p)
}

// --- the executor --------------------------------------------------------------
// What a program with tasks runs on (D92). These run before the workers
// start, and allocate nothing.

const MAX_WORKERS: int64 = 32

// The bytes after `prefix` in the first entry of the environment that starts
// with it, 0 when none does.
fun env_after(prefix: str) -> int64 {
    let pp = __addr_of(prefix)
    let n = __load64(pp)
    var entry = __environ()
    while true {
        let e = __load64(entry)
        if e == 0 {
            return 0
        }
        if __equal_bytes(e, pp + 8, n) {
            return e + n
        }
        entry += 8
    }
    return 0
}

// The number the decimal digits at `p` spell (wrapping), stopping once it is
// past `limit`.
fun digits_at(p: int64, limit: int64) -> int64 {
    var n: int64 = 0
    var q = p
    while true {
        let d = (__load8(q) as int64) - 48
        if d < 0 || d > 9 || n > limit {
            return n
        }
        n = n * 10 + d
        q += 1
    }
    return n
}

// The order ready frames run in, from MYLA_SCHED (D110, MYLA-231): `fifo`
// (1), `seed:N` (2, the generator seeded with N); anything else keeps the
// default, the newest first (0).
pub fun sched_init() {
    let v = env_after("MYLA_SCHED=")
    if v == 0 {
        return
    }
    let word = __load32(v)
    if word == 1868982630u32 && __load8(v + 4) == 0u8 {  // "fifo"
        __store64(__rt_addr("__exec_sched"), 1)
    } else if word == 1684366707u32 && __load8(v + 4) == 58u8 {  // "seed:"
        __store64(__rt_addr("__exec_rng"), digits_at(v + 5, 9223372036854775807))
        __store64(__rt_addr("__exec_sched"), 2)
    }
}

// How many workers run the tasks: MYLA_THREADS when the environment has it,
// else the CPUs this process may run on; at least 1, at most MAX_WORKERS.
pub fun workers_count() -> int64 {
    var n: int64 = 0
    let v = env_after("MYLA_THREADS=")
    if v != 0 {
        n = digits_at(v, 100000)
    } else {
        n = os.cpus_allowed()
    }
    if n == 0 {
        return 1
    }
    if n > MAX_WORKERS {
        return MAX_WORKERS
    }
    return n
}

// A task's first frame keeps its flags in word 48 (2: asked to stop, D96) and
// its parent task in word 56.

// `__task_cancel`: the child task whose first frame is `fr` asked to stop;
// none (0: joined already) is left alone. Its sleepers and readers (and its
// children's) go on at once (D124). Under the timers' lock, which a task
// takes to look at its flags before it waits (`timer_add`, `wait_fds`), so
// none starts waiting unseen after this (MYLA-163: a cancel between a
// sleeper's look and its timer let it sleep its whole time).
pub fun task_cancel(fr: int64) {
    if fr == 0 {
        return
    }
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    cancel_locked(fr)
    give_lock(lock)
}

// `__task_cancelled`: 1 when the running task or a task above it was asked to
// stop, else 0.
pub fun task_cancelled() -> int64 {
    var t = __rt_get("__exec_task")
    while t != 0 {
        if (__load64(t + 48) & 2) != 0 {
            return 1
        }
        t = __load64(t + 56)
    }
    return 0
}

// `__failed_wait`: once a task has failed (D97), until no other worker runs
// a frame; at once otherwise.
pub fun failed_wait() {
    if __rt_get("__exec_failing") != 0 {
        wait_stopped()
    }
}

// `__wait_stopped`: until no other worker runs a frame, each worker's
// current one looked at again from the first once one does.
pub fun wait_stopped() {
    let me = __rt_get("__worker_id")
    var w: int64 = 0
    while w < __rt_get("__exec_workers") {
        if w != me && __load64(__rt_waddr("__exec_cur", w)) != 0 {
            __pause()
            w = 0
        } else {
            w += 1
        }
    }
}

// --- the executor's queues -------------------------------------------------------
// Each worker has a queue of ready frames (D92, MYLA-140): a ring of its own
// (EXEC_CAP frames, at `__wq_rings` + its index * 8 MiB) and a record
// `[lock][head][tail]` (a cache line of `__wq`; the counters run either way,
// the ring's index is the counter masked). A worker pushes onto its own
// queue's tail and takes its newest frame (depth first: a task's children
// before its siblings'), else steals the oldest frame of the next queue that
// has one (the biggest piece of a tree of tasks); a frame yielding a turn goes
// to the oldest end, behind the others (D110: depth-first, with one worker the
// order of the self-hosted interpreter). MYLA_SCHED changes it (`sched_init`):
// `fifo` (1) takes the oldest (a yield goes to the newest end); `seed:N` (2)
// queues each push at the end a generator seeded with N picks (a yield still
// behind the others). `__exec_seq` counts the pushes, the word sleeping
// workers wait on (futex); `__exec_sleepers` counts those asleep.
//
// Nothing here allocates, and the lock is never held across a trap.

const EXEC_CAP: int64 = 1048576
const SCHED_MUL: int64 = 6364136223846793005
const SCHED_ADD: int64 = 1442695040888963407

// The record of worker `w`'s queue.
fun wq_of(w: int64) -> int64 {
    return __rt_addr("__wq") + (w << 6)
}

// Take the spin lock in the word at `p` (a queue's or an actor's record):
// an exchange, so nothing after it is seen before it (MYLA-267).
fun take_lock(p: int64) {
    while __xchg64(p, 1) != 0 {
        __pause()
    }
}

// Give the lock at `p` back: a release store, so everything written while
// it was held is seen by whoever takes it next. A plain store would do on
// x86-64, but aarch64 may make it visible before them (MYLA-267).
fun give_lock(p: int64) {
    __store_rel64(p, 0)
}

// Worker `w`'s ring (its slot for the counter `n`: `+ ((n & (EXEC_CAP - 1))
// << 3)`).
fun ring_of(w: int64) -> int64 {
    return __rt_get("__wq_rings") + (w << 23)
}

// After a push: a worker that went to sleep before it saw the queue empty
// after counting itself a sleeper, so the count is read after the push.
fun exec_pushed() {
    __fetch_add64(__rt_addr("__exec_seq"), 1)
    if __rt_get("__exec_sleepers") != 0 {
        os.unpark_one(__rt_addr("__exec_seq"))
    }
    if __rt_get("__exec_polling") != 0 {
        os.poller_wake(__rt_get("__exec_poller"))
    }
}

// `__exec_push`: the frame `fr` onto the running worker's queue, its newest
// end (seed:N: the end the generator's next value picks, its bit 33, as the
// interpreter's `Interp.ready`); a sleeping worker woken.
pub fun exec_push(fr: int64) {
    let w = __rt_get("__worker_id")
    let q = wq_of(w)
    take_lock(q)
    if __rt_get("__exec_sched") == 2 {
        let x = __rt_get("__exec_rng") * SCHED_MUL + SCHED_ADD
        __store64(__rt_addr("__exec_rng"), x)
        if ((x >> 33) & 1) != 0 {
            push_oldest(q, w, fr)
            return
        }
    }
    let tail = __load64(q + 16)
    if tail - __load64(q + 8) >= EXEC_CAP {
        // the ring full: out of memory, the lock given back first
        give_lock(q)
        __trap_oom()
    }
    __store64(ring_of(w) + ((tail & (EXEC_CAP - 1)) << 3), fr)
    __store64(q + 16, tail + 1)
    give_lock(q)
    exec_pushed()
}

// `fr` onto the oldest end of worker `w`'s queue `q`, whose lock is taken.
fun push_oldest(q: int64, w: int64, fr: int64) {
    let head = __load64(q + 8) - 1
    if __load64(q + 16) - head > EXEC_CAP {
        give_lock(q)
        __trap_oom()
    }
    __store64(q + 8, head)
    __store64(ring_of(w) + ((head & (EXEC_CAP - 1)) << 3), fr)
    give_lock(q)
    exec_pushed()
}

// `__exec_yield_push`: the frame `fr` yielding a turn, onto the oldest end of
// the running worker's queue (fifo: the newest, as any push).
pub fun exec_yield_push(fr: int64) {
    if __rt_get("__exec_sched") == 1 {
        exec_push(fr)
        return
    }
    let w = __rt_get("__worker_id")
    let q = wq_of(w)
    take_lock(q)
    push_oldest(q, w, fr)
}

// `__exec_find`: the running worker's newest frame (fifo: its oldest), else
// the oldest frame of the next queue that has one; 0 when none has.
pub fun exec_find() -> int64 {
    let me = __rt_get("__worker_id")
    if __rt_get("__exec_sched") != 1 {
        let q = wq_of(me)
        // a glance first: an empty queue's lock isn't taken
        if __load64(q + 8) != __load64(q + 16) {
            take_lock(q)
            let tail = __load64(q + 16) - 1
            if tail >= __load64(q + 8) {
                __store64(q + 16, tail)
                let fr = __load64(ring_of(me) + ((tail & (EXEC_CAP - 1)) << 3))
                give_lock(q)
                return fr
            }
            give_lock(q)
        }
    }
    return exec_steal(me)
}

// The oldest frame of each queue in turn, starting with worker `me`'s own; 0
// when none has one.
fun exec_steal(me: int64) -> int64 {
    let n = __rt_get("__exec_workers")
    var w = me
    var left = n
    while left > 0 {
        let q = wq_of(w)
        if __load64(q + 8) != __load64(q + 16) {
            take_lock(q)
            let head = __load64(q + 8)
            if head != __load64(q + 16) {
                let fr = __load64(ring_of(w) + ((head & (EXEC_CAP - 1)) << 3))
                __store64(q + 8, head + 1)
                give_lock(q)
                return fr
            }
            give_lock(q)
        }
        w += 1
        if w >= n {
            w = 0
        }
        left -= 1
    }
    return 0
}

// `__exec_peek`: 1 when some queue has a frame (a glance, no lock taken).
pub fun exec_peek() -> int64 {
    let n = __rt_get("__exec_workers")
    var q = __rt_addr("__wq")
    var w: int64 = 0
    while w < n {
        if __load64(q + 8) != __load64(q + 16) {
            return 1
        }
        q += 64
        w += 1
    }
    return 0
}

// --- waiting for a task, actors ----------------------------------------------------
// A frame waiting for a task is linked to the next one through its word 32,
// the first in the task's `task` word (24: 0 running, the first frame waiting
// while it runs, 1 done). An actor's executor (D92) is the record
// `[lock][running][first waiting][last]`; a frame handed the actor keeps it in
// its word 64 until it runs (dropped, it passes it on, D94).

// `myla___wait(child, frame)`, the frame waiting for the child task: the
// frame to go on with at once (the child has ended), else 0 (it joined the
// frames waiting, a parent and siblings, MYLA-148).
pub fun task_wait(child: int64, fr: int64) -> int64 {
    let at = child + 24
    while true {
        // acquire: the child's result, published before its word became 1
        // (`task_end`'s exchange), is read after this (MYLA-267)
        let first = __load_acq64(at)
        if first == 1 {
            return fr
        }
        __store64(fr + 32, first)
        if __cas64(at, first, fr) {
            return 0
        }
    }
    return 0
}

// `__wake_waiters`: each frame of the list from `first` (0: none), which
// waited for a task that has ended, queued; the next one is read before a
// frame is queued, as it may run and change its word 32 at once.
pub fun wake_waiters(first: int64) {
    var fr = first
    while fr != 0 {
        let next = __load64(fr + 32)
        exec_push(fr)
        fr = next
    }
}

// `myla___actor_enter(record, frame)`: the frame going on holding the actor
// when it is free (returned), else 0, the frame queued (the worker returns to
// the executor). Busy with no frame queued, on more than one worker, it first
// waits a little for the holder to leave (MYLA-150): an actor's methods are
// mostly short, and a frame queued is handed the actor and keeps it until a
// worker resumes it, so every caller after it queues too (a convoy). No one
// waits before it, so the order stays first come, first served.
pub fun actor_enter(rec: int64, fr: int64) -> int64 {
    var spins: int64 = 0
    if __rt_get("__exec_workers") > 1 {
        spins = 1000
    }
    while true {
        take_lock(rec)
        if __load64(rec + 8) == 0 {
            __store64(rec + 8, 1)
            give_lock(rec)
            return fr
        }
        if __load64(rec + 16) == 0 && spins != 0 {
            give_lock(rec)
            while spins != 0 && __load64(rec + 8) != 0 {
                __pause()
                spins -= 1
            }
        } else {
            __store64(fr + 32, 0)
            let last = __load64(rec + 24)
            if last != 0 {
                __store64(last + 32, fr)
            } else {
                __store64(rec + 16, fr)
            }
            __store64(rec + 24, fr)
            give_lock(rec)
            return 0
        }
    }
    return 0
}

// `__actor_leave`: out of the actor whose record is `rec`; the first frame
// waiting is handed it and queued to run, or the actor is free.
pub fun actor_leave(rec: int64) {
    take_lock(rec)
    let fr = __load64(rec + 16)
    if fr == 0 {
        __store64(rec + 8, 0)
        give_lock(rec)
        return
    }
    let next = __load64(fr + 32)
    __store64(rec + 16, next)
    if next == 0 {
        __store64(rec + 24, 0)
    }
    __store64(fr + 64, rec)
    give_lock(rec)
    exec_push(fr)
}

// --- the executor's loop -------------------------------------------------------------


// `__exec_run`'s loop: a worker resuming ready frames for good. The platform
// enters it with the worker's stack recorded (`__exec_sp`), and a worker
// whose task failed (D97, `__task_fail`) comes back to its start on that
// stack: it keeps nothing from one frame to the next.
pub fun exec_run() {
    var turns: int64 = 0
    while true {
        if __rt_get("__timer_count") != 0 {
            timers_fire()
        }
        // descriptors watched: a glance at the poller now and then, for
        // workers too busy to poll (D124)
        if __rt_get("__watch_count") != 0 {
            turns += 1
            if (turns & 63) == 0 {
                exec_glance()
            }
        }
        let fr = exec_find()
        if fr == 0 {
            exec_idle()
        } else {
            // the frame this worker runs, published before the failure flag
            // is looked at (an exchange: a full barrier; `__task_fail` sets
            // the flag, then looks at what the workers run)
            __xchg64(__rt_addr("__exec_cur"), fr)
            if __rt_get("__exec_failing") != 0 {
                // once a task has failed, every frame is dropped, not
                // resumed, an actor handed to it passed on (D94, D97)
                let held = __xchg64(fr + 64, 0)
                if held != 0 {
                    actor_leave(held)
                }
            } else {
                __store64(fr + 64, 0)
                // the running task's first frame, for `task_cancelled`:
                // until control comes back, frames of this task run, but the
                // one resumed may end and be freed meanwhile
                __store64(__rt_addr("__exec_task"), __load64(fr + 40))
                __run_frame(fr)
            }
            __xchg64(__rt_addr("__exec_cur"), 0)
        }
    }
}

// No frame found: this worker counts itself idle and only glances at the
// queues (it stops counting before it takes a frame, so the count is
// exact), a while spinning, then asleep until a push. Every worker idle and
// nothing queued: no task can go on, a runtime error.
fun exec_idle() {
    __fetch_add64(__rt_addr("__exec_idle"), 1)
    if exec_peek() == 0 {
        if exec_all_waiting() {
            exec_stuck()
        }
        var spins: int64 = 4000
        while spins != 0 && exec_peek() == 0 {
            __pause()
            spins -= 1
        }
        if spins == 0 && (__rt_get("__timer_count") != 0 || __rt_get("__watch_count") != 0) && __xchg64(__rt_addr("__exec_polling"), 1) == 0 {
            // tasks asleep: this worker polls (one at a time, D124) until the
            // nearest deadline or a push (`exec_pushed` wakes it), then fires
            // the timers that passed; a last glance after claiming the poll
            exec_poll()
            spins = 1
        }
        if spins == 0 {
            // asleep: counted a sleeper first, then the pushes seen, then a
            // last glance (a push after it changes `__exec_seq`, whose low
            // half the wait compares, and the wait returns at once)
            __fetch_add64(__rt_addr("__exec_sleepers"), 1)
            let seen = __load32(__rt_addr("__exec_seq")) as int64
            if exec_peek() == 0 {
                os.park(__rt_addr("__exec_seq"), seen)
            }
            __fetch_add64(__rt_addr("__exec_sleepers"), -1)
        }
    }
    // leaving: counted before this worker can take a frame (exec_find), so
    // a check that began while it was idle sees it left
    __fetch_add64(__rt_addr("__exec_gen"), 1)
    __fetch_add64(__rt_addr("__exec_idle"), -1)
}

// Whether no task can go on: every worker idle for the whole check (no one
// left `exec_idle` meanwhile: `__exec_gen` unchanged), and then no timer,
// no watched descriptor, no frame being taken off them (`__exec_waking`)
// and nothing queued, read in that order. While every worker is idle, a
// frame moves only from the timers or the watches to a queue, counted in
// `__exec_waking` all the way, so these reads can't miss it; a worker that
// takes a frame off a queue or runs one has left `exec_idle` (MYLA-275:
// without the generation, a worker that left and took the last queued
// frame after the idle count was read looked like no one). Each read is a
// read-modify-write, ordered on every processor; the check is rare.
fun exec_all_waiting() -> bool {
    let gen = __fetch_add64(__rt_addr("__exec_gen"), 0)
    if __fetch_add64(__rt_addr("__exec_idle"), 0) < __rt_get("__exec_workers") {
        return false
    }
    if __fetch_add64(__rt_addr("__timer_count"), 0) != 0 || __fetch_add64(__rt_addr("__watch_count"), 0) != 0 {
        return false
    }
    if __fetch_add64(__rt_addr("__exec_waking"), 0) != 0 || exec_peek() != 0 {
        return false
    }
    return __fetch_add64(__rt_addr("__exec_gen"), 0) == gen
}

// --- time: the clock, sleeping, the timers (D124) --------------------------------

// `__clock_ns`: the monotonic clock in nanoseconds.
pub fun clock_ns() -> int64 {
    return os.clock_ns()
}

// `__sleep_ns`: the thread asleep for `n` nanoseconds (`await __sleep(ms)`
// in a program without tasks, the interpreter's sleeping tasks).
pub fun sleep_ns(n: int64) {
    if n > 0 {
        os.sleep_ns(n)
    }
}

// The timers: the frames asleep and the deadlines of tasks (`timeout`), in
// a heap ordered by their time and, for one time, by the order they were
// set. The heap's cell is `__timers`, `[count][cap]` and then
// `[time][seq][frame][cell]` entries, under `__timer_lock`; `__timer_count`
// is its count, read without the lock to see whether there are any. A
// sleeper's entry holds its frame and no cell; a deadline's holds the
// child task's first frame with its low bit set and the cell its `timeout`
// reads (1 once the deadline fired). A worker that finds no frame while
// there are timers polls (`exec_poll`) instead of parking.

const TIMER: int64 = 32

// `myla___sleep(frame, ms)`: the frame asleep for `ms` milliseconds, on the
// timers (its frame function suspends after this call); no time at all in
// a task already asked to stop (D124).
pub fun sleep_frame(fr: int64, ms: int64) {
    let seq = timer_add(os.clock_ns() + ms * 1000000, fr, 0)
}

// `__cancel_after(child, ms)`: the child task whose first frame is `fr`
// cancelled once `ms` milliseconds passed (D124, `task.timeout`): its flags
// get "has a deadline" (4), so its end takes the deadline off; the cell
// `__disarm` reads, which says whether the deadline fired.
pub fun cancel_after(fr: int64, ms: int64) -> int64 {
    let cell = __alloc(8)
    __store64(cell, 0)
    let at = fr + 48
    while true {
        let flags = __load64(at)
        if __cas64(at, flags, flags | 4) {
            break
        }
    }
    let seq = timer_add(os.clock_ns() + ms * 1000000, fr | 1, cell)
    return cell
}

// `__disarm(cell)`: whether the deadline of `cancel_after` had not fired
// (its task ended first); the cell freed.
pub fun disarm(cell: int64) -> bool {
    let fired = __load64(cell)
    __free(cell)
    return fired == 0
}

// `__task_end(fr)`: the task whose first frame is `fr` ended (not the
// entry's): its deadline, if it has one, taken off the timers (a deadline
// that fired did all it does under their lock, so nothing touches the frame
// after this), then the frames waiting for it go on, its word saying done.
pub fun task_end(fr: int64) {
    if (__load64(fr + 48) & 4) != 0 {
        let lock = __rt_addr("__timer_lock")
        take_lock(lock)
        timers_forget(fr | 1)
        give_lock(lock)
    }
    wake_waiters(__xchg64(fr + 24, 1))
}

// A timer at `at` for `fr` (and `cell`); its order among timers of one time.
// A sleeper (no cell) of a task asked to stop is due at once, its flags read
// under the lock (`task_cancel`).
fun timer_add(at0: int64, fr: int64, cell: int64) -> int64 {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    var at = at0
    if cell == 0 && task_cancelled() != 0 {
        at = 0
    }
    if __rt_get("__exec_poller") == 0 {
        __store64(__rt_addr("__exec_poller"), os.poller_new())
    }
    var c = __rt_get("__timers")
    if c == 0 || __load64(c) == __load64(c + 8) {
        c = timers_grown(c)
    }
    let seq = __rt_get("__timer_seq")
    __store64(__rt_addr("__timer_seq"), seq + 1)
    // sifted up from the end
    var i = __load64(c)
    while i > 0 {
        let parent = (i - 1) / 2
        let pe = c + 16 + parent * TIMER
        if !timer_before(at, seq, __load64(pe), __load64(pe + 8)) {
            break
        }
        __copy_bytes(c + 16 + i * TIMER, pe, TIMER)
        i = parent
    }
    let e = c + 16 + i * TIMER
    __store64(e, at)
    __store64(e + 8, seq)
    __store64(e + 16, fr)
    __store64(e + 24, cell)
    __store64(c, __load64(c) + 1)
    __store64(__rt_addr("__timer_count"), __load64(c))
    give_lock(lock)
    // a worker polling until a later time wakes to wait for this one
    if __rt_get("__exec_polling") != 0 {
        os.poller_wake(__rt_get("__exec_poller"))
    }
    return seq
}

// Whether the timer `(a, sa)` is due before `(b, sb)`.
fun timer_before(a: int64, sa: int64, b: int64, sb: int64) -> bool {
    return a < b || (a == b && sa < sb)
}

// The timers' cell `cell` (0: none yet) moved into one twice as big.
fun timers_grown(cell: int64) -> int64 {
    var cap: int64 = 16
    var n: int64 = 0
    if cell != 0 {
        n = __load64(cell)
        cap = __load64(cell + 8) * 2
    }
    let bigger = __alloc(16 + cap * TIMER)
    __store64(bigger, n)
    __store64(bigger + 8, cap)
    if cell != 0 {
        __copy_bytes(bigger + 16, cell + 16, n * TIMER)
        __free(cell)
    }
    __store64(__rt_addr("__timers"), bigger)
    return bigger
}

// The timers that passed taken off: a sleeper's frame queued on this worker
// so that the earliest runs first (the newest runs first, D110, so they are
// pushed latest first; with MYLA_SCHED=fifo, earliest first); a deadline
// cancels its task, under the lock, and its sleepers' time comes at once.
fun timers_fire() {
    let now = os.clock_ns()
    let lock = __rt_addr("__timer_lock")
    var due: [int64] = []
    __fetch_add64(__rt_addr("__exec_waking"), 1)
    take_lock(lock)
    while true {
        let cell = __rt_get("__timers")
        if cell == 0 || __load64(cell) == 0 || __load64(cell + 16) > now {
            break
        }
        let fr = __load64(cell + 32)
        let rec = __load64(cell + 40)
        timers_pop(cell)
        if (fr & 1) != 0 {
            __store64(rec, 1)
            cancel_locked(fr - 1)
        } else {
            due.push(fr)
        }
    }
    give_lock(lock)
    if __rt_get("__exec_sched") == 1 {
        for fr in due {
            exec_push(fr)
        }
    } else {
        var i = due.len()
        while i > 0 {
            i -= 1
            exec_push(due[i])
        }
    }
    __fetch_add64(__rt_addr("__exec_waking"), -1)
}

// The task whose first frame is `t` asked to stop (its flags' 2), and the
// time of every sleeper of it or a task below it come (D124: a cancelled
// task's sleep ends at once); the timers' lock held.
fun cancel_locked(t: int64) {
    let at = t + 48
    while true {
        let flags = __load64(at)
        if __cas64(at, flags, flags | 2) {
            break
        }
    }
    // waiting for input: no longer watched, queued (its read sees the
    // request)
    let ws = __rt_get("__watches")
    if ws != 0 {
        var k: int64 = 0
        while k < __load64(ws) {
            let wf = __load64(ws + 24 + k * 16)
            if task_below(__load64(wf + 40), t) {
                // every entry of the frame taken (and unwatched), so it is
                // queued once
                let gone = watch_take(wf)
                exec_push(wf)
            } else {
                k += 1
            }
        }
    }
    let cell = __rt_get("__timers")
    if cell == 0 {
        return
    }
    let n = __load64(cell)
    var woke = false
    var i: int64 = 0
    while i < n {
        let e = cell + 16 + i * TIMER
        let fr = __load64(e + 16)
        if (fr & 1) == 0 && task_below(__load64(fr + 40), t) {
            __store64(e, 0)
            woke = true
        }
        i += 1
    }
    if woke {
        timers_heapify(cell)
    }
}

// Whether the task `t` (a first frame) is `top` or a task below it.
fun task_below(t: int64, top: int64) -> bool {
    var x = t
    while x != 0 {
        if x == top {
            return true
        }
        x = __load64(x + 56)
    }
    return false
}

// Every timer for `fr` (a deadline's tagged frame) taken off; the lock held.
fun timers_forget(fr: int64) {
    let cell = __rt_get("__timers")
    if cell == 0 {
        return
    }
    var n = __load64(cell)
    var i: int64 = 0
    var gone = false
    while i < n {
        let e = cell + 16 + i * TIMER
        if __load64(e + 16) == fr {
            n -= 1
            __copy_bytes(e, cell + 16 + n * TIMER, TIMER)
            gone = true
        } else {
            i += 1
        }
    }
    if gone {
        __store64(cell, n)
        __store64(__rt_addr("__timer_count"), n)
        timers_heapify(cell)
    }
}

// The earliest timer of the cell `cell` (not empty) taken off: the last one
// moved to the top and sifted down.
fun timers_pop(cell: int64) {
    let n = __load64(cell) - 1
    __store64(cell, n)
    __store64(__rt_addr("__timer_count"), n)
    if n == 0 {
        return
    }
    __copy_bytes(cell + 16, cell + 16 + n * TIMER, TIMER)
    timer_sift(cell, 0, n)
}

// The heap of the cell `cell` made whole again after times changed.
fun timers_heapify(cell: int64) {
    let n = __load64(cell)
    var i = n / 2
    while i > 0 {
        i -= 1
        timer_sift(cell, i, n)
    }
}

// The timer at `i` sifted down among the `n` of the cell `cell`.
fun timer_sift(cell: int64, i0: int64, n: int64) {
    let tmp = __rt_addr("__timer_tmp")
    var i = i0
    while true {
        var child = 2 * i + 1
        if child >= n {
            return
        }
        let ce = cell + 16 + child * TIMER
        if child + 1 < n {
            let re = ce + TIMER
            if timer_before(__load64(re), __load64(re + 8), __load64(ce), __load64(ce + 8)) {
                child += 1
            }
        }
        let c = cell + 16 + child * TIMER
        let e = cell + 16 + i * TIMER
        if !timer_before(__load64(c), __load64(c + 8), __load64(e), __load64(e + 8)) {
            return
        }
        // swapped through a scratch entry (the lock held: one at a time)
        __copy_bytes(tmp, e, TIMER)
        __copy_bytes(e, c, TIMER)
        __copy_bytes(c, tmp, TIMER)
        i = child
    }
}

// The poll of an idle worker (it holds `__exec_polling`): until the nearest
// deadline, or a push or a new timer wakes it, unless a frame is queued
// already; then the timers that passed fire.
fun exec_poll() {
    if exec_peek() == 0 {
        var timeout: int64 = -1
        let lock = __rt_addr("__timer_lock")
        take_lock(lock)
        let cell = __rt_get("__timers")
        if cell != 0 && __load64(cell) != 0 {
            let left = __load64(cell + 16) - os.clock_ns()
            timeout = 0
            if left > 0 {
                // rounded up: woken before the deadline, it would poll again
                timeout = (left + 999999) / 1000000
            }
        }
        give_lock(lock)
        if timeout != 0 {
            poll_events(os.poller_wait(__rt_get("__exec_poller"), timeout))
        }
    }
    __store_rel64(__rt_addr("__exec_polling"), 0)
    timers_fire()
}

// A busy worker's look at the poller, when no other worker polls: the
// frames whose descriptors became readable queued.
fun exec_glance() {
    if __xchg64(__rt_addr("__exec_polling"), 1) == 0 {
        poll_events(os.poller_wait(__rt_get("__exec_poller"), 0))
        __store_rel64(__rt_addr("__exec_polling"), 0)
    }
}

// The `n` events of the last wait (the poll held): each frame whose
// descriptor became readable queued, unless a cancel took it already.
fun poll_events(n: int64) {
    let lock = __rt_addr("__timer_lock")
    __fetch_add64(__rt_addr("__exec_waking"), 1)
    var i: int64 = 0
    while i < n {
        let fr = os.poller_event(i)
        if fr != 0 {
            take_lock(lock)
            let mine = watch_take(fr)
            give_lock(lock)
            if mine {
                exec_push(fr)
            }
        }
        i += 1
    }
    __fetch_add64(__rt_addr("__exec_waking"), -1)
}

// --- descriptors: frames waiting for input (D124) --------------------------------
// `__watches`: `[count][cap]` and then `[fd][frame]` entries, under the
// timers' lock; `__watch_count` its count.

// `myla___wait_fd(frame, fd)`: the frame waiting until `fd` is readable (its
// input there or ended): watched by the poller, which queues it then (its
// frame function suspends after this call). A task asked to stop waits no
// time, nor for what the poller can't watch (a regular file: always ready).
pub fun wait_fd(fr: int64, fd: int64) {
    wait_fds(fr, fd, -1)
}

// `myla___wait_fd2(frame, a, b)`: the frame waiting until `a` or `b` is
// readable (a child's stdout and stderr, `std.process.run_async`).
pub fun wait_fd2(fr: int64, a: int64, b: int64) {
    wait_fds(fr, a, b)
}

// The frame waiting for `a`, and `b` too unless it is negative: an entry
// for each, so the first event takes both (`watch_take`).
fun wait_fds(fr: int64, a: int64, b: int64) {
    // (its flags read under the lock, `task_cancel`)
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    if task_cancelled() != 0 {
        give_lock(lock)
        exec_push(fr)
        return
    }
    if __rt_get("__exec_poller") == 0 {
        __store64(__rt_addr("__exec_poller"), os.poller_new())
    }
    var ready = !watch_add(a, fr)
    if b >= 0 && !ready {
        ready = !watch_add(b, fr)
    }
    if ready {
        // one the poller can't watch (a regular file): ready now
        let gone = watch_take(fr)
        give_lock(lock)
        exec_push(fr)
        return
    }
    give_lock(lock)
}

// An entry `[fd][frame]` on `__watches`, the descriptor watched; false when
// the poller can't watch it (no entry then). The lock held.
fun watch_add(fd: int64, fr: int64) -> bool {
    var cell = __rt_get("__watches")
    if cell == 0 || __load64(cell) == __load64(cell + 8) {
        var cap: int64 = 8
        var n: int64 = 0
        if cell != 0 {
            n = __load64(cell)
            cap = __load64(cell + 8) * 2
        }
        let bigger = __alloc(16 + cap * 16)
        __store64(bigger, n)
        __store64(bigger + 8, cap)
        if cell != 0 {
            __copy_bytes(bigger + 16, cell + 16, n * 16)
            __free(cell)
        }
        __store64(__rt_addr("__watches"), bigger)
        cell = bigger
    }
    if os.poller_watch(__rt_get("__exec_poller"), fd, fr) < 0 {
        return false
    }
    let n = __load64(cell)
    __store64(cell + 16 + n * 16, fd)
    __store64(cell + 24 + n * 16, fr)
    __store64(cell, n + 1)
    __store64(__rt_addr("__watch_count"), n + 1)
    return true
}

// Whether the frame `fr` was waiting for a descriptor: every entry of it
// taken off and its descriptor no longer watched (the lock held).
fun watch_take(fr: int64) -> bool {
    let cell = __rt_get("__watches")
    if cell == 0 {
        return false
    }
    var n = __load64(cell)
    var found = false
    var i: int64 = 0
    while i < n {
        if __load64(cell + 24 + i * 16) == fr {
            os.poller_forget(__rt_get("__exec_poller"), __load64(cell + 16 + i * 16))
            n -= 1
            __copy_bytes(cell + 16 + i * 16, cell + 16 + n * 16, 16)
            found = true
        } else {
            i += 1
        }
    }
    __store64(cell, n)
    __store64(__rt_addr("__watch_count"), n)
    return found
}

// Every task waits for another one: the program ends.
fun exec_stuck() {
    let msg = __addr_of("runtime error: every task waits for another one\n")
    os.write_all(2, msg + 8, __load64(msg))
    os.exit(1)
}

// --- lists -----------------------------------------------------------------------
// A list's cell is `[len][cap][elements]`.

// `__list_grow`: the full cell `cell` (its length its capacity, the caller
// made it unique) moved into one twice as big (4 elements at first), of
// `stride` bytes an element; the old cell freed.
pub fun list_grow(cell: int64, stride: int64) -> int64 {
    let cap = __load64(cell + 8)
    var bigger: int64 = 4
    if cap != 0 {
        bigger = cap * 2
    }
    let p = __alloc(bigger * stride + 16)
    __copy_bytes(p, cell, cap * stride + 16)
    __store64(p + 8, bigger)
    __free(cell)
    return p
}

// --- deep copies between tasks (D92, MYLA-148) ---------------------------------------
// A value crossing to another task shares no count with the original: the
// per-type deep copies built by the code generator end at these, for the
// cells that own nothing. A cell's size is the word 16 bytes before it, its
// count the word 8 before; a static string's count starts at 2^61 and never
// reaches zero.

// `__deep_str`: the string (or another cell owning nothing) itself when it
// is unshared or static, else a copy, the original's count down (first: it
// stays above zero, and the copy is a tail call).
pub fun deep_str(cell: int64) -> int64 {
    let rc = __load64(cell - 8)
    if rc == 1 || rc >= 2305843009213693952 {
        return cell
    }
    __store64(cell - 8, rc - 1)
    return dclone_cell(cell)
}

// `__dclone_str`: a copy of the string, others holding the original (whose
// count stays); a static one shared.
pub fun dclone_str(cell: int64) -> int64 {
    if __load64(cell - 8) >= 2305843009213693952 {
        return cell
    }
    return dclone_cell(cell)
}

// `__dclone_cell`: a copy of the cell, word for word.
pub fun dclone_cell(cell: int64) -> int64 {
    let size = __load64(cell - 16)
    let copy = __alloc(size)
    __copy_bytes(copy, cell, size)
    return copy
}

// --- floats as text ----------------------------------------------------------------
// A float is printed with `digits` significant digits (17 for a float64, 9
// for a float32), the shortest of them that keep its value, as the
// interpreter prints it: its decimal exponent found among the powers of ten
// (`__pow10_hi`, 10^(i - 323) for i from 0 to 631, `__pow10_lo` the rest of
// each), then its digits as an integer, the float scaled by a power of ten
// with the error of the product kept (Dekker's product), then laid out.
// Each operation is the assembly's it replaces, in its order, so the digits
// are the same bit for bit.

// The float64 of the bits `b`.
fun f64_of(b: uint64) -> float64 {
    return __f64_from_bits(b)
}

// `10^(i - 323)`'s float64, and the rest of it.
fun pow10_hi(i: int64) -> float64 {
    return __f64_from_bits(__load64(__rt_addr("__pow10_hi") + i * 8) as uint64)
}

fun pow10_lo(i: int64) -> float64 {
    return __f64_from_bits(__load64(__rt_addr("__pow10_lo") + i * 8) as uint64)
}

// `a * b` and its rounding error, exactly (Dekker): the operands split in
// halves of 26 bits, scaled first so that neither half overflows.
fun two_prod(a0: float64, b0: float64) -> (float64, float64) {
    var a = a0
    var b = b0
    let big = f64_of(9092767647661031424u64)
    if a > big {
        a = a * f64_of(4318952042648305664u64)
        b = b * f64_of(4895412794951729152u64)
    } else if b > big {
        a = a * f64_of(4895412794951729152u64)
        b = b * f64_of(4318952042648305664u64)
    }
    let split = f64_of(4728779608772575232u64)
    let a2 = a * split
    let ahi = a2 - (a2 - a)
    let alo = a - ahi
    let b2 = b * split
    let bhi = b2 - (b2 - b)
    let blo = b - bhi
    let p = a * b
    var err = ahi * bhi - p
    err = err + ahi * blo
    err = err + alo * bhi
    err = err + alo * blo
    return (p, err)
}

// `x * 10^e`, rounded to an integer, the product's error kept (in two steps
// for an `e` past 308, whose power isn't a float64).
fun fscale(x0: float64, e0: int64) -> int64 {
    var x = x0
    var e = e0
    var carry = 0.0
    if e > 308 {
        let first = two_prod(x, pow10_hi(523))
        carry = first.1 + x * pow10_lo(523)
        x = first.0
        e -= 200
    }
    let i = e + 323
    let prod = two_prod(x, pow10_hi(i))
    var lo = prod.1 + x * pow10_lo(i)
    lo = lo + pow10_hi(i) * carry
    return __f64_round(prod.0) + __f64_round(lo)
}

// A float `%` on a target without an instruction for it (aarch64,
// MYLA-163): the remainder of `x / y` truncated toward zero, exactly, its
// sign `x`'s (C's `fmod`, as x86-64's `fprem` gives it), on the bits of both
// (musl's algorithm: the significands' long division, one bit a step); a NaN
// for a zero or NaN `y` and for an infinite or NaN `x`.
#test(4620130267728707584, 4611686018427387904)[4609434218613702656]
#test(-4618441417868443648, 4607182418800017408)[-4618441417868443648]
#test(118622047889322841, 4906019910204099648)[118622047889322841]
#test(4906019910204099648, 4613937818241073152)[4607182418800017408]
#test(-128383115725867620, 4619848792751996928)[-4604367669032910848]
#test(7, 2)[1]
#test(9110782046170513408, 4591870180066957722)[4591870178993215898]
#test(4607182418800017408, 0)[9221120237041090560]
pub fun fmod(xb: int64, yb: int64) -> int64 {
    var ux = xb as uint64
    var uy = yb as uint64
    var ex = ((ux >> 52u64) & 0x7FFu64) as int64
    var ey = ((uy >> 52u64) & 0x7FFu64) as int64
    let sx = ux & 0x8000000000000000u64
    let ynan = (uy << 1u64) > 0xFFE0000000000000u64
    if (uy << 1u64) == 0u64 || ynan || ex == 2047 { return 0x7FF8000000000000 }
    if (ux << 1u64) <= (uy << 1u64) {
        if (ux << 1u64) == (uy << 1u64) { return sx as int64 }
        return xb
    }
    // the significands with their leading bit, a subnormal's normalized
    if ex == 0 {
        var i = ux << 12u64
        while (i >> 63u64) == 0u64 {
            ex -= 1
            i = i << 1u64
        }
        ux = ux << ((1 - ex) as uint64)
    } else {
        ux = (ux & 0x000FFFFFFFFFFFFFu64) | 0x0010000000000000u64
    }
    if ey == 0 {
        var i = uy << 12u64
        while (i >> 63u64) == 0u64 {
            ey -= 1
            i = i << 1u64
        }
        uy = uy << ((1 - ey) as uint64)
    } else {
        uy = (uy & 0x000FFFFFFFFFFFFFu64) | 0x0010000000000000u64
    }
    while ex > ey {
        let d = ux - uy
        if (d >> 63u64) == 0u64 {
            if d == 0u64 { return sx as int64 }
            ux = d
        }
        ux = ux << 1u64
        ex -= 1
    }
    let d = ux - uy
    if (d >> 63u64) == 0u64 {
        if d == 0u64 { return sx as int64 }
        ux = d
    }
    while (ux >> 52u64) == 0u64 {
        ux = ux << 1u64
        ex -= 1
    }
    if ex > 0 {
        ux = (ux - 0x0010000000000000u64) | ((ex as uint64) << 52u64)
    } else {
        ux = ux >> ((1 - ex) as uint64)
    }
    return (ux | sx) as int64
}

// `__float_to_str`: the float64 of the bits `bits` with `digits` significant
// digits, trailing zeros dropped: plain digits up to its units, then a point
// and the rest, or `0.` and zeros before them for a magnitude below 1.
pub fun float_to_str(bits: int64, digits: int64) -> str {
    let mag = bits & 9223372036854775807
    let inf: int64 = 9218868437227405312
    if mag > inf {
        return "nan"
    }
    if mag == inf {
        if bits < 0 {
            return "-inf"
        }
        return "inf"
    }
    if mag == 0 {
        if bits < 0 {
            return "-0"
        }
        return "0"
    }
    let x = f64_of(mag as uint64)
    // its decimal exponent: the greatest power of ten not above it
    var lo: int64 = 0
    var hi: int64 = 631
    var at: int64 = -1
    while lo <= hi {
        let mid = (lo + hi) >> 1
        if x < pow10_hi(mid) {
            hi = mid - 1
        } else {
            at = mid
            lo = mid + 1
        }
    }
    var m = fscale(x, digits - 1 + 323 - at) as uint64
    var low: uint64 = 1
    var k = digits - 1
    while k > 0 {
        low = low * 10u64
        k -= 1
    }
    if m >= low * 10u64 {
        m = m / 10u64
        at += 1
    }
    if m < low {
        m = low
    }
    var n = digits
    while n > 1 {
        let q = m / 10u64
        if m != q * 10u64 {
            break
        }
        m = q
        n -= 1
    }
    let exp = at - 323
    var sign: int64 = 0
    if bits < 0 {
        sign = 1
    }
    var len: int64 = 0
    var dot: int64 = -1
    var lead: int64 = 0
    if exp >= n - 1 {
        len = sign + exp + 1
    } else if exp >= 0 {
        len = sign + n + 1
        dot = exp + 1
    } else {
        lead = -exp + 1
        len = sign + lead + n
    }
    let p = __alloc(len + 8)
    __store64(p, len)
    var q = p + 8
    if sign == 1 {
        __store8(q, 45u8)  // '-'
        q += 1
    }
    if lead > 0 {
        // `0.` and the zeros after the point
        __store8(q, 48u8)
        __store8(q + 1, 46u8)
        var z: int64 = 2
        while z < lead {
            __store8(q + z, 48u8)
            z += 1
        }
        q += lead
    }
    // the digits, from the last, a point among them
    var i = n - 1
    while i >= 0 {
        var pos = i
        if dot >= 0 && i >= dot {
            pos = i + 1
        }
        let tenth = m / 10u64
        __store8(q + pos, (48u64 + m - tenth * 10u64) as uint8)
        m = tenth
        i -= 1
    }
    if dot >= 0 {
        __store8(q + dot, 46u8)  // '.'
    }
    // the zeros up to the units of a large one
    if exp >= n - 1 {
        var z = n
        while z <= exp {
            __store8(q + z, 48u8)
            z += 1
        }
    }
    return __str_of(p)
}
