// std.rt — the runtime written in Myla (MYLA-162, D117).
//
// A native build loads this module with every program; a function here is
// compiled where the code generator calls it in place of the assembly
// routine it replaces (`myla_runtime_function` in selfhost/lower.my). The
// routines move here one by one; until a routine's assembly callers move
// too, both versions exist.
//
// Raw memory goes through the primitives `__load8`, `__load64`, `__store8`,
// `__store64`, `__alloc`, `__free`, `__addr_of`, `__str_of`, and the bulk
// copy and comparison `__copy_bytes` and `__equal_bytes`, which each backend
// does natively; addresses are `int64`. A string's cell holds its length
// (8 bytes), then its bytes. `__syscall(n, a, b, c)` makes a system call
// (Linux's numbers, for now the only platform), `__set_io_errno` records
// the errno `std.io` reports and `__environ()` gives the environment.

// `a + b` (`__str_concat`): a new cell holding both strings' bytes.
pub fun str_concat(a: str, b: str) -> str {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    let na = __load64(pa)
    let nb = __load64(pb)
    let p = __alloc(na + nb + 8)
    __store64(p, na + nb)
    __copy_bytes(p + 8, pa + 8, na)
    __copy_bytes(p + 8 + na, pb + 8, nb)
    return __str_of(p)
}

// `a == b` (`__str_eq`): the same cell, or equal lengths and bytes.
pub fun str_eq(a: str, b: str) -> bool {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    if pa == pb {
        return true
    }
    let n = __load64(pa)
    if n != __load64(pb) {
        return false
    }
    return __equal_bytes(pa + 8, pb + 8, n)
}

// --- files and directories, on Linux's system calls -------------------------
//
// Each sets the errno `std.io` reports: 0, or the failed call's.

const SYS_STAT: int64 = 4
const SYS_GETCWD: int64 = 79
const SYS_RENAME: int64 = 82
const SYS_MKDIR: int64 = 83
const SYS_RMDIR: int64 = 84
const SYS_UNLINK: int64 = 87

// `path` as the NUL-terminated copy the kernel reads, which the caller frees.
fun c_path(path: str) -> int64 {
    let p = __addr_of(path)
    let n = __load64(p)
    let buf = __alloc(n + 1)
    __copy_bytes(buf, p + 8, n)
    __store8(buf + n, 0u8)
    return buf
}

// A system call on one path, its errno recorded (`__unlink`, `__rmdir`).
fun on_path(nr: int64, path: str, arg: int64) {
    __set_io_errno(0)
    let p = c_path(path)
    let r = __syscall(nr, p, arg, 0)
    if r < 0 {
        __set_io_errno(-r)
    }
    __free(p)
}

// `__stat`: the mode of what `path` names (the type bits and permissions),
// or -1.
pub fun stat(path: str) -> int {
    __set_io_errno(0)
    let p = c_path(path)
    let buf = __alloc(144)
    let r = __syscall(SYS_STAT, p, buf, 0)
    var mode = -1
    if r < 0 {
        __set_io_errno(-r)
    } else {
        mode = (__load64(buf + 24) & 4294967295i64) as int
    }
    __free(buf)
    __free(p)
    return mode
}

// `__mkdir`: a directory with the permissions `mode`.
pub fun mkdir(path: str, mode: int) {
    on_path(SYS_MKDIR, path, mode as int64)
}

pub fun unlink(path: str) {
    on_path(SYS_UNLINK, path, 0)
}

pub fun rmdir(path: str) {
    on_path(SYS_RMDIR, path, 0)
}

pub fun rename(from_path: str, to_path: str) {
    __set_io_errno(0)
    let a = c_path(from_path)
    let b = c_path(to_path)
    let r = __syscall(SYS_RENAME, a, b, 0)
    if r < 0 {
        __set_io_errno(-r)
    }
    __free(b)
    __free(a)
}

// `__getcwd`: the working directory, or "" with the errno (ENOENT for a
// removed directory, ERANGE for one longer than 4 KB).
pub fun getcwd() -> str {
    __set_io_errno(0)
    let buf = __alloc(4096)
    let r = __syscall(SYS_GETCWD, buf, 4096, 0)
    var n: int64 = 0
    if r < 0 {
        __set_io_errno(-r)
    } else {
        n = r - 1
    }
    let p = __alloc(n + 8)
    __store64(p, n)
    __copy_bytes(p + 8, buf, n)
    __free(buf)
    return __str_of(p)
}


const SYS_READ: int64 = 0
const SYS_WRITE: int64 = 1
const SYS_OPEN: int64 = 2
const SYS_CLOSE: int64 = 3
const SYS_FSTAT: int64 = 5

// `__read_file`: the bytes of the file at `path`, or "" with the errno. A
// file that reports no size (/proc, a pipe) is read into a cell that doubles
// until the end.
pub fun read_file(path: str) -> str {
    __set_io_errno(0)
    let p = c_path(path)
    let fd = __syscall(SYS_OPEN, p, 0, 0)
    __free(p)
    if fd < 0 {
        __set_io_errno(-fd)
        return ""
    }
    let st = __alloc(144)
    __syscall(SYS_FSTAT, fd, st, 0)
    var cap = __load64(st + 48)
    __free(st)
    let grows = cap == 0
    if grows {
        cap = 4096
    }
    var cell = __alloc(cap + 8)
    var n: int64 = 0
    while true {
        if n == cap {
            if !grows {
                break
            }
            let bigger = __alloc(cap + cap + 8)
            __copy_bytes(bigger + 8, cell + 8, n)
            __free(cell)
            cell = bigger
            cap = cap + cap
        }
        let r = __syscall(SYS_READ, fd, cell + 8 + n, cap - n)
        if r < 0 {
            __set_io_errno(-r)
            break
        }
        if r == 0 {
            break
        }
        n = n + r
    }
    __store64(cell, n)
    __syscall(SYS_CLOSE, fd, 0, 0)
    return __str_of(cell)
}

// `__write_file`: `contents` as the whole file at `path` (created with the
// permissions 0644), the errno recorded.
pub fun write_file(path: str, contents: str) {
    __set_io_errno(0)
    let p = c_path(path)
    let fd = __syscall(SYS_OPEN, p, 577, 420)  // O_WRONLY | O_CREAT | O_TRUNC, 0644
    __free(p)
    if fd < 0 {
        __set_io_errno(-fd)
        return
    }
    let c = __addr_of(contents)
    let n = __load64(c)
    var done: int64 = 0
    while done < n {
        let r = __syscall(SYS_WRITE, fd, c + 8 + done, n - done)
        if r < 0 {
            __set_io_errno(-r)
            break
        }
        done = done + r
    }
    __syscall(SYS_CLOSE, fd, 0, 0)
}

const SYS_GETDENTS64: int64 = 217

// `__list_dir`: the name of every entry of the directory at `path`, each
// followed by a NUL byte, in the kernel's order ("." and ".." included), or
// "" with the errno.
pub fun list_dir(path: str) -> str {
    __set_io_errno(0)
    let p = c_path(path)
    let fd = __syscall(SYS_OPEN, p, 589824, 0)  // O_RDONLY | O_DIRECTORY | O_CLOEXEC
    __free(p)
    if fd < 0 {
        __set_io_errno(-fd)
        return ""
    }
    let records = __alloc(4096)
    var cap: int64 = 4088
    var cell = __alloc(cap + 8)
    var n: int64 = 0
    while true {
        let got = __syscall(SYS_GETDENTS64, fd, records, 4096)
        if got == -4 {
            continue  // EINTR
        }
        if got < 0 {
            __set_io_errno(-got)
            n = 0
            break
        }
        if got == 0 {
            break
        }
        // each record: its length at 16 (2 bytes), its NUL-terminated name at 19
        var at: int64 = 0
        while at < got {
            let name = records + at + 19
            var len: int64 = 0
            while __load8(name + len) != 0u8 {
                len += 1
            }
            if n + len + 1 > cap {
                var bigger_cap = cap + cap
                while n + len + 1 > bigger_cap {
                    bigger_cap += bigger_cap
                }
                let bigger = __alloc(bigger_cap + 8)
                __copy_bytes(bigger + 8, cell + 8, n)
                __free(cell)
                cell = bigger
                cap = bigger_cap
            }
            __copy_bytes(cell + 8 + n, name, len + 1)
            n += len + 1
            at += __load64(records + at + 16) & 65535i64
        }
    }
    __free(records)
    __store64(cell, n)
    __syscall(SYS_CLOSE, fd, 0, 0)
    return __str_of(cell)
}

// --- the environment ---------------------------------------------------------

// `__getenv`: the value of the first `name=value` entry of the environment
// the process started with, or "" with the errno ENOENT.
pub fun getenv(name: str) -> str {
    __set_io_errno(0)
    let np = __addr_of(name)
    let n = __load64(np)
    var entry = __environ()
    while true {
        let e = __load64(entry)
        if e == 0 {
            break
        }
        if __equal_bytes(e, np + 8, n) && __load8(e + n) == 61u8 {  // '='
            let v = e + n + 1
            var len: int64 = 0
            while __load8(v + len) != 0u8 {
                len += 1
            }
            let p = __alloc(len + 8)
            __store64(p, len)
            __copy_bytes(p + 8, v, len)
            return __str_of(p)
        }
        entry += 8
    }
    __set_io_errno(2)
    return ""
}

// --- processes ---------------------------------------------------------------

const SYS_POLL: int64 = 7
const SYS_PIPE: int64 = 22
const SYS_DUP2: int64 = 33
const SYS_FORK: int64 = 57
const SYS_EXECVE: int64 = 59
const SYS_EXIT: int64 = 60
const SYS_WAIT4: int64 = 61
const SYS_PIPE2: int64 = 293
const EINTR: int64 = -4
const LOW32: int64 = 4294967295i64

// The child's side of `run`, between fork and exec: system calls on numbers
// the parent prepared, nothing allocated or released. Its stdout and stderr
// become the pipes' write ends; when the exec fails, its errno goes back
// through `report` (closed on exec) and the child ends with 127.
fun exec_child(out_pipe: int64, err_pipe: int64, report: int64, path: int64, argv: int64, scratch: int64) {
    __syscall(SYS_DUP2, out_pipe >> 32, 1, 0)
    __syscall(SYS_DUP2, err_pipe >> 32, 2, 0)
    __syscall(SYS_CLOSE, out_pipe & LOW32, 0, 0)
    __syscall(SYS_CLOSE, out_pipe >> 32, 0, 0)
    __syscall(SYS_CLOSE, err_pipe & LOW32, 0, 0)
    __syscall(SYS_CLOSE, err_pipe >> 32, 0, 0)
    __syscall(SYS_CLOSE, report & LOW32, 0, 0)
    let r = __syscall(SYS_EXECVE, path, argv, __environ())
    __store64(scratch, -r)
    __syscall(SYS_WRITE, report >> 32, scratch, 4)
    __syscall(SYS_EXIT, 127, 0, 0)
}

// A read of up to 4 KB of `fd` into `buf`: the bytes read, 0 for none yet
// (EINTR), -1 at the end of the file or on an error.
fun read_some(fd: int64, buf: int64) -> int64 {
    let got = __syscall(SYS_READ, fd, buf, 4096)
    if got == EINTR {
        return 0
    }
    if got <= 0 {
        return -1
    }
    return got
}

// `__run`: runs `program` (its path, not searched for) with the argument
// vector `argv` and the environment the process started with, reads its
// stdout and stderr as they come (poll), and waits for it. Gives what it
// wrote to stdout; `__run_stderr`, `__run_exit_code`, `__run_signal` (a
// signal that ended it, exit code -1) and `__run_errno` (the errno of a
// failed spawn) give the rest.
pub fun run(program: str, argv: [str]) -> [uint8] {
    var out: [uint8] = []
    var err: [uint8] = []
    let path = c_path(program)
    let n = argv.len() as int64
    let args = __alloc(n * 8 + 8)
    var k: int64 = 0
    for a in argv {
        __store64(args + k * 8, c_path(a))
        k += 1
    }
    __store64(args + n * 8, 0)
    // three pipes, a pair of int32 file descriptors each: read end low
    let pipes = __alloc(24)
    let buf = __alloc(4096)
    var errno: int64 = 0
    var exit_code: int64 = 0
    var signal: int64 = 0
    var r = __syscall(SYS_PIPE, pipes, 0, 0)
    if r >= 0 {
        r = __syscall(SYS_PIPE, pipes + 8, 0, 0)
    }
    if r >= 0 {
        r = __syscall(SYS_PIPE2, pipes + 16, 524288, 0)  // O_CLOEXEC
    }
    var pid: int64 = -1
    if r >= 0 {
        pid = __syscall(SYS_FORK, 0, 0, 0)
        r = pid
    }
    if r < 0 {
        errno = -r
    } else {
        let out_pipe = __load64(pipes)
        let err_pipe = __load64(pipes + 8)
        let report = __load64(pipes + 16)
        if pid == 0 {
            exec_child(out_pipe, err_pipe, report, path, args, buf)
        }
        __syscall(SYS_CLOSE, out_pipe >> 32, 0, 0)
        __syscall(SYS_CLOSE, err_pipe >> 32, 0, 0)
        __syscall(SYS_CLOSE, report >> 32, 0, 0)
        var out_fd = out_pipe & LOW32
        var err_fd = err_pipe & LOW32
        // the child's errno when the exec failed, nothing when it succeeded
        if __syscall(SYS_READ, report & LOW32, buf, 4) > 0 {
            errno = __load64(buf) & LOW32
            __syscall(SYS_CLOSE, out_fd, 0, 0)
            __syscall(SYS_CLOSE, err_fd, 0, 0)
            out_fd = -1
            err_fd = -1
        }
        __syscall(SYS_CLOSE, report & LOW32, 0, 0)
        // two pollfds {fd: int32, events: int16, revents: int16}, POLLIN
        let fds = __alloc(16)
        while out_fd >= 0 || err_fd >= 0 {
            __store64(fds, (out_fd & LOW32) | (1i64 << 32))
            __store64(fds + 8, (err_fd & LOW32) | (1i64 << 32))
            let ready = __syscall(SYS_POLL, fds, 2, -1)
            if ready == EINTR {
                continue
            }
            if ready < 0 {
                break
            }
            if out_fd >= 0 && (__load64(fds) >> 48) != 0 {
                let got = read_some(out_fd, buf)
                if got < 0 {
                    __syscall(SYS_CLOSE, out_fd, 0, 0)
                    out_fd = -1
                }
                var i: int64 = 0
                while i < got {
                    out.push(__load8(buf + i))
                    i += 1
                }
            }
            if err_fd >= 0 && (__load64(fds + 8) >> 48) != 0 {
                let got = read_some(err_fd, buf)
                if got < 0 {
                    __syscall(SYS_CLOSE, err_fd, 0, 0)
                    err_fd = -1
                }
                var i: int64 = 0
                while i < got {
                    err.push(__load8(buf + i))
                    i += 1
                }
            }
        }
        if out_fd >= 0 {
            __syscall(SYS_CLOSE, out_fd, 0, 0)
        }
        if err_fd >= 0 {
            __syscall(SYS_CLOSE, err_fd, 0, 0)
        }
        __free(fds)
        while __syscall(SYS_WAIT4, pid, buf, 0) == EINTR {
        }
        if errno == 0 {
            let status = __load64(buf) & LOW32
            if (status & 127) != 0 {
                signal = status & 127
                exit_code = -1
            } else {
                exit_code = (status >> 8) & 255
            }
        }
    }
    __free(buf)
    __free(pipes)
    k = 0
    while k < n {
        __free(__load64(args + k * 8))
        k += 1
    }
    __free(args)
    __free(path)
    __set_run_status(exit_code, signal, errno)
    __set_run_stderr(err)
    return out
}

// --- standard input ----------------------------------------------------------

// `__read`: what one read of at most `n` bytes of `fd` gives (retried on
// EINTR): empty at the end of the input, for `n <= 0`, or with the errno.
pub fun read(fd: int, n: int) -> str {
    __set_io_errno(0)
    var want = n as int64
    if want < 0 {
        want = 0
    }
    let cell = __alloc(want + 8)
    var got: int64 = 0
    if want > 0 {
        got = __syscall(SYS_READ, fd as int64, cell + 8, want)
        while got == EINTR {
            got = __syscall(SYS_READ, fd as int64, cell + 8, want)
        }
        if got < 0 {
            __set_io_errno(-got)
            got = 0
        }
    }
    __store64(cell, got)
    return __str_of(cell)
}

// `__poll`: 1 when a read of `fd` won't block (input, its end, or an error),
// 0 when `timeout_ms` (negative: none) ran out, -1 with the errno when poll
// failed; retried on EINTR.
pub fun poll(fd: int, timeout_ms: int) -> int {
    __set_io_errno(0)
    let pfd = __alloc(8)
    __store64(pfd, ((fd as int64) & LOW32) | (1i64 << 32))  // POLLIN
    var r = __syscall(SYS_POLL, pfd, 1, timeout_ms as int64)
    while r == EINTR {
        r = __syscall(SYS_POLL, pfd, 1, timeout_ms as int64)
    }
    __free(pfd)
    if r < 0 {
        __set_io_errno(-r)
        return -1
    }
    if r > 0 {
        return 1
    }
    return 0
}

// --- the program's arguments -------------------------------------------------

// `__args`: the program's arguments, its own path first.
pub fun args() -> [str] {
    var out: [str] = []
    var at = __argv()
    while true {
        let c = __load64(at)
        if c == 0 {
            break
        }
        var len: int64 = 0
        while __load8(c + len) != 0u8 {
            len += 1
        }
        let p = __alloc(len + 8)
        __store64(p, len)
        __copy_bytes(p + 8, c, len)
        out.push(__str_of(p))
        at += 8
    }
    return out
}
