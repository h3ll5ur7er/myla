// std.rt — the runtime written in Myla (MYLA-162, D117).
//
// A native build loads this module with every program (the copy the tools
// carry when a standard library folder lacks it); a function here is
// compiled where the code generator calls it in place of the assembly
// routine it replaced (`myla_runtime_function` in selfhost/lower.my). What
// stays in assembly per target is the machine's own: the program's start,
// the system-call stubs, the signal handler, the jumps into frames.
//
// Raw memory goes through the primitives `__load8`, `__load64`, `__store8`,
// `__store64`, `__alloc`, `__free`, `__addr_of`, `__str_of`, `__rotl`, and the bulk
// copy and comparison `__copy_bytes` and `__equal_bytes`, which each backend
// does natively; addresses are `int64`. A string's cell holds its length
// (8 bytes), then its bytes. What it needs from the operating system goes
// through the platform layer, `std.platform` (`os.`); `__set_io_errno`
// records the errno `std.io` reports and `__environ()` gives the
// environment.

import .platform as os
// format specs (D139): the code generator calls std.fmt's functions, which
// every program carries this way
import .fmt as fmt
// slices (D142): the code generator calls std.slice's functions
import .slice as slice
import .num as num

// `a + b` (`__str_concat`): a new cell holding both strings' bytes.
pub fun str_concat(a: str, b: str) -> str {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    let na = __load64(pa)
    let nb = __load64(pb)
    let p = __alloc(na + nb + 8)
    __store64(p, na + nb)
    __copy_bytes(p + 8, pa + 8, na)
    __copy_bytes(p + 8 + na, pb + 8, nb)
    return __str_of(p)
}

// An f-string's pieces joined three or four at a time (MYLA-252): a new
// cell holding their bytes, made once.
pub fun str_concat3(a: str, b: str, c: str) -> str {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    let pc = __addr_of(c)
    let na = __load64(pa)
    let nb = __load64(pb)
    let nc = __load64(pc)
    let p = __alloc(na + nb + nc + 8)
    __store64(p, na + nb + nc)
    __copy_bytes(p + 8, pa + 8, na)
    __copy_bytes(p + 8 + na, pb + 8, nb)
    __copy_bytes(p + 8 + na + nb, pc + 8, nc)
    return __str_of(p)
}

pub fun str_concat4(a: str, b: str, c: str, d: str) -> str {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    let pc = __addr_of(c)
    let pd = __addr_of(d)
    let na = __load64(pa)
    let nb = __load64(pb)
    let nc = __load64(pc)
    let nd = __load64(pd)
    let p = __alloc(na + nb + nc + nd + 8)
    __store64(p, na + nb + nc + nd)
    __copy_bytes(p + 8, pa + 8, na)
    __copy_bytes(p + 8 + na, pb + 8, nb)
    __copy_bytes(p + 8 + na + nb, pc + 8, nc)
    __copy_bytes(p + 8 + na + nb + nc, pd + 8, nd)
    return __str_of(p)
}

// The `n` bytes (a multiple of 8) at `p` set to 0: a new async frame's
// (MYLA-263).
pub fun zero_words(p: int64, n: int64) {
    var at: int64 = 0
    while at < n {
        __store64(p + at, 0)
        at += 8
    }
}

// --- function values' environments (MYLA-263) ------------------------------
//
// An environment's first word points at the record of its routines,
// `[drop, clone, deep]` (the code generator's `env_record_of`); its count is
// at -8, as a cell's. A function value without one has a null environment.

// `__func_retain(env)`: one more reference to the environment.
pub fun func_retain(env: int64) {
    if env != 0 {
        __store64(env - 8, __load64(env - 8) + 1)
    }
}

// `__func_drop(env)`: one reference less; at none, the drop function its
// record names releases what it holds and frees it.
pub fun func_drop(env: int64) {
    if env == 0 {
        return
    }
    let n = __load64(env - 8) - 1
    __store64(env - 8, n)
    if n == 0 {
        let done = __call_code(__load64(__load64(env)), env)
    }
}

// `__deep_env(env)` and `__dclone_env(env)` (D92, MYLA-148): the deep copy
// and the clone its record names (with tasks; null for none).
pub fun deep_env(env: int64) -> int64 {
    if env == 0 {
        return 0
    }
    return __call_code(__load64(__load64(env) + 16), env)
}

pub fun dclone_env(env: int64) -> int64 {
    if env == 0 {
        return 0
    }
    return __call_code(__load64(__load64(env) + 8), env)
}

// `__equal_bytes(p, q, n)`: whether the `n` bytes at `p` and `q` are the
// same, eight at a time, then one (MYLA-263: the same on every target).
pub fun equal_bytes(p: int64, q: int64, n: int64) -> bool {
    var i: int64 = 0
    while i + 8 <= n {
        if __load64(p + i) != __load64(q + i) {
            return false
        }
        i += 8
    }
    while i < n {
        if __load8(p + i) != __load8(q + i) {
            return false
        }
        i += 1
    }
    return true
}

// `a == b` (`__str_eq`): the same cell, or equal lengths and bytes.
pub fun str_eq(a: str, b: str) -> bool {
    let pa = __addr_of(a)
    let pb = __addr_of(b)
    if pa == pb {
        return true
    }
    let n = __load64(pa)
    if n != __load64(pb) {
        return false
    }
    return __equal_bytes(pa + 8, pb + 8, n)
}

// `a < b` and the other orderings of strings (MYLA-318): -1, 0 or 1, as
// `Ord`'s `cmp` gives them, by the first byte that differs (unsigned), or
// the shorter first when one begins the other; the order `list_dir` sorts
// in. Eight bytes at a time while they agree (its cases are the parity
// programs' `string_ordering`).
pub fun str_cmp(a: str, b: str) -> int64 {
    let pa = __addr_of(a) + 8
    let pb = __addr_of(b) + 8
    let na = __load64(pa - 8)
    let nb = __load64(pb - 8)
    var n = na
    if nb < n {
        n = nb
    }
    var i: int64 = 0
    while i + 8 <= n && __load64(pa + i) == __load64(pb + i) {
        i += 8
    }
    while i < n {
        let x = __load8(pa + i)
        let y = __load8(pb + i)
        if x != y {
            if x < y {
                return -1
            }
            return 1
        }
        i += 1
    }
    if na < nb {
        return -1
    }
    if na > nb {
        return 1
    }
    return 0
}

// --- files and directories (the platform's, `std.platform`) ----------------
//
// Each sets the errno `std.io` reports: 0, or the failed call's.

// The errno of `r`, a result of the platform's (0 when it is none).
fun record(r: int64) {
    if r < 0 {
        __set_io_errno(-r)
    } else {
        __set_io_errno(0)
    }
}

// Whether `path` holds a NUL byte, which the kernel would take for its end
// (`"a\u{0}b"` naming `a`): such a path names nothing, with EINVAL (the
// review of 2026-11-06, R7; `IoError.InvalidInput`).
fun nul_in(path: str) -> bool {
    let p = __addr_of(path)
    let n = __load64(p)
    var i: int64 = 0
    while i < n {
        if __load8(p + 8 + i) == 0u8 {
            __set_io_errno(EINVAL)
            return true
        }
        i += 1
    }
    return false
}

const EINVAL: int64 = 22

// `__stat`: the mode of what `path` names (the type bits and permissions),
// or -1.
pub fun stat(path: str) -> int {
    if nul_in(path) {
        return -1
    }
    let r = os.mode_of(path)
    record(r)
    if r < 0 {
        return -1
    }
    return r as int
}

// `__mkdir`: a directory with the permissions `mode`.
pub fun mkdir(path: str, mode: int) {
    if !nul_in(path) {
        record(os.make_dir(path, mode as int64))
    }
}

pub fun unlink(path: str) {
    if !nul_in(path) {
        record(os.remove_file(path))
    }
}

pub fun rmdir(path: str) {
    if !nul_in(path) {
        record(os.remove_dir(path))
    }
}

pub fun rename(from_path: str, to_path: str) {
    if !nul_in(from_path) && !nul_in(to_path) {
        record(os.rename(from_path, to_path))
    }
}

// `__getcwd`: the working directory, or "" with the errno (ENOENT for a
// removed directory, ERANGE for one longer than 4 KB).
pub fun getcwd() -> str {
    let buf = __alloc(4096)
    let r = os.cwd(buf, 4096)
    record(r)
    var n: int64 = 0
    if r > 0 {
        n = r
    }
    let p = __alloc(n + 8)
    __store64(p, n)
    __copy_bytes(p + 8, buf, n)
    __free(buf)
    return __str_of(p)
}

// `__read_file`: the bytes of the file at `path`, or "" with the errno. A
// file that reports no size (/proc, a pipe) is read into a cell that doubles
// until the end.
pub fun read_file(path: str) -> str {
    __set_io_errno(0)
    if nul_in(path) {
        return ""
    }
    let fd = os.open_read(path)
    if fd < 0 {
        __set_io_errno(-fd)
        return ""
    }
    var cap = os.file_size(fd)
    let grows = cap == 0
    if grows {
        cap = 4096
    }
    var cell = __alloc(cap + 8)
    var n: int64 = 0
    while true {
        if n == cap {
            if !grows {
                break
            }
            let bigger = __alloc(cap + cap + 8)
            __copy_bytes(bigger + 8, cell + 8, n)
            __free(cell)
            cell = bigger
            cap = cap + cap
        }
        let r = os.read(fd, cell + 8 + n, cap - n)
        if r < 0 {
            __set_io_errno(-r)
            break
        }
        if r == 0 {
            break
        }
        n = n + r
    }
    __store64(cell, n)
    os.close(fd)
    return __str_of(cell)
}

// `__write_file`: `contents` as the whole file at `path` (created with the
// permissions 0644), the errno recorded.
pub fun write_file(path: str, contents: str) {
    __set_io_errno(0)
    if nul_in(path) {
        return
    }
    let fd = os.open_write(path)
    if fd < 0 {
        __set_io_errno(-fd)
        return
    }
    let c = __addr_of(contents)
    let n = __load64(c)
    var done: int64 = 0
    while done < n {
        let r = os.write(fd, c + 8 + done, n - done)
        if r < 0 {
            __set_io_errno(-r)
            break
        }
        done = done + r
    }
    os.close(fd)
}

// `__list_dir`: the name of every entry of the directory at `path`, each
// followed by a NUL byte, in the file system's order ("." and ".." included),
// or "" with the errno.
pub fun list_dir(path: str) -> str {
    __set_io_errno(0)
    if nul_in(path) {
        return ""
    }
    let fd = os.open_dir(path)
    if fd < 0 {
        __set_io_errno(-fd)
        return ""
    }
    let records = __alloc(4096)
    var cap: int64 = 4088
    var cell = __alloc(cap + 8)
    var n: int64 = 0
    while true {
        let got = os.dir_read(fd, records, 4096)
        if got == os.EINTR {
            continue
        }
        if got < 0 {
            __set_io_errno(-got)
            n = 0
            break
        }
        if got == 0 {
            break
        }
        var at: int64 = 0
        while at < got {
            let name = os.dir_entry_name(records + at)
            var len: int64 = 0
            while __load8(name + len) != 0u8 {
                len += 1
            }
            if n + len + 1 > cap {
                var bigger_cap = cap + cap
                while n + len + 1 > bigger_cap {
                    bigger_cap += bigger_cap
                }
                let bigger = __alloc(bigger_cap + 8)
                __copy_bytes(bigger + 8, cell + 8, n)
                __free(cell)
                cell = bigger
                cap = bigger_cap
            }
            __copy_bytes(cell + 8 + n, name, len + 1)
            n += len + 1
            at += os.dir_entry_size(records + at)
        }
    }
    __free(records)
    __store64(cell, n)
    os.close(fd)
    return __str_of(cell)
}

// --- file descriptors (MYLA-336) ---------------------------------------------
//
// A descriptor is read with `__read` and written with `__write` (below), at
// its cursor, and closed with `__close`. What these primitives take as `fd`
// is a descriptor's number, or a handle (D181) for one: `__open` and
// `__spawn_piped` give handles (a `File`'s, a child's streams'), which hold
// the descriptor, so that a copy of a closed `File` reaches nothing and not
// the file that got its descriptor next. A number below HANDLE_MIN (2^23,
// past any descriptor's or process ID's) is a descriptor itself: the
// standard streams', `io.fd_stream`'s.

const H_FD: int64 = 3

// The descriptor `fd` stands for: itself below HANDLE_MIN, else the one the
// open handle `fd` holds, or -1 (EBADF's) when it isn't open.
fun fd_of(fd: int64) -> int64 {
    if fd < HANDLE_MIN {
        return fd
    }
    return handle_get(fd, H_FD)
}

// A handle for the new descriptor `fd` (a negative one, an error, as it is).
fun fd_handle(fd: int64) -> int64 {
    if fd < 0 {
        return fd
    }
    return handle_new(H_FD, fd)
}

// `__open(path, flags, mode)`: the file at `path` opened, a handle for its
// descriptor (closed on exec), or -1 with the errno. `flags`: 1 read, 2
// write (both: read and write), 4 create, 8 truncate, 16 append, 32 exclusive (with
// create: EEXIST when the file is there); without 1 or 2, or with another
// bit, EINVAL. `mode`: the permissions of a file it creates, less the umask
// (none on wasm32).
pub fun open(path: str, flags: int, mode: int) -> int {
    __set_io_errno(0)
    if nul_in(path) {
        return -1
    }
    if (flags & 3) == 0 || (flags & -64) != 0 {
        __set_io_errno(EINVAL)
        return -1
    }
    let r = os.open_file(path, flags as int64, mode as int64)
    record(r)
    if r < 0 {
        return -1
    }
    return fd_handle(r) as int
}

// `__seek(fd, offset, whence)`: the cursor of `fd` moved to `offset` bytes
// from the start (`whence` 0), the cursor (1) or the end (2): the new
// offset from the start, or -1 with the errno (EINVAL for another whence
// or an offset before the start, ESPIPE for a pipe).
pub fun seek(fd: int, offset: int64, whence: int) -> int64 {
    if whence < 0 || whence > 2 {
        __set_io_errno(EINVAL)
        return -1
    }
    let r = os.seek(fd_of(fd as int64), offset, whence as int64)
    record(r)
    if r < 0 {
        return -1
    }
    return r
}

// `__fstat(fd)`: `[size, mode, mtime]` of the open file `fd` (the mode's
// type bits and permissions as `__stat`'s, the modification time in
// nanoseconds since 1970), or `[]` with the errno.
pub fun fstat(fd: int) -> [int64] {
    let out = __alloc(24)
    let r = os.fd_stat(fd_of(fd as int64), out)
    record(r)
    var st: [int64] = []
    if r >= 0 {
        st = [__load64(out), __load64(out + 8), __load64(out + 16)]
    }
    __free(out)
    return st
}

// `__path_stat(path, follow)` (MYLA-378, MYLA-363): `[size, mode, mtime,
// dev, ino]` of what `path` names, without opening it: the size, mode and
// time as `__fstat`'s, then the device and the file's number on it, which
// together tell one file from another. A symbolic link is followed when
// `follow`, else it is described itself (its mode's type bits 0o120000).
// `[]` with the errno (ENOENT, a dangling link followed; EINVAL for a NUL
// in the path).
pub fun path_stat(path: str, follow: bool) -> [int64] {
    var st: [int64] = []
    if nul_in(path) {
        return st
    }
    let out = __alloc(40)
    let r = os.path_stat(path, follow, out)
    record(r)
    if r >= 0 {
        st = [__load64(out), __load64(out + 8), __load64(out + 16), __load64(out + 24), __load64(out + 32)]
    }
    __free(out)
    return st
}

// --- entropy (MYLA-336) --------------------------------------------------------

// `__random_bytes(n)`: `n` bytes of the system's entropy (getrandom(2),
// WASI's `random_get`), or none with the errno (EINVAL for a negative `n`).
pub fun random_bytes(n: int) -> [uint8] {
    __set_io_errno(0)
    var want = n as int64
    if want < 0 {
        __set_io_errno(EINVAL)
        want = 0
    }
    let cell = __alloc(want + 16)
    __store64(cell, 0)
    __store64(cell + 8, want)
    if want > 0 {
        let r = os.random_fill(cell + 16, want)
        record(r)
        if r == 0 {
            __store64(cell, want)
        }
    }
    return __list_of(cell)
}

// --- handles (D181) ----------------------------------------------------------------
//
// A handle (a socket's, a notifier's) is a number only the runtime turns
// into what the platform uses (a descriptor, a Windows SOCKET, a record's
// address): an index into the table `__handles` and the generation of its
// entry, in one positive `int`. The table's cell is `[cap][open][last]` and
// then `cap` entries `[handle][kind][value]`, `cap` a power of two; the
// handle `h` is in the entry `h & (cap - 1)`, which holds `h` while it is
// open and 0 once it is free. Handles are given in increasing order from
// 2^23 (HANDLE_MIN), each the first number after the last one given whose
// entry is free, so a handle closed is never given again (until the count
// passes 2^31 - 1 and starts again at 2^23, after some two billion), and no
// descriptor's number or process ID (Linux's are below 2^20 and 2^22) is
// ever one: an operation through a copy made before a
// close, or through a number made up (one that isn't an open handle's),
// finds its entry holding another handle or none, and fails, and never
// reaches the descriptor or the record the entry may hold by then. The
// table doubles before it is half full, each entry moving to its handle's
// place in the bigger one (two open handles differ modulo the old size, so
// modulo the new one too). The lock is `__handles + 8`; the notifiers take
// it inside the timers' lock. A close on one worker while another worker's
// operation through a copy is between its look-up and its system call can
// still reach the next socket with the descriptor: closing a stream another
// task is using is a race of the program's.

const HANDLE: int64 = 24
const H_SOCKET: int64 = 1
const H_NOTIFIER: int64 = 2
const HANDLE_MIN: int64 = 8388608
const HANDLE_MAX: int64 = 2147483647

// A new handle of the kind `kind` for `value` (at least 0).
fun handle_new(kind: int64, value: int64) -> int64 {
    let lock = __rt_addr("__handles") + 8
    take_lock(lock)
    var t = __rt_get("__handles")
    if t == 0 || 2 * (__load64(t + 8) + 1) > __load64(t) {
        t = handles_grown(t)
    }
    let mask = __load64(t) - 1
    var h = __load64(t + 16) + 1
    if h < HANDLE_MIN || h > HANDLE_MAX - mask {
        h = HANDLE_MIN
    }
    while __load64(t + 24 + (h & mask) * HANDLE) != 0 {
        h += 1
    }
    let e = t + 24 + (h & mask) * HANDLE
    __store64(e, h)
    __store64(e + 8, kind)
    __store64(e + 16, value)
    __store64(t + 8, __load64(t + 8) + 1)
    __store64(t + 16, h)
    give_lock(lock)
    return h
}

// What the open handle `h` of the kind `kind` holds, or -1 (closed, of
// another kind, or never given); `free`: and the handle closed.
fun handle_take(h: int64, kind: int64, free: bool) -> int64 {
    if h <= 0 {
        return -1
    }
    let lock = __rt_addr("__handles") + 8
    take_lock(lock)
    let t = __rt_get("__handles")
    var v: int64 = -1
    if t != 0 {
        let e = t + 24 + (h & (__load64(t) - 1)) * HANDLE
        if __load64(e) == h && __load64(e + 8) == kind {
            v = __load64(e + 16)
            if free {
                __store64(e, 0)
                __store64(t + 8, __load64(t + 8) - 1)
            }
        }
    }
    give_lock(lock)
    return v
}

fun handle_get(h: int64, kind: int64) -> int64 {
    return handle_take(h, kind, false)
}

fun handle_free(h: int64, kind: int64) -> int64 {
    return handle_take(h, kind, true)
}

// The table `t` (0: none yet) moved into one twice as big (64 entries at
// first); the lock held.
fun handles_grown(t: int64) -> int64 {
    var cap: int64 = 64
    if t != 0 {
        cap = __load64(t) * 2
    }
    let bigger = __alloc(24 + cap * HANDLE)
    zero_words(bigger, 24 + cap * HANDLE)
    __store64(bigger, cap)
    if t != 0 {
        __store64(bigger + 8, __load64(t + 8))
        __store64(bigger + 16, __load64(t + 16))
        var i: int64 = 0
        while i < __load64(t) {
            let e = t + 24 + i * HANDLE
            let h = __load64(e)
            if h != 0 {
                __copy_bytes(bigger + 24 + (h & (cap - 1)) * HANDLE, e, HANDLE)
            }
            i += 1
        }
        __free(t)
    }
    __store64(__rt_addr("__handles"), bigger)
    return bigger
}

// --- sockets (MYLA-346) ------------------------------------------------------------
//
// The primitives of std.net, each over the platform's socket functions
// (`os.sock_*`). A socket is a handle (`int`, D181) that only these take:
// data is sent and received on it, and `__sock_close` closes it, as a port
// where sockets aren't descriptors (Winsock) needs; the handle's entry holds
// the platform's socket. An address is a portable record, a string of 7 or
// 19 bytes: the family (4 or 6), the port (two bytes, big-endian), the
// address's 4 or 16 bytes. Each sets the errno `__io_errno` reads, 0 on
// success; a handle that isn't open (closed, through a copy too, or made
// up) is EBADF.

const EBADF: int64 = 9

// A platform result as a primitive's: the errno recorded, -1 for an error.
fun sock_result(r: int64) -> int {
    record(r)
    if r < 0 {
        return -1
    }
    return r as int
}

// The platform's socket of the handle `h`, or -1.
fun sock_of(h: int) -> int64 {
    return handle_get(h as int64, H_SOCKET)
}

// A new socket's handle for the platform's result `r` (a socket, or minus
// the errno), as a primitive's result.
fun sock_new(r: int64) -> int {
    if r < 0 {
        return sock_result(r)
    }
    return sock_result(handle_new(H_SOCKET, r))
}

// `__sock_open(family, kind)`: a new socket of the family `family` (4 or
// 6) and the kind `kind` (1 stream, 2 datagrams), blocking: its handle, or
// -1 (EAFNOSUPPORT for another family, EINVAL for another kind).
pub fun sock_open(family: int, kind: int) -> int {
    return sock_new(os.sock_open(family as int64, kind as int64))
}

// `__sock_set_nonblocking(h, on)`: the socket `h` non-blocking (`on` 1) or
// blocking (0): 0, or -1.
pub fun sock_set_nonblocking(h: int, on: int) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.sock_nonblocking(s, on as int64))
}

// `__sock_bind(h, addr)`: the socket bound to the address record `addr`.
pub fun sock_bind(h: int, addr: str) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.sock_bind(s, addr))
}

// `__sock_listen(h, backlog)`: the stream socket listening.
pub fun sock_listen(h: int, backlog: int) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.sock_listen(s, backlog as int64))
}

// `__sock_accept(h)`: the next connection of the listening socket `h`, a
// new socket (blocking), or -1 (EAGAIN when `h` is non-blocking and none is
// queued); retried on EINTR.
pub fun sock_accept(h: int) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    var r = os.sock_accept(s)
    while r == os.EINTR {
        r = os.sock_accept(s)
    }
    return sock_new(r)
}

// `__sock_connect(h, addr)`: the socket connected to the address record
// `addr`: 0, or -1; EINPROGRESS (115) for a non-blocking socket, whose
// connection goes on: once it is writable, `__sock_error` says how it went.
pub fun sock_connect(h: int, addr: str) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.sock_connect(s, addr))
}

// `__sock_error(h)`: the error pending on the socket, taken (0 for none,
// else its errno), or -1 when it can't be read.
pub fun sock_error(h: int) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.sock_error(s))
}

// `__sock_send(h, s, start)`: the bytes of `s` from `start` on sent on the
// connected socket, in one call: how many went (fewer when a non-blocking
// socket's buffer filled), or -1 (EAGAIN: none fitted; EPIPE or ECONNRESET:
// the peer went away; no signal). Retried on EINTR.
pub fun sock_send(h: int, s: str, start: int) -> int {
    let k = sock_of(h)
    if k < 0 {
        return sock_result(-EBADF)
    }
    let c = __addr_of(s)
    let n = __load64(c)
    let at = start as int64
    if at < 0 || at > n {
        return sock_result(-EINVAL)
    }
    var r = os.sock_send(k, c + 8 + at, n - at)
    while r == os.EINTR {
        r = os.sock_send(k, c + 8 + at, n - at)
    }
    return sock_result(r)
}

// `__sock_recv(h, n)`: what one receive of at most `n` bytes gives: empty
// at the end of the stream, for `n <= 0`, or with the errno (EAGAIN: nothing
// there yet on a non-blocking socket). Retried on EINTR.
pub fun sock_recv(h: int, n: int) -> str {
    var want = n as int64
    if want < 0 {
        want = 0
    }
    let cell = __alloc(want + 8)
    var got: int64 = 0
    __set_io_errno(0)
    let s = sock_of(h)
    if s < 0 {
        __set_io_errno(EBADF)
    } else if want > 0 {
        got = os.sock_recv(s, cell + 8, want)
        while got == os.EINTR {
            got = os.sock_recv(s, cell + 8, want)
        }
        if got < 0 {
            __set_io_errno(-got)
            got = 0
        }
    }
    let fit = fitted(cell, 8, got)
    __store64(fit, got)
    return __str_of(fit)
}

// `__sock_send_to(h, s, addr)`: `s` sent as one datagram to the address
// record `addr`: how many bytes, or -1. Retried on EINTR.
pub fun sock_send_to(h: int, s: str, addr: str) -> int {
    let k = sock_of(h)
    if k < 0 {
        return sock_result(-EBADF)
    }
    let c = __addr_of(s)
    var r = os.sock_send_to(k, c + 8, __load64(c), addr)
    while r == os.EINTR {
        r = os.sock_send_to(k, c + 8, __load64(c), addr)
    }
    return sock_result(r)
}

// `__sock_recv_from(h, n)`: the next datagram, at most `n` bytes of it (the
// rest dropped): 19 bytes holding its sender's address record (7 of them
// for IPv4), then its bytes; "" with the errno (EAGAIN: none yet on a
// non-blocking socket). Retried on EINTR.
pub fun sock_recv_from(h: int, n: int) -> str {
    var want = n as int64
    if want < 0 {
        want = 0
    }
    let cell = __alloc(want + 8 + 24)
    __store64(cell + 8, 0)
    __store64(cell + 16, 0)
    __store64(cell + 24, 0)
    var got: int64 = -EBADF
    let s = sock_of(h)
    if s >= 0 {
        got = os.sock_recv_from(s, cell + 27, want, cell + 8)
        while got == os.EINTR {
            got = os.sock_recv_from(s, cell + 27, want, cell + 8)
        }
    }
    record(got)
    var len: int64 = 0
    if got >= 0 {
        len = 19 + got
    }
    let fit = fitted(cell, 8, len)
    __store64(fit, len)
    return __str_of(fit)
}

// `__sock_addr(h, peer)`: the address record of the socket's own end
// (`peer` 0) or of its peer (1), or "" with the errno (ENOTCONN: no peer).
pub fun sock_addr(h: int, peer: int) -> str {
    let cell = __alloc(8 + 19)
    var r: int64 = -EBADF
    let s = sock_of(h)
    if s >= 0 {
        r = os.sock_addr(s, peer as int64, cell + 8)
    }
    record(r)
    if r < 0 {
        __store64(cell, 0)
    } else {
        __store64(cell, r)
    }
    return __str_of(cell)
}

// `__sock_shutdown(h, how)`: the socket's receiving (`how` 1), sending (2)
// or both (3) ended: 0, or -1.
pub fun sock_shutdown(h: int, how: int) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.sock_shutdown(s, how as int64))
}

// `__sock_option(h, opt, value)`: the option `opt` (1 no delay, 2
// broadcast, 3 a listener's address reused) set to `value` (0 or 1).
pub fun sock_option(h: int, opt: int, value: int) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.sock_option(s, opt as int64, value as int64))
}

// `__sock_poll(h, events, timeout_ms)`: waiting, the thread blocked, at most
// `timeout_ms` milliseconds (negative: no limit) until the socket is ready
// for `events` (1 to receive or accept, 2 to send or a connect's end): the
// events ready (an error or a hang-up counts as each), 0 when the time ran
// out, or -1. Retried on EINTR.
pub fun sock_poll(h: int, events: int, timeout_ms: int) -> int {
    let s = sock_of(h)
    if s < 0 {
        return sock_result(-EBADF)
    }
    var r = os.sock_poll(s, events as int64, timeout_ms as int64)
    while r == os.EINTR {
        r = os.sock_poll(s, events as int64, timeout_ms as int64)
    }
    return sock_result(r)
}

// `__sock_close(h)`: the socket closed, its handle with it (every copy of
// it fails from then on with EBADF): 0, or -1.
pub fun sock_close(h: int) -> int {
    let s = handle_free(h as int64, H_SOCKET)
    if s < 0 {
        return sock_result(-EBADF)
    }
    watches_closed(s)
    return sock_result(os.sock_close(s))
}

// `__net_config(which)`: the path of the hosts file (`which` 0), or the
// resolver's configuration as resolv.conf text (1), as the platform keeps
// them; "" for none.
pub fun net_config(which: int) -> str {
    __set_io_errno(0)
    return os.net_config(which as int64)
}

// --- the terminal and signals (MYLA-350) -----------------------------------------------
//
// The primitives of std.term and std.signal, each over the platform's
// functions of the same name (`os.term_*`, `os.signal_*`). A terminal is
// named by a descriptor (0 to 2 in std.term); its mode is an opaque string
// the platform fills. Each sets the errno `__io_errno` reads, 0 on success:
// ENOTTY (25) for a descriptor that isn't a terminal, ENOSYS (38) where the
// target has none (wasm32).

// `__term_is_tty(fd)`: 1 when the descriptor is a terminal, else 0.
pub fun term_is_tty(fd: int) -> int {
    __set_io_errno(0)
    if fd < 0 {
        return 0
    }
    return os.term_is_tty(fd as int64) as int
}

// `__term_size(fd)`: the terminal's columns times 65536 plus its rows, or -1.
pub fun term_size(fd: int) -> int {
    var r: int64 = -EBADF
    if fd >= 0 {
        r = os.term_size(fd as int64)
    }
    return sock_result(r)
}

// `__term_get(fd)`: the terminal's mode as the platform keeps it, or ""
// with the errno.
pub fun term_get(fd: int) -> str {
    let cell = __alloc(8 + 64)
    var r: int64 = -EBADF
    if fd >= 0 {
        r = os.term_get_mode(fd as int64, cell + 8)
    }
    record(r)
    if r < 0 {
        __store64(cell, 0)
    } else {
        __store64(cell, r)
    }
    return __str_of(cell)
}

// `__term_set(fd, mode)`: the terminal back in the mode `__term_get` gave:
// 0, or -1. The mode the exit hook keeps for `fd` set again is raw mode
// left: the hook goes (D187).
pub fun term_set(fd: int, mode: str) -> int {
    if fd < 0 {
        return sock_result(-EBADF)
    }
    let r = os.term_set_mode(fd as int64, mode)
    let h = __rt_addr("__exit_hook")
    let m = __addr_of(mode)
    if r >= 0 && __load64(h) == (fd as int64) + 1 && __load64(m) == __load64(h + 24) && __equal_bytes(m + 8, h + 32, __load64(m)) {
        __store64(h, 0)
    }
    return sock_result(r)
}

// `__term_raw(fd)`: the terminal in raw mode (no echo, a key at a time, no
// signal keys): 0, or -1. The mode before it is kept for the exit hook,
// which puts it back however the program ends (D187); raw mode entered
// again keeps the first one's.
pub fun term_raw(fd: int) -> int {
    if fd < 0 {
        return sock_result(-EBADF)
    }
    let h = __rt_addr("__exit_hook")
    var kept = false
    if __load64(h) == 0 {
        let n = os.term_get_mode(fd as int64, h + 32)
        if n >= 0 {
            // a static string's cell: its size, a count that never reaches
            // zero, its length
            __store64(h + 8, 64)
            __store64(h + 16, 2305843009213693952)
            __store64(h + 24, n)
            kept = true
        }
    }
    let r = os.term_make_raw(fd as int64)
    if kept && r >= 0 {
        __store64(h, (fd as int64) + 1)
    }
    return sock_result(r)
}

// `__term_vt(fd)`: escape sequences written to the terminal interpreted
// from now on (turned on where the platform must): 0, or -1.
pub fun term_vt(fd: int) -> int {
    if fd < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.term_enable_vt(fd as int64))
}

// `__signal_listen(on)`: the interrupt and terminate signals caught (`on`
// 1: the handle they arrive on, or -1), or let go (0: their defaults back
// once nobody listens).
pub fun signal_listen(on: int) -> int {
    return sock_result(os.signal_listen(on as int64))
}

// `__signal_take(h)`: the next signal on the handle `h`, the thread
// waiting for one: 2 (an interrupt) or 15 (termination); 0 when the handle
// ended, or -1.
pub fun signal_take(h: int) -> int {
    if h < 0 {
        return sock_result(-EBADF)
    }
    return sock_result(os.signal_take(h as int64))
}

// --- the environment ---------------------------------------------------------

// `__getenv`: the value of the first `name=value` entry of the environment
// the process started with, or "" with the errno ENOENT.
pub fun getenv(name: str) -> str {
    __set_io_errno(0)
    let np = __addr_of(name)
    let n = __load64(np)
    var entry = __environ()
    while true {
        let e = __load64(entry)
        if e == 0 {
            break
        }
        if __equal_bytes(e, np + 8, n) && __load8(e + n) == 61u8 {  // '='
            let v = e + n + 1
            var len: int64 = 0
            while __load8(v + len) != 0u8 {
                len += 1
            }
            let p = __alloc(len + 8)
            __store64(p, len)
            __copy_bytes(p + 8, v, len)
            return __str_of(p)
        }
        entry += 8
    }
    __set_io_errno(2)
    return ""
}

// --- processes ---------------------------------------------------------------

const LOW32: int64 = 4294967295i64

// `__run`: runs `program` (its path, not searched for) with the argument
// vector `argv` and the environment the process started with, reads its
// stdout and stderr as they come, and waits for it (the platform's). Gives
// what it wrote to stdout; `__run_stderr`, `__run_exit_code`, `__run_signal`
// (a signal that ended it, exit code -1) and `__run_errno` (the errno of a
// failed spawn) give the rest.
pub fun run(program: str, argv: [str]) -> [uint8] {
    return os.run(program, argv)
}

// `__spawn`, `__reap`, `__kill`, `__close`: a child started and not waited
// for, then waited for, signalled, its descriptors closed (D124,
// `std.process.run_async`; the platform's).
pub fun spawn(program: str, argv: [str]) -> [int] {
    return os.spawn(program, argv)
}

// `__run_with(program, argv, opts)` and `__spawn_with`: `run` and `spawn` as
// D147 has them. A program named without a `/` is looked for in each
// directory of this process's PATH ("/bin:/usr/bin" without one; an empty
// entry is the working directory), as `execvp` looks. `opts`: the directory
// to run it in ("": this one), "1" or "" for whether its stdin is the text
// after it (else this process's), then its environment: "" for this
// process's, "keep" for this process's with the changes after it, "clear"
// for only what the changes set (a change `NAME=value` sets NAME, a bare
// `NAME` removes it).
pub fun run_with(program: str, argv: [str], opts: [str]) -> [uint8] {
    return os.run_with(program_paths(program), argv, opts)
}

pub fun spawn_with(program: str, argv: [str], opts: [str]) -> [int] {
    return os.spawn_with(program_paths(program), argv, opts)
}

// The paths `program` may be at (D147): itself when it names a path,
// else in each directory of PATH.
fun program_paths(program: str) -> [str] {
    var i = 0
    while i < program.len() {
        if program[i] == 47u8 {         // '/'
            return [program]
        }
        i += 1
    }
    if program == "" {
        return [program]
    }
    var path = getenv("PATH")
    if __io_errno() != 0 {
        path = "/bin:/usr/bin"
    }
    var out: [str] = []
    var start = 0
    i = 0
    while i <= path.len() {
        if i == path.len() || path[i] == 58u8 {   // ':'
            var sb = StringBuilder()
            sb.append(path, start, i)
            var dir = sb.build()
            if dir == "" {
                dir = "."
            }
            out.push(dir + "/" + program)
            start = i + 1
        }
        i += 1
    }
    return out
}

pub fun reap(pid: int) -> int {
    return os.reap(pid as int64) as int
}

// `__kill(pid, sig)`: the signal `sig` sent to `pid`, the errno recorded
// (ESRCH when there's no such process; ENOSYS on wasm32).
pub fun kill(pid: int, sig: int) {
    record(os.kill(pid as int64, sig as int64))
}

// `__spawn_piped(program, argv, opts)` (MYLA-336): `spawn_with` with the
// child's stdin a pipe too, `[errno, pid, in, out, err, exited]`: `in` the
// write end of its stdin's pipe, `out` and `err` the read ends of its
// stdout's and stderr's, `exited` its pidfd; `opts` as `run_with` takes
// them, but for the input, which the pipe is instead. Or `opts[1]` says
// what each stream is (MYLA-378), three letters for stdin, stdout and
// stderr: `p` a pipe, `i` this process's, `n` nothing (/dev/null), and for
// stdin `t` the text `opts[2]` or `d` the descriptor whose number `opts[2]`
// is (handed over: closed here once the child has it); a stream that isn't
// a pipe is -1 in the result. `[errno, 0, -1, -1, -1, -1]` when it
// couldn't be started (ENOSYS on wasm32).
pub fun spawn_piped(program: str, argv: [str], opts: [str]) -> [int] {
    var given: int64 = -1
    var o = opts
    if o.len() > 2 && o[1].len() > 0 && o[1][0] == 100u8 {     // 'd'
        given = digits_of(o[2])
        if given >= HANDLE_MIN {
            o[2] = int_to_str(fd_of(given))
        }
    }
    var h = os.spawn_piped(program_paths(program), argv, o)
    // the descriptor handed over is closed now (once the child has it, or
    // with the error): its handle with it
    if given >= HANDLE_MIN {
        let gone = handle_free(given, H_FD)
    }
    var k = 2
    while k < 6 && k < h.len() {
        h[k] = fd_handle(h[k] as int64) as int
        k += 1
    }
    return h
}

// The number the decimal digits `s` make (-1: none, or not only digits).
#test("42")[42]
#test("")[-1]
#test("4x")[-1]
fun digits_of(s: str) -> int64 {
    if s.len() == 0 || s.len() > 18 {
        return -1
    }
    var n: int64 = 0
    var i = 0
    while i < s.len() {
        let b = s[i]
        if b < 48u8 || b > 57u8 {   // '0', '9'
            return -1
        }
        n = n * 10 + (b - 48u8) as int64
        i += 1
    }
    return n
}

// `__try_reap(pid)` (MYLA-336): the child `pid` reaped if it has ended, as
// `__reap` gives it (its exit code, or minus its signal), without waiting;
// 256 while it runs (errno 0), or 256 with the errno (ECHILD: not a child
// of this process, or already reaped).
pub fun try_reap(pid: int) -> int {
    let out = __alloc(8)
    let r = os.try_reap(pid as int64, out)
    record(r)
    var code = 256
    if r > 0 {
        code = __load64(out) as int
    }
    __free(out)
    return code
}

// `__close(fd)`: the descriptor closed, a handle's with the handle (every
// copy of it fails from then on), its errno recorded (MYLA-378): EBADF for
// one that isn't open (a negative one too), EIO when the data written
// couldn't be kept. EINTR is no error: Linux has closed it then, and
// closing it again could close another file's.
pub fun close(fd: int) {
    var d = fd as int64
    if d >= HANDLE_MIN {
        d = handle_free(d, H_FD)
    }
    if d < 0 {
        __set_io_errno(EBADF)
        return
    }
    watches_closed(d)
    var r = os.close(d)
    if r == os.EINTR {
        r = 0
    }
    record(r)
}

// --- standard input ----------------------------------------------------------

// The cell `cell` from `__alloc`, whose bytes from `head` on hold the `got`
// that one read gave: itself if it is no more than twice their size, else a
// cell of their size, with them copied, and `cell` freed. So a short read
// keeps no more than it got, not the room its request asked for (S1: 33 MB
// read from a pipe 64 KiB at a time by reads of 16 MB kept 513 cells of
// 16 MB, and ran out of memory on wasm32).
fun fitted(cell: int64, head: int64, got: int64) -> int64 {
    if (got + head) * 2 >= __load64(cell - 16) {
        return cell
    }
    let small = __alloc(got + head)
    __copy_bytes(small + head, cell + head, got)
    __free(cell)
    return small
}

// `__read`: what one read of at most `n` bytes of `fd` gives (retried on
// EINTR): empty at the end of the input, for `n <= 0`, or with the errno.
pub fun read(fd: int, n: int) -> str {
    let d = fd_of(fd as int64)
    __set_io_errno(0)
    var want = n as int64
    if want < 0 {
        want = 0
    }
    let cell = __alloc(want + 8)
    var got: int64 = 0
    if want > 0 {
        got = os.read(d, cell + 8, want)
        while got == os.EINTR {
            got = os.read(d, cell + 8, want)
        }
        if got < 0 {
            __set_io_errno(-got)
            got = 0
        }
    }
    let fit = fitted(cell, 8, got)
    __store64(fit, got)
    return __str_of(fit)
}

// `__read_bytes` (D177): `__read`, the bytes read into a list.
pub fun read_bytes(fd: int, n: int) -> [uint8] {
    let d = fd_of(fd as int64)
    __set_io_errno(0)
    var want = n as int64
    if want < 0 {
        want = 0
    }
    let cell = __alloc(want + 16)
    var got: int64 = 0
    if want > 0 {
        got = os.read(d, cell + 16, want)
        while got == os.EINTR {
            got = os.read(d, cell + 16, want)
        }
        if got < 0 {
            __set_io_errno(-got)
            got = 0
        }
    }
    let fit = fitted(cell, 16, got)
    __store64(fit, got)
    __store64(fit + 8, __load64(fit - 16) - 16)
    return __list_of(fit)
}

// `__poll`: 1 when a read of `fd` won't block (input, its end, or an error),
// 0 when `timeout_ms` (negative: none) ran out, -1 with the errno when poll
// failed; retried on EINTR.
pub fun poll(fd: int, timeout_ms: int) -> int {
    let d = fd_of(fd as int64)
    __set_io_errno(0)
    if d < 0 {
        __set_io_errno(EBADF)
        return -1
    }
    var r = os.poll_read(d, timeout_ms as int64)
    while r == os.EINTR {
        r = os.poll_read(d, timeout_ms as int64)
    }
    if r < 0 {
        __set_io_errno(-r)
        return -1
    }
    return r as int
}

// `__poll_write` (MYLA-419): 1 when `fd` has room for a write (a pipe at
// least PIPE_BUF bytes), or a write fails at once (an error, the reader
// gone), 0 when `timeout_ms` (negative: none) ran out, -1 with the errno
// when poll failed; retried on EINTR.
pub fun poll_write(fd: int, timeout_ms: int) -> int {
    let d = fd_of(fd as int64)
    __set_io_errno(0)
    if d < 0 {
        __set_io_errno(EBADF)
        return -1
    }
    var r = os.poll_write(d, timeout_ms as int64)
    while r == os.EINTR {
        r = os.poll_write(d, timeout_ms as int64)
    }
    if r < 0 {
        __set_io_errno(-r)
        return -1
    }
    return r as int
}

// `await __wait_readable(fd)` (`events` 1) or `__wait_writable(fd)` (2) in
// a program without tasks: the thread blocked until `fd` is ready (D124;
// the 2026-11-10 review's S4: a non-blocking input read at once gave
// EAGAIN), at once for a negative descriptor, as with tasks.
pub fun wait_alone(fd: int, events: int) {
    let d = fd_of(fd as int64)
    if d < 0 {
        return
    }
    var r: int64 = 0
    if events == 2 {
        r = os.poll_write(d, -1)
    } else {
        r = os.poll_read(d, -1)
    }
    while r == os.EINTR {
        if events == 2 {
            r = os.poll_write(d, -1)
        } else {
            r = os.poll_read(d, -1)
        }
    }
}

// --- the program's arguments -------------------------------------------------

// `__args`: the program's arguments, its own path first.
pub fun args() -> [str] {
    var out: [str] = []
    var at = __argv()
    while true {
        let c = __load64(at)
        if c == 0 {
            break
        }
        var len: int64 = 0
        while __load8(c + len) != 0u8 {
            len += 1
        }
        let p = __alloc(len + 8)
        __store64(p, len)
        __copy_bytes(p + 8, c, len)
        out.push(__str_of(p))
        at += 8
    }
    return out
}

// --- numbers as text ---------------------------------------------------------

// How many decimal digits `u` has.
#test(0u64)[1]
#test(9u64)[1]
#test(10u64)[2]
#test(18446744073709551615u64)[20]
fun digit_count(u: uint64) -> int64 {
    var n: int64 = 1
    var p: uint64 = 10
    while n < 20 && u >= p {
        n += 1
        p = p.wrapping_mul(10)   // past 10^19 only as the loop ends
    }
    return n
}

// `u`'s `n` digits written to `at`, the last first.
fun put_digits(u0: uint64, at: int64, n: int64) {
    var u = u0
    var i = n - 1
    while i >= 0 {
        let q = u / 10  // one division a digit: the remainder from the quotient
        __store8(at + i, ((u - q * 10) as uint8) + 48u8)
        u = q
        i -= 1
    }
}

// `__uint_to_str`: an unsigned integer in decimal.
pub fun uint_to_str(u: uint64) -> str {
    let n = digit_count(u)
    let p = __alloc(n + 8)
    __store64(p, n)
    put_digits(u, p + 8, n)
    return __str_of(p)
}

// `__bool_to_str`: `true` or `false`.
pub fun bool_to_str(b: bool) -> str {
    if b {
        return "true"
    }
    return "false"
}

// `__char_to_str`: a character as the string of its UTF-8 bytes.
pub fun char_to_str(c: char) -> str {
    let u = c as int64
    if u < 128 {
        let p = __alloc(9)
        __store64(p, 1)
        __store8(p + 8, u as uint8)
        return __str_of(p)
    }
    if u < 2048 {
        let p = __alloc(10)
        __store64(p, 2)
        __store8(p + 8, (192 | (u >> 6)) as uint8)
        __store8(p + 9, (128 | (u & 63)) as uint8)
        return __str_of(p)
    }
    if u < 65536 {
        let p = __alloc(11)
        __store64(p, 3)
        __store8(p + 8, (224 | (u >> 12)) as uint8)
        __store8(p + 9, (128 | ((u >> 6) & 63)) as uint8)
        __store8(p + 10, (128 | (u & 63)) as uint8)
        return __str_of(p)
    }
    let p = __alloc(12)
    __store64(p, 4)
    __store8(p + 8, (240 | ((u >> 18) & 7)) as uint8)
    __store8(p + 9, (128 | ((u >> 12) & 63)) as uint8)
    __store8(p + 10, (128 | ((u >> 6) & 63)) as uint8)
    __store8(p + 11, (128 | (u & 63)) as uint8)
    return __str_of(p)
}

// `__int_to_str`: a signed integer in decimal, a `-` before a negative one.
pub fun int_to_str(v: int64) -> str {
    if v >= 0 {
        return uint_to_str(v as uint64)
    }
    let u = (v as uint64).wrapping_neg()
    let n = digit_count(u)
    let p = __alloc(n + 9)
    __store64(p, n + 1)
    __store8(p + 8, 45u8)  // '-'
    put_digits(u, p + 9, n)
    return __str_of(p)
}

// --- lists -------------------------------------------------------------------
//
// A list's cell holds its length, its capacity (8 bytes each), then its
// elements, each as wide as its type keeps it (D120: a `char` 4 bytes).

// The scalar the UTF-8 sequence led by the byte at `p + i` encodes (of `n`
// bytes in all), with its length above bit 32: `cp | len << 32`; U+FFFD and
// 1 for a byte that isn't part of a well-formed sequence (an overlong form,
// a surrogate, beyond U+10FFFF, cut short). Out of `str_chars`' loop, which
// keeps its few values in registers so.
fun decode_at(p: int64, i: int64, n: int64) -> int64 {
    let b = __load8(p + i) as int64
    // the sequence's length, its payload bits, and the least scalar of that
    // length (a smaller one is overlong)
    var need: int64 = 0
    var cp: int64 = 0
    var least: int64 = 0
    if b >= 0xC2 && b < 0xE0 {
        need = 2
        cp = b & 0x1F
        least = 0x80
    } else if b >= 0xE0 && b < 0xF0 {
        need = 3
        cp = b & 0x0F
        least = 0x800
    } else if b >= 0xF0 && b < 0xF5 {
        need = 4
        cp = b & 0x07
        least = 0x10000
    }
    if need == 0 || i + need > n {
        return 0xFFFD | (1i64 << 32)
    }
    var k: int64 = 1
    while k < need {
        let c = __load8(p + i + k) as int64
        if (c & 0xC0) != 0x80 {
            return 0xFFFD | (1i64 << 32)
        }
        cp = (cp << 6) | (c & 0x3F)
        k += 1
    }
    if cp < least || cp > 0x10FFFF || (cp & -2048) == 0xD800 {
        return 0xFFFD | (1i64 << 32)
    }
    return cp | (need << 32)
}

// The character at byte `i` of `s` (`decode_at`, whose `cp | len << 32` it
// gives): a `for c in s` loop's step at a byte that isn't ASCII (MYLA-318;
// raw memory, so its cases are the parity programs' `for_over_a_string`).
pub fun str_char_at(s: str, i: int64) -> int64 {
    let p = __addr_of(s) + 8
    return decode_at(p, i, __load64(p - 8))
}

// `__str_chars` (`s.chars()`): the code points of `s`, U+FFFD for each byte
// that isn't part of a well-formed UTF-8 sequence.
pub fun str_chars(s: str) -> [char] {
    let p = __addr_of(s) + 8
    let n = __load64(p - 8)
    let cell = __alloc(n * 4 + 16)
    var at = cell + 16
    var i: int64 = 0
    while i < n {
        let b = __load8(p + i)
        if b < 128u8 {
            __store32(at, b as uint32)
            i += 1
        } else {
            let r = decode_at(p, i, n)
            __store32(at, (r & LOW32) as uint32)
            i += r >> 32
        }
        at += 4
    }
    __store64(cell, (at - cell - 16) >> 2)
    __store64(cell + 8, n)
    return __list_of(cell)
}

// --- maps --------------------------------------------------------------------
//
// A map's cell holds its count and its capacity (a power of two), then the
// slots `[state:8][key:8][value][rank:8]`, `slot_size` bytes each, then the
// next rank (8 bytes), the first rank that may be a key's (8 bytes: every
// rank below it is a gap), and the order: at each rank below the next, the
// index of the slot that took it (4 bytes, room for one per slot). State 0
// is empty, 1 full, 2 a removed key's tombstone; a key is a value, or a
// string's cell (`is_str` 1). The slot of a key is found by its hash and
// linear probing, past tombstones.
//
// A key's rank is its place in the order of insertion (D105): a new key takes
// the next rank, and the order the slot's index there. A removal leaves a
// tombstone and a gap in the ranks, without touching the other slots, so it
// takes constant time (MYLA-310); a rank is a key's while the slot the order
// names is full and has that rank (a tombstone's slot may be taken again,
// with a rank of its own). `keys` and `for` go through the ranks in order
// and skip the gaps; `for` from the first rank that may be a key's, which it
// moves past the gaps it finds, so a loop that leaves at its first key costs
// the gaps since the last loop, not the map's size (`map_walk`, MYLA-496).
// The next rank counts
// every slot a key has filled since the last compaction, tombstones too, so
// when it reaches 3/4 of the capacity, `map_put_slot` compacts the table:
// tombstones dropped, ranks renumbered 0 … count - 1, the capacity the
// smallest that leaves it at most half full (so it grows, stays or shrinks).
// A removal from a map with fewer keys than an eighth of its capacity
// compacts it the same way (`map_shrink`, MYLA-429), so a map emptied by
// removals shrinks, and walking it costs its keys, not the capacity it once
// had.

const PHI: int64 = -7046029254386353131  // 2^64 / the golden ratio

// The hash of a string's cell: its length and its bytes, eight at a time,
// mixed in with a multiply by 2^64/phi and a rotation, the high half folded
// into the low one, which picks the slot. A value's hash is the value
// multiplied by 2^64/phi, folded the same way. The assembly's `__map_hash`
// computes the same, which the other map routines still use. A compound
// key's hash routine (`__khash_<K>`, MYLA-313) mixes its strings in with it.
pub fun str_hash(key: int64) -> int64 {
    var n = __load64(key)
    var p = key + 8
    var h = n.wrapping_mul(PHI)
    while n >= 8 {
        h = (h ^ __load64(p)).wrapping_mul(PHI)
        h = __rotl(h, 29)
        p += 8
        n -= 8
    }
    while n > 0 {
        h = (h ^ (__load8(p) as int64)).wrapping_mul(PHI)
        p += 1
        n -= 1
    }
    h = h.wrapping_mul(PHI)
    return h ^ (((h as uint64) >> 32) as int64)
}

// `__map_lookup`: the slot holding `key` in the map `cell`, or 0. A value's
// probe loop makes no call, so its values stay in registers.
pub fun map_lookup(cell: int64, key: int64, slot_size: int64, is_str: int64) -> int64 {
    let mask = __load64(cell + 8) - 1
    let slots = cell + 16
    if is_str == 0 {
        let h = key.wrapping_mul(PHI)
        var i = (h ^ (((h as uint64) >> 32) as int64)) & mask
        while true {
            let slot = slots + i * slot_size
            let state = __load64(slot)
            if state == 0 {
                return 0
            }
            if state != 2 && __load64(slot + 8) == key {
                return slot
            }
            i = (i + 1) & mask
        }
    }
    var i = str_hash(key) & mask
    let n = __load64(key)
    while true {
        let slot = slots + i * slot_size
        let state = __load64(slot)
        if state == 0 {
            return 0
        }
        if state != 2 {
            let k = __load64(slot + 8)
            if k == key || (__load64(k) == n && __equal_bytes(k + 8, key + 8, n)) {
                return slot
            }
        }
        i = (i + 1) & mask
    }
    return 0
}

// `n` bytes at `p` zeroed.
fun zero_bytes(p: int64, n: int64) {
    var at = p
    var left = n
    while left >= 8 {
        __store64(at, 0)
        at += 8
        left -= 8
    }
    while left > 0 {
        __store8(at, 0u8)
        at += 1
        left -= 1
    }
}

// `__map_new`: an empty map of `cap` slots of `slot_size` bytes (the next
// rank and the first 0 after them, then room for the order).
pub fun map_new(cap: int64, slot_size: int64) -> int64 {
    let cell = __alloc(cap * slot_size + 32 + cap * 4)
    __store64(cell, 0)
    __store64(cell + 8, cap)
    zero_bytes(cell + 16, cap * slot_size + 16)
    return cell
}

// The address of the map `cell`'s next rank, after its slots; the first rank
// that may be a key's is in the word after it, then the order.
fun map_next_rank(cell: int64, slot_size: int64) -> int64 {
    return cell + 16 + __load64(cell + 8) * slot_size
}

// The full slot that has the rank `r` in the map whose slots start at `slots`
// and whose order is at `order`, or 0 for a gap.
fun map_at_rank(slots: int64, order: int64, slot_size: int64, r: int64) -> int64 {
    let slot = slots + (__load32(order + r * 4) as int64) * slot_size
    if __load64(slot) == 1 && __load64(slot + slot_size - 8) == r {
        return slot
    }
    return 0
}

// `for k in m`'s step (MYLA-496): the full slot of the map `cell` with the
// lowest rank above the slot `after`'s, or from the first rank that may be a
// key's when `after` is 0 (then moved past the gaps found, as a removal only
// makes gaps); 0 when there is none. The loop holds the map, so it doesn't
// change under it.
pub fun map_walk(cell: int64, slot_size: int64, after: int64) -> int64 {
    let slots = cell + 16
    let tail = slots + __load64(cell + 8) * slot_size
    let next = __load64(tail)
    var r: int64 = 0
    if after == 0 {
        r = __load64(tail + 8)
    } else {
        r = __load64(after + slot_size - 8) + 1
    }
    while r < next {
        let slot = map_at_rank(slots, tail + 16, slot_size, r)
        if slot != 0 {
            if after == 0 {
                __store64(tail + 8, r)
            }
            return slot
        }
        r += 1
    }
    if after == 0 {
        __store64(tail + 8, r)
    }
    return 0
}

// The slot of `key` in the map `cell` (which has room), found or made: its
// address, plus 1 when the key was there (its value is then replaced; slots
// are 8-byte aligned). A new key takes the first tombstone on its way, else
// the empty slot it ends at, and the next rank (its index in the order there),
// with a reference to a string key.
fun map_set_slot(cell: int64, key: int64, slot_size: int64, is_str: int64) -> int64 {
    let mask = __load64(cell + 8) - 1
    let slots = cell + 16
    var i: int64 = 0
    var n: int64 = 0
    if is_str == 0 {
        let h = key.wrapping_mul(PHI)
        i = (h ^ (((h as uint64) >> 32) as int64)) & mask
    } else {
        i = str_hash(key) & mask
        n = __load64(key)
    }
    var tomb: int64 = -1
    while true {
        let slot = slots + i * slot_size
        let state = __load64(slot)
        if state == 0 {
            var at = slot
            if tomb >= 0 {
                at = slots + tomb * slot_size
                i = tomb
            }
            let next = slots + (mask + 1) * slot_size
            let rank = __load64(next)
            __store64(at, 1)
            __store64(at + 8, key)
            __store64(at + slot_size - 8, rank)
            __store64(next, rank + 1)
            __store32(next + 16 + rank * 4, i as uint32)
            __store64(cell, __load64(cell) + 1)
            if is_str != 0 {
                __store64(key - 8, __load64(key - 8) + 1)
            }
            return at
        }
        if state == 1 {
            let k = __load64(slot + 8)
            if k == key || (is_str != 0 && __load64(k) == n && __equal_bytes(k + 8, key + 8, n)) {
                return slot + 1
            }
        } else if tomb < 0 {
            tomb = i
        }
        i = (i + 1) & mask
    }
    return 0
}

// `m[key] = v`'s slot (`__map_reserve` and `__map_set_slot` in one): room
// made in the map at `holder` (compacted when empty or when its next rank
// reaches 3/4 of the capacity, the new cell stored back), then `key`'s slot
// as `map_set_slot` gives it.
pub fun map_put_slot(holder: int64, key: int64, slot_size: int64, is_str: int64) -> int64 {
    var cell = __load64(holder)
    let cap = __load64(cell + 8)
    if cap == 0 || (__load64(map_next_rank(cell, slot_size)) + 1) * 4 >= cap * 3 {
        cell = map_rehash(cell, slot_size, is_str, map_fit(__load64(cell)))
        __store64(holder, cell)
    }
    return map_set_slot(cell, key, slot_size, is_str)
}

// The capacity a map of `count` keys is compacted to: the smallest power of
// two, at least 8, that leaves it at most half full with one key more.
fun map_fit(count: int64) -> int64 {
    var fit: int64 = 8
    while (count + 1) * 2 > fit {
        fit = fit * 2
    }
    return fit
}

// `remove`'s compaction (`__map_shrink`, MYLA-429): the map at `holder`,
// which had fewer keys than an eighth of its capacity when a key was removed,
// compacted into the capacity `map_fit` gives (the new cell stored back), so
// a walk over it and the operations after cost its live keys, not the
// capacity it once needed. Each compaction is paid for by the keys removed
// since the last (about an eighth of the capacity at least), so a removal
// stays amortised O(1).
pub fun map_shrink(holder: int64, slot_size: int64, is_str: int64) {
    let cell = __load64(holder)
    let fit = map_fit(__load64(cell))
    if fit < __load64(cell + 8) {
        __store64(holder, map_rehash(cell, slot_size, is_str, fit))
    }
}

// The keys and values of the map `cell` moved into a new one of `cap` slots,
// without tombstones and in their order, ranked 0 … count - 1 (taken by
// rank through the order, from the first that may be a key's); the old cell
// freed.
fun map_rehash(cell: int64, slot_size: int64, is_str: int64, cap: int64) -> int64 {
    let fresh = map_new(cap, slot_size)
    let slots = cell + 16
    let tail = map_next_rank(cell, slot_size)
    let next = __load64(tail)
    var r = __load64(tail + 8)
    while r < next {
        let slot = map_at_rank(slots, tail + 16, slot_size, r)
        if slot != 0 {
            map_moved(fresh, slot, slot_size, is_str)
        }
        r += 1
    }
    __free(cell)
    return fresh
}

// The key and value of the full `slot` moved into the map `fresh` (which has
// room and lacks the key), ranked next there: its new slot.
fun map_moved(fresh: int64, slot: int64, slot_size: int64, is_str: int64) -> int64 {
    let k = __load64(slot + 8)
    let at = map_set_slot(fresh, k, slot_size, is_str)
    if is_str != 0 {
        // the key moved: the new cell's reference is the old one's
        __store64(k - 8, __load64(k - 8) - 1)
    }
    if slot_size > 24 {
        __copy_bytes(at + 16, slot + 16, slot_size - 24)
    }
    return at
}

// `keys(m)` (`__map_keys`): a new list of the keys of the map `cell` in the
// order they were inserted (by rank: without gaps each at its rank, else the
// gaps skipped), as wide as the list's elements are (`stride` bytes), with a
// reference to each string key.
pub fun map_keys(cell: int64, slot_size: int64, stride: int64, is_str: int64) -> int64 {
    let count = __load64(cell)
    let list = __alloc(count * stride + 16)
    __store64(list, count)
    __store64(list + 8, count)
    let next = __load64(map_next_rank(cell, slot_size))
    if next == count {
        var slot = cell + 16
        let end = slot + __load64(cell + 8) * slot_size
        // the common case, written out rather than through `map_key_to`:
        // a call per key cost 14 % on `keys()` of a growing map
        while slot < end {
            if __load64(slot) == 1 {
                let k = __load64(slot + 8)
                if is_str != 0 {
                    let rc = k - 8
                    __store64(rc, __load64(rc) + 1)
                }
                let at = list + 16 + __load64(slot + slot_size - 8) * stride
                if stride == 8 {
                    __store64(at, k)
                } else if stride == 4 {
                    __store32(at, k as uint32)
                } else if stride == 2 {
                    __store8(at, k as uint8)
                    __store8(at + 1, (k >> 8) as uint8)
                } else {
                    __store8(at, k as uint8)
                }
            }
            slot += slot_size
        }
        return list
    }
    let slots = cell + 16
    let tail = map_next_rank(cell, slot_size)
    var at = list + 16
    var r = __load64(tail + 8)
    while r < next {
        let slot = map_at_rank(slots, tail + 16, slot_size, r)
        if slot != 0 {
            map_key_to(at, slot, stride, is_str)
            at += stride
        }
        r += 1
    }
    return list
}

// The key of the full `slot` stored at `at`, `stride` bytes wide, with a
// reference of its own to a string key.
fun map_key_to(at: int64, slot: int64, stride: int64, is_str: int64) {
    let k = __load64(slot + 8)
    if is_str != 0 {
        let rc = k - 8
        __store64(rc, __load64(rc) + 1)
    }
    if stride == 8 {
        __store64(at, k)
    } else if stride == 4 {
        __store32(at, k as uint32)
    } else if stride == 2 {
        __store8(at, k as uint8)
        __store8(at + 1, (k >> 8) as uint8)
    } else {
        __store8(at, k as uint8)
    }
}

// --- maps with compound keys ---------------------------------------------------
//
// A key that isn't an integer, `char`, `bool` or `str` (a tuple, a struct,
// an enum, a list: any `Eq + Hash` type, D163, MYLA-313) has a hash and an
// equality routine of its own, which the code generator builds for its type
// (`__khash_<K>`, `__keq_<K>`) with the routines that find and make its slot
// (`__mfind_<K>`, `__mput_<K>`). Its slot is `[state:8][hash:8][key][value]
// [rank:8]`: the key's words are in it as a value's are, and the hash beside
// them, so the routines below probe, compact and list the keys without
// calling a routine of the key's type. The integers', `char`'s, `bool`'s and
// `str`'s maps keep the routines above.

// The next full slot after `after` (0: from the start) on the probe of the
// hash `h` in the map `cell` whose hash is `h`, or 0 where an empty slot
// ends the probe: the candidates `__mfind_<K>` compares with its key.
pub fun map_find_h(cell: int64, h: int64, slot_size: int64, after: int64) -> int64 {
    let cap = __load64(cell + 8)
    if cap == 0 {
        return 0
    }
    let mask = cap - 1
    let slots = cell + 16
    var i = h & mask
    if after != 0 {
        i = ((after - slots) / slot_size + 1) & mask
    }
    while true {
        let slot = slots + i * slot_size
        let state = __load64(slot)
        if state == 0 {
            return 0
        }
        if state == 1 && __load64(slot + 8) == h {
            return slot
        }
        i = (i + 1) & mask
    }
    return 0
}

// A new slot for a key with the hash `h` that the map at `holder` lacks:
// room made as `map_put_slot` makes it (the new cell stored back), then the
// first tombstone or empty slot on its probe, full, with its hash and the
// next rank. The caller copies the key and the value in.
pub fun map_slot_h(holder: int64, h: int64, slot_size: int64) -> int64 {
    var cell = __load64(holder)
    let cap = __load64(cell + 8)
    if cap == 0 || (__load64(map_next_rank(cell, slot_size)) + 1) * 4 >= cap * 3 {
        cell = map_rehash_h(cell, slot_size, map_fit(__load64(cell)))
        __store64(holder, cell)
    }
    return map_place_h(cell, h, slot_size)
}

// `map_shrink` of a map with compound keys (`__map_shrink_h`).
pub fun map_shrink_h(holder: int64, slot_size: int64) {
    let cell = __load64(holder)
    let fit = map_fit(__load64(cell))
    if fit < __load64(cell + 8) {
        __store64(holder, map_rehash_h(cell, slot_size, fit))
    }
}

// `map_slot_h`'s slot in the map `cell`, which has room: the first empty
// one on the probe, past the tombstones, so the keys of one hash stay on it
// in the order of insertion and are compared oldest first, as the
// interpreter compares them (a key's written `eq` runs alike, MYLA-546).
// A tombstone holds a rank until the next compaction, so the load bound
// holds without reusing them.
fun map_place_h(cell: int64, h: int64, slot_size: int64) -> int64 {
    let mask = __load64(cell + 8) - 1
    let slots = cell + 16
    var i = h & mask
    while true {
        let slot = slots + i * slot_size
        let state = __load64(slot)
        if state == 0 {
            let next = slots + (mask + 1) * slot_size
            let rank = __load64(next)
            __store64(slot, 1)
            __store64(slot + 8, h)
            __store64(slot + slot_size - 8, rank)
            __store64(next, rank + 1)
            __store32(next + 16 + rank * 4, i as uint32)
            __store64(cell, __load64(cell) + 1)
            return slot
        }
        i = (i + 1) & mask
    }
    return 0
}

// `map_rehash` of a map with compound keys: each key and value moved by its
// hash, the references with them.
fun map_rehash_h(cell: int64, slot_size: int64, cap: int64) -> int64 {
    let fresh = map_new(cap, slot_size)
    let slots = cell + 16
    let tail = map_next_rank(cell, slot_size)
    let next = __load64(tail)
    var r = __load64(tail + 8)
    while r < next {
        let slot = map_at_rank(slots, tail + 16, slot_size, r)
        if slot != 0 {
            map_moved_h(fresh, slot, slot_size)
        }
        r += 1
    }
    __free(cell)
    return fresh
}

// The key and value of the full `slot` moved into the map `fresh`, ranked
// next there: its new slot.
fun map_moved_h(fresh: int64, slot: int64, slot_size: int64) -> int64 {
    let at = map_place_h(fresh, __load64(slot + 8), slot_size)
    __copy_bytes(at + 16, slot + 16, slot_size - 24)
    return at
}

// The keys of the map `cell` with compound keys, `key_size` bytes each, in a
// new list in the order of insertion; no reference taken (`__mkeys_<K>`
// takes them).
pub fun map_keys_h(cell: int64, slot_size: int64, key_size: int64) -> int64 {
    let count = __load64(cell)
    let list = __alloc(count * key_size + 16)
    __store64(list, count)
    __store64(list + 8, count)
    let next = __load64(map_next_rank(cell, slot_size))
    if next == count {
        var slot = cell + 16
        let end = slot + __load64(cell + 8) * slot_size
        while slot < end {
            if __load64(slot) == 1 {
                __copy_bytes(list + 16 + __load64(slot + slot_size - 8) * key_size, slot + 16, key_size)
            }
            slot += slot_size
        }
        return list
    }
    let slots = cell + 16
    let tail = map_next_rank(cell, slot_size)
    var at = list + 16
    var r = __load64(tail + 8)
    while r < next {
        let slot = map_at_rank(slots, tail + 16, slot_size, r)
        if slot != 0 {
            __copy_bytes(at, slot + 16, key_size)
            at += key_size
        }
        r += 1
    }
    return list
}

// --- string builders ---------------------------------------------------------
//
// A builder's cell holds its length and its capacity in bytes, then its
// bytes; a builder variable holds its cell, unique when appended to.

// `StringBuilder(n)` (MYLA-369): an empty builder with room for `n` bytes
// (none for a negative `n`), all the cell has: appends up to that many
// copy nothing but their own bytes.
pub fun sb_with_capacity(n: int) -> int64 {
    var want = n as int64
    if want < 0 {
        want = 0
    }
    let cell = __alloc(want + 16)
    __store64(cell, 0)
    __store64(cell + 8, __load64(cell - 16) - 16)
    return cell
}

// `__str_to_bytes(s)` (MYLA-369): the bytes of `s` as a list, in one
// allocation and one copy.
pub fun str_to_bytes(s: str) -> [uint8] {
    let p = __addr_of(s)
    let n = __load64(p)
    let cell = __alloc(n + 16)
    __store64(cell, n)
    __store64(cell + 8, __load64(cell - 16) - 16)
    __copy_bytes(cell + 16, p + 8, n)
    return __list_of(cell)
}

// `__bytes_to_str(b)` (MYLA-369): the bytes `b` as a string, as they are
// (they needn't be UTF-8, D164), in one allocation and one copy.
pub fun bytes_to_str(b: [uint8]) -> str {
    let p = __list_addr(b)
    let n = __load64(p)
    let cell = __alloc(n + 8)
    __store64(cell, n)
    __copy_bytes(cell + 8, p + 16, n)
    return __str_of(cell)
}

// `append(sb, s)`: `s`'s bytes after the builder's (the builder at the
// address `holder`). The fast paths call nothing, so their values stay in
// registers; a full builder is the business of a tail call.
pub fun sb_append(holder: int64, s: str) {
    let src = __addr_of(s)
    let count = __load64(src)
    let cell = __load64(holder)
    let len = __load64(cell)
    let need = len + count
    if need > __load64(cell + 8) {
        sb_append_grown(holder, cell, src + 8, count)
        return
    }
    __store64(cell, need)
    __copy_bytes(cell + 16 + len, src + 8, count)
}

// `append_byte(sb, b)`: one byte after the builder's.
pub fun sb_append_byte(holder: int64, b: uint8) {
    let cell = __load64(holder)
    let len = __load64(cell)
    if len >= __load64(cell + 8) {
        sb_byte_grown(holder, cell, b)
        return
    }
    __store8(cell + 16 + len, b)
    __store64(cell, len + 1)
}

// `sb.append_char(c)` (MYLA-390): the UTF-8 bytes of the character `c`
// after the builder's.
pub fun sb_append_char(holder: int64, c: char) {
    let v = c as int64
    if v < 0x80 {
        sb_append_byte(holder, v as uint8)
    } else if v < 0x800 {
        sb_append_byte(holder, (0xC0 | (v >> 6)) as uint8)
        sb_append_byte(holder, (0x80 | (v & 0x3F)) as uint8)
    } else if v < 0x10000 {
        sb_append_byte(holder, (0xE0 | (v >> 12)) as uint8)
        sb_append_byte(holder, (0x80 | ((v >> 6) & 0x3F)) as uint8)
        sb_append_byte(holder, (0x80 | (v & 0x3F)) as uint8)
    } else {
        sb_append_byte(holder, (0xF0 | (v >> 18)) as uint8)
        sb_append_byte(holder, (0x80 | ((v >> 12) & 0x3F)) as uint8)
        sb_append_byte(holder, (0x80 | ((v >> 6) & 0x3F)) as uint8)
        sb_append_byte(holder, (0x80 | (v & 0x3F)) as uint8)
    }
}

// `__sb_append_bytes`: the `count` bytes at `src` after the builder's (a
// range of a string).
pub fun sb_append_bytes(holder: int64, src: int64, count: int64) {
    let cell = __load64(holder)
    let len = __load64(cell)
    let need = len + count
    if need > __load64(cell + 8) {
        sb_append_grown(holder, cell, src, count)
        return
    }
    __store64(cell, need)
    __copy_bytes(cell + 16 + len, src, count)
}

// The appends to a full builder: the `count` bytes at `src`, or the byte `b`.
fun sb_append_grown(holder: int64, cell: int64, src: int64, count: int64) {
    let len = __load64(cell)
    let bigger = sb_bigger(holder, cell, len + count)
    __copy_bytes(bigger + 16 + len, src, count)
    __store64(bigger, len + count)
}

fun sb_byte_grown(holder: int64, cell: int64, b: uint8) {
    let len = __load64(cell)
    let bigger = sb_bigger(holder, cell, len + 1)
    __store8(bigger + 16 + len, b)
    __store64(bigger, len + 1)
}

// The full builder `cell` at the address `holder` replaced by one twice as
// large (or as large as `need`), so building a long text piece by piece
// stays linear: its bytes copied, the old cell freed, the new one returned.
fun sb_bigger(holder: int64, cell: int64, need: int64) -> int64 {
    let len = __load64(cell)
    var cap = __load64(cell + 8) * 2
    if cap < need {
        cap = need
    }
    if grew_in_place(cell, cap + 16) {
        __store64(cell + 8, __load64(cell - 16) - 16)
        return cell
    }
    let bigger = __alloc(cap + 16)
    __store64(bigger, len)
    __store64(bigger + 8, __load64(bigger - 16) - 16)
    __copy_bytes(bigger + 16, cell + 16, len)
    __free(cell)
    __store64(holder, bigger)
    return bigger
}

// --- printing ----------------------------------------------------------------


// `print(s)` (`__print_str`) and `print` of the other scalars but floats.
// A closed pipe ends the program quietly (D146), another error with a
// runtime error (D153).
pub fun print_str(s: str) {
    let c = __addr_of(s)
    let r = os.write_line(c + 8, __load64(c))
    if r == os.EPIPE {
        broken_pipe()
    }
    if r < 0 {
        write_failed(-r)
    }
}

// A write without a result that failed: the program ends with a runtime
// error saying why (D153; `std.io` says the same for its writes).
fun write_failed(code: int64) {
    write_err(__addr_of("runtime error: write failed: "))
    write_err(__addr_of(errno_text(code)))
    write_err(__addr_of("\n"))
    exit_program(1)
}

// A write to a closed pipe: the program ends quietly, as by SIGPIPE (D146),
// after the exit hook (D187).
fun broken_pipe() {
    exit_hook()
    os.broken_pipe()
}

// What the errno `code` of a failed write means (as `strerror` says it).
#test(28i64)["no space left on device"]
#test(71i64)["errno 71"]
fun errno_text(code: int64) -> str {
    if code == 28 {
        return "no space left on device"
    }
    if code == 5 {
        return "input/output error"
    }
    if code == 9 {
        return "bad file descriptor"
    }
    if code == 27 {
        return "file too large"
    }
    if code == 122 {
        return "disk quota exceeded"
    }
    return format("errno {}", code)
}

pub fun print_int(v: int64) {
    print_str(int_to_str(v))
}

pub fun print_uint(v: uint64) {
    print_str(uint_to_str(v))
}

pub fun print_bool(b: bool) {
    if b {
        print_str("true")
    } else {
        print_str("false")
    }
}

pub fun print_char(c: char) {
    print_str(format("{}", c))
}

// `__write(fd, s)`: `s`'s bytes to the file descriptor `fd`; its error for
// `__io_errno`, 0 when there was none. A closed pipe on the standard output
// or error ends the program quietly (D146).
pub fun write(fd: int, s: str) {
    let d = fd_of(fd as int64)
    let c = __addr_of(s)
    let r = os.write_all(d, c + 8, __load64(c))
    if r == os.EPIPE && (fd == 1 || fd == 2) {
        broken_pipe()
    }
    if r < 0 {
        __set_io_errno(-r)
    } else {
        __set_io_errno(0)
    }
}

// `__write_bytes(fd, b)` (D177): `__write` of the bytes of a list.
pub fun write_bytes(fd: int, b: [uint8]) {
    let d = fd_of(fd as int64)
    let c = __list_addr(b)
    let r = os.write_all(d, c + 16, __load64(c))
    if r == os.EPIPE && (fd == 1 || fd == 2) {
        broken_pipe()
    }
    if r < 0 {
        __set_io_errno(-r)
    } else {
        __set_io_errno(0)
    }
}

// --- runtime errors ------------------------------------------------------------

// The texts of the runtime errors that carry values, as the interpreter
// words them (D183): the trap routines and the lowering's cold paths build
// them, then report them as `__panic` does.

// `list index 7 out of bounds (len 3)` (`__trap_lindex`).
pub fun list_index_text(i: int64, n: int64) -> str {
    return "list index " + int_to_str(i) + " out of bounds (len " + int_to_str(n) + ")"
}

// `string index 9 out of bounds (len 3)` (`__trap_sindex`).
pub fun str_index_text(i: int64, n: int64) -> str {
    return "string index " + int_to_str(i) + " out of bounds (len " + int_to_str(n) + ")"
}

// The same with a `uint64` index, written unsigned (`__trap_luindex`,
// `__trap_suindex`; MYLA-546).
pub fun list_uindex_text(i: int64, n: int64) -> str {
    return "list index " + uint_to_str(i as uint64) + " out of bounds (len " + int_to_str(n) + ")"
}

pub fun str_uindex_text(i: int64, n: int64) -> str {
    return "string index " + uint_to_str(i as uint64) + " out of bounds (len " + int_to_str(n) + ")"
}

// `string range 2..9 out of bounds (len 3)`: `sb.append(s, a, b)` with a
// range that isn't within `s` (`__trap_range`).
pub fun range_text(a: int64, b: int64, n: int64) -> str {
    return "string range " + int_to_str(a) + ".." + int_to_str(b) + " out of bounds (len " + int_to_str(n) + ")"
}

// `invalid char: 55296 is not a Unicode scalar value`.
pub fun char_text(cp: int64) -> str {
    return "invalid char: " + int_to_str(cp) + " is not a Unicode scalar value"
}

// `map key 5 not found`, the key's text (`key_*_text`) given.
pub fun key_text(k: str) -> str {
    return "map key " + k + " not found"
}

// A key's text where the interpreter's differs from the value's print form:
// a `bool` as `True` or `False`, a string quoted and escaped (Python's
// `repr`, as the interpreter's `py_repr_str`).
pub fun key_bool_text(b: bool) -> str {
    if b {
        return "True"
    }
    return "False"
}

// A float's from its print form `s` (`__float_to_str`): an integral value
// with `.0` (`3.0`, `-0.0`), an exponent signed and of two digits at least
// (`1e+300`, `1.5e-07`); `nan`, `inf` and `-inf` as they are.
#test("3")["3.0"]
#test("-0")["-0.0"]
#test("2.5")["2.5"]
#test("1e300")["1e+300"]
#test("1.5e-7")["1.5e-07"]
#test("1e-100")["1e-100"]
#test("-inf")["-inf"]
pub fun key_float_text(s: str) -> str {
    var e = -1
    var point = false
    var i = 0
    while i < s.len() {
        if s[i] == 'e' {
            e = i
        }
        if s[i] == '.' {
            point = true
        }
        i += 1
    }
    if s == "nan" || s == "inf" || s == "-inf" {
        return s
    }
    if e < 0 {
        if point {
            return s
        }
        return s + ".0"
    }
    var sb = StringBuilder()
    sb.append(s, 0, e + 1)
    var d = e + 1
    if s[d] == '-' {
        sb.append("-")
        d += 1
    } else {
        sb.append("+")
    }
    if s.len() - d < 2 {
        sb.append("0")
    }
    sb.append(s, d, s.len())
    return sb.build()
}

pub fun key_str_text(s: str) -> str {
    var has_single = false
    var has_double = false
    for c in s {
        if c == '\'' {
            has_single = true
        }
        if c == '"' {
            has_double = true
        }
    }
    var quote = '\''
    if has_single && !has_double {
        quote = '"'
    }
    var sb = StringBuilder()
    sb.append_char(quote)
    for c in s {
        let cp = c as int32
        if c == '\\' {
            sb.append("\\\\")
        } else if c == quote {
            sb.append_char('\\')
            sb.append_char(c)
        } else if cp == 10 {
            sb.append("\\n")
        } else if cp == 9 {
            sb.append("\\t")
        } else if cp == 13 {
            sb.append("\\r")
        } else if cp < 32 || (cp >= 127 && cp <= 160) || cp == 173 {
            let digits = "0123456789abcdef"
            sb.append("\\x")
            sb.append_byte(digits[(cp / 16) % 16])
            sb.append_byte(digits[cp % 16])
        } else {
            sb.append_char(c)
        }
    }
    sb.append_char(quote)
    return sb.build()
}

// --- the end of the program (D187) ---------------------------------------------------

// `__exit_program(code)`: the program ended with the status `code`, every
// thread with it, after the exit hook: a return from the entry point, an
// `exit`, a runtime error or a stack overflow ends here. It allocates
// nothing.
pub fun exit_program(code: int) {
    exit_hook()
    os.exit(code as int64)
}

// The exit hook: the terminal `__term_raw` made raw, if nothing put it back
// since, back in the mode it had (`__exit_hook`: its descriptor plus one,
// then that mode as a static string's cell). It runs once: taken off before
// it runs, so a failure in it doesn't come back to it.
pub fun exit_hook() {
    let h = __rt_addr("__exit_hook")
    let fd = __load64(h) - 1
    if fd < 0 {
        return
    }
    __store64(h, 0)
    let r = os.term_set_mode(fd, __str_of(h + 24))
}

// `__panic`'s report (a trap, `panic`, a failed `assert`; MYLA-17, MYLA-65):
// `runtime error: <msg>` on stderr (`msg` a string's cell), with a position
// record `pos` (a file name's cell, then the line and the column as 32-bit
// numbers) `  --> file:line:col` after it, then the process ends with 1.
// It allocates nothing: a heap that ran out reports through it too.
pub fun panic_report(msg: int64, pos: int64) {
    report_error(msg, pos)
    exit_program(1)
}

// `panic_report` with tasks: the end waits for the other workers (D97).
pub fun panic_report_tasks(msg: int64, pos: int64) {
    report_error(msg, pos)
    failed_wait()
    exit_program(1)
}

fun report_error(msg: int64, pos: int64) {
    write_err(__addr_of("runtime error: "))
    write_err(msg)
    if pos != 0 {
        write_err(__addr_of("\n  --> "))
        write_err(__load64(pos))
        write_err_num(__load32(pos + 8) as int64)
        write_err_num(__load32(pos + 12) as int64)
    }
    write_err(__addr_of("\n"))
}

// The string whose cell is at `cell` on stderr.
fun write_err(cell: int64) {
    os.write_all(2, cell + 8, __load64(cell))
}

// `:` and `n` in decimal on stderr (its digits in `__panic_buf`).
fun write_err_num(n: int64) {
    let end = __rt_addr("__panic_buf") + 32
    var at = end
    var v = n
    while true {
        at -= 1
        __store8(at, (48 + v % 10) as uint8)
        v = v / 10
        if v == 0 {
            break
        }
    }
    at -= 1
    __store8(at, 58u8)  // ':'
    os.write_all(2, at, end - at)
}

// --- the allocator -----------------------------------------------------------
//
// A cell is `[size:8][count:8]` and then what the program sees, the size a
// multiple of 8 up to 4 KB and a power of two above. A freed cell goes on
// the list for its size (its first word the next cell): the small sizes'
// heads at `__free_buckets + size`, the large ones' at `+ 4104 + 8k` for
// 2^k bytes. A new one comes off that list, else from the arena between
// `__heap_ptr` and `__heap_end`: a chunk of CHUNK bytes the platform maps
// when the last one is full (none before the first cell, D106 (B)). A big
// cell, one that doesn't fit in a chunk, gets a mapping of its own, as big
// as it needs in whole pages, and gives it back when it is freed (D157);
// where the platform can't give memory back (wasm32) it goes on
// `__big_free` instead, for a later big cell it is large enough for (the
// review of 2026-11-06, R6: a power of two for every size and nothing
// reused stopped a list at 2^26 elements). So a program holds about as
// much address space as it uses.

const CHUNK: int64 = 16777216  // 16 MiB, a power of two

// `__alloc`: a cell of at least `n` bytes, its count 1.
pub fun alloc(n: int64) -> int64 {
    var size = (n + 7) & -8
    var slot = __rt_addr("__free_buckets") + size
    if size + 32 > CHUNK {
        // a big cell: a mapping of its own (D157)
        return alloc_big(size, 16, 0)
    }
    if size > 4096 {
        let k = __bsr64(size - 1) + 1
        size = 1i64 << k
        slot = __rt_addr("__free_buckets") + 4104 + k * 8
    }
    let p = __load64(slot)
    if p != 0 {
        __store64(slot, __load64(p))
        __store64(p - 8, 1)
        return p
    }
    let at = __rt_get("__heap_ptr")
    let next = at + 16 + size
    if next <= __rt_get("__heap_end") {
        __store64(__rt_addr("__heap_ptr"), next)
        __store64(at, size)
        __store64(at + 8, 1)
        return at + 16
    }
    return alloc_mapped(size)
}

// A cell of `size` bytes when the arena is full: mapped on its own when it
// is bigger than a chunk, else the first of a new chunk, which becomes the
// arena (the rest of the old one stays unused).
fun alloc_mapped(size: int64) -> int64 {
    if size + 16 > CHUNK {
        return alloc_big(size, 16, 0)
    }
    let m = os.map_memory(CHUNK)
    if m < 0 {
        __trap_oom()
    }
    __store64(__rt_addr("__heap_ptr"), m + 16 + size)
    __store64(__rt_addr("__heap_end"), m + CHUNK)
    __store64(m, size)
    __store64(m + 8, 1)
    return m + 16
}

// `__free`: the cell `p` back on the list for its size.
pub fun free(p: int64) {
    let size = __load64(p - 16)
    // (a big cell's size is at least CHUNK - 32, an arena's at most half a
    // chunk)
    if size + 32 > CHUNK {
        free_big(p, 16)
        return
    }
    var slot = __rt_addr("__free_buckets") + size
    if size > 4096 {
        slot = __rt_addr("__free_buckets") + 4104 + __bsr64(size) * 8
    }
    __store64(p, __load64(slot))
    __store64(slot, p)
}

// With tasks (D92): each worker allocates from chunks of its own, with its
// own lists; a cell freed on another worker goes on its owner's
// `__remote_free` list, which the owner takes back whole before it bumps its
// arena. Many push onto a list, one takes all of it: no lock, and no ABA. A
// worker's chunk is aligned to its size and its first word is the worker's
// number, so a cell's owner is the word at its address rounded down to a
// chunk; a cell bigger than a chunk gets an aligned mapping of its own with
// the same word, the cell in its first chunk.

// `__alloc` with tasks.
pub fun alloc_tasks(n: int64) -> int64 {
    var size = (n + 7) & -8
    var slot = __rt_addr("__free_buckets") + size
    if size + 32 > CHUNK {
        // a big cell: a mapping of its own (D157)
        return alloc_big(size, 32, __rt_get("__worker_id"))
    }
    if size > 4096 {
        let k = __bsr64(size - 1) + 1
        size = 1i64 << k
        slot = __rt_addr("__free_buckets") + 4104 + k * 8
    }
    let p = __load64(slot)
    if p != 0 {
        __store64(slot, __load64(p))
        __store64(p - 8, 1)
        return p
    }
    if __rt_get("__remote_free") != 0 {
        return alloc_drained(n)
    }
    let at = __rt_get("__heap_ptr")
    let next = at + 16 + size
    if next <= __rt_get("__heap_end") {
        __store64(__rt_addr("__heap_ptr"), next)
        __store64(at, size)
        __store64(at + 8, 1)
        return at + 16
    }
    return alloc_tasks_mapped(size)
}

// `alloc_mapped` with tasks: the chunk (or the big cell's mapping) aligned,
// its first word this worker's number, the cell after it.
fun alloc_tasks_mapped(size: int64) -> int64 {
    var span = CHUNK
    if size + 32 > CHUNK {
        return alloc_big(size, 32, __rt_get("__worker_id"))
    }
    let m = map_aligned(span)
    __store64(m, __rt_get("__worker_id"))
    if span == CHUNK {
        __store64(__rt_addr("__heap_ptr"), m + 32 + size)
        __store64(__rt_addr("__heap_end"), m + CHUNK)
    }
    __store64(m + 16, size)
    __store64(m + 24, 1)
    return m + 32
}

// A big cell of at least `size` bytes, `head` bytes after the start of its
// mapping (16; with tasks 32, the first word the worker's number, as a
// chunk's, though nothing reads it): a freed one large enough taken back
// where the platform keeps memory, else a mapping of whole pages, aligned to
// a chunk with tasks (`worker` its first word). Its size is all the mapping
// holds after `head`.
fun alloc_big(size0: int64, head: int64, worker: int64) -> int64 {
    let page: int64 = 65536
    let span = (size0 + head + page - 1) & -page
    if !os.RETURNS_MEMORY {
        // (the platforms that keep memory run one worker, D125: no lock)
        var prev = __rt_addr("__big_free")
        var c = __load64(prev)
        while c != 0 {
            if __load64(c - 16) >= span - head {
                __store64(prev, __load64(c))
                __store64(c - 8, 1)
                return c
            }
            prev = c
            c = __load64(c)
        }
    }
    var m: int64 = 0
    if head == 32 {
        m = map_aligned(span)
        __store64(m, worker)
    } else {
        m = os.map_memory(span)
        if m < 0 {
            __trap_oom()
        }
    }
    __store64(m + head - 16, span - head)
    __store64(m + head - 8, 1)
    return m + head
}

// Whether the cell `p` now holds at least `want` bytes where it is: a big
// cell that ends where the memory does, on a platform that doesn't give
// memory back (wasm32, whose memory grows only at its end), the memory
// grown under it.
fun grew_in_place(p: int64, want: int64) -> bool {
    let size = __load64(p - 16)
    if os.RETURNS_MEMORY || size + 32 <= CHUNK || want <= size {
        return false
    }
    // the memory's end: a mapping of nothing gives it
    if os.map_memory(0) != p + size {
        return false
    }
    let page: int64 = 65536
    let more = (want - size + page - 1) & -page
    if os.map_memory(more) != p + size {
        return false
    }
    __store64(p - 16, size + more)
    return true
}

// The big cell `p` freed: its mapping given back, or kept for a later one
// where the platform can't give memory back.
fun free_big(p: int64, head: int64) {
    if os.RETURNS_MEMORY {
        os.unmap_memory(p - head, __load64(p - 16) + head)
        return
    }
    __store64(p, __rt_get("__big_free"))
    __store64(__rt_addr("__big_free"), p)
}

// `span` bytes (a multiple of CHUNK) mapped at an address that is a
// multiple of CHUNK: more mapped, the ends given back.
fun map_aligned(span: int64) -> int64 {
    let m = os.map_memory(span + CHUNK)
    if m < 0 {
        __trap_oom()
    }
    let start = (m + CHUNK - 1) & -CHUNK
    if start > m {
        os.unmap_memory(m, start - m)
    }
    let end = m + span + CHUNK
    if end > start + span {
        os.unmap_memory(start + span, end - start - span)
    }
    return start
}

// The cells other workers freed taken back onto this worker's lists, then
// `alloc_tasks` again.
fun alloc_drained(n: int64) -> int64 {
    var c = __xchg64(__rt_addr("__remote_free"), 0)
    while c != 0 {
        let next = __load64(c)
        free(c)
        c = next
    }
    return alloc_tasks(n)
}

// `__free` with tasks: another worker's cell onto its owner's list; a big
// one given back wherever it is freed.
pub fun free_tasks(p: int64) {
    if __load64(p - 16) + 32 > CHUNK {
        free_big(p, 32)
        return
    }
    let owner = __load64(p & -CHUNK)
    if owner != __rt_get("__worker_id") {
        let slot = __rt_waddr("__remote_free", owner)
        while true {
            let head = __load64(slot)
            __store64(p, head)
            if __cas64(slot, head, p) {
                return
            }
        }
    }
    let size = __load64(p - 16)
    var slot = __rt_addr("__free_buckets") + size
    if size > 4096 {
        slot = __rt_addr("__free_buckets") + 4104 + __bsr64(size) * 8
    }
    __store64(p, __load64(slot))
    __store64(slot, p)
}

// --- the executor --------------------------------------------------------------
// What a program with tasks runs on (D92). These run before the workers
// start, and allocate nothing.

const MAX_WORKERS: int64 = 32

// The bytes after `prefix` in the first entry of the environment that starts
// with it, 0 when none does.
fun env_after(prefix: str) -> int64 {
    let pp = __addr_of(prefix)
    let n = __load64(pp)
    var entry = __environ()
    while true {
        let e = __load64(entry)
        if e == 0 {
            return 0
        }
        if __equal_bytes(e, pp + 8, n) {
            return e + n
        }
        entry += 8
    }
    return 0
}

// The number the decimal digits at `p` spell (wrapping), stopping once it is
// past `limit`.
fun digits_at(p: int64, limit: int64) -> int64 {
    var n: int64 = 0
    var q = p
    while true {
        let d = (__load8(q) as int64) - 48
        if d < 0 || d > 9 || n > limit {
            return n
        }
        n = n.wrapping_mul(10).wrapping_add(d)
        q += 1
    }
    return n
}

// The order ready frames run in, from MYLA_SCHED (D110, MYLA-231): `fifo`
// (1), `seed:N` (2, the generator seeded with N); anything else keeps the
// default, the newest first (0).
pub fun sched_init() {
    let v = env_after("MYLA_SCHED=")
    if v == 0 {
        return
    }
    let word = __load32(v)
    if word == 1868982630u32 && __load8(v + 4) == 0u8 {  // "fifo"
        __store64(__rt_addr("__exec_sched"), 1)
    } else if word == 1684366707u32 && __load8(v + 4) == 58u8 {  // "seed:"
        __store64(__rt_addr("__exec_rng"), digits_at(v + 5, 9223372036854775807))
        __store64(__rt_addr("__exec_sched"), 2)
    }
}

// How many workers run the tasks: MYLA_THREADS when the environment has it,
// else the CPUs this process may run on; at least 1, at most MAX_WORKERS.
pub fun workers_count() -> int64 {
    var n: int64 = 0
    let v = env_after("MYLA_THREADS=")
    if v != 0 {
        n = digits_at(v, 100000)
    } else {
        n = os.cpus_allowed()
    }
    if n == 0 {
        return 1
    }
    if n > MAX_WORKERS {
        return MAX_WORKERS
    }
    return n
}

// A task's first frame keeps its flags in word 48 (2: asked to stop, D96) and
// its parent task in word 56.

// `__task_cancel`: the child task whose first frame is `fr` asked to stop;
// none (0: joined already) is left alone. Its sleepers and readers (and its
// children's) go on at once (D124). Under the timers' lock, which a task
// takes to look at its flags before it waits (`timer_add`, `wait_fds`), so
// none starts waiting unseen after this (MYLA-163: a cancel between a
// sleeper's look and its timer let it sleep its whole time).
pub fun task_cancel(fr: int64) {
    if fr == 0 {
        return
    }
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    cancel_locked(fr)
    give_lock(lock)
}

// `__task_cancelled`: 1 when the running task or a task above it was asked to
// stop, else 0.
pub fun task_cancelled() -> int64 {
    var t = __rt_get("__exec_task")
    while t != 0 {
        if (__load64(t + 48) & 2) != 0 {
            return 1
        }
        t = __load64(t + 56)
    }
    return 0
}

// `__failed_wait`: once a task has failed (D97), until no other worker runs
// a frame; at once otherwise.
pub fun failed_wait() {
    if __rt_get("__exec_failing") != 0 {
        wait_stopped()
    }
}

// `__wait_stopped`: until no other worker runs a frame, each worker's
// current one looked at again from the first once one does.
pub fun wait_stopped() {
    let me = __rt_get("__worker_id")
    var w: int64 = 0
    while w < __rt_get("__exec_workers") {
        if w != me && __load64(__rt_waddr("__exec_cur", w)) != 0 {
            __pause()
            w = 0
        } else {
            w += 1
        }
    }
}

// --- the executor's queues -------------------------------------------------------
// Each worker has a queue of ready frames (D92, MYLA-140): a ring of its own
// (EXEC_CAP frames, at `__wq_rings` + its index * 8 MiB) and a record
// `[lock][head][tail]` (a cache line of `__wq`; the counters run either way,
// the ring's index is the counter masked). A worker pushes onto its own
// queue's tail and takes its newest frame (depth first: a task's children
// before its siblings'), else steals the oldest frame of the next queue that
// has one (the biggest piece of a tree of tasks); a frame yielding a turn goes
// to the oldest end, behind the others (D110: depth-first, with one worker the
// order of the self-hosted interpreter). MYLA_SCHED changes it (`sched_init`):
// `fifo` (1) takes the oldest (a yield goes to the newest end); `seed:N` (2)
// queues each push at the end a generator seeded with N picks (a yield still
// behind the others). `__exec_seq` counts the pushes, the word sleeping
// workers wait on (futex); `__exec_sleepers` counts those asleep.
//
// Nothing here allocates, and the lock is never held across a trap.

const EXEC_CAP: int64 = 1048576
const SCHED_MUL: int64 = 6364136223846793005
const SCHED_ADD: int64 = 1442695040888963407

// The record of worker `w`'s queue.
fun wq_of(w: int64) -> int64 {
    return __rt_addr("__wq") + (w << 6)
}

// Take the spin lock in the word at `p` (a queue's or an actor's record):
// an exchange, so nothing after it is seen before it (MYLA-267).
fun take_lock(p: int64) {
    while __xchg64(p, 1) != 0 {
        __pause()
    }
}

// Give the lock at `p` back: a release store, so everything written while
// it was held is seen by whoever takes it next. A plain store would do on
// x86-64, but aarch64 may make it visible before them (MYLA-267).
fun give_lock(p: int64) {
    __store_rel64(p, 0)
}

// Worker `w`'s ring (its slot for the counter `n`: `+ ((n & (EXEC_CAP - 1))
// << 3)`).
fun ring_of(w: int64) -> int64 {
    return __rt_get("__wq_rings") + (w << 23)
}

// After a push: a worker that went to sleep before it saw the queue empty
// after counting itself a sleeper, so the count is read after the push.
fun exec_pushed() {
    __fetch_add64(__rt_addr("__exec_seq"), 1)
    if __rt_get("__exec_sleepers") != 0 {
        os.unpark_one(__rt_addr("__exec_seq"))
    }
    if __rt_get("__exec_polling") != 0 {
        os.poller_wake(__rt_get("__exec_poller"))
    }
}

// `__exec_push`: the frame `fr` onto the running worker's queue, its newest
// end (seed:N: the end the generator's next value picks, its bit 33, as the
// interpreter's `Interp.ready`); a sleeping worker woken.
pub fun exec_push(fr: int64) {
    let w = __rt_get("__worker_id")
    let q = wq_of(w)
    take_lock(q)
    if __rt_get("__exec_sched") == 2 {
        let x = __rt_get("__exec_rng").wrapping_mul(SCHED_MUL).wrapping_add(SCHED_ADD)
        __store64(__rt_addr("__exec_rng"), x)
        if ((x >> 33) & 1) != 0 {
            push_oldest(q, w, fr)
            return
        }
    }
    let tail = __load64(q + 16)
    if tail - __load64(q + 8) >= EXEC_CAP {
        // the ring full: out of memory, the lock given back first
        give_lock(q)
        __trap_oom()
    }
    __store64(ring_of(w) + ((tail & (EXEC_CAP - 1)) << 3), fr)
    __store64(q + 16, tail + 1)
    give_lock(q)
    exec_pushed()
}

// `fr` onto the oldest end of worker `w`'s queue `q`, whose lock is taken.
fun push_oldest(q: int64, w: int64, fr: int64) {
    let head = __load64(q + 8) - 1
    if __load64(q + 16) - head > EXEC_CAP {
        give_lock(q)
        __trap_oom()
    }
    __store64(q + 8, head)
    __store64(ring_of(w) + ((head & (EXEC_CAP - 1)) << 3), fr)
    give_lock(q)
    exec_pushed()
}

// `__exec_yield_push`: the frame `fr` yielding a turn, onto the oldest end of
// the running worker's queue (fifo: the newest, as any push).
pub fun exec_yield_push(fr: int64) {
    if __rt_get("__exec_sched") == 1 {
        exec_push(fr)
        return
    }
    let w = __rt_get("__worker_id")
    let q = wq_of(w)
    take_lock(q)
    push_oldest(q, w, fr)
}

// `__exec_find`: the running worker's newest frame (fifo: its oldest), else
// the oldest frame of the next queue that has one; 0 when none has.
pub fun exec_find() -> int64 {
    let me = __rt_get("__worker_id")
    if __rt_get("__exec_sched") != 1 {
        let q = wq_of(me)
        // a glance first: an empty queue's lock isn't taken
        if __load64(q + 8) != __load64(q + 16) {
            take_lock(q)
            let tail = __load64(q + 16) - 1
            if tail >= __load64(q + 8) {
                __store64(q + 16, tail)
                let fr = __load64(ring_of(me) + ((tail & (EXEC_CAP - 1)) << 3))
                give_lock(q)
                return fr
            }
            give_lock(q)
        }
    }
    return exec_steal(me)
}

// The oldest frame of each queue in turn, starting with worker `me`'s own; 0
// when none has one.
fun exec_steal(me: int64) -> int64 {
    let n = __rt_get("__exec_workers")
    var w = me
    var left = n
    while left > 0 {
        let q = wq_of(w)
        if __load64(q + 8) != __load64(q + 16) {
            take_lock(q)
            let head = __load64(q + 8)
            if head != __load64(q + 16) {
                let fr = __load64(ring_of(w) + ((head & (EXEC_CAP - 1)) << 3))
                __store64(q + 8, head + 1)
                give_lock(q)
                return fr
            }
            give_lock(q)
        }
        w += 1
        if w >= n {
            w = 0
        }
        left -= 1
    }
    return 0
}

// `__exec_peek`: 1 when some queue has a frame (a glance, no lock taken).
pub fun exec_peek() -> int64 {
    let n = __rt_get("__exec_workers")
    var q = __rt_addr("__wq")
    var w: int64 = 0
    while w < n {
        if __load64(q + 8) != __load64(q + 16) {
            return 1
        }
        q += 64
        w += 1
    }
    return 0
}

// --- waiting for a task, actors ----------------------------------------------------
// A frame waiting for a task is linked to the next one through its word 32,
// the first in the task's `task` word (24: 0 running, the first frame waiting
// while it runs, 1 done). An actor's executor (D92) is the record
// `[lock][running][first waiting][last]`; a frame handed the actor keeps it in
// its word 64 until it runs (dropped, it passes it on, D94).

// `myla___wait(child, frame)`, the frame waiting for the child task: the
// frame to go on with at once (the child has ended), else 0 (it joined the
// frames waiting, a parent and siblings, MYLA-148).
pub fun task_wait(child: int64, fr: int64) -> int64 {
    let at = child + 24
    while true {
        // acquire: the child's result, published before its word became 1
        // (`task_end`'s exchange), is read after this (MYLA-267)
        let first = __load_acq64(at)
        if first == 1 {
            return fr
        }
        __store64(fr + 32, first)
        if __cas64(at, first, fr) {
            return 0
        }
    }
    return 0
}

// `__wake_waiters`: each frame of the list from `first` (0: none), which
// waited for a task that has ended, queued; the next one is read before a
// frame is queued, as it may run and change its word 32 at once.
pub fun wake_waiters(first: int64) {
    var fr = first
    while fr != 0 {
        let next = __load64(fr + 32)
        exec_push(fr)
        fr = next
    }
}

// `myla___actor_enter(record, frame)`: the frame going on holding the actor
// when it is free (returned), else 0, the frame queued (the worker returns to
// the executor). Busy with no frame queued, on more than one worker, it first
// waits a little for the holder to leave (MYLA-150): an actor's methods are
// mostly short, and a frame queued is handed the actor and keeps it until a
// worker resumes it, so every caller after it queues too (a convoy). No one
// waits before it, so the order stays first come, first served.
pub fun actor_enter(rec: int64, fr: int64) -> int64 {
    var spins: int64 = 0
    if __rt_get("__exec_workers") > 1 {
        spins = 1000
    }
    while true {
        take_lock(rec)
        if __load64(rec + 8) == 0 {
            __store64(rec + 8, 1)
            give_lock(rec)
            return fr
        }
        if __load64(rec + 16) == 0 && spins != 0 {
            give_lock(rec)
            while spins != 0 && __load64(rec + 8) != 0 {
                __pause()
                spins -= 1
            }
        } else {
            __store64(fr + 32, 0)
            let last = __load64(rec + 24)
            if last != 0 {
                __store64(last + 32, fr)
            } else {
                __store64(rec + 16, fr)
            }
            __store64(rec + 24, fr)
            give_lock(rec)
            return 0
        }
    }
    return 0
}

// `__actor_leave`: out of the actor whose record is `rec`; the first frame
// waiting is handed it and queued to run, or the actor is free.
pub fun actor_leave(rec: int64) {
    take_lock(rec)
    let fr = __load64(rec + 16)
    if fr == 0 {
        __store64(rec + 8, 0)
        give_lock(rec)
        return
    }
    let next = __load64(fr + 32)
    __store64(rec + 16, next)
    if next == 0 {
        __store64(rec + 24, 0)
    }
    __store64(fr + 64, rec)
    give_lock(rec)
    exec_push(fr)
}

// --- the executor's loop -------------------------------------------------------------


// `__exec_run`'s loop: a worker resuming ready frames for good. The platform
// enters it with the worker's stack recorded (`__exec_sp`), and a worker
// whose task failed (D97, `__task_fail`) comes back to its start on that
// stack: it keeps nothing from one frame to the next.
pub fun exec_run() {
    var turns: int64 = 0
    while true {
        if __rt_get("__timer_count") != 0 {
            timers_fire()
        }
        // descriptors watched: a glance at the poller now and then, for
        // workers too busy to poll (D124)
        if __rt_get("__watch_count") != 0 {
            turns += 1
            if (turns & 63) == 0 {
                exec_glance()
            }
        }
        let fr = exec_find()
        if fr == 0 {
            exec_idle()
        } else {
            // the frame this worker runs, published before the failure flag
            // is looked at (an exchange: a full barrier; `__task_fail` sets
            // the flag, then looks at what the workers run)
            __xchg64(__rt_addr("__exec_cur"), fr)
            if __rt_get("__exec_failing") != 0 {
                // once a task has failed, every frame is dropped, not
                // resumed, an actor handed to it passed on (D94, D97)
                let held = __xchg64(fr + 64, 0)
                if held != 0 {
                    actor_leave(held)
                }
            } else {
                __store64(fr + 64, 0)
                // the running task's first frame, for `task_cancelled`:
                // until control comes back, frames of this task run, but the
                // one resumed may end and be freed meanwhile
                __store64(__rt_addr("__exec_task"), __load64(fr + 40))
                __run_frame(fr)
            }
            __xchg64(__rt_addr("__exec_cur"), 0)
        }
    }
}

// No frame found: this worker counts itself idle and only glances at the
// queues (it stops counting before it takes a frame, so the count is
// exact), a while spinning, then asleep until a push. Every worker idle and
// nothing queued: no task can go on, a runtime error.
fun exec_idle() {
    __fetch_add64(__rt_addr("__exec_idle"), 1)
    if exec_peek() == 0 {
        if exec_all_waiting() {
            exec_stuck()
        }
        // descriptors watched: a look at the poller first, and every 512
        // turns of the spin, without waiting (MYLA-518): a descriptor armed
        // again may be ready at once (the next frame waiting to accept on a
        // listener), and a reply that comes while this worker spins is
        // taken then, not once the spin is over
        var spins: int64 = 4096
        while spins != 0 && exec_peek() == 0 {
            if (spins & 511) == 0 && __rt_get("__watch_count") != 0 {
                exec_glance()
            } else {
                __pause()
            }
            spins -= 1
        }
        if spins == 0 && (__rt_get("__timer_count") != 0 || __rt_get("__watch_count") != 0) && __xchg64(__rt_addr("__exec_polling"), 1) == 0 {
            // tasks asleep: this worker polls (one at a time, D124) until the
            // nearest deadline or a push (`exec_pushed` wakes it), then fires
            // the timers that passed; a last glance after claiming the poll
            exec_poll()
            spins = 1
        }
        if spins == 0 {
            // asleep: counted a sleeper first, then the pushes seen, then a
            // last glance (a push after it changes `__exec_seq`, whose low
            // half the wait compares, and the wait returns at once)
            __fetch_add64(__rt_addr("__exec_sleepers"), 1)
            // read with acquire, so the glance's loads can't be satisfied
            // before it on a weakly ordered CPU (a push between the two would
            // then be missed until the pusher's own worker takes the frame)
            let seen = __load_acq64(__rt_addr("__exec_seq")) & 4294967295
            if exec_peek() == 0 {
                os.park(__rt_addr("__exec_seq"), seen)
            }
            __fetch_add64(__rt_addr("__exec_sleepers"), -1)
        }
    }
    // leaving: counted before this worker can take a frame (exec_find), so
    // a check that began while it was idle sees it left
    __fetch_add64(__rt_addr("__exec_gen"), 1)
    __fetch_add64(__rt_addr("__exec_idle"), -1)
}

// Whether no task can go on: every worker idle for the whole check (no one
// left `exec_idle` meanwhile: `__exec_gen` unchanged), and then no timer,
// no watched descriptor, no frame being taken off them (`__exec_waking`)
// and nothing queued, read in that order. While every worker is idle, a
// frame moves only from the timers or the watches to a queue, counted in
// `__exec_waking` all the way, so these reads can't miss it; a worker that
// takes a frame off a queue or runs one has left `exec_idle` (MYLA-275:
// without the generation, a worker that left and took the last queued
// frame after the idle count was read looked like no one). Each read is a
// read-modify-write, ordered on every processor; the check is rare.
fun exec_all_waiting() -> bool {
    let gen = __fetch_add64(__rt_addr("__exec_gen"), 0)
    if __fetch_add64(__rt_addr("__exec_idle"), 0) < __rt_get("__exec_workers") {
        return false
    }
    if __fetch_add64(__rt_addr("__timer_count"), 0) != 0 || __fetch_add64(__rt_addr("__watch_count"), 0) != 0 {
        return false
    }
    if __fetch_add64(__rt_addr("__exec_waking"), 0) != 0 || exec_peek() != 0 {
        return false
    }
    return __fetch_add64(__rt_addr("__exec_gen"), 0) == gen
}

// --- time: the clock, sleeping, the timers (D124) --------------------------------

// `__clock_ns`: the monotonic clock in nanoseconds.
pub fun clock_ns() -> int64 {
    return os.clock_ns()
}

// `__wall_ns`: the wall clock, nanoseconds since 1970-01-01T00:00:00Z
// (MYLA-334, `std.time.now_utc`).
pub fun wall_ns() -> int64 {
    return os.wall_ns()
}

// `__sleep_ns`: the thread asleep for `n` nanoseconds (`await __sleep(ms)`
// in a program without tasks, the interpreter's sleeping tasks).
pub fun sleep_ns(n: int64) {
    if n > 0 {
        os.sleep_ns(n)
    }
}

// The timers: the frames asleep and the deadlines of tasks (`timeout`), in
// a heap ordered by their time and, for one time, by the order they were
// set. The heap's cell is `__timers`, `[count][cap]` and then
// `[time][seq][frame][cell]` entries, under `__timer_lock`; `__timer_count`
// is its count, read without the lock to see whether there are any. A
// sleeper's entry holds its frame and no cell; a deadline's holds the
// child task's first frame with its low bit set and the cell its `timeout`
// reads, `[fired][place]` (1 once the deadline fired; where its entry is);
// a wait's time limit (MYLA-387) its waiter (`waiter`) with the bit 2 set
// and no cell. Every entry keeps its place where its end looks for it
// (`timer_placed`): a sleeper's in its task's record, a deadline's in its
// cell, a time limit's in its waiter, so none is looked for among all of
// them (MYLA-419's M11, MYLA-456). A worker that finds no frame while there
// are timers polls (`exec_poll`) instead of parking.

const TIMER: int64 = 32

// `myla___sleep(frame, ms)`: the frame asleep for `ms` milliseconds, on the
// timers (its frame function suspends after this call); no time at all in
// a task already asked to stop (D124).
pub fun sleep_frame(fr: int64, ms: int64) {
    let seq = timer_add(os.clock_ns() + ms * 1000000, fr, 0)
}

// `__cancel_after(child, ms)`: the child task whose first frame is `fr`
// cancelled once `ms` milliseconds passed (D124, `task.timeout`): its flags
// get "has a deadline" (4), so its end takes the deadline off; the cell
// `__disarm` reads, which says whether the deadline fired, and which keeps
// the deadline's place among the timers; the task's record holds it, so
// its end takes it off without a scan (MYLA-456; a second deadline of one
// task, which std.task never sets, is looked for: the flag 1). The child
// may have ended already (on another worker, before this ran): its flags
// say so (8, `task_end`), and no deadline is set, so none can fire later
// into a freed frame (the review of 2026-11-06, R1). The flag and the timer
// go in under the timers' lock, so an end that sees the flag finds the
// timer.
pub fun cancel_after(fr: int64, ms: int64) -> int64 {
    let cell = __alloc(16)
    __store64(cell, 0)
    __store64(cell + 8, -1)
    let at = fr + 48
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    while true {
        let flags = __load64(at)
        if (flags & 8) != 0 {
            give_lock(lock)
            return cell
        }
        if __cas64(at, flags, flags | 4) {
            break
        }
    }
    let rec = task_rec(fr)
    if __load64(rec + 32) == 0 {
        __store64(rec + 32, cell)
    } else {
        flags_or(fr, 1)
    }
    let seq = timer_add_locked(os.clock_ns() + ms * 1000000, fr | 1, cell)
    give_lock(lock)
    timers_changed()
    return cell
}

// `__disarm(cell)`: whether the deadline of `cancel_after` had not fired
// (its task ended first); the cell freed.
pub fun disarm(cell: int64) -> bool {
    let fired = __load64(cell)
    __free(cell)
    return fired == 0
}

// `__task_end(fr)`: the task whose first frame is `fr` ended (not the
// entry's): its deadline, if it has one, taken off the timers (a deadline
// that fired did all it does under their lock, so nothing touches the frame
// after this) and its record freed, then the frames waiting for it go on,
// its word saying done.
pub fun task_end(fr: int64) {
    // "ended" (8) unless a deadline was set (4) or it has a record: then
    // under the lock, which whoever sets either holds
    let at = fr + 48
    while true {
        let flags = __load64(at)
        if (flags & 4) != 0 || (flags >> 4) != 0 {
            let lock = __rt_addr("__timer_lock")
            take_lock(lock)
            task_done_locked(fr)
            give_lock(lock)
            break
        }
        if __cas64(at, flags, flags | 8) {
            break
        }
    }
    wake_waiters(__xchg64(fr + 24, 1))
}

// --- the records of tasks (MYLA-456) ----------------------------------------------
// A task that waits (asleep, parked on a notifier, watching a descriptor)
// or has a deadline gets a record, which its first frame's flags word
// holds above the flags (`rec << 4`), made when first needed (`task_rec`)
// and freed with the task (`task_done_locked`): `[parent's record][first
// child's][next sibling's][previous sibling's][deadline's cell][wait]
// [sleeper's place]`. The records form the tree of the tasks below any
// that has one (a task's record is made with its parent's), so a cancel
// visits its task's and its descendants' records, not every timer, waiter
// and watch. `wait` is what the task waits on now, tagged: its frame | 1
// asleep (and its place among the timers, `timer_placed`), its waiter | 2
// parked, its frame's first watch | 3 watching a descriptor (MYLA-518)
// (a task runs one frame at a time, so it waits on one thing). Everything
// here is under the timers' lock.

const TASK_REC: int64 = 56

// The record of the task whose first frame is `t`, made (with its
// parent's) when it has none; the lock held.
fun task_rec(t: int64) -> int64 {
    let have = __load64(t + 48) >> 4
    if have != 0 {
        return have
    }
    let rec = __alloc(TASK_REC)
    zero_words(rec, TASK_REC)
    let parent = __load64(t + 56)
    if parent != 0 {
        let up = task_rec(parent)
        __store64(rec, up)
        let first = __load64(up + 8)
        __store64(rec + 16, first)
        if first != 0 {
            __store64(first + 24, rec)
        }
        __store64(up + 8, rec)
    }
    flags_or(t, rec << 4)
    return rec
}

// The flags of the task `t` with `bits` set.
fun flags_or(t: int64, bits: int64) {
    let at = t + 48
    while true {
        let flags = __load64(at)
        if __cas64(at, flags, flags | bits) {
            break
        }
    }
}

// The record of the task the frame `fr` runs in (0: none); the lock held.
fun rec_of_frame(fr: int64) -> int64 {
    return __load64(__load64(fr + 40) + 48) >> 4
}

// The task `fr` waiting on `w` (tagged), its record made if need be; the
// lock held.
fun waits_on(fr: int64, w: int64) {
    __store64(task_rec(__load64(fr + 40)) + 40, w)
}

// The wait `w` (tagged) of the frame `fr`'s task over, if it is its wait;
// the lock held.
fun wait_over(fr: int64, w: int64) {
    let rec = rec_of_frame(fr)
    if rec != 0 && __load64(rec + 40) == w {
        __store64(rec + 40, 0)
    }
}

// The task whose first frame is `t` ended: its deadline off the timers
// unless it fired, its record off its parent's and freed, its flags
// "ended" (8) and without a record; the lock held.
fun task_done_locked(t: int64) {
    let at = t + 48
    let flags = __load64(at)
    let rec = flags >> 4
    if rec != 0 {
        let cell = __load64(rec + 32)
        if cell != 0 && __load64(cell) == 0 {
            deadline_remove(t, cell)
        }
        // (a child outliving its task, which structured concurrency rules
        // out, would move up to the parent's record)
        let up = __load64(rec)
        var c = __load64(rec + 8)
        while c != 0 {
            let next = __load64(c + 16)
            __store64(c, 0)
            __store64(c + 16, 0)
            __store64(c + 24, 0)
            if up != 0 {
                __store64(c, up)
                let first = __load64(up + 8)
                __store64(c + 16, first)
                if first != 0 {
                    __store64(first + 24, c)
                }
                __store64(up + 8, c)
            }
            c = next
        }
        let next = __load64(rec + 16)
        let prev = __load64(rec + 24)
        if prev != 0 {
            __store64(prev + 16, next)
        } else if up != 0 {
            __store64(up + 8, next)
        }
        if next != 0 {
            __store64(next + 24, prev)
        }
        __free(rec)
    }
    if (flags & 1) != 0 {
        timers_forget(t | 1)
    }
    while true {
        let f = __load64(at)
        if __cas64(at, f, (f & 14) | 8) {
            break
        }
    }
}

// The deadline of the task `t`, whose cell `cell` keeps its place, taken
// off the timers; the lock held.
fun deadline_remove(t: int64, cell: int64) {
    let timers = __rt_get("__timers")
    let i = __load64(cell + 8)
    if timers == 0 || i < 0 || i >= __load64(timers) || __load64(timers + 32 + i * TIMER) != (t | 1) {
        // (never: a deadline's place is kept wherever its timer moves)
        timers_forget(t | 1)
        return
    }
    timer_remove_at(timers, i)
}

// A timer at `at` for `fr` (and `cell`); its order among timers of one time.
// A sleeper (no cell) of a task asked to stop is due at once, its flags read
// under the lock (`task_cancel`).
fun timer_add(at0: int64, fr: int64, cell: int64) -> int64 {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let seq = timer_add_locked(at0, fr, cell)
    give_lock(lock)
    timers_changed()
    return seq
}

// A worker polling until a later time woken to wait for a new timer.
fun timers_changed() {
    if __rt_get("__exec_polling") != 0 {
        os.poller_wake(__rt_get("__exec_poller"))
    }
}

// `timer_add` with the timers' lock held.
fun timer_add_locked(at0: int64, fr: int64, cell: int64) -> int64 {
    var at = at0
    if cell == 0 && task_cancelled() != 0 {
        at = 0
    }
    if __rt_get("__exec_poller") == 0 {
        __store64(__rt_addr("__exec_poller"), os.poller_new())
    }
    var c = __rt_get("__timers")
    if c == 0 || __load64(c) == __load64(c + 8) {
        c = timers_grown(c)
    }
    let seq = __rt_get("__timer_seq")
    __store64(__rt_addr("__timer_seq"), seq + 1)
    if (fr & 3) == 0 {
        // a sleeper: its task's record keeps its place
        waits_on(fr, fr | 1)
    }
    // sifted up from the end
    var i = __load64(c)
    while i > 0 {
        let parent = (i - 1) / 2
        let pe = c + 16 + parent * TIMER
        if !timer_before(at, seq, __load64(pe), __load64(pe + 8)) {
            break
        }
        __copy_bytes(c + 16 + i * TIMER, pe, TIMER)
        timer_placed(c, i)
        i = parent
    }
    let e = c + 16 + i * TIMER
    __store64(e, at)
    __store64(e + 8, seq)
    __store64(e + 16, fr)
    __store64(e + 24, cell)
    timer_placed(c, i)
    __store64(c, __load64(c) + 1)
    __store64(__rt_addr("__timer_count"), __load64(c))
    return seq
}

// The entry at `i` of the timers' cell `cell` just put there, its place
// kept where its end looks for it: a wait's time limit (its waiter tagged
// 2) in its waiter, so that a wake takes it off without looking through
// every timer (`timer_remove`, the 2026-11-09 review's M11); a deadline
// (its task tagged 1) in its cell, for its task's end, and a sleeper in its
// task's record, for a cancel (MYLA-456).
fun timer_placed(cell: int64, i: int64) {
    let e = cell + 16 + i * TIMER
    let fr = __load64(e + 16)
    let tag = fr & 3
    if tag == 2 {
        __store64(fr - 2 + 80, i)
    } else if tag == 1 {
        __store64(__load64(e + 24) + 8, i)
    } else {
        __store64(rec_of_frame(fr) + 48, i)
    }
}

// Whether the timer `(a, sa)` is due before `(b, sb)`.
fun timer_before(a: int64, sa: int64, b: int64, sb: int64) -> bool {
    return a < b || (a == b && sa < sb)
}

// The timers' cell `cell` (0: none yet) moved into one twice as big.
fun timers_grown(cell: int64) -> int64 {
    var cap: int64 = 16
    var n: int64 = 0
    if cell != 0 {
        n = __load64(cell)
        cap = __load64(cell + 8) * 2
    }
    let bigger = __alloc(16 + cap * TIMER)
    __store64(bigger, n)
    __store64(bigger + 8, cap)
    if cell != 0 {
        __copy_bytes(bigger + 16, cell + 16, n * TIMER)
        __free(cell)
    }
    __store64(__rt_addr("__timers"), bigger)
    return bigger
}

// The timers that passed taken off: a sleeper's frame queued on this worker
// so that the earliest runs first (the newest runs first, D110, so they are
// pushed latest first; with MYLA_SCHED=fifo, earliest first); a deadline
// cancels its task, under the lock, and its sleepers' time comes at once.
fun timers_fire() {
    let now = os.clock_ns()
    let lock = __rt_addr("__timer_lock")
    var due: [int64] = []
    __fetch_add64(__rt_addr("__exec_waking"), 1)
    take_lock(lock)
    while true {
        let cell = __rt_get("__timers")
        if cell == 0 || __load64(cell) == 0 || __load64(cell + 16) > now {
            break
        }
        let fr = __load64(cell + 32)
        let rec = __load64(cell + 40)
        timers_pop(cell)
        if (fr & 1) != 0 {
            __store64(rec, 1)
            cancel_locked(fr - 1)
        } else if (fr & 2) != 0 {
            // a wait on a notifier whose time passed (MYLA-387)
            let w = fr - 2
            unpark_locked(w, 3, false)
            due.push(__load64(w))
        } else {
            wait_over(fr, fr | 1)
            due.push(fr)
        }
    }
    give_lock(lock)
    if __rt_get("__exec_sched") == 1 {
        for fr in due {
            exec_push(fr)
        }
    } else {
        var i = due.len()
        while i > 0 {
            i -= 1
            exec_push(due[i])
        }
    }
    __fetch_add64(__rt_addr("__exec_waking"), -1)
}

// The task whose first frame is `t` asked to stop (its flags' 2), and the
// time of every sleeper of it or a task below it come (D124: a cancelled
// task's sleep ends at once), every wait of theirs on a notifier or a
// descriptor ended; the timers' lock held. They are found through the
// records of `t` and the tasks below it (MYLA-456), where every timer,
// parked waiter and watch was looked at.
fun cancel_locked(t: int64) {
    flags_or(t, 2)
    let top = __load64(t + 48) >> 4
    if top == 0 {
        return
    }
    // the records of the tree below `top`, depth first
    var r = top
    while true {
        cancel_wait(r)
        let child = __load64(r + 8)
        if child != 0 {
            r = child
        } else {
            while r != top && __load64(r + 16) == 0 {
                r = __load64(r)
            }
            if r == top {
                return
            }
            r = __load64(r + 16)
        }
    }
}

// The wait of the task whose record is `r` ended by a cancel: a sleeper's
// time come (it fires with the next timers), a parked waiter taken off its
// notifier (and its time limit off the timers) and queued, a frame waiting
// for input no longer watched and queued (its read sees the request); the
// lock held.
fun cancel_wait(r: int64) {
    let w = __load64(r + 40)
    let kind = w & 3
    let p = w - kind
    if kind == 1 {
        let cell = __rt_get("__timers")
        let i = __load64(r + 48)
        if cell != 0 && i >= 0 && i < __load64(cell) && __load64(cell + 32 + i * TIMER) == p {
            __store64(cell + 16 + i * TIMER, 0)
            let top = timer_sift_up(cell, i)
        }
    } else if kind == 2 {
        let wf = __load64(p)
        unpark_locked(p, 4, true)
        exec_push(wf)
    } else if kind == 3 {
        // every watch of the frame taken (and its descriptors unwatched
        // when no other frame waits for them), so it is queued once
        exec_push(frame_unwatch(p))
    }
}

// Every timer for `fr` (a deadline's tagged frame) taken off; the lock held.
fun timers_forget(fr: int64) {
    let cell = __rt_get("__timers")
    if cell == 0 {
        return
    }
    var n = __load64(cell)
    var i: int64 = 0
    var gone = false
    while i < n {
        let e = cell + 16 + i * TIMER
        if __load64(e + 16) == fr {
            n -= 1
            __copy_bytes(e, cell + 16 + n * TIMER, TIMER)
            timer_placed(cell, i)
            gone = true
        } else {
            i += 1
        }
    }
    if gone {
        __store64(cell, n)
        __store64(__rt_addr("__timer_count"), n)
        timers_heapify(cell)
    }
}

// The time limit of the parked waiter `w` taken off the timers, from the
// place it keeps (`timer_placed`): the last timer moved into it and sifted
// up or down, so a wake costs O(log timers), not a look at each (M11). The
// lock held.
fun timer_remove(w: int64) {
    let cell = __rt_get("__timers")
    let i = __load64(w + 80)
    if cell == 0 || i < 0 || i >= __load64(cell) || __load64(cell + 32 + i * TIMER) != (w | 2) {
        // (never: a waiter's place is kept wherever its timer moves)
        timers_forget(w | 2)
        return
    }
    timer_remove_at(cell, i)
}

// The timer at `i` of the cell `cell` taken off: the last one moved into
// its place and sifted up or down. The lock held.
fun timer_remove_at(cell: int64, i: int64) {
    let n = __load64(cell) - 1
    __store64(cell, n)
    __store64(__rt_addr("__timer_count"), n)
    if i == n {
        return
    }
    __copy_bytes(cell + 16 + i * TIMER, cell + 16 + n * TIMER, TIMER)
    timer_placed(cell, i)
    timer_sift(cell, timer_sift_up(cell, i), n)
}

// The timer at `i0` of the cell `cell` sifted up: where it ends.
fun timer_sift_up(cell: int64, i0: int64) -> int64 {
    let tmp = __rt_addr("__timer_tmp")
    var i = i0
    while i > 0 {
        let parent = (i - 1) / 2
        let e = cell + 16 + i * TIMER
        let pe = cell + 16 + parent * TIMER
        if !timer_before(__load64(e), __load64(e + 8), __load64(pe), __load64(pe + 8)) {
            return i
        }
        __copy_bytes(tmp, e, TIMER)
        __copy_bytes(e, pe, TIMER)
        __copy_bytes(pe, tmp, TIMER)
        timer_placed(cell, i)
        timer_placed(cell, parent)
        i = parent
    }
    return i
}

// The earliest timer of the cell `cell` (not empty) taken off: the last one
// moved to the top and sifted down.
fun timers_pop(cell: int64) {
    let n = __load64(cell) - 1
    __store64(cell, n)
    __store64(__rt_addr("__timer_count"), n)
    if n == 0 {
        return
    }
    __copy_bytes(cell + 16, cell + 16 + n * TIMER, TIMER)
    timer_placed(cell, 0)
    timer_sift(cell, 0, n)
}

// The heap of the cell `cell` made whole again after times changed.
fun timers_heapify(cell: int64) {
    let n = __load64(cell)
    var i = n / 2
    while i > 0 {
        i -= 1
        timer_sift(cell, i, n)
    }
}

// The timer at `i` sifted down among the `n` of the cell `cell`.
fun timer_sift(cell: int64, i0: int64, n: int64) {
    let tmp = __rt_addr("__timer_tmp")
    var i = i0
    while true {
        var child = 2 * i + 1
        if child >= n {
            return
        }
        let ce = cell + 16 + child * TIMER
        if child + 1 < n {
            let re = ce + TIMER
            if timer_before(__load64(re), __load64(re + 8), __load64(ce), __load64(ce + 8)) {
                child += 1
            }
        }
        let c = cell + 16 + child * TIMER
        let e = cell + 16 + i * TIMER
        if !timer_before(__load64(c), __load64(c + 8), __load64(e), __load64(e + 8)) {
            return
        }
        // swapped through a scratch entry (the lock held: one at a time)
        __copy_bytes(tmp, e, TIMER)
        __copy_bytes(e, c, TIMER)
        __copy_bytes(c, tmp, TIMER)
        timer_placed(cell, i)
        timer_placed(cell, child)
        i = child
    }
}

// The poll of an idle worker (it holds `__exec_polling`): until the nearest
// deadline, or a push or a new timer wakes it, unless a frame is queued
// already; then the timers that passed fire.
fun exec_poll() {
    if exec_peek() == 0 {
        var timeout: int64 = -1
        let lock = __rt_addr("__timer_lock")
        take_lock(lock)
        let cell = __rt_get("__timers")
        if cell != 0 && __load64(cell) != 0 {
            let left = __load64(cell + 16) - os.clock_ns()
            timeout = 0
            if left > 0 {
                // rounded up: woken before the deadline, it would poll again
                timeout = (left + 999999) / 1000000
            }
        }
        give_lock(lock)
        if timeout != 0 {
            let woken = poll_events(os.poller_wait(__rt_get("__exec_poller"), timeout))
            __store_rel64(__rt_addr("__exec_polling"), 0)
            push_woken(woken)
            timers_fire()
            return
        }
    }
    __store_rel64(__rt_addr("__exec_polling"), 0)
    timers_fire()
}

// A busy worker's look at the poller, when no other worker polls: the
// frames whose descriptors became readable queued.
fun exec_glance() {
    if __xchg64(__rt_addr("__exec_polling"), 1) == 0 {
        let woken = poll_events(os.poller_wait(__rt_get("__exec_poller"), 0))
        __store_rel64(__rt_addr("__exec_polling"), 0)
        push_woken(woken)
    }
}

// The `n` events of the last wait (the poll held): for each descriptor
// ready, the first frame waiting to receive (or read) on it queued if it is
// ready for that, and the first waiting to send if it is ready for that,
// each with its other watch taken off, unless a cancel took them already;
// the descriptor armed again for the frames that still wait (MYLA-518).
// The poller's watch is level-triggered and fires once: armed again while
// the descriptor is still ready (a second connection to accept, data the
// woken frame left), it fires again, and the next waiter is woken then. So
// N tasks accepting on one listener cost O(1) a connection, where every
// waiter was woken and all but one watched again. The frames woken, which
// `push_woken` queues once the poll is given back (a push while it is held
// would write to the poller to wake its holder: this worker);
// `__exec_waking` counts them until then.
fun poll_events(n: int64) -> [int64] {
    let lock = __rt_addr("__timer_lock")
    __fetch_add64(__rt_addr("__exec_waking"), 1)
    var woken: [int64] = []
    let t = __rt_get("__watches")
    if t != 0 && __load64(t + 8) != 0 {
        woken = woken_later(woken)
    }
    var i: int64 = 0
    while i < n {
        let tok = os.poller_event(i)
        if tok != 0 {
            let ready = os.poller_event_ready(i)
            take_lock(lock)
            var a: int64 = 0
            var b: int64 = 0
            let slot = watch_slot(tok - 1)
            if slot != 0 {
                // (fired: the poller watches it no more)
                __store64(slot + 40, 0)
                if (ready & 1) != 0 {
                    a = watch_first(slot, 1)
                    if a != 0 {
                        a = watch_fired(a)
                    }
                }
                if (ready & 2) != 0 {
                    b = watch_first(slot, 2)
                    if b != 0 {
                        b = watch_fired(b)
                    }
                }
                if __load64(slot) != 0 {
                    let armed = slot_arm(tok - 1, slot)
                }
            }
            give_lock(lock)
            if a != 0 {
                woken.push(a)
            }
            if b != 0 {
                woken.push(b)
            }
        }
        i += 1
    }
    return woken
}

// The frames `poll_events` woke queued, and no longer counted waking.
fun push_woken(woken: [int64]) {
    for fr in woken {
        exec_push(fr)
    }
    __fetch_add64(__rt_addr("__exec_waking"), -1)
}

// --- descriptors: frames waiting for input (D124) --------------------------------
// `__watches`, under the timers' lock: a table indexed by descriptor,
// `[cap][woken]` and then `cap` slots (MYLA-518; `woken`: the frames a
// close woke, for the next poll to queue), each `[first watch][last
// watch][receivers][senders][sockets][armed][known][tag]`: the frames
// waiting for that descriptor in the order they came, how many wait to
// receive (or read) and to send, how many of them wait for a socket
// (`os.poller_watch_socket`; the others for a descriptor to read,
// `os.poller_watch`), what the poller watches the descriptor for now
// (`events`, 5 for a read through `poller_watch`, 0: nothing), whether the
// poller has it (1: watched before and not forgotten, so it is armed
// again, not added: its watch fires once and stays), and the tag of its
// socket's last parking (a lot's, below). A watch is `[fd][frame][events]
// [next][previous][other]`: `events` 0 for a descriptor waited for until
// it is readable, else what a socket is waited for (1 to receive, 2 to
// send; MYLA-346); `other` the frame's other watch when it waits for two
// descriptors (`wait_fd2`), each the other's, or, with no frame, the
// parking of a socket parked on a lot. The frame's
// task's wait (its record's) is its first watch | 3, so a cancel finds it.
// Adding, taking and finding a frame's watches cost O(1), an event O(1)
// unless it looks past frames waiting for the other direction.
// `__watch_count` counts the watches. Descriptors are small numbers on the
// platforms (a port whose sockets aren't, Windows', would key the slots by
// handle instead).

const WSLOT: int64 = 64
const WNODE: int64 = 48

// `myla___wait_fd(frame, fd)`: the frame waiting until `fd` is readable (its
// input there or ended): watched by the poller, which queues it then (its
// frame function suspends after this call). A task asked to stop waits no
// time, nor for what the poller can't watch (a regular file: always ready).
pub fun wait_fd(fr: int64, fd: int64) {
    wait_fds(fr, fd_of(fd), -1, 0)
}

// `myla___wait_fd2(frame, a, b)`: the frame waiting until `a` or `b` is
// readable (a child's stdout and stderr, `std.process.run_async`).
pub fun wait_fd2(fr: int64, a: int64, b: int64) {
    var bd: int64 = -1
    if b >= 0 {
        bd = fd_of(b)
    }
    wait_fds(fr, fd_of(a), bd, 0)
}

// `__wait_writable_frame(frame, fd)` (`__wait_writable`, MYLA-419): the
// frame waiting until `fd` has room for a write (a child's input), watched
// as a socket waiting to send is: the platform's poller takes any
// descriptor that way on Linux.
pub fun wait_writable_frame(fr: int64, fd: int64) {
    wait_fds(fr, fd_of(fd), -1, 2)
}

// `myla___wait_sock(frame, h, events)` (`__wait_socket`, MYLA-346): the
// frame waiting until the socket `h` is ready for `events` (1 to receive or
// accept, 2 to send or a connect's end; an error or a hang-up counts as
// either), watched by the poller through the platform's socket functions.
// A wake-up may come early (another task took what was there): the caller
// tries its operation again and waits again on EAGAIN. A handle that isn't
// open (D181) waits no time, and the operation then fails.
pub fun wait_sock(fr: int64, h: int64, events: int64) {
    wait_fds(fr, handle_get(h, H_SOCKET), -1, events & 3)
}

// The frame waiting for `a`, and `b` too unless it is negative: a watch
// for each, so the first event takes both (`frame_unwatch`); `events` as a
// watch's (0: readable descriptors).
fun wait_fds(fr: int64, a: int64, b: int64, events: int64) {
    // (its flags read under the lock, `task_cancel`)
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    if task_cancelled() != 0 {
        give_lock(lock)
        exec_push(fr)
        return
    }
    // no descriptor (-1, a closed stream's): ready now on every target, as
    // the interpreter has it (MYLA-375); wasm32's poller would watch it and
    // never wake
    if a < 0 {
        give_lock(lock)
        exec_push(fr)
        return
    }
    if __rt_get("__exec_poller") == 0 {
        __store64(__rt_addr("__exec_poller"), os.poller_new())
    }
    let first = watch_add(a, fr, events)
    var ready = first == 0
    if b >= 0 && !ready {
        let second = watch_add(b, fr, events)
        if second == 0 {
            ready = true
        } else {
            __store64(first + 40, second)
            __store64(second + 40, first)
        }
    }
    if ready {
        // one the poller can't watch (a regular file): ready now
        if first != 0 {
            let gone = frame_unwatch(first)
        }
        give_lock(lock)
        exec_push(fr)
        return
    }
    // its task's wait, which a cancel ends
    waits_on(fr, first | 3)
    give_lock(lock)
}

// The slot of the descriptor `fd` in `__watches`, or 0 when the table
// doesn't reach it (the lock held).
fun watch_slot(fd: int64) -> int64 {
    let t = __rt_get("__watches")
    if t == 0 || fd < 0 || fd >= __load64(t) {
        return 0
    }
    return t + 16 + fd * WSLOT
}

// The slot of `fd`, the table grown to reach it (64 slots at first, then
// doubled until it does); the lock held.
fun watch_slot_made(fd: int64) -> int64 {
    let t = __rt_get("__watches")
    var cap: int64 = 64
    if t != 0 {
        cap = __load64(t)
        if fd < cap {
            return t + 16 + fd * WSLOT
        }
    }
    while cap <= fd {
        cap *= 2
    }
    let bigger = __alloc(16 + cap * WSLOT)
    zero_words(bigger, 16 + cap * WSLOT)
    __store64(bigger, cap)
    if t != 0 {
        // (the watches hold no slot's address: they move as they are)
        __store64(bigger + 8, __load64(t + 8))
        __copy_bytes(bigger + 16, t + 16, __load64(t) * WSLOT)
        __free(t)
    }
    __store64(__rt_addr("__watches"), bigger)
    return bigger + 16 + fd * WSLOT
}

// A watch of the frame `fr` on `fd` for `events`, last among the frames
// waiting for it, and the descriptor watched for what they all wait for: the
// watch, or 0 when the poller can't watch the descriptor (no watch then).
// The lock held. A descriptor is watched once whatever number of frames
// wait for it, its token `fd + 1` (a poller keeps one per descriptor: a
// second frame's would replace the first's, the review of 2026-11-06, R5).
fun watch_add(fd: int64, fr: int64, events: int64) -> int64 {
    let slot = watch_slot_made(fd)
    let w = __alloc(WNODE)
    __store64(w, fd)
    __store64(w + 8, fr)
    __store64(w + 16, events)
    __store64(w + 24, 0)
    __store64(w + 40, 0)
    let last = __load64(slot + 8)
    __store64(w + 32, last)
    if last != 0 {
        __store64(last + 24, w)
    } else {
        __store64(slot, w)
    }
    __store64(slot + 8, w)
    slot_count(slot, events, 1)
    if slot_arm(fd, slot) < 0 {
        watch_unlink(slot, w)
        __free(w)
        return 0
    }
    __store64(__rt_addr("__watch_count"), __rt_get("__watch_count") + 1)
    return w
}

// The counts of the slot `slot` changed by `d` for a watch for `events`.
fun slot_count(slot: int64, events: int64, d: int64) {
    if events == 0 || (events & 1) != 0 {
        __store64(slot + 16, __load64(slot + 16) + d)
    }
    if (events & 2) != 0 {
        __store64(slot + 24, __load64(slot + 24) + d)
    }
    if events != 0 {
        __store64(slot + 32, __load64(slot + 32) + d)
    }
}

// The descriptor `fd` (its slot `slot`, with a watch) watched by the poller
// for what its frames wait for, unless it is already: negative when the
// poller can't watch it. The lock held.
fun slot_arm(fd: int64, slot: int64) -> int64 {
    var want: int64 = 5
    if __load64(slot + 32) != 0 {
        want = 0
        if __load64(slot + 16) != 0 {
            want |= 1
        }
        if __load64(slot + 24) != 0 {
            want |= 2
        }
    }
    let armed = __load64(slot + 40)
    if armed == want {
        return 0
    }
    let again = __load64(slot + 48) != 0
    var r: int64 = 0
    if want == 5 {
        r = os.poller_watch(__rt_get("__exec_poller"), fd, fd + 1, again)
    } else {
        r = os.poller_watch_socket(__rt_get("__exec_poller"), fd, want, fd + 1, again)
    }
    if r >= 0 {
        __store64(slot + 40, want)
        __store64(slot + 48, 1)
    }
    return r
}

// The first watch of `slot` for `ready` (1: to receive or read, 2: to
// send), or 0 (the lock held).
fun watch_first(slot: int64, ready: int64) -> int64 {
    var w = __load64(slot)
    while w != 0 {
        let ev = __load64(w + 16)
        if (ev == 0 && ready == 1) || (ev & ready) != 0 {
            return w
        }
        w = __load64(w + 24)
    }
    return 0
}

// The watch `w` out of the list of `slot` and its counts; the descriptor no
// longer watched when no frame waits for it. The lock held.
fun watch_unlink(slot: int64, w: int64) {
    let next = __load64(w + 24)
    let prev = __load64(w + 32)
    if prev != 0 {
        __store64(prev + 24, next)
    } else {
        __store64(slot, next)
    }
    if next != 0 {
        __store64(next + 32, prev)
    } else {
        __store64(slot + 8, prev)
    }
    slot_count(slot, __load64(w + 16), -1)
    if __load64(slot) == 0 && __load64(slot + 40) != 0 {
        let fd = __load64(w)
        if __load64(slot + 40) == 5 {
            os.poller_forget(__rt_get("__exec_poller"), fd)
        } else {
            os.poller_forget_socket(__rt_get("__exec_poller"), fd)
        }
        __store64(slot + 40, 0)
        __store64(slot + 48, 0)
    }
}

// The frame of the watch `w` no longer waiting: its watches (`w` and its
// other) taken off and freed, its task's wait over. The frame, to queue
// (the lock held).
fun frame_unwatch(w: int64) -> int64 {
    let fr = __load64(w + 8)
    let other = __load64(w + 40)
    wait_over(fr, w | 3)
    watch_free(w)
    if other != 0 {
        wait_over(fr, other | 3)
        watch_free(other)
    }
    return fr
}

// The descriptor `fd` about to be closed: the frames waiting for it woken
// (their operation then fails, its handle closed), a socket parked on a
// lot ready there (its parker finds it closed), and its slot cleared, so
// that the next descriptor given its number starts afresh, not with the
// poller's watch of this one, which the close ends. The frames are queued
// by the next poll (`woken_later`), which the poller is woken for: a
// program without tasks has no queues to push them on (nor any watch),
// and its close comes here too.
fun watches_closed(fd: int64) {
    let t = __rt_get("__watches")
    if t == 0 {
        return
    }
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    var any = false
    let slot = watch_slot(fd)
    if slot != 0 {
        while __load64(slot) != 0 {
            let fr = watch_fired(__load64(slot))
            if fr != 0 {
                // on the table's list, counted a watch until it is queued
                let n = __alloc(16)
                __store64(n, fr)
                __store64(n + 8, __load64(__rt_get("__watches") + 8))
                __store64(__rt_get("__watches") + 8, n)
                __store64(__rt_addr("__watch_count"), __rt_get("__watch_count") + 1)
                any = true
            }
        }
        __store64(slot + 40, 0)
        __store64(slot + 48, 0)
        __store64(slot + 56, 0)
    }
    give_lock(lock)
    if any && __rt_get("__exec_poller") != 0 {
        os.poller_wake(__rt_get("__exec_poller"))
    }
}

// The frames a close woke (`watches_closed`), taken off the table's list
// onto `woken` (the poll held).
fun woken_later(woken: [int64]) -> [int64] {
    var out = woken
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let t = __rt_get("__watches")
    var n = __load64(t + 8)
    __store64(t + 8, 0)
    while n != 0 {
        out.push(__load64(n))
        let next = __load64(n + 8)
        __free(n)
        __store64(__rt_addr("__watch_count"), __rt_get("__watch_count") - 1)
        n = next
    }
    give_lock(lock)
    return out
}

// The watch `w`'s wait over (its descriptor ready, or closed): its frame
// no longer waiting, or its parked socket ready on its lot. The frame to
// queue, or 0 (the lock held).
fun watch_fired(w: int64) -> int64 {
    if __load64(w + 8) == 0 {
        return parked_fired(w)
    }
    return frame_unwatch(w)
}

// The watch `w` off its slot, and freed (the lock held).
fun watch_free(w: int64) {
    watch_unlink(watch_slot(__load64(w)), w)
    __free(w)
    __store64(__rt_addr("__watch_count"), __rt_get("__watch_count") - 1)
}

// --- lots: sockets parked with no task (MYLA-468) --------------------------------
// A lot is a set of sockets parked on the reactor, each waiting to become
// readable with no frame: a watch whose frame is 0 and whose `other` is its
// parking, `[lot][handle][descriptor][deadline][next][previous][watch]`
// (PARKING bytes). A socket ready leaves the watches for the lot's ready
// list, and the lot's notifier (a `std.task.Notifier`'s id) is notified
// once, so a task waiting on it takes the socket (`__sock_ready`). A lot is
// the record `[notifier][first ready][last ready][first parked][last
// parked][count parked]`, which a handle names (kind H_LOT, D181); its
// parked sockets are kept in the order of their deadlines (none: last), so
// the ones whose time ran out come first (`__sock_expired`). A parking's
// `tag`, a number its parker keeps with the socket (std.http: when its
// connection's time is up), stays in the socket's slot of the watches
// (`__sock_tag`). All under the timers' lock.

const H_LOT: int64 = 4
const LOT: int64 = 48
const PARKING: int64 = 56

// `__sock_lot(n)`: a new lot whose sockets, once ready, notify the
// notifier whose id is `n`: its handle.
pub fun sock_lot(n: int64) -> int {
    __set_io_errno(0)
    let rec = __alloc(LOT)
    zero_words(rec, LOT)
    __store64(rec, n)
    return handle_new(H_LOT, rec) as int
}

// `__sock_park(lot, h, deadline, tag)`: the socket `h` parked on `lot` until
// it is readable (or its input ended), with `deadline` (a time of the
// parker's clock, `std.time.now_ms` in std.http, negative for none) and
// `tag` kept with it: how many sockets are parked on the lot then, or -1
// with EBADF (`lot` or `h` not open). A socket the poller can't watch is
// ready at once.
pub fun sock_park(lot: int, h: int, deadline: int64, tag: int64) -> int {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let rec = handle_get(lot as int64, H_LOT)
    let fd = handle_get(h as int64, H_SOCKET)
    if rec < 0 || fd < 0 {
        give_lock(lock)
        return sock_result(-EBADF)
    }
    __set_io_errno(0)
    if __rt_get("__exec_poller") == 0 {
        __store64(__rt_addr("__exec_poller"), os.poller_new())
    }
    let p = __alloc(PARKING)
    zero_words(p, PARKING)
    __store64(p, rec)
    __store64(p + 8, h as int64)
    __store64(p + 16, fd)
    __store64(p + 24, deadline)
    // after the last parked whose deadline isn't later (looked for from the
    // end: most come with the latest deadline)
    var after = __load64(rec + 32)
    while after != 0 && deadline_before(deadline, __load64(after + 24)) {
        after = __load64(after + 40)
    }
    parking_link(rec, p, after)
    __store64(rec + 40, __load64(rec + 40) + 1)
    let count = __load64(rec + 40)
    __store64(watch_slot_made(fd) + 56, tag)
    let w = watch_add(fd, 0, 1)
    var fr: int64 = 0
    if w == 0 {
        fr = parking_ready(p)
    } else {
        __store64(w + 40, p)
        __store64(p + 48, w)
    }
    give_lock(lock)
    if fr != 0 {
        exec_push(fr)
    }
    return count as int
}

// Whether the deadline `a` comes before `b` (a negative one: never).
#test(5i64, 7i64)[true]
#test(7i64, 5i64)[false]
#test(5i64, -1i64)[true]
#test(-1i64, 5i64)[false]
#test(-1i64, -1i64)[false]
fun deadline_before(a: int64, b: int64) -> bool {
    if a < 0 {
        return false
    }
    return b < 0 || a < b
}

// The parking `p` put on its lot `rec`'s parked list after `after` (0: first).
fun parking_link(rec: int64, p: int64, after: int64) {
    var next: int64 = 0
    if after != 0 {
        next = __load64(after + 32)
        __store64(after + 32, p)
    } else {
        next = __load64(rec + 24)
        __store64(rec + 24, p)
    }
    __store64(p + 32, next)
    __store64(p + 40, after)
    if next != 0 {
        __store64(next + 40, p)
    } else {
        __store64(rec + 32, p)
    }
}

// The parking `p` off its lot's list that starts at `rec + head` (8: the
// ready, 24: the parked).
fun parking_unlink(rec: int64, p: int64, head: int64) {
    let next = __load64(p + 32)
    let prev = __load64(p + 40)
    if prev != 0 {
        __store64(prev + 32, next)
    } else {
        __store64(rec + head, next)
    }
    if next != 0 {
        __store64(next + 40, prev)
    } else {
        __store64(rec + head + 8, prev)
    }
}

// The parked socket `p` ready: off the parked (its watch gone already, or
// never made), last on the ready list, and its lot's notifier notified once:
// the frame of the task that waited longest on it, to queue, or 0 (a permit
// left). The lock held.
fun parking_ready(p: int64) -> int64 {
    let rec = __load64(p)
    parking_unlink(rec, p, 24)
    __store64(rec + 40, __load64(rec + 40) - 1)
    __store64(p + 48, 0)
    let last = __load64(rec + 16)
    __store64(p + 32, 0)
    __store64(p + 40, last)
    if last != 0 {
        __store64(last + 32, p)
    } else {
        __store64(rec + 8, p)
    }
    __store64(rec + 16, p)
    let n = notifier_record(__load64(rec))
    if n < 0 {
        return 0
    }
    let w = __load64(n + 16)
    if w == 0 {
        __store64(n, __load64(n) + 1)
        return 0
    }
    let fr = __load64(w)
    unpark_locked(w, 2, true)
    return fr
}

// The watch `w` of a parked socket fired (or its descriptor is being
// closed): the socket ready on its lot. The frame to queue, or 0.
fun parked_fired(w: int64) -> int64 {
    let p = __load64(w + 40)
    watch_free(w)
    return parking_ready(p)
}

// `__sock_ready(lot)`: the socket parked on `lot` that became ready first,
// taken off the lot; 0 when none is, -1 with EBADF when `lot` isn't open.
pub fun sock_ready(lot: int) -> int {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let rec = handle_get(lot as int64, H_LOT)
    if rec < 0 {
        give_lock(lock)
        return sock_result(-EBADF)
    }
    __set_io_errno(0)
    let p = __load64(rec + 8)
    var h: int64 = 0
    if p != 0 {
        parking_unlink(rec, p, 8)
        h = __load64(p + 8)
        __free(p)
    }
    give_lock(lock)
    return h as int
}

// `__sock_expired(lot, now)`: a socket parked on `lot` whose deadline is
// `now` or before, taken off the lot (no longer watched), the one with the
// earliest deadline; with `now` negative the earliest, whatever its
// deadline (the one parked longest, when they all have the same time
// limit). 0 when none is, -1 with EBADF when `lot` isn't open.
pub fun sock_expired(lot: int, now: int64) -> int {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let rec = handle_get(lot as int64, H_LOT)
    if rec < 0 {
        give_lock(lock)
        return sock_result(-EBADF)
    }
    __set_io_errno(0)
    let p = __load64(rec + 24)
    var h: int64 = 0
    if p != 0 && (now < 0 || (__load64(p + 24) >= 0 && __load64(p + 24) <= now)) {
        h = __load64(p + 8)
        parking_unlink(rec, p, 24)
        __store64(rec + 40, __load64(rec + 40) - 1)
        if __load64(p + 48) != 0 {
            watch_free(__load64(p + 48))
        }
        __free(p)
    }
    give_lock(lock)
    return h as int
}

// `__sock_tag(h)`: the tag the socket `h` was last parked with (0: never).
pub fun sock_tag(h: int) -> int64 {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let fd = handle_get(h as int64, H_SOCKET)
    var tag: int64 = 0
    let slot = watch_slot(fd)
    if slot != 0 {
        tag = __load64(slot + 56)
    }
    give_lock(lock)
    return tag
}

// `__sock_lot_close(lot)`: the lot closed, its parked sockets no longer
// watched and its ready ones forgotten (none of them closed: the parker
// takes them first, `__sock_expired(lot, -1)` and `__sock_ready`). 0, or
// -1 with EBADF.
pub fun sock_lot_close(lot: int) -> int {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let rec = handle_free(lot as int64, H_LOT)
    if rec < 0 {
        give_lock(lock)
        return sock_result(-EBADF)
    }
    __set_io_errno(0)
    for head in [8i64, 24i64] {
        var p = __load64(rec + head)
        while p != 0 {
            let next = __load64(p + 32)
            if __load64(p + 48) != 0 {
                watch_free(__load64(p + 48))
            }
            __free(p)
            p = next
        }
    }
    __free(rec)
    give_lock(lock)
    return 0
}

// Every task waits for another one: the program ends. Each idle worker can
// see it at once; the first to claim the report (`__parked`'s second word)
// writes it and ends the program, the others wait for that end, so the line
// is written once (MYLA-387).
fun exec_stuck() {
    if __xchg64(__rt_addr("__parked") + 8, 1) != 0 {
        while true {
            os.sleep_ns(1000000)
        }
    }
    let msg = __addr_of("runtime error: every task waits for another one\n")
    os.write_all(2, msg + 8, __load64(msg))
    exit_program(1)
}

// --- notifiers: tasks parked until another wakes them (MYLA-387) -----------------
// A notifier (`std.task.notifier`) is the record `[permits][generation][first
// waiter][last]`, which a handle names (`handle_new`, kind H_NOTIFIER, D181):
// a copy of the handle reaches the same record, and one closed, or made up,
// reaches none. A wait is a waiter, the cell `[frame][notifier][next]
// [previous][two words unused][state][since][ms][record][timer]` (WAITER
// bytes) that `waiter` makes and `woken` frees: while it is parked it is on
// its notifier's list, oldest first, and its task's record holds it, for a
// cancel (MYLA-456; every parked waiter was on a list, `__parked`, which a
// cancel walked); `record` is its notifier's record then, and `timer` the
// place of its time limit among the timers (`timer_placed`). Its state: 0 made, 1 parked, then 2 notified, 3 timed
// out, 4 cancelled, 5 its notifier closed while it waited, 6 its notifier
// closed (or never made) before it. `notify_one` wakes the oldest waiter,
// or with none adds a permit, which the next wait takes at once (none is
// lost when the wake comes before the wait); `notify_all` wakes every
// waiter and counts a generation, which a wait `since` an older one sees at
// once. Everything here is under the timers' lock: a wait's time limit is a
// timer (the waiter tagged 2) and a cancel ends a wait, both under it
// already; a close frees the record under it too, so a record found under
// the lock stays until it is given back.

const WAITER: int64 = 88

// `__notifier()`: a new notifier, with no permit and no waiter: its handle.
pub fun notifier() -> int64 {
    let n = __alloc(32)
    zero_words(n, 32)
    return handle_new(H_NOTIFIER, n)
}

// The record of the notifier `n`, or -1 when it is closed or was never made
// (the timers' lock held, if there are tasks).
fun notifier_record(n: int64) -> int64 {
    return handle_get(n, H_NOTIFIER)
}

// `__notify_gen(n)`: how many times `notify_all` woke the notifier `n`'s
// waiters so far (`std.task`'s `listen`); -1 when it is closed.
pub fun notify_gen(n: int64) -> int64 {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let rec = notifier_record(n)
    var g: int64 = -1
    if rec >= 0 {
        g = __load64(rec + 8)
    }
    give_lock(lock)
    return g
}

// `__waiter(n, since, ms)`: a wait on the notifier `n`, `since` its
// generation (-1: any), for at most `ms` milliseconds (negative: no limit),
// to park (`__park`) and then read (`__woken`).
pub fun waiter(n: int64, since: int64, ms: int) -> int64 {
    let w = __alloc(WAITER)
    zero_words(w, WAITER)
    __store64(w + 8, n)
    __store64(w + 56, since)
    __store64(w + 64, ms as int64)
    return w
}

// `__woken(w)`: how the wait `w` ended, 1 notified, 0 its time passed (or
// its notifier was closed while it waited), 2 its task was asked to stop
// (D96), 3 its notifier was closed before (std.task's runtime error); the
// waiter freed.
pub fun woken(w: int64) -> int {
    let st = __load64(w + 48)
    __free(w)
    if st == 2 {
        return 1
    }
    if st == 4 {
        return 2
    }
    if st == 6 {
        return 3
    }
    return 0
}

// The state the wait `w` ends with at once (the lock held, if there are
// tasks), else 1 (it parks): its notifier closed, a permit there (taken), a
// `notify_all` since its generation, no time to wait. Its record noted.
fun park_now(w: int64) -> int64 {
    let n = notifier_record(__load64(w + 8))
    if n < 0 {
        return 6
    }
    __store64(w + 72, n)
    let permits = __load64(n)
    if permits > 0 {
        __store64(n, permits - 1)
        return 2
    }
    let since = __load64(w + 56)
    if since >= 0 && __load64(n + 8) != since {
        return 2
    }
    if __load64(w + 64) == 0 {
        return 3
    }
    return 1
}

// `myla___park(frame, w)`: the frame parked on the wait `w`'s notifier until
// it is woken, its time passes, its task is asked to stop or the notifier is
// closed (its frame function suspends after this call); queued at once when
// it needn't wait.
pub fun park_frame(fr: int64, w: int64) {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    // (its flags read under the lock, `task_cancel`)
    var st: int64 = 4
    if task_cancelled() == 0 {
        st = park_now(w)
    }
    if st != 1 {
        __store64(w + 48, st)
        give_lock(lock)
        exec_push(fr)
        return
    }
    __store64(w, fr)
    __store64(w + 48, 1)
    // last on its notifier's list
    let n = __load64(w + 72)
    let last = __load64(n + 24)
    __store64(w + 24, last)
    if last != 0 {
        __store64(last + 16, w)
    } else {
        __store64(n + 16, w)
    }
    __store64(n + 24, w)
    // its task's wait, which a cancel ends
    waits_on(fr, w | 2)
    let ms = __load64(w + 64)
    if ms > 0 {
        let seq = timer_add_locked(os.clock_ns() + ms * 1000000, w | 2, 0)
    }
    give_lock(lock)
    if ms > 0 {
        timers_changed()
    }
}

// `__park(w)` without tasks: nobody else can wake it, so the wait ends at
// once, after its time, or never (every task waits).
pub fun park_alone(w: int64) {
    var st = park_now(w)
    if st == 1 {
        let ms = __load64(w + 64)
        if ms < 0 {
            exec_stuck()
        }
        os.sleep_ns(ms * 1000000)
        st = 3
    }
    __store64(w + 48, st)
}

// The parked waiter `w` taken off its notifier's list and its task's
// record, its time limit off the timers (`forget`: unless a timer fired
// it), its state `st` (the lock held).
fun unpark_locked(w: int64, st: int64, forget: bool) {
    let n = __load64(w + 72)
    let next = __load64(w + 16)
    let prev = __load64(w + 24)
    if prev != 0 {
        __store64(prev + 16, next)
    } else {
        __store64(n + 16, next)
    }
    if next != 0 {
        __store64(next + 24, prev)
    } else {
        __store64(n + 24, prev)
    }
    wait_over(__load64(w), w | 2)
    if forget && __load64(w + 64) > 0 {
        timer_remove(w)
    }
    __store64(w + 48, st)
}

// `__notify(n, all)`: the oldest task waiting on the notifier `n` woken, or
// a permit added when none waits; `all`: every task waiting woken and the
// generation counted, no permit. The frames woken are queued so that the
// one that waited longest runs first, as the timers queue sleepers. False
// when `n` is closed (nothing done).
pub fun notify(n: int64, all: bool) -> bool {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let rec = notifier_record(n)
    if rec < 0 {
        give_lock(lock)
        return false
    }
    if !all {
        let w = __load64(rec + 16)
        if w == 0 {
            __store64(rec, __load64(rec) + 1)
            give_lock(lock)
            return true
        }
        let fr = __load64(w)
        unpark_locked(w, 2, true)
        give_lock(lock)
        exec_push(fr)
        return true
    }
    __store64(rec + 8, __load64(rec + 8) + 1)
    wake_all_locked(rec, 2, lock)
    return true
}

// Every task waiting on the notifier record `rec` woken with the state `st`
// and queued, the one that waited longest first; the lock `lock` given back
// first.
fun wake_all_locked(rec: int64, st: int64, lock: int64) {
    if __load64(rec + 16) == 0 {
        give_lock(lock)
        return
    }
    var due: [int64] = []
    while __load64(rec + 16) != 0 {
        let w = __load64(rec + 16)
        due.push(__load64(w))
        unpark_locked(w, st, true)
    }
    give_lock(lock)
    if __rt_get("__exec_sched") == 1 {
        for fr in due {
            exec_push(fr)
        }
    } else {
        var i = due.len()
        while i > 0 {
            i -= 1
            exec_push(due[i])
        }
    }
}

// `__notify(n, all)` without tasks: no task waits (`park_alone` parks
// none), so a permit added, or the generation counted; false when `n` is
// closed.
pub fun notify_alone(n: int64, all: bool) -> bool {
    let rec = notifier_record(n)
    if rec < 0 {
        return false
    }
    if all {
        __store64(rec + 8, __load64(rec + 8) + 1)
    } else {
        __store64(rec, __load64(rec) + 1)
    }
    return true
}

// `__notifier_close(n)` (D181): the notifier `n` closed, every task waiting
// on it woken (its wait not notified) and its record freed, its handle
// naming nothing from then on; false when it was closed already.
pub fun notifier_close(n: int64) -> bool {
    let lock = __rt_addr("__timer_lock")
    take_lock(lock)
    let rec = handle_free(n, H_NOTIFIER)
    if rec < 0 {
        give_lock(lock)
        return false
    }
    // the waiters off it first: they are queued once the lock is given back
    var due: [int64] = []
    while __load64(rec + 16) != 0 {
        let w = __load64(rec + 16)
        due.push(__load64(w))
        unpark_locked(w, 5, true)
    }
    __free(rec)
    give_lock(lock)
    for fr in due {
        exec_push(fr)
    }
    return true
}

// --- lists -----------------------------------------------------------------------
// A list's cell is `[len][cap][elements]`.

// `__list_grow`: the full cell `cell` (its length its capacity, the caller
// made it unique) moved into one twice as big (4 elements at first), of
// `stride` bytes an element; the old cell freed.
pub fun list_grow(cell: int64, stride: int64) -> int64 {
    let cap = __load64(cell + 8)
    var bigger: int64 = 4
    if cap != 0 {
        bigger = cap * 2
    }
    // a big cell at the top of a memory that doesn't give memory back
    // (wasm32) grows where it is: no copy, and no second cell beside it
    if grew_in_place(cell, bigger * stride + 16) {
        __store64(cell + 8, elements_in(cell, stride, bigger))
        return cell
    }
    let p = __alloc(bigger * stride + 16)
    __copy_bytes(p, cell, cap * stride + 16)
    // the whole cell: its size class (or a big cell's pages) may hold more
    // than was asked (the review of 2026-11-06, R6)
    __store64(p + 8, elements_in(p, stride, bigger))
    __free(cell)
    return p
}

// How many elements of `stride` bytes the list cell `p` holds (its size is
// the word 16 bytes before it), at least `asked`; `asked` for elements of no
// bytes (a `[()]`).
fun elements_in(p: int64, stride: int64, asked: int64) -> int64 {
    if stride == 0 {
        return asked
    }
    return (__load64(p - 16) - 16) / stride
}

// --- deep copies between tasks (D92, MYLA-148) ---------------------------------------
// A value crossing to another task shares no count with the original: the
// per-type deep copies built by the code generator end at these, for the
// cells that own nothing. A cell's size is the word 16 bytes before it, its
// count the word 8 before; a static string's count starts at 2^61 and never
// reaches zero.

// `__deep_str`: the string (or another cell owning nothing) itself when it
// is unshared or static, else a copy, the original's count down (first: it
// stays above zero, and the copy is a tail call).
pub fun deep_str(cell: int64) -> int64 {
    let rc = __load64(cell - 8)
    if rc == 1 || rc >= 2305843009213693952 {
        return cell
    }
    __store64(cell - 8, rc - 1)
    return dclone_cell(cell)
}

// `__dclone_str`: a copy of the string, others holding the original (whose
// count stays); a static one shared.
pub fun dclone_str(cell: int64) -> int64 {
    if __load64(cell - 8) >= 2305843009213693952 {
        return cell
    }
    return dclone_cell(cell)
}

// `__dclone_cell`: a copy of the cell, word for word.
pub fun dclone_cell(cell: int64) -> int64 {
    let size = __load64(cell - 16)
    let copy = __alloc(size)
    __copy_bytes(copy, cell, size)
    return copy
}

// --- floats as text ----------------------------------------------------------------
// A float is printed with `digits` significant digits (17 for a float64, 9
// for a float32), the shortest of them that keep its value, as the
// interpreter prints it: its decimal exponent found among the powers of ten
// (`__pow10_hi`, 10^(i - 323) for i from 0 to 631, `__pow10_lo` the rest of
// each), then its digits as an integer, the float scaled by a power of ten
// with the error of the product kept (Dekker's product), then laid out.
// Each operation is the assembly's it replaces, in its order, so the digits
// are the same bit for bit.

// The float64 of the bits `b`.
fun f64_of(b: uint64) -> float64 {
    return __f64_from_bits(b)
}

// `10^(i - 323)`'s float64, and the rest of it.
fun pow10_hi(i: int64) -> float64 {
    return __f64_from_bits(__load64(__rt_addr("__pow10_hi") + i * 8) as uint64)
}

fun pow10_lo(i: int64) -> float64 {
    return __f64_from_bits(__load64(__rt_addr("__pow10_lo") + i * 8) as uint64)
}

// `a * b` and its rounding error, exactly (Dekker): the operands split in
// halves of 26 bits, scaled first so that neither half overflows.
fun two_prod(a0: float64, b0: float64) -> (float64, float64) {
    var a = a0
    var b = b0
    let big = f64_of(9092767647661031424u64)
    if a > big {
        a = a * f64_of(4318952042648305664u64)
        b = b * f64_of(4895412794951729152u64)
    } else if b > big {
        a = a * f64_of(4895412794951729152u64)
        b = b * f64_of(4318952042648305664u64)
    }
    let split = f64_of(4728779608772575232u64)
    let a2 = a * split
    let ahi = a2 - (a2 - a)
    let alo = a - ahi
    let b2 = b * split
    let bhi = b2 - (b2 - b)
    let blo = b - bhi
    let p = a * b
    var err = ahi * bhi - p
    err = err + ahi * blo
    err = err + alo * bhi
    err = err + alo * blo
    return (p, err)
}

// `x * 10^e`, rounded to an integer, the product's error kept (in two steps
// for an `e` past 308, whose power isn't a float64).
fun fscale(x0: float64, e0: int64) -> int64 {
    var x = x0
    var e = e0
    var carry = 0.0
    if e > 308 {
        let first = two_prod(x, pow10_hi(523))
        carry = first.1 + x * pow10_lo(523)
        x = first.0
        e -= 200
    }
    let i = e + 323
    let prod = two_prod(x, pow10_hi(i))
    var lo = prod.1 + x * pow10_lo(i)
    lo = lo + pow10_hi(i) * carry
    return __f64_round(prod.0) + __f64_round(lo)
}

// A float `%` on a target without an instruction for it (aarch64,
// MYLA-163): the remainder of `x / y` truncated toward zero, exactly, its
// sign `x`'s (C's `fmod`, as x86-64's `fprem` gives it), on the bits of both
// (musl's algorithm: the significands' long division, one bit a step); a NaN
// for a zero or NaN `y` and for an infinite or NaN `x`.
#test(4620130267728707584, 4611686018427387904)[4609434218613702656]
#test(-4618441417868443648, 4607182418800017408)[-4618441417868443648]
#test(118622047889322841, 4906019910204099648)[118622047889322841]
#test(4906019910204099648, 4613937818241073152)[4607182418800017408]
#test(-128383115725867620, 4619848792751996928)[-4604367669032910848]
#test(7, 2)[1]
#test(9110782046170513408, 4591870180066957722)[4591870178993215898]
#test(4607182418800017408, 0)[9221120237041090560]
pub fun fmod(xb: int64, yb: int64) -> int64 {
    var ux = xb as uint64
    var uy = yb as uint64
    var ex = ((ux >> 52u64) & 0x7FFu64) as int64
    var ey = ((uy >> 52u64) & 0x7FFu64) as int64
    let sx = ux & 0x8000000000000000u64
    let ynan = (uy << 1u64) > 0xFFE0000000000000u64
    if (uy << 1u64) == 0u64 || ynan || ex == 2047 { return 0x7FF8000000000000 }
    if (ux << 1u64) <= (uy << 1u64) {
        if (ux << 1u64) == (uy << 1u64) { return sx as int64 }
        return xb
    }
    // the significands with their leading bit, a subnormal's normalized
    if ex == 0 {
        var i = ux << 12u64
        while (i >> 63u64) == 0u64 {
            ex -= 1
            i = i << 1u64
        }
        ux = ux << ((1 - ex) as uint64)
    } else {
        ux = (ux & 0x000FFFFFFFFFFFFFu64) | 0x0010000000000000u64
    }
    if ey == 0 {
        var i = uy << 12u64
        while (i >> 63u64) == 0u64 {
            ey -= 1
            i = i << 1u64
        }
        uy = uy << ((1 - ey) as uint64)
    } else {
        uy = (uy & 0x000FFFFFFFFFFFFFu64) | 0x0010000000000000u64
    }
    while ex > ey {
        let d = ux.wrapping_sub(uy)   // its top bit: whether uy was larger
        if (d >> 63u64) == 0u64 {
            if d == 0u64 { return sx as int64 }
            ux = d
        }
        ux = ux << 1u64
        ex -= 1
    }
    let d = ux.wrapping_sub(uy)
    if (d >> 63u64) == 0u64 {
        if d == 0u64 { return sx as int64 }
        ux = d
    }
    while (ux >> 52u64) == 0u64 {
        ux = ux << 1u64
        ex -= 1
    }
    if ex > 0 {
        ux = (ux - 0x0010000000000000u64) | ((ex as uint64) << 52u64)
    } else {
        ux = ux >> ((1 - ex) as uint64)
    }
    return (ux | sx) as int64
}

// `__float_to_str`: the float64 of the bits `bits` in the fewest significant
// digits, up to `digits`, that read back as it (D155; `digits` is 9 for a
// float32, whose digits read back as that float32), trailing zeros dropped:
// plain digits up to its units, then a point and the rest, or `0.` and zeros
// before them for a magnitude below 1; below 1e-4 and from 1e16 on, its
// digits with a point after the first and the exponent (`1.5e-7`, `1e300`).
pub fun float_to_str(bits: int64, digits: int64) -> str {
    let mag = bits & 9223372036854775807
    let inf: int64 = 9218868437227405312
    if mag > inf {
        return "nan"
    }
    if mag == inf {
        if bits < 0 {
            return "-inf"
        }
        return "inf"
    }
    if mag == 0 {
        if bits < 0 {
            return "-0"
        }
        return "0"
    }
    let x = f64_of(mag as uint64)
    // its decimal exponent: the greatest power of ten not above it
    var lo: int64 = 0
    var hi: int64 = 631
    var at: int64 = -1
    while lo <= hi {
        let mid = (lo + hi) >> 1
        if x < pow10_hi(mid) {
            hi = mid - 1
        } else {
            at = mid
            lo = mid + 1
        }
    }
    // the fewest digits that read back as it: more digits, correctly
    // rounded, are never farther from it, so a binary search finds them
    // (`digits` always do)
    var lo_n: int64 = 1
    var hi_n = digits
    while lo_n < hi_n {
        let mid = (lo_n + hi_n) >> 1
        if digits_reading_back(x, at, mid, mag as uint64, digits == 9).0 != 0u64 {
            hi_n = mid
        } else {
            lo_n = mid + 1
        }
    }
    var n = lo_n
    var dn = decimal_digits(x, at, n)
    if n < digits {
        dn = digits_reading_back(x, at, n, mag as uint64, digits == 9)
    }
    var m = dn.0
    at = dn.1
    while n > 1 {
        let q = m / 10u64
        if m != q * 10u64 {
            break
        }
        m = q
        n -= 1
    }
    let exp = at - 323
    var sign: int64 = 0
    if bits < 0 {
        sign = 1
    }
    if exp < -4 || exp >= 16 {
        return exponent_form(m, n, exp, sign == 1)
    }
    var len: int64 = 0
    var dot: int64 = -1
    var lead: int64 = 0
    if exp >= n - 1 {
        len = sign + exp + 1
    } else if exp >= 0 {
        len = sign + n + 1
        dot = exp + 1
    } else {
        lead = -exp + 1
        len = sign + lead + n
    }
    let p = __alloc(len + 8)
    __store64(p, len)
    var q = p + 8
    if sign == 1 {
        __store8(q, 45u8)  // '-'
        q += 1
    }
    if lead > 0 {
        // `0.` and the zeros after the point
        __store8(q, 48u8)
        __store8(q + 1, 46u8)
        var z: int64 = 2
        while z < lead {
            __store8(q + z, 48u8)
            z += 1
        }
        q += lead
    }
    // the digits, from the last, a point among them
    var i = n - 1
    while i >= 0 {
        var pos = i
        if dot >= 0 && i >= dot {
            pos = i + 1
        }
        let tenth = m / 10u64
        __store8(q + pos, (48u64 + m - tenth * 10u64) as uint8)
        m = tenth
        i -= 1
    }
    if dot >= 0 {
        __store8(q + dot, 46u8)  // '.'
    }
    // the zeros up to the units of a large one
    if exp >= n - 1 {
        var z = n
        while z <= exp {
            __store8(q + z, 48u8)
            z += 1
        }
    }
    return __str_of(p)
}

// `x`'s `n` significant digits, rounded, as an integer, and the index of its
// decimal exponent (`at`, one more when rounding carried into a new digit).
fun decimal_digits(x: float64, at0: int64, n: int64) -> (uint64, int64) {
    var at = at0
    var m = fscale(x, n - 1 + 323 - at) as uint64
    var low: uint64 = 1
    var k = n - 1
    while k > 0 {
        low = low * 10u64
        k -= 1
    }
    if m >= low * 10u64 {
        m = m / 10u64
        at += 1
    }
    if m < low {
        m = low
    }
    return (m, at)
}

// `x`'s `n` significant digits that read back as it, and the index of their
// exponent, or 0 for none: the rounded digits, or one either side of them
// (the scaling's rounding can be one off in the last place).
fun digits_reading_back(x: float64, at0: int64, n: int64, mag: uint64, f32: bool) -> (uint64, int64) {
    let d = decimal_digits(x, at0, n)
    let e = d.1 - 323 - (n - 1)
    if reads_back(d.0, e, mag, f32) {
        return d
    }
    if reads_back(d.0 - 1u64, e, mag, f32) {
        return (d.0 - 1u64, d.1)
    }
    if reads_back(d.0 + 1u64, e, mag, f32) {
        return (d.0 + 1u64, d.1)
    }
    return (0u64, d.1)
}

// Whether `m` times 10 to the `e` reads back as the float64 of the bits `mag`
// (non-negative), or as its float32 (`f32`), as a literal does.
fun reads_back(m: uint64, e: int64, mag: uint64, f32: bool) -> bool {
    var b: uint64 = 0
    if m < 9007199254740992u64 && e >= -22 && e <= 22 {
        // both exact, so the one rounding of the product or quotient is the
        // literal's (Clinger's fast path)
        var ae = e
        if ae < 0 {
            ae = -ae
        }
        let k = pow10_hi(323 + ae)
        var y = m as float64
        if e >= 0 {
            y = y * k
        } else {
            y = y / k
        }
        b = __f64_bits(y)
    } else {
        b = num.f64_literal_bits(uint_to_str(m) + "e" + int_to_str(e))
    }
    if f32 {
        b = num.f32_round_bits(b)
    }
    return b == mag
}

// The `n` digits of `m` with a point after the first (none for one digit),
// then `e` and the exponent `exp` (D155).
fun exponent_form(m0: uint64, n: int64, exp: int64, negative: bool) -> str {
    let ds = uint_to_str(m0)
    var sb = StringBuilder()
    if negative {
        sb.append("-")
    }
    sb.append(ds, 0, 1)
    if n > 1 {
        sb.append(".")
        sb.append(ds, 1, n as int32)
    }
    sb.append("e")
    sb.append(int_to_str(exp))
    return sb.build()
}
