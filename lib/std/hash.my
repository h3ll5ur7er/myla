// std.hash: the Hasher, fast hashes and checksums (MYLA-327).
//
// - `Hasher` is the state the `Hash` trait passes through by value (D163,
//   MYLA-313): `h = h.add_u64(x)`, or a chain,
//   `hash.new().add_u64(a).add_str(s).finish()`. Its algorithm is wyhash
//   (final version 4, Wang Yi's, as Zig's std.hash.Wyhash has it), chosen over
//   SipHash-1-3 by measurement (docs/Language/Standard-library/Hash.md). The
//   seed is fixed for now, so a hash is the same in every run and runner.
// - `wyhash`, `fnv1a32` and `fnv1a64` hash a `str` or a `[uint8]` at once.
// - `crc32` (IEEE, the one of zlib, gzip and PNG) and `adler32` (zlib's) are
//   checksums, incremental through their `_update` forms.
//
// Every operation has a `str` form and a `[uint8]` form (`_bytes`), equal on
// equal bytes. The integers wrap (D4), which these algorithms rely on. Myla
// has no 128-bit integer, so wyhash's 64 × 64 → 128-bit product is built from
// four 32 × 32-bit ones.

// wyhash's secret (final version 4)
const S0: uint64 = 0xa0761d6478bd642f
const S1: uint64 = 0xe7037ed1a0b428db
const S2: uint64 = 0x8ebc6af09c88c6e3
const S3: uint64 = 0x589965cc75374cc3

const LO32: uint64 = 0xFFFFFFFF

// --- the Hasher -------------------------------------------------------------

// The running state of a hash: a value, passed through each `add` and given
// back by it, since Myla has no `var` parameters. Two hashers with the same
// seed that were given the same values in the same order are equal and
// finish equal.
#derive(Eq)
pub struct Hasher {
    state: uint64,
}

// `with_seed(0)`'s state, computed once (the cases of `new` and `with_seed`
// check it).
const SEED0_STATE: uint64 = 0x1ff5c2923a788d2c

// A hasher with the fixed seed: `with_seed(0)`.
#test[Hasher { state: 0x1ff5c2923a788d2cu64 }]
pub fun new() -> Hasher {
    return Hasher { state: SEED0_STATE }
}

// A hasher with its own seed; `with_seed(k).add_str(s).finish()` is
// `wyhash(s, k)`.
#test(0u64)[Hasher { state: 0x1ff5c2923a788d2cu64 }]
#test(9u64)[Hasher { state: 0xe0d557fc84a21d9au64 }]
pub fun with_seed(seed: uint64) -> Hasher {
    return Hasher { state: seed ^ mix(seed ^ S0, S1) }
}

impl Hasher {
    // Adds a 64-bit word: one folded multiplication. Every other integer,
    // `bool` and `char` is widened to one (a signed one sign-extended), so
    // `add_u8(255)` and `add_u64(255)` give the same state.
    #test(new(), 0u64)[Hasher { state: 0x42bc986dc5eec4d3u64 }]
    #test(new(), 1u64)[Hasher { state: 0x59b81abf6522ad07u64 }]
    #test(with_seed(9u64), 1u64)[Hasher { state: 0x6f9257817c090e77u64 }]
    #test(new().add_u64(1u64), 2u64)[Hasher { state: 0x4e0a109fae7c734bu64 }] // order matters
    #test(new().add_u64(2u64), 1u64)[Hasher { state: 0xcaa39b6da599288du64 }]
    fun add_u64(self, x: uint64) -> Hasher {
        return Hasher { state: mix(self.state ^ x, S1) }
    }

    #test(new(), 255u8)[Hasher { state: 0xd6456ad28572a8fu64 }]
    fun add_u8(self, x: uint8) -> Hasher {
        return self.add_u64(x as uint64)
    }

    #test(new(), 255u16)[Hasher { state: 0xd6456ad28572a8fu64 }]
    fun add_u16(self, x: uint16) -> Hasher {
        return self.add_u64(x as uint64)
    }

    #test(new(), 255u32)[Hasher { state: 0xd6456ad28572a8fu64 }]
    fun add_u32(self, x: uint32) -> Hasher {
        return self.add_u64(x as uint64)
    }

    #test(new(), -1i8)[Hasher { state: 0x70bc9b8185eefae3u64 }]
    fun add_i8(self, x: int8) -> Hasher {
        return self.add_u64(x as uint64)
    }

    #test(new(), -1i16)[Hasher { state: 0x70bc9b8185eefae3u64 }]
    fun add_i16(self, x: int16) -> Hasher {
        return self.add_u64(x as uint64)
    }

    #test(new(), -1i32)[Hasher { state: 0x70bc9b8185eefae3u64 }]
    fun add_i32(self, x: int32) -> Hasher {
        return self.add_u64(x as uint64)
    }

    #test(new(), -1i64)[Hasher { state: 0x70bc9b8185eefae3u64 }]
    fun add_i64(self, x: int64) -> Hasher {
        return self.add_u64(x as uint64)
    }

    // `true` adds 1, `false` 0.
    #test(new(), true)[Hasher { state: 0x59b81abf6522ad07u64 }]
    #test(new(), false)[Hasher { state: 0x42bc986dc5eec4d3u64 }]
    fun add_bool(self, x: bool) -> Hasher {
        if x {
            return self.add_u64(1)
        }
        return self.add_u64(0)
    }

    // Adds the character's code point.
    #test(new(), '\u{1}')[Hasher { state: 0x59b81abf6522ad07u64 }]
    fun add_char(self, x: char) -> Hasher {
        return self.add_u64(x as uint64)
    }

    // Adds the string's bytes and its length: wyhash of `s`, seeded with the
    // state. The length makes it prefix-free: "ab" then "c" isn't "a" then
    // "bc".
    #test(new(), "")[Hasher { state: 0x409638ee2bde459u64 }]
    #test(new(), "abc")[Hasher { state: 0x2a4f1d7cb516c72u64 }]
    #test(new().add_str("ab"), "c")[Hasher { state: 0x436b48dabff54997u64 }] // not "a" then "bc"
    #test(new().add_str("a"), "bc")[Hasher { state: 0x149f2873f367ddeau64 }]
    #test(new().add_u64(7u64), "x")[Hasher { state: 0xe8a68c2bdaa06aaeu64 }]
    fun add_str(self, s: str) -> Hasher {
        return Hasher { state: wy_str(s, self.state) }
    }

    // `add_str` of the same bytes.
    #test(new(), [97u8, 98u8, 99u8])[Hasher { state: 0x2a4f1d7cb516c72u64 }]
    fun add_bytes(self, b: [uint8]) -> Hasher {
        return Hasher { state: wy_bytes(b, self.state) }
    }

    // The hash of everything added. The hasher is a value, so it can be
    // added to and finished again.
    #test(new())[0x1ff5c2923a788d2cu64]
    #test(new().add_str("abc"))[0x2a4f1d7cb516c72u64]
    fun finish(self) -> uint64 {
        return self.state
    }
}

// --- wyhash -----------------------------------------------------------------

// The wyhash of `s` with `seed`: what `with_seed(seed).add_str(s).finish()`
// gives. The first vectors are those of Zig's tests of std.hash.Wyhash.
#test("", 0u64)[0x409638ee2bde459u64]
#test("a", 1u64)[0xa8412d091b5fe0a9u64]
#test("abc", 2u64)[0x32dd92e4b2915153u64]
#test("message digest", 3u64)[0x8619124089a3a16bu64]
#test("abcdefghijklmnopqrstuvwxyz", 4u64)[0x7a43afb61d7f5f40u64]
#test("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", 5u64)[0xff42329b90e50d58u64]
#test("12345678901234567890123456789012345678901234567890123456789012345678901234567890", 6u64)[0xc39cab13b115aad3u64]
#test("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUV", 0u64)[0x8a186694f6d5a3ceu64] // 48 bytes
#test("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVW", 0u64)[0x21be4db77473d10du64] // 49 bytes
#test("012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345", 0u64)[0xc8527a58bcdedfa3u64] // 96 bytes
#test("0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456", 0u64)[0xbae4f83bf2e6ff3bu64] // 97 bytes
pub fun wyhash(s: str, seed: uint64) -> uint64 {
    return wy_str(s, seed ^ mix(seed ^ S0, S1))
}

#test([], 0u64)[0x409638ee2bde459u64]
#test([97u8, 98u8, 99u8], 2u64)[0x32dd92e4b2915153u64]
pub fun wyhash_bytes(b: [uint8], seed: uint64) -> uint64 {
    return wy_bytes(b, seed ^ mix(seed ^ S0, S1))
}

// The 128-bit product of `a` and `b` as (low, high) words, from four
// 32 × 32-bit products. `mid` holds at most three 32-bit numbers, so it
// doesn't overflow.
#test(0xFFFFFFFFFFFFFFFFu64, 0xFFFFFFFFFFFFFFFFu64)[(1u64, 0xFFFFFFFFFFFFFFFEu64)]
#test(0x100000000u64, 0x100000000u64)[(0u64, 1u64)]
#test(3u64, 5u64)[(15u64, 0u64)]
fun mum(a: uint64, b: uint64) -> (uint64, uint64) {
    let al = a & LO32
    let ah = a >> 32
    let bl = b & LO32
    let bh = b >> 32
    let ll = al * bl
    let lh = al * bh
    let hl = ah * bl
    let mid = (ll >> 32) + (lh & LO32) + (hl & LO32)
    return ((ll & LO32) | (mid << 32), ah * bh + (lh >> 32) + (hl >> 32) + (mid >> 32))
}

// The two halves of the product, folded by xor: wyhash's mixing step.
// `mum`, written out, as it runs once for every 16 bytes.
#test(0xFFFFFFFFFFFFFFFFu64, 0xFFFFFFFFFFFFFFFFu64)[0xFFFFFFFFFFFFFFFFu64]
#test(3u64, 5u64)[15u64]
fun mix(a: uint64, b: uint64) -> uint64 {
    let al = a & LO32
    let ah = a >> 32
    let bl = b & LO32
    let bh = b >> 32
    let ll = al * bl
    let lh = al * bh
    let hl = ah * bl
    let mid = (ll >> 32) + (lh & LO32) + (hl & LO32)
    return ((ll & LO32) | (mid << 32)) ^ (ah * bh + (lh >> 32) + (hl >> 32) + (mid >> 32))
}

// The end of wyhash, for both forms.
fun wy_end(a: uint64, b: uint64, seed: uint64, n: int) -> uint64 {
    let (lo, hi) = mum(a ^ S1, b ^ seed)
    return mix(lo ^ S0 ^ (n as uint64), hi ^ S1)
}

// Little-endian words of 8 and 4 bytes at `i`.
#test("\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}", 0)[0x0807060504030201u64]
fun r8(s: str, i: int) -> uint64 {
    return (s[i] as uint64) | ((s[i + 1] as uint64) << 8) | ((s[i + 2] as uint64) << 16) |
        ((s[i + 3] as uint64) << 24) | ((s[i + 4] as uint64) << 32) | ((s[i + 5] as uint64) << 40) |
        ((s[i + 6] as uint64) << 48) | ((s[i + 7] as uint64) << 56)
}

#test("x\u{1}\u{2}\u{3}\u{4}", 1)[0x04030201u64]
fun r4(s: str, i: int) -> uint64 {
    return (s[i] as uint64) | ((s[i + 1] as uint64) << 8) | ((s[i + 2] as uint64) << 16) |
        ((s[i + 3] as uint64) << 24)
}

// wyhash of `s` with its seed set up already: the Hasher's state.
fun wy_str(s: str, seed0: uint64) -> uint64 {
    let n = s.len()
    var seed = seed0
    if n <= 16 {
        if n >= 4 {
            let q = (n >> 3) << 2
            return wy_end((r4(s, 0) << 32) | r4(s, q), (r4(s, n - 4) << 32) | r4(s, n - 4 - q), seed, n)
        }
        if n > 0 {
            return wy_end(((s[0] as uint64) << 16) | ((s[n >> 1] as uint64) << 8) | (s[n - 1] as uint64), 0, seed, n)
        }
        return wy_end(0, 0, seed, n)
    }
    var i = 0
    if n > 48 {
        var see1 = seed
        var see2 = seed
        while i + 48 < n {
            seed = mix(r8(s, i) ^ S1, r8(s, i + 8) ^ seed)
            see1 = mix(r8(s, i + 16) ^ S2, r8(s, i + 24) ^ see1)
            see2 = mix(r8(s, i + 32) ^ S3, r8(s, i + 40) ^ see2)
            i += 48
        }
        seed = seed ^ see1 ^ see2
    }
    while i + 16 < n {
        seed = mix(r8(s, i) ^ S1, r8(s, i + 8) ^ seed)
        i += 16
    }
    return wy_end(r8(s, n - 16), r8(s, n - 8), seed, n)
}

#test([1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8], 0)[0x0807060504030201u64]
fun r8b(b: [uint8], i: int) -> uint64 {
    return (b[i] as uint64) | ((b[i + 1] as uint64) << 8) | ((b[i + 2] as uint64) << 16) |
        ((b[i + 3] as uint64) << 24) | ((b[i + 4] as uint64) << 32) | ((b[i + 5] as uint64) << 40) |
        ((b[i + 6] as uint64) << 48) | ((b[i + 7] as uint64) << 56)
}

#test([9u8, 1u8, 2u8, 3u8, 4u8], 1)[0x04030201u64]
fun r4b(b: [uint8], i: int) -> uint64 {
    return (b[i] as uint64) | ((b[i + 1] as uint64) << 8) | ((b[i + 2] as uint64) << 16) |
        ((b[i + 3] as uint64) << 24)
}

// `wy_str` over a list of bytes.
fun wy_bytes(b: [uint8], seed0: uint64) -> uint64 {
    let n = b.len()
    var seed = seed0
    if n <= 16 {
        if n >= 4 {
            let q = (n >> 3) << 2
            return wy_end((r4b(b, 0) << 32) | r4b(b, q), (r4b(b, n - 4) << 32) | r4b(b, n - 4 - q), seed, n)
        }
        if n > 0 {
            return wy_end(((b[0] as uint64) << 16) | ((b[n >> 1] as uint64) << 8) | (b[n - 1] as uint64), 0, seed, n)
        }
        return wy_end(0, 0, seed, n)
    }
    var i = 0
    if n > 48 {
        var see1 = seed
        var see2 = seed
        while i + 48 < n {
            seed = mix(r8b(b, i) ^ S1, r8b(b, i + 8) ^ seed)
            see1 = mix(r8b(b, i + 16) ^ S2, r8b(b, i + 24) ^ see1)
            see2 = mix(r8b(b, i + 32) ^ S3, r8b(b, i + 40) ^ see2)
            i += 48
        }
        seed = seed ^ see1 ^ see2
    }
    while i + 16 < n {
        seed = mix(r8b(b, i) ^ S1, r8b(b, i + 8) ^ seed)
        i += 16
    }
    return wy_end(r8b(b, n - 16), r8b(b, n - 8), seed, n)
}

// --- FNV-1a -----------------------------------------------------------------

const FNV32_BASIS: uint32 = 0x811c9dc5
const FNV32_PRIME: uint32 = 16777619
const FNV64_BASIS: uint64 = 0xcbf29ce484222325
const FNV64_PRIME: uint64 = 0x100000001b3

// FNV-1a with 32 bits: for each byte, xor it in, then multiply by the prime.
// Simple and short, but a byte at a time, so slower than wyhash on long
// input. The vectors are the reference's (Fowler, Noll and Vo).
#test("")[0x811c9dc5u32]
#test("a")[0xe40c292cu32]
#test("foobar")[0xbf9cf968u32]
pub fun fnv1a32(s: str) -> uint32 {
    var h = FNV32_BASIS
    let n = s.len()
    var i = 0
    while i < n {
        h = (h ^ (s[i] as uint32)) * FNV32_PRIME
        i += 1
    }
    return h
}

#test([])[0x811c9dc5u32]
#test([102u8, 111u8, 111u8, 98u8, 97u8, 114u8])[0xbf9cf968u32]
pub fun fnv1a32_bytes(b: [uint8]) -> uint32 {
    var h = FNV32_BASIS
    let n = b.len()
    var i = 0
    while i < n {
        h = (h ^ (b[i] as uint32)) * FNV32_PRIME
        i += 1
    }
    return h
}

// FNV-1a with 64 bits.
#test("")[0xcbf29ce484222325u64]
#test("a")[0xaf63dc4c8601ec8cu64]
#test("foobar")[0x85944171f73967e8u64]
pub fun fnv1a64(s: str) -> uint64 {
    var h = FNV64_BASIS
    let n = s.len()
    var i = 0
    while i < n {
        h = (h ^ (s[i] as uint64)) * FNV64_PRIME
        i += 1
    }
    return h
}

#test([])[0xcbf29ce484222325u64]
#test([102u8, 111u8, 111u8, 98u8, 97u8, 114u8])[0x85944171f73967e8u64]
pub fun fnv1a64_bytes(b: [uint8]) -> uint64 {
    var h = FNV64_BASIS
    let n = b.len()
    var i = 0
    while i < n {
        h = (h ^ (b[i] as uint64)) * FNV64_PRIME
        i += 1
    }
    return h
}

// --- CRC-32 -----------------------------------------------------------------

// From this many bytes on, the CRC is computed eight bytes at a time
// ("slicing by 8"), which needs seven more tables, derived from the first.
// Deriving them takes about as long as 1700 bytes a byte at a time.
const CRC_SLICE_MIN: int = 2048

// CRC-32 as zlib, gzip, PNG and Ethernet compute it (CRC-32/ISO-HDLC: the
// reflected polynomial 0xEDB88320, the register starting at and xored with
// 0xFFFFFFFF).
#test("")[0u32]
#test("123456789")[0xCBF43926u32] // the check value of CRC-32/ISO-HDLC
#test("The quick brown fox jumps over the lazy dog")[0x414FA339u32]
pub fun crc32(s: str) -> uint32 {
    return crc32_update(0, s)
}

#test([])[0u32]
#test([49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8])[0xCBF43926u32]
pub fun crc32_bytes(b: [uint8]) -> uint32 {
    return crc32_update_bytes(0, b)
}

// The CRC-32 of the bytes behind `crc` followed by `s`, as zlib's
// `crc32(crc, buf, len)`: start from 0, and
// `crc32_update(crc32(a), b) == crc32(a + b)`.
#test(0u32, "123456789")[0xCBF43926u32]
#test(crc32("1234"), "56789")[0xCBF43926u32]
#test(0xCBF43926u32, "")[0xCBF43926u32]
pub fun crc32_update(crc: uint32, s: str) -> uint32 {
    let n = s.len()
    var c = crc ^ 0xFFFFFFFF
    var t = crc_table()
    var i = 0
    if n >= CRC_SLICE_MIN {
        t = crc_slices(t)
        while i + 8 <= n {
            c = c ^ ((s[i] as uint32) | ((s[i + 1] as uint32) << 8) | ((s[i + 2] as uint32) << 16) |
                ((s[i + 3] as uint32) << 24))
            c = t[1792 + (c & 0xFF) as int] ^ t[1536 + ((c >> 8) & 0xFF) as int] ^
                t[1280 + ((c >> 16) & 0xFF) as int] ^ t[1024 + (c >> 24) as int] ^
                t[768 + s[i + 4] as int] ^ t[512 + s[i + 5] as int] ^ t[256 + s[i + 6] as int] ^ t[s[i + 7] as int]
            i += 8
        }
    }
    while i < n {
        c = t[((c ^ (s[i] as uint32)) & 0xFF) as int] ^ (c >> 8)
        i += 1
    }
    return c ^ 0xFFFFFFFF
}

#test(crc32("1234"), [53u8, 54u8, 55u8, 56u8, 57u8])[0xCBF43926u32]
pub fun crc32_update_bytes(crc: uint32, b: [uint8]) -> uint32 {
    let n = b.len()
    var c = crc ^ 0xFFFFFFFF
    var t = crc_table()
    var i = 0
    if n >= CRC_SLICE_MIN {
        t = crc_slices(t)
        while i + 8 <= n {
            c = c ^ ((b[i] as uint32) | ((b[i + 1] as uint32) << 8) | ((b[i + 2] as uint32) << 16) |
                ((b[i + 3] as uint32) << 24))
            c = t[1792 + (c & 0xFF) as int] ^ t[1536 + ((c >> 8) & 0xFF) as int] ^
                t[1280 + ((c >> 16) & 0xFF) as int] ^ t[1024 + (c >> 24) as int] ^
                t[768 + b[i + 4] as int] ^ t[512 + b[i + 5] as int] ^ t[256 + b[i + 6] as int] ^ t[b[i + 7] as int]
            i += 8
        }
    }
    while i < n {
        c = t[((c ^ (b[i] as uint32)) & 0xFF) as int] ^ (c >> 8)
        i += 1
    }
    return c ^ 0xFFFFFFFF
}

// `crc_table()` followed by tables 1 to 7 of slicing by 8: entry k·256 + x
// is the CRC register after byte x and k zero bytes.
fun crc_slices(t0: [uint32]) -> [uint32] {
    var t = t0
    var k = 256
    while k < 2048 {
        let prev = t[k - 256]
        t.push((prev >> 8) ^ t[(prev & 0xFF) as int])
        k += 1
    }
    return t
}

// The CRC register after the byte x, for each x: the table every CRC-32
// implementation has (`crc_table_matches` derives it bit by bit).
fun crc_table() -> [uint32] {
    return [
        0x00000000, 0x77073096, 0xEE0E612C, 0x990951BA, 0x076DC419, 0x706AF48F, 0xE963A535, 0x9E6495A3,
        0x0EDB8832, 0x79DCB8A4, 0xE0D5E91E, 0x97D2D988, 0x09B64C2B, 0x7EB17CBD, 0xE7B82D07, 0x90BF1D91,
        0x1DB71064, 0x6AB020F2, 0xF3B97148, 0x84BE41DE, 0x1ADAD47D, 0x6DDDE4EB, 0xF4D4B551, 0x83D385C7,
        0x136C9856, 0x646BA8C0, 0xFD62F97A, 0x8A65C9EC, 0x14015C4F, 0x63066CD9, 0xFA0F3D63, 0x8D080DF5,
        0x3B6E20C8, 0x4C69105E, 0xD56041E4, 0xA2677172, 0x3C03E4D1, 0x4B04D447, 0xD20D85FD, 0xA50AB56B,
        0x35B5A8FA, 0x42B2986C, 0xDBBBC9D6, 0xACBCF940, 0x32D86CE3, 0x45DF5C75, 0xDCD60DCF, 0xABD13D59,
        0x26D930AC, 0x51DE003A, 0xC8D75180, 0xBFD06116, 0x21B4F4B5, 0x56B3C423, 0xCFBA9599, 0xB8BDA50F,
        0x2802B89E, 0x5F058808, 0xC60CD9B2, 0xB10BE924, 0x2F6F7C87, 0x58684C11, 0xC1611DAB, 0xB6662D3D,
        0x76DC4190, 0x01DB7106, 0x98D220BC, 0xEFD5102A, 0x71B18589, 0x06B6B51F, 0x9FBFE4A5, 0xE8B8D433,
