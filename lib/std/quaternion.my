// std.quaternion: quaternions of float64 (D201, MYLA-587).
//
// GENERATED by scripts/gen_std_linalg.py, with its float32 twin
// std.quaternion32, from one template: edit the script, not this file.
//
// `Quat` (fields `x`, `y`, `z`, `w`: the vector part, then the scalar), the
// rotations of 3D space: made by `from_axis_angle(axis, angle)`,
// `from_rotation_x(angle)` … `from_euler_xyz(x, y, z)` or `Quat.identity()`
// (std.algebra's trait). `a * b` rotates by `b` first, `q * v` rotates the
// vector `v`; `slerp`, `to_mat4` and the rest are methods. Angles are in
// radians, rotations right-handed (counterclockwise looking at the origin
// from the axis' positive side), as std.matrix's.

import std.float as fl
from std.algebra import Identity
from std.vector import Vec3, vec3
from std.matrix import Mat3, Mat4, mat3
from std.quaternion32 import Quat as QuatF32

#derive(Eq, Hash)
pub struct Quat {
    x: float64,
    y: float64,
    z: float64,
    w: float64,
}

pub fun quat(x: float64, y: float64, z: float64, w: float64) -> Quat {
    return Quat { x: x, y: y, z: z, w: w }
}

// The rotation by `angle` about `axis` (normalized here).
pub fun from_axis_angle(axis: Vec3, angle: float64) -> Quat {
    let a = axis.normalized()
    let h = angle * 0.5
    let s = h.sin()
    return Quat { x: a.x * s, y: a.y * s, z: a.z * s, w: h.cos() }
}

pub fun from_rotation_x(angle: float64) -> Quat {
    return from_axis_angle(vec3(1.0, 0.0, 0.0), angle)
}

pub fun from_rotation_y(angle: float64) -> Quat {
    return from_axis_angle(vec3(0.0, 1.0, 0.0), angle)
}

pub fun from_rotation_z(angle: float64) -> Quat {
    return from_axis_angle(vec3(0.0, 0.0, 1.0), angle)
}

// The rotation by `x` about the x axis, then `y` about y, then `z` about z.
pub fun from_euler_xyz(x: float64, y: float64, z: float64) -> Quat {
    return from_rotation_z(z) * from_rotation_y(y) * from_rotation_x(x)
}

impl Identity for Quat {
    fun identity() -> Quat {
        return Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    }
}

impl Format for Quat {
    fun format(self, spec: str) -> str {
        return f"({self.x}, {self.y}, {self.z}, {self.w})"
    }
}

// The rotation by `o` first, then by `self` (Hamilton's product).
impl Mul for Quat {
    fun mul(self, o: Quat) -> Quat {
        return Quat {
            x: self.w * o.x + self.x * o.w + self.y * o.z - self.z * o.y,
            y: self.w * o.y - self.x * o.z + self.y * o.w + self.z * o.x,
            z: self.w * o.z + self.x * o.y - self.y * o.x + self.z * o.w,
            w: self.w * o.w - self.x * o.x - self.y * o.y - self.z * o.z,
        }
    }
}

// The vector `v` rotated.
impl Mul<Vec3, Vec3> for Quat {
    fun mul(self, v: Vec3) -> Vec3 {
        let u = vec3(self.x, self.y, self.z)
        let t = u.cross(v) * 2.0
        return v + t * self.w + u.cross(t)
    }
}

impl Mul<float64> for Quat {
    fun mul(self, k: float64) -> Quat {
        return Quat { x: self.x * k, y: self.y * k, z: self.z * k, w: self.w * k }
    }
}

impl Mul<Quat, Quat> for float64 {
    fun mul(self, q: Quat) -> Quat {
        return q * self
    }
}

impl Add for Quat {
    fun add(self, o: Quat) -> Quat {
        return Quat { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z, w: self.w + o.w }
    }
}

impl Sub for Quat {
    fun sub(self, o: Quat) -> Quat {
        return Quat { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z, w: self.w - o.w }
    }
}

impl Neg for Quat {
    fun neg(self) -> Quat {
        return Quat { x: -self.x, y: -self.y, z: -self.z, w: -self.w }
    }
}

impl Quat {
    fun dot(self, o: Quat) -> float64 {
        return self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w
    }

    fun length_squared(self) -> float64 {
        return self.dot(self)
    }

    fun length(self) -> float64 {
        return self.dot(self).sqrt()
    }

    fun normalized(self) -> Quat {
        return self * (1.0 / self.length())
    }

    #test(Quat { x: 1.0, y: 2.0, z: 3.0, w: 4.0 })[Quat { x: -1.0, y: -2.0, z: -3.0, w: 4.0 }]
    fun conjugate(self) -> Quat {
        return Quat { x: -self.x, y: -self.y, z: -self.z, w: self.w }
    }

    // The inverse rotation (the conjugate over the squared length).
    fun inverse(self) -> Quat {
        return self.conjugate() * (1.0 / self.length_squared())
    }

    // The rotation `t` of the way from `self` to `end` along the shorter
    // arc, at a constant angular speed (a normalized blend when they are
    // nearly the same).
    fun slerp(self, end: Quat, t: float64) -> Quat {
        var e = end
        var d = self.dot(end)
        if d < 0.0 {
            e = -end
            d = -d
        }
        if d > 0.9995 { return (self + (e - self) * t).normalized() }
        let theta = d.acos()
        let s = theta.sin()
        return self * ((theta * (1.0 - t)).sin() / s) + e * ((theta * t).sin() / s)
    }

    // The rotation as a matrix (of a unit quaternion).
    fun to_mat3(self) -> Mat3 {
        let x2 = self.x + self.x
        let y2 = self.y + self.y
        let z2 = self.z + self.z
        let xx = self.x * x2
        let xy = self.x * y2
        let xz = self.x * z2
        let yy = self.y * y2
        let yz = self.y * z2
        let zz = self.z * z2
        let wx = self.w * x2
        let wy = self.w * y2
        let wz = self.w * z2
        return mat3(vec3(1.0 - (yy + zz), xy + wz, xz - wy), vec3(xy - wz, 1.0 - (xx + zz), yz + wx), vec3(xz + wy, yz - wx, 1.0 - (xx + yy)))
    }

    fun to_mat4(self) -> Mat4 {
        return self.to_mat3().to_mat4()
    }

    // The axis and the angle of the rotation (of a unit quaternion); the x
    // axis and 0 for none.
    fun to_axis_angle(self) -> (Vec3, float64) {
        let w = self.w.clamp(-1.0, 1.0)
        let s = (1.0 - w * w).sqrt()
        if s < 0.000001 { return (vec3(1.0, 0.0, 0.0), 0.0) }
        return (vec3(self.x / s, self.y / s, self.z / s), 2.0 * w.acos())
    }

    fun to_f32(self) -> QuatF32 {
        return QuatF32 { x: self.x as float32, y: self.y as float32, z: self.z as float32, w: self.w as float32 }
    }
}
