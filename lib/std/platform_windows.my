// std.platform — the platform layer under std.rt: Windows on x86-64
// (MYLA-702, the Windows port's first step, D210 to D216).
//
// The same functions as std/platform.my (Linux on x86-64), over kernel32
// (D212: no C runtime, no ntdll). A call of kernel32's function `Name` is
// `__syscall(__rt_get("__imp_Name"), a, b, c)` or `__syscall5(…, d, e)`:
// the word of its import slot is the function's address, which the
// runtime's `__syscall` calls with Win64's convention
// (selfhost/runtime_x86.my, `emit_windows_calls`), and the code generator
// records the name for the program's import library (D211). A function of
// another DLL is called the same way, once selfhost/codegen.my's
// `windows_dlls` names its DLL (bcrypt's, MYLA-722). A BOOL or a
// DWORD comes back in the low 32 bits only (`ok`, `& LOW32`). A failure's
// `GetLastError` is given back as a Myla cause, negative (`cause`, D219).
//
// Strings are UTF-8 in Myla and UTF-16 only at the system's calls (D215):
// the command line and the environment are made UTF-8 once at the start
// (`windows_start`), the console's code pages are UTF-8 while the program
// runs, and "\n" is written as is, never as "\r\n".
//
// What this step has (D210): the standard streams (descriptors 0, 1 and 2,
// the process's standard handles), the heap's memory (VirtualAlloc), the
// clocks and sleeping, the arguments, the environment and the exit; files,
// directories and the working directory (MYLA-704); child processes
// (MYLA-705); the workers' parking and the CPUs they may use (MYLA-703: the
// threads, each one's state block and a stack overflow's report are the
// runtime's, selfhost/runtime_x86.my); random bytes (bcrypt, MYLA-722);
// the console as the terminal and its control events as signals
// (MYLA-707); sockets over Winsock 2 and the poller on an I/O completion
// port (MYLA-706). Not for programs (its primitives are the standard
// library's, D100).

// The target this module is the platform layer of, as `--target` names it:
// the target a program built with it runs on (x86-64 Windows).
pub const TARGET: str = "x86_64-windows"

// What a function that fails gives: minus a cause code (D129, D209, D219),
// never Windows' error code, which `cause` maps here, so nothing above this
// module knows Windows' numbers. The codes are std.ioerror's, the same in
// every platform module (tests/burn/test_platform_interface.py holds them
// to it): 1 to 21 the causes of `IoError`, 32 to 35 those std.rt and
// std.net act on themselves, and from OTHER on OTHER plus the system's own
// code (`IoError.Other(code)`).
pub const NOT_FOUND: int64 = 1
pub const PERMISSION_DENIED: int64 = 2
pub const ALREADY_EXISTS: int64 = 3
pub const NOT_A_DIRECTORY: int64 = 4
pub const IS_A_DIRECTORY: int64 = 5
pub const NOT_EMPTY: int64 = 6
pub const INTERRUPTED: int64 = 7
pub const CANCELLED: int64 = 8
pub const UNSUPPORTED: int64 = 9
pub const BROKEN_PIPE: int64 = 10
pub const INVALID_INPUT: int64 = 11
pub const CONNECTION_REFUSED: int64 = 12
pub const CONNECTION_RESET: int64 = 13
pub const CONNECTION_ABORTED: int64 = 14
pub const NOT_CONNECTED: int64 = 15
pub const ADDR_IN_USE: int64 = 16
pub const ADDR_NOT_AVAILABLE: int64 = 17
pub const TIMED_OUT: int64 = 18
pub const HOST_UNREACHABLE: int64 = 19
pub const NETWORK_UNREACHABLE: int64 = 20
pub const INVALID_DATA: int64 = 21
pub const WOULD_BLOCK: int64 = 32
pub const IN_PROGRESS: int64 = 33
pub const BAD_HANDLE: int64 = 34
pub const NOT_A_TERMINAL: int64 = 35
pub const OTHER: int64 = 256

// What a file is (`path_stat`, `fd_stat`, `path_kind`) or a directory's entry
// names (`dir_entry_kind`): KIND_UNKNOWN for an entry the file system gave no
// kind (a caller that needs one asks `path_stat`).
pub const KIND_UNKNOWN: int64 = 0
pub const KIND_FILE: int64 = 1
pub const KIND_DIR: int64 = 2
pub const KIND_SYMLINK: int64 = 3
pub const KIND_CHAR_DEVICE: int64 = 4
pub const KIND_BLOCK_DEVICE: int64 = 5
pub const KIND_FIFO: int64 = 6
pub const KIND_SOCKET: int64 = 7
pub const KIND_OTHER: int64 = 8

// What a target may lack (D209, D210): processes are there (MYLA-705);
// without sockets every `sock_` function fails with UNSUPPORTED, until
// their step (MYLA-706).
pub const PROCESSES: bool = true
pub const SOCKETS: bool = true
// Whether memory unmapped goes back to the system (VirtualFree).
pub const RETURNS_MEMORY: bool = true
// Whether `advise_huge_pages` can back memory with huge pages (large pages
// need a privilege a program rarely holds: none asked for).
pub const HUGE_PAGES: bool = false

const ENOSYS: int64 = -UNSUPPORTED
const LOW32: int64 = 4294967295i64
// the code page of UTF-8 (D215)
const CP_UTF8: int64 = 65001
// VirtualAlloc's and VirtualFree's
const MEM_COMMIT_RESERVE: int64 = 12288
const MEM_DECOMMIT: int64 = 16384
const MEM_RELEASE: int64 = 32768
// VirtualQuery's state of a region reserved, nothing committed
// (MEMORY_BASIC_INFORMATION's `State`)
const MEM_RESERVE: int64 = 8192
const PAGE_READWRITE: int64 = 4
// a wait without a time limit (WaitOnAddress's, Sleep's)
const INFINITE: int64 = 4294967295i64
// the 100-nanosecond intervals from 1601 to 1970 (a FILETIME's epoch)
const EPOCH_1970: int64 = 116444736000000000i64

// --- calls and their errors --------------------------------------------------------

// Whether a BOOL `r` says the call worked (its low 32 bits not 0).
fun ok(r: int64) -> bool {
    return (r & LOW32) != 0
}

// The calling thread's last error (`GetLastError`).
fun last_error() -> int64 {
    return __syscall(__rt_get("__imp_GetLastError"), 0, 0, 0) & LOW32
}

// What a failed call gives: minus the cause of the last error.
fun failed() -> int64 {
    return -cause(last_error())
}

// The cause code of Windows' error code `e` (winerror.h): the file and path
// not found NOT_FOUND, access denied and a sharing violation
// PERMISSION_DENIED, a pipe being closed, broken or not connected
// BROKEN_PIPE. One without a cause is OTHER plus Linux's errno of the same
// meaning where Linux has one (`linux_errno`), so that an `Other` reads the
// same on every target (std.rt's and std.io's texts name Linux's numbers:
// a full disk is "no space left on device"), as wasm32 does with WASI's
// (MYLA-426); else OTHER plus 4096 plus Windows' own code, past every
// Linux errno, so it is never taken for one.
#test(2)[1]
#test(3)[1]
#test(5)[2]
#test(6)[34]
#test(80)[3]
#test(183)[3]
#test(145)[6]
#test(267)[4]
#test(50)[9]
#test(87)[11]
#test(109)[10]
#test(232)[10]
#test(233)[10]
#test(995)[8]
#test(1460)[18]
#test(13)[21]
#test(112)[284]
#test(8)[268]
#test(17)[274]
#test(1392)[5744]
fun cause(e: int64) -> int64 {
    if e == 2 || e == 3 || e == 15 || e == 161 { return NOT_FOUND }        // FILE_, PATH_NOT_FOUND, INVALID_DRIVE, BAD_PATHNAME
    if e == 5 || e == 32 || e == 33 || e == 1314 { return PERMISSION_DENIED } // ACCESS_DENIED, SHARING_, LOCK_VIOLATION, PRIVILEGE_NOT_HELD
    if e == 80 || e == 183 { return ALREADY_EXISTS }                         // FILE_EXISTS, ALREADY_EXISTS
    if e == 267 { return NOT_A_DIRECTORY }                                   // DIRECTORY
    if e == 145 { return NOT_EMPTY }                                         // DIR_NOT_EMPTY
    if e == 995 || e == 1223 { return CANCELLED }                            // OPERATION_ABORTED, CANCELLED
    if e == 1 || e == 50 || e == 120 { return UNSUPPORTED }                  // INVALID_FUNCTION, NOT_SUPPORTED, CALL_NOT_IMPLEMENTED
    if e == 109 || e == 232 || e == 233 { return BROKEN_PIPE }               // BROKEN_PIPE, NO_DATA, PIPE_NOT_CONNECTED
    if e == 87 || e == 123 { return INVALID_INPUT }                          // INVALID_PARAMETER, INVALID_NAME
    if e == 258 || e == 1460 { return TIMED_OUT }                            // WAIT_TIMEOUT, TIMEOUT
    if e == 13 || e == 1113 { return INVALID_DATA }                          // INVALID_DATA, NO_UNICODE_TRANSLATION
    if e == 997 { return IN_PROGRESS }                                       // IO_PENDING
    if e == 6 { return BAD_HANDLE }                                          // INVALID_HANDLE
    return OTHER + linux_errno(e)
}

// Linux's errno of the same meaning as Windows' code `e` that has no cause,
// else 4096 plus `e`.
#test(112)[28]
#test(39)[28]
#test(4)[24]
#test(14)[12]
#test(223)[27]
#test(1117)[5]
#test(1392)[5488]
fun linux_errno(e: int64) -> int64 {
    if e == 4 { return 24 }                          // TOO_MANY_OPEN_FILES: EMFILE
    if e == 8 || e == 14 { return 12 }               // NOT_ENOUGH_MEMORY, OUTOFMEMORY: ENOMEM
    if e == 17 { return 18 }                         // NOT_SAME_DEVICE: EXDEV
    if e == 19 { return 30 }                         // WRITE_PROTECT: EROFS
    if e == 23 || e == 1117 { return 5 }             // CRC, IO_DEVICE: EIO
    if e == 39 || e == 112 { return 28 }             // HANDLE_DISK_FULL, DISK_FULL: ENOSPC
    if e == 206 { return 36 }                        // FILENAME_EXCED_RANGE: ENAMETOOLONG
    if e == 223 { return 27 }                        // FILE_TOO_LARGE: EFBIG
    if e == 1921 { return 40 }                       // CANT_RESOLVE_FILENAME: ELOOP
    return 4096 + e
}

// --- text: UTF-16 at the system, UTF-8 in Myla (D215) ------------------------------

// The UTF-16 code unit at `p`.
fun unit(p: int64) -> int64 {
    return (__load8(p) as int64) | ((__load8(p + 1) as int64) << 8)
}

// The `n` UTF-16 code units at `p`.
fun units_at(p: int64, n: int64) -> [int] {
    var out: [int] = []
    var i: int64 = 0
    while i < n {
        out.push(unit(p + 2 * i) as int)
        i += 1
    }
    return out
}

// How many units the NUL-terminated UTF-16 text at `p` has.
fun wide_len(p: int64) -> int64 {
    var n: int64 = 0
    while unit(p + 2 * n) != 0 {
        n += 1
    }
    return n
}

// The code point at `units[i]` and how many units it takes: a surrogate
// pair one, a lone surrogate U+FFFD (as Windows itself converts it).
#test([65], 0)[(65, 1)]
#test([55357, 56832, 33], 0)[(128512, 2)]
#test([55357, 33], 0)[(65533, 1)]
#test([56832], 0)[(65533, 1)]
fun code_point(units: [int], i: int) -> (int, int) {
    let c = units[i]
    if c >= 55296 && c < 56320 && i + 1 < units.len() {
        let d = units[i + 1]
        if d >= 56320 && d < 57344 {
            return (65536 + ((c - 55296) << 10) + (d - 56320), 2)
        }
    }
    if c >= 55296 && c < 57344 {
        return (65533, 1)
    }
    return (c, 1)
}

// `units[start:end]` as UTF-8.
fun utf8_of(units: [int], start: int, end: int) -> str {
    var sb = StringBuilder()
    var i = start
    while i < end {
        let (c, used) = code_point(units, i)
        sb.append_char(c as char)
        i += used
    }
    return sb.build()
}

// The UTF-16 units of `s` (for the tests).
fun units_of(s: str) -> [int] {
    var out: [int] = []
    for c in s.chars() {
        let v = c as int
        if v >= 65536 {
            out.push(55296 + ((v - 65536) >> 10))
            out.push(56320 + ((v - 65536) & 1023))
        } else {
            out.push(v)
        }
    }
    return out
}

// --- the start ---------------------------------------------------------------------

// What the runtime's `_start` calls first (selfhost/runtime_x86.my): the
// console's code pages set to UTF-8 (D215), the ones before kept to be put
// back at the exit (`__win_console_cp`; 0 where there is no console); the
// arguments (`GetCommandLineW`, `split_command_line`) and the environment
// (`GetEnvironmentStringsW`, `environment_strings`) laid out as the kernel
// lays them out on Linux, for `__argv` and `__environ` (`c_vector`).
pub fun windows_start() {
    let cp = __rt_addr("__win_console_cp")
    __store64(cp, __syscall(__rt_get("__imp_GetConsoleOutputCP"), 0, 0, 0) & LOW32)
    __store64(cp + 8, __syscall(__rt_get("__imp_GetConsoleCP"), 0, 0, 0) & LOW32)
    if __load64(cp) != 0 {
        let o = __syscall(__rt_get("__imp_SetConsoleOutputCP"), CP_UTF8, 0, 0)
    }
    if __load64(cp + 8) != 0 {
        let i = __syscall(__rt_get("__imp_SetConsoleCP"), CP_UTF8, 0, 0)
    }
    let cl = __syscall(__rt_get("__imp_GetCommandLineW"), 0, 0, 0)
    var line: [int] = []
    if cl != 0 {
        line = units_at(cl, wide_len(cl))
    }
    __store64(__rt_addr("__argv"), c_vector(split_command_line(line)))
    let block = __syscall(__rt_get("__imp_GetEnvironmentStringsW"), 0, 0, 0)
    var env: [int] = []
    if block != 0 {
        var n: int64 = 0
        while unit(block + 2 * n) != 0 || unit(block + 2 * n + 2) != 0 {
            n += 1
        }
        env = units_at(block, n + 1)
        let freed = __syscall(__rt_get("__imp_FreeEnvironmentStringsW"), block, 0, 0)
    }
    __store64(__rt_addr("__envp"), c_vector(environment_strings(env)))
}

// `xs` as a list of 8-byte pointers to NUL-terminated copies of them,
// ending with 0, in memory of its own (never freed): its address.
fun c_vector(xs: [str]) -> int64 {
    var bytes: int64 = 8 * (xs.len() as int64 + 1)
    for x in xs {
        bytes += x.len() as int64 + 1
    }
    let v = map_memory(bytes)
    if v < 0 {
        __trap_oom()
    }
    var o = v + 8 * (xs.len() as int64 + 1)
    var k: int64 = 0
    for x in xs {
        let n = x.len() as int64
        __store64(v + 8 * k, o)
        __copy_bytes(o, __addr_of(x) + 8, n)
        __store8(o + n, 0u8)
        o += n + 1
        k += 1
    }
    __store64(v + 8 * k, 0)
    return v
}

// The command line `line` (its UTF-16 units) split into arguments, in
// UTF-8, as Windows' C runtime splits it (the rules of `CommandLineToArgvW`
// and of MSVC's runtime since 2008): the program's name up to the first
// blank, or between quotes without escapes; then words between blanks
// (spaces and tabs), where quotes group blanks into a word, `""` within
// quotes is a quote, and backslashes are literal but before a quote, where
// each two are one and an odd one makes the quote literal.
#test("prog a b")[["prog", "a", "b"]]
#test("\"C:\\My Dir\\p.exe\"  x\ty ")[["C:\\My Dir\\p.exe", "x", "y"]]
#test("p \"two words\" \"\" q\"uo\"te")[["p", "two words", "", "quote"]]
#test("p a\\\\b c\\\\\\\"d e\\\\\"f g\"")[["p", "a\\\\b", "c\\\"d", "e\\f g"]]
#test("p \"in \"\"q\"\" x\" tail\\")[["p", "in \"q\" x", "tail\\"]]
#test("p \u{e9}\u{4e2d} \u{1f600}")[["p", "\u{e9}\u{4e2d}", "\u{1f600}"]]
#test("")[[""]]
fun split_command_line_test(cl: str) -> [str] {
    return split_command_line(units_of(cl))
}

fun split_command_line(line: [int]) -> [str] {
    let n = line.len()
    var out: [str] = []
    var at = 0
    // the program's name
    if n > 0 && line[0] == 34 {
        at = 1
        while at < n && line[at] != 34 {
            at += 1
        }
        out.push(utf8_of(line, 1, at))
        if at < n {
            at += 1
        }
    } else {
        while at < n && line[at] != 32 && line[at] != 9 {
            at += 1
        }
        out.push(utf8_of(line, 0, at))
    }
    while true {
        while at < n && (line[at] == 32 || line[at] == 9) {
            at += 1
        }
        if at >= n {
            break
        }
        var sb = StringBuilder()
        var quoted = false
        while at < n {
            let c = line[at]
            if (c == 32 || c == 9) && !quoted {
                break
            }
            if c == 92 {
                // backslashes: literal, but before a quote
                var b = 0
                while at < n && line[at] == 92 {
                    b += 1
                    at += 1
                }
                let quote = at < n && line[at] == 34
                var lit = b
                if quote {
                    lit = b / 2
                }
                var i = 0
                while i < lit {
                    sb.append_byte(92u8)
                    i += 1
                }
                if quote && b % 2 == 1 {
                    sb.append_byte(34u8)
                    at += 1
                }
            } else if c == 34 {
                if quoted && at + 1 < n && line[at + 1] == 34 {
                    sb.append_byte(34u8)
                    at += 2
                } else {
                    quoted = !quoted
                    at += 1
                }
            } else {
                let (cp, used) = code_point(line, at)
                sb.append_char(cp as char)
                at += used
            }
        }
        out.push(sb.build())
    }
    return out
}

// The environment block `block` (its UTF-16 units: `name=value` strings,
// each ending with a NUL, then a NUL) as its strings, in UTF-8. Windows'
// own entries of a drive's directory (`=C:=C:\…`) are left out, as no
// variable's name starts with `=`.
#test("A=1|B=x y||")[["A=1", "B=x y"]]
#test("=C:=C:\\w|PATH=a;b||")[["PATH=a;b"]]
#test("|")[[]]
fun environment_test(block: str) -> [str] {
    var units = units_of(block)
    var i = 0
    while i < units.len() {
        if units[i] == 124 {
            units[i] = 0
        }
        i += 1
    }
    return environment_strings(units)
}

fun environment_strings(block: [int]) -> [str] {
    var out: [str] = []
    var at = 0
    while at < block.len() && block[at] != 0 {
        var end = at
        while end < block.len() && block[end] != 0 {
            end += 1
        }
        if block[at] != 61 {
            out.push(utf8_of(block, at, end))
        }
        at = end + 1
    }
    return out
}

// --- the standard streams ---------------------------------------------------------

// The handle of the descriptor `fd`, 0 for none. A descriptor is a
// handle (MYLA-704): a file's, a directory's (`open_file`, `open_dir`), a
// pipe's (a child's stream), a process's (a child's `exited`, MYLA-705);
// but 0, 1 and 2, which no handle is (a handle is a multiple of 4, an old
// console's 3 more), are the standard streams (input, output, error:
// `GetStdHandle`). A negative one is none (-1 and -2 would be the process's
// and the thread's own pseudo-handles).
fun std_handle(fd: int64) -> int64 {
    if fd < 0 {
        return 0
    }
    if fd > 2 {
        return fd
    }
    let h = __syscall(__rt_get("__imp_GetStdHandle"), -10 - fd, 0, 0)
    if h == -1 {
        return 0
    }
    return h
}

// Up to `n` bytes of `fd` read to `buf`: how many (0 at the end: a pipe
// whose writer closed it, ERROR_BROKEN_PIPE, is one).
pub fun read(fd: int64, buf: int64, n: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return -BAD_HANDLE
    }
    var len = n
    if len > 1073741824 {
        len = 1073741824
    }
    if fd > 2 && ws_kind(h) == K_PIPE_IN {
        return pipe_read(h, buf, len)
    }
    let done = __rt_addr("__win_io")
    __store64(done, 0)
    let r = __syscall5(__rt_get("__imp_ReadFile"), h, buf, len, done, 0)
    let got = __load64(done) & LOW32
    if got == 0 && len > 0 && console_read_aborted(h) {
        return read(fd, buf, n)
    }
    if !ok(r) {
        let e = last_error()
        if e == 109 || e == 38 {
            return 0  // BROKEN_PIPE, HANDLE_EOF
        }
        return -access_cause(e)
    }
    return got
}

// Whether a read of `h` that gave nothing was a read of the console that a
// Ctrl-C ended (ERROR_OPERATION_ABORTED, as Python's console reader takes
// it), the error then cleared: the read goes on, as Linux restarts a read
// that a signal std.signal catches interrupts (SA_RESTART); without a
// listener the Ctrl-C ends the program meanwhile (MYLA-707).
fun console_read_aborted(h: int64) -> bool {
    if last_error() != 995 {
        return false
    }
    // (another handle's error kept for the caller's cause)
    let console = console_mode(h) >= 0
    let c = __syscall(__rt_get("__imp_SetLastError"), if console { 0 } else { 995 }, 0, 0)
    return console
}

// The kind of the watched handle of `h` (K_PIPE_IN, …), 0 for a handle
// that has none (a file, the console, an anonymous pipe).
fun ws_kind(h: int64) -> int64 {
    net_lock()
    let ws = ws_find(h)
    var k: int64 = 0
    if ws != 0 {
        k = __load64(ws + WS_KIND)
    }
    net_unlock()
    return k
}

// Up to `n` bytes of our end `h` of a child's output pipe (overlapped,
// MYLA-706) read to `buf`, the thread waiting as a plain read does: how
// many (0 at the end), or minus the cause. Its OVERLAPPED's event is one
// of its own with the low bit set, so the port gets no packet for it.
fun pipe_read(h: int64, buf: int64, n: int64) -> int64 {
    let ev = __syscall5(__rt_get("__imp_CreateEventW"), 0, 1, 0, 0, 0)
    if ev == 0 {
        return failed()
    }
    let ov = __alloc(40)
    __store64(ov, 0)
    __store64(ov + 8, 0)
    __store64(ov + 16, 0)
    __store64(ov + 24, ev | 1)
    var r = __syscall5(__rt_get("__imp_ReadFile"), h, buf, n, 0, ov)
    var e: int64 = 0
    if !ok(r) {
        e = last_error()
    }
    if ok(r) || e == WSA_IO_PENDING {
        while __load_acq64(ov) == STATUS_PENDING {
            let w = __syscall(__rt_get("__imp_WaitForSingleObject"), ev, WAIT_INFINITE, 0)
        }
        r = __syscall5(__rt_get("__imp_GetOverlappedResult"), h, ov, ov + 32, 0, 0)
        e = 0
        if !ok(r) {
            e = last_error()
        }
    }
    let got = __load64(ov + 32) & LOW32
    __free(ov)
    let c = __syscall(__rt_get("__imp_CloseHandle"), ev, 0, 0)
    if e == 109 || e == 38 || e == 233 {
        return 0  // BROKEN_PIPE, HANDLE_EOF, PIPE_NOT_CONNECTED
    }
    if e != 0 {
        return -access_cause(e)
    }
    return got
}

// Up to `n` bytes at `buf` written to our end `h` of a child's input pipe
// (overlapped, MYLA-706, MYLA-726): a copy of at most SEND_ROOM of them
// written overlapped, how many (once the write before has ended, waited
// for here; how it failed, if it did, is this one's error). A write that
// goes on when this returns is the poller's to hear of: until it ends,
// `poll_write` says there is no room, so `write_async`'s task waits with
// the task suspended, not its worker.
fun pipe_write(ws: int64, h: int64, buf: int64, n: int64) -> int64 {
    if (__load64(ws + WS_FLAGS) & F_SENDING) != 0 {
        let done = op_wait(ws, WS_SEND, __load64(ws + WS_SEND_EVENT), -1)
        let st = __load_acq64(ws + WS_SEND)
        ws_flag(h, F_SENDING, false)
        if status_cause(st) != 0 {
            return -status_cause(st)
        }
    }
    var len = n
    if len > SEND_ROOM {
        len = SEND_ROOM
    }
    if !send_room(ws, len) {
        return failed()
    }
    __copy_bytes(__load64(ws + WS_BUF), buf, len)
    net_lock()
    op_reset(ws, WS_SEND, __load64(ws + WS_SEND_EVENT))
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | F_SENDING)
    let r = __syscall5(__rt_get("__imp_WriteFile"), h, __load64(ws + WS_BUF), len, 0, ws + WS_SEND)
    let going = op_started(ws, call_going(r), F_SENDING)
    let e = last_error()
    net_unlock()
    if !going {
        return -access_cause(e)
    }
    return len
}

// The cause of the error `e` of a read or a write: access denied, for a
// handle opened without the access, BAD_HANDLE as Linux's EBADF.
fun access_cause(e: int64) -> int64 {
    if e == 5 {
        return BAD_HANDLE
    }
    return cause(e)
}

// Up to `n` bytes at `buf` written to `fd`: how many.
pub fun write(fd: int64, buf: int64, n: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return -BAD_HANDLE
    }
    var len = n
    if len > 1073741824 {
        len = 1073741824
    }
    if fd > 2 {
        let ws = ws_hold(h)
        if ws != 0 && __load64(ws + WS_KIND) == K_PIPE_OUT {
            let r = pipe_write(ws, h, buf, len)
            ws_release(ws)
            return r
        }
        ws_release(ws)
    }
    // (how many bytes, in a block of the runtime's: a write reports
    // running out of memory, so it can't allocate)
    let done = __rt_addr("__win_io")
    __store64(done, 0)
    let r = __syscall5(__rt_get("__imp_WriteFile"), h, buf, len, done, 0)
    let wrote = __load64(done) & LOW32
    if !ok(r) {
        return -access_cause(last_error())
    }
    return wrote
}

// The descriptor `fd` closed: its handle closed (`CloseHandle`, one that
// isn't open BAD_HANDLE: a file's, a child's pipe or process); one of the
// standard streams left without one (a write to it then BAD_HANDLE, as
// Linux's EBADF).
pub fun close(fd: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return -BAD_HANDLE
    }
    if fd > 2 && !ws_closed(h) {
        return 0
    }
    let r = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
    if fd > 2 {
        if !ok(r) {
            return failed()
        }
        return 0
    }
    let none = __syscall(__rt_get("__imp_SetStdHandle"), -10 - fd, 0, 0)
    if !ok(r) {
        return failed()
    }
    return 0
}

// The watched handle of `h` (if it has one) closed, before the handle is:
// true when the caller closes the handle now, false when it is closed later
// (our end of a child's input pipe whose write goes on: once it ends,
// `ws_close_later`). A process's wait of the pool's is given back first,
// once its callback has returned (UnregisterWaitEx), as a wait on a closed
// handle is undefined.
fun ws_closed(h: int64) -> bool {
    var wait: int64 = 0
    net_lock()
    ws_later()
    let ws = ws_take(h)
    if ws == 0 {
        net_unlock()
        return true
    }
    if __load64(ws + WS_KIND) == K_PIPE_OUT && ws_going(ws, WS_SEND, F_SENDING) &&
            ws_close_later(ws, __rt_get("__imp_CloseHandle")) {
        net_unlock()
        return false
    }
    if (__load64(ws + WS_FLAGS) & F_WAITING) != 0 {
        __store64(ws + WS_FLAGS, (__load64(ws + WS_FLAGS) & ~F_WAITING) | F_CLOSED)
        wait = __load64(ws + WS_WAIT)
    }
    if wait == 0 {
        ws_drop(ws)
        net_unlock()
        return true
    }
    net_unlock()
    let u = __syscall(__rt_get("__imp_UnregisterWaitEx"), wait, UNTIL_DONE, 0)
    net_lock()
    if __load_acq64(ws + WS_POST + 32) == 0 {
        // (it never posted: no packet is due for it)
        __store64(ws + WS_REFS, __load64(ws + WS_REFS) - 1)
    }
    ws_drop(ws)
    net_unlock()
    return true
}

// 1 when a read of `fd` won't block (input, its end, or an error), 0 when
// `timeout_ms` (negative: none) ran out: a pipe asked how much it holds
// (`PeekNamedPipe`), every millisecond; anything else (a file, the
// console, and under Wine a Linux pipe handed over, which isn't a named
// pipe) is taken for ready (MYLA-708 checks the limit on Windows). A
// child's process (`spawn_piped`'s `exited`) is ready once it ended,
// waited for (`WaitForSingleObject`) as a pidfd is polled on Linux.
pub fun poll_read(fd: int64, timeout_ms: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return 1
    }
    if handle_kind(h) == WATCH_WAITABLE {
        var limit = timeout_ms
        if limit < 0 {
            limit = WAIT_INFINITE
        }
        if (__syscall(__rt_get("__imp_WaitForSingleObject"), h, limit, 0) & LOW32) == WAITED_OUT {
            return 0
        }
        return 1
    }
    if timeout_ms < 0 {
        return 1
    }
    let avail = __alloc(8)
    let start = clock_ns()
    var ready: int64 = 0
    while true {
        __store64(avail, 0)
        let r = __syscall5(__rt_get("__imp_PeekNamedPipe"), h, 0, 0, 0, avail)
        if !ok(r) || (__load64(avail) & LOW32) != 0 {
            ready = 1
            break
        }
        if clock_ns() - start >= timeout_ms * 1000000 {
            break
        }
        let s = __syscall(__rt_get("__imp_Sleep"), 1, 0, 0)
    }
    __free(avail)
    return ready
}

// 1 when a write of `fd` won't wait: our end of a child's input pipe once
// its write before has ended (MYLA-726), waited for at most `timeout_ms`
// (negative: no limit), 0 when that ran out; anything else (a write to a
// standard stream blocks until it is done, as a blocking descriptor's
// does) 1.
pub fun poll_write(fd: int64, timeout_ms: int64) -> int64 {
    let h = std_handle(fd)
    if fd <= 2 || h == 0 {
        return 1
    }
    let ws = ws_hold(h)
    var r: int64 = 1
    if ws != 0 && __load64(ws + WS_KIND) == K_PIPE_OUT && ws_going(ws, WS_SEND, F_SENDING) &&
            !op_wait(ws, WS_SEND, __load64(ws + WS_SEND_EVENT), timeout_ms) {
        r = 0
    }
    ws_release(ws)
    return r
}

// The `n` bytes at `p` written to `fd`, a write at a time: 0, or the first
// error (minus its cause).
pub fun write_all(fd: int64, p: int64, n: int64) -> int64 {
    var at = p
    var left = n
    while left > 0 {
        let r = write(fd, at, left)
        if r < 0 {
            return r
        }
        at += r
        left -= r
    }
    return 0
}

// The `n` bytes at `p` and a newline on the standard output in one write
// (copied after each other), so that lines don't interleave; 0, or the
// first error (minus its cause).
pub fun write_line(p: int64, n: int64) -> int64 {
    let buf = __alloc(n + 1)
    __copy_bytes(buf, p, n)
    __store8(buf + n, 10u8)
    let r = write_all(1, buf, n + 1)
    __free(buf)
    return r
}

// A write to a closed pipe on the standard output or error ends the program
// quietly (D146): Windows has no SIGPIPE, so with the exit code a shell
// shows for a process that SIGPIPE ended, as on wasm32.
pub fun broken_pipe() {
    exit(141)
}

// --- files and directories (MYLA-704) ---------------------------------------------------
// A path crosses as UTF-16 (`wide`, D215), `/` and `\` both its separators
// (Windows reads both); a descriptor is the handle of the file or directory
// (`std_handle`). A file is opened sharing reading, writing and removing it
// with every other handle, as on Linux, where an open file locks nothing.
// What Windows reports otherwise than Linux is made Linux's where a
// program would see it: a directory opened as a file IS_A_DIRECTORY, and a
// path through a file NOT_A_DIRECTORY, not access denied and a path not
// found (`open_handle`, `path_failed`).

// CreateFile2's access rights, sharing, ways to open and flags
const GENERIC_READ: int64 = 2147483648i64
const GENERIC_WRITE: int64 = 1073741824
// FILE_GENERIC_WRITE less FILE_WRITE_DATA: every write at the end
const APPEND_ACCESS: int64 = 1179924
const FILE_READ_ATTRIBUTES: int64 = 128
const SHARE_ALL: int64 = 7
const CREATE_NEW: int64 = 1
const CREATE_ALWAYS: int64 = 2
const OPEN_EXISTING: int64 = 3
const OPEN_ALWAYS: int64 = 4
const TRUNCATE_EXISTING: int64 = 5
const FILE_FLAG_BACKUP_SEMANTICS: int64 = 33554432
const FILE_FLAG_OPEN_REPARSE_POINT: int64 = 2097152
// a file's attributes, and GetFileAttributesW's failure
const ATTR_READONLY: int64 = 1
const ATTR_DIRECTORY: int64 = 16
const ATTR_REPARSE_POINT: int64 = 1024
const NO_ATTRIBUTES: int64 = 4294967295i64
// the reparse points that are links: a symbolic link, a junction, WSL's
const TAG_SYMLINK: int64 = 2684354572i64
const TAG_MOUNT_POINT: int64 = 2684354563i64
const TAG_LX_SYMLINK: int64 = 2684354589i64
// GetFileType's
const FILE_TYPE_DISK: int64 = 1
const FILE_TYPE_CHAR: int64 = 2
const FILE_TYPE_PIPE: int64 = 3
// GetFileInformationByHandleEx's classes
const ATTRIBUTE_TAG_INFO: int64 = 9
const ID_BOTH_DIRECTORY_INFO: int64 = 10
// the causes Linux gives where Windows has none: ESPIPE, ERANGE
const ILLEGAL_SEEK: int64 = 285
const OUT_OF_RANGE: int64 = 290

// `s` as the NUL-terminated UTF-16 text the system reads (D215), in memory
// the caller frees: a byte that starts no well-formed UTF-8 character is
// U+FFFD (`utf8_char`; a unit for each byte at most, so `2 * len + 2`
// bytes are room).
fun wide(s: str) -> int64 {
    let p = __addr_of(s) + 8
    let n = __load64(p - 8)
    let out = __alloc(2 * n + 2)
    var i: int64 = 0
    var o = out
    while i < n {
        // the three bytes after this one that are there, the first lowest
        var next: int64 = 0
        var k: int64 = 3
        while k > 0 {
            next = next << 8
            if i + k < n {
                next |= __load8(p + i + k) as int64
            }
            k -= 1
        }
        let (c, used) = utf8_char(__load8(p + i) as int64, next, n - i - 1)
        if c >= 65536 {
            store_unit(o, 55296 + ((c - 65536) >> 10))
            store_unit(o + 2, 56320 + ((c - 65536) & 1023))
            o += 4
        } else {
            store_unit(o, c)
            o += 2
        }
        i += used
    }
    store_unit(o, 0)
    return out
}

// The UTF-16 code unit `u` stored at `p`.
fun store_unit(p: int64, u: int64) {
    __store8(p, (u & 255) as uint8)
    __store8(p + 1, ((u >> 8) & 255) as uint8)
}

// The code point of the UTF-8 character that starts with the byte `b`, the
// bytes after it `next` (the first lowest), `left` of them there, and its
// length in bytes; a byte that starts none (a stray continuation, an
// overlong form, a surrogate, past U+10FFFF, cut off) is U+FFFD, one byte.
#test(104, 0, 0)[(104, 1)]
#test(195, 169, 1)[(233, 2)]
#test(228, 0xADB8, 2)[(20013, 3)]
#test(240, 0x80989F, 3)[(128512, 4)]
#test(128, 65, 1)[(65533, 1)]
#test(192, 175, 1)[(65533, 1)]
#test(224, 0x8080, 2)[(65533, 1)]
#test(237, 0x80A0, 2)[(65533, 1)]
#test(244, 0x808090, 3)[(65533, 1)]
#test(240, 0x989F, 2)[(65533, 1)]
#test(195, 65, 1)[(65533, 1)]
#test(255, 0, 0)[(65533, 1)]
fun utf8_char(b: int64, next: int64, left: int64) -> (int64, int64) {
    if b < 128 {
        return (b, 1)
    }
    var len: int64 = 4
    var c = b & 7
    var least: int64 = 65536
    if b >= 194 && b < 224 {
        len = 2
        c = b & 31
        least = 128
    } else if b >= 224 && b < 240 {
        len = 3
        c = b & 15
        least = 2048
    } else if b < 240 || b >= 245 {
        return (65533, 1)
    }
    if len - 1 > left {
        return (65533, 1)
    }
    var k: int64 = 1
    while k < len {
        let d = (next >> (8 * (k - 1))) & 255
        if (d & 192) != 128 {
            return (65533, 1)
        }
        c = (c << 6) | (d & 63)
        k += 1
    }
    if c < least || c > 1114111 || (c >= 55296 && c < 57344) {
        return (65533, 1)
    }
    return (c, len)
}

// The `n` UTF-16 units at `src` written to `dst` as UTF-8, a lone surrogate
// as U+FFFD (`joined_units`): how many bytes (three a unit at most).
fun put_utf8(dst: int64, src: int64, n: int64) -> int64 {
    var o = dst
    var i: int64 = 0
    while i < n {
        var d: int64 = -1
        if i + 1 < n {
            d = unit(src + 2 * i + 2)
        }
        let (c, used) = joined_units(unit(src + 2 * i), d)
        i += used
        let (bytes, len) = utf8_bytes(c)
        var k: int64 = 0
        while k < len {
            __store8(o + k, ((bytes >> (8 * k)) & 255) as uint8)
            k += 1
        }
        o += len
    }
    return o - dst
}

// The code point the UTF-16 unit `c` starts, `d` the unit after it (-1 for
// none), and how many units it takes: a surrogate pair two, a lone
// surrogate U+FFFD, as Windows converts one.
#test(65, 66)[(65, 1)]
#test(55357, 56832)[(128512, 2)]
#test(55357, 65)[(65533, 1)]
#test(55357, -1)[(65533, 1)]
#test(56832, 55357)[(65533, 1)]
fun joined_units(c: int64, d: int64) -> (int64, int64) {
    if c >= 55296 && c < 56320 && d >= 56320 && d < 57344 {
        return (65536 + ((c - 55296) << 10) + (d - 56320), 2)
    }
    if c >= 55296 && c < 57344 {
        return (65533, 1)
    }
    return (c, 1)
}

// The UTF-8 bytes of the code point `c`, the first lowest, and how many.
#test(65)[(65, 1)]
#test(233)[(0xA9C3, 2)]
#test(20013)[(0xADB8E4, 3)]
#test(128512)[(0x80989FF0, 4)]
fun utf8_bytes(c: int64) -> (int64, int64) {
    if c < 128 {
        return (c, 1)
    }
    if c < 2048 {
        return ((192 | (c >> 6)) | ((128 | (c & 63)) << 8), 2)
    }
    if c < 65536 {
        return ((224 | (c >> 12)) | ((128 | ((c >> 6) & 63)) << 8) | ((128 | (c & 63)) << 16), 3)
    }
    return ((240 | (c >> 18)) | ((128 | ((c >> 12) & 63)) << 8) | ((128 | ((c >> 6) & 63)) << 16) | ((128 | (c & 63)) << 24), 4)
}

// The attributes of what the path `w` names (GetFileAttributesW, a link
// not followed), NO_ATTRIBUTES for none.
fun attributes(w: int64) -> int64 {
    return __syscall(__rt_get("__imp_GetFileAttributesW"), w, 0, 0) & LOW32
}

// Whether the attributes `a` are a directory's.
fun is_dir_attr(a: int64) -> bool {
    return a != NO_ATTRIBUTES && (a & ATTR_DIRECTORY) != 0
}

// What a call on the path `w` that failed with the error `e` gives: minus
// its cause, but what Linux reports where Windows reports a path not found
// or a bad name: a name longer than 255 units ENAMETOOLONG's `Other` (no
// file system of either takes one, D220), and a path through a file
// NOT_A_DIRECTORY (ENOTDIR), found by asking each directory the path names
// before its last component for its attributes (and the last one too when
// the path ends in a separator).
fun path_failed(w: int64, e: int64) -> int64 {
    if e != 2 && e != 3 && e != 123 && e != 206 {
        return -cause(e)
    }
    let n = wide_len(w)
    var run: int64 = 0
    var k: int64 = 0
    while k < n {
        run += 1
        if is_sep(unit(w + 2 * k)) {
            run = 0
        }
        if run > 255 {
            return -(OTHER + 36)
        }
        k += 1
    }
    let trailing = n > 0 && is_sep(unit(w + 2 * n - 2))
    if e == 2 && !trailing {
        return -cause(e)
    }
    var i: int64 = 1
    while i < n {
        let c = unit(w + 2 * i)
        if is_sep(c) && !is_sep(unit(w + 2 * i - 2)) {
            store_unit(w + 2 * i, 0)
            let a = attributes(w)
            store_unit(w + 2 * i, c)
            if a != NO_ATTRIBUTES && (a & ATTR_DIRECTORY) == 0 {
                return -NOT_A_DIRECTORY
            }
        }
        i += 1
    }
    return -cause(e)
}

// Whether the UTF-16 unit `c` separates a path's components.
fun is_sep(c: int64) -> bool {
    return c == 47 || c == 92
}

// What `path` names opened (`CreateFile2`) for `access`, as `disposition`
// says, with `flags`: its handle, or minus the cause. A directory opened as
// a file is IS_A_DIRECTORY (Windows: access denied), as Linux reports
// reading or writing one.
fun open_handle(path: str, access: int64, disposition: int64, flags: int64) -> int64 {
    let w = wide(path)
    // CREATEFILE2_EXTENDED_PARAMETERS: its size and FILE_ATTRIBUTE_NORMAL,
    // the flags, no security attributes or template
    let params = __alloc(32)
    __store64(params, 32 | (128i64 << 32))
    __store64(params + 8, flags)
    __store64(params + 16, 0)
    __store64(params + 24, 0)
    var h = __syscall5(__rt_get("__imp_CreateFile2"), w, access, SHARE_ALL, disposition, params)
    if h == -1 {
        let e = last_error()
        if e == 5 && (flags & FILE_FLAG_BACKUP_SEMANTICS) == 0 && is_dir_attr(attributes(w)) {
            h = -IS_A_DIRECTORY
        } else {
            h = path_failed(w, e)
        }
    }
    __free(params)
    __free(w)
    return h
}

// The file at `path` opened for reading: its descriptor.
pub fun open_read(path: str) -> int64 {
    return open_handle(path, GENERIC_READ, OPEN_EXISTING, 0)
}

// The file at `path` opened for writing, created or emptied.
pub fun open_write(path: str) -> int64 {
    return open_handle(path, GENERIC_WRITE, CREATE_ALWAYS, 0)
}

// The directory at `path` opened for listing (`dir_read`); a file
// NOT_A_DIRECTORY, as Linux's O_DIRECTORY.
pub fun open_dir(path: str) -> int64 {
    let h = open_handle(path, GENERIC_READ, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS)
    if h < 0 {
        return h
    }
    let info = __alloc(56)
    let r = __syscall(__rt_get("__imp_GetFileInformationByHandle"), h, info, 0)
    let a = __load64(info) & LOW32
    __free(info)
    if !ok(r) || (a & ATTR_DIRECTORY) == 0 {
        let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
        return -NOT_A_DIRECTORY
    }
    return h
}

// The size of the open file `fd`, 0 when it has none (a pipe, the console).
pub fun file_size(fd: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return 0
    }
    let w = __alloc(8)
    __store64(w, 0)
    let r = __syscall(__rt_get("__imp_GetFileSizeEx"), h, w, 0)
    var size: int64 = 0
    if ok(r) {
        size = __load64(w)
    }
    __free(w)
    return size
}

// The file at `path` opened with std.rt's portable `flags` (1 read, 2
// write, 4 create, 8 truncate, 16 append, 32 exclusive; at least one of the
// first two): its descriptor. `mode` isn't used: Windows has no permission
// bits, and a new file isn't read-only (D218).
pub fun open_file(path: str, flags: int64, mode: int64) -> int64 {
    var access: int64 = 0
    if (flags & 1) != 0 {
        access |= GENERIC_READ
    }
    if (flags & 2) != 0 {
        if (flags & 16) != 0 {
            access |= APPEND_ACCESS
        } else {
            access |= GENERIC_WRITE
        }
    }
    return open_handle(path, access, disposition_of(flags), 0)
}

// How CreateFile2 opens a file for the portable `flags`: exclusive with
// create CREATE_NEW, create and truncate CREATE_ALWAYS, create alone
// OPEN_ALWAYS, truncate alone TRUNCATE_EXISTING, else OPEN_EXISTING.
#test(1)[3]
#test(3 | 4)[4]
#test(2 | 8)[5]
#test(2 | 4 | 8)[2]
#test(3 | 4 | 32)[1]
#test(2 | 4 | 8 | 32)[1]
#test(2 | 32)[3]
#test(2 | 4 | 16)[4]
fun disposition_of(flags: int64) -> int64 {
    let create = (flags & 4) != 0
    let truncate = (flags & 8) != 0
    if create && (flags & 32) != 0 {
        return CREATE_NEW
    }
    if create && truncate {
        return CREATE_ALWAYS
    }
    if create {
        return OPEN_ALWAYS
    }
    if truncate {
        return TRUNCATE_EXISTING
    }
    return OPEN_EXISTING
}

// The cursor of `fd` moved to `offset` from the start (`whence` 0), the
// cursor (1) or the end (2): the new offset. One before the start or past
// int64's range is INVALID_INPUT and leaves the cursor, as Linux's lseek;
// a pipe or the console can't seek (ESPIPE's `Other`).
pub fun seek(fd: int64, offset: int64, whence: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return -BAD_HANDLE
    }
    let t = file_type(h)
    if t < 0 {
        return t
    }
    if t != FILE_TYPE_DISK {
        return -ILLEGAL_SEEK
    }
    let w = __alloc(8)
    __store64(w, 0)
    var r: int64 = 1
    if whence == 1 {
        r = __syscall5(__rt_get("__imp_SetFilePointerEx"), h, 0, w, 1, 0)
    } else if whence == 2 {
        r = __syscall(__rt_get("__imp_GetFileSizeEx"), h, w, 0)
    }
    let base = __load64(w)
    if !ok(r) {
        __free(w)
        return failed()
    }
    if (offset > 0 && base > 9223372036854775807i64 - offset) || base + offset < 0 {
        __free(w)
        return -INVALID_INPUT
    }
    r = __syscall5(__rt_get("__imp_SetFilePointerEx"), h, base + offset, w, 0, 0)
    let at = __load64(w)
    __free(w)
    if !ok(r) {
        return failed()
    }
    return at
}

// What the handle `h` is (`GetFileType`: FILE_TYPE_DISK, a pipe, a
// character device, 0 for another), or minus the cause (a handle that isn't
// open BAD_HANDLE).
fun file_type(h: int64) -> int64 {
    // (an unknown type sets no error)
    let none = __syscall(__rt_get("__imp_SetLastError"), 0, 0, 0)
    let t = __syscall(__rt_get("__imp_GetFileType"), h, 0, 0) & LOW32
    if t == 0 && last_error() != 0 {
        return failed()
    }
    return t
}

// The size, the kind (KIND_FILE, …), the permission bits and the
// modification time (nanoseconds since 1970) of the open file `fd`, as four
// words at `out`: 0, or minus its cause.
pub fun fd_stat(fd: int64, out: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return -BAD_HANDLE
    }
    return handle_stat(h, out, false)
}

// `fd_stat`'s four words of the open handle `h` at `out`, then, when `ids`,
// the volume's serial number and the file's index on it (which together
// tell one file from another). A pipe or the console is a FIFO or a
// character device, its size and time 0 (GetFileType); a file's is
// GetFileInformationByHandle's, and a reparse point's tag says whether it
// is a link (`kind_of`). 0, or minus the cause.
fun handle_stat(h: int64, out: int64, ids: bool) -> int64 {
    let t = file_type(h)
    if t < 0 {
        return t
    }
    if t != FILE_TYPE_DISK {
        var kind = KIND_OTHER
        if t == FILE_TYPE_CHAR {
            kind = KIND_CHAR_DEVICE
        } else if t == FILE_TYPE_PIPE {
            kind = KIND_FIFO
        }
        __store64(out, 0)
        __store64(out + 8, kind)
        __store64(out + 16, 438)
        __store64(out + 24, 0)
        if ids {
            __store64(out + 32, 0)
            __store64(out + 40, 0)
        }
        return 0
    }
    // BY_HANDLE_FILE_INFORMATION: the attributes at 0, the last write's
    // FILETIME at 20, the volume's serial number at 28, the size's high and
    // low halves at 32 and 36, the index's at 44 and 48
    let info = __alloc(56)
    let r = __syscall(__rt_get("__imp_GetFileInformationByHandle"), h, info, 0)
    if !ok(r) {
        __free(info)
        return failed()
    }
    let attrs = __load64(info) & LOW32
    var tag: int64 = 0
    if (attrs & ATTR_REPARSE_POINT) != 0 {
        // FILE_ATTRIBUTE_TAG_INFO: the attributes, the reparse tag
        let ti = __alloc(8)
        if ok(__syscall5(__rt_get("__imp_GetFileInformationByHandleEx"), h, ATTRIBUTE_TAG_INFO, ti, 8, 0)) {
            tag = (__load64(ti) >> 32) & LOW32
        }
        __free(ti)
    }
    let kind = kind_of(attrs, tag)
    __store64(out, ((__load64(info + 32) & LOW32) << 32) | (__load64(info + 36) & LOW32))
    __store64(out + 8, kind)
    __store64(out + 16, permissions_of(attrs, kind))
    __store64(out + 24, (__load64(info + 20) - EPOCH_1970) * 100)
    if ids {
        __store64(out + 32, __load64(info + 28) & LOW32)
        __store64(out + 40, ((__load64(info + 44) & LOW32) << 32) | (__load64(info + 48) & LOW32))
    }
    __free(info)
    return 0
}

// The kind of a file of the attributes `attrs`, a reparse point's tag `tag`:
// a symbolic link or a junction KIND_SYMLINK (a reparse point of another
// tag, a file in the cloud say, is what it holds), a directory KIND_DIR, the
// rest KIND_FILE.
#test(32, 0)[1]
#test(16, 0)[2]
#test(1056, 2684354572)[3]
#test(1040, 2684354563)[3]
#test(1056, 2684354589)[3]
#test(1056, 2147483674)[1]
#test(1040, 0)[2]
fun kind_of(attrs: int64, tag: int64) -> int64 {
    if (attrs & ATTR_REPARSE_POINT) != 0 && (tag == TAG_SYMLINK || tag == TAG_MOUNT_POINT || tag == TAG_LX_SYMLINK) {
        return KIND_SYMLINK
    }
    if (attrs & ATTR_DIRECTORY) != 0 {
        return KIND_DIR
    }
    return KIND_FILE
}

// A file's permission bits from its read-only attribute (D218): 0o444 or
// 0o666, a directory 0o555 or 0o777, a link 0o777, as Linux shows one.
#test(32, 1)[438]
#test(33, 1)[292]
#test(16, 2)[511]
#test(17, 2)[365]
#test(1057, 3)[511]
fun permissions_of(attrs: int64, kind: int64) -> int64 {
    if kind == KIND_SYMLINK {
        return 511
    }
    let readonly = (attrs & ATTR_READONLY) != 0
    if kind == KIND_DIR {
        if readonly {
            return 365
        }
        return 511
    }
    if readonly {
        return 292
    }
    return 438
}

// The size, the kind, the permission bits, the modification time, the
// volume and the file's index on it of what `path` names, as six words at
// `out` (`handle_stat`), opened for its attributes only: a symbolic link
// followed when `follow`, else described itself
// (FILE_FLAG_OPEN_REPARSE_POINT). 0, or minus its cause.
pub fun path_stat(path: str, follow: bool, out: int64) -> int64 {
    var flags = FILE_FLAG_BACKUP_SEMANTICS
    if !follow {
        flags |= FILE_FLAG_OPEN_REPARSE_POINT
    }
    let h = open_handle(path, FILE_READ_ATTRIBUTES, OPEN_EXISTING, flags)
    if h < 0 {
        return h
    }
    let r = handle_stat(h, out, true)
    let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
    return r
}

// `n` bytes of the system's entropy at `buf` (getrandom(2)'s on Linux): 0,
// or minus the cause. They come from bcrypt (D212, MYLA-722):
// `BCryptGenRandom` with no algorithm's handle and the system's preferred
// generator, at most RANDOM_CHUNK bytes a call (its count is a ULONG). It
// gives an NTSTATUS, not a last error: a failure is INVALID_INPUT for
// STATUS_INVALID_PARAMETER, else Linux's EIO (`Other(5)`, "input/output
// error").
pub fun random_fill(buf: int64, n: int64) -> int64 {
    var done: int64 = 0
    while done < n {
        var want = n - done
        if want > RANDOM_CHUNK {
            want = RANDOM_CHUNK
        }
        let status = __syscall5(__rt_get("__imp_BCryptGenRandom"), 0, buf + done, want, BCRYPT_USE_SYSTEM_PREFERRED_RNG, 0) & LOW32
        if status == STATUS_INVALID_PARAMETER {
            return -INVALID_INPUT
        }
        if status != 0 {
            return -(OTHER + 5)
        }
        done += want
    }
    return 0
}

// BCryptGenRandom's flag for the system's generator, without a handle
const BCRYPT_USE_SYSTEM_PREFERRED_RNG: int64 = 2
const STATUS_INVALID_PARAMETER: int64 = 3221225485i64
// the most bytes a call of BCryptGenRandom is asked for (1 GiB)
const RANDOM_CHUNK: int64 = 1073741824

// The kind of what `path` names (KIND_FILE, …; symbolic links followed), or
// minus its cause.
pub fun path_kind(path: str) -> int64 {
    let out = __alloc(48)
    var r = path_stat(path, true, out)
    if r >= 0 {
        r = __load64(out + 8)
    }
    __free(out)
    return r
}

// A call of the kernel32 function at `f` on the path `path` (a BOOL): 0, or
// minus the cause (`path_failed`).
fun on_path(f: int64, path: str) -> int64 {
    let w = wide(path)
    var r: int64 = 0
    if !ok(__syscall(f, w, 0, 0)) {
        r = path_failed(w, last_error())
    }
    __free(w)
    return r
}

// A directory (`CreateDirectoryW`); `mode` isn't used (D218).
pub fun make_dir(path: str, mode: int64) -> int64 {
    return on_path(__rt_get("__imp_CreateDirectoryW"), path)
}

// The file (or symbolic link) at `path` removed (`DeleteFileW`). A
// directory is IS_A_DIRECTORY, as Linux's unlink says (Windows: access
// denied), but a link to one is removed as Windows removes one
// (`RemoveDirectoryW`).
pub fun remove_file(path: str) -> int64 {
    let w = wide(path)
    var r: int64 = 0
    if !ok(__syscall(__rt_get("__imp_DeleteFileW"), w, 0, 0)) {
        let e = last_error()
        let a = attributes(w)
        if e == 5 && is_dir_attr(a) && (a & ATTR_REPARSE_POINT) != 0 {
            if !ok(__syscall(__rt_get("__imp_RemoveDirectoryW"), w, 0, 0)) {
                r = failed()
            }
        } else if e == 5 && is_dir_attr(a) {
            r = -IS_A_DIRECTORY
        } else {
            r = path_failed(w, e)
        }
    }
    __free(w)
    return r
}

// The empty directory at `path` removed (`RemoveDirectoryW`).
pub fun remove_dir(path: str) -> int64 {
    return on_path(__rt_get("__imp_RemoveDirectoryW"), path)
}

// `from_path` renamed `to_path`, replacing a file there, as Linux's rename
// (`MoveFileExW` with MOVEFILE_REPLACE_EXISTING).
pub fun rename(from_path: str, to_path: str) -> int64 {
    let a = wide(from_path)
    let b = wide(to_path)
    var r: int64 = 0
    if !ok(__syscall(__rt_get("__imp_MoveFileExW"), a, b, 1)) {
        r = path_failed(a, last_error())
    }
    __free(b)
    __free(a)
    return r
}

// The working directory's path written to `buf` (room for `n` bytes), in
// UTF-8: its length; ERANGE's `Other` for one longer than `n`, as Linux's
// getcwd.
pub fun cwd(buf: int64, n: int64) -> int64 {
    let w = __alloc(2 * n + 2)
    let units = __syscall(__rt_get("__imp_GetCurrentDirectoryW"), n + 1, w, 0) & LOW32
    if units == 0 {
        __free(w)
        return failed()
    }
    var len: int64 = -OUT_OF_RANGE
    if units <= n {
        let text = __alloc(3 * units)
        len = put_utf8(text, w, units)
        if len <= n {
            __copy_bytes(buf, text, len)
        } else {
            len = -OUT_OF_RANGE
        }
        __free(text)
    }
    __free(w)
    return len
}

// The next entries of the directory `fd` read to `buf` (room for `n`
// bytes), as records of this module's own that `dir_entry_size`,
// `dir_entry_name`, `dir_entry_name_len` and `dir_entry_kind` read: how
// many bytes of them (0 at the end), or minus its cause. Windows gives
// FILE_ID_BOTH_DIR_INFO records (`GetFileInformationByHandleEx`) in half of
// `n`, each made one of ours: its size, its kind and its name's length in
// three words, then the name in UTF-8, padded to 8 bytes. A record of ours
// is at most twice the size of Windows' (at least 104 bytes and two a unit
// of its name; ours 24 and three a unit), so the records fit in `n`.
pub fun dir_read(fd: int64, buf: int64, n: int64) -> int64 {
    let h = std_handle(fd)
    if h == 0 {
        return -BAD_HANDLE
    }
    let room = (n / 2) & -8
    let raw = __alloc(room)
    if !ok(__syscall5(__rt_get("__imp_GetFileInformationByHandleEx"), h, ID_BOTH_DIRECTORY_INFO, raw, room, 0)) {
        let e = last_error()
        __free(raw)
        if e == 18 || e == 2 {
            return 0  // NO_MORE_FILES, FILE_NOT_FOUND: no more entries
        }
        return -cause(e)
    }
    // FILE_ID_BOTH_DIR_INFO: the next record's offset at 0 (0 for none), the
    // attributes at 56, the name's length in bytes at 60, a reparse point's
    // tag at 64, the name at 104
    var at: int64 = 0
    var o: int64 = 0
    while true {
        let rec = raw + at
        let attrs = __load64(rec + 56) & LOW32
        let len = put_utf8(buf + o + 24, rec + 104, (__load64(rec + 60) & LOW32) / 2)
        let size = (24 + len + 7) & -8
        __store64(buf + o, size)
        __store64(buf + o + 8, kind_of(attrs, __load64(rec + 64) & LOW32))
        __store64(buf + o + 16, len)
        o += size
        let next = __load64(rec) & LOW32
        if next == 0 {
            break
        }
        at += next
    }
    __free(raw)
    return o
}

// The size of the directory record at `rec` (the next one follows it).
pub fun dir_entry_size(rec: int64) -> int64 {
    return __load64(rec)
}

// Where the name of the entry at `rec` starts (`dir_entry_name_len` bytes,
// UTF-8).
pub fun dir_entry_name(rec: int64) -> int64 {
    return rec + 24
}

// The length of the name of the entry at `rec`, in bytes.
pub fun dir_entry_name_len(rec: int64) -> int64 {
    return __load64(rec + 16)
}

// The kind of the entry at `rec` (from its attributes and tag: `kind_of`).
pub fun dir_entry_kind(rec: int64) -> int64 {
    return __load64(rec + 8)
}

// --- processes (MYLA-705) -----------------------------------------------------------
// A child is `CreateProcessW`'s: its program found here, through PATH and
// PATHEXT (`program_candidates`; std.rt hands the name over as it is), its
// arguments one command line its C runtime splits back
// (`command_line`, the inverse of `split_command_line`), a batch file run
// by cmd with its arguments quoted for cmd (`bat_command_line`), its
// standard handles those of `STARTUPINFO` (the only handles it inherits:
// PROC_THREAD_ATTRIBUTE_HANDLE_LIST). Its process ID is the `pid` std.rt
// and std.process know; its process handle is the descriptor `exited`,
// which is ready once it ended (for `poll_read` and the poller, as a pidfd
// is on Linux) and, while it is open, keeps the ID the child's, so `reap`,
// `try_reap` and `kill` open the child again by its ID. Windows has no
// signals: a child's status is its exit code's 32 bits (D216), and `kill`
// ends it with the code 1.

// Added to the cause of a directory the child can't be started in (past
// every cause code and OTHER plus any system's code; std.process's
// `SpawnError.WorkingDir`), as on Linux.
const DIR_FAILED: int64 = 65536
// WaitForSingleObject's limit for none, and its answers
const WAIT_INFINITE: int64 = 4294967295i64
const WAITED_OUT: int64 = 258
// PROC_THREAD_ATTRIBUTE_HANDLE_LIST, EXTENDED_STARTUPINFO_PRESENT,
// CREATE_UNICODE_ENVIRONMENT, STARTF_USESTDHANDLES
const HANDLE_LIST: int64 = 131074
const EXTENDED_STARTUP: int64 = 524288
const UNICODE_ENVIRONMENT: int64 = 1024
const USE_STD_HANDLES: int64 = 256
// OpenProcess's rights: SYNCHRONIZE, PROCESS_QUERY_LIMITED_INFORMATION,
// PROCESS_TERMINATE
const CHILD_RIGHTS: int64 = 1052673
// what PATHEXT is without one (Windows' own)
const DEFAULT_PATHEXT: str = ".COM;.EXE;.BAT;.CMD"

// The kernel32 function at the import slot `f` called with `args` (up to
// ten) through the runtime's `__win_call` (selfhost/runtime_x86.my), for
// the functions `__syscall5` has too few arguments for.
fun win_call(f: int64, args: [int64]) -> int64 {
    let b = __alloc(88)
    __store64(b, f)
    var k: int64 = 0
    while k < 10 {
        var v: int64 = 0
        if k < args.len() as int64 {
            v = args[k as int]
        }
        __store64(b + 8 + 8 * k, v)
        k += 1
    }
    let r = __syscall(__rt_addr("__win_call"), b, 0, 0)
    __free(b)
    return r
}

// The UTF-16 code units `units` in memory of their own (to `__free`).
fun units_mem(units: [int]) -> int64 {
    let n = units.len() as int64
    let p = __alloc(2 * n + 2)
    var i: int64 = 0
    while i < n {
        let u = units[i as int] as int64
        __store8(p + 2 * i, (u & 255) as uint8)
        __store8(p + 2 * i + 1, ((u >> 8) & 255) as uint8)
        i += 1
    }
    return p
}

// `s` as NUL-terminated UTF-16 (D215), in memory of its own (to `__free`).
fun spawn_wide(s: str) -> int64 {
    var units = units_of(s)
    units.push(0)
    return units_mem(units)
}

// Whether the byte `b` is in `s`.
#test("a\"b", 34u8)[true]
#test("ab", 34u8)[false]
fun has_byte(s: str, b: uint8) -> bool {
    var i = 0
    while i < s.len() {
        if s[i] == b {
            return true
        }
        i += 1
    }
    return false
}

// `b` in upper case, if it is an ASCII letter.
fun upper(b: uint8) -> uint8 {
    if b >= 97u8 && b <= 122u8 {
        return b - 32u8
    }
    return b
}

// Whether `a` ends with `tail`, ASCII's case ignored.
#test("x.BaT", ".bat")[true]
#test("x.bat.exe", ".bat")[false]
#test("t", ".bat")[false]
fun ends_with_ci(a: str, tail: str) -> bool {
    if a.len() < tail.len() {
        return false
    }
    let at = a.len() - tail.len()
    var i = 0
    while i < tail.len() {
        if upper(a[at + i]) != upper(tail[i]) {
            return false
        }
        i += 1
    }
    return true
}

// The decimal digits of `n` (not negative).
#test(0)["0"]
#test(4096)["4096"]
fun decimal(n: int64) -> str {
    var digits: [uint8] = []
    var v = n
    while true {
        digits.push(48u8 + (v % 10) as uint8)
        v = v / 10
        if v == 0 {
            break
        }
    }
    var sb = StringBuilder()
    var i = digits.len() - 1
    while i >= 0 {
        sb.append_byte(digits[i])
        i -= 1
    }
    return sb.build()
}

// --- the command line

// `argv` as the command line Windows' C runtime splits back into it
// (`split_command_line`, its inverse; Rust's and Python's quoting): the
// program's name between quotes, as it is (it can't hold one: the caller
// refuses that), each argument after a blank as it is unless it is empty
// or holds a blank, then between quotes; inside, a quote after `n`
// backslashes is `2n + 1` backslashes and the quote, and the `n`
// backslashes before a closing quote are `2n`.
#test(["p", "a b", ""])["\"p\" \"a b\" \"\""]
#test(["C:\\x y\\p.exe", "quo\"te", "back\\slash", "tail\\"])["\"C:\\x y\\p.exe\" quo\\\"te back\\slash tail\\"]
#test(["p", "a b\\", "a\\\"b", "\tx"])["\"p\" \"a b\\\\\" a\\\\\\\"b \"\tx\""]
#test([])[""]
fun command_line(argv: [str]) -> str {
    var sb = StringBuilder()
    var k = 0
    for a in argv {
        if k == 0 {
            sb.append("\"")
            sb.append(a)
            sb.append("\"")
        } else {
            sb.append(" ")
            sb.append(quoted_arg(a))
        }
        k += 1
    }
    return sb.build()
}

// Whether `command_line(argv)` splits back into `argv`.
#test(["p", "plain", "two words", "quo\"te", "back\\slash", "tail\\", "", "\u{e9}\u{4e2d} \u{1f600}", "a\\\\\"b", "\tx", "x\\\\", "\"", "\\\"\\", "\"\"", "a\\\\ b\\\\"])[true]
#test(["C:\\My Dir\\p.exe"])[true]
fun splits_back(argv: [str]) -> bool {
    return split_command_line(units_of(command_line(argv))) == argv
}

// One argument as `command_line` writes it.
fun quoted_arg(a: str) -> str {
    let quote = a.len() == 0 || has_byte(a, 32u8) || has_byte(a, 9u8)
    var sb = StringBuilder()
    if quote {
        sb.append_byte(34u8)
    }
    var backslashes = 0
    var i = 0
    while i < a.len() {
        let b = a[i]
        if b == 92u8 {
            backslashes += 1
        } else {
            if b == 34u8 {
                for k in 0..backslashes + 1 {
                    sb.append_byte(92u8)
                }
            }
            backslashes = 0
        }
        sb.append_byte(b)
        i += 1
    }
    if quote {
        for k in 0..backslashes {
            sb.append_byte(92u8)
        }
        sb.append_byte(34u8)
    }
    return sb.build()
}

// The command line that runs the batch file `script` with the arguments
// `args` through cmd (`cmd.exe /c`, which CreateProcess would start for it
// without quoting the arguments for cmd: Rust's quoting since CVE-2024-24576,
// which cmd's own rules read back): `/e:ON /v:OFF /d`, the whole command
// between quotes, the script's path between quotes of its own, each
// argument as `bat_quoted_arg` gives it. "" when it can't be: a quote in
// the path or a backslash at its end, which no file name has, a carriage
// return or a newline in an argument, which would end cmd's line.
#test("C:\\t\\e.bat", ["a b", "c&d", "50%", "", "x\\", "q\"q", "ok-1.2/x"])["cmd.exe /e:ON /v:OFF /d /c \"\"C:\\t\\e.bat\" \"a b\" \"c&d\" \"50%%cd:~,%\" \"\" \"x\\\\\" \"q\"\"q\" ok-1.2/x\""]
#test("C:\\t\\e\".bat", ["a"])[""]
#test("C:\\t\\e.bat", ["a\nb"])[""]
fun bat_command_line(script: str, args: [str]) -> str {
    if has_byte(script, 34u8) || (script.len() > 0 && script[script.len() - 1] == 92u8) {
        return ""
    }
    var sb = StringBuilder()
    sb.append("cmd.exe /e:ON /v:OFF /d /c \"\"")
    sb.append(script)
    sb.append("\"")
    for a in args {
        if has_byte(a, 13u8) || has_byte(a, 10u8) {
            return ""
        }
        sb.append(" ")
        sb.append(bat_quoted_arg(a))
    }
    sb.append("\"")
    return sb.build()
}

// One argument of a batch file's command line: between quotes unless it
// is only letters, digits and `#$*+-./:?@\_` (and not empty, nor ending
// with a backslash, which would take the closing quote); inside, a quote
// doubled (after its backslashes doubled) and each `%` written
// `%%cd:~,%`, which cmd reads as a `%` that names no variable.
fun bat_quoted_arg(a: str) -> str {
    var quote = a.len() == 0 || a[a.len() - 1] == 92u8
    for c in a {
        let v = c as int
        if v < 128 {
            let alnum = (v >= 48 && v <= 57) || (v >= 65 && v <= 90) || (v >= 97 && v <= 122)
            let plain = v == 35 || v == 36 || v == 42 || v == 43 || v == 45 || v == 46 || v == 47 || v == 58 || v == 63 || v == 64 || v == 92 || v == 95
            if !alnum && !plain {
                quote = true
            }
        } else if v < 160 {
            quote = true      // a C1 control
        }
    }
    var sb = StringBuilder()
    if quote {
        sb.append_byte(34u8)
    }
    var backslashes = 0
    var i = 0
    while i < a.len() {
        let b = a[i]
        if b == 92u8 {
            backslashes += 1
        } else {
            if b == 34u8 {
                for k in 0..backslashes {
                    sb.append_byte(92u8)
                }
                sb.append_byte(34u8)
            } else if b == 37u8 {
                sb.append("%%cd:~,")
            }
            backslashes = 0
        }
        sb.append_byte(b)
        i += 1
    }
    if quote {
        for k in 0..backslashes {
            sb.append_byte(92u8)
        }
        sb.append_byte(34u8)
    }
    return sb.build()
}

// --- the program: PATH and PATHEXT

// The files `program` may be, in the order they are tried (D147, as Windows'
// shell looks, without its working directory first): a name with a
// directory (a `/`, a `\` or a drive) is itself and then itself with each of
// PATHEXT's extensions (`pathext`, Windows' own list without one); a name
// alone the same in each directory of PATH (`path`, its `;`-separated
// entries, quotes taken off, empty ones skipped), itself first only when it
// has an extension, as a file without one isn't run from PATH.
#test("C:\\bin\\p.exe", "C:\\a", ".EXE")[["C:\\bin\\p.exe", "C:\\bin\\p.exe.EXE"]]
#test("./helper", "", ".COM;.EXE")[["./helper", "./helper.COM", "./helper.EXE"]]
#test("D:x", "", ".EXE")[["D:x", "D:x.EXE"]]
#test("helper", "C:\\a;;\"C:\\b c\";D:\\d\\", ".COM;.EXE")[["C:\\a\\helper.COM", "C:\\a\\helper.EXE", "C:\\b c\\helper.COM", "C:\\b c\\helper.EXE", "D:\\d\\helper.COM", "D:\\d\\helper.EXE"]]
#test("run.bat", "C:\\a", ".COM;.BAT")[["C:\\a\\run.bat", "C:\\a\\run.bat.COM", "C:\\a\\run.bat.BAT"]]
#test("p", "C:\\a", "")[["C:\\a\\p.COM", "C:\\a\\p.EXE", "C:\\a\\p.BAT", "C:\\a\\p.CMD"]]
#test("p", "", ".EXE")[[]]
#test("", "C:\\a", ".EXE")[[""]]
fun program_candidates(program: str, path: str, pathext: str) -> [str] {
    if program == "" {
        return [program]
    }
    var exts = list_entries(pathext)
    if exts.len() == 0 {
        exts = list_entries(DEFAULT_PATHEXT)
    }
    var dirs: [str] = []
    var name_start = 0
    var i = 0
    while i < program.len() {
        if program[i] == 47u8 || program[i] == 92u8 {   // '/', '\'
            name_start = i + 1
        }
        i += 1
    }
    let with_dir = name_start > 0 || (program.len() >= 2 && program[1] == 58u8)   // a drive's ':'
    var has_ext = false
    i = name_start
    while i < program.len() {
        if program[i] == 46u8 {      // '.'
            has_ext = true
        }
        i += 1
    }
    var out: [str] = []
    if with_dir {
        out.push(program)
        for e in exts {
            out.push(program + e)
        }
        return out
    }
    for d in list_entries(path) {
        var dir = d
        if dir[dir.len() - 1] != 92u8 && dir[dir.len() - 1] != 47u8 {
            dir = dir + "\\"
        }
        if has_ext {
            out.push(dir + program)
        }
        for e in exts {
            out.push(dir + program + e)
        }
    }
    return out
}

// The non-empty entries of the `;`-separated list `s`, without quotes.
#test("a;;\"b c\";")[["a", "b c"]]
#test("")[[]]
fun list_entries(s: str) -> [str] {
    var out: [str] = []
    var sb = StringBuilder()
    var i = 0
    while i <= s.len() {
        if i == s.len() || s[i] == 59u8 {   // ';'
            let e = sb.build()
            if e != "" {
                out.push(e)
            }
            sb = StringBuilder()
        } else if s[i] != 34u8 {
            sb.append_byte(s[i])
        }
        i += 1
    }
    return out
}

// Whether `path` names a batch file, which cmd runs.
fun is_batch(path: str) -> bool {
    return ends_with_ci(path, ".bat") || ends_with_ci(path, ".cmd")
}

// The attributes of the file at `path` (`GetFileAttributesW`), or minus the
// cause.
fun attributes_of(path: str) -> int64 {
    let w = spawn_wide(path)
    let a = __syscall(__rt_get("__imp_GetFileAttributesW"), w, 0, 0) & LOW32
    var r = a
    if a == LOW32 {
        r = failed()
    }
    __free(w)
    return r
}

// cmd's path: `cmd.exe` in the system's directory.
fun cmd_path() -> str {
    let buf = __alloc(1040)
    let n = __syscall(__rt_get("__imp_GetSystemDirectoryW"), buf, 520, 0) & LOW32
    var dir = "C:\\Windows\\System32"
    if n > 0 && n < 520 {
        dir = utf8_of(units_at(buf, n), 0, n as int)
    }
    __free(buf)
    return dir + "\\cmd.exe"
}

// --- the environment

// The entries of this process's environment (`name=value`, UTF-8, as
// `windows_start` made them).
fun this_environment() -> [str] {
    var out: [str] = []
    var entry = __environ()
    while __load64(entry) != 0 {
        let e = __load64(entry)
        var len: int64 = 0
        while __load8(e + len) != 0u8 {
            len += 1
        }
        let p = __alloc(len + 8)
        __store64(p, len)
        __copy_bytes(p + 8, e, len)
        out.push(__str_of(p))
        entry += 8
    }
    return out
}

// How long the name of the entry (or bare name) `e` is: up to its `=`.
fun name_len(e: str) -> int {
    var n = 0
    while n < e.len() && e[n] != 61u8 {   // '='
        n += 1
    }
    return n
}

// Whether the entries (or names) `a` and `b` have the same name, its case
// ignored as Windows ignores it.
#test("Path=x", "PATH")[true]
#test("PATHEXT=x", "PATH")[false]
fun same_name(a: str, b: str) -> bool {
    let n = name_len(a)
    if name_len(b) != n {
        return false
    }
    var i = 0
    while i < n {
        if upper(a[i]) != upper(b[i]) {
            return false
        }
        i += 1
    }
    return true
}

// Whether the name of `a` sorts before the name of `b`, the case ignored
// (the order CreateProcess wants an environment block in).
fun name_before(a: str, b: str) -> bool {
    let n = name_len(a)
    let m = name_len(b)
    var i = 0
    while i < n && i < m {
        let x = upper(a[i])
        let y = upper(b[i])
        if x != y {
            return x < y
        }
        i += 1
    }
    return n < m
}

// The value of this process's variable `name` ("" without one).
fun env_value(name: str) -> str {
    for e in this_environment() {
        if same_name(e, name) && name_len(e) < e.len() {
            // (no slice: std.platform loads no std.slice)
            var sb = StringBuilder()
            sb.append(e, name_len(e) + 1, e.len())
            return sb.build()
        }
    }
    return ""
}

// The environment `opts` gives a child (`std.rt.run_with`'s `opts[3]` on:
// "keep" this process's with the changes after it, "clear" only what they
// set; a change `NAME=value` sets NAME in place of the variable of that
// name in any case, a bare `NAME` removes it), sorted by name.
#test(["A=1", "b=2"], ["", "", "", "keep", "B=3", "C=4", "a"])[["B=3", "C=4"]]
#test(["A=1"], ["", "", "", "clear", "Z=1", "Y=2"])[["Y=2", "Z=1"]]
fun child_environment(base: [str], opts: [str]) -> [str] {
    var entries: [str] = []
    if opts[3] != "clear" {
        entries = base
    }
    var i = 4
    while i < opts.len() {
        let change = opts[i]
        var kept: [str] = []
        for e in entries {
            if !same_name(e, change) {
                kept.push(e)
            }
        }
        if name_len(change) < change.len() {
            kept.push(change)
        }
        entries = kept
        i += 1
    }
    // sorted, by insertion: an environment is short
    var k = 1
    while k < entries.len() {
        let e = entries[k]
        var j = k - 1
        while j >= 0 && name_before(e, entries[j]) {
            entries[j + 1] = entries[j]
            j -= 1
        }
        entries[j + 1] = e
        k += 1
    }
    return entries
}

// The environment block of `entries` (UTF-16, each ending with a NUL,
// then a NUL), in memory of its own.
fun environment_block(entries: [str]) -> int64 {
    var units: [int] = []
    for e in entries {
        for u in units_of(e) {
            units.push(u)
        }
        units.push(0)
    }
    if entries.len() == 0 {
        units.push(0)
    }
    units.push(0)
    return units_mem(units)
}

// --- the standard streams

// What a child's three standard streams are, from `stdio_mode`'s letters:
// its handles (0: none), this process's end of each that is a pipe (-1:
// none), a descriptor handed over (`d`, closed once the child has it; -1:
// none), and the cause when one couldn't be made (0: none).
struct Streams {
    child: [int64],
    ours: [int64],
    given: int64,
    cause: int64,
}

// How a child's standard streams are made, from `opts` (`std.rt.run_with`'s
// and `spawn_piped`'s): three letters, for stdin, stdout and stderr, each
// `p` (a pipe this process holds the other end of), `i` (this process's),
// `n` (nothing: NUL), and for stdin also `t` (the text `opts[2]`) or `d`
// (the descriptor `opts[2]` names, MYLA-378). `opts[1]` gives them; else
// "1" there is a text input, and the input is a pipe when `piped` and this
// process's otherwise, the output and the error pipes (as on Linux).
#test(["", "1", "x"], false)["tpp"]
#test(["", "", ""], false)["ipp"]
#test([], true)["ppp"]
#test(["", "din", "5"], true)["din"]
fun stdio_mode(opts: [str], piped: bool) -> str {
    if opts.len() > 1 && opts[1].len() == 3 {
        return opts[1]
    }
    if opts.len() > 2 && opts[1] == "1" {
        return "tpp"
    }
    if piped {
        return "ppp"
    }
    return "ipp"
}

// The descriptor the decimal `s` names (-1 for none).
#test("17")[17]
#test("")[-1]
#test("x")[-1]
fun descriptor_of(s: str) -> int64 {
    if s.len() == 0 || s.len() > 18 {
        return -1
    }
    var n: int64 = 0
    var i = 0
    while i < s.len() {
        let c = s[i]
        if c < 48u8 || c > 57u8 {
            return -1
        }
        n = n * 10 + (c - 48u8) as int64
        i += 1
    }
    return n
}

// The handle `h` made one a child inherits (`SetHandleInformation`'s
// HANDLE_FLAG_INHERIT): 0, or minus the cause.
fun inheritable(h: int64) -> int64 {
    if !ok(__syscall(__rt_get("__imp_SetHandleInformation"), h, 1, 1)) {
        return failed()
    }
    return 0
}

// A copy of the handle `h` a child inherits (`DuplicateHandle`, the same
// access), or minus the cause.
fun inheritable_copy(h: int64) -> int64 {
    let out = __alloc(8)
    __store64(out, 0)
    let r = win_call(__rt_get("__imp_DuplicateHandle"), [-1, h, -1, out, 0, 1, 2])   // this process, DUPLICATE_SAME_ACCESS
    var c = __load64(out)
    if !ok(r) {
        c = failed()
    }
    __free(out)
    return c
}

// The NUL device open for reading and writing, inheritable: its handle, or
// minus the cause.
fun null_device() -> int64 {
    let w = spawn_wide("NUL")
    // GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, OPEN_EXISTING
    let h = win_call(__rt_get("__imp_CreateFileW"), [w, 3221225472i64, 3, 0, 3, 0, 0])
    __free(w)
    if h == -1 {
        return failed()
    }
    let r = inheritable(h)
    if r < 0 {
        let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
        return r
    }
    return h
}

// A file holding `text`, read from its start, which the child inherits and
// which goes when the last handle of it is closed (a temporary file deleted
// on close: what Linux's `memfd_create` gives, so that a large input can't
// stop the child against its output, D147): its handle, or minus the cause.
fun input_file(text: str) -> int64 {
    let buf = __alloc(1040)
    let n = __syscall(__rt_get("__imp_GetTempPathW"), 520, buf, 0) & LOW32
    if n == 0 || n >= 520 {
        __free(buf)
        return failed()
    }
    let dir = utf8_of(units_at(buf, n), 0, n as int)
    __free(buf)
    let pid = __syscall(__rt_get("__imp_GetCurrentProcessId"), 0, 0, 0) & LOW32
    var tries: int64 = 0
    while true {
        let w = spawn_wide(dir + "myla-input-" + decimal(pid) + "-" + decimal(clock_ns() & 4294967295i64) + "-" + decimal(tries) + ".tmp")
        // GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | _WRITE | _DELETE,
        // CREATE_NEW, FILE_FLAG_DELETE_ON_CLOSE | FILE_ATTRIBUTE_TEMPORARY
        let h = win_call(__rt_get("__imp_CreateFileW"), [w, 3221225472i64, 7, 0, 1, 67109120, 0])
        __free(w)
        if h != -1 {
            var r = write_all(h, __addr_of(text) + 8, text.len() as int64)
            if r == 0 && !ok(__syscall5(__rt_get("__imp_SetFilePointerEx"), h, 0, 0, 0, 0)) {
                r = failed()
            }
            if r == 0 {
                r = inheritable(h)
            }
            if r < 0 {
                let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
                return r
            }
            return h
        }
        let e = last_error()
        tries += 1
        if (e != 80 && e != 183) || tries > 100 {   // FILE_EXISTS, ALREADY_EXISTS: another name
            return -cause(e)
        }
    }
    return -OTHER
}

// A pipe for a child's standard stream (MYLA-706): a named pipe of this
// process's (`\\.\pipe\myla-<pid>-<n>`, one instance, no remote
// client), whose end here is overlapped (a watched handle, on the port in
// a program with tasks, so the poller hears when it holds bytes or has room
// again, MYLA-726) and the child's plain, as a program expects its
// standard streams, and inheritable. `to_child`: the child reads it (its
// input), else writes it. Our end at `out`, the child's after it: 0, or
// minus the cause.
fun pipe_pair(to_child: bool, out: int64) -> int64 {
    let pid = __syscall(__rt_get("__imp_GetCurrentProcessId"), 0, 0, 0) & LOW32
    let k = __fetch_add64(net() + NET_PIPES, 1)
    let name = spawn_wide("\\\\.\\pipe\\myla-" + decimal(pid) + "-" + decimal(k))
    // PIPE_ACCESS_OUTBOUND or _INBOUND, FILE_FLAG_OVERLAPPED,
    // FILE_FLAG_FIRST_PIPE_INSTANCE; PIPE_TYPE_BYTE | PIPE_WAIT |
    // PIPE_REJECT_REMOTE_CLIENTS; one instance, 64 KiB each way
    var access: int64 = 1074266113
    var child_access = GENERIC_WRITE
    var kind = K_PIPE_IN
    if to_child {
        access = 1074266114
        child_access = GENERIC_READ
        kind = K_PIPE_OUT
    }
    let ours = win_call(__rt_get("__imp_CreateNamedPipeW"), [name, access, 8, 1, 65536, 65536, 0, 0])
    if ours == -1 {
        __free(name)
        return failed()
    }
    let theirs = win_call(__rt_get("__imp_CreateFileW"), [name, child_access, 0, 0, OPEN_EXISTING, 0, 0])
    var e: int64 = 0
    if theirs == -1 {
        e = failed()
    }
    __free(name)
    if e == 0 {
        e = inheritable(theirs)
    }
    if e == 0 && ws_new(ours, kind, with_tasks()) == 0 {
        e = -(OTHER + 24)
    }
    if e < 0 {
        let c = close(ours)
        if theirs != -1 {
            let d = __syscall(__rt_get("__imp_CloseHandle"), theirs, 0, 0)
        }
        return e
    }
    __store64(out, ours)
    __store64(out + 8, theirs)
    return 0
}

// The child's three streams as `how` (three letters of `stdio_mode`) and
// `opts` say.
fun child_streams(how: str, opts: [str]) -> Streams {
    var s = Streams { child: [0, 0, 0], ours: [-1, -1, -1], given: -1, cause: 0 }
    var null_h: int64 = 0
    let pipe = __alloc(16)
    var k = 0
    while k < 3 && s.cause == 0 {
        let c = how[k]
        var h: int64 = 0
        if c == 'p' {
            // ours overlapped, the child's plain and made inheritable
            let r = pipe_pair(k == 0, pipe)
            if r < 0 {
                s.cause = -r
            } else {
                s.ours[k] = __load64(pipe)
                h = __load64(pipe + 8)
            }
        } else if c == 'n' || (c == 't' && (opts.len() < 3 || opts[2] == "")) {
            if null_h == 0 {
                null_h = null_device()
                if null_h < 0 {
                    s.cause = -null_h
                    null_h = 0
                }
            }
            h = null_h
        } else if c == 't' {
            h = input_file(opts[2])
            if h < 0 {
                s.cause = -h
                h = 0
            }
        } else if c == 'd' {
            // the descriptor handed over: one that isn't open is BAD_HANDLE
            // here, as on Linux
            let fd = descriptor_of(opts[2])
            var given: int64 = 0
            if fd >= 0 {
                given = std_handle(fd)
            }
            let flags = __alloc(8)
            if given == 0 || !ok(__syscall(__rt_get("__imp_GetHandleInformation"), given, flags, 0)) {
                s.cause = BAD_HANDLE
            } else {
                h = inheritable_copy(given)
                s.given = fd
                if h < 0 {
                    s.cause = -h
                    h = 0
                }
            }
            __free(flags)
        } else {
            // this process's: a copy the child inherits (none without one)
            let mine = std_handle(k as int64)
            if mine != 0 {
                h = inheritable_copy(mine)
                if h < 0 {
                    h = 0
                }
            }
        }
        s.child[k] = h
        k += 1
    }
    __free(pipe)
    return s
}

// The child's handles, each once (two streams may share the NUL device).
fun distinct_handles(child: [int64]) -> [int64] {
    var out: [int64] = []
    for h in child {
        var seen = h == 0
        for o in out {
            if o == h {
                seen = true
            }
        }
        if !seen {
            out.push(h)
        }
    }
    return out
}

// The child's handles closed here, and this process's ends too when
// `all` (nothing was started), the descriptor handed over in any case.
fun close_streams(s: Streams, all: bool) {
    for h in distinct_handles(s.child) {
        let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
    }
    if all {
        for h in s.ours {
            if h >= 0 {
                let c = close(h)
            }
        }
    }
    if s.given >= 0 {
        let c = close(s.given)
    }
}

// --- starting it

// A child started as `spawn_piped` describes, its streams as `how` (three
// letters of `stdio_mode`) says: `[cause, pid, in, out, err, process]`.
fun start_child(paths: [str], argv: [str], opts: [str], how: str) -> [int] {
    if argv.len() > 0 && has_byte(argv[0], 34u8) {
        // no quote in a program's name on its command line
        return [INVALID_INPUT as int, 0, -1, -1, -1, -1]
    }
    var dir: int64 = 0
    if opts.len() > 0 && opts[0] != "" {
        let a = attributes_of(opts[0])
        if a < 0 {
            return [(DIR_FAILED - a) as int, 0, -1, -1, -1, -1]
        }
        if (a & 16) == 0 {      // FILE_ATTRIBUTE_DIRECTORY
            return [(DIR_FAILED + NOT_A_DIRECTORY) as int, 0, -1, -1, -1, -1]
        }
        dir = spawn_wide(opts[0])
    }
    var env: int64 = 0
    if opts.len() > 3 && opts[3] != "" {
        env = environment_block(child_environment(this_environment(), opts))
    }
    let s = child_streams(how, opts)
    var failure = s.cause
    var pid: int64 = 0
    var process: int64 = -1
    if failure == 0 {
        let pi = __alloc(24)
        failure = create_child(paths, argv, s, env, dir, pi)
        if failure == 0 {
            process = __load64(pi)
            pid = __load64(pi + 16) & LOW32
            let t = __syscall(__rt_get("__imp_CloseHandle"), __load64(pi + 8), 0, 0)
        }
        __free(pi)
    }
    close_streams(s, failure != 0)
    if dir != 0 {
        __free(dir)
    }
    if env != 0 {
        __free(env)
    }
    if failure != 0 {
        return [failure as int, 0, -1, -1, -1, -1]
    }
    return [0, pid as int, s.ours[0] as int, s.ours[1] as int, s.ours[2] as int, process as int]
}

// The child created (`CreateProcessW`, into `pi`) from the first of the
// candidates of `paths` that starts: 0, or the cause. A candidate not
// there (or no program: ERROR_BAD_EXE_FORMAT) gives way to the next; one
// that may not be run is remembered, as `execvp` remembers EACCES, and a
// file that isn't a program is "exec format error" if none starts.
fun create_child(paths: [str], argv: [str], s: Streams, env: int64, dir: int64, pi: int64) -> int64 {
    let handles = distinct_handles(s.child)
    // the startup information (STARTUPINFOEXW), its handles the only ones
    // the child inherits when the attribute list can be made
    let si = __alloc(112)
    zero_bytes(si, 112)
    __store64(si + 60, USE_STD_HANDLES)         // dwFlags (and wShowWindow 0)
    __store64(si + 80, s.child[0])
    __store64(si + 88, s.child[1])
    __store64(si + 96, s.child[2])
    var flags = UNICODE_ENVIRONMENT
    var list: int64 = 0
    var array: int64 = 0
    let n = handles.len() as int64
    __store32(si, 104u32)                       // cb: STARTUPINFOW alone
    if n > 0 {
        let size = __alloc(8)
        __store64(size, 0)
        let first = __syscall5(__rt_get("__imp_InitializeProcThreadAttributeList"), 0, 1, 0, size, 0)
        list = __alloc(__load64(size) + 8)
        array = __alloc(8 * n)
        var k: int64 = 0
        for h in handles {
            __store64(array + 8 * k, h)
            k += 1
        }
        var made = ok(__syscall5(__rt_get("__imp_InitializeProcThreadAttributeList"), list, 1, 0, size, 0))
        if made {
            made = ok(win_call(__rt_get("__imp_UpdateProcThreadAttribute"), [list, 0, HANDLE_LIST, array, 8 * n, 0, 0]))
            if !made {
                let gone = __syscall(__rt_get("__imp_DeleteProcThreadAttributeList"), list, 0, 0)
            }
        }
        if made {
            __store32(si, 112u32)
            __store64(si + 104, list)
            flags = flags | EXTENDED_STARTUP
        } else {
            // (inheriting every inheritable handle: only the child's are,
            // while it starts)
            __free(list)
            list = 0
        }
        __free(size)
    }
    var inherit: int64 = 0
    if n > 0 {
        inherit = 1
    }
    let line = command_line(argv)
    var rest: [str] = []
    var i = 1
    while i < argv.len() {
        rest.push(argv[i])
        i += 1
    }
    var failure = NOT_FOUND           // no candidate to try
    var denied = false
    var not_a_program = false
    let path = env_value("PATH")
    let pathext = env_value("PATHEXT")
    var found = false
    for p in paths {
        for cand in program_candidates(p, path, pathext) {
            if found || (failure != NOT_FOUND && failure != 0) {
                break
            }
            var app = cand
            var cl = line
            var tried = true
            if is_batch(cand) {
                // cmd runs any name: only one that is a file is tried
                let a = attributes_of(cand)
                if a < 0 || (a & 16) != 0 {
                    tried = false
                } else {
                    cl = bat_command_line(cand, rest)
                    if cl == "" {
                        failure = INVALID_INPUT
                        tried = false
                    }
                    app = cmd_path()
                }
            }
            if tried {
                let wa = spawn_wide(app)
                let wl = spawn_wide(cl)
                let r = win_call(__rt_get("__imp_CreateProcessW"), [wa, wl, 0, 0, inherit, flags, env, dir, si, pi])
                let e = last_error()
                __free(wa)
                __free(wl)
                if ok(r) {
                    found = true
                    failure = 0
                } else if e == 5 {
                    denied = true            // ACCESS_DENIED: kept unless one runs
                } else if e == 193 || e == 216 {
                    not_a_program = true     // BAD_EXE_FORMAT, EXE_MACHINE_TYPE_MISMATCH
                } else if e != 2 && e != 3 && e != 123 && e != 267 {
                    failure = cause(e)       // not FILE_, PATH_NOT_FOUND, INVALID_NAME, DIRECTORY
                }
            }
        }
    }
    if !found && failure == NOT_FOUND {
        if denied {
            failure = PERMISSION_DENIED
        } else if not_a_program {
            failure = OTHER + 8              // ENOEXEC's "exec format error"
        }
    }
    if list != 0 {
        let gone = __syscall(__rt_get("__imp_DeleteProcThreadAttributeList"), list, 0, 0)
        __free(list)
    }
    if array != 0 {
        __free(array)
    }
    __free(si)
    return failure
}

// The `n` bytes at `p` zeroed.
fun zero_bytes(p: int64, n: int64) {
    var i: int64 = 0
    while i < n {
        __store8(p + i, 0u8)
        i += 1
    }
}

// --- what the platform interface asks for

// `program` (not searched for) run with the argument vector `argv` and the
// environment the process started with, its stdout and stderr read as they
// come, and waited for. Gives what it wrote to stdout; `__set_run_stderr`
// and `__set_run_status` (its exit code's 32 bits, or the cause of a failed
// spawn) record the rest.
pub fun run(program: str, argv: [str]) -> [uint8] {
    return run_with([program], argv, [])
}

// `run` with the paths to try, in turn (each looked for on PATH, with
// PATHEXT's extensions), and the options of `std.rt.run_with` (D147). The
// two pipes are read as either has bytes (`PeekNamedPipe`, a millisecond's
// nap while neither has: anonymous pipes can't be waited for, MYLA-706's
// overlapped reads will), the last one left with plain reads.
pub fun run_with(paths: [str], argv: [str], opts: [str]) -> [uint8] {
    var out: [uint8] = []
    var err: [uint8] = []
    let h = start_child(paths, argv, opts, stdio_mode(opts, false))
    if h[0] != 0 {
        __set_run_status(0, 0, h[0] as int64)
        __set_run_stderr(err)
        return out
    }
    if h[2] >= 0 {
        // (an input pipe nobody writes: its end at once)
        let c = close(h[2] as int64)
    }
    var o = h[3] as int64
    var e = h[4] as int64
    let buf = __alloc(65536)
    while o >= 0 || e >= 0 {
        var src: int64 = -1
        if o >= 0 && e >= 0 {
            if pipe_ready(o) {
                src = o
            } else if pipe_ready(e) {
                src = e
            } else {
                let s = __syscall(__rt_get("__imp_Sleep"), 1, 0, 0)
                continue
            }
        } else if o >= 0 {
            src = o
        } else {
            src = e
        }
        let got = read(src, buf, 65536)
        if got <= 0 {
            let c = close(src)
            if src == o {
                o = -1
            } else {
                e = -1
            }
        } else {
            var i: int64 = 0
            while i < got {
                if src == o {
                    out.push(__load8(buf + i))
                } else {
                    err.push(__load8(buf + i))
                }
                i += 1
            }
        }
    }
    __free(buf)
    let process = h[5] as int64
    let w = __syscall(__rt_get("__imp_WaitForSingleObject"), process, WAIT_INFINITE, 0)
    let code = exit_code_of(process)
    let c = __syscall(__rt_get("__imp_CloseHandle"), process, 0, 0)
    __set_run_status(code, 0, 0)
    __set_run_stderr(err)
    return out
}

// Whether a read of the pipe `h` won't wait: it holds bytes, or its writer
// closed it (or it fails).
fun pipe_ready(h: int64) -> bool {
    let avail = __alloc(8)
    __store64(avail, 0)
    let r = __syscall5(__rt_get("__imp_PeekNamedPipe"), h, 0, 0, 0, avail)
    let ready = !ok(r) || (__load64(avail) & LOW32) != 0
    __free(avail)
    return ready
}

// The exit code of the process `h` that ended (`GetExitCodeProcess`), its
// 32 bits (D216).
fun exit_code_of(h: int64) -> int64 {
    let w = __alloc(8)
    __store64(w, 0)
    let r = __syscall(__rt_get("__imp_GetExitCodeProcess"), h, w, 0)
    let code = __load64(w) & LOW32
    __free(w)
    return code
}

// `program` started with the argument vector `argv` (as `run` starts it)
// and not waited for (D124, `std.process.run_async`): `[cause, pid, out,
// err, exited]`, `out` and `err` the read ends of its stdout's and
// stderr's pipes and `exited` its process's handle (ready once it ended),
// or `[cause, 0, -1, -1, -1]` when it couldn't be started.
pub fun spawn(program: str, argv: [str]) -> [int] {
    return spawn_with([program], argv, [])
}

// `spawn` with the paths to try, in turn, and the options of
// `std.rt.run_with` (D147).
pub fun spawn_with(paths: [str], argv: [str], opts: [str]) -> [int] {
    let h = start_child(paths, argv, opts, stdio_mode(opts, false))
    return [h[0], h[1], h[3], h[4], h[5]]
}

// `spawn_with` with each standard stream as `opts[1]` says (`stdio_mode`:
// a pipe, this process's, nothing, a text, a descriptor; all three pipes
// unless it says otherwise, MYLA-336, MYLA-378): `[cause, pid, in, out,
// err, exited]`, `in` the write end of its stdin's pipe and `out` and `err`
// the read ends of its stdout's and stderr's (-1 for a stream that isn't a
// pipe), or `[cause, 0, -1, -1, -1, -1]`.
pub fun spawn_piped(paths: [str], argv: [str], opts: [str]) -> [int] {
    return start_child(paths, argv, opts, stdio_mode(opts, true))
}

// The child `pid` opened again by its ID (its handle `exited` still open
// keeps the ID its own), or 0.
fun open_child(pid: int64) -> int64 {
    if pid <= 0 {
        return 0
    }
    return __syscall(__rt_get("__imp_OpenProcess"), CHILD_RIGHTS, 0, pid)
}

// The child `pid` (from `spawn`) waited for: its exit code's 32 bits (no
// signal ends a process on Windows), 0 when it can't be found.
pub fun reap(pid: int64) -> int64 {
    let h = open_child(pid)
    if h == 0 {
        return 0
    }
    let w = __syscall(__rt_get("__imp_WaitForSingleObject"), h, WAIT_INFINITE, 0)
    let code = exit_code_of(h)
    let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
    return code
}

// The child `pid`'s status if it has ended, not waited for (MYLA-336): 0
// while it runs, 1 when it ended, with what `reap` would give as the word
// at `out`, or minus the cause (ECHILD's `Other` when there is no such
// process).
pub fun try_reap(pid: int64, out: int64) -> int64 {
    let h = open_child(pid)
    if h == 0 {
        return -(OTHER + 10)
    }
    var r: int64 = 1
    if (__syscall(__rt_get("__imp_WaitForSingleObject"), h, 0, 0) & LOW32) == WAITED_OUT {
        r = 0
    } else {
        __store64(out, exit_code_of(h))
    }
    let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
    return r
}

// The process `pid` ended (`TerminateProcess`, with the exit code 1, as
// Rust's and Python's `kill` end one: Windows has no signal to send, and
// any `sig` but 0 ends it); `sig` 0 only asks whether it is there. 0 (one
// that ended already too), or minus the cause (ESRCH's `Other`: no such
// process).
pub fun kill(pid: int64, sig: int64) -> int64 {
    let h = open_child(pid)
    if h == 0 {
        return -(OTHER + 3)
    }
    var r: int64 = 0
    if sig != 0 && (__syscall(__rt_get("__imp_WaitForSingleObject"), h, 0, 0) & LOW32) == WAITED_OUT {
        if !ok(__syscall(__rt_get("__imp_TerminateProcess"), h, 1, 0)) {
            r = failed()
        }
    }
    let c = __syscall(__rt_get("__imp_CloseHandle"), h, 0, 0)
    return r
}

// --- sockets and the I/O completion port (MYLA-706: ws2_32, D212) ----------------------
// What std.net needs, over Winsock 2 (`WSAStartup` before the first socket,
// `sock_open`). A socket is a SOCKET, which std.rt's handle table holds
// (D181), as an address record crosses this layer (`sockaddr_of`,
// `record_into`: Windows' AF_INET6 is 23). The functions are Linux's:
// sockets start blocking, std.net makes them non-blocking, and an operation
// that would wait fails with WOULD_BLOCK (IN_PROGRESS for a connect), which
// Winsock's own non-blocking calls give as WSAEWOULDBLOCK; its codes are
// std.ioerror's causes (`wsa_cause`).
//
// The poller (below) waits on one I/O completion port of the process's
// (`net_port`), which is a completion queue, not a readiness one: a packet
// comes when an overlapped operation ends, or when someone posts one. What
// std.rt waits for is readiness (D124), so each handle the port serves has
// a state of the platform's (a "watched handle", `ws_*`) with an operation
// in flight that ends when the handle may have become ready, and the packet
// only says "look at it again": the poller then looks (`ws_level`: WSAPoll,
// PeekNamedPipe, the operations' own status) and gives the event, or
// starts the operation again. The operations, for each handle that can be
// waited for:
// - a stream socket to receive from, a datagram socket, our end of a
//   child's output pipe: a read of no bytes (`WSARecv`, `WSARecvFrom` with
//   MSG_PEEK, `ReadFile`), which ends when bytes are there (or the end, or
//   an error) and takes none of them;
// - a listener: `AcceptEx` on a socket of its own, whose connection the next
//   `sock_accept` takes before any `accept` would;
// - a connect: `ConnectEx` (a non-blocking socket on the port is connected
//   so), which ends with the connection made or refused;
// - a send that would block, and every write of a child's input pipe: the
//   bytes (a copy) sent or written overlapped, which ends once they are
//   gone; meanwhile the next one is WOULD_BLOCK (`poll_write` 0), so a task
//   waits for room as on Linux (MYLA-726);
// - a child's end (its process handle): a wait of the thread pool's
//   (`RegisterWaitForSingleObject`), whose callback, the runtime's
//   `__win_wait_posted`, posts the packet.
// Level-triggered once, as std.rt asks: a handle armed again while still
// ready is looked at and ready at once. Only a program with tasks puts its
// handles on the port (a program without them has no poller): there
// everything is Winsock's plain non-blocking calls and `WSAPoll`.
//
// A watched handle is the table's (`ws_find`, by the handle's value) until
// it is closed, and freed once no packet is due for it (`refs`): a packet
// names it by the OVERLAPPED it holds, never by the handle, so one that
// comes after a close (an operation cancelled) finds it closed and is
// dropped, whatever handle took its number. A send or a write still going
// when its handle is closed would be cancelled with it, its bytes lost
// (Linux sends what a closed socket's buffer holds): such a close waits, on
// a thread of the pool's, for that operation's end (`ws_close_later`).
// The net state, `__win_net` (selfhost/codegen.my), and each watched
// handle's are under one spin lock, held for loads and stores and for
// calls that only start an operation, never for one that waits.

// `__win_net`: the lock, the port, the table (its words, its room, its
// slots used), Winsock started, AcceptEx's and ConnectEx's addresses, the
// count naming the pipes, a wake-up posted, the handles closed later, how
// many armed handles are looked at each millisecond, Winsock's functions
// the poller calls (`ws2`)
const NET_PORT: int64 = 8
const NET_TABLE: int64 = 16
const NET_CAP: int64 = 24
const NET_USED: int64 = 32
const NET_WINSOCK: int64 = 40
const NET_ACCEPTEX: int64 = 48
const NET_CONNECTEX: int64 = 56
const NET_PIPES: int64 = 64
const NET_WAKE: int64 = 72
const NET_LATER: int64 = 80
const NET_PEEKS: int64 = 88
const NET_WS2: int64 = 96

// a watched handle: its handle, kind, flags, the events armed (1 to read,
// 2 to write) and their token, the packets due, its event (the operations
// of reading, accepting and connecting signal it), the events an operation
// that failed to start makes ready, the connection AcceptEx gave and the
// socket it takes the next one on, the bytes of a send or a write (and
// their room), the pool's wait, the last wait that looked at it, the
// event of its send or write, the next closed later; then its operations,
// each an OVERLAPPED and the watched handle's address: the read of no
// bytes, the send or write, AcceptEx's or ConnectEx's (a process's wait's
// packet), the posted packet; the context of `__win_wait_posted`, a WSABUF,
// AcceptEx's addresses
const WS_HANDLE: int64 = 0
const WS_KIND: int64 = 8
const WS_FLAGS: int64 = 16
const WS_WANT: int64 = 24
const WS_TOKEN: int64 = 32
const WS_REFS: int64 = 40
const WS_EVENT: int64 = 48
const WS_FORCED: int64 = 56
const WS_ACCEPTED: int64 = 64
const WS_ACCEPTING: int64 = 72
const WS_BUF: int64 = 80
const WS_BUF_CAP: int64 = 88
const WS_WAIT: int64 = 96
const WS_MARK: int64 = 104
const WS_SEND_EVENT: int64 = 112
const WS_NEXT: int64 = 120
const WS_PROBE: int64 = 128
const WS_SEND: int64 = 168
const WS_ACCEPT: int64 = 208
const WS_NUDGE: int64 = 248
const WS_POST: int64 = 288
const WS_WSABUF: int64 = 328
const WS_ADDRS: int64 = 344
const WS_SIZE: int64 = 440

// its kinds: a stream socket, a datagram socket, our end of a pipe we
// read or write (overlapped), a process, a pipe not ours (an inherited
// standard input: looked at each millisecond, as it can't be waited for)
const K_STREAM: int64 = 1
const K_DGRAM: int64 = 2
const K_PIPE_IN: int64 = 3
const K_PIPE_OUT: int64 = 4
const K_PROCESS: int64 = 5
const K_PIPE: int64 = 6

// its flags: closed (in no table); on the port; non-blocking; bound;
// listening; the connect's context set; the read of no bytes, the send or
// write, AcceptEx, ConnectEx started (going on while its status is
// STATUS_PENDING); the process waited for; a packet posted; closed later
const F_CLOSED: int64 = 1
const F_ASSOC: int64 = 2
const F_NONBLOCK: int64 = 4
const F_BOUND: int64 = 8
const F_LISTENING: int64 = 16
const F_UPDATED: int64 = 32
const F_PROBING: int64 = 64
const F_SENDING: int64 = 128
const F_ACCEPTING: int64 = 256
const F_CONNECTING: int64 = 512
const F_WAITING: int64 = 1024
const F_NUDGED: int64 = 2048
const F_LATER: int64 = 4096

// an OVERLAPPED's status while its operation goes on
const STATUS_PENDING: int64 = 259
const WSA_IO_PENDING: int64 = 997
const WSAEWOULDBLOCK: int64 = 10035
const WSAEMSGSIZE: int64 = 10040
// the most bytes a send or a write takes when it would wait (a copy)
const SEND_ROOM: int64 = 262144
// WSAPoll's events: to read, to write, an error, a hang-up
const POLLRDNORM: int64 = 256
const POLLWRNORM: int64 = 16
const POLL_ERRORS: int64 = 7
// RegisterWaitForSingleObject's WT_EXECUTEONLYONCE, UnregisterWaitEx's
// "until the callback has returned"
const WT_ONCE: int64 = 8
const UNTIL_DONE: int64 = -1

// Winsock's functions that the poller and the functions every socket
// reaches call (`ws2`): WSAPoll, WSARecv, WSARecvFrom, WSAGetLastError,
// getsockname, WSASocketW, closesocket, WSAIoctl. `winsock` keeps their
// addresses, so the poller names no function of ws2_32's, and a program
// that opens no socket doesn't import it (MYLA-722).
const W_POLL: int64 = 0
const W_RECV: int64 = 1
const W_RECV_FROM: int64 = 2
const W_ERROR: int64 = 3
const W_SOCKNAME: int64 = 4
const W_SOCKET: int64 = 5
const W_CLOSE: int64 = 6
const W_IOCTL: int64 = 7

// The address of Winsock's function `i` (W_POLL, …), 0 before `winsock`.
fun ws2(i: int64) -> int64 {
    let t = __load_acq64(net() + NET_WS2)
    if t == 0 {
        return 0
    }
    return __load64(t + 8 * i)
}

// The net state's words.
fun net() -> int64 {
    return __rt_addr("__win_net")
}

// The net lock taken, spinning while another thread holds it (giving the
// CPU up now and then: under Wine a call it is held across takes a trip to
// Wine's server).
fun net_lock() {
    var spins = 0
    while __xchg64(net(), 1) != 0 {
        spins += 1
        if spins < 64 {
            __pause()
        } else {
            let y = __syscall(__rt_get("__imp_SwitchToThread"), 0, 0, 0)
            spins = 0
        }
    }
}

// The net lock given back.
fun net_unlock() {
    __store_rel64(net(), 0)
}

// Whether the program has tasks, so a poller (a program without them waits
// for a socket in `sock_poll` only, and nothing takes the port's packets).
fun with_tasks() -> bool {
    return __tasks_waiting() >= 0
}

// The process's I/O completion port, made the first time: its handle, or 0.
fun net_port() -> int64 {
    let n = net()
    let p = __load_acq64(n + NET_PORT)
    if p != 0 {
        return p
    }
    net_lock()
    if __load64(n + NET_PORT) == 0 {
        let made = __syscall5(__rt_get("__imp_CreateIoCompletionPort"), -1, 0, 0, 0, 0)
        __store_rel64(n + NET_PORT, made)
    }
    net_unlock()
    return __load64(n + NET_PORT)
}

// Winsock started (`WSAStartup`, version 2.2), once: 0, or minus the cause.
fun winsock() -> int64 {
    let n = net()
    if __load_acq64(n + NET_WINSOCK) == 1 {
        return 0
    }
    net_lock()
    var r: int64 = 0
    if __load64(n + NET_WINSOCK) == 0 {
        let data = __alloc(512)   // WSADATA
        let e = __syscall(__rt_get("__imp_WSAStartup"), 514, data, 0) & LOW32
        __free(data)
        if e != 0 {
            r = -wsa_cause(e)
        } else {
            let t = __alloc(64)
            __store64(t + 8 * W_POLL, __rt_get("__imp_WSAPoll"))
            __store64(t + 8 * W_RECV, __rt_get("__imp_WSARecv"))
            __store64(t + 8 * W_RECV_FROM, __rt_get("__imp_WSARecvFrom"))
            __store64(t + 8 * W_ERROR, __rt_get("__imp_WSAGetLastError"))
            __store64(t + 8 * W_SOCKNAME, __rt_get("__imp_getsockname"))
            __store64(t + 8 * W_SOCKET, __rt_get("__imp_WSASocketW"))
            __store64(t + 8 * W_CLOSE, __rt_get("__imp_closesocket"))
            __store64(t + 8 * W_IOCTL, __rt_get("__imp_WSAIoctl"))
            __store_rel64(n + NET_WS2, t)
            __store_rel64(n + NET_WINSOCK, 1)
        }
    }
    net_unlock()
    return r
}

// The calling thread's last Winsock error (0 before Winsock started).
fun wsa_error() -> int64 {
    let f = ws2(W_ERROR)
    if f == 0 {
        return 0
    }
    return __syscall(f, 0, 0, 0) & LOW32
}

// What a failed Winsock call gives: minus the cause of its error.
fun wsa_failed() -> int64 {
    return -wsa_cause(wsa_error())
}

// Whether a Winsock call's int result (its low 32 bits) is SOCKET_ERROR.
fun wsa_bad(r: int64) -> bool {
    return (r & LOW32) == LOW32
}

// The cause of the Winsock error `e` (winsock2.h's WSAE… codes), as
// [[Language/Standard-library/Net#porting-sockets-to-another-system]] says;
// one without a cause OTHER plus Linux's errno of the same meaning; one
// that isn't Winsock's as `cause` maps kernel32's.
#test(10035)[32]
#test(10036)[33]
#test(10061)[12]
#test(10054)[13]
#test(10053)[14]
#test(10057)[15]
#test(10048)[16]
#test(10049)[17]
#test(10060)[18]
#test(10065)[19]
#test(10051)[20]
#test(10047)[9]
#test(10022)[11]
#test(10038)[34]
#test(10004)[7]
#test(10058)[10]
#test(10055)[361]
#test(10040)[346]
#test(995)[8]
fun wsa_cause(e: int64) -> int64 {
    if e == 10035 { return WOULD_BLOCK }                                     // WSAEWOULDBLOCK
    if e == 10036 { return IN_PROGRESS }                                     // WSAEINPROGRESS
    if e == 10061 { return CONNECTION_REFUSED }
    if e == 10054 || e == 10052 { return CONNECTION_RESET }                  // WSAECONNRESET, WSAENETRESET
    if e == 10053 { return CONNECTION_ABORTED }
    if e == 10057 { return NOT_CONNECTED }
    if e == 10048 { return ADDR_IN_USE }
    if e == 10049 { return ADDR_NOT_AVAILABLE }
    if e == 10060 { return TIMED_OUT }
    if e == 10065 { return HOST_UNREACHABLE }
    if e == 10051 { return NETWORK_UNREACHABLE }
    if e == 10047 || e == 10043 || e == 10045 { return UNSUPPORTED }         // WSAEAFNOSUPPORT, WSAEPROTONOSUPPORT, WSAEOPNOTSUPP
    if e == 10022 { return INVALID_INPUT }                                   // WSAEINVAL
    if e == 10038 || e == 10009 || e == 6 { return BAD_HANDLE }              // WSAENOTSOCK, WSAEBADF, an invalid handle
    if e == 10004 { return INTERRUPTED }
    if e == 10013 { return PERMISSION_DENIED }                               // WSAEACCES
    if e == 10058 { return BROKEN_PIPE }                                     // WSAESHUTDOWN: Linux's EPIPE
    if e == 10037 { return OTHER + 114 }                                     // WSAEALREADY: EALREADY
    if e == 10040 { return OTHER + 90 }                                      // WSAEMSGSIZE: EMSGSIZE
    if e == 10050 { return OTHER + 100 }                                     // WSAENETDOWN: ENETDOWN
    if e == 10055 { return OTHER + 105 }                                     // WSAENOBUFS: ENOBUFS
    if e == 10056 { return OTHER + 106 }                                     // WSAEISCONN: EISCONN
    if e == 10064 { return OTHER + 112 }                                     // WSAEHOSTDOWN: EHOSTDOWN
    if e == 10024 { return OTHER + 24 }                                      // WSAEMFILE: EMFILE
    if e == 10014 { return OTHER + 14 }                                      // WSAEFAULT: EFAULT
    return cause(e)
}

// The cause of the NTSTATUS an overlapped operation ended with (its
// OVERLAPPED's `Internal`): 0 for success, and for a read of no bytes that
// found a datagram (STATUS_BUFFER_OVERFLOW) or the end; Linux's EIO's
// `Other` for one not mapped.
#test(0)[0]
#test(2147483653i64)[0]
#test(3221226038i64)[12]
#test(3221225997i64)[13]
#test(3221225803i64)[10]
#test(3221225760i64)[8]
#test(3221225473i64)[261]
fun status_cause(s: int64) -> int64 {
    if s == 0 || s == 2147483653i64 || s == 3221225489i64 { return 0 }       // SUCCESS, BUFFER_OVERFLOW, END_OF_FILE
    if s == 3221226038i64 { return CONNECTION_REFUSED }                      // CONNECTION_REFUSED
    if s == 3221225997i64 || s == 3221225996i64 { return CONNECTION_RESET }   // CONNECTION_RESET, _DISCONNECTED
    if s == 3221226049i64 { return CONNECTION_ABORTED }
    if s == 3221226044i64 { return NETWORK_UNREACHABLE }
    if s == 3221226045i64 { return HOST_UNREACHABLE }
    if s == 3221225653i64 { return TIMED_OUT }                               // IO_TIMEOUT
    if s == 3221225760i64 { return CANCELLED }                               // CANCELLED
    if s == 3221225803i64 || s == 3221225649i64 || s == 3221225648i64 { return BROKEN_PIPE }  // PIPE_BROKEN, _CLOSING, _DISCONNECTED
    if s == 3221225480i64 { return BAD_HANDLE }                              // INVALID_HANDLE
    if s == 3221225506i64 { return PERMISSION_DENIED }                       // ACCESS_DENIED
    if s == 3221225485i64 { return INVALID_INPUT }                           // INVALID_PARAMETER
    return OTHER + 5
}

// --- the watched handles' table

// The watched handle of the handle `h`, or 0 (the lock held). The table
// is open addressing on the handle's value, 1 the mark of a slot freed
// (no handle is 1).
fun ws_find(h: int64) -> int64 {
    let n = net()
    let t = __load64(n + NET_TABLE)
    if t == 0 || h == 0 {
        return 0
    }
    let cap = __load64(n + NET_CAP)
    var i = ws_slot(h, cap)
    while true {
        let k = __load64(t + 16 * i)
        if k == h {
            return __load64(t + 16 * i + 8)
        }
        if k == 0 {
            return 0
        }
        i = (i + 1) & (cap - 1)
    }
    return 0
}

// The first slot of the handle `h` in a table of `cap` slots.
#test(4i64, 64i64)[1]
#test(8i64, 64i64)[2]
fun ws_slot(h: int64, cap: int64) -> int64 {
    return (h >> 2) & (cap - 1)
}

// The watched handle `ws` put in the table under its handle (the lock
// held), the table grown to twice its room once it is half used.
fun ws_put(ws: int64) {
    let n = net()
    var cap = __load64(n + NET_CAP)
    if __load64(n + NET_TABLE) == 0 || 2 * (__load64(n + NET_USED) + 1) > cap {
        let old = __load64(n + NET_TABLE)
        let old_cap = cap
        cap = 64
        while 4 * (ws_count(old, old_cap) + 1) > cap {
            cap = 2 * cap
        }
        let t = __alloc(16 * cap)
        var k: int64 = 0
        while k < 2 * cap {
            __store64(t + 8 * k, 0)
            k += 1
        }
        __store64(n + NET_TABLE, t)
        __store64(n + NET_CAP, cap)
        __store64(n + NET_USED, 0)
        var i: int64 = 0
        while i < old_cap {
            let key = __load64(old + 16 * i)
            if key > 1 {
                ws_insert(key, __load64(old + 16 * i + 8))
            }
            i += 1
        }
        if old != 0 {
            __free(old)
        }
    }
    ws_insert(__load64(ws + WS_HANDLE), ws)
}

// How many handles the table `t` of `cap` slots holds.
fun ws_count(t: int64, cap: int64) -> int64 {
    var c: int64 = 0
    var i: int64 = 0
    while i < cap {
        if __load64(t + 16 * i) > 1 {
            c += 1
        }
        i += 1
    }
    return c
}

// `ws` under the handle `h` in a free slot (the table has room).
fun ws_insert(h: int64, ws: int64) {
    let n = net()
    let t = __load64(n + NET_TABLE)
    let cap = __load64(n + NET_CAP)
    var i = ws_slot(h, cap)
    while __load64(t + 16 * i) > 1 {
        i = (i + 1) & (cap - 1)
    }
    if __load64(t + 16 * i) == 0 {
        __store64(n + NET_USED, __load64(n + NET_USED) + 1)
    }
    __store64(t + 16 * i, h)
    __store64(t + 16 * i + 8, ws)
}

// The handle `h` taken out of the table (the lock held): its watched
// handle, or 0.
fun ws_take(h: int64) -> int64 {
    let n = net()
    let t = __load64(n + NET_TABLE)
    if t == 0 || h == 0 {
        return 0
    }
    let cap = __load64(n + NET_CAP)
    var i = ws_slot(h, cap)
    while true {
        let k = __load64(t + 16 * i)
        if k == h {
            let ws = __load64(t + 16 * i + 8)
            __store64(t + 16 * i, 1)
            __store64(t + 16 * i + 8, 0)
            return ws
        }
        if k == 0 {
            return 0
        }
        i = (i + 1) & (cap - 1)
    }
    return 0
}

// A new watched handle for the handle `h` of the kind `kind`, put on the
// port when `assoc` (and the program has one), and in the table: its
// address, or 0 when no event could be made.
fun ws_new(h: int64, kind: int64, assoc: bool) -> int64 {
    let ev = __syscall5(__rt_get("__imp_CreateEventW"), 0, 1, 0, 0, 0)   // manual reset, not signalled
    if ev == 0 {
        return 0
    }
    let ws = __alloc(WS_SIZE)
    var k: int64 = 0
    while k < WS_SIZE {
        __store64(ws + k, 0)
        k += 8
    }
    __store64(ws + WS_HANDLE, h)
    __store64(ws + WS_KIND, kind)
    __store64(ws + WS_EVENT, ev)
    for op in [WS_PROBE, WS_SEND, WS_ACCEPT, WS_NUDGE] {
        __store64(ws + op + 32, ws)
    }
    var flags: int64 = 0
    if assoc {
        let port = net_port()
        if port != 0 && __syscall5(__rt_get("__imp_CreateIoCompletionPort"), h, port, 0, 0, 0) == port {
            flags = F_ASSOC
        }
    }
    __store64(ws + WS_FLAGS, flags)
    net_lock()
    let old = ws_take(h)
    if old != 0 {
        // (a handle closed behind the table's back: CloseHandle on a
        // handle given to the program by another call)
        ws_drop(old)
    }
    ws_put(ws)
    net_unlock()
    return ws
}

// The watched handle `ws` closed for the table (the lock held, it is in
// none): freed now unless a packet is due for it or it closes later.
fun ws_drop(ws: int64) {
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | F_CLOSED)
    ws_unused(ws)
}

// `ws` freed if it is closed, no packet is due for it and it doesn't close
// later (the lock held).
fun ws_unused(ws: int64) {
    let f = __load64(ws + WS_FLAGS)
    if (f & F_CLOSED) == 0 || (f & F_LATER) != 0 || __load64(ws + WS_REFS) != 0 {
        return
    }
    let c = __syscall(__rt_get("__imp_CloseHandle"), __load64(ws + WS_EVENT), 0, 0)
    if __load64(ws + WS_SEND_EVENT) != 0 {
        let d = __syscall(__rt_get("__imp_CloseHandle"), __load64(ws + WS_SEND_EVENT), 0, 0)
    }
    if __load64(ws + WS_BUF) != 0 {
        __free(__load64(ws + WS_BUF))
    }
    __free(ws)
}

// The watched handle of `h` (0 for none), held: not freed, even if
// another worker closes `h` meanwhile, until `ws_release`.
fun ws_hold(h: int64) -> int64 {
    net_lock()
    let ws = ws_find(h)
    if ws != 0 {
        __store64(ws + WS_REFS, __load64(ws + WS_REFS) + 1)
    }
    net_unlock()
    return ws
}

// The watched handle `ws` (from `ws_hold`, 0 for none) no longer held.
fun ws_release(ws: int64) {
    if ws == 0 {
        return
    }
    net_lock()
    __store64(ws + WS_REFS, __load64(ws + WS_REFS) - 1)
    ws_unused(ws)
    net_unlock()
}

// Whether `ws`'s operation at `op` (flagged `flag` when started) goes on.
fun ws_going(ws: int64, op: int64, flag: int64) -> bool {
    return (__load64(ws + WS_FLAGS) & flag) != 0 && __load_acq64(ws + op) == STATUS_PENDING
}

// `ws`'s operation at `op` made ready to start, signalling `event`
// (0: none).
fun op_reset(ws: int64, op: int64, event: int64) {
    let o = ws + op
    __store64(o, 0)
    __store64(o + 8, 0)
    __store64(o + 16, 0)
    __store64(o + 24, event)
}

// The operation `ws`'s `op` started, flagged `flag`, `going` when the call
// that started it says it ended or goes on (`call_going`, `wsa_going`): a
// packet is due then, when `ws` is on the port; else its flag taken off.
// Gives `going`. The lock held.
fun op_started(ws: int64, going: bool, flag: int64) -> bool {
    if going {
        if (__load64(ws + WS_FLAGS) & F_ASSOC) != 0 {
            __store64(ws + WS_REFS, __load64(ws + WS_REFS) + 1)
        }
        return true
    }
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) & ~flag)
    return false
}

// Whether an overlapped call that gave the BOOL `r` ended or goes on.
fun call_going(r: int64) -> bool {
    return ok(r) || last_error() == WSA_IO_PENDING
}

// Whether an overlapped Winsock call that gave `r` (0 for success) ended or
// goes on.
fun wsa_going(r: int64) -> bool {
    return (r & LOW32) == 0 || wsa_error() == WSA_IO_PENDING
}

// The thread blocked until `ws`'s operation at `op` ends, for at most
// `timeout_ms` (negative: no limit), waiting on `event`, which it
// signals: whether it ended.
fun op_wait(ws: int64, op: int64, event: int64, timeout_ms: int64) -> bool {
    let start = clock_ns()
    while __load_acq64(ws + op) == STATUS_PENDING {
        let r = __syscall(__rt_get("__imp_ResetEvent"), event, 0, 0)
        if __load_acq64(ws + op) != STATUS_PENDING {
            return true
        }
        var left = WAIT_INFINITE
        if timeout_ms >= 0 {
            left = timeout_ms - (clock_ns() - start) / 1000000
            if left <= 0 {
                return false
            }
        }
        let w = __syscall(__rt_get("__imp_WaitForSingleObject"), event, left, 0)
    }
    return true
}

// A packet posted for `ws` ("look at it now"), unless one is due already
// (the lock held).
fun ws_nudge(ws: int64) {
    let f = __load64(ws + WS_FLAGS)
    if (f & F_NUDGED) != 0 {
        return
    }
    let port = __load64(net() + NET_PORT)
    if port == 0 {
        return
    }
    if ok(__syscall5(__rt_get("__imp_PostQueuedCompletionStatus"), port, 0, 0, ws + WS_NUDGE, 0)) {
        __store64(ws + WS_FLAGS, f | F_NUDGED)
        __store64(ws + WS_REFS, __load64(ws + WS_REFS) + 1)
    }
}

// The handle of `ws` closed once its send or write ends, by a wait of the
// thread pool's on that operation's event (`__win_wait_posted` calls
// `close_fn`, closesocket or CloseHandle, with the handle): true, or false
// when no wait could be made (the caller closes it now). `ws` is out of
// the table and closed later (F_LATER), on the list `ws_later` frees from.
// The lock held.
fun ws_close_later(ws: int64, close_fn: int64) -> bool {
    let ctx = ws + WS_POST
    __store64(ctx, close_fn)
    __store64(ctx + 8, __load64(ws + WS_HANDLE))
    __store64(ctx + 16, 0)
    __store64(ctx + 24, 0)
    __store64(ctx + 32, 0)
    let r = win_call(__rt_get("__imp_RegisterWaitForSingleObject"),
        [ws + WS_WAIT, __load64(ws + WS_SEND_EVENT), __rt_addr("__win_wait_posted"), ctx, WAIT_INFINITE, WT_ONCE])
    if !ok(r) {
        return false
    }
    let n = net()
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | F_CLOSED | F_LATER)
    __store64(ws + WS_NEXT, __load64(n + NET_LATER))
    __store64(n + NET_LATER, ws)
    return true
}

// The handles closed later whose operation has ended and whose wait has
// closed them: their waits given back and their states freed once no
// packet is due for them (the lock held).
fun ws_later() {
    let n = net()
    var prev: int64 = 0
    var ws = __load64(n + NET_LATER)
    while ws != 0 {
        let next = __load64(ws + WS_NEXT)
        if __load_acq64(ws + WS_POST + 32) != 0 && __load64(ws + WS_REFS) == 0 {
            if prev == 0 {
                __store64(n + NET_LATER, next)
            } else {
                __store64(prev + WS_NEXT, next)
            }
            let u = __syscall(__rt_get("__imp_UnregisterWaitEx"), __load64(ws + WS_WAIT), 0, 0)
            __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) & ~F_LATER)
            ws_unused(ws)
        } else {
            prev = ws
        }
        ws = next
    }
}

// --- sockets

// A new socket of the family `family` (4: IPv4, 6: IPv6, both an IPv6
// socket's by default, as Linux's) and the kind `kind` (1: a stream, TCP;
// 2: datagrams, UDP), blocking, not inherited, overlapped: its handle. A
// datagram socket doesn't fail its next receive after an ICMP "port
// unreachable" (SIO_UDP_CONNRESET off), as Linux's unconnected one doesn't.
pub fun sock_open(family: int64, kind: int64) -> int64 {
    var af: int64 = 2               // AF_INET
    if family == 6 {
        af = 23                     // AF_INET6
    } else if family != 4 {
        return -UNSUPPORTED
    }
    if kind != 1 && kind != 2 {
        return -INVALID_INPUT
    }
    let started = winsock()
    if started < 0 {
        return started
    }
    var proto: int64 = 6            // IPPROTO_TCP
    if kind == 2 {
        proto = 17                  // IPPROTO_UDP
    }
    // WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT
    let s = win_call(__rt_get("__imp_WSASocketW"), [af, kind, proto, 0, 0, 129])
    if s == -1 || s == 0 {
        return wsa_failed()
    }
    let v = __alloc(8)
    __store64(v, 0)
    if af == 23 {
        let o = win_call(__rt_get("__imp_setsockopt"), [s, 41, 27, v, 4])        // IPPROTO_IPV6, IPV6_V6ONLY: 0
    }
    if kind == 2 {
        let got = __alloc(8)
        let o = win_call(__rt_get("__imp_WSAIoctl"), [s, 2550136844i64, v, 4, 0, 0, got, 0, 0])  // SIO_UDP_CONNRESET
        __free(got)
    }
    __free(v)
    if !sock_watched(s, kind) {
        let c = __syscall(__rt_get("__imp_closesocket"), s, 0, 0)
        return -(OTHER + 24)
    }
    return s
}

// The socket `s` of the kind `kind` (1, 2) a watched handle, on the port in
// a program with tasks: whether one could be made.
fun sock_watched(s: int64, kind: int64) -> bool {
    var k = K_STREAM
    if kind == 2 {
        k = K_DGRAM
    }
    return ws_new(s, k, with_tasks()) != 0
}

// The socket `h` in non-blocking mode (`on` 1) or blocking (0)
// (`ioctlsocket`'s FIONBIO). 0, or minus its cause.
pub fun sock_nonblocking(h: int64, on: int64) -> int64 {
    let v = __alloc(8)
    __store64(v, on)
    let r = __syscall(__rt_get("__imp_ioctlsocket"), h, 2147772030i64, v)   // FIONBIO
    __free(v)
    if wsa_bad(r) {
        return wsa_failed()
    }
    ws_flag(h, F_NONBLOCK, on != 0)
    return 0
}

// The flag `flag` of `h`'s watched handle set (`on`) or taken off.
fun ws_flag(h: int64, flag: int64, on: bool) {
    net_lock()
    let ws = ws_find(h)
    if ws != 0 {
        if on {
            __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | flag)
        } else {
            __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) & ~flag)
        }
    }
    net_unlock()
}

// The address record `rec` as a `sockaddr_in` or `sockaddr_in6` (Windows'
// AF_INET6 is 23) in a new block of 32 bytes, which the caller frees, its
// length stored at `len`; 0 for a record that is neither.
fun sockaddr_of(rec: str, len: int64) -> int64 {
    let p = __addr_of(rec)
    let n = __load64(p)
    let sa = __alloc(32)
    __store64(sa, 0)
    __store64(sa + 8, 0)
    __store64(sa + 16, 0)
    __store64(sa + 24, 0)
    if n == 7 && __load8(p + 8) == 4u8 {
        __store8(sa, 2u8)                       // AF_INET (little-endian)
        __store8(sa + 2, __load8(p + 9))        // the port, big-endian
        __store8(sa + 3, __load8(p + 10))
        __copy_bytes(sa + 4, p + 11, 4)
        __store64(len, 16)
        return sa
    }
    if n == 19 && __load8(p + 8) == 6u8 {
        __store8(sa, 23u8)                      // AF_INET6
        __store8(sa + 2, __load8(p + 9))
        __store8(sa + 3, __load8(p + 10))
        __copy_bytes(sa + 8, p + 11, 16)        // after the flow information
        __store64(len, 28)
        return sa
    }
    __free(sa)
    return 0
}

// The address record of the `sockaddr` at `sa` written at `at` (room for
// 19 bytes): its length, 7 or 19; 0 for another family.
fun record_into(sa: int64, at: int64) -> int64 {
    let fam = (__load8(sa) as int64) | ((__load8(sa + 1) as int64) << 8)
    var n: int64 = 0
    if fam == 2 {
        __store8(at, 4u8)
        __copy_bytes(at + 3, sa + 4, 4)
        n = 7
    } else if fam == 23 {
        __store8(at, 6u8)
        __copy_bytes(at + 3, sa + 8, 16)
        n = 19
    }
    if n > 0 {
        __store8(at + 1, __load8(sa + 2))
        __store8(at + 2, __load8(sa + 3))
    }
    return n
}

// The socket `h` bound to the address record `rec` (port 0: one the
// system picks): 0, or minus its cause (ADDR_IN_USE, ADDR_NOT_AVAILABLE, …).
pub fun sock_bind(h: int64, rec: str) -> int64 {
    let len = __alloc(8)
    let sa = sockaddr_of(rec, len)
    if sa == 0 {
        __free(len)
        return -INVALID_INPUT
    }
    let r = __syscall(__rt_get("__imp_bind"), h, sa, __load64(len))
    __free(sa)
    __free(len)
    if wsa_bad(r) {
        return wsa_failed()
    }
    ws_flag(h, F_BOUND, true)
    return 0
}

// The stream socket `h` listening, at most `backlog` connections queued.
pub fun sock_listen(h: int64, backlog: int64) -> int64 {
    if wsa_bad(__syscall(__rt_get("__imp_listen"), h, backlog, 0)) {
        return wsa_failed()
    }
    ws_flag(h, F_LISTENING, true)
    return 0
}

// The next connection queued on the listening socket `h`: a new socket,
// blocking, not inherited (WOULD_BLOCK when `h` is non-blocking and none is
// queued). The one AcceptEx took for a waiting task comes first.
pub fun sock_accept(h: int64) -> int64 {
    var a: int64 = 0
    net_lock()
    let ws = ws_find(h)
    if ws != 0 {
        if __load64(ws + WS_ACCEPTED) != 0 {
            a = __load64(ws + WS_ACCEPTED)
            __store64(ws + WS_ACCEPTED, 0)
        } else if (__load64(ws + WS_FLAGS) & F_ACCEPTING) != 0 && __load_acq64(ws + WS_ACCEPT) != STATUS_PENDING {
            accept_ended(ws)
            a = __load64(ws + WS_ACCEPTED)
            __store64(ws + WS_ACCEPTED, 0)
        }
    }
    net_unlock()
    if a != 0 {
        let lh = __alloc(8)
        __store64(lh, h)
        let u = win_call(__rt_get("__imp_setsockopt"), [a, 65535, 28683, lh, 8])   // SO_UPDATE_ACCEPT_CONTEXT
        __free(lh)
    } else {
        a = __syscall(__rt_get("__imp_accept"), h, 0, 0)
        if a == -1 || a == 0 {
            return wsa_failed()
        }
        // (Winsock's takes the listener's non-blocking mode)
        let v = __alloc(8)
        __store64(v, 0)
        let b = __syscall(__rt_get("__imp_ioctlsocket"), a, 2147772030i64, v)
        __free(v)
    }
    if !sock_watched(a, 1) {
        let c = __syscall(__rt_get("__imp_closesocket"), a, 0, 0)
        return -(OTHER + 24)
    }
    return a
}

// `ws`'s AcceptEx ended (the lock held): the connection it took is
// `accepted`, or its socket closed when it failed.
fun accept_ended(ws: int64) {
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) & ~F_ACCEPTING)
    let s = __load64(ws + WS_ACCEPTING)
    __store64(ws + WS_ACCEPTING, 0)
    if s == 0 {
        return
    }
    if __load64(ws + WS_ACCEPT) == 0 && __load64(ws + WS_ACCEPTED) == 0 {
        __store64(ws + WS_ACCEPTED, s)
    } else {
        let c = __syscall(__rt_get("__imp_closesocket"), s, 0, 0)
    }
}

// The address of the Winsock extension whose GUID's 16 bytes are `guid`
// (`WSAIoctl`'s SIO_GET_EXTENSION_FUNCTION_POINTER on the socket `s`),
// kept at the net state's `at`: 0 when there is none.
fun extension(s: int64, at: int64, guid: [int64]) -> int64 {
    let n = net()
    let known = __load_acq64(n + at)
    if known != 0 {
        return known
    }
    let g = __alloc(16)
    __store64(g, guid[0])
    __store64(g + 8, guid[1])
    let out = __alloc(16)
    __store64(out, 0)
    let r = win_call(ws2(W_IOCTL), [s, 3355443206i64, g, 16, out, 8, out + 8, 0, 0])
    let f = __load64(out)
    __free(g)
    __free(out)
    if (r & LOW32) == 0 && f != 0 {
        __store_rel64(n + at, f)
        return f
    }
    return 0
}

// AcceptEx's address (WSAID_ACCEPTEX), and ConnectEx's (WSAID_CONNECTEX).
fun accept_ex(s: int64) -> int64 {
    return extension(s, NET_ACCEPTEX, [1283468361458941425i64, -7880938297915028843i64])
}

fun connect_ex(s: int64) -> int64 {
    return extension(s, NET_CONNECTEX, [5071297216797345721i64, 4469387828705814926i64])
}

// The socket `h` connected to the address record `rec`: 0, or minus the
// cause; IN_PROGRESS for a non-blocking socket whose connection goes on (it
// becomes writable once it is made or has failed: `sock_error` tells which).
// A non-blocking socket on the port connects with ConnectEx (bound first to
// any address of its family), so the poller hears of the end.
pub fun sock_connect(h: int64, rec: str) -> int64 {
    let len = __alloc(8)
    let sa = sockaddr_of(rec, len)
    if sa == 0 {
        __free(len)
        return -INVALID_INPUT
    }
    let ws = ws_hold(h)
    var r: int64 = 0
    if ws != 0 && (__load64(ws + WS_FLAGS) & (F_ASSOC | F_NONBLOCK)) == (F_ASSOC | F_NONBLOCK) && connect_ex(h) != 0 {
        r = connect_overlapped(ws, h, sa, __load64(len))
    } else if wsa_bad(__syscall(__rt_get("__imp_connect"), h, sa, __load64(len))) {
        let e = wsa_error()
        if e == WSAEWOULDBLOCK {
            r = -IN_PROGRESS
        } else {
            r = -wsa_cause(e)
        }
    }
    ws_release(ws)
    __free(sa)
    __free(len)
    return r
}

// `sock_connect` through ConnectEx: IN_PROGRESS, or minus the cause.
fun connect_overlapped(ws: int64, h: int64, sa: int64, len: int64) -> int64 {
    if (__load64(ws + WS_FLAGS) & F_BOUND) == 0 {
        let any = __alloc(32)
        __store64(any, 0)
        __store64(any + 8, 0)
        __store64(any + 16, 0)
        __store64(any + 24, 0)
        __store8(any, __load8(sa))
        let b = __syscall(__rt_get("__imp_bind"), h, any, len)
        __free(any)
        if wsa_bad(b) {
            return wsa_failed()
        }
        ws_flag(h, F_BOUND, true)
    }
    net_lock()
    op_reset(ws, WS_ACCEPT, __load64(ws + WS_EVENT))
    __store64(ws + WS_FLAGS, (__load64(ws + WS_FLAGS) | F_CONNECTING) & ~F_UPDATED)
    let r = win_call(connect_ex(h), [h, sa, len, 0, 0, 0, ws + WS_ACCEPT])
    let going = op_started(ws, call_going(r), F_CONNECTING)
    let e = wsa_error()
    net_unlock()
    if !going {
        return -wsa_cause(e)
    }
    return -IN_PROGRESS
}

// The error pending on the socket `h` (SO_ERROR, or how its ConnectEx
// ended), taken: 0 for none, else its cause, positive (a connect in
// progress that failed: CONNECTION_REFUSED). A connection ConnectEx made
// gets its context then (SO_UPDATE_CONNECT_CONTEXT), so that its addresses
// and `shutdown` work.
pub fun sock_error(h: int64) -> int64 {
    let ws = ws_hold(h)
    if ws != 0 && (__load64(ws + WS_FLAGS) & F_CONNECTING) != 0 {
        let st = __load_acq64(ws + WS_ACCEPT)
        var c: int64 = 0
        if st != STATUS_PENDING {
            ws_flag(h, F_CONNECTING, false)
            c = status_cause(st)
            if c == 0 && (__load64(ws + WS_FLAGS) & F_UPDATED) == 0 {
                let u = win_call(__rt_get("__imp_setsockopt"), [h, 65535, 28688, 0, 0])   // SO_UPDATE_CONNECT_CONTEXT
                ws_flag(h, F_UPDATED, true)
            }
        }
        ws_release(ws)
        return c
    }
    ws_release(ws)
    let v = __alloc(16)
    __store64(v, 0)
    __store64(v + 8, 4)
    let r = win_call(__rt_get("__imp_getsockopt"), [h, 65535, 4103, v, v + 8])   // SOL_SOCKET, SO_ERROR
    let e = __load64(v) & LOW32
    __free(v)
    if wsa_bad(r) {
        return wsa_failed()
    }
    if e == 0 {
        return 0
    }
    return wsa_cause(e)
}

// Up to `n` bytes at `p` sent on the connected socket `h`: how many (no
// signal on Windows). A non-blocking socket on the port whose send would
// wait sends a copy of them (at most SEND_ROOM) overlapped, its end the
// poller's to hear of; until it ends the next send is WOULD_BLOCK, and how
// it failed, if it did, is the next one's error.
pub fun sock_send(h: int64, p: int64, n: int64) -> int64 {
    var len = n
    if len > 1073741824 {
        len = 1073741824
    }
    let ws = ws_hold(h)
    let r = send_with(ws, h, p, len)
    ws_release(ws)
    return r
}

// `sock_send` of `len` bytes with `h`'s watched handle `ws` (0: none) held.
fun send_with(ws: int64, h: int64, p: int64, len: int64) -> int64 {
    if ws != 0 && (__load64(ws + WS_FLAGS) & F_SENDING) != 0 {
        if (__load64(ws + WS_FLAGS) & F_NONBLOCK) == 0 {
            let done = op_wait(ws, WS_SEND, __load64(ws + WS_SEND_EVENT), -1)
        }
        let st = __load_acq64(ws + WS_SEND)
        if st == STATUS_PENDING {
            return -WOULD_BLOCK
        }
        ws_flag(h, F_SENDING, false)
        if status_cause(st) != 0 {
            return -status_cause(st)
        }
    }
    let r = win_call(__rt_get("__imp_send"), [h, p, len, 0])
    if !wsa_bad(r) {
        return r & LOW32
    }
    let e = wsa_error()
    if e == WSAEWOULDBLOCK && ws != 0 && (__load64(ws + WS_FLAGS) & F_ASSOC) != 0 {
        return send_overlapped(ws, h, p, len)
    }
    return -wsa_cause(e)
}

// Room for `n` bytes in `ws`'s buffer, and its event for sends and writes
// (the lock not held): false when it couldn't be made.
fun send_room(ws: int64, n: int64) -> bool {
    if __load64(ws + WS_SEND_EVENT) == 0 {
        let ev = __syscall5(__rt_get("__imp_CreateEventW"), 0, 1, 0, 0, 0)
        if ev == 0 {
            return false
        }
        __store64(ws + WS_SEND_EVENT, ev)
    }
    if __load64(ws + WS_BUF_CAP) < n {
        if __load64(ws + WS_BUF) != 0 {
            __free(__load64(ws + WS_BUF))
        }
        __store64(ws + WS_BUF, __alloc(n))
        __store64(ws + WS_BUF_CAP, n)
    }
    return true
}

// `sock_send`'s overlapped send of at most SEND_ROOM of the `n` bytes at
// `p`: how many it took, or minus the cause.
fun send_overlapped(ws: int64, h: int64, p: int64, n: int64) -> int64 {
    var len = n
    if len > SEND_ROOM {
        len = SEND_ROOM
    }
    if !send_room(ws, len) {
        return -WOULD_BLOCK
    }
    __copy_bytes(__load64(ws + WS_BUF), p, len)
    __store64(ws + WS_WSABUF, len)
    __store64(ws + WS_WSABUF + 8, __load64(ws + WS_BUF))
    net_lock()
    op_reset(ws, WS_SEND, __load64(ws + WS_SEND_EVENT))
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | F_SENDING)
    let r = win_call(__rt_get("__imp_WSASend"), [h, ws + WS_WSABUF, 1, 0, 0, ws + WS_SEND, 0])
    let going = op_started(ws, wsa_going(r), F_SENDING)
    let e = wsa_error()
    net_unlock()
    if !going {
        return -wsa_cause(e)
    }
    return len
}

// Up to `n` bytes received on the connected socket `h` at `p`: how many,
// 0 when the peer ended the stream.
pub fun sock_recv(h: int64, p: int64, n: int64) -> int64 {
    var len = n
    if len > 1073741824 {
        len = 1073741824
    }
    let r = win_call(__rt_get("__imp_recv"), [h, p, len, 0])
    if wsa_bad(r) {
        return wsa_failed()
    }
    return r & LOW32
}

// The `n` bytes at `p` sent as one datagram on the socket `h` to the
// address record `rec`: how many.
pub fun sock_send_to(h: int64, p: int64, n: int64, rec: str) -> int64 {
    let len = __alloc(8)
    let sa = sockaddr_of(rec, len)
    if sa == 0 {
        __free(len)
        return -INVALID_INPUT
    }
    let r = win_call(__rt_get("__imp_sendto"), [h, p, n, 0, sa, __load64(len)])
    __free(sa)
    __free(len)
    if wsa_bad(r) {
        return wsa_failed()
    }
    return r & LOW32
}

// The next datagram on the socket `h`: its first `n` bytes at `p` (the rest
// of a longer one dropped: WSAEMSGSIZE is no error), its sender's address
// record at `sender` (room for 19 bytes): how many bytes.
pub fun sock_recv_from(h: int64, p: int64, n: int64, sender: int64) -> int64 {
    let sa = __alloc(48)
    __store64(sa, 0)
    __store64(sa + 32, 28)
    let r = win_call(__rt_get("__imp_recvfrom"), [h, p, n, 0, sa, sa + 32])
    var got = r & LOW32
    if wsa_bad(r) {
        let e = wsa_error()
        if e == WSAEMSGSIZE {
            got = n
        } else {
            got = -wsa_cause(e)
        }
    }
    if got >= 0 {
        let k = record_into(sa, sender)
    }
    __free(sa)
    return got
}

// The address record of the socket `h`'s own end (`peer` 0, getsockname)
// or of its peer (1, getpeername) written at `at` (room for 19 bytes): its
// length, or minus its cause (NOT_CONNECTED: no peer).
pub fun sock_addr(h: int64, peer: int64, at: int64) -> int64 {
    let sa = __alloc(48)
    __store64(sa, 0)
    __store64(sa + 32, 28)
    var f = __rt_get("__imp_getsockname")
    if peer != 0 {
        f = __rt_get("__imp_getpeername")
    }
    let r = __syscall(f, h, sa, sa + 32)
    var n: int64 = 0
    if wsa_bad(r) {
        n = wsa_failed()
    } else {
        n = record_into(sa, at)
    }
    __free(sa)
    return n
}

// The socket `h`'s receiving (`how` 1), sending (2) or both (3) ended
// (SD_RECEIVE, SD_SEND, SD_BOTH).
pub fun sock_shutdown(h: int64, how: int64) -> int64 {
    if how < 1 || how > 3 {
        return -INVALID_INPUT
    }
    if wsa_bad(__syscall(__rt_get("__imp_shutdown"), h, how - 1, 0)) {
        return wsa_failed()
    }
    return 0
}

// The option `opt` of the socket `h` set to `value` (0 off, 1 on): 1 no
// delay (TCP_NODELAY), 2 broadcast (SO_BROADCAST), 3 a listener's address
// reused while old connections to it linger, which Windows allows anyway
// (its own SO_REUSEADDR would let another program take the port): nothing.
pub fun sock_option(h: int64, opt: int64, value: int64) -> int64 {
    var level: int64 = 65535      // SOL_SOCKET
    var name: int64 = 0
    if opt == 1 {
        level = 6                 // IPPROTO_TCP
        name = 1                  // TCP_NODELAY
    } else if opt == 2 {
        name = 32                 // SO_BROADCAST
    } else if opt == 3 {
        return 0
    } else {
        return -INVALID_INPUT
    }
    let v = __alloc(8)
    __store64(v, value)
    let r = win_call(__rt_get("__imp_setsockopt"), [h, level, name, v, 4])
    __free(v)
    if wsa_bad(r) {
        return wsa_failed()
    }
    return 0
}

// Whether the socket `h` is ready for what `events` asks (1: to receive or
// accept, 2: to send, or a connect's end), waiting at most `timeout_ms`
// milliseconds (negative: no limit): the events ready, an error or a
// hang-up counting as both (the operation then reports it); 0 when the time
// ran out. A socket's own operations (a send, ConnectEx, AcceptEx) are
// waited for on their events; otherwise `WSAPoll`.
pub fun sock_poll(h: int64, events: int64, timeout_ms: int64) -> int64 {
    let ws = ws_hold(h)
    let r = poll_with(ws, h, events, timeout_ms)
    ws_release(ws)
    return r
}

// `sock_poll` with `h`'s watched handle `ws` (0: none) held.
fun poll_with(ws: int64, h: int64, events: int64, timeout_ms: int64) -> int64 {
    let start = clock_ns()
    while true {
        var left = timeout_ms
        if timeout_ms > 0 {
            left = timeout_ms - (clock_ns() - start) / 1000000
            if left < 0 {
                left = 0
            }
        }
        if ws != 0 {
            let f = __load64(ws + WS_FLAGS)
            if (events & 2) != 0 && ws_going(ws, WS_SEND, F_SENDING) {
                if !op_wait(ws, WS_SEND, __load64(ws + WS_SEND_EVENT), left) {
                    return 0
                }
                return 2
            }
            if (events & 2) != 0 && ws_going(ws, WS_ACCEPT, F_CONNECTING) {
                if !op_wait(ws, WS_ACCEPT, __load64(ws + WS_EVENT), left) {
                    return 0
                }
                return 2
            }
            if (events & 1) != 0 && (f & F_LISTENING) != 0 && (__load64(ws + WS_ACCEPTED) != 0 ||
                    ((f & F_ACCEPTING) != 0 && __load_acq64(ws + WS_ACCEPT) != STATUS_PENDING)) {
                return 1
            }
            if (events & 1) != 0 && ws_going(ws, WS_ACCEPT, F_ACCEPTING) {
                // (a connection AcceptEx would take never makes the
                // listener readable): its event or WSAPoll, a slice at a time
                var slice: int64 = 10
                if left >= 0 && left < slice {
                    slice = left
                }
                let w = __syscall(__rt_get("__imp_WaitForSingleObject"), __load64(ws + WS_EVENT), slice, 0)
                let r = wsa_poll(h, events, 0)
                if r != 0 {
                    return r
                }
                if left == 0 {
                    return 0
                }
                continue
            }
        }
        return wsa_poll(h, events, left)
    }
    return 0
}

// `WSAPoll` of the socket `h` for `events` (1, 2), at most `timeout_ms`:
// the events ready (an error or a hang-up counting as both), 0 when the
// time ran out, or minus the cause.
fun wsa_poll(h: int64, events: int64, timeout_ms: int64) -> int64 {
    var want: int64 = 0
    if (events & 1) != 0 { want |= POLLRDNORM }
    if (events & 2) != 0 { want |= POLLWRNORM }
    let pfd = __alloc(16)
    __store64(pfd, h)
    __store64(pfd + 8, want)
    var limit = timeout_ms
    if limit < 0 {
        limit = -1
    }
    let r = __syscall(ws2(W_POLL), pfd, 1, limit)
    let got = (__load64(pfd + 8) >> 16) & 65535
    __free(pfd)
    if wsa_bad(r) {
        return wsa_failed()
    }
    if (r & LOW32) == 0 {
        return 0
    }
    return poll_ready(got, events)
}

// The portable readiness of WSAPoll's `revents` for the `events` asked.
#test(256i64, 3i64)[1]
#test(16i64, 3i64)[2]
#test(2i64, 1i64)[1]
#test(1i64, 3i64)[3]
fun poll_ready(got: int64, events: int64) -> int64 {
    var out: int64 = 0
    if (got & POLLRDNORM) != 0 { out |= 1 }
    if (got & POLLWRNORM) != 0 { out |= 2 }
    if (got & POLL_ERRORS) != 0 { out |= 3 }   // POLLERR, POLLHUP, POLLNVAL
    return out & events
}

// The socket `h` closed (`closesocket`), its watched handle with it; one
// whose overlapped send still goes on is closed once it ends
// (`ws_close_later`), so its bytes go as Linux sends a closed socket's.
pub fun sock_close(h: int64) -> int64 {
    var spare: int64 = 0
    var accepted: int64 = 0
    net_lock()
    ws_later()
    let ws = ws_take(h)
    if ws != 0 {
        if ws_going(ws, WS_SEND, F_SENDING) && ws_close_later(ws, __rt_get("__imp_closesocket")) {
            net_unlock()
            return 0
        }
        spare = __load64(ws + WS_ACCEPTING)
        accepted = __load64(ws + WS_ACCEPTED)
        __store64(ws + WS_ACCEPTED, 0)
        ws_drop(ws)
    }
    net_unlock()
    let r = __syscall(__rt_get("__imp_closesocket"), h, 0, 0)
    if spare != 0 {
        // (AcceptEx's socket: its operation ends cancelled)
        let c = __syscall(__rt_get("__imp_closesocket"), spare, 0, 0)
    }
    if accepted != 0 {
        let c = __syscall(__rt_get("__imp_closesocket"), accepted, 0, 0)
    }
    if wsa_bad(r) {
        return wsa_failed()
    }
    return 0
}

// What std.net reads of the system's configuration: `which` 0, the path of
// the hosts file (`%SystemRoot%\System32\drivers\etc\hosts`); 1, the name
// servers `GetNetworkParams` (iphlpapi) gives, as resolv.conf's
// `nameserver` lines; "" for none.
pub fun net_config(which: int64) -> str {
    if which == 0 {
        var root = env_value("SystemRoot")
        if root == "" {
            root = "C:\\Windows"
        }
        return root + "\\System32\\drivers\\etc\\hosts"
    }
    if which == 1 {
        return name_servers()
    }
    return ""
}

// The name servers of `GetNetworkParams`' FIXED_INFO (its DnsServerList at
// 272: a list of IP_ADDR_STRING, the next at 0 and the address's text at
// 8) as `nameserver` lines.
fun name_servers() -> str {
    let size = __alloc(8)
    __store64(size, 0)
    let first = __syscall(__rt_get("__imp_GetNetworkParams"), 0, size, 0) & LOW32
    let n = __load64(size) & LOW32
    if first != 111 || n == 0 {   // ERROR_BUFFER_OVERFLOW: the size it needs
        __free(size)
        return ""
    }
    let info = __alloc(n)
    let r = __syscall(__rt_get("__imp_GetNetworkParams"), info, size, 0) & LOW32
    var out = StringBuilder()
    if r == 0 {
        var node = info + 272
        while node != 0 {
            var line = StringBuilder()
            var k: int64 = 0
            while k < 16 && __load8(node + 8 + k) != 0u8 {
                line.append_byte(__load8(node + 8 + k))
                k += 1
            }
            let text = line.build()
            if text.len() > 0 {
                out.append("nameserver " + text + "\n", 0, text.len() + 12)
            }
            node = __load64(node)
        }
    }
    __free(info)
    __free(size)
    return out.build()
}

// --- the terminal and signals: MYLA-707 ------------------------------------------------
// A terminal is the console (D216): a descriptor is one when its handle
// has a console mode (`GetConsoleMode`), the console's input or one of its
// screen buffers. Its size is a screen buffer's window
// (`GetConsoleScreenBufferInfo`'s `srWindow`), the input's that of the
// console's active screen buffer (`CONOUT$`), as Linux gives a terminal's
// size on each of its descriptors. Its saved mode is the handle's console
// mode, 4 bytes. Raw mode is the input without ENABLE_LINE_INPUT,
// ENABLE_ECHO_INPUT and ENABLE_PROCESSED_INPUT (Ctrl-C a key, Enter a CR)
// and with ENABLE_VIRTUAL_TERMINAL_INPUT (special keys as their escape
// sequences); a key at a time is the input without ENABLE_LINE_INPUT and,
// as Windows echoes only a line it edits, without ENABLE_ECHO_INPUT. Escape
// sequences written are interpreted once ENABLE_VIRTUAL_TERMINAL_PROCESSING
// is on, and the output mode before is put back at the exit with the code
// pages (`console_back`).
//
// Signals come from the console's control handler (`SetConsoleCtrlHandler`):
// the runtime's `__win_on_ctrl` (selfhost/runtime_x86.my), which Windows
// calls on a thread of its own that has no state block of the runtime's
// (the workers' TLS slot is empty there, D222), so it allocates nothing and
// reaches only the process's words. Ctrl-C and Ctrl-Break are SIGINT (2),
// the console's close, a logoff and a shutdown SIGTERM (15). While someone
// listens (`__sig_pipe`'s count), the handler writes the number to the pipe
// as a byte, as Linux's `__on_signal` writes to its self-pipe, and the
// event is handled; after a close, a logoff or a shutdown, which Windows
// ends the process for once its handlers return, it waits: the program has
// until Windows' time limit (5 seconds for a close) to end itself. Else,
// while std.term holds the console raw (`__exit_hook`), it runs
// `raw_signal`, which puts the mode back (D192), and passes the event on
// to Windows' default handler, which ends the process
// (STATUS_CONTROL_C_EXIT). Else it passes the event on at once, as if it
// weren't there: it is added the first time it is needed and stays.
// `__sig_pipe`'s words: the pipe's write end, its read end plus one, how
// many listen, a lock, whether the handler was added.

const ENABLE_PROCESSED_INPUT: int64 = 1
const ENABLE_LINE_INPUT: int64 = 2
const ENABLE_ECHO_INPUT: int64 = 4
const ENABLE_VIRTUAL_TERMINAL_INPUT: int64 = 512
const ENABLE_VIRTUAL_TERMINAL_PROCESSING: int64 = 4
const CONSOLE_MODE_SIZE: int64 = 4

// The console mode of the handle `h`, or -1 for a handle that has none
// (not the console's).
fun console_mode(h: int64) -> int64 {
    if h == 0 {
        return -1
    }
    let m = __alloc(8)
    __store64(m, 0)
    let r = __syscall(__rt_get("__imp_GetConsoleMode"), h, m, 0)
    let mode = __load64(m) & LOW32
    __free(m)
    if !ok(r) {
        return -1
    }
    return mode
}

// The handle `h` given the console mode `mode`: 0, or minus the cause.
fun set_console_mode(h: int64, mode: int64) -> int64 {
    if !ok(__syscall(__rt_get("__imp_SetConsoleMode"), h, mode, 0)) {
        return failed()
    }
    return 0
}

// Whether the descriptor `fd` is a terminal (the console's): 1 or 0.
pub fun term_is_tty(fd: int64) -> int64 {
    if console_mode(std_handle(fd)) < 0 {
        return 0
    }
    return 1
}

// The size of the console `fd` is: its window's columns from bit 16 up and
// its rows in the low 16 bits, or minus its cause (NOT_A_TERMINAL for a
// descriptor that isn't the console's). The console's input has the size
// of its active screen buffer (`CONOUT$`).
pub fun term_size(fd: int64) -> int64 {
    let h = std_handle(fd)
    if console_mode(h) < 0 {
        return -NOT_A_TERMINAL
    }
    var r = window_size(h)
    if r < 0 {
        let out = open_handle("CONOUT$", GENERIC_READ | GENERIC_WRITE, OPEN_EXISTING, 0)
        if out >= 0 {
            r = window_size(out)
            let c = __syscall(__rt_get("__imp_CloseHandle"), out, 0, 0)
        }
    }
    return r
}

// The window of the screen buffer `h` (`GetConsoleScreenBufferInfo`'s
// `srWindow`: its left, top, right and bottom from byte 10), as
// `term_size` gives it, or minus the cause.
fun window_size(h: int64) -> int64 {
    let info = __alloc(24)
    var r = __syscall(__rt_get("__imp_GetConsoleScreenBufferInfo"), h, info, 0)
    if ok(r) {
        var cols = short_at(info + 14) - short_at(info + 10) + 1
        let rows = short_at(info + 16) - short_at(info + 12) + 1
        if cols > 32767 {
            cols = 32767                                // what an `int` holds shifted
        }
        r = (cols << 16) | rows
        if cols <= 0 || rows <= 0 {
            r = -NOT_A_TERMINAL
        }
    } else {
        r = failed()
    }
    __free(info)
    return r
}

// The signed 16-bit number at `p`.
fun short_at(p: int64) -> int64 {
    let u = (__load8(p) as int64) | ((__load8(p + 1) as int64) << 8)
    if u >= 32768 {
        return u - 65536
    }
    return u
}

// The console mode of `fd`, written at `buf` (4 bytes): how many bytes, or
// minus its cause.
pub fun term_get_mode(fd: int64, buf: int64) -> int64 {
    let m = console_mode(std_handle(fd))
    if m < 0 {
        return -NOT_A_TERMINAL
    }
    __store32(buf, m as uint32)
    return CONSOLE_MODE_SIZE
}

// The console `fd` set to the mode `term_get_mode` gave, at once: 0, or
// minus its cause (INVALID_INPUT for a block of another size).
pub fun term_set_mode(fd: int64, mode: str) -> int64 {
    let p = __addr_of(mode)
    if __load64(p) != CONSOLE_MODE_SIZE {
        return -INVALID_INPUT
    }
    let h = std_handle(fd)
    if console_mode(h) < 0 {
        return -NOT_A_TERMINAL
    }
    return set_console_mode(h, __load64(p + 8) & LOW32)
}

// The console's input `fd` made raw from its mode now: no line editing, no
// echo, Ctrl-C a key, Enter a CR, special keys as escape sequences
// (ENABLE_VIRTUAL_TERMINAL_INPUT; a console without it, without). 0, or
// minus its cause.
pub fun term_make_raw(fd: int64) -> int64 {
    let h = std_handle(fd)
    let m = console_mode(h)
    if m < 0 {
        return -NOT_A_TERMINAL
    }
    return keys_console_mode(h, raw_input_mode(m))
}

// The console's input `fd` a key at a time from its mode now: without line
// editing, and so without echo (Windows echoes only a line it edits),
// Ctrl-C still a signal. 0, or minus its cause.
pub fun term_make_cbreak(fd: int64) -> int64 {
    let h = std_handle(fd)
    let m = console_mode(h)
    if m < 0 {
        return -NOT_A_TERMINAL
    }
    return keys_console_mode(h, cbreak_input_mode(m))
}

// The console's input `h` given the mode `m`, or, on a console without
// ENABLE_VIRTUAL_TERMINAL_INPUT, `m` without it: 0, or minus the cause.
fun keys_console_mode(h: int64, m: int64) -> int64 {
    let r = set_console_mode(h, m)
    if r < 0 {
        return set_console_mode(h, m & ~ENABLE_VIRTUAL_TERMINAL_INPUT)
    }
    return r
}

// A raw console's input mode, from the mode `m`.
#test(503)[1008]
#test(0)[512]
fun raw_input_mode(m: int64) -> int64 {
    return (m & ~(ENABLE_PROCESSED_INPUT | ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT)) | ENABLE_VIRTUAL_TERMINAL_INPUT
}

// The input mode a key at a time, from the mode `m`.
#test(503)[1009]
fun cbreak_input_mode(m: int64) -> int64 {
    return (m & ~(ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT)) | ENABLE_VIRTUAL_TERMINAL_INPUT
}

// Escape sequences written to `fd` interpreted from now on
// (ENABLE_VIRTUAL_TERMINAL_PROCESSING on its screen buffer): 0, or minus
// its cause (NOT_A_TERMINAL for a descriptor that isn't the console's; the
// console's input, which nothing is written to, as it is). The first
// screen buffer it turns them on for and the mode it had are kept for the
// exit (`console_back`).
pub fun term_enable_vt(fd: int64) -> int64 {
    let h = std_handle(fd)
    let m = console_mode(h)
    if m < 0 {
        return -NOT_A_TERMINAL
    }
    // (the input's modes are others: its 4 is ENABLE_ECHO_INPUT)
    if (m & ENABLE_VIRTUAL_TERMINAL_PROCESSING) != 0 || window_size(h) < 0 {
        return 0
    }
    let r = set_console_mode(h, m | ENABLE_VIRTUAL_TERMINAL_PROCESSING)
    let kept = __rt_addr("__win_console_cp") + 16
    if r >= 0 && __load_acq64(kept) == 0 {
        // (two workers at once keep the same handle and mode)
        __store64(kept + 8, m)
        __store_rel64(kept, h)
    }
    return r
}

// The console as the program found it, at its end: its code pages
// (`windows_start`) and the output mode `term_enable_vt` changed. It
// allocates nothing and reaches only the process's words, as the console's
// control handler runs it too (`raw_signal`).
fun console_back() {
    let cp = __rt_addr("__win_console_cp")
    if __load64(cp) != 0 {
        let o = __syscall(__rt_get("__imp_SetConsoleOutputCP"), __load64(cp), 0, 0)
    }
    if __load64(cp + 8) != 0 {
        let i = __syscall(__rt_get("__imp_SetConsoleCP"), __load64(cp + 8), 0, 0)
    }
    let h = __load_acq64(cp + 16)
    if h != 0 {
        let m = __syscall(__rt_get("__imp_SetConsoleMode"), h, __load64(cp + 24), 0)
    }
}

// The interrupt and terminate signals caught (`on` 1), or back to what
// they did before once the last of those who asked lets go (`on` 0).
// Caught, each goes to a pipe (`CreatePipe`, not inherited) as a byte, 2
// for an interrupt, 15 for termination, and `on` 1 gives its read end; let
// go, what is queued is dropped.
pub fun signal_listen(on: int64) -> int64 {
    let st = sig_lock()
    var r: int64 = 0
    if on != 0 {
        if __load64(st + 8) == 0 {
            let ends = __alloc(16)
            if ok(__syscall5(__rt_get("__imp_CreatePipe"), ends, ends + 8, 0, 0, 0)) {
                __store64(st, __load64(ends + 8))
                __store64(st + 8, __load64(ends) + 1)
            } else {
                r = failed()
            }
            __free(ends)
        }
        if r >= 0 {
            r = ctrl_handler_added(st)
        }
        if r >= 0 {
            __store64(st + 16, __load64(st + 16) + 1)
            r = __load64(st + 8) - 1
        }
    } else if __load64(st + 16) > 0 {
        __store64(st + 16, __load64(st + 16) - 1)
        if __load64(st + 16) == 0 {
            drain(__load64(st + 8) - 1)
        }
    }
    __store_rel64(st + 24, 0)
    return r
}

// `__sig_pipe`'s lock taken, spinning while another worker holds it: the
// block's address.
fun sig_lock() -> int64 {
    let st = __rt_addr("__sig_pipe")
    while __xchg64(st + 24, 1) != 0 {
        __pause()
    }
    return st
}

// The console's control handler (`__win_on_ctrl`) added, the first time,
// under `sig_lock`: 0, or minus the cause.
fun ctrl_handler_added(st: int64) -> int64 {
    if __load64(st + 32) != 0 {
        return 0
    }
    if !ok(__syscall(__rt_get("__imp_SetConsoleCtrlHandler"), __rt_addr("__win_on_ctrl"), 1, 0)) {
        return failed()
    }
    __store64(st + 32, 1)
    return 0
}

// What the pipe's read end `h` holds, read and dropped, without waiting.
fun drain(h: int64) {
    let buf = __alloc(64)
    while pipe_holds(h) {
        if read(h, buf, 64) <= 0 {
            break
        }
    }
    __free(buf)
}

// Whether the pipe `h` holds bytes now (`PeekNamedPipe`).
fun pipe_holds(h: int64) -> bool {
    let avail = __alloc(8)
    __store64(avail, 0)
    let r = __syscall5(__rt_get("__imp_PeekNamedPipe"), h, 0, 0, 0, avail)
    let holds = ok(r) && (__load64(avail) & LOW32) != 0
    __free(avail)
    return holds
}

// The descriptor `signal_listen(1)` gives (the pipe's read end), or -1
// before the first listener: what std.rt checks a listener's handle holds.
pub fun signal_fd() -> int64 {
    return __load64(__rt_addr("__sig_pipe") + 8) - 1
}

// The next signal caught on the handle `h` that `signal_listen` gave, the
// thread waiting for one: 2 or 15, 0 when the pipe ended, or minus its
// cause.
pub fun signal_take(h: int64) -> int64 {
    let b = __alloc(8)
    __store64(b, 0)
    var r = read(h, b, 1)
    if r > 0 {
        r = __load8(b) as int64
    }
    __free(b)
    return r
}

// What the console's control handler runs for an interrupt or a request to
// terminate while std.term holds the console raw and nobody listens (D192):
// the mode before raw mode put back, as the exit hook does (D187; the
// runtime's `__exit_hook`: the descriptor plus one, then the mode as a
// string's cell, its 4 bytes at 32), and the console's code pages and
// output mode (`console_back`); the handler then passes the event on to
// Windows' default, which ends the process. It runs on a thread without a
// state block, so it allocates nothing.
pub fun raw_signal(sig: int64) {
    let h = __rt_addr("__exit_hook")
    let fd = __load64(h) - 1
    if fd >= 0 {
        __store64(h, 0)
        let r = __syscall(__rt_get("__imp_SetConsoleMode"), std_handle(fd), __load64(h + 32) & LOW32, 0)
    }
    console_back()
}

// While the console is raw (`on`), the control handler there to put its
// mode back on an interrupt or a request to terminate (`raw_signal`). It
// asks the exit hook whether the console is raw, so raw mode left needs
// nothing.
pub fun raw_signals(on: bool) {
    if on {
        let st = sig_lock()
        let r = ctrl_handler_added(st)
        __store_rel64(st + 24, 0)
    }
}

// --- memory ------------------------------------------------------------------------

// `n` bytes of fresh memory, zeroed, readable and writable (VirtualAlloc,
// reserved and committed): their address, or minus the cause.
pub fun map_memory(n: int64) -> int64 {
    let p = __syscall5(__rt_get("__imp_VirtualAlloc"), 0, n, MEM_COMMIT_RESERVE, PAGE_READWRITE, 0)
    if p == 0 {
        return failed()
    }
    return p
}

// The `n` bytes at `p` (whole pages of a mapping) given back: decommitted,
// and the mapping they are part of released once none of it is committed
// (`VirtualFree` releases only a whole one). So a mapping given back in
// parts goes back whole with its last part: std.rt aligns a chunk or a big
// cell by mapping more and giving back its ends, with tasks
// (`map_aligned`), and the cell's own part follows when it is freed
// (MYLA-703; the ends' addresses stayed reserved before).
pub fun unmap_memory(p: int64, n: int64) {
    // MEMORY_BASIC_INFORMATION (the allocation's base at 8, the region's
    // size at 24, its state at 32): in the thread's block of the runtime's,
    // as this runs while the heap grows (`map_aligned`) and can't allocate
    let info = __rt_addr("__win_memory_info")
    if __syscall(__rt_get("__imp_VirtualQuery"), p, info, 48) == 0 {
        return
    }
    let base = __load64(info + 8)
    let r = __syscall(__rt_get("__imp_VirtualFree"), p, n, MEM_DECOMMIT)
    // the region from the base: all of the mapping when it is one reserved
    // region (the next one another mapping's, or none)
    if __syscall(__rt_get("__imp_VirtualQuery"), base, info, 48) == 0 || (__load64(info + 32) & LOW32) != MEM_RESERVE {
        return
    }
    let end = base + __load64(info + 24)
    if __syscall(__rt_get("__imp_VirtualQuery"), end, info, 48) == 0 || __load64(info + 8) != base {
        let freed = __syscall(__rt_get("__imp_VirtualFree"), base, 0, MEM_RELEASE)
    }
}

// No huge pages to ask for: nothing changes.
pub fun advise_huge_pages(p: int64, n: int64) {
}

// --- time --------------------------------------------------------------------------

// The monotonic clock, in nanoseconds since some fixed point in the past
// (`QueryPerformanceCounter` at its frequency).
pub fun clock_ns() -> int64 {
    let w = __alloc(16)
    let c = __syscall(__rt_get("__imp_QueryPerformanceCounter"), w, 0, 0)
    let f = __syscall(__rt_get("__imp_QueryPerformanceFrequency"), w + 8, 0, 0)
    let ticks = __load64(w)
    var freq = __load64(w + 8)
    __free(w)
    if freq <= 0 {
        freq = 1
    }
    return ticks / freq * 1000000000 + ticks % freq * 1000000000 / freq
}

// The wall clock, in nanoseconds since 1970-01-01T00:00:00Z
// (`GetSystemTimePreciseAsFileTime`'s 100-nanosecond intervals since 1601).
pub fun wall_ns() -> int64 {
    let w = __alloc(8)
    let r = __syscall(__rt_get("__imp_GetSystemTimePreciseAsFileTime"), w, 0, 0)
    let t = __load64(w)
    __free(w)
    return (t - EPOCH_1970) * 100
}

// The calling thread asleep for `n` nanoseconds (`Sleep`, in whole
// milliseconds, at least one for a positive `n`).
pub fun sleep_ns(n: int64) {
    if n <= 0 {
        return
    }
    let ms = (n + 999999) / 1000000
    let r = __syscall(__rt_get("__imp_Sleep"), ms, 0, 0)
}

// --- the poller (D124) on the I/O completion port (MYLA-706) ---------------------------
// What a task waits for besides a timer: a socket (`poller_watch_socket`),
// a pipe of a child's until it holds bytes or ends and a child's process
// until it ended (`poller_watch`, MYLA-705), the room in a child's input
// pipe (`poller_watch_socket` with 2, MYLA-726). The wait is
// `GetQueuedCompletionStatusEx` on the process's port (`net_port`) with the
// nearest timer's time limit; `poller_wake` posts a packet of no
// operation, at most one at a time (the net state's `NET_WAKE`), as Linux's
// eventfd counts its wake-ups into one.
//
// A watch arms the handle's watched handle (`ws_watch`: its token and its
// events) and posts it a packet, so the waiting worker looks at it at once:
// every packet, an operation's end or one posted, means "look at this
// handle again". The wait looks (`ws_level`) at the handles its packets
// named that are still armed: one ready gives its event and is disarmed
// (a watch fires once, as EPOLLONESHOT's); one not ready gets the operation
// that ends when it may be (`ws_notify`, above), and stays armed. So a
// handle armed again while it is ready is ready at once (level-triggered,
// std.rt's `poll_events`), and a wake-up that comes early (another task
// took what was there) costs a look. A pipe that isn't ours (an inherited
// standard input) and a datagram socket's room can't be waited for: armed,
// they are looked at each millisecond (the wait's limit is a millisecond
// while there is one: `NET_PEEKS`). Anything else (the console, a file)
// can't be watched: ready at once, as a regular file is on Linux.
//
// One worker waits at a time (std.rt's `__exec_polling`); the others watch,
// forget and wake meanwhile, each under the net lock. No handle is held by
// a wait (it holds packets, which name watched handles that live until
// none is due), so a forget only disarms, and a handle can be closed while
// a wait goes on: its operations end cancelled, and their packets find
// it closed (D226's copy and its wait for the forgetting worker are gone).
//
// The poller's block: `[port][entries][tokens][readies][room][wait]`: the
// port, room for 64 OVERLAPPED_ENTRYs, the events of the last wait (their
// tokens and readiness, room for `room`), the count of its waits (the
// mark that a wait looks at a handle once). The events are the waiting
// worker's own (one waits at a time, and it alone reads them,
// `poller_event`, before its next wait).

// What a watch watches: a pipe, or a handle waited for (`handle_kind`).
const WATCH_PIPE: int64 = 1
const WATCH_WAITABLE: int64 = 2
// the most packets one wait takes
const ENTRIES: int64 = 64

// How the poller watches the handle `h` (`GetFileType`): a pipe as one,
// one of no file's type (a process) as a handle waited for, anything else
// not at all (0).
fun handle_kind(h: int64) -> int64 {
    let t = __syscall(__rt_get("__imp_GetFileType"), h, 0, 0) & LOW32
    if t == 3 {           // FILE_TYPE_PIPE
        return WATCH_PIPE
    }
    if t == 0 {           // FILE_TYPE_UNKNOWN
        return WATCH_WAITABLE
    }
    return 0
}

// A new poller: its block, or minus the cause.
pub fun poller_new() -> int64 {
    let port = net_port()
    if port == 0 {
        return failed()
    }
    let p = __alloc(48)
    __store64(p, port)
    __store64(p + 8, __alloc(32 * ENTRIES))
    __store64(p + 16, __alloc(8 * ENTRIES))
    __store64(p + 24, __alloc(8 * ENTRIES))
    __store64(p + 32, ENTRIES)
    __store64(p + 40, 0)
    return p
}

// Waiting in the poller `p` (from `poller_new`) for at most `timeout_ms`
// milliseconds (negative: no limit), or until `poller_wake`: how many
// events (0 when the time ran out, or for a wake-up). One worker waits at
// a time (std.rt's `__exec_polling`); the others watch, forget and wake
// meanwhile.
pub fun poller_wait(p: int64, timeout_ms: int64) -> int64 {
    let start = clock_ns()
    let entries = __load64(p + 8)
    let got = __alloc(8)
    var events: int64 = 0
    while true {
        var limit = WAIT_INFINITE
        if timeout_ms >= 0 {
            limit = timeout_ms - (clock_ns() - start) / 1000000
            if limit < 0 {
                limit = 0
            }
        }
        let peeking = __load_acq64(net() + NET_PEEKS) != 0
        if peeking && (limit == WAIT_INFINITE || limit > 1) {
            limit = 1
        }
        __store64(got, 0)
        let r = win_call(__rt_get("__imp_GetQueuedCompletionStatusEx"), [__load64(p), entries, ENTRIES, got, limit, 0])
        var n: int64 = 0
        if ok(r) {
            n = __load64(got) & LOW32
        }
        __store64(p + 40, __load64(p + 40) + 1)
        let (looked, woken) = poller_take(p, entries, n, peeking)
        events = poller_look(p, looked)
        if events > 0 || woken || limit == 0 {
            break
        }
        if timeout_ms >= 0 && (clock_ns() - start) / 1000000 >= timeout_ms {
            break
        }
    }
    __free(got)
    return events
}

// The `n` packets at `entries` taken (the lock held for them): each the
// end of an operation of a watched handle, or one posted for it, unless it
// is a wake-up. A closed one is freed once none is due for it; one armed
// is to be looked at (once a wait, and kept from being freed meanwhile:
// a packet's due), and so is each armed one looked at each millisecond
// when `peeking`. The handles to look at, and whether a wake-up came.
fun poller_take(p: int64, entries: int64, n: int64, peeking: bool) -> ([int64], bool) {
    let mark = __load64(p + 40)
    var looked: [int64] = []
    var woken = false
    net_lock()
    var i: int64 = 0
    while i < n {
        let ov = __load64(entries + 32 * i + 8)
        if ov == 0 {
            woken = true
            __store64(net() + NET_WAKE, 0)
        } else {
            let ws = __load64(ov + 32)
            __store64(ws + WS_REFS, __load64(ws + WS_REFS) - 1)
            if ov == ws + WS_NUDGE {
                __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) & ~F_NUDGED)
            }
            if ov == ws + WS_ACCEPT && (__load64(ws + WS_FLAGS) & F_WAITING) != 0 {
                // a process's wait of the pool's: done once, given back
                __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) & ~F_WAITING)
                let u = __syscall(__rt_get("__imp_UnregisterWaitEx"), __load64(ws + WS_WAIT), 0, 0)
            }
            if (__load64(ws + WS_FLAGS) & F_CLOSED) != 0 {
                ws_unused(ws)
            } else if __load64(ws + WS_WANT) != 0 && __load64(ws + WS_MARK) != mark {
                __store64(ws + WS_MARK, mark)
                __store64(ws + WS_REFS, __load64(ws + WS_REFS) + 1)
                looked.push(ws)
            }
        }
        i += 1
    }
    if peeking {
        let t = __load64(net() + NET_TABLE)
        var k: int64 = 0
        while t != 0 && k < __load64(net() + NET_CAP) {
            let ws = __load64(t + 16 * k + 8)
            if __load64(t + 16 * k) > 1 && ws_peeked(ws) && __load64(ws + WS_MARK) != mark {
                __store64(ws + WS_MARK, mark)
                __store64(ws + WS_REFS, __load64(ws + WS_REFS) + 1)
                looked.push(ws)
            }
            k += 1
        }
    }
    ws_later()
    net_unlock()
    return (looked, woken)
}

// Whether the armed `ws` is looked at each millisecond: a pipe not ours
// armed to read, a datagram socket armed to write.
fun ws_peeked(ws: int64) -> bool {
    let want = __load64(ws + WS_WANT)
    let kind = __load64(ws + WS_KIND)
    return (kind == K_PIPE && (want & 1) != 0) || (kind == K_DGRAM && (want & 2) != 0)
}

// The handles `looked` looked at (without the lock: what they are ready
// for), then, under it, each still armed given its event if it is ready
// (and disarmed), else its operation that ends when it may be: how many
// events, in the poller's block.
fun poller_look(p: int64, looked: [int64]) -> int64 {
    if looked.len() == 0 {
        return 0
    }
    var ready: [int64] = []
    for ws in looked {
        ready.push(ws_level(ws))
    }
    let want = looked.len() as int64
    if want > __load64(p + 32) {
        __free(__load64(p + 16))
        __free(__load64(p + 24))
        __store64(p + 16, __alloc(8 * want))
        __store64(p + 24, __alloc(8 * want))
        __store64(p + 32, want)
    }
    let tokens = __load64(p + 16)
    let readies = __load64(p + 24)
    var events: int64 = 0
    net_lock()
    var i = 0
    while i < looked.len() {
        let ws = looked[i]
        __store64(ws + WS_REFS, __load64(ws + WS_REFS) - 1)
        let armed = __load64(ws + WS_WANT)
        if (__load64(ws + WS_FLAGS) & F_CLOSED) != 0 {
            ws_unused(ws)
        } else if armed != 0 {
            let r = (ready[i] | __load64(ws + WS_FORCED)) & armed
            if r != 0 {
                __store64(tokens + 8 * events, __load64(ws + WS_TOKEN))
                __store64(readies + 8 * events, r)
                events += 1
                ws_disarm(ws)
            } else {
                ws_notify(ws)
            }
        }
        i += 1
    }
    net_unlock()
    return events
}

// `ws` disarmed (the lock held), no longer looked at each millisecond.
fun ws_disarm(ws: int64) {
    if ws_peeked(ws) {
        __store64(net() + NET_PEEKS, __load64(net() + NET_PEEKS) - 1)
    }
    __store64(ws + WS_WANT, 0)
    __store64(ws + WS_FORCED, 0)
}

// What the armed `ws` is ready for now, of what it is armed for (1 to read,
// 2 to write; an error or a hang-up counts as both, as on Linux): a stream
// socket to read when WSAPoll says so (a listener when AcceptEx took a
// connection), to write when no send or connect of its goes on; a datagram
// socket as WSAPoll says; a pipe to read when it holds bytes or ended, ours
// to write when no write of its goes on; a process once it ended. The lock
// not held (a handle closed meanwhile only makes a wake-up early).
fun ws_level(ws: int64) -> int64 {
    let want = __load64(ws + WS_WANT)
    let kind = __load64(ws + WS_KIND)
    let h = __load64(ws + WS_HANDLE)
    let f = __load64(ws + WS_FLAGS)
    var r: int64 = 0
    if (want & 1) != 0 {
        if kind == K_STREAM && (f & F_LISTENING) != 0 {
            if __load64(ws + WS_ACCEPTED) != 0 || ((f & F_ACCEPTING) != 0 && __load_acq64(ws + WS_ACCEPT) != STATUS_PENDING) {
                r |= 1
            }
        } else if kind == K_STREAM || kind == K_DGRAM {
            r |= wsa_poll(h, 1, 0)
        } else if kind == K_PIPE_IN || kind == K_PIPE {
            if pipe_ready(h) {
                r |= 1
            }
        } else if kind == K_PROCESS {
            if (__syscall(__rt_get("__imp_WaitForSingleObject"), h, 0, 0) & LOW32) != WAITED_OUT {
                r |= 1
            }
        }
    }
    if (want & 2) != 0 {
        if kind == K_DGRAM {
            r |= wsa_poll(h, 2, 0)
        } else if !ws_going(ws, WS_SEND, F_SENDING) && !ws_going(ws, WS_ACCEPT, F_CONNECTING) {
            r |= 2
        }
    }
    if r < 0 {
        r = 3
    }
    return r
}

// The operation started that ends when the armed `ws` may be ready (the
// lock held), unless one goes on: a read of no bytes (a stream socket, a
// datagram socket with MSG_PEEK, our pipe), AcceptEx (a listener), the
// pool's wait (a process); a send, a connect or a write ends of itself. One
// that can't start makes `ws` ready (its forced events, and a packet
// posted): the operation the task tries then reports why.
fun ws_notify(ws: int64) {
    let want = __load64(ws + WS_WANT)
    let kind = __load64(ws + WS_KIND)
    let h = __load64(ws + WS_HANDLE)
    let f = __load64(ws + WS_FLAGS)
    if (want & 1) == 0 || ((f & F_ASSOC) == 0 && kind != K_PROCESS) {
        return
    }
    var good = true
    if kind == K_STREAM && (f & F_LISTENING) != 0 {
        if __load64(ws + WS_ACCEPTED) == 0 && (f & F_ACCEPTING) == 0 {
            good = accept_start(ws, h)
        }
    } else if kind == K_STREAM || kind == K_DGRAM || kind == K_PIPE_IN {
        if !ws_going(ws, WS_PROBE, F_PROBING) {
            op_reset(ws, WS_PROBE, __load64(ws + WS_EVENT))
            __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | F_PROBING)
            __store64(ws + WS_WSABUF, 0)
            __store64(ws + WS_WSABUF + 8, ws + WS_ADDRS)
            if kind == K_PIPE_IN {
                let r = __syscall5(__rt_get("__imp_ReadFile"), h, ws + WS_ADDRS, 0, 0, ws + WS_PROBE)
                good = op_started(ws, call_going(r), F_PROBING)
            } else {
                // the flags (MSG_PEEK for a datagram, which a read of no
                // bytes would drop) and an address's room, after the WSABUF
                let flags = ws + WS_ADDRS + 48
                __store64(flags, 0)
                var r: int64 = 0
                if kind == K_DGRAM {
                    __store64(flags, 2)
                    __store64(flags + 8, 28)
                    r = win_call(ws2(W_RECV_FROM), [h, ws + WS_WSABUF, 1, 0, flags, ws + WS_ADDRS, flags + 8, ws + WS_PROBE, 0])
                } else {
                    r = win_call(ws2(W_RECV), [h, ws + WS_WSABUF, 1, 0, flags, ws + WS_PROBE, 0])
                }
                good = op_started(ws, wsa_going(r), F_PROBING)
            }
        }
    } else if kind == K_PROCESS {
        if (f & F_WAITING) == 0 {
            good = process_wait(ws, h)
        }
    }
    if !good {
        __store64(ws + WS_FORCED, 3)
        ws_nudge(ws)
    }
}

// The listener `ws` (handle `h`) given AcceptEx on a new socket of its
// family (the lock held): whether it started.
fun accept_start(ws: int64, h: int64) -> bool {
    let fn = accept_ex(h)
    let addrs = __alloc(48)
    __store64(addrs + 32, 28)
    var af: int64 = 2
    if !wsa_bad(__syscall(ws2(W_SOCKNAME), h, addrs, addrs + 32)) && __load8(addrs) == 23u8 {
        af = 23
    }
    __free(addrs)
    if fn == 0 {
        return false
    }
    let s = win_call(ws2(W_SOCKET), [af, 1, 6, 0, 0, 129])
    if s == -1 || s == 0 {
        return false
    }
    __store64(ws + WS_ACCEPTING, s)
    op_reset(ws, WS_ACCEPT, __load64(ws + WS_EVENT))
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | F_ACCEPTING)
    // no bytes received with the connection; each address's room 16 more
    // than sockaddr_in6's 28, as AcceptEx asks
    let r = win_call(fn, [h, s, ws + WS_ADDRS, 0, 44, 44, ws + WS_ADDRS + 88, ws + WS_ACCEPT])
    if !op_started(ws, call_going(r), F_ACCEPTING) {
        __store64(ws + WS_ACCEPTING, 0)
        let c = __syscall(ws2(W_CLOSE), s, 0, 0)
        return false
    }
    return true
}

// The process `ws` (handle `h`) waited for by the thread pool, whose
// callback posts the packet of `ws`'s WS_ACCEPT (the lock held): whether
// the wait was made.
fun process_wait(ws: int64, h: int64) -> bool {
    let ctx = ws + WS_POST
    __store64(ctx, __rt_get("__imp_PostQueuedCompletionStatus"))
    __store64(ctx + 8, __load64(net() + NET_PORT))
    __store64(ctx + 16, 0)
    __store64(ctx + 24, ws + WS_ACCEPT)
    __store64(ctx + 32, 0)
    let r = win_call(__rt_get("__imp_RegisterWaitForSingleObject"),
        [ws + WS_WAIT, h, __rt_addr("__win_wait_posted"), ctx, WAIT_INFINITE, WT_ONCE])
    if !ok(r) {
        return false
    }
    __store64(ws + WS_FLAGS, __load64(ws + WS_FLAGS) | F_WAITING)
    __store64(ws + WS_REFS, __load64(ws + WS_REFS) + 1)
    return true
}

// The token of event `i` of the last `poller_wait` (of the program's
// poller, std.rt's `__exec_poller`), read by the worker that waited.
pub fun poller_event(i: int64) -> int64 {
    return __load64(__load64(__rt_get("__exec_poller") + 16) + 8 * i)
}

// What event `i` found its handle ready for: 1 to read (or its end, a
// process's end), 2 to write, 3 both (an error or a hang-up counts as
// either), as `poller_watch_socket`'s `events`.
pub fun poller_event_ready(i: int64) -> int64 {
    return __load64(__load64(__rt_get("__exec_poller") + 24) + 8 * i)
}

// The descriptor `fd` watched by the poller `p` until it is readable (a
// pipe, its end too) or has ended (a process), once: a later wait gives
// `token`. UNSUPPORTED for one it can't watch, which is ready now.
pub fun poller_watch(p: int64, fd: int64, token: int64, again: bool) -> int64 {
    return ws_watch(std_handle(fd), 1, token)
}

// The handle `h` (a socket, or our end of a pipe: a child's input waited
// for room, MYLA-726) watched until it is ready for `events` (1: to receive
// or accept, 2: to send or a connect's end; an error or a hang-up always
// counts), once: a later wait gives `token`. A handle armed already is
// armed again with the new `events` (std.rt gives the union of what its
// waiters ask). `again` changes nothing here.
pub fun poller_watch_socket(p: int64, h: int64, events: int64, token: int64, again: bool) -> int64 {
    return ws_watch(h, events & 3, token)
}

// The handle `h` armed for `want` with `token`, and a packet posted for it,
// so that the waiting worker looks at it now: 0, or UNSUPPORTED for a
// handle the poller can't watch (not one of a watched handle's kinds).
// One that has no watched handle yet (a process, a pipe not ours) gets
// one here.
fun ws_watch(h: int64, want: int64, token: int64) -> int64 {
    if h == 0 || want == 0 {
        return -UNSUPPORTED
    }
    net_lock()
    var ws = ws_find(h)
    net_unlock()
    if ws == 0 {
        let kind = handle_kind(h)
        if kind == 0 {
            return -UNSUPPORTED
        }
        var k = K_PROCESS
        if kind == WATCH_PIPE {
            k = K_PIPE
        }
        ws = ws_new(h, k, false)
        if ws == 0 {
            return -UNSUPPORTED
        }
    }
    net_lock()
    if ws_peeked(ws) {
        __store64(net() + NET_PEEKS, __load64(net() + NET_PEEKS) - 1)
    }
    __store64(ws + WS_WANT, want)
    __store64(ws + WS_TOKEN, token)
    if ws_peeked(ws) {
        __store64(net() + NET_PEEKS, __load64(net() + NET_PEEKS) + 1)
    }
    ws_nudge(ws)
    net_unlock()
    return 0
}

// The descriptor `fd` no longer watched by the poller `p`: disarmed (an
// operation going on ends as it will, its packet then only looked at).
pub fun poller_forget(p: int64, fd: int64) {
    ws_forget(std_handle(fd))
}

// The socket `h` no longer watched by the poller `p`.
pub fun poller_forget_socket(p: int64, h: int64) {
    ws_forget(h)
}

// The handle `h` disarmed.
fun ws_forget(h: int64) {
    net_lock()
    let ws = ws_find(h)
    if ws != 0 {
        ws_disarm(ws)
    }
    net_unlock()
}

// The worker waiting in the poller `p` woken (or the next wait returns at
// once): a packet of no operation posted, unless one is due already.
pub fun poller_wake(p: int64) {
    if __xchg64(net() + NET_WAKE, 1) == 0 {
        if !ok(__syscall5(__rt_get("__imp_PostQueuedCompletionStatus"), __load64(p), 0, 0, 0, 0)) {
            __store64(net() + NET_WAKE, 0)
        }
    }
}

// --- workers (MYLA-703) ------------------------------------------------------------
// The workers are threads of the runtime's (`CreateThread`, selfhost/
// runtime_x86.my); they park on a word with WaitOnAddress and are woken
// with WakeByAddressSingle, as Linux's with a futex. kernel32 doesn't
// export those two: they are imported from their API set's DLL,
// api-ms-win-core-synch-l1-2-0.dll (Windows 8 on; selfhost/codegen.my's
// `windows_dlls`, MYLA-722).

// How many CPUs this process may run on (`GetProcessAffinityMask`'s mask
// of the process's group; 0 when the system won't say).
pub fun cpus_allowed() -> int64 {
    let masks = __alloc(16)
    var n: int64 = 0
    // (the current process: its pseudo handle -1)
    if ok(__syscall(__rt_get("__imp_GetProcessAffinityMask"), -1, masks, masks + 8)) {
        var m = __load64(masks)
        while m != 0 {
            m = m & (m - 1)
            n += 1
        }
    }
    __free(masks)
    return n
}

// The worker parked while the 32-bit word at `addr` still holds `seen`
// (it may also wake for no reason). The value it is compared with is the
// thread's own word of the runtime's (`__win_io`, free between reads and
// writes), as this runs while the worker has nothing to do and allocates
// nothing.
pub fun park(addr: int64, seen: int64) {
    let expected = __rt_addr("__win_io")
    __store32(expected, (seen & LOW32) as uint32)
    let r = __syscall5(__rt_get("__imp_WaitOnAddress"), addr, expected, 4, INFINITE, 0)
}

// One worker parked on the word at `addr` woken.
pub fun unpark_one(addr: int64) {
    let r = __syscall(__rt_get("__imp_WakeByAddressSingle"), addr, 0, 0)
}

// The process ended with the status `code`, all 32 bits of it (D216): the
// console as the program found it first (its code pages and output mode,
// `console_back`), and the workers made all started (`workers_started`).
pub fun exit(code: int64) {
    workers_started()
    console_back()
    let r = __syscall(__rt_get("__imp_ExitProcess"), code & LOW32, 0, 0)
}

// Until every worker thread the runtime made has started (`__win_threads`:
// how many it made, how many started; selfhost/runtime_x86.my), for at
// most a second: under Wine a thread still starting when the process ends
// fails to reach Wine's server and says so on the standard error ("wine
// client error: … sendmsg"), after a program that ends at once (MYLA-703).
fun workers_started() {
    let threads = __rt_addr("__win_threads")
    var naps = 0
    while __load_acq64(threads + 8) < __load_acq64(threads) && naps < 1000 {
        let s = __syscall(__rt_get("__imp_Sleep"), 1, 0, 0)
        naps += 1
    }
}
