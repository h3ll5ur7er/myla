// The worker waiting in the poller `p` woken (or its next wait, which then
// returns at once).
pub fun poller_wake(p: int64) {
    let was = __xchg64(p, 1)
    let wake = __load64(__rt_addr("__win_synch") + 8)
    if wake != 0 {
        let r = __syscall(wake, p, 0, 0)
    }
}

// --- workers (MYLA-703) ------------------------------------------------------------
// The workers are threads of the runtime's (`CreateThread`, selfhost/
// runtime_x86.my); they park on a word with WaitOnAddress and are woken
// with WakeByAddressSingle, as Linux's with a futex. kernel32 doesn't
// export those two: `windows_start` finds them (`find_synch`), and where
// the system has none a park is a nap of a millisecond, which a wake
// doesn't shorten (a park may end for no reason).

// How many CPUs this process may run on (`GetProcessAffinityMask`'s mask
// of the process's group; 0 when the system won't say).
pub fun cpus_allowed() -> int64 {
    let masks = __alloc(16)
    var n: int64 = 0
    // (the current process: its pseudo handle -1)
    if ok(__syscall(__rt_get("__imp_GetProcessAffinityMask"), -1, masks, masks + 8)) {
        var m = __load64(masks)
        while m != 0 {
            m = m & (m - 1)
            n += 1
        }
    }
    __free(masks)
    return n
}

// The worker parked while the 32-bit word at `addr` still holds `seen`
// (it may also wake for no reason). The value it is compared with is the
// thread's own word of the runtime's (`__win_io`, free between reads and
// writes), as this runs while the worker has nothing to do and allocates
// nothing.
pub fun park(addr: int64, seen: int64) {
    let wait = __rt_get("__win_synch")
    if wait == 0 {
        let s = __syscall(__rt_get("__imp_Sleep"), 1, 0, 0)
        return
    }
    let expected = __rt_addr("__win_io")
    __store32(expected, (seen & LOW32) as uint32)
    let r = __syscall5(wait, addr, expected, 4, INFINITE, 0)
}

// One worker parked on the word at `addr` woken.
pub fun unpark_one(addr: int64) {
    let wake = __load64(__rt_addr("__win_synch") + 8)
    if wake != 0 {
        let r = __syscall(wake, addr, 0, 0)
    }
}

// The process ended with the status `code`, all 32 bits of it (D216): the
// console's code pages put back first (`windows_start`), and the workers
// made all started (`workers_started`).
pub fun exit(code: int64) {
    workers_started()
    let cp = __rt_addr("__win_console_cp")
    if __load64(cp) != 0 {
        let o = __syscall(__rt_get("__imp_SetConsoleOutputCP"), __load64(cp), 0, 0)
    }
    if __load64(cp + 8) != 0 {
        let i = __syscall(__rt_get("__imp_SetConsoleCP"), __load64(cp + 8), 0, 0)
    }
    let r = __syscall(__rt_get("__imp_ExitProcess"), code & LOW32, 0, 0)
}

// Until every worker thread the runtime made has started (`__win_threads`:
// how many it made, how many started; selfhost/runtime_x86.my), for at
// most a second: under Wine a thread still starting when the process ends
// fails to reach Wine's server and says so on the standard error ("wine
// client error: … sendmsg"), after a program that ends at once (MYLA-703).
fun workers_started() {
    let threads = __rt_addr("__win_threads")
    var naps = 0
    while __load_acq64(threads + 8) < __load_acq64(threads) && naps < 1000 {
        let s = __syscall(__rt_get("__imp_Sleep"), 1, 0, 0)
        naps += 1
    }
}
