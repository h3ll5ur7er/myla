// --- time --------------------------------------------------------------------------

// The monotonic clock, in nanoseconds since some fixed point in the past
// (`QueryPerformanceCounter` at its frequency).
pub fun clock_ns() -> int64 {
    let w = __alloc(16)
    let c = __syscall(__rt_get("__imp_QueryPerformanceCounter"), w, 0, 0)
    let f = __syscall(__rt_get("__imp_QueryPerformanceFrequency"), w + 8, 0, 0)
    let ticks = __load64(w)
    var freq = __load64(w + 8)
    __free(w)
    if freq <= 0 {
        freq = 1
    }
    return ticks / freq * 1000000000 + ticks % freq * 1000000000 / freq
}

// The wall clock, in nanoseconds since 1970-01-01T00:00:00Z
// (`GetSystemTimePreciseAsFileTime`'s 100-nanosecond intervals since 1601).
pub fun wall_ns() -> int64 {
    let w = __alloc(8)
    let r = __syscall(__rt_get("__imp_GetSystemTimePreciseAsFileTime"), w, 0, 0)
    let t = __load64(w)
    __free(w)
    return (t - EPOCH_1970) * 100
}

// The calling thread asleep for `n` nanoseconds (`Sleep`, in whole
// milliseconds, at least one for a positive `n`).
pub fun sleep_ns(n: int64) {
    if n <= 0 {
        return
    }
    let ms = (n + 999999) / 1000000
    let r = __syscall(__rt_get("__imp_Sleep"), ms, 0, 0)
}

// --- the poller (D124): timers only until MYLA-706 ---------------------------------------
// One worker runs the tasks (MYLA-703), so nothing wakes it from another
// thread: its poller only waits for the nearest timer (`poller_wait`
// sleeps). Watching a descriptor or a socket (IOCP) comes with MYLA-706.

pub fun poller_new() -> int64 {
    return 1
}

// Asleep for `timeout_ms` milliseconds: no events (a negative timeout, which
// waits for a watched descriptor, none can be: at once).
pub fun poller_wait(p: int64, timeout_ms: int64) -> int64 {
    if timeout_ms > 0 {
        let r = __syscall(__rt_get("__imp_Sleep"), timeout_ms, 0, 0)
    }
    return 0
}

