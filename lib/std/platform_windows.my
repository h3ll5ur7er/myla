// --- memory ------------------------------------------------------------------------

// `n` bytes of fresh memory, zeroed, readable and writable (VirtualAlloc,
// reserved and committed): their address, or minus the cause.
pub fun map_memory(n: int64) -> int64 {
    let p = __syscall5(__rt_get("__imp_VirtualAlloc"), 0, n, MEM_COMMIT_RESERVE, PAGE_READWRITE, 0)
    if p == 0 {
        return failed()
    }
    return p
}

// The `n` bytes at `p` (whole pages of a mapping) given back: a mapping
// that starts at `p` and ends with them released (`VirtualFree` releases
// only a whole one), part of one decommitted, its addresses kept reserved
// (std.rt gives back parts of the mappings it aligns, with tasks; their
// addresses stay taken until MYLA-703 maps aligned memory its own way).
pub fun unmap_memory(p: int64, n: int64) {
    // MEMORY_BASIC_INFORMATION, the allocation's base at 8: in a block of
    // the runtime's, as this runs while the heap grows (`map_aligned`) and
    // can't allocate
    let info = __rt_addr("__win_memory_info")
    var whole = false
    if __syscall(__rt_get("__imp_VirtualQuery"), p, info, 48) != 0 && __load64(info + 8) == p {
        whole = __syscall(__rt_get("__imp_VirtualQuery"), p + n, info, 48) == 0 || __load64(info + 8) != p
    }
    if whole {
        let r = __syscall(__rt_get("__imp_VirtualFree"), p, 0, MEM_RELEASE)
    } else {
        let r = __syscall(__rt_get("__imp_VirtualFree"), p, n, MEM_DECOMMIT)
    }
}

// No huge pages to ask for: nothing changes.
