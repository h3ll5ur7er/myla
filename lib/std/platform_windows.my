// --- memory ------------------------------------------------------------------------

// `n` bytes of fresh memory, zeroed, readable and writable (VirtualAlloc,
// reserved and committed): their address, or minus the cause.
pub fun map_memory(n: int64) -> int64 {
    let p = __syscall5(__rt_get("__imp_VirtualAlloc"), 0, n, MEM_COMMIT_RESERVE, PAGE_READWRITE, 0)
    if p == 0 {
        return failed()
    }
    return p
}

// The `n` bytes at `p` (whole pages of a mapping) given back: decommitted,
// and the mapping they are part of released once none of it is committed
// (`VirtualFree` releases only a whole one). So a mapping given back in
// parts goes back whole with its last part: std.rt aligns a chunk or a big
// cell by mapping more and giving back its ends, with tasks
// (`map_aligned`), and the cell's own part follows when it is freed
// (MYLA-703; the ends' addresses stayed reserved before).
pub fun unmap_memory(p: int64, n: int64) {
    // MEMORY_BASIC_INFORMATION (the allocation's base at 8, the region's
    // size at 24, its state at 32): in the thread's block of the runtime's,
    // as this runs while the heap grows (`map_aligned`) and can't allocate
    let info = __rt_addr("__win_memory_info")
    if __syscall(__rt_get("__imp_VirtualQuery"), p, info, 48) == 0 {
        return
    }
    let base = __load64(info + 8)
    let r = __syscall(__rt_get("__imp_VirtualFree"), p, n, MEM_DECOMMIT)
    // the region from the base: all of the mapping when it is one reserved
    // region (the next one another mapping's, or none)
    if __syscall(__rt_get("__imp_VirtualQuery"), base, info, 48) == 0 || (__load64(info + 32) & LOW32) != MEM_RESERVE {
        return
    }
    let end = base + __load64(info + 24)
    if __syscall(__rt_get("__imp_VirtualQuery"), end, info, 48) == 0 || __load64(info + 8) != base {
        let freed = __syscall(__rt_get("__imp_VirtualFree"), base, 0, MEM_RELEASE)
    }
}

// No huge pages to ask for: nothing changes.
pub fun advise_huge_pages(p: int64, n: int64) {
}

// --- time --------------------------------------------------------------------------

// The monotonic clock, in nanoseconds since some fixed point in the past
// (`QueryPerformanceCounter` at its frequency).
pub fun clock_ns() -> int64 {
    let w = __alloc(16)
    let c = __syscall(__rt_get("__imp_QueryPerformanceCounter"), w, 0, 0)
    let f = __syscall(__rt_get("__imp_QueryPerformanceFrequency"), w + 8, 0, 0)
    let ticks = __load64(w)
    var freq = __load64(w + 8)
    __free(w)
    if freq <= 0 {
        freq = 1
    }
    return ticks / freq * 1000000000 + ticks % freq * 1000000000 / freq
}

// The wall clock, in nanoseconds since 1970-01-01T00:00:00Z
// (`GetSystemTimePreciseAsFileTime`'s 100-nanosecond intervals since 1601).
pub fun wall_ns() -> int64 {
    let w = __alloc(8)
    let r = __syscall(__rt_get("__imp_GetSystemTimePreciseAsFileTime"), w, 0, 0)
    let t = __load64(w)
    __free(w)
    return (t - EPOCH_1970) * 100
}

// The calling thread asleep for `n` nanoseconds (`Sleep`, in whole
// milliseconds, at least one for a positive `n`).
pub fun sleep_ns(n: int64) {
    if n <= 0 {
        return
    }
    let ms = (n + 999999) / 1000000
    let r = __syscall(__rt_get("__imp_Sleep"), ms, 0, 0)
}

// --- the poller (D124): timers, pipes and processes until MYLA-706 ----------------------
// What a task waits for besides a timer, for now: a pipe (a child's stream,
// the standard input when it is one) until it holds bytes or its writer
// closed it, and a process (a child's `exited`) until it ended (MYLA-705).
// A watch is armed once (one that fired waits for `poller_watch` again, as
// EPOLLONESHOT's). A wait looks at each armed watch (`PeekNamedPipe`, a
// process's handle), then waits for the processes and its wake-up event
// (`WaitForMultipleObjects`, which `poller_wake` sets), a millisecond at a
// time while a pipe is watched (an anonymous pipe can't be waited for).
// MYLA-706 puts it on an I/O completion port, with sockets. Anything else
// (the console, a file) can't be watched: ready at once, as a regular file
// is on Linux.
//
// The workers are threads (MYLA-703): one waits in the poller (std.rt's
// `__exec_polling`) while any other may watch, forget or wake, under
// std.rt's watch lock only. So the poller's block has a lock of its own
// (a spin lock: it is held for a few loads and stores, never across a
// system call), and a wait works on a copy: it copies the armed watches
// (their descriptors, tokens, kinds and handles) under the lock, looks at
// them and waits without it, and takes it again to record an event only
// for a watch that is still there, armed and the same (one forgotten
// meanwhile is ignored). A watch made or armed while a wait goes on wakes
// it, so the new one is waited for at once. A handle closed while a wait
// holds it in its copy would be a wait on a closed (or reused) handle, which
// Windows leaves undefined: `poller_forget` therefore wakes a wait that
// copied the watches and returns only once that wait is over (its count of
// waits moved on), and std.rt forgets a watch whose last waiter went before
// it closes the handle (`watch_unlink`). A handle closed while frames still
// wait on it (std.rt's `watches_closed`) isn't forgotten first: the wait's
// check drops its event, and the wait holds the object it was given until
// it returns (MYLA-706's completion port ends this).
// No copy is a `DuplicateHandle` of its own: a duplicate of a pipe's read
// end would keep the pipe open after this process closed it (the child's
// writes would not fail), and it would cost two calls a handle a wait.
//
// The block: `[lock][cap][count][watches][wake event][waiting][waits]
// [events][events' cap][copy][copy's cap]`; a watch `[fd][token][armed]
// [kind]`, a copy's entry `[fd][token][kind][handle]`. The watches are the
// lock's; the events and the copy are the waiting worker's own (one waits
// at a time, and it alone reads the events, `poller_event`, before its
// next wait).

// What a watch watches: a pipe, or a handle waited for.
const WATCH_PIPE: int64 = 1
const WATCH_WAITABLE: int64 = 2
// a watch's and a copy's bytes
const WATCH: int64 = 32
// the most handles WaitForMultipleObjects takes (MAXIMUM_WAIT_OBJECTS)
const MOST_WAITED: int64 = 64

// How the poller watches the handle `h` (`GetFileType`): a pipe as one,
// one of no file's type (a process) as a handle waited for, anything else
// not at all (0).
fun handle_kind(h: int64) -> int64 {
    let t = __syscall(__rt_get("__imp_GetFileType"), h, 0, 0) & LOW32
    if t == 3 {           // FILE_TYPE_PIPE
        return WATCH_PIPE
    }
    if t == 0 {           // FILE_TYPE_UNKNOWN
        return WATCH_WAITABLE
    }
    return 0
}

// A new poller: its block, or minus the cause.
pub fun poller_new() -> int64 {
    let wake = __syscall5(__rt_get("__imp_CreateEventW"), 0, 0, 0, 0, 0)
    if wake == 0 {
        return failed()
    }
    let p = __alloc(88)
    __store64(p, 0)
    __store64(p + 8, 16)
    __store64(p + 16, 0)
    __store64(p + 24, __alloc(16 * WATCH))
    __store64(p + 32, wake)
    __store64(p + 40, 0)
    __store64(p + 48, 0)
    __store64(p + 56, __alloc(16 * 8))
    __store64(p + 64, 16)
    __store64(p + 72, __alloc(16 * WATCH))
    __store64(p + 80, 16)
    return p
}

// The poller's lock taken, spinning while another worker holds it.
fun poller_lock(p: int64) {
    while __xchg64(p, 1) != 0 {
        __pause()
    }
}

// The poller's lock given back.
fun poller_unlock(p: int64) {
    __store_rel64(p, 0)
}

// The watch of `fd` in the poller `p`, or 0 (the lock held).
fun watch_of(p: int64, fd: int64) -> int64 {
    let ws = __load64(p + 24)
    var k: int64 = 0
    while k < __load64(p + 16) {
        if __load64(ws + WATCH * k) == fd {
            return ws + WATCH * k
        }
        k += 1
    }
    return 0
}

// The armed watches of `p` copied for a wait, and the wait counted as
// going on (`waiting`): how many (the lock held).
fun poller_copy(p: int64) -> int64 {
    let count = __load64(p + 16)
    if count > __load64(p + 80) {
        __free(__load64(p + 72))
        __store64(p + 72, __alloc(count * WATCH))
        __store64(p + 80, count)
    }
    let ws = __load64(p + 24)
    let copy = __load64(p + 72)
    var n: int64 = 0
    var k: int64 = 0
    while k < count {
        let w = ws + WATCH * k
        if __load64(w + 16) != 0 {
            let c = copy + WATCH * n
            __store64(c, __load64(w))
            __store64(c + 8, __load64(w + 8))
            __store64(c + 16, __load64(w + 24))
            __store64(c + 24, std_handle(__load64(w)))
            n += 1
        }
        k += 1
    }
    __store64(p + 40, 1)
    return n
}

// The wait that copied the watches over (the lock not held): no longer
// waiting, its count of waits moved on, for `poller_forget`.
fun poller_done(p: int64) {
    poller_lock(p)
    __store64(p + 40, 0)
    __store64(p + 48, __load64(p + 48) + 1)
    poller_unlock(p)
}

// Of the `n` copied watches, those ready now (looked at without the lock)
// recorded as the events of this wait, each disarmed, if its watch is still
// there, armed and the same: how many.
fun poller_ready(p: int64, n: int64) -> int64 {
    let copy = __load64(p + 72)
    var ready: [int64] = []
    var i: int64 = 0
    while i < n {
        let c = copy + WATCH * i
        let h = __load64(c + 24)
        var yes = true
        if __load64(c + 16) == WATCH_PIPE {
            yes = pipe_ready(h)
        } else {
            yes = (__syscall(__rt_get("__imp_WaitForSingleObject"), h, 0, 0) & LOW32) != WAITED_OUT
        }
        if yes {
            ready.push(i)
        }
        i += 1
    }
    if ready.len() == 0 {
        return 0
    }
    // the events: this worker's own, as large as they need be
    let want = ready.len() as int64
    if want > __load64(p + 64) {
        __free(__load64(p + 56))
        __store64(p + 56, __alloc(8 * want))
        __store64(p + 64, want)
    }
    let events = __load64(p + 56)
    var got: int64 = 0
    poller_lock(p)
    for k in ready {
        let c = copy + WATCH * k
        let w = watch_of(p, __load64(c))
        if w != 0 && __load64(w + 16) != 0 && __load64(w + 8) == __load64(c + 8) {
            __store64(w + 16, 0)
            __store64(events + 8 * got, __load64(c + 8))
            got += 1
        }
    }
    poller_unlock(p)
    return got
}

// Waiting in the poller `p` (from `poller_new`) for at most `timeout_ms`
// milliseconds (negative: no limit), or until `poller_wake`: how many
// events (0 when the time ran out, or for a wake-up). Without a watch and
// without a limit, at once (no event can come). One worker waits at a time
// (std.rt's `__exec_polling`); the others watch, forget and wake meanwhile.
pub fun poller_wait(p: int64, timeout_ms: int64) -> int64 {
    let start = clock_ns()
    let handles = __alloc(8 * MOST_WAITED)
    var result: int64 = 0
    while true {
        poller_lock(p)
        let n = poller_copy(p)
        poller_unlock(p)
        let got = poller_ready(p, n)
        if got > 0 || timeout_ms == 0 {
            result = got
            break
        }
        // the wake-up event and the processes, the pipes looked at again
        // a millisecond later
        let copy = __load64(p + 72)
        __store64(handles, __load64(p + 32))
        var count: int64 = 1
        var pipes = false
        var i: int64 = 0
        while i < n {
            let c = copy + WATCH * i
            if __load64(c + 16) == WATCH_PIPE || count == MOST_WAITED {
                pipes = true
            } else {
                __store64(handles + 8 * count, __load64(c + 24))
                count += 1
            }
            i += 1
        }
        if count == 1 && !pipes && timeout_ms < 0 {
            break
        }
        var left = WAIT_INFINITE
        if timeout_ms > 0 {
            left = timeout_ms - (clock_ns() - start) / 1000000
            if left <= 0 {
                break
            }
        }
        if pipes && (left == WAIT_INFINITE || left > 1) {
            left = 1
        }
        let r = __syscall5(__rt_get("__imp_WaitForMultipleObjects"), count, handles, 0, left, 0) & LOW32
        if r == 0 {
            break          // woken
        }
        poller_done(p)
    }
    poller_done(p)
    __free(handles)
    return result
}

// The token of event `i` of the last `poller_wait` (of the program's
// poller, std.rt's `__exec_poller`, as Linux's are in its `__poll_buf`),
// read by the worker that waited.
pub fun poller_event(i: int64) -> int64 {
    return __load64(__load64(__rt_get("__exec_poller") + 56) + 8 * i)
}

// What event `i` found its descriptor ready for: to read (a pipe that holds
// bytes or ended, a process that ended).
pub fun poller_event_ready(i: int64) -> int64 {
    return 1
}

// The descriptor `fd` watched by the poller `p` until it is readable (a
// pipe) or has ended (a process), once: the next wait gives `token`; `again`
// changes nothing here (a watch that fired is armed again either way). A
// wait going on is woken, to wait for it too. UNSUPPORTED for one it can't
// watch, which is ready now.
pub fun poller_watch(p: int64, fd: int64, token: int64, again: bool) -> int64 {
    let h = std_handle(fd)
    var kind: int64 = 0
    if h != 0 {
        kind = handle_kind(h)
    }
    if kind == 0 {
        return -UNSUPPORTED
    }
    poller_lock(p)
    var w = watch_of(p, fd)
    if w == 0 {
        var cap = __load64(p + 8)
        let n = __load64(p + 16)
        if n == cap {
            // twice the room (the watches are the lock's: no wait reads them)
            let ws = __alloc(2 * cap * WATCH)
            __copy_bytes(ws, __load64(p + 24), cap * WATCH)
            __free(__load64(p + 24))
            __store64(p + 24, ws)
            cap = 2 * cap
            __store64(p + 8, cap)
        }
        w = __load64(p + 24) + WATCH * n
        __store64(w, fd)
        __store64(p + 16, n + 1)
    }
    __store64(w + 8, token)
    __store64(w + 16, 1)
    __store64(w + 24, kind)
    let waiting = __load64(p + 40)
    poller_unlock(p)
    if waiting != 0 {
        poller_wake(p)
    }
    return 0
}

// The descriptor `fd` no longer watched by the poller `p`. A wait that
// copied the watches is woken, and this returns once it is over, so the
// handle can be closed then (no wait holds it).
pub fun poller_forget(p: int64, fd: int64) {
    poller_lock(p)
    let w = watch_of(p, fd)
    if w != 0 {
        let n = __load64(p + 16) - 1
        __copy_bytes(w, __load64(p + 24) + WATCH * n, WATCH)
        __store64(p + 16, n)
    }
    let waiting = __load64(p + 40)
    let waits = __load64(p + 48)
    poller_unlock(p)
    if w != 0 && waiting != 0 {
        poller_wake(p)
        while __load_acq64(p + 48) == waits {
            let y = __syscall(__rt_get("__imp_SwitchToThread"), 0, 0, 0)
        }
    }
}

pub fun poller_watch_socket(p: int64, h: int64, events: int64, token: int64, again: bool) -> int64 {
    return ENOSYS
}

pub fun poller_forget_socket(p: int64, h: int64) {
}

// The worker waiting in the poller `p` woken (or the next wait returns at
// once): its event set.
pub fun poller_wake(p: int64) {
    let r = __syscall(__rt_get("__imp_SetEvent"), __load64(p + 32), 0, 0)
}

// --- workers (MYLA-703) ------------------------------------------------------------
// The workers are threads of the runtime's (`CreateThread`, selfhost/
// runtime_x86.my); they park on a word with WaitOnAddress and are woken
// with WakeByAddressSingle, as Linux's with a futex. kernel32 doesn't
// export those two: `windows_start` finds them (`find_synch`), and where
// the system has none a park is a nap of a millisecond, which a wake
// doesn't shorten (a park may end for no reason).

// How many CPUs this process may run on (`GetProcessAffinityMask`'s mask
// of the process's group; 0 when the system won't say).
pub fun cpus_allowed() -> int64 {
    let masks = __alloc(16)
    var n: int64 = 0
    // (the current process: its pseudo handle -1)
    if ok(__syscall(__rt_get("__imp_GetProcessAffinityMask"), -1, masks, masks + 8)) {
        var m = __load64(masks)
        while m != 0 {
            m = m & (m - 1)
            n += 1
        }
    }
    __free(masks)
    return n
}

// The worker parked while the 32-bit word at `addr` still holds `seen`
// (it may also wake for no reason). The value it is compared with is the
// thread's own word of the runtime's (`__win_io`, free between reads and
// writes), as this runs while the worker has nothing to do and allocates
// nothing.
pub fun park(addr: int64, seen: int64) {
    let wait = __rt_get("__win_synch")
    if wait == 0 {
        let s = __syscall(__rt_get("__imp_Sleep"), 1, 0, 0)
        return
    }
    let expected = __rt_addr("__win_io")
    __store32(expected, (seen & LOW32) as uint32)
    let r = __syscall5(wait, addr, expected, 4, INFINITE, 0)
}

// One worker parked on the word at `addr` woken.
pub fun unpark_one(addr: int64) {
    let wake = __load64(__rt_addr("__win_synch") + 8)
    if wake != 0 {
        let r = __syscall(wake, addr, 0, 0)
    }
}

// The process ended with the status `code`, all 32 bits of it (D216): the
// console's code pages put back first (`windows_start`), and the workers
// made all started (`workers_started`).
pub fun exit(code: int64) {
    workers_started()
    let cp = __rt_addr("__win_console_cp")
    if __load64(cp) != 0 {
        let o = __syscall(__rt_get("__imp_SetConsoleOutputCP"), __load64(cp), 0, 0)
    }
    if __load64(cp + 8) != 0 {
        let i = __syscall(__rt_get("__imp_SetConsoleCP"), __load64(cp + 8), 0, 0)
    }
    let r = __syscall(__rt_get("__imp_ExitProcess"), code & LOW32, 0, 0)
}

// Until every worker thread the runtime made has started (`__win_threads`:
// how many it made, how many started; selfhost/runtime_x86.my), for at
// most a second: under Wine a thread still starting when the process ends
// fails to reach Wine's server and says so on the standard error ("wine
// client error: … sendmsg"), after a program that ends at once (MYLA-703).
fun workers_started() {
    let threads = __rt_addr("__win_threads")
    var naps = 0
    while __load_acq64(threads + 8) < __load_acq64(threads) && naps < 1000 {
        let s = __syscall(__rt_get("__imp_Sleep"), 1, 0, 0)
        naps += 1
    }
}
