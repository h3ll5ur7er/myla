// std.csv: comma-separated values after RFC 4180 (MYLA-332, D164).
//
// A record is a line of fields split by the delimiter (`,` unless given). A
// field that starts with `"` is quoted: it ends at the next lone `"`, a `""`
// inside it stands for one `"`, and it may hold delimiters and line ends. A
// record ends at CRLF, LF or a lone CR, or at the end of the text; a line end
// inside quotes is part of the field, as written. A blank line is no record.
// What RFC 4180 leaves open is decided as Go's `encoding/csv` and Python's
// `csv` (with `strict=True`) decide it: records may have different numbers of
// fields, spaces are part of a field, and a `"` inside a field that doesn't
// start with one is an error. `write` quotes a field only when it must.
// `stream_reader` reads the records of a stream (`std.io`'s `Read`) one at a
// time, holding only the record it reads and a chunk of the stream.

from std.io import Read, from_str
from std.fs import IoError
import std.bytes as bytes_m // `to_str`: a stream's bytes

// What is wrong with a text.
#derive(Eq)
pub enum CsvErrorKind {
    // A `"` inside a field that doesn't start with one
    BareQuote,
    // A quoted field still open at the end of the text (the position is its
    // opening quote)
    UnclosedQuote,
    // Something other than a delimiter or a line end after a quoted field's
    // closing `"`
    AfterQuote,
    // `parse_records`: a record with more fields than the header (the
    // position is the first extra field) or fewer (the end of the record)
    FieldCount,
    // `parse_records`: a name the header has twice (the position is the
    // second)
    DuplicateName,
    // A stream reader's stream failed (the position is the end of what it
    // read); `io_error()` gives the cause
    Io,
}

// An error and where it is: line and column count from 1, the column in
// characters, as for `std.json`'s errors.
#derive(Eq)
pub struct CsvError {
    kind: CsvErrorKind,
    line: int,
    col: int,
}

impl CsvError {
    // The reason in words, without the position (D168).
    #test(CsvError { kind: CsvErrorKind.BareQuote, line: 2, col: 5 })["'\"' in an unquoted field"]
    #test(CsvError { kind: CsvErrorKind.UnclosedQuote, line: 1, col: 1 })["a quoted field without its closing '\"'"]
    #test(CsvError { kind: CsvErrorKind.AfterQuote, line: 1, col: 4 })["a delimiter or a line end expected after '\"'"]
    #test(CsvError { kind: CsvErrorKind.FieldCount, line: 3, col: 1 })["a record with another number of fields than the header"]
    #test(CsvError { kind: CsvErrorKind.DuplicateName, line: 1, col: 5 })["a name the header has twice"]
    #test(CsvError { kind: CsvErrorKind.Io, line: 1, col: 4 })["the stream failed"]
    fun message(self) -> str {
        return match self.kind {
            BareQuote => "'\"' in an unquoted field"
            UnclosedQuote => "a quoted field without its closing '\"'"
            AfterQuote => "a delimiter or a line end expected after '\"'"
            FieldCount => "a record with another number of fields than the header"
            DuplicateName => "a name the header has twice"
            Io => "the stream failed"
        }
    }
}

impl Format for CsvError {
    // `line:col: what`, e.g. `2:5: '"' in an unquoted field`: the position,
    // then `message()`.
    #test(CsvError { kind: CsvErrorKind.BareQuote, line: 2, col: 5 }, "")["2:5: '\"' in an unquoted field"]
    #test(CsvError { kind: CsvErrorKind.FieldCount, line: 3, col: 1 }, "")["3:1: a record with another number of fields than the header"]
    #test(CsvError { kind: CsvErrorKind.Io, line: 1, col: 4 }, "")["1:4: the stream failed"]
    fun format(self, spec: str) -> str {
        return f"{self.line}:{self.col}: {self.message()}"
    }
}

// The records of `text`, each a list of its fields.
#test("a,b\r\n1,2\r\n")[Ok([["a", "b"], ["1", "2"]])]
#test("a,b\n1,2")[Ok([["a", "b"], ["1", "2"]])] // LF, and no line end at the end
#test("\"x, y\",\"say \"\"hi\"\"\"\n")[Ok([["x, y", "say \"hi\""]])]
#test("\"two\nlines\",z")[Ok([["two\nlines", "z"]])]
#test("a,,\n,\n")[Ok([["a", "", ""], ["", ""]])] // empty fields
#test("a\n\n\r\nb\n")[Ok([["a"], ["b"]])] // blank lines are no records
#test("\"\"\n")[Ok([[""]])] // but a quoted empty field is one
#test("")[Ok([])]
#test("a\"b")[Err(CsvError { kind: CsvErrorKind.BareQuote, line: 1, col: 2 })]
#test("ok\n\"open")[Err(CsvError { kind: CsvErrorKind.UnclosedQuote, line: 2, col: 1 })]
#test("\"a\"b")[Err(CsvError { kind: CsvErrorKind.AfterQuote, line: 1, col: 4 })]
#test("\"é\nü\" x,\"y\"z")[Err(CsvError { kind: CsvErrorKind.AfterQuote, line: 2, col: 3 })] // columns count characters
pub fun parse(text: str) -> Result<[[str]], CsvError> {
    return parse_with(text, ',')
}

// The records of `text` with another delimiter, such as `'\t'` or `';'`. The
// delimiter must be ASCII and neither `"` nor a line end: another one is a
// runtime error.
#test("a\tb c\n1\t2", '\t')[Ok([["a", "b c"], ["1", "2"]])]
#test("a;\"b;c\"", ';')[Ok([["a", "b;c"]])]
#test("a,b;c", ';')[Ok([["a,b", "c"]])]
#test("a", '"')[panic("std.csv: the delimiter must be ASCII and neither '\"' nor a line end")]
pub fun parse_with(text: str, delim: char) -> Result<[[str]], CsvError> {
    var r = new_reader(text, delim, false)
    var rows: [[str]] = []
    while r.skip_blank() {
        rows.push(r.record()?)
    }
    return Ok(rows)
}

// The records after the first, each a map from the first record's names to
// its fields, in the header's order. Every record must have as many fields as
// the header, and the header no name twice.
#test("a,b\n1,2\n3,4")[Ok([["a": "1", "b": "2"], ["a": "3", "b": "4"]])]
#test("only,header\n")[Ok([])]
#test("")[Ok([])]
#test("a,b\n1,2,3")[Err(CsvError { kind: CsvErrorKind.FieldCount, line: 2, col: 5 })]
#test("a,b\n1\n")[Err(CsvError { kind: CsvErrorKind.FieldCount, line: 2, col: 2 })]
#test("a,b,a\n1,2,3")[Err(CsvError { kind: CsvErrorKind.DuplicateName, line: 1, col: 5 })]
pub fun parse_records(text: str) -> Result<[[str: str]], CsvError> {
    return parse_records_with(text, ',')
}

// `parse_records` with another delimiter, as for `parse_with`.
#test("x\ty\n\"1\t2\"\t3", '\t')[Ok([["x": "1\t2", "y": "3"]])]
pub fun parse_records_with(text: str, delim: char) -> Result<[[str: str]], CsvError> {
    var r = new_reader(text, delim, true)
    var out: [[str: str]] = []
    if !r.skip_blank() {
        return Ok(out)
    }
    let header = r.record()?
    var seen: [str: bool] = [:]
    var k = 0
    while k < header.len() {
        if seen.contains(header[k]) {
            return Err(r.error(CsvErrorKind.DuplicateName, r.starts[k]))
        }
        seen[header[k]] = true
        k += 1
    }
    while r.skip_blank() {
        let fields = r.record()?
        if fields.len() != header.len() {
            let at = if fields.len() > header.len() { r.starts[header.len()] } else { r.end }
            return Err(r.error(CsvErrorKind.FieldCount, at))
        }
        var m: [str: str] = [:]
        var j = 0
        while j < header.len() {
            m[header[j]] = fields[j]
            j += 1
        }
        out.push(m)
    }
    return Ok(out)
}

// --- Reading ------------------------------------------------------------------

struct Reader {
    s: str,
    d: uint8,
    i: int,
    // with `track`, the offsets where the last record's fields start and the
    // offset of its end (for `parse_records`' errors)
    track: bool,
    starts: [int],
    end: int,
    // the position of `s[0]`: its line and column, and whether the byte
    // before it is a CR (a stream reader drops what it has read)
    line0: int,
    col0: int,
    cr0: bool,
}

fun new_reader(text: str, delim: char, track: bool) -> Reader {
    let d = delim as uint32
    if d >= 128 || delim == '"' || delim == '\n' || delim == '\r' {
        panic("std.csv: the delimiter must be ASCII and neither '\"' nor a line end")
    }
    return Reader { s: text, d: d as uint8, i: 0, track: track, starts: [], end: 0, line0: 1, col0: 1, cr0: false }
}

impl Reader {
    // An error at byte offset `at`: its line and column counted from the
    // start, as an error is rare.
    fun error(self, kind: CsvErrorKind, at: int) -> CsvError {
        let (line, col, _) = self.position(at)
        return CsvError { kind: kind, line: line, col: col }
    }

    // The line and column of byte offset `at`, and whether the byte before
    // it is a CR. A CR starts a line, and so does an LF but one right after
    // a CR.
    #test(new_reader("a\r\nb\rc\nd", ',', false), 8)[(4, 2, false)]
    #test(new_reader("é\r", ',', false), 3)[(2, 1, true)]
    fun position(self, at: int) -> (int, int, bool) {
        var line = self.line0
        var col = self.col0
        var cr = self.cr0
        var k = 0
        while k < at {
            let c = self.s[k]
            if c == '\r' {
                line += 1
                col = 1
                cr = true
            } else if c == '\n' {
                if !cr {
                    line += 1
                    col = 1
                }
                cr = false
            } else {
                if c < 128u8 || c >= 192u8 {
                    col += 1 // not a UTF-8 continuation byte
                }
                cr = false
            }
            k += 1
        }
        return (line, col, cr)
    }

    // The bytes before the current position dropped, and `more` added after
    // the rest.
    fun refill(var self, more: str) {
        let (line, col, cr) = self.position(self.i)
        var sb = StringBuilder(self.s.len() - self.i + more.len())
        sb.append(self.s, self.i, self.s.len())
        sb.append(more)
        self.s = sb.build()
        self.i = 0
        self.line0 = line
        self.col0 = col
        self.cr0 = cr
    }

    // Moves past blank lines; whether a record follows.
    fun skip_blank(var self) -> bool {
        while self.i < self.s.len() {
            let c = self.s[self.i]
            if c != '\n' && c != '\r' {
                return true
            }
            self.i += 1
        }
        return false
    }

    // The record at the current position, and past its line end.
    fun record(var self) -> Result<[str], CsvError> {
        let s = self.s
        let n = s.len()
        let d = self.d
        var i = self.i
        var fields: [str] = []
        if self.track {
            self.starts = []
        }
        while true {
            if self.track {
                self.starts.push(i)
            }
            if i < n && s[i] == '"' {
                // a quoted field: copied in runs between doubled quotes
                let open = i
                i += 1
                var run = i
                var sb = StringBuilder()
                var doubled = false
                var closed = false
                while i < n && !closed {
                    let c = s[i]
                    if c == '"' {
                        if i + 1 < n && s[i + 1] == '"' {
                            sb.append(s, run, i + 1)
                            doubled = true
                            i += 2
                            run = i
                        } else {
                            closed = true
                        }
                    } else {
                        i += 1
                    }
                }
                if !closed {
                    return Err(self.error(CsvErrorKind.UnclosedQuote, open))
                }
                if doubled {
                    sb.append(s, run, i)
                    fields.push(sb.build())
                } else {
                    fields.push(s[run:i])
                }
                i += 1
                if i < n && s[i] != d && s[i] != '\n' && s[i] != '\r' {
                    return Err(self.error(CsvErrorKind.AfterQuote, i))
                }
            } else {
                let start = i
                while i < n && s[i] != d && s[i] != '\n' && s[i] != '\r' {
                    if s[i] == '"' {
                        return Err(self.error(CsvErrorKind.BareQuote, i))
                    }
                    i += 1
                }
                fields.push(s[start:i])
            }
            if i >= n {
                self.end = i
                self.i = i
                return Ok(fields)
            }
            if s[i] == d {
                i += 1
            } else {
                // a line end: CRLF, LF or CR
                self.end = i
                if s[i] == '\r' && i + 1 < n && s[i + 1] == '\n' {
                    i += 2
                } else {
                    i += 1
                }
                self.i = i
                return Ok(fields)
            }
        }
        unreachable()
    }
}

// --- Reading a stream ---------------------------------------------------------

// How many bytes a stream reader asks its stream for at first: doubled while
// a record needs more, back to this once it is read.
const CHUNK: int = 65536

// The records of a stream (`std.io`'s `Read`), read one at a time: what
// `parse_with` gives, the same records and the same errors, without the text
// in memory. It holds the record it reads and a chunk of the stream. An
// `Iterator` of `Result<[str], CsvError>`: `Ok` for each record, one `Err`
// if the text is broken or the stream fails, then nothing.
pub struct CsvStreamReader<R> {
    src: [R],            // the stream, as `std.io`'s `Buffered` keeps it
    rd: Reader,          // the bytes read and not yet used, from rd.i on
    eof: bool,           // the stream has ended
    done: bool,          // the end, or an error, given
    first: int,          // the first read's size
    chunk: int,          // the next read's size
    io: Option<IoError>,
}

// A reader of the records the stream `r` holds.
pub fun stream_reader<R: Read>(r: R) -> CsvStreamReader<R> {
    return stream_reader_sized(r, ',', CHUNK)
}

// `stream_reader` with another delimiter, as for `parse_with`.
pub fun stream_reader_with<R: Read>(r: R, delim: char) -> CsvStreamReader<R> {
    return stream_reader_sized(r, delim, CHUNK)
}

// A stream reader whose first read is of `chunk` bytes (the tests' small
// ones put the ends of reads everywhere).
fun stream_reader_sized<R: Read>(r: R, delim: char, chunk: int) -> CsvStreamReader<R> {
    return CsvStreamReader { src: [r], rd: new_reader("", delim, false), eof: false, done: false,
                             first: chunk, chunk: chunk, io: None }
}

impl<R: Read> CsvStreamReader<R> {
    // The next record; None at the end of the stream. A record is read once
    // its line end, or the end of the stream, is in: one that reaches the
    // end of the bytes read so far is read again with more.
    fun read_record(var self) -> Result<Option<[str]>, CsvError> {
        while !self.done {
            if self.rd.skip_blank() {
                let start = self.rd.i
                match self.rd.record() {
                    Ok(fields) => {
                        if self.eof || self.rd.i < self.rd.s.len() {
                            self.chunk = self.first
                            return Ok(Some(fields))
                        }
                        self.rd.i = start
                    }
                    Err(e) => {
                        // only an open quote may close in what follows
                        if self.eof || e.kind != CsvErrorKind.UnclosedQuote {
                            self.done = true
                            return Err(e)
                        }
                    }
                }
            } else if self.eof {
                self.done = true
                return Ok(None)
            }
            self.fill()?
        }
        return Ok(None)
    }

    // Why the stream failed, if it did.
    fun io_error(self) -> Option<IoError> {
        return self.io
    }

    // The next chunk of the stream after the bytes not yet used.
    fun fill(var self) -> Result<(), CsvError> {
        var r = self.src.pop()
        let got = r.read(self.chunk)
        self.src.push(r)
        match got {
            Ok(more) => {
                if more.len() == 0 {
                    self.eof = true
                } else {
                    self.rd.refill(bytes_m.to_str(more))
                    if self.chunk < 0x1000000 {
                        self.chunk *= 2
                    }
                }
                return Ok(())
            }
            Err(e) => {
                self.io = Some(e)
                self.done = true
                return Err(self.rd.error(CsvErrorKind.Io, self.rd.s.len()))
            }
        }
    }
}

impl<R: Read> Iterator<Result<[str], CsvError>> for CsvStreamReader<R> {
    // The next record; none after the last and after an error.
    fun next(var self) -> Option<Result<[str], CsvError>> {
        return match self.read_record() {
            Ok(Some(fields)) => Some(Ok(fields))
            Ok(None) => None
            Err(e) => Some(Err(e))
        }
    }
}

// --- Writing ------------------------------------------------------------------

// The records as CSV text, each ended by CRLF. A field is quoted only when it
// must be: when it holds a `,`, a `"` or a line end, or when it is the only
// field of its record and empty (a blank line would be no record).
#test([["a", "b"], ["1", "2"]])["a,b\r\n1,2\r\n"]
#test([["x, y", "say \"hi\"", "two\nlines"]])["\"x, y\",\"say \"\"hi\"\"\",\"two\nlines\"\r\n"]
#test([[""], ["", ""]])["\"\"\r\n,\r\n"]
#test([["a b", " c "]])["a b, c \r\n"] // spaces need no quotes
pub fun write(rows: [[str]]) -> str {
    return write_with(rows, ',')
}

// `write` with another delimiter, which must be one `parse_with` takes, and
// another line end, such as "\n".
#test([["a", "b;c"], ["d,e"]], ';', "\n")["a;\"b;c\"\nd,e\n"]
#test([["a\tb"]], '\t', "\r\n")["\"a\tb\"\r\n"]
pub fun write_with(rows: [[str]], delim: char, line_end: str = "\r\n") -> str {
    let r = new_reader("", delim, false) // checks the delimiter
    var sb = StringBuilder()
    for row in rows {
        var first = true
        for f in row {
            if !first {
                sb.append_byte(r.d)
            }
            first = false
            if needs_quotes(f, r.d) || (row.len() == 1 && f.len() == 0) {
                sb.append_byte('"')
                var run = 0
                var i = 0
                while i < f.len() {
                    if f[i] == '"' {
                        sb.append(f, run, i + 1)
                        sb.append_byte('"')
                        run = i + 1
                    }
                    i += 1
                }
                sb.append(f, run, f.len())
                sb.append_byte('"')
            } else {
                sb.append(f)
            }
        }
        sb.append(line_end)
    }
    return sb.build()
}

// Whether `f` holds the delimiter, a quote or a line end.
fun needs_quotes(f: str, d: uint8) -> bool {
    var i = 0
    while i < f.len() {
        let c = f[i]
        if c == d || c == '"' || c == '\n' || c == '\r' {
            return true
        }
        i += 1
    }
    return false
}

// What `write` writes, `parse` reads back.
#test
fun round_trip() {
    let rows = [["plain", "with,comma", "with \"quote\""], [""], ["multi\r\nline", "", "é"], ["\"", ",", "\r"]]
    match parse(write(rows)) {
        Ok(back) => {
            assert(back.len() == rows.len(), "the number of records")
            var i = 0
            while i < rows.len() {
                assert(back[i].len() == rows[i].len(), f"the fields of record {i}")
                var j = 0
                while j < rows[i].len() {
                    assert(back[i][j] == rows[i][j], f"field {j} of record {i}")
                    j += 1
                }
                i += 1
            }
        }
        Err(e) => assert(false, f"{e}")
    }
}

// --- The stream reader's tests --------------------------------------------------

// What a stream reader of `text` gives, its first read of `chunk` bytes: the
// records, or the first error, as `parse_with` gives them.
fun streamed(text: str, delim: char, chunk: int) -> Result<[[str]], CsvError> {
    let r = stream_reader_sized(from_str(text), delim, chunk)
    var rows: [[str]] = []
    for row in r {
        rows.push(row?)
    }
    return Ok(rows)
}

// A stream reader gives what `parse_with` gives, wherever its reads end: a
// read of every size from one byte to the whole text.
#test
fun stream_as_parse() {
    let texts = ["a,b\r\n1,2\r\n", "a,b\n1,2", "\"x, y\",\"say \"\"hi\"\"\"\n", "\"two\nlines\",z",
                 "a,,\n,\n", "a\n\n\r\nb\n", "\"\"\n", "", "\r\n\r\n", "a\"b", "ok\n\"open", "\"a\"b",
                 "\"é\nü\" x,\"y\"z", "x\r\r\ny\rz\r", "\"a\r\nb\"\r\n\"c\"\"\"\"d\"\r\n", "é,ü\r\n\"ß\"\r\n\r\nend",
                 "1,2\r\n\r\nbad\"q", "a\r\n\r\n\r\"open", "\"\"\"\"", "\"x\"\r", "a,\"b\"\r\n\"\"\"c\",d\"e"]
    for t in texts {
        let want = parse(t)
        var chunk = 1
        while chunk <= t.len() + 1 {
            let got = streamed(t, ',', chunk)
            if got != want {
                print(f"{t.len()} bytes, reads of {chunk}")
            }
            assert(got == want, "the records parse gives")
            chunk += 1
        }
    }
    let tabs = "a\tb\n\"1\t2\"\t3\r\n"
    assert(streamed(tabs, '\t', 3) == parse_with(tabs, '\t'), "another delimiter")
    let rows = [["plain", "with,comma", "with \"quote\""], [""], ["multi\r\nline", "", "é"], ["\"", ",", "\r"]]
    assert(streamed(write(rows), ',', 5) == Ok(rows), "what write writes")
}

// A stream reader holds a record and a chunk, not the text; a long record
// is read in reads that double, not again for each.
#test
fun stream_holds_a_chunk() {
    var sb = StringBuilder()
    var k = 0
    while k < 5000 {
        sb.append(f"{k},\"field, {k}\"\r\n")
        k += 1
    }
    let text = sb.build()
    var r = stream_reader_sized(from_str(text), ',', 256)
    var n = 0
    var most = 0
    var going = true
    while going {
        match r.read_record() {
            Ok(Some(fields)) => {
                assert(fields == [f"{n}", f"field, {n}"], "the record")
                n += 1
                if r.rd.s.len() > most {
                    most = r.rd.s.len()
                }
            }
            Ok(None) => { going = false }
            Err(e) => {
                assert(false, "an error")
                going = false
            }
        }
    }
    assert(n == 5000 && text.len() == 97780, "every record")
    assert(most < 1024, "a chunk in memory")
    var long = StringBuilder()
    var field = StringBuilder()
    long.append("\"")
    k = 0
    while k < 50000 {
        long.append("ab\"\"c")
        field.append("ab\"c")
        k += 1
    }
    long.append("\",x\n")
    let one = long.build()
    var lr = stream_reader_sized(from_str(one), ',', 1)
    assert(lr.read_record() == Ok(Some([field.build(), "x"])), "a record of 250,000 bytes")
    assert(lr.chunk == 1, "the reads back to their first size")
}

// A stream that gives `text` and then fails.
struct Failing {
    text: str,
    given: bool,
}

impl Read for Failing {
    fun read(var self, n: int) -> Result<[uint8], IoError> {
        if self.given {
            return Err(IoError.Other(5))
        }
        self.given = true
        return Ok(bytes_m.from_str(self.text))
    }
}

// A stream that fails is an `Io` error at the end of what was read, after
// the records before it, and `io_error()` its cause.
#test
fun stream_failure() {
    var r = stream_reader_sized(Failing { text: "a,b\r\né,", given: false }, ',', 16)
    match r.io_error() {
        Some(_) => assert(false, "no cause yet")
        None => {}
    }
    assert(r.read_record() == Ok(Some(["a", "b"])), "the record before")
    assert(r.read_record() == Err(CsvError { kind: CsvErrorKind.Io, line: 2, col: 3 }), "the failure")
    assert(r.read_record() == Ok(None), "nothing after it")
    match r.io_error() {
        Some(Other(5)) => {}
        _ => assert(false, "the cause")
    }
}
