// std.bench: time a closure over repeated runs (MYLA-403).
//
// `run(name, f)` calls `f` in batches of doubling size until one batch takes
// a millisecond: that is the warm-up, and it fixes how many calls a run makes
// (the batch), so that reading the clock costs a run next to nothing. Then it
// times runs of that many calls with `std.time`'s monotonic clock, until a
// second has passed (at least 5 runs, at most 1000); `run_n` makes a given
// number of runs, `run_for` runs for a given time. The `Report` has each
// run's time a call, the minimum, the median, the largest and the spread (the
// median absolute deviation), and `line()` prints them on one line.
//
// Every result of `f` goes through `black_box`, a function the compiler
// doesn't see through, so the work isn't optimised away.

import .time as time
import .list as list_m // `sort`

// What a benchmark measured. The times are nanoseconds a call of the
// closure, as float64 (a run's time divided by the calls it made).
pub struct Report {
    name: str,
    // The timed runs
    runs: int,
    // The calls of the closure a run made
    batch: int,
    // Each run's time a call, in the order of the runs
    times: [float64],
    min: float64,
    median: float64,
    max: float64,
    // The median of the runs' distances from the median: a spread that one
    // slow run (a page fault, another process) doesn't move
    spread: float64,
}

// A batch is made at least this long while warming up.
const TARGET_NS: int64 = 1000000
// The most calls a run makes.
const MAX_BATCH: int = 16777216
// The time `run` takes for its runs (a second), and their least and most.
const BUDGET_NS: int64 = 1000000000
const MIN_RUNS: int = 5
const MAX_RUNS: int = 1000

// `v`, through a call the compiler doesn't see through: it doesn't inline a
// function of another module, so code whose result goes here isn't dead.
pub fun black_box<T>(v: T) -> T {
    return v
}

// `f` timed over runs for about a second: at least 5, at most 1000.
pub fun run<T>(name: str, f: () -> T) -> Report {
    return measure(name, f, MIN_RUNS, MAX_RUNS, BUDGET_NS)
}

// `f` timed over `n` runs (at least one).
pub fun run_n<T>(name: str, n: int, f: () -> T) -> Report {
    let runs = if n < 1 { 1 } else { n }
    return measure(name, f, runs, runs, 0)
}

// `f` timed over runs until `budget` has passed (at least one run).
pub fun run_for<T>(name: str, budget: time.Duration, f: () -> T) -> Report {
    return measure(name, f, 1, 2147483647, budget.as_nanos())
}

// Runs of `f` after the warm-up: at least `min_runs`, at most `max_runs`,
// and no more once `budget` nanoseconds have passed.
fun measure<T>(name: str, f: () -> T, min_runs: int, max_runs: int, budget: int64) -> Report {
    let batch = warm_up(f)
    var totals: [int64] = []
    let start = time.now_ns()
    while totals.len() < max_runs {
        if totals.len() >= min_runs && time.now_ns() - start >= budget { break }
        let t0 = time.now_ns()
        var k = 0
        while k < batch {
            black_box(f())
            k += 1
        }
        totals.push(time.now_ns() - t0)
    }
    return summary(name, batch, totals)
}

// Calls `f` in batches of 1, 2, 4, … calls until one takes TARGET_NS; that
// batch. A clock that doesn't move (MYLA_TIME=virtual, which moves only
// when tasks sleep) gives 1 once a batch of 1024 calls took no time.
fun warm_up<T>(f: () -> T) -> int {
    var batch = 1
    while true {
        let t0 = time.now_ns()
        var k = 0
        while k < batch {
            black_box(f())
            k += 1
        }
        let dt = time.now_ns() - t0
        if dt >= TARGET_NS || batch >= MAX_BATCH { return batch }
        if dt == 0 && batch >= 1024 { return 1 }
        batch *= 2
    }
    unreachable()
}

// The report of runs of `batch` calls each that took `totals` nanoseconds.
// No runs give a report of zeros.
#test("x", 1, [])[Report { name: "x", runs: 0, batch: 1, times: [], min: 0.0, median: 0.0, max: 0.0, spread: 0.0 }]
#test("x", 2, [30, 10, 20])[Report { name: "x", runs: 3, batch: 2, times: [15.0, 5.0, 10.0], min: 5.0, median: 10.0, max: 15.0, spread: 5.0 }]
#test("y", 1, [4, 1, 100, 2])[Report { name: "y", runs: 4, batch: 1, times: [4.0, 1.0, 100.0, 2.0], min: 1.0, median: 3.0, max: 100.0, spread: 1.5 }] // one slow run moves neither the median nor the spread much
pub fun summary(name: str, batch: int, totals: [int64]) -> Report {
    var times: [float64] = []
    for t in totals {
        times.push(t as float64 / batch as float64)
    }
    if times.len() == 0 {
        return Report { name: name, runs: 0, batch: batch, times: times, min: 0.0, median: 0.0, max: 0.0, spread: 0.0 }
    }
    let sorted = times.sorted()
    let mid = median_of(sorted)
    var dev: [float64] = []
    for t in times {
        dev.push(if t < mid { mid - t } else { t - mid })
    }
    return Report {
        name: name, runs: times.len(), batch: batch, times: times,
        min: sorted[0], median: mid, max: sorted[^1], spread: median_of(dev.sorted()),
    }
}

// The median of the sorted list `xs` (not empty): its middle element, or the
// mean of its two middle ones.
#test([1.0])[1.0]
#test([1.0, 2.0, 7.0, 9.0])[4.5]
fun median_of(xs: [float64]) -> float64 {
    let n = xs.len()
    if n % 2 == 1 { return xs[n / 2] }
    return (xs[n / 2 - 1] + xs[n / 2]) / 2.0
}

// `ns` nanoseconds with three significant digits and a unit: `12.3 ns`,
// `1.23 µs`, `123 ms`, `4.50 s`.
#test(0.0)["0.00 ns"]
#test(0.456)["0.46 ns"]
#test(12.34)["12.3 ns"]
#test(999.4)["999 ns"]
#test(999.7)["1.00 µs"]
#test(1234.0)["1.23 µs"]
#test(1230000.0)["1.23 ms"]
#test(123456789.0)["123 ms"]
#test(4500000000.0)["4.50 s"]
#test(12345000000000.0)["12345 s"]
pub fun duration_text(ns: float64) -> str {
    let units = ["ns", "µs", "ms", "s"]
    var v = ns
    var u = 0
    while u < 3 && v >= 999.5 {
        v = v / 1000.0
        u += 1
    }
    if v >= 99.95 { return f"{v:.0} {units[u]}" }
    if v >= 9.995 { return f"{v:.1} {units[u]}" }
    return f"{v:.2} {units[u]}"
}

impl Report {
    // The report on one line: `fib  min 1.23 ms  median 1.30 ms  ±0.8%
    // (25 runs)`, `(25 runs of 1000 calls)` when a run made more than one,
    // the spread a percentage of the median.
    fun line(self) -> str {
        let pct = if self.median > 0.0 { self.spread / self.median * 100.0 } else { 0.0 }
        let calls = if self.batch > 1 { f" of {self.batch} calls" } else { "" }
        let s = if self.runs == 1 { "" } else { "s" }
        return f"{self.name}  min {duration_text(self.min)}  median {duration_text(self.median)}  ±{pct:.1}%  ({self.runs} run{s}{calls})"
    }
}

impl Format for Report {
    // The report as `line()` writes it (the spec is ignored).
    fun format(self, spec: str) -> str {
        return self.line()
    }
}

// --- tests -------------------------------------------------------------------
// `run`, `run_n` and `run_for` are generic and take closures, which a
// `#test` case can't (D116), so they are tested by test functions (D162).

#test(Report { name: "fib", runs: 25, batch: 1, times: [], min: 1230000.0, median: 1300000.0, max: 2000000.0, spread: 10400.0 })["fib  min 1.23 ms  median 1.30 ms  ±0.8%  (25 runs)"]
#test(Report { name: "get", runs: 1, batch: 4096, times: [], min: 12.0, median: 12.0, max: 12.0, spread: 0.0 })["get  min 12.0 ns  median 12.0 ns  ±0.0%  (1 run of 4096 calls)"]
#test(Report { name: "none", runs: 0, batch: 1, times: [], min: 0.0, median: 0.0, max: 0.0, spread: 0.0 })["none  min 0.00 ns  median 0.00 ns  ±0.0%  (0 runs)"]
fun line_cases(r: Report) -> str {
    return r.line()
}

fun busy(n: int) -> int64 {
    var acc: int64 = 0
    for i in 0..n {
        acc = acc.wrapping_mul(31).wrapping_add(i as int64)
    }
    return acc
}

#test
fun run_n_makes_n_runs() {
    let r = run_n("busy", 7, () => busy(100))
    assert(r.runs == 7 && r.times.len() == 7, "seven runs")
    assert(r.batch >= 1, "a batch")
    assert(r.min > 0.0 && r.min <= r.median && r.median <= r.max, f"ordered: {r.min} {r.median} {r.max}")
    assert(r.spread >= 0.0 && r.spread <= r.max - r.min, "a spread within the range")
    assert(run_n("once", 0, () => 1).runs == 1, "at least one run")
    assert(f"{r}" == r.line(), "Format is the line")
    assert(r.line()[:10] == "busy  min ", r.line())
}

#test
fun run_for_stops_at_its_budget() {
    let start = time.now_ns()
    let r = run_for("busy", time.millis(30), () => busy(1000))
    let took = time.now_ns() - start
    assert(r.runs >= 1, "a run")
    // the warm-up takes a few milliseconds and the last run one more
    assert(took < 500000000, f"took {took} ns")
    // a run is about a millisecond (the batch), so 30 ms make a few
    assert(r.runs <= 60, f"{r.runs} runs")
}

#test
fun runs_more_calls_for_less_work() {
    let small = run_n("small", 3, () => busy(10))
    let big = run_n("big", 3, () => busy(10000))
    assert(small.batch > big.batch, f"batches {small.batch} and {big.batch}")
    assert(small.median < big.median, f"medians {small.median} and {big.median}")
}

#test
fun black_box_gives_its_value() {
    assert(black_box(42) == 42, "an int")
    assert(black_box("s") == "s", "a str")
    assert(black_box([1, 2]) == [1, 2], "a list")
}
