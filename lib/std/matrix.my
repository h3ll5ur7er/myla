// std.matrix: square matrices of 2 to 4 and matrices of any shape of float64 (D201, MYLA-587).
//
// GENERATED by scripts/gen_std_linalg.py, with its float32 twin
// std.matrix32, from one template: edit the script, not this file.
//
// `Mat2`, `Mat3` and `Mat4`, column-major: the columns are the fields
// `x_axis`, `y_axis`, `z_axis`, `w_axis` (vectors of std.vector), and a
// matrix multiplies a column vector, `m * v`, so `a * b * v` applies `b`
// first. Made by `mat3(c0, c1, c2)` (columns), `mat3_from_rows(r0, r1, r2)`,
// `Mat3.identity()` / `Mat3.zero()` (std.algebra's traits) and the transforms
// (`translation`, `rotation_x`, `look_at_rh`, `perspective_rh_gl`, …,
// right-handed). `m[(row, col)]` is an element, `m[i]` a column (D200).
// `Matrix` has any shape, its elements in one column-major list, its
// operators checking the shapes. Matrices print by rows: `[(1, 0), (0, 1)]`.

import std.float as fl
from std.algebra import Zero, Identity
from std.vector import Vec2, Vec3, Vec4, Vector, vec2, vec3, vec4
from std.matrix32 import Mat2 as Mat2F32, Mat3 as Mat3F32, Mat4 as Mat4F32, Matrix as MatrixF32

#derive(Eq, Hash)
pub struct Mat2 {
    x_axis: Vec2,
    y_axis: Vec2,
}

// A Mat2 of its columns.
pub fun mat2(c0: Vec2, c1: Vec2) -> Mat2 {
    return Mat2 { x_axis: c0, y_axis: c1 }
}

// A Mat2 of its rows.
pub fun mat2_from_rows(r0: Vec2, r1: Vec2) -> Mat2 {
    return mat2(r0, r1).transpose()
}

impl Identity for Mat2 {
    fun identity() -> Mat2 {
        return Mat2 { x_axis: vec2(1.0, 0.0), y_axis: vec2(0.0, 1.0) }
    }
}

impl Zero for Mat2 {
    fun zero() -> Mat2 {
        return Mat2 { x_axis: Vec2.zero(), y_axis: Vec2.zero() }
    }
}

impl Format for Mat2 {
    fun format(self, spec: str) -> str {
        return "[" + f"{self.row(0)}" + ", " + f"{self.row(1)}" + "]"
    }
}

// `a * b`: `b` first, then `a`, on a column vector.
impl Mul for Mat2 {
    fun mul(self, o: Mat2) -> Mat2 {
        return Mat2 { x_axis: self * o.x_axis, y_axis: self * o.y_axis }
    }
}

impl Mul<Vec2, Vec2> for Mat2 {
    fun mul(self, v: Vec2) -> Vec2 {
        return Vec2 {
            x: self.x_axis.x * v.x + self.y_axis.x * v.y,
            y: self.x_axis.y * v.x + self.y_axis.y * v.y,
        }
    }
}

impl Mul<float64> for Mat2 {
    fun mul(self, k: float64) -> Mat2 {
        return Mat2 { x_axis: self.x_axis * k, y_axis: self.y_axis * k }
    }
}

impl Mul<Mat2, Mat2> for float64 {
    fun mul(self, m: Mat2) -> Mat2 {
        return m * self
    }
}

impl Add for Mat2 {
    fun add(self, o: Mat2) -> Mat2 {
        return Mat2 { x_axis: self.x_axis + o.x_axis, y_axis: self.y_axis + o.y_axis }
    }
}

impl Sub for Mat2 {
    fun sub(self, o: Mat2) -> Mat2 {
        return Mat2 { x_axis: self.x_axis - o.x_axis, y_axis: self.y_axis - o.y_axis }
    }
}

impl Neg for Mat2 {
    fun neg(self) -> Mat2 {
        return Mat2 { x_axis: -self.x_axis, y_axis: -self.y_axis }
    }
}

// `m[(row, col)]`.
impl Index<(int, int), float64> for Mat2 {
    fun index(self, rc: (int, int)) -> float64 {
        let (r, c) = rc
        return self.col(c)[r]
    }
}

impl IndexSet<(int, int), float64> for Mat2 {
    fun set_index(var self, rc: (int, int), v: float64) {
        let (r, c) = rc
        if c == 0 { self.x_axis[r] = v } else if c == 1 { self.y_axis[r] = v } else { panic(f"column {c} out of range for a Mat2") }
    }
}

// `m[i]`: the column `i`.
impl Index<int, Vec2> for Mat2 {
    fun index(self, i: int) -> Vec2 {
        return self.col(i)
    }
}

impl IndexSet<int, Vec2> for Mat2 {
    fun set_index(var self, i: int, v: Vec2) {
        if i == 0 { self.x_axis = v } else if i == 1 { self.y_axis = v } else { panic(f"column {i} out of range for a Mat2") }
    }
}

impl Mat2 {
    fun col(self, i: int) -> Vec2 {
        if i == 0 { return self.x_axis }
        if i == 1 { return self.y_axis }
        panic(f"column {i} out of range for a Mat2")
    }

    fun row(self, i: int) -> Vec2 {
        return vec2(self.x_axis[i], self.y_axis[i])
    }

    fun transpose(self) -> Mat2 {
        return mat2(self.row(0), self.row(1))
    }

    fun trace(self) -> float64 {
        return self.x_axis.x + self.y_axis.y
    }

    // The elements column by column, as a GPU takes them.
    fun to_list(self) -> [float64] {
        return [self.x_axis.x, self.x_axis.y, self.y_axis.x, self.y_axis.y]
    }

    fun to_matrix(self) -> Matrix {
        return Matrix { rows: 2, cols: 2, data: self.to_list() }
    }

    fun to_f32(self) -> Mat2F32 {
        return Mat2F32 { x_axis: self.x_axis.to_f32(), y_axis: self.y_axis.to_f32() }
    }

    #test(Mat2 { x_axis: Vec2 { x: 1.0, y: 3.0 }, y_axis: Vec2 { x: 2.0, y: 4.0 } })[-2.0]
    fun determinant(self) -> float64 {
        return self.x_axis.x * self.y_axis.y - self.y_axis.x * self.x_axis.y
    }

    // The inverse; None for a matrix with no inverse (a determinant of 0 or
    // not finite).
    fun inverse(self) -> Option<Mat2> {
        let d = self.determinant()
        if d == 0.0 || !d.is_finite() { return None }
        let adj = mat2(vec2(self.y_axis.y, -self.x_axis.y), vec2(-self.y_axis.x, self.x_axis.x))
        return Some(adj * (1.0 / d))
    }
}

#derive(Eq, Hash)
pub struct Mat3 {
    x_axis: Vec3,
    y_axis: Vec3,
    z_axis: Vec3,
}

// A Mat3 of its columns.
pub fun mat3(c0: Vec3, c1: Vec3, c2: Vec3) -> Mat3 {
    return Mat3 { x_axis: c0, y_axis: c1, z_axis: c2 }
}

// A Mat3 of its rows.
pub fun mat3_from_rows(r0: Vec3, r1: Vec3, r2: Vec3) -> Mat3 {
    return mat3(r0, r1, r2).transpose()
}

impl Identity for Mat3 {
    fun identity() -> Mat3 {
        return Mat3 { x_axis: vec3(1.0, 0.0, 0.0), y_axis: vec3(0.0, 1.0, 0.0), z_axis: vec3(0.0, 0.0, 1.0) }
    }
}

impl Zero for Mat3 {
    fun zero() -> Mat3 {
        return Mat3 { x_axis: Vec3.zero(), y_axis: Vec3.zero(), z_axis: Vec3.zero() }
    }
}

impl Format for Mat3 {
    fun format(self, spec: str) -> str {
        return "[" + f"{self.row(0)}" + ", " + f"{self.row(1)}" + ", " + f"{self.row(2)}" + "]"
    }
}

// `a * b`: `b` first, then `a`, on a column vector.
impl Mul for Mat3 {
    fun mul(self, o: Mat3) -> Mat3 {
        return Mat3 { x_axis: self * o.x_axis, y_axis: self * o.y_axis, z_axis: self * o.z_axis }
    }
}

impl Mul<Vec3, Vec3> for Mat3 {
    fun mul(self, v: Vec3) -> Vec3 {
        return Vec3 {
            x: self.x_axis.x * v.x + self.y_axis.x * v.y + self.z_axis.x * v.z,
            y: self.x_axis.y * v.x + self.y_axis.y * v.y + self.z_axis.y * v.z,
            z: self.x_axis.z * v.x + self.y_axis.z * v.y + self.z_axis.z * v.z,
        }
    }
}

impl Mul<float64> for Mat3 {
    fun mul(self, k: float64) -> Mat3 {
        return Mat3 { x_axis: self.x_axis * k, y_axis: self.y_axis * k, z_axis: self.z_axis * k }
    }
}

impl Mul<Mat3, Mat3> for float64 {
    fun mul(self, m: Mat3) -> Mat3 {
        return m * self
    }
}

impl Add for Mat3 {
    fun add(self, o: Mat3) -> Mat3 {
        return Mat3 { x_axis: self.x_axis + o.x_axis, y_axis: self.y_axis + o.y_axis, z_axis: self.z_axis + o.z_axis }
    }
}

impl Sub for Mat3 {
    fun sub(self, o: Mat3) -> Mat3 {
        return Mat3 { x_axis: self.x_axis - o.x_axis, y_axis: self.y_axis - o.y_axis, z_axis: self.z_axis - o.z_axis }
    }
}

impl Neg for Mat3 {
    fun neg(self) -> Mat3 {
        return Mat3 { x_axis: -self.x_axis, y_axis: -self.y_axis, z_axis: -self.z_axis }
    }
}

// `m[(row, col)]`.
impl Index<(int, int), float64> for Mat3 {
    fun index(self, rc: (int, int)) -> float64 {
        let (r, c) = rc
        return self.col(c)[r]
    }
}

impl IndexSet<(int, int), float64> for Mat3 {
    fun set_index(var self, rc: (int, int), v: float64) {
        let (r, c) = rc
        if c == 0 { self.x_axis[r] = v } else if c == 1 { self.y_axis[r] = v } else if c == 2 { self.z_axis[r] = v } else { panic(f"column {c} out of range for a Mat3") }
    }
}

// `m[i]`: the column `i`.
impl Index<int, Vec3> for Mat3 {
    fun index(self, i: int) -> Vec3 {
        return self.col(i)
    }
}

impl IndexSet<int, Vec3> for Mat3 {
    fun set_index(var self, i: int, v: Vec3) {
        if i == 0 { self.x_axis = v } else if i == 1 { self.y_axis = v } else if i == 2 { self.z_axis = v } else { panic(f"column {i} out of range for a Mat3") }
    }
}

impl Mat3 {
    fun col(self, i: int) -> Vec3 {
        if i == 0 { return self.x_axis }
        if i == 1 { return self.y_axis }
        if i == 2 { return self.z_axis }
        panic(f"column {i} out of range for a Mat3")
    }

    fun row(self, i: int) -> Vec3 {
        return vec3(self.x_axis[i], self.y_axis[i], self.z_axis[i])
    }

    fun transpose(self) -> Mat3 {
        return mat3(self.row(0), self.row(1), self.row(2))
    }

    fun trace(self) -> float64 {
        return self.x_axis.x + self.y_axis.y + self.z_axis.z
    }

    // The elements column by column, as a GPU takes them.
    fun to_list(self) -> [float64] {
        return [self.x_axis.x, self.x_axis.y, self.x_axis.z, self.y_axis.x, self.y_axis.y, self.y_axis.z, self.z_axis.x, self.z_axis.y, self.z_axis.z]
    }

    fun to_matrix(self) -> Matrix {
        return Matrix { rows: 3, cols: 3, data: self.to_list() }
    }

    fun to_f32(self) -> Mat3F32 {
        return Mat3F32 { x_axis: self.x_axis.to_f32(), y_axis: self.y_axis.to_f32(), z_axis: self.z_axis.to_f32() }
    }

    #test(Mat3 { x_axis: Vec3 { x: 2.0, y: 0.0, z: 0.0 }, y_axis: Vec3 { x: 0.0, y: 3.0, z: 0.0 }, z_axis: Vec3 { x: 1.0, y: 1.0, z: 4.0 } })[24.0]
    fun determinant(self) -> float64 {
        return self.z_axis.dot(self.x_axis.cross(self.y_axis))
    }

    fun inverse(self) -> Option<Mat3> {
        let t0 = self.y_axis.cross(self.z_axis)
        let t1 = self.z_axis.cross(self.x_axis)
        let t2 = self.x_axis.cross(self.y_axis)
        let d = self.z_axis.dot(t2)
        if d == 0.0 || !d.is_finite() { return None }
        return Some(mat3(t0, t1, t2).transpose() * (1.0 / d))
    }

    // As a Mat4, a 2D affine transform's 3D one: `w` the unit column.
    fun to_mat4(self) -> Mat4 {
        return mat4(self.x_axis.extend(0.0), self.y_axis.extend(0.0), self.z_axis.extend(0.0), vec4(0.0, 0.0, 0.0, 1.0))
    }

    // The 2D point `p` transformed by an affine Mat3 (translation included).
    fun transform_point2(self, p: Vec2) -> Vec2 {
        return (self * p.extend(1.0)).truncate()
    }

    // The 2D vector `v` transformed by an affine Mat3 (no translation).
    fun transform_vector2(self, v: Vec2) -> Vec2 {
        return (self * v.extend(0.0)).truncate()
    }
}

#derive(Eq, Hash)
pub struct Mat4 {
    x_axis: Vec4,
    y_axis: Vec4,
    z_axis: Vec4,
    w_axis: Vec4,
}

// A Mat4 of its columns.
pub fun mat4(c0: Vec4, c1: Vec4, c2: Vec4, c3: Vec4) -> Mat4 {
    return Mat4 { x_axis: c0, y_axis: c1, z_axis: c2, w_axis: c3 }
}

// A Mat4 of its rows.
pub fun mat4_from_rows(r0: Vec4, r1: Vec4, r2: Vec4, r3: Vec4) -> Mat4 {
    return mat4(r0, r1, r2, r3).transpose()
}

impl Identity for Mat4 {
    fun identity() -> Mat4 {
        return Mat4 { x_axis: vec4(1.0, 0.0, 0.0, 0.0), y_axis: vec4(0.0, 1.0, 0.0, 0.0), z_axis: vec4(0.0, 0.0, 1.0, 0.0), w_axis: vec4(0.0, 0.0, 0.0, 1.0) }
    }
}

impl Zero for Mat4 {
    fun zero() -> Mat4 {
        return Mat4 { x_axis: Vec4.zero(), y_axis: Vec4.zero(), z_axis: Vec4.zero(), w_axis: Vec4.zero() }
    }
}

impl Format for Mat4 {
    fun format(self, spec: str) -> str {
        return "[" + f"{self.row(0)}" + ", " + f"{self.row(1)}" + ", " + f"{self.row(2)}" + ", " + f"{self.row(3)}" + "]"
    }
}

// `a * b`: `b` first, then `a`, on a column vector.
impl Mul for Mat4 {
    fun mul(self, o: Mat4) -> Mat4 {
        return Mat4 { x_axis: self * o.x_axis, y_axis: self * o.y_axis, z_axis: self * o.z_axis, w_axis: self * o.w_axis }
    }
}

impl Mul<Vec4, Vec4> for Mat4 {
    fun mul(self, v: Vec4) -> Vec4 {
        return Vec4 {
            x: self.x_axis.x * v.x + self.y_axis.x * v.y + self.z_axis.x * v.z + self.w_axis.x * v.w,
            y: self.x_axis.y * v.x + self.y_axis.y * v.y + self.z_axis.y * v.z + self.w_axis.y * v.w,
            z: self.x_axis.z * v.x + self.y_axis.z * v.y + self.z_axis.z * v.z + self.w_axis.z * v.w,
            w: self.x_axis.w * v.x + self.y_axis.w * v.y + self.z_axis.w * v.z + self.w_axis.w * v.w,
        }
    }
}

impl Mul<float64> for Mat4 {
    fun mul(self, k: float64) -> Mat4 {
        return Mat4 { x_axis: self.x_axis * k, y_axis: self.y_axis * k, z_axis: self.z_axis * k, w_axis: self.w_axis * k }
    }
}

impl Mul<Mat4, Mat4> for float64 {
    fun mul(self, m: Mat4) -> Mat4 {
        return m * self
    }
}

impl Add for Mat4 {
    fun add(self, o: Mat4) -> Mat4 {
        return Mat4 { x_axis: self.x_axis + o.x_axis, y_axis: self.y_axis + o.y_axis, z_axis: self.z_axis + o.z_axis, w_axis: self.w_axis + o.w_axis }
    }
}

impl Sub for Mat4 {
    fun sub(self, o: Mat4) -> Mat4 {
        return Mat4 { x_axis: self.x_axis - o.x_axis, y_axis: self.y_axis - o.y_axis, z_axis: self.z_axis - o.z_axis, w_axis: self.w_axis - o.w_axis }
    }
}

impl Neg for Mat4 {
    fun neg(self) -> Mat4 {
        return Mat4 { x_axis: -self.x_axis, y_axis: -self.y_axis, z_axis: -self.z_axis, w_axis: -self.w_axis }
    }
}

// `m[(row, col)]`.
impl Index<(int, int), float64> for Mat4 {
    fun index(self, rc: (int, int)) -> float64 {
        let (r, c) = rc
        return self.col(c)[r]
    }
}

impl IndexSet<(int, int), float64> for Mat4 {
    fun set_index(var self, rc: (int, int), v: float64) {
        let (r, c) = rc
        if c == 0 { self.x_axis[r] = v } else if c == 1 { self.y_axis[r] = v } else if c == 2 { self.z_axis[r] = v } else if c == 3 { self.w_axis[r] = v } else { panic(f"column {c} out of range for a Mat4") }
    }
}

// `m[i]`: the column `i`.
impl Index<int, Vec4> for Mat4 {
    fun index(self, i: int) -> Vec4 {
        return self.col(i)
    }
}

impl IndexSet<int, Vec4> for Mat4 {
    fun set_index(var self, i: int, v: Vec4) {
        if i == 0 { self.x_axis = v } else if i == 1 { self.y_axis = v } else if i == 2 { self.z_axis = v } else if i == 3 { self.w_axis = v } else { panic(f"column {i} out of range for a Mat4") }
    }
}

impl Mat4 {
    fun col(self, i: int) -> Vec4 {
        if i == 0 { return self.x_axis }
        if i == 1 { return self.y_axis }
        if i == 2 { return self.z_axis }
        if i == 3 { return self.w_axis }
        panic(f"column {i} out of range for a Mat4")
    }

    fun row(self, i: int) -> Vec4 {
        return vec4(self.x_axis[i], self.y_axis[i], self.z_axis[i], self.w_axis[i])
    }

    fun transpose(self) -> Mat4 {
        return mat4(self.row(0), self.row(1), self.row(2), self.row(3))
    }

    fun trace(self) -> float64 {
        return self.x_axis.x + self.y_axis.y + self.z_axis.z + self.w_axis.w
    }

    // The elements column by column, as a GPU takes them.
    fun to_list(self) -> [float64] {
        return [self.x_axis.x, self.x_axis.y, self.x_axis.z, self.x_axis.w, self.y_axis.x, self.y_axis.y, self.y_axis.z, self.y_axis.w, self.z_axis.x, self.z_axis.y, self.z_axis.z, self.z_axis.w, self.w_axis.x, self.w_axis.y, self.w_axis.z, self.w_axis.w]
    }

    fun to_matrix(self) -> Matrix {
        return Matrix { rows: 4, cols: 4, data: self.to_list() }
    }

    fun to_f32(self) -> Mat4F32 {
        return Mat4F32 { x_axis: self.x_axis.to_f32(), y_axis: self.y_axis.to_f32(), z_axis: self.z_axis.to_f32(), w_axis: self.w_axis.to_f32() }
    }

    #test(Mat4 { x_axis: Vec4 { x: 2.0, y: 0.0, z: 0.0, w: 0.0 }, y_axis: Vec4 { x: 0.0, y: 3.0, z: 0.0, w: 0.0 }, z_axis: Vec4 { x: 0.0, y: 0.0, z: 4.0, w: 0.0 }, w_axis: Vec4 { x: 1.0, y: 2.0, z: 3.0, w: 1.0 } })[24.0]
    fun determinant(self) -> float64 {
        let a = self.x_axis
        let b = self.y_axis
        let c = self.z_axis
        let d = self.w_axis
        let s2323 = c.z * d.w - c.w * d.z
        let s1323 = c.y * d.w - c.w * d.y
        let s1223 = c.y * d.z - c.z * d.y
        let s0323 = c.x * d.w - c.w * d.x
        let s0223 = c.x * d.z - c.z * d.x
        let s0123 = c.x * d.y - c.y * d.x
        return a.x * (b.y * s2323 - b.z * s1323 + b.w * s1223) - a.y * (b.x * s2323 - b.z * s0323 + b.w * s0223) + a.z * (b.x * s1323 - b.y * s0323 + b.w * s0123) - a.w * (b.x * s1223 - b.y * s0223 + b.z * s0123)
    }

    // The inverse (by `Matrix`'s elimination with partial pivoting); None for
    // a matrix with no inverse.
    fun inverse(self) -> Option<Mat4> {
        return match self.to_matrix().inverse() {
            Some(m) => Some(mat4(vec4(m.data[0], m.data[1], m.data[2], m.data[3]), vec4(m.data[4], m.data[5], m.data[6], m.data[7]), vec4(m.data[8], m.data[9], m.data[10], m.data[11]), vec4(m.data[12], m.data[13], m.data[14], m.data[15]))),
            None => None,
        }
    }

    // The upper-left 3x3 part: the rotation and scale of an affine transform.
    fun upper_left(self) -> Mat3 {
        return mat3(self.x_axis.truncate(), self.y_axis.truncate(), self.z_axis.truncate())
    }

    // The point `p` transformed by an affine Mat4 (translation included, no
    // perspective divide).
    fun transform_point3(self, p: Vec3) -> Vec3 {
        return (self * p.extend(1.0)).truncate()
    }

    // The vector `v` transformed (no translation).
    fun transform_vector3(self, v: Vec3) -> Vec3 {
        return (self * v.extend(0.0)).truncate()
    }

    // The point `p` transformed and divided by its `w`: a projection's.
    fun project_point3(self, p: Vec3) -> Vec3 {
        let r = self * p.extend(1.0)
        return r.truncate() / r.w
    }
}

// --- transforms (column vectors, right-handed) ------------------------------

// A Mat2 rotating by `angle` radians, counterclockwise.
pub fun rotation2(angle: float64) -> Mat2 {
    let c = angle.cos()
    let s = angle.sin()
    return mat2(vec2(c, s), vec2(-s, c))
}

// The affine Mat3 moving a 2D point by `v`.
pub fun translation2d(v: Vec2) -> Mat3 {
    return mat3(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(v.x, v.y, 1.0))
}

// The affine Mat3 rotating a 2D point by `angle` radians, counterclockwise.
pub fun rotation2d(angle: float64) -> Mat3 {
    let c = angle.cos()
    let s = angle.sin()
    return mat3(vec3(c, s, 0.0), vec3(-s, c, 0.0), vec3(0.0, 0.0, 1.0))
}

pub fun scaling2d(v: Vec2) -> Mat3 {
    return mat3(vec3(v.x, 0.0, 0.0), vec3(0.0, v.y, 0.0), vec3(0.0, 0.0, 1.0))
}

// The Mat4 moving a point by `v`.
pub fun translation(v: Vec3) -> Mat4 {
    return mat4(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(v.x, v.y, v.z, 1.0))
}

pub fun scaling(v: Vec3) -> Mat4 {
    return mat4(vec4(v.x, 0.0, 0.0, 0.0), vec4(0.0, v.y, 0.0, 0.0), vec4(0.0, 0.0, v.z, 0.0), vec4(0.0, 0.0, 0.0, 1.0))
}

// Rotations by `angle` radians about an axis, counterclockwise looking at
// the origin from the axis' positive side.
pub fun rotation_x(angle: float64) -> Mat4 {
    let c = angle.cos()
    let s = angle.sin()
    return mat4(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, c, s, 0.0), vec4(0.0, -s, c, 0.0), vec4(0.0, 0.0, 0.0, 1.0))
}

pub fun rotation_y(angle: float64) -> Mat4 {
    let c = angle.cos()
    let s = angle.sin()
    return mat4(vec4(c, 0.0, -s, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(s, 0.0, c, 0.0), vec4(0.0, 0.0, 0.0, 1.0))
}

pub fun rotation_z(angle: float64) -> Mat4 {
    let c = angle.cos()
    let s = angle.sin()
    return mat4(vec4(c, s, 0.0, 0.0), vec4(-s, c, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0))
}

// The rotation by `angle` radians about `axis` (normalized here).
pub fun rotation_axis(axis: Vec3, angle: float64) -> Mat4 {
    let a = axis.normalized()
    let c = angle.cos()
    let s = angle.sin()
    let t = 1.0 - c
    return mat4(
        vec4(t * a.x * a.x + c, t * a.x * a.y + s * a.z, t * a.x * a.z - s * a.y, 0.0),
        vec4(t * a.x * a.y - s * a.z, t * a.y * a.y + c, t * a.y * a.z + s * a.x, 0.0),
        vec4(t * a.x * a.z + s * a.y, t * a.y * a.z - s * a.x, t * a.z * a.z + c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0))
}

// The view matrix of a camera at `eye` looking at `center`, `up` its up:
// right-handed, the camera looking down its -z.
pub fun look_at_rh(eye: Vec3, center: Vec3, up: Vec3) -> Mat4 {
    let f = (center - eye).normalized()
    let s = f.cross(up).normalized()
    let u = s.cross(f)
    return mat4(vec4(s.x, u.x, -f.x, 0.0), vec4(s.y, u.y, -f.y, 0.0), vec4(s.z, u.z, -f.z, 0.0), vec4(-s.dot(eye), -u.dot(eye), f.dot(eye), 1.0))
}

// A right-handed perspective projection, `fov_y` radians high, depth to
// OpenGL's -1..1.
pub fun perspective_rh_gl(fov_y: float64, aspect: float64, near: float64, far: float64) -> Mat4 {
    let f = 1.0 / (fov_y * 0.5).tan()
    let r = 1.0 / (near - far)
    return mat4(vec4(f / aspect, 0.0, 0.0, 0.0), vec4(0.0, f, 0.0, 0.0), vec4(0.0, 0.0, (far + near) * r, -1.0), vec4(0.0, 0.0, 2.0 * far * near * r, 0.0))
}

// A right-handed perspective projection, depth to 0..1 (Vulkan, Metal,
// Direct3D, WebGPU).
pub fun perspective_rh(fov_y: float64, aspect: float64, near: float64, far: float64) -> Mat4 {
    let f = 1.0 / (fov_y * 0.5).tan()
    let r = far / (near - far)
    return mat4(vec4(f / aspect, 0.0, 0.0, 0.0), vec4(0.0, f, 0.0, 0.0), vec4(0.0, 0.0, r, -1.0), vec4(0.0, 0.0, near * r, 0.0))
}

// A right-handed orthographic projection of the box `left`..`right`,
// `bottom`..`top`, `near`..`far`, depth to OpenGL's -1..1.
pub fun orthographic_rh_gl(left: float64, right: float64, bottom: float64, top: float64, near: float64, far: float64) -> Mat4 {
    let w = 1.0 / (right - left)
    let h = 1.0 / (top - bottom)
    let d = 1.0 / (far - near)
    return mat4(vec4(2.0 * w, 0.0, 0.0, 0.0), vec4(0.0, 2.0 * h, 0.0, 0.0), vec4(0.0, 0.0, -2.0 * d, 0.0), vec4(-(right + left) * w, -(top + bottom) * h, -(far + near) * d, 1.0))
}

// The same, depth to 0..1.
pub fun orthographic_rh(left: float64, right: float64, bottom: float64, top: float64, near: float64, far: float64) -> Mat4 {
    let w = 1.0 / (right - left)
    let h = 1.0 / (top - bottom)
    let d = 1.0 / (near - far)
    return mat4(vec4(2.0 * w, 0.0, 0.0, 0.0), vec4(0.0, 2.0 * h, 0.0, 0.0), vec4(0.0, 0.0, d, 0.0), vec4(-(right + left) * w, -(top + bottom) * h, near * d, 1.0))
}

// --- Matrix: any shape ------------------------------------------------------

// A `rows` x `cols` matrix, its elements column by column in `data`. Its
// operators check the shapes: `matrix shapes don't fit: 2x3 * 2x3`.
#derive(Eq, Hash)
pub struct Matrix {
    rows: int,
    cols: int,
    data: [float64],
}

// The matrix of `data`, column by column.
pub fun matrix(rows: int, cols: int, data: [float64]) -> Matrix {
    if rows < 0 || cols < 0 || data.len() != rows * cols { panic(f"a {rows}x{cols} matrix takes {rows * cols} elements, got {data.len()}") }
    return Matrix { rows: rows, cols: cols, data: data }
}

// The matrix of `rows`, each a list of one length.
#test([[1.0, 2.0], [3.0, 4.0]])[Matrix { rows: 2, cols: 2, data: [1.0, 3.0, 2.0, 4.0] }]
pub fun from_rows(rows: [[float64]]) -> Matrix {
    let r = rows.len()
    let c = if r == 0 { 0 } else { rows[0].len() }
    var data: [float64] = []
    var j = 0
    while j < c {
        for row in rows {
            if row.len() != c { panic(f"the rows of a matrix differ in length: {c} and {row.len()}") }
            data.push(row[j])
        }
        j += 1
    }
    return Matrix { rows: r, cols: c, data: data }
}

pub fun zero_matrix(rows: int, cols: int) -> Matrix {
    var data: [float64] = []
    var i = 0
    while i < rows * cols {
        data.push(0.0)
        i += 1
    }
    return matrix(rows, cols, data)
}

// The `n` x `n` identity.
pub fun identity(n: int) -> Matrix {
    var m = zero_matrix(n, n)
    var i = 0
    while i < n {
        m.data[i * n + i] = 1.0
        i += 1
    }
    return m
}

fun same_shape(a: Matrix, b: Matrix) {
    if a.rows != b.rows || a.cols != b.cols { panic(f"matrix shapes differ: {a.rows}x{a.cols} and {b.rows}x{b.cols}") }
}

impl Format for Matrix {
    fun format(self, spec: str) -> str {
        var sb = StringBuilder()
        sb.append("[")
        var i = 0
        while i < self.rows {
            if i > 0 { sb.append(", ") }
            sb.append(f"{self.row(i)}")
            i += 1
        }
        sb.append("]")
        return sb.build()
    }
}

impl Index<(int, int), float64> for Matrix {
    fun index(self, rc: (int, int)) -> float64 {
        let (r, c) = rc
        if r < 0 || r >= self.rows || c < 0 || c >= self.cols { panic(f"index ({r}, {c}) out of range for a {self.rows}x{self.cols} matrix") }
        return self.data[c * self.rows + r]
    }
}

impl IndexSet<(int, int), float64> for Matrix {
    fun set_index(var self, rc: (int, int), v: float64) {
        let (r, c) = rc
        if r < 0 || r >= self.rows || c < 0 || c >= self.cols { panic(f"index ({r}, {c}) out of range for a {self.rows}x{self.cols} matrix") }
        self.data[c * self.rows + r] = v
    }
}

impl Mul for Matrix {
    fun mul(self, o: Matrix) -> Matrix {
        if self.cols != o.rows { panic(f"matrix shapes don't fit: {self.rows}x{self.cols} * {o.rows}x{o.cols}") }
        var data: [float64] = []
        var j = 0
        while j < o.cols {
            var i = 0
            while i < self.rows {
                var acc: float64 = 0.0
                var k = 0
                while k < self.cols {
                    acc += self.data[k * self.rows + i] * o.data[j * o.rows + k]
                    k += 1
                }
                data.push(acc)
                i += 1
            }
            j += 1
        }
        return Matrix { rows: self.rows, cols: o.cols, data: data }
    }
}

impl Mul<Vector, Vector> for Matrix {
    fun mul(self, v: Vector) -> Vector {
        if self.cols != v.data.len() { panic(f"matrix shapes don't fit: {self.rows}x{self.cols} * a vector of {v.data.len()}") }
        var data: [float64] = []
        var i = 0
        while i < self.rows {
            var acc: float64 = 0.0
            var k = 0
            while k < self.cols {
                acc += self.data[k * self.rows + i] * v.data[k]
                k += 1
            }
            data.push(acc)
            i += 1
        }
        return Vector { data: data }
    }
}

impl Mul<float64> for Matrix {
    fun mul(self, k: float64) -> Matrix {
        var data: [float64] = []
        for x in self.data { data.push(x * k) }
        return Matrix { rows: self.rows, cols: self.cols, data: data }
    }
}

impl Mul<Matrix, Matrix> for float64 {
    fun mul(self, m: Matrix) -> Matrix {
        return m * self
    }
}

impl Add for Matrix {
    fun add(self, o: Matrix) -> Matrix {
        same_shape(self, o)
        var data: [float64] = []
        var i = 0
        while i < self.data.len() {
            data.push(self.data[i] + o.data[i])
            i += 1
        }
        return Matrix { rows: self.rows, cols: self.cols, data: data }
    }
}

impl Sub for Matrix {
    fun sub(self, o: Matrix) -> Matrix {
        return self + o * -1.0
    }
}

impl Neg for Matrix {
    fun neg(self) -> Matrix {
        return self * -1.0
    }
}

impl Matrix {
    fun row(self, i: int) -> Vector {
        var d: [float64] = []
        var j = 0
        while j < self.cols {
            d.push(self.data[j * self.rows + i])
            j += 1
        }
        return Vector { data: d }
    }

    fun col(self, j: int) -> Vector {
        return Vector { data: self.data[j * self.rows:(j + 1) * self.rows] }
    }

    fun transpose(self) -> Matrix {
        var data: [float64] = []
        var i = 0
        while i < self.rows {
            var j = 0
            while j < self.cols {
                data.push(self.data[j * self.rows + i])
                j += 1
            }
            i += 1
        }
        return Matrix { rows: self.cols, cols: self.rows, data: data }
    }

    // The determinant of a square matrix, by elimination with partial
    // pivoting.
    #test(Matrix { rows: 2, cols: 2, data: [4.0, 2.0, 2.0, 3.0] })[8.0]
    fun determinant(self) -> float64 {
        if self.rows != self.cols { panic(f"a {self.rows}x{self.cols} matrix has no determinant") }
        let n = self.rows
        var a = self.transpose().data
        var det: float64 = 1.0
        var col = 0
        while col < n {
            var piv = col
            var r = col + 1
            while r < n {
                if a[r * n + col].abs() > a[piv * n + col].abs() { piv = r }
                r += 1
            }
            if a[piv * n + col] == 0.0 { return 0.0 }
            if piv != col {
                var k = 0
                while k < n {
                    let t = a[col * n + k]
                    a[col * n + k] = a[piv * n + k]
                    a[piv * n + k] = t
                    k += 1
                }
                det = -det
            }
            let p = a[col * n + col]
            det *= p
            r = col + 1
            while r < n {
                let f = a[r * n + col] / p
                var k = col
                while k < n {
                    a[r * n + k] -= f * a[col * n + k]
                    k += 1
                }
                r += 1
            }
            col += 1
        }
        return det
    }

    // The inverse of a square matrix, by Gauss-Jordan elimination with
    // partial pivoting; None when it has none.
    fun inverse(self) -> Option<Matrix> {
        if self.rows != self.cols { panic(f"a {self.rows}x{self.cols} matrix has no inverse") }
        let n = self.rows
        // the rows of [self | identity], 2n wide
        var a: [float64] = []
        var i = 0
        while i < n {
            var j = 0
            while j < n {
                a.push(self.data[j * n + i])
                j += 1
            }
            j = 0
            while j < n {
                a.push(if i == j { 1.0 } else { 0.0 })
                j += 1
            }
            i += 1
        }
        let w = 2 * n
        var col = 0
        while col < n {
            var piv = col
            var r = col + 1
            while r < n {
                if a[r * w + col].abs() > a[piv * w + col].abs() { piv = r }
                r += 1
            }
            if a[piv * w + col] == 0.0 || !a[piv * w + col].is_finite() { return None }
            if piv != col {
                var k = 0
                while k < w {
                    let t = a[col * w + k]
                    a[col * w + k] = a[piv * w + k]
                    a[piv * w + k] = t
                    k += 1
                }
            }
            let p = a[col * w + col]
            var k = 0
            while k < w {
                a[col * w + k] /= p
                k += 1
            }
            r = 0
            while r < n {
                if r != col {
                    let f = a[r * w + col]
                    if f != 0.0 {
                        k = 0
                        while k < w {
                            a[r * w + k] -= f * a[col * w + k]
                            k += 1
                        }
                    }
                }
                r += 1
            }
            col += 1
        }
        var data: [float64] = []
        var j = 0
        while j < n {
            i = 0
            while i < n {
                data.push(a[i * w + n + j])
                i += 1
            }
            j += 1
        }
        return Some(Matrix { rows: n, cols: n, data: data })
    }

    fun to_list(self) -> [float64] {
        return self.data
    }

    fun to_f32(self) -> MatrixF32 {
        var d: [float32] = []
        for x in self.data { d.push(x as float32) }
        return MatrixF32 { rows: self.rows, cols: self.cols, data: d }
    }
}
