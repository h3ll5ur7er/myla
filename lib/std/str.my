// std.str: methods on str (MYLA-321, D164).
//
// Strings are bytes: positions and lengths count bytes, the
// whitespace of `trim` and `words` and the case of `to_upper` and
// `to_lower` are ASCII, and every other byte is left as it is.

impl str {
    // The first position of `needle`; an empty one is found at 0.
    #test("hello", "l")[Some(2)]
    #test("hello", "lo")[Some(3)]
    #test("hello", "hello")[Some(0)]
    #test("hello", "x")[None]
    #test("hello", "hello!")[None] // needle longer than the text
    #test("hello", "")[Some(0)]
    #test("", "")[Some(0)]
    #test("aaab", "aab")[Some(1)] // a partial match before the match
    #test("größe", "ße")[Some(4)] // byte positions
    fun find(self, needle: str) -> Option<int> {
        return self.find_from(needle, 0)
    }

    // The last position of `needle`; an empty one is found at the end.
    // Linear in the length of the text, as `find_from` is.
    #test("hello", "l")[Some(3)]
    #test("abcabc", "abc")[Some(3)]
    #test("hello", "x")[None]
    #test("hello", "")[Some(5)]
    #test("ab", "abc")[None]
    fun rfind(self, needle: str) -> Option<int> {
        let m = needle.len()
        var i = self.len() - m
        if m == 0 {
            return Some(i)
        }
        let first = needle[0]
        let top = i
        var work: int64 = 0
        while i >= 0 {
            if self[i] == first {
                let j = matched(self, needle, i)
                if j == m {
                    return Some(i)
                }
                work += j as int64
                if work > SCAN_BUDGET + 4 * ((top - i) as int64) {
                    return last_two_way(self, needle, i)
                }
            }
            i -= 1
        }
        return None
    }

    // The first position of `needle` at or after `start`. A plain scan,
    // which is fastest for the needles text has; one that spends more than
    // a few comparisons a byte on partial matches goes on with the two-way
    // search (M25), so the time is linear in the length of the text.
    #test("abcabc", "abc", 1)[Some(3)]
    #test("abcabc", "abc", 3)[Some(3)]
    #test("abcabc", "abc", 4)[None]
    #test("abc", "a", -5)[Some(0)] // a negative start counts as 0
    #test("abc", "", 3)[Some(3)]
    #test("abc", "", 4)[None] // past the end
    fun find_from(self, needle: str, start: int) -> Option<int> {
        let n = self.len()
        let m = needle.len()
        var i = if start < 0 { 0 } else { start }
        if m == 0 {
            return if i <= n { Some(i) } else { None }
        }
        let first = needle[0]
        if m == 1 {
            while i < n {
                if self[i] == first { return Some(i) }
                i += 1
            }
            return None
        }
        let last = n - m
        let begin = i
        var work: int64 = 0
        while i <= last {
            if self[i] == first {
                let j = matched(self, needle, i)
                if j == m {
                    return Some(i)
                }
                work += j as int64
                if work > SCAN_BUDGET + 4 * ((i - begin) as int64) {
                    return two_way(self, needle, i)
                }
            }
            i += 1
        }
        return None
    }

    #test("hello", "ell")[true]
    #test("hello", "elk")[false]
    #test("hello", "")[true]
    fun contains(self, needle: str) -> bool {
        return match self.find_from(needle, 0) {
            Some(_) => true
            None => false
        }
    }

    #test("hello", "he")[true]
    #test("hello", "lo")[false]
    #test("he", "hello")[false]
    #test("hello", "")[true]
    fun starts_with(self, prefix: str) -> bool {
        return prefix.len() <= self.len() && at(self, prefix, 0)
    }

    #test("hello", "lo")[true]
    #test("hello", "he")[false]
    #test("lo", "hello")[false]
    #test("hello", "")[true]
    fun ends_with(self, suffix: str) -> bool {
        let i = self.len() - suffix.len()
        return i >= 0 && at(self, suffix, i)
    }

    // The number of matches of `needle` that don't overlap. An empty
    // one matches before every character and at the end.
    #test("banana", "a")[3]
    #test("banana", "ana")[1] // matches don't overlap
    #test("aaaa", "aa")[2]
    #test("banana", "x")[0]
    #test("abc", "")[4] // the places replace("", …) inserts at
    #test("äb", "")[3]
    fun count(self, needle: str) -> int {
        let m = needle.len()
        if m == 0 {
            return char_count(self) + 1
        }
        var k = 0
        var i = 0
        while let Some(j) = self.find_from(needle, i) {
            k += 1
            i = j + m
        }
        return k
    }

    // The pieces between the matches of `sep`, one more than there are
    // matches. An empty separator splits into characters, as `chars()`
    // does, but as strings.
    #test("a,b,c", ",")[["a", "b", "c"]]
    #test("a,,b,", ",")[["a", "", "b", ""]]
    #test("abc", ",")[["abc"]]
    #test("", ",")[[""]]
    #test("a::b::c", "::")[["a", "b", "c"]]
    #test("aé", "")[["a", "é"]] // an empty separator splits into characters
    #test("", "")[[]]
    fun split(self, sep: str) -> [str] {
        return self.splitn(sep, self.len() + 1)
    }

    // At most `n` pieces, the last one holding the rest of the text.
    #test("a,b,c", ",", 2)[["a", "b,c"]]
    #test("a,b,c", ",", 1)[["a,b,c"]]
    #test("a,b,c", ",", 5)[["a", "b", "c"]]
    #test("a,b,c", ",", 0)[[]]
    #test("key = value = x", " = ", 2)[["key", "value = x"]]
    #test("abc", "", 2)[["a", "bc"]]
    fun splitn(self, sep: str, n: int) -> [str] {
        var out: [str] = []
        if n <= 0 {
            return out
        }
        if sep.len() == 0 {
            var start = 0
            var i = 1
            while i <= self.len() && out.len() < n - 1 {
                if i == self.len() || !is_cont(self[i]) {
                    out.push(part(self, start, i))
                    start = i
                }
                i += 1
            }
            if start < self.len() {
                out.push(part(self, start, self.len()))
            }
            return out
        }
        var start = 0
        while out.len() < n - 1 {
            match self.find_from(sep, start) {
                Some(j) => {
                    out.push(part(self, start, j))
                    start = j + sep.len()
                }
                None => { break }
            }
        }
        out.push(part(self, start, self.len()))
        return out
    }

    // The runs of text between ASCII whitespace.
    #test("  one two\tthree\n")[["one", "two", "three"]]
    #test("one")[["one"]]
    #test(" \t\r\n ")[[]]
    #test("")[[]]
    #test("a\u{0b}b\u{0c}c")[["a", "b", "c"]] // vertical tab and form feed
    fun words(self) -> [str] {
        var out: [str] = []
        let n = self.len()
        var i = 0
        while i < n {
            while i < n && is_space(self[i]) {
                i += 1
            }
            let start = i
            while i < n && !is_space(self[i]) {
                i += 1
            }
            if i > start {
                out.push(part(self, start, i))
            }
        }
        return out
    }

    // The lines, without their `\n` or `\r\n`. A final line ending
    // gives no empty last line.
    #test("a\nb\nc")[["a", "b", "c"]]
    #test("a\nb\n")[["a", "b"]] // a final newline gives no empty line
    #test("a\r\nb\r\n")[["a", "b"]]
    #test("a\n\nb")[["a", "", "b"]]
    #test("\n")[[""]]
    #test("")[[]]
    #test("a\rb\r")[["a\rb\r"]] // a lone \r doesn't end a line
    fun lines(self) -> [str] {
        var out: [str] = []
        let n = self.len()
        var start = 0
        while start < n {
            var end = n
            var next = n
            match self.find_from("\n", start) {
                Some(j) => {
                    end = if j > start && self[j - 1] == '\r' { j - 1 } else { j }
                    next = j + 1
                }
                None => {}
            }
            out.push(part(self, start, end))
            start = next
        }
        return out
    }

    // Without ASCII whitespace at either end.
    #test("  hi there \n")["hi there"]
    #test("hi")["hi"]
    #test(" \t ")[""]
    #test("")[""]
    fun trim(self) -> str {
        return part(self, space_end(self), space_start(self))
    }

    #test("  hi  ")["hi  "]
    #test("\n\thi")["hi"]
    fun trim_start(self) -> str {
        return part(self, space_end(self), self.len())
    }

    #test("  hi  ")["  hi"]
    #test("hi\r\n")["hi"]
    #test("   ")[""] // whitespace only (M16)
    #test("\r\n")[""]
    #test("")[""]
    fun trim_end(self) -> str {
        return part(self, 0, space_before(self, self.len(), 0))
    }

    // The rest after `prefix`, if the text starts with it.
    #test("v1.2", "v")[Some("1.2")]
    #test("v1.2", "x")[None]
    #test("v1.2", "")[Some("v1.2")]
    #test("v", "v1.2")[None]
    fun strip_prefix(self, prefix: str) -> Option<str> {
        if self.starts_with(prefix) {
            return Some(part(self, prefix.len(), self.len()))
        }
        return None
    }

    // The text before `suffix`, if it ends with it.
    #test("main.my", ".my")[Some("main")]
    #test("main.my", ".rs")[None]
    #test("ab", "ab")[Some("")]
    fun strip_suffix(self, suffix: str) -> Option<str> {
        if self.ends_with(suffix) {
            return Some(part(self, 0, self.len() - suffix.len()))
        }
        return None
    }

    // With the ASCII letters a to z made capitals.
    #test("Hello, World 42")["HELLO, WORLD 42"]
    #test("größe")["GRößE"] // only ASCII letters change
    #test("")[""]
    fun to_upper(self) -> str {
        return shift_case(self, 'a', 'z')
    }

    // With the ASCII letters A to Z made small.
    #test("Hello, World 42")["hello, world 42"]
    #test("ÄBC")["Äbc"]
    fun to_lower(self) -> str {
        return shift_case(self, 'A', 'Z')
    }

    // The bytes of the text, in one copy (D180): what a stream's `write`
    // takes, `w.write(line.bytes())`.
    #test("hé")[[104u8, 195u8, 169u8]]
    #test("")[[]]
    fun bytes(self) -> [uint8] {
        return __str_to_bytes(self)
    }

    // The text `n` times; none for `n <= 0`. More than a str holds
    // (2,147,483,647 bytes) is a runtime error.
    #test("ab", 3)["ababab"]
    #test("ab", 1)["ab"]
    #test("ab", 17)["ababababababababababababababababab"] // in bulk: 16 + 1
    #test("é", 33)["ééééééééééééééééééééééééééééééééé"] // 32 + 1
    #test("ab", 0)[""]
    #test("ab", -2)[""]
    #test("", 5)[""]
    #test("", 2147483647)[""]
    #test("ab", 1073741824)[panic("std.str.repeat: n = 1073741824 copies of 2 bytes are more than a str holds")]
    fun repeat(self, n: int) -> str {
        if n <= 0 || self.len() == 0 {
            return ""
        }
        if (n as int64) * (self.len() as int64) > 2147483647 {
            panic(f"std.str.repeat: n = {n} copies of {self.len()} bytes are more than a str holds")
        }
        var sb = StringBuilder(n * self.len())
        if n <= 16 {
            var i = 0
            while i < n {
                sb.append(self)
                i += 1
            }
            return sb.build()
        }
        // In bulk: the text doubled into a run of `c` copies, up to 4,096
        // bytes, appended whole, so a million copies of a byte are 245
        // appends, not a million (2.6 s interpreted, MYLA-546), and need
        // 4 KB past the result
        var run = self
        var c = 1
        while c <= n / 2 && run.len() <= 2048 {
            run = run + run
            c *= 2
        }
        var k = n
        while k >= c {
            sb.append(run)
            k -= c
        }
        sb.append(run, 0, k * self.len())
        return sb.build()
    }

    // At least `width` characters, with `fill` added in front. The width
    // counts characters, as a format spec's does.
    #test("7", 3, '0')["007"]
    #test("42", 5, ' ')["   42"]
    #test("hello", 3, ' ')["hello"] // never cut
    #test("é", 3, '·')["··é"] // the width counts characters
    #test("ab", -2147483648, ' ')["ab"] // any width (D184)
    #test("ab", 2147483647, 'é')[panic("std.str.pad_start: width = 2147483647 makes more than a str holds")]
    fun pad_start(self, width: int, fill: char) -> str {
        return padding(self, width, fill, "pad_start") + self
    }

    // At least `width` characters, with `fill` added behind.
    #test("7", 3, '0')["700"]
    #test("ab", 4, '.')["ab.."]
    #test("hello", 3, ' ')["hello"]
    #test("é", 2, '-')["é-"]
    #test("ab", -2147483648, ' ')["ab"]
    fun pad_end(self, width: int, fill: char) -> str {
        return self + padding(self, width, fill, "pad_end")
    }

    // Every match of `old` replaced by `new`. An empty `old` matches
    // before every character and at the end.
    #test("a-b-c", "-", "+")["a+b+c"]
    #test("aaaa", "aa", "b")["bb"]
    #test("hello", "l", "")["heo"]
    #test("hello", "x", "y")["hello"]
    #test("abc", "", "-")["-a-b-c-"] // an empty pattern: around every character
    #test("", "", "-")["-"]
    #test("aé", "", "|")["|a|é|"]
    fun replace(self, old: str, new: str) -> str {
        return self.replacen(old, new, self.len() + 1)
    }

    // The first `n` matches of `old` replaced by `new`.
    #test("a-b-c", "-", "+", 1)["a+b-c"]
    #test("a-b-c", "-", "+", 5)["a+b+c"]
    #test("a-b-c", "-", "+", 0)["a-b-c"]
    #test("abc", "", "-", 2)["-a-bc"]
    fun replacen(self, old: str, new: str, n: int) -> str {
        if n <= 0 {
            return self
        }
        var sb = StringBuilder()
        var done = 0
        if old.len() == 0 {
            var i = 0
            while i <= self.len() {
                if i == self.len() || !is_cont(self[i]) {
                    if done < n {
                        sb.append(new)
                        done += 1
                    }
                }
                if i < self.len() {
                    sb.append_byte(self[i])
                }
                i += 1
            }
            return sb.build()
        }
        var start = 0
        while done < n {
            match self.find_from(old, start) {
                Some(j) => {
                    sb.append(self, start, j)
                    sb.append(new)
                    start = j + old.len()
                    done += 1
                }
                None => { break }
            }
        }
        if done == 0 {
            return self
        }
        sb.append(self, start, self.len())
        return sb.build()
    }
}

// The `fill`s that make `s` `width` characters long, none if it is as
// long; more than a str holds is a runtime error naming `width` and the
// method `name` (D184).
#test("ab", 4, '.', "pad_end")[".."]
#test("abc", 2, '.', "pad_end")[""]
fun padding(s: str, width: int, fill: char, name: str) -> str {
    let have = char_count(s)
    if width <= have {
        return ""
    }
    let one = f"{fill}"
    let k = width - have
    if (k as int64) * (one.len() as int64) + (s.len() as int64) > 2147483647 {
        panic(f"std.str.{name}: width = {width} makes more than a str holds")
    }
    return one.repeat(k)
}

// Whether `needle` is in `s` at byte `i` (which must leave room for it).
#test("hello", "ll", 2)[true]
#test("hello", "ll", 1)[false]
#test("hello", "", 5)[true]
fun at(s: str, needle: str, i: int) -> bool {
    var j = 0
    let m = needle.len()
    while j < m {
        if s[i + j] != needle[j] {
            return false
        }
        j += 1
    }
    return true
}

// How many comparisons a plain search may spend on partial matches, past
// four a byte of the text it scanned, before it takes the two-way search
// instead: a needle of text never comes near it, one like "aaab" in
// "aaaa…" soon does.
const SCAN_BUDGET: int64 = 256

// How many bytes of `needle` are in `s` at byte `i`, from the first on
// (which must leave room for it).
#test("hello", "ll", 2)[2]
#test("hello", "lx", 2)[1]
#test("hello", "x", 0)[0]
fun matched(s: str, needle: str, i: int) -> int {
    var j = 0
    let m = needle.len()
    while j < m && s[i + j] == needle[j] {
        j += 1
    }
    return j
}

// The two-way string search of Crochemore and Perrin (1991), as musl's
// `strstr` has it without its table of bytes, from byte `start` of `s` on:
// time linear in the length of the text whatever the needle (not empty),
// in constant room. The needle is cut into a left and a right half at its
// critical factorization; the right half is compared first, from the
// left, then the left half from the right; a mismatch in the right half
// moves on by as many bytes as matched, one in the left half by the
// needle's period. For a periodic needle, `mem` remembers how much of the
// left half the move by the period leaves matched.
#test("aaaaaaaaaab", "aab", 0)[Some(8)]
#test("abcabcabd", "abcabd", 0)[Some(3)]
#test("abababab", "abab", 1)[Some(2)]
#test("xyz", "xyzw", 0)[None]
fun two_way(s: str, needle: str, start: int) -> Option<int> {
    let n = s.len()
    let m = needle.len()
    let (ms1, per1) = max_suffix(needle, false)
    let (ms2, per2) = max_suffix(needle, true)
    var ms = ms1
    var per = per1
    if ms2 > ms1 {
        ms = ms2
        per = per2
    }
    // periodic: the left half comes again a period later
    var periodic = true
    var t = 0
    while t <= ms && periodic {
        periodic = needle[t] == needle[per + t]
        t += 1
    }
    var mem0 = 0
    if periodic {
        mem0 = m - per
    } else {
        per = if ms > m - ms - 1 { ms + 1 } else { m - ms }
    }
    var mem = 0
    var h = start
    while h <= n - m {
        // the right half, from the left
        var k = if ms + 1 > mem { ms + 1 } else { mem }
        while k < m && needle[k] == s[h + k] {
            k += 1
        }
        if k < m {
            h += k - ms
            mem = 0
            continue
        }
        // the left half, from the right
        k = ms + 1
        while k > mem && needle[k - 1] == s[h + k - 1] {
            k -= 1
        }
        if k <= mem {
            return Some(h)
        }
        h += per
        mem = mem0
    }
    return None
}

// The maximal suffix of `p` (not empty) in byte order, or in the opposite
// order with `reversed`: the position before it (-1 for all of `p`) and
// its period.
#test("abcab", false)[(1, 3)]
#test("aab", false)[(1, 1)]
#test("aab", true)[(-1, 3)]
#test("aaa", false)[(-1, 1)]
fun max_suffix(p: str, reversed: bool) -> (int, int) {
    let m = p.len()
    var ip = -1
    var jp = 0
    var k = 1
    var per = 1
    while jp + k < m {
        let a = p[ip + k]
        let b = p[jp + k]
        if a == b {
            if k == per {
                jp += per
                k = 1
            } else {
                k += 1
            }
        } else if (a > b) != reversed {
            jp += k
            k = 1
            per = jp - ip
        } else {
            ip = jp
            jp += 1
            k = 1
            per = 1
        }
    }
    return (ip, per)
}

// The last position of `needle` (not empty) in `s` at or before byte `i`:
// `two_way` over both reversed.
#test("aabaab", "aab", 3)[Some(3)]
#test("aabaab", "aab", 2)[Some(0)]
#test("abc", "x", 2)[None]
fun last_two_way(s: str, needle: str, i: int) -> Option<int> {
    let end = i + needle.len()
    return match two_way(reversed_bytes(s, end), reversed_bytes(needle, needle.len()), 0) {
        Some(r) => Some(end - needle.len() - r)
        None => None
    }
}

// The first `end` bytes of `s`, last first.
#test("abc", 3)["cba"]
#test("abc", 2)["ba"]
fun reversed_bytes(s: str, end: int) -> str {
    var sb = StringBuilder(end)
    var i = end
    while i > 0 {
        i -= 1
        sb.append_byte(s[i])
    }
    return sb.build()
}

// The bytes of `s` from `start` up to `end`: any bytes, even part of a
// character, where a slice `s[start:end]` would stop.
#test("hello", 1, 3)["el"]
#test("hello", 0, 5)["hello"]
#test("hello", 2, 2)[""]
fun part(s: str, start: int, end: int) -> str {
    if start == 0 && end == s.len() {
        return s
    }
    var sb = StringBuilder()
    sb.append(s, start, end)
    return sb.build()
}

// A UTF-8 continuation byte, 10xxxxxx: not the start of a character.
#test(0x80)[true]
#test(0xBF)[true]
#test(0xC3)[false]
#test(0x41)[false]
fun is_cont(b: uint8) -> bool {
    return (b & 0xC0) == 0x80
}

// The number of characters: the bytes that aren't continuation bytes.
#test("")[0]
#test("größe")[5]
fun char_count(s: str) -> int {
    var k = 0
    var i = 0
    while i < s.len() {
        if !is_cont(s[i]) {
            k += 1
        }
        i += 1
    }
    return k
}

// ASCII whitespace, as C's isspace: space, \t, \n, \v, \f and \r.
#test(' ')[true]
#test('\t')[true]
#test('\r')[true]
#test(0x0B)[true]
#test(0x0E)[false]
#test('a')[false]
fun is_space(b: uint8) -> bool {
    return b == ' ' || (b >= 9 && b <= 13)
}

// The position after the whitespace at the start of `s`.
#test("  a ")[2]
#test("   ")[3]
fun space_end(s: str) -> int {
    var i = 0
    while i < s.len() && is_space(s[i]) {
        i += 1
    }
    return i
}

// The position of the whitespace at the end of `s`, not before
// `space_end(s)`.
#test("  a ")[3]
#test("   ")[3] // not before space_end
fun space_start(s: str) -> int {
    return space_before(s, s.len(), space_end(s))
}

// The position of the whitespace right before `end` in `s`, not before
// `low`.
#test("a  ", 3, 0)[1]
#test("   ", 3, 0)[0]
#test("   ", 3, 2)[2]
fun space_before(s: str, end: int, low: int) -> int {
    var i = end
    while i > low && is_space(s[i - 1]) {
        i -= 1
    }
    return i
}

// `s` with the bytes from `low` to `high` moved 32 the other way: up
// for a to z, down for A to Z.
#test("aZ!", 'a', 'z')["AZ!"]
#test("aZ!", 'A', 'Z')["az!"]
fun shift_case(s: str, low: uint8, high: uint8) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < s.len() {
        let b = s[i]
        if b >= low && b <= high {
            sb.append_byte(b ^ 32)
        } else {
            sb.append_byte(b)
        }
        i += 1
    }
    return sb.build()
}

#test
fun split_and_join_round_trip() {
    let texts = ["", ",", "a", "a,b", ",a,,b,", "é,ü"]
    for t in texts {
        let parts = t.split(",")
        var sb = StringBuilder()
        var i = 0
        for p in parts {
            if i > 0 { sb.append(",") }
            sb.append(p)
            i += 1
        }
        assert(sb.build() == t, "split, then join, gives the text")
        assert(parts.len() == t.count(",") + 1, "one part more than separators")
    }
}

#test
fun count_is_what_replace_replaces() {
    let cases = [("banana", "an"), ("aaaaa", "aa"), ("abc", ""), ("", ""), ("xyz", "q")]
    for c in cases {
        let (t, p) = c
        let marked = t.replace(p, "\u{0}")
        var zeros = 0
        var i = 0
        while i < marked.len() {
            if marked[i] == 0 { zeros += 1 }
            i += 1
        }
        assert(zeros == t.count(p), "count is the number replace replaces")
    }
}

// `repeat` past 16 copies appends a run of copies, up to 4,096 bytes, then
// part of one (MYLA-546): each count about a run's size, texts that
// double into a run several times, once, or not at all.
#test
fun repeat_in_bulk() {
    for t in ["x", "ab", "é", "abc".repeat(500), "q".repeat(3000)] {
        let counts = if t.len() < 1000 { [17, 31, 32, 33, 4095, 4096, 4097, 9000] } else { [17, 18, 33] }
        for n in counts {
            let r = t.repeat(n)
            assert(r.len() == n * t.len(), f"{t.len()} bytes {n} times: {r.len()} bytes")
            var i = 0
            while i < n {
                if r[i * t.len():(i + 1) * t.len()] != t {
                    assert(false, f"{t.len()} bytes {n} times: copy {i}")
                }
                i += 1
            }
        }
    }
}

#test
fun any_bytes() {
    // A string read from a file can hold any bytes: the methods cut
    // it anywhere a match says, even inside a character.
    var sb = StringBuilder()
    sb.append_byte(0xC3)
    sb.append("|")
    sb.append_byte(0xFF)
    sb.append("|é")
    let s = sb.build()
    let parts = s.split("|")
    assert(parts.len() == 3, "three parts")
    assert(parts[0].len() == 1 && parts[0][0] == 0xC3, "a lone lead byte")
    assert(parts[1].len() == 1 && parts[1][0] == 0xFF, "an invalid byte")
    assert(parts[2] == "é", "a whole character")
    let tail = "é"
    var cont = StringBuilder()
    cont.append_byte(tail[1])
    let piece = cont.build()
    assert(match tail.find(piece) { Some(1) => true, _ => false }, "a match inside a character")
    assert(tail.split(piece).len() == 2, "a split inside a character")
    assert(s.to_upper().len() == s.len(), "to_upper keeps every byte")
}

#test
fun trim_keeps_inner_text() {
    let s = " \t a  b \r\n"
    assert(s.trim() == "a  b", "trim")
    assert(s.trim_start().trim_end() == s.trim(), "trim_start then trim_end")
    assert(s.words().len() == 2, "words")
    for w in ["", " ", " \t\r\n", "\u{0b}\u{0c}"] {
        assert(w.trim_end() == "" && w.trim_start() == "" && w.trim() == "", "whitespace only")
    }
}

// Where a plain search finds `p` in `s` from `start` on (the reference of
// the test below), or the last place at or before `start` with `last`.
fun plain_find(s: str, p: str, start: int, last: bool) -> Option<int> {
    var i = start
    while i >= 0 && i + p.len() <= s.len() {
        if at(s, p, i) {
            return Some(i)
        }
        i = if last { i - 1 } else { i + 1 }
    }
    return None
}

// The two-way search finds what a plain search finds (M25): every text of
// up to 6 bytes over "ab" with every needle of up to 4, and 800 texts and
// needles drawn at random from runs of "a", "b" and "c", forwards from two
// starts and backwards; then `find`, `rfind` and `count` on a needle that
// makes the plain scan give up.
#test
fun two_way_is_a_plain_search() {
    var texts: [str] = [""]
    var k = 0
    while k < texts.len() && texts[k].len() < 6 {
        texts.push(texts[k] + "a")
        texts.push(texts[k] + "b")
        k += 1
    }
    var pairs: [(str, str)] = []
    for t in texts {
        for p in texts {
            if p.len() >= 1 && p.len() <= 4 {
                pairs.push((t, p))
            }
        }
    }
    var seed: uint32 = 12345
    var r = 0
    while r < 800 {
        var parts: [str] = ["", ""]
        var w = 0
        while w < 2 {
            seed = seed.wrapping_mul(1103515245).wrapping_add(12345)
            var pieces = (seed >> 16) % 9
            var sb = StringBuilder()
            while pieces > 0 {
                seed = seed.wrapping_mul(1103515245).wrapping_add(12345)
                let c = 'a' + (((seed >> 16) % 3) as int32)
                seed = seed.wrapping_mul(1103515245).wrapping_add(12345)
                var run = 1 + (seed >> 16) % 4
                while run > 0 {
                    sb.append_char(c)
                    run -= 1
                }
                pieces -= 1
            }
            parts[w] = sb.build()
            w += 1
        }
        if parts[1].len() > 0 {
            pairs.push((parts[0] + parts[1] + parts[0], parts[1]))
            pairs.push((parts[0] + parts[0], parts[1]))
        }
        r += 1
    }
    for (t, p) in pairs {
        let mid = t.len() / 2
        assert(two_way(t, p, 0) == plain_find(t, p, 0, false), "from the start")
        assert(two_way(t, p, mid) == plain_find(t, p, mid, false), "from the middle")
        if t.len() >= p.len() {
            let top = t.len() - p.len()
            assert(last_two_way(t, p, top) == plain_find(t, p, top, true), "backwards")
        }
    }
    let hay = "a".repeat(3000) + "b" + "a".repeat(3000) + "b"
    let needle = "a".repeat(1000) + "b"
    assert(hay.find(needle) == Some(2000), "find")
    assert(hay.rfind(needle) == Some(5001), "rfind")
    assert(hay.count(needle) == 2, "count")
    assert(hay.find_from(needle, 2001) == Some(5001), "find_from")
    assert("a".repeat(5000).find(needle) == None, "none")
}
