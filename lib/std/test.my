// std.test — what a test function needs beyond `#test` (D162, MYLA-304).
//
// A test function is a function without parameters under a bare `#test`: it
// passes when it returns, fails on a runtime error. These are the checks
// that fail it with a message the report shows (`FAIL  count_rows: expected
// 3, got 4`), a scratch directory the runner removes when the case ends
// however it ends, and the path of the project's program for the tests of
// `tests/` (MYLA-306). Every failure is a runtime error, as `assert`'s is: a
// case fails the way a program fails, and `myla test` is the one place that
// goes on after one.

import std.fs as fs

// Fail the case unless `cond` holds.
pub fun expect(cond: bool, msg: str = "expectation failed") {
    if !cond { panic(msg) }
}

// Fail the case unless `got` is `want`, naming both.
pub fun expect_eq<T: Eq + Format>(got: T, want: T) {
    if !(got == want) { panic(f"expected {want}, got {got}") }
}

// Fail the case when `got` is `other`, naming it.
pub fun expect_ne<T: Eq + Format>(got: T, other: T) {
    if got == other { panic(f"expected two different values, both are {got}") }
}

// Fail the case with `msg`.
pub fun fail(msg: str) {
    panic(msg)
}

// A fresh, empty directory for the running case, under the case's scratch
// root (`$TMPDIR` or `/tmp`), which the runner removes when the case ends,
// passed or failed; each call gives a new one. Outside `myla test` there is
// no case, which is a runtime error.
pub fun temp_dir() -> str {
    let root = __test_dir()
    if root == "" { panic("test.temp_dir() needs a running case: run the file with 'myla test'") }
    let taken = match fs.list_dir(root) {
        Ok(names) => names.len(),
        Err(e) => 0,
    }
    let path = f"{root}/d{taken}"
    match fs.make_dir_all(path) {
        Ok(()) => {},
        Err(e) => { panic(f"test.temp_dir() could not create {path}") },
    }
    return path
}

// The path of the project's program, built by `myla test` before the files
// of `tests/` run (MYLA-306); a runtime error elsewhere.
pub fun program() -> str {
    let p = __test_program()
    if p == "" { panic("test.program() needs a project with a program: run 'myla test' in it") }
    return p
}
