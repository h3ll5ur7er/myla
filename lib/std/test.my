// std.test — what a test function needs beyond `#test` (D162, MYLA-304).
//
// A test function is a function without parameters under a bare `#test`: it
// passes when it returns, fails on a runtime error. These are the checks
// that fail it with a message the report shows (`FAIL  count_rows: expected
// 3, got 4`), a scratch directory the runner removes when the case ends
// however it ends, and the path of the project's program for the tests of
// `tests/` (MYLA-306). Every failure is a runtime error, as `assert`'s is: a
// case fails the way a program fails, and `myla test` is the one place that
// goes on after one.

import std.fs as fs

// Fail the case unless `cond` holds.
pub fun expect(cond: bool, msg: str = "expectation failed") {
    if !cond { panic(msg) }
}

// Fail the case unless `got` is `want`, naming both.
pub fun expect_eq<T: Eq + Format>(got: T, want: T) {
    if !(got == want) { panic(f"expected {want}, got {got}") }
}

// Fail the case when `got` is `other`, naming it.
pub fun expect_ne<T: Eq + Format>(got: T, other: T) {
    if got == other { panic(f"expected two different values, both are {got}") }
}

// Fail the case with `msg`.
pub fun fail(msg: str) {
    panic(msg)
}

// A fresh, empty directory for the running case, under the case's scratch
// root (`$TMPDIR` or `/tmp`), which the runner removes when the case ends,
// passed or failed; each call gives a new one (`std.fs`'s
// `make_temp_dir_in`: `d` and 16 random hexadecimal digits). Outside `myla
// test` there is no case, which is a runtime error.
pub fun temp_dir() -> str {
    let root = case_root("temp_dir")
    match fs.make_temp_dir_in(root, "d") {
        Ok(path) => { return path },
        Err(e) => { panic(f"test.temp_dir() could not create a directory in {root}") },
    }
    unreachable()
}

// A fresh, empty file for the running case, in the case's scratch root,
// which the runner removes when the case ends; each call gives a new one
// (`std.fs`'s `make_temp_file_in`: `f` and 16 random hexadecimal digits,
// mode 0600). Outside `myla test` it is a runtime error.
pub fun temp_file() -> str {
    let root = case_root("temp_file")
    match fs.make_temp_file_in(root, "f") {
        Ok((path, file)) => {
            var f = file
            let closed = f.close()
            return path
        },
        Err(e) => { panic(f"test.temp_file() could not create a file in {root}") },
    }
    unreachable()
}

// The running case's scratch root, made if it isn't there yet; a runtime
// error for `test.<what>()` outside a case.
fun case_root(what: str) -> str {
    let root = __test_dir()
    if root == "" { panic(f"test.{what}() needs a running case: run the file with 'myla test'") }
    match fs.make_dir_all(root) {
        Ok(()) => {},
        Err(e) => { panic(f"test.{what}() could not create {root}") },
    }
    return root
}

// Two directories and a file for the case, each new and empty, in the
// case's root. (Where the harness runs the cases in itself, as on wasm32,
// there is no case root, and so nothing to test.)
#test
fun temp_dirs_and_files() {
    if __test_dir() == "" { return }
    let d = temp_dir()
    let e = temp_dir()
    expect_ne(d, e)
    expect(fs.is_dir(d) && fs.is_dir(e), "two directories")
    expect(match fs.list_dir(d) { Ok(names) => names.len() == 0, Err(_) => false }, "an empty one")
    let f = temp_file()
    expect(fs.is_file(f), "a file")
    expect(match fs.read_to_string(f) { Ok(s) => s == "", Err(_) => false }, "an empty one")
    expect(starts_with(f, __test_dir() + "/"), "in the case's root")
}

// The path of the project's program, built by `myla test` before the files
// of `tests/` run (MYLA-306); a runtime error elsewhere.
pub fun program() -> str {
    let p = __test_program()
    if p == "" { panic("test.program() needs a project with a program: run 'myla test' in it") }
    return p
}

// --- The harness of `myla test --native` (MYLA-307) ----------------------
//
// `myla test --native` builds a program from a file and its cases: each
// case a function giving its verdict (None when it passed, else why it
// failed), and a `#main` that runs them through the functions below. The
// runner starts a child process of itself for each case (`<harness> --case
// <n> <nonce>`), so a runtime error or an `exit` ends that case only, what
// it printed is kept for the report and its scratch directory
// (MYLA_TEST_DIR) removed.
//
// A child tells the runner how its case ended in a record on stderr, which
// is the child's last word (D191): the head `\u{1}myla-<nonce>\u{1}`
// (`record_head`), a kind, `:`, a number and `;`, then as many bytes of text
// as the number says for the kinds that carry a text. `P:0;` the case
// returned and passed, `F:<n>;<detail>` it returned and failed, both
// written here (`case_end`); `E:<n>;<message>` a runtime error and
// `X:<status>;` an `exit` (the status the process ends with, `exit(n)`'s
// `n` modulo 256), which the runtime writes (std.rt's
// `test_record`), once `reporting` has given it the head. The nonce is the
// runner's, new for each run, so nothing a case writes can pass for a
// record, and the length frames the text, so a message of many lines is
// whole. The rest of stderr is what the case wrote itself, passed on.
//
// A wasm32 module can start no process, so there `myla test` itself runs
// the harness, `<harness> --from <n> <nonce>` (MYLA-370): it runs the cases
// from `n` on in itself, each after a record `B:0;` on both streams
// (`case_begin`) and ending with its record, and `myla test` cuts what it
// printed into the cases' (`cut_run`); the case a runtime error or an
// `exit` ended is the last one, and the next run starts after it. Run by
// hand without either flag, where no process can be started the cases run
// in the harness itself, in order, and the first runtime error ends the run.

import std.fs as fs
from std.process import args, exit, command, ExitStatus, Output, env
from std.io import write, eprint
from std.time import now_ns
from std.num import format_float

// A case as the report knows it: its name, and what it expects of the
// call: a value (`kind` 0), a runtime error with `message` (1,
// `[panic("message")]`), an exit with `code` (2, `[exit(code)]`).
pub struct Case { name: str, kind: int32, message: str, code: int32 }

// The case `argv` names, `<harness> --case <n>` with the run's nonce after
// it, or without one by hand; -1 when it names none and this process is
// the runner.
#test(["h", "--case", "3", "17"])[3]
#test(["h", "--case", "3"])[3]
#test(["h"])[-1]
#test(["h", "--case", "x"])[-1]
#test(["h", "--case", "3", "17", "x"])[-1]
pub fun case_index(argv: [str]) -> int32 {
    if argv.len() < 3 || argv.len() > 4 || argv[1] != "--case" { return -1 }
    var n = 0
    var i = 0
    while i < argv[2].len() {
        let c = argv[2][i]
        if c < '0' || c > '9' { return -1 }
        n = n * 10 + (c as int32 - 48)
        i = i + 1
    }
    return n
}

// The case `argv` starts a run at, `<harness> --from <n> <nonce>`
// (MYLA-370); -1 when it names none.
#test(["h", "--from", "12", "17"])[12]
#test(["h", "--case", "3"])[-1]
#test(["h"])[-1]
pub fun from_index(argv: [str]) -> int32 {
    if argv.len() < 3 || argv.len() > 4 || argv[1] != "--from" { return -1 }
    return case_index(["", "--case", argv[2]])
}

// The head of the records of the run whose nonce is `nonce` (D191).
#test("17")["\u{1}myla-17\u{1}"]
pub fun record_head(nonce: str) -> str {
    return "\u{1}myla-" + nonce + "\u{1}"
}

// A run's nonce, new for each run: what no case can know beforehand.
fun new_nonce() -> str {
    return f"{now_ns()}"
}

// This process reports its cases with records (D191): their head, from the
// nonce `argv` names after `--case <n>` or `--from <n>` ("" without one, and
// then no records), given to the runtime too, which writes the record of a
// runtime error or an `exit` with it (`__test_report`: a string's cell of
// its own, which stays as long as the process).
pub fun reporting(argv: [str]) -> str {
    if argv.len() != 4 || (argv[1] != "--case" && argv[1] != "--from") { return "" }
    let head = record_head(argv[3])
    let n = head.len() as int64
    let cell = __alloc(n + 8)
    __store64(cell, n)
    __copy_bytes(cell + 8, __addr_of(head) + 8, n)
    __store64(__rt_addr("__test_report"), cell)
    return head
}

// The runtime writes no record from now on: the harness ends by itself.
fun reporting_ends() {
    __store64(__rt_addr("__test_report"), 0)
}

// A case of a run `--from <n>` begins: a record on both streams.
pub fun case_begin(head: str) {
    if head == "" { return }
    let o = write(1, head + "B:0;")
    let e = write(2, head + "B:0;")
}

// A case ended by returning, with its verdict (None when it passed): its
// record on stderr.
pub fun case_end(head: str, verdict: Option<str>) {
    if head == "" { return }
    let e = match verdict {
        Some(detail) => write(2, head + f"F:{detail.len()};" + detail),
        None => write(2, head + "P:0;"),
    }
}

// A child's end: its case returned, and passed (status 0) or failed (1),
// its record the last thing on stderr.
pub fun child_done(head: str, verdict: Option<str>) {
    case_end(head, verdict)
    reporting_ends()
    exit(match verdict { Some(detail) => 1, None => 0 })
}

// A run `--from <n>` cut into its cases: for each case it began, what it
// printed on stdout and on stderr, and its status as a child's would be
// (0 for one the run went on after; the run's `code` for the last one).
// Output before the first case is dropped.
#test("\u{1}myla-1\u{1}B:0;a\n\u{1}myla-1\u{1}B:0;", "\u{1}myla-1\u{1}B:0;\u{1}myla-1\u{1}P:0;\u{1}myla-1\u{1}B:0;\u{1}myla-1\u{1}E:1;x", 1, "\u{1}myla-1\u{1}")[[("a\n", "\u{1}myla-1\u{1}P:0;", 0), ("", "\u{1}myla-1\u{1}E:1;x", 1)]]
#test("\u{1}myla-case\u{1}x", "\u{1}myla-2\u{1}B:0;\u{1}myla-case\u{1}\u{1}myla-2\u{1}P:0;", 0, "\u{1}myla-1\u{1}")[[]]   // another run's marks, an old one's
#test("", "", 1, "\u{1}myla-1\u{1}")[[]]
pub fun cut_run(stdout: str, stderr: str, code: int32, head: str) -> [(str, str, int32)] {
    let mark = head + "B:0;"
    let outs = pieces(stdout, mark)
    let errs = pieces(stderr, mark)
    var runs: [(str, str, int32)] = []
    var i = 1
    while i < errs.len() {
        let out = if i < outs.len() { outs[i] } else { "" }
        runs.push((out, errs[i], if i == errs.len() - 1 { code } else { 0 }))
        i = i + 1
    }
    return runs
}

// `text` cut at each `mark`: the piece before the first, then one after each.
#test("ab|c|", "|")[["ab", "c", ""]]
#test("abc", "|")[["abc"]]
#test("", "|")[[""]]
fun pieces(text: str, mark: str) -> [str] {
    var out: [str] = []
    var start = 0
    var i = 0
    while i + mark.len() <= text.len() {
        var k = 0
        while k < mark.len() && text[i + k] == mark[k] { k = k + 1 }
        if k == mark.len() {
            out.push(slice_of(text, start, i))
            i = i + mark.len()
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(slice_of(text, start, text.len()))
    return out
}

// The runner: every case in a child process of `program` (this harness),
// the report printed as `myla test` prints it; Some(status), 0 when all
// passed. None when the first child could not be started: the cases run in
// this process instead (`report_inline`).
pub fun run_in_children(program: str, cases: [Case]) -> Option<int32> {
    var passed = 0
    var k = 0
    // under an emulator (MYLA_TEST_EMULATOR, from `myla test --target`),
    // the children run under it too
    var words: [str] = []
    match env("MYLA_TEST_EMULATOR") {
        Some(e) => { words = split_words(e) },
        None => {},
    }
    var exe = program
    var lead: [str] = []
    if words.len() > 0 {
        exe = words[0]
        var i = 1
        while i < words.len() {
            lead.push(words[i])
            i = i + 1
        }
        lead.push(program)
    }
    var base = match env("TMPDIR") { Some(d) => d, None => "" }
    if base == "" { base = "/tmp" }
    let root = f"{base}/myla-test-{now_ns()}"
    let nonce = new_nonce()
    let head = record_head(nonce)
    var lines: [str] = []
    while k < cases.len() {
        let dir = f"{root}/c{k}"
        var argv = lead
        argv.push("--case")
        argv.push(f"{k}")
        argv.push(nonce)
        let ran = command(exe).args(argv).env("MYLA_TEST_DIR", dir).stdin("").output()
        var started = true
        var out = Output { stdout: [], stderr: [], status: ExitStatus.Exited(0) }
        match ran {
            Ok(o) => { out = o },
            Err(e) => { started = false },
        }
        if fs.exists(dir) { let gone = fs.remove_dir_all(dir) }
        if !started {
            if k == 0 { return None }
            lines.push(f"FAIL  {cases[k].name}: could not start the case's process\n")
        } else {
            let code = match out.status {
                ExitStatus.Exited(c) => c,
                ExitStatus.Signaled(s) => -s,
            }
            let (verdict, shown) = case_detail(cases[k], text(out.stdout), text(out.stderr), code, head)
            match verdict { None => { passed = passed + 1 }, Some(d) => {} }
            for l in case_lines(cases[k], verdict, shown) { lines.push(l) }
        }
        k = k + 1
    }
    if fs.exists(root) { let gone = fs.remove_dir_all(root) }
    for l in lines { let w = write(1, l) }
    return Some(summary(passed, cases.len()))
}

// A case's lines in the report: PASS, or FAIL with the detail (none for an
// empty one) and the output lines it printed under it.
#test(Case { name: "t", kind: 0, message: "", code: 0 }, None, ["x"])[["PASS  t\n"]]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, Some("a\nb"), ["x"])[["FAIL  t: a\\nb\n", "      | x\n"]]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, Some(""), [])[["FAIL  t\n"]]   // an empty `Err` fails
pub fun case_lines(c: Case, verdict: Option<str>, shown: [str]) -> [str] {
    let detail = match verdict {
        Some(d) => d,
        None => { return [f"PASS  {c.name}\n"] },
    }
    var lines = [fail_line(c.name, detail)]
    for l in shown { lines.push("      | " + l + "\n") }
    return lines
}

// A case's FAIL line, as the interpreter's `myla test` writes it.
#test("t", "x")["FAIL  t: x\n"]
#test("t", "")["FAIL  t\n"]
pub fun fail_line(name: str, detail: str) -> str {
    if detail == "" { return f"FAIL  {name}\n" }
    return f"FAIL  {name}: {on_one_line(detail)}\n"
}

// What a child's run says of its case: the verdict (None when it passed)
// and the output lines to show under a FAIL line. What the case wrote on
// stderr itself is passed on, as `myla test` lets a case's stderr through
// when it interprets it; the record isn't.
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "x\n", "\u{1}myla-1\u{1}P:0;", 0, "\u{1}myla-1\u{1}")[(None, ["x"])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "x\n", "\u{1}myla-1\u{1}F:17;expected 1, got 2", 1, "\u{1}myla-1\u{1}")[(Some("expected 1, got 2"), ["x"])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-1\u{1}F:0;", 1, "\u{1}myla-1\u{1}")[(Some(""), [])]   // an empty `Err`
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-1\u{1}E:4;boom", 1, "\u{1}myla-1\u{1}")[(Some("runtime error: boom"), [])]
#test(Case { name: "t", kind: 1, message: "boom", code: 0 }, "", "\u{1}myla-1\u{1}E:4;boom", 1, "\u{1}myla-1\u{1}")[(None, [])]
#test(Case { name: "t", kind: 1, message: "boom", code: 0 }, "", "\u{1}myla-1\u{1}E:2;bo", 1, "\u{1}myla-1\u{1}")[(Some("expected runtime error 'boom', got runtime error 'bo'"), [])]   // exactly (D183)
#test(Case { name: "t", kind: 1, message: "", code: 0 }, "", "\u{1}myla-1\u{1}E:1;x", 1, "\u{1}myla-1\u{1}")[(Some("expected runtime error '', got runtime error 'x'"), [])]
#test(Case { name: "t", kind: 1, message: "a\nruntime error: b", code: 0 }, "", "\u{1}myla-1\u{1}E:18;a\nruntime error: b", 1, "\u{1}myla-1\u{1}")[(None, [])]   // a message of many lines, whole (C5)
#test(Case { name: "t", kind: 1, message: "b", code: 0 }, "", "\u{1}myla-1\u{1}E:18;a\nruntime error: b", 1, "\u{1}myla-1\u{1}")[(Some("expected runtime error 'b', got runtime error 'a\nruntime error: b'"), [])]
#test(Case { name: "t", kind: 1, message: "boom", code: 0 }, "", "\u{1}myla-1\u{1}X:3;", 3, "\u{1}myla-1\u{1}")[(Some("expected runtime error 'boom', exited with status 3"), [])]
#test(Case { name: "t", kind: 2, message: "", code: 3 }, "", "\u{1}myla-1\u{1}X:3;", 3, "\u{1}myla-1\u{1}")[(None, [])]
#test(Case { name: "t", kind: 2, message: "", code: 3 }, "", "\u{1}myla-1\u{1}X:0;", 0, "\u{1}myla-1\u{1}")[(Some("expected exit status 3, exited with status 0"), [])]
#test(Case { name: "t", kind: 2, message: "", code: 0 }, "", "\u{1}myla-1\u{1}X:0;", 0, "\u{1}myla-1\u{1}")[(None, [])]   // `[exit(0)]` (M6)
#test(Case { name: "t", kind: 2, message: "", code: 0 }, "", "\u{1}myla-1\u{1}F:29;expected exit status 0, got 2", 1, "\u{1}myla-1\u{1}")[(Some("expected exit status 0, got 2"), [])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-1\u{1}X:0;", 0, "\u{1}myla-1\u{1}")[(Some("exited with status 0"), [])]   // `exit(0)` in a case (M6)
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-1\u{1}X:2;", 2, "\u{1}myla-1\u{1}")[(Some("exited with status 2"), [])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "", -9, "\u{1}myla-1\u{1}")[(Some("killed by signal 9"), [])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-1\u{1}E:19;expected a\n, got b\n", 1, "\u{1}myla-1\u{1}")[(Some("runtime error: expected a\n, got b\n"), [])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "runtime error: stack overflow\n", 1, "\u{1}myla-1\u{1}")[(Some("runtime error: stack overflow"), [])]   // an emulator's report of a trap
pub fun case_detail(c: Case, stdout: str, stderr: str, code: int32, head: str) -> (Option<str>, [str]) {
    let (verdict, shown, rest) = case_outcome(c, stdout, stderr, code, head)
    if rest != "" { eprint(rest) }
    return (verdict, shown)
}

// `case_detail`'s verdict and lines, and what the case wrote on stderr
// itself, which `case_detail` passes on: stderr without the case's record
// (with the records of the run whose head is `head`, D191). A case that
// ended without one ended outside the runtime: by a signal, or by a trap an
// emulator reported as the runtime does, `runtime error: …` last on stderr
// (wasm32's, `tools/wasm/run.mjs`).
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "warn\n\u{1}myla-1\u{1}F:2;no", 1, "\u{1}myla-1\u{1}")[(Some("no"), [], "warn\n")]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-done\u{1}runtime error: fake\n\u{1}myla-1\u{1}X:1;", 1, "\u{1}myla-1\u{1}")[(Some("exited with status 1"), [], "\u{1}myla-done\u{1}runtime error: fake\n")]   // marks of its own
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-2\u{1}P:0;\u{1}myla-1\u{1}X:3;", 3, "\u{1}myla-1\u{1}")[(Some("exited with status 3"), [], "\u{1}myla-2\u{1}P:0;")]   // another run's record
#test(Case { name: "t", kind: 1, message: "boom", code: 0 }, "", "progress... \u{1}myla-1\u{1}E:4;boom", 1, "\u{1}myla-1\u{1}")[(None, [], "progress... ")]
#test(Case { name: "t", kind: 1, message: "stack overflow", code: 0 }, "", "w\nruntime error: stack overflow\n\u{1}myla-1\u{1}E:14;stack overflow", 1, "\u{1}myla-1\u{1}")[(None, [], "w\n")]   // the runtime's own line taken off
#test(Case { name: "t", kind: 1, message: "boom", code: 0 }, "", "runtime error: fake\nruntime error: boom\n", 1, "\u{1}myla-1\u{1}")[(None, [], "runtime error: fake\n")]   // an emulator's report, last
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "\u{1}myla-1\u{1}E:9;cut", 1, "\u{1}myla-1\u{1}")[(Some("exited with status 1"), [], "\u{1}myla-1\u{1}E:9;cut")]   // a record cut short is none
pub fun case_outcome(c: Case, stdout: str, stderr: str, code: int32, head: str) -> (Option<str>, [str], str) {
    let shown = lines_of(stdout)
    let r = record_in(stderr, head)
    if r.kind == "P" { return (None, shown, r.rest) }
    if r.kind == "F" { return (Some(r.text), shown, r.rest) }
    if r.kind == "E" { return (failed(c, r.text), shown, without_overflow_line(r.rest, r.text)) }
    if r.kind == "X" { return (exited(c, r.n), shown, r.rest) }
    if code < 0 { return (Some(f"killed by signal {-code}"), shown, stderr) }
    var at = -1
    if code == 1 {
        at = last_at(stderr, ERROR_HEAD, true)
        if at < 0 { at = last_at(stderr, ERROR_HEAD, false) }
    }
    if at >= 0 { return (failed(c, error_message(after(stderr, at + ERROR_HEAD.len()))), shown, before(stderr, at)) }
    return (exited(c, code), shown, stderr)
}

// The verdict on a case whose call ended in a runtime error with `failure`.
fun failed(c: Case, failure: str) -> Option<str> {
    if c.kind == 1 {
        if failure == c.message { return None }
        return Some(f"expected runtime error '{c.message}', got runtime error '{failure}'")
    }
    if c.kind == 2 { return Some(f"expected exit status {c.code}, got runtime error '{failure}'") }
    return Some("runtime error: " + failure)
}

// The verdict on a case whose call ended the process with `status`.
fun exited(c: Case, status: int32) -> Option<str> {
    if c.kind == 1 { return Some(f"expected runtime error '{c.message}', exited with status {status}") }
    if c.kind == 2 {
        if status == c.code { return None }
        return Some(f"expected exit status {c.code}, exited with status {status}")
    }
    return Some(f"exited with status {status}")
}

// What a case wrote on stderr, `rest`, without the line natively written
// for a stack overflow before its record (`__on_segv`'s, which runs no
// Myla code first).
#test("a\nruntime error: stack overflow\n", "stack overflow")["a\n"]
#test("a\nruntime error: stack overflow\n", "boom")["a\nruntime error: stack overflow\n"]
fun without_overflow_line(rest: str, failure: str) -> str {
    let line = "runtime error: stack overflow\n"
    if failure != "stack overflow" || rest.len() < line.len() { return rest }
    let at = rest.len() - line.len()
    if after(rest, at) != line { return rest }
    return before(rest, at)
}

// A record of a case's end on its stderr (D191): its kind (`P`, `F`, `E`,
// `X`; "" when there is none), its number, its text, and stderr without it.
pub struct Record { kind: str, n: int32, text: str, rest: str }

// The last record with the head `head` on `stderr`, whole, else none.
#test("w\n\u{1}myla-9\u{1}F:3;a\nb", "\u{1}myla-9\u{1}")[Record { kind: "F", n: 3, text: "a\nb", rest: "w\n" }]
#test("\u{1}myla-9\u{1}X:255;", "\u{1}myla-9\u{1}")[Record { kind: "X", n: 255, text: "", rest: "" }]
#test("a\u{1}myla-9\u{1}E:1;xb", "\u{1}myla-9\u{1}")[Record { kind: "E", n: 1, text: "x", rest: "ab" }]
#test("\u{1}myla-8\u{1}P:0;", "\u{1}myla-9\u{1}")[Record { kind: "", n: 0, text: "", rest: "\u{1}myla-8\u{1}P:0;" }]
#test("\u{1}myla-9\u{1}E:9;x", "\u{1}myla-9\u{1}")[Record { kind: "", n: 0, text: "", rest: "\u{1}myla-9\u{1}E:9;x" }]
#test("\u{1}myla-9\u{1}E:;x", "\u{1}myla-9\u{1}")[Record { kind: "", n: 0, text: "", rest: "\u{1}myla-9\u{1}E:;x" }]
#test("x", "")[Record { kind: "", n: 0, text: "", rest: "x" }]
pub fun record_in(stderr: str, head: str) -> Record {
    let none = Record { kind: "", n: 0, text: "", rest: stderr }
    if head == "" { return none }
    let at = last_at(stderr, head, false)
    if at < 0 { return none }
    var i = at + head.len()
    if i + 2 > stderr.len() || stderr[i + 1] != ':' { return none }
    let kind = slice_of(stderr, i, i + 1)
    i = i + 2
    let digits = i
    var n = 0
    while i < stderr.len() && stderr[i] >= '0' && stderr[i] <= '9' && i - digits < 9 {
        n = n * 10 + (stderr[i] as int32 - 48)
        i = i + 1
    }
    if i == digits || i >= stderr.len() || stderr[i] != ';' { return none }
    i = i + 1
    var text = ""
    if kind == "E" || kind == "F" {
        if n > stderr.len() - i { return none }
        text = slice_of(stderr, i, i + n)
        i = i + n
    }
    return Record { kind: kind, n: n, text: text, rest: before(stderr, at) + after(stderr, i) }
}

// How the runtime's report of a runtime error starts.
const ERROR_HEAD: str = "runtime error: "

// The message of a runtime error's report, from after its head: up to its
// position line, else its last newline.
#test("boom\n  --> t.my:1:1\n")["boom"]
#test("a\n  --> b\n\n  --> t.my:2:3\n")["a\n  --> b\n"]
#test("stack overflow\n")["stack overflow"]
#test("cut")["cut"]
fun error_message(tail: str) -> str {
    let pos = last_at(tail, "\n  --> ", false)
    if pos >= 0 { return before(tail, pos) }
    if tail.len() > 0 && tail[tail.len() - 1] == '\n' { return before(tail, tail.len() - 1) }
    return tail
}

// Where `mark` last occurs in `text` (with `line_start`, only where it
// starts a line); -1 when it doesn't.
#test("a|b|", "|", false)[3]
#test("ab", "|", false)[-1]
#test("x: a\nx: b", "x: ", true)[5]
#test("ax: b", "x: ", true)[-1]
#test("x: ", "x: ", true)[0]
fun last_at(text: str, mark: str, line_start: bool) -> int32 {
    var i = text.len() - mark.len()
    while i >= 0 {
        var k = 0
        while k < mark.len() && text[i + k] == mark[k] { k = k + 1 }
        if k == mark.len() && (!line_start || i == 0 || text[i - 1] == '\n') { return i }
        i = i - 1
    }
    return -1
}

// A case run in this process (no children here), which gave `verdict`: its
// line printed now, so that a later failure that ends the run leaves it;
// whether it passed. (A `[panic]` or `[exit]` case can't pass this way:
// the failure ends the run.)
pub fun report_inline(c: Case, verdict: Option<str>) -> bool {
    match verdict {
        Some(detail) => {
            let w = write(1, fail_line(c.name, detail))
            return false
        },
        None => {
            let w = write(1, f"PASS  {c.name}\n")
            return true
        },
    }
    unreachable()
}

// The harness ends with `status`, writing no record.
pub fun end(status: int32) {
    reporting_ends()
    exit(status)
}

// The summary line, and the status to end with.
pub fun summary(passed: int32, total: int32) -> int32 {
    let w = write(1, f"\n{passed}/{total} passed.\n")
    if passed == total { return 0 }
    return 1
}

// `bytes` as text.
fun text(bytes: [uint8]) -> str {
    var sb = StringBuilder()
    for b in bytes { sb.append_byte(b) }
    return sb.build()
}

#test("a\nb\n")[["a", "b"]]
#test("a")[["a"]]
#test("")[[]]
fun lines_of(text: str) -> [str] {
    var out: [str] = []
    var line = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == '\n' {
            out.push(line.build())
            line = StringBuilder()
        } else {
            line.append_byte(text[i])
        }
        i = i + 1
    }
    let rest = line.build()
    if rest.len() > 0 { out.push(rest) }
    return out
}

// `s` from its byte `n` on (no slice: the harness of `std.slice` itself
// must build).
#test("myla test: x", 11)["x"]
fun after(s: str, n: int32) -> str {
    return slice_of(s, n, s.len())
}

// `s` before its byte `n`.
#test("ab|", 2)["ab"]
fun before(s: str, n: int32) -> str {
    return slice_of(s, 0, n)
}

#test("abc", 1, 2)["b"]
fun slice_of(s: str, a: int32, b: int32) -> str {
    var sb = StringBuilder()
    sb.append(s, a, b)
    return sb.build()
}

#test("myla test: x", "myla test: ")[true]
#test("my", "myla")[false]
fun starts_with(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() { return false }
    var i = 0
    while i < prefix.len() {
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    return true
}

#test("node run.mjs")[["node", "run.mjs"]]
fun split_words(text: str) -> [str] {
    var out: [str] = []
    var word = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == ' ' {
            let w = word.build()
            if w.len() > 0 { out.push(w) }
            word = StringBuilder()
        } else {
            word.append_byte(text[i])
        }
        i = i + 1
    }
    let w = word.build()
    if w.len() > 0 { out.push(w) }
    return out
}

#test("a\nb")["a\\nb"]
fun on_one_line(text: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == '\n' { sb.append("\\n") } else { sb.append_byte(text[i]) }
        i = i + 1
    }
    return sb.build()
}

// --- Values as the report shows them (the interpreter's forms) -----------

// A string as the report quotes it (Python's repr: single quotes unless
// the text has one and no double quote; `\n`, `\t`, `\r`, `\\`, the quote
// and `\xNN` for the other control characters).
#test("it's")["\"it's\""]
#test("a\nb")["'a\\nb'"]
#test("say \"hi\"")["'say \"hi\"'"]
#test("")["''"]
pub fun repr_str(s: str) -> str {
    var has_single = false
    var has_double = false
    for c in s.chars() {
        if c == '\'' { has_single = true }
        if c == '"' { has_double = true }
    }
    var quote = '\''
    if has_single && !has_double { quote = '"' }
    var sb = StringBuilder()
    sb.append(f"{quote}")
    for c in s.chars() {
        let cp = c as int32
        if c == '\\' { sb.append("\\\\") }
        else if c == quote { sb.append(f"\\{c}") }
        else if cp == 10 { sb.append("\\n") }
        else if cp == 9 { sb.append("\\t") }
        else if cp == 13 { sb.append("\\r") }
        else if cp < 32 || (cp >= 127 && cp <= 160) || cp == 173 { sb.append(f"\\x{hex2(cp)}") }
        else { sb.append(f"{c}") }
    }
    sb.append(f"{quote}")
    return sb.build()
}

// A float as the report shows it (Python's repr, the interpreter's form,
// M7): `2.0`, `1e+16`, `-0.0`, `nan`, `inf`.
#test(2.0)["2.0"]
#test(1e16)["1e+16"]
#test(-0.0)["-0.0"]
#test(0.1)["0.1"]
pub fun repr_float(v: float64) -> str {
    return format_float(v)
}

#test(24)["18"]
#test(108)["6c"]
fun hex2(v: int32) -> str {
    let digits = "0123456789abcdef"
    var sb = StringBuilder()
    sb.append_byte(digits[(v / 16) % 16])
    sb.append_byte(digits[v % 16])
    return sb.build()
}

// `text` with the module ids taken off the names in it, as the report
// shows an `Err(e)` of a test function: `std$fs$IoError.NotFound` is
// `IoError.NotFound`.
#test("std$fs$IoError.NotFound")["IoError.NotFound"]
#test("plain")["plain"]
pub fun without_module_ids(text: str) -> str {
    var sb = StringBuilder()
    var word = StringBuilder()
    var i = 0
    while i < text.len() {
        let c = text[i]
        if c == '$' {
            word = StringBuilder()
        } else if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
            word.append_byte(c)
        } else {
            sb.append(word.build())
            word = StringBuilder()
            sb.append_byte(c)
        }
        i = i + 1
    }
    sb.append(word.build())
    return sb.build()
}
