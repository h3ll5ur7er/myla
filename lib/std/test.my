// std.test — what a test function needs beyond `#test` (D162, MYLA-304).
//
// A test function is a function without parameters under a bare `#test`: it
// passes when it returns, fails on a runtime error. These are the checks
// that fail it with a message the report shows (`FAIL  count_rows: expected
// 3, got 4`), a scratch directory the runner removes when the case ends
// however it ends, and the path of the project's program for the tests of
// `tests/` (MYLA-306). Every failure is a runtime error, as `assert`'s is: a
// case fails the way a program fails, and `myla test` is the one place that
// goes on after one.

import std.fs as fs

// Fail the case unless `cond` holds.
pub fun expect(cond: bool, msg: str = "expectation failed") {
    if !cond { panic(msg) }
}

// Fail the case unless `got` is `want`, naming both.
pub fun expect_eq<T: Eq + Format>(got: T, want: T) {
    if !(got == want) { panic(f"expected {want}, got {got}") }
}

// Fail the case when `got` is `other`, naming it.
pub fun expect_ne<T: Eq + Format>(got: T, other: T) {
    if got == other { panic(f"expected two different values, both are {got}") }
}

// Fail the case with `msg`.
pub fun fail(msg: str) {
    panic(msg)
}

// A fresh, empty directory for the running case, under the case's scratch
// root (`$TMPDIR` or `/tmp`), which the runner removes when the case ends,
// passed or failed; each call gives a new one (`std.fs`'s
// `make_temp_dir_in`: `d` and 16 random hexadecimal digits). Outside `myla
// test` there is no case, which is a runtime error.
pub fun temp_dir() -> str {
    let root = case_root("temp_dir")
    match fs.make_temp_dir_in(root, "d") {
        Ok(path) => { return path },
        Err(e) => { panic(f"test.temp_dir() could not create a directory in {root}") },
    }
    unreachable()
}

// A fresh, empty file for the running case, in the case's scratch root,
// which the runner removes when the case ends; each call gives a new one
// (`std.fs`'s `make_temp_file_in`: `f` and 16 random hexadecimal digits,
// mode 0600). Outside `myla test` it is a runtime error.
pub fun temp_file() -> str {
    let root = case_root("temp_file")
    match fs.make_temp_file_in(root, "f") {
        Ok((path, file)) => {
            var f = file
            let closed = f.close()
            return path
        },
        Err(e) => { panic(f"test.temp_file() could not create a file in {root}") },
    }
    unreachable()
}

// The running case's scratch root, made if it isn't there yet; a runtime
// error for `test.<what>()` outside a case.
fun case_root(what: str) -> str {
    let root = __test_dir()
    if root == "" { panic(f"test.{what}() needs a running case: run the file with 'myla test'") }
    match fs.make_dir_all(root) {
        Ok(()) => {},
        Err(e) => { panic(f"test.{what}() could not create {root}") },
    }
    return root
}

// Two directories and a file for the case, each new and empty, in the
// case's root. (Where the harness runs the cases in itself, as on wasm32,
// there is no case root, and so nothing to test.)
#test
fun temp_dirs_and_files() {
    if __test_dir() == "" { return }
    let d = temp_dir()
    let e = temp_dir()
    expect_ne(d, e)
    expect(fs.is_dir(d) && fs.is_dir(e), "two directories")
    expect(match fs.list_dir(d) { Ok(names) => names.len() == 0, Err(_) => false }, "an empty one")
    let f = temp_file()
    expect(fs.is_file(f), "a file")
    expect(match fs.read_to_string(f) { Ok(s) => s == "", Err(_) => false }, "an empty one")
    expect(starts_with(f, __test_dir() + "/"), "in the case's root")
}

// The path of the project's program, built by `myla test` before the files
// of `tests/` run (MYLA-306); a runtime error elsewhere.
pub fun program() -> str {
    let p = __test_program()
    if p == "" { panic("test.program() needs a project with a program: run 'myla test' in it") }
    return p
}

// --- The harness of `myla test --native` (MYLA-307) ----------------------
//
// `myla test --native` builds a program from a file and its cases: each
// case a function giving "" when it passed, else why it failed, and a
// `#main` that runs them through the functions below. The runner starts a
// child process of itself for each case (`<harness> --case <n>`), so a
// runtime error or an `exit` ends that case only, what it printed is kept
// for the report and its scratch directory (MYLA_TEST_DIR) removed.
//
// A wasm32 module can start no process, so there `myla test` itself runs
// the harness, `<harness> --from <n>` (MYLA-370): it runs the cases from
// `n` on in itself, each between markers on both streams (`case_begin`,
// `case_end`), and `myla test` cuts what it printed into the cases'
// (`cut_run`); the case a runtime error or an `exit` ended is the last
// one, and the next run starts after it. Run by hand without either flag,
// where no process can be started the cases run in the harness itself, in
// order, and the first runtime error ends the run.

import std.fs as fs
from std.process import args, exit, command, ExitStatus, Output, env
from std.io import write, eprint
from std.time import now_ns

// A case as the report knows it: its name, and what it expects of the
// call: a value (`kind` 0), a runtime error with `message` (1,
// `[panic("message")]`), an exit with `code` (2, `[exit(code)]`).
pub struct Case { name: str, kind: int32, message: str, code: int32 }

// The case `argv` names, `<harness> --case <n>`; -1 when it names none and
// this process is the runner.
#test(["h", "--case", "3"])[3]
#test(["h"])[-1]
#test(["h", "--case", "x"])[-1]
pub fun case_index(argv: [str]) -> int32 {
    if argv.len() != 3 || argv[1] != "--case" { return -1 }
    var n = 0
    var i = 0
    while i < argv[2].len() {
        let c = argv[2][i]
        if c < '0' || c > '9' { return -1 }
        n = n * 10 + (c as int32 - 48)
        i = i + 1
    }
    return n
}

// The case `argv` starts a run at, `<harness> --from <n>` (MYLA-370); -1
// when it names none.
#test(["h", "--from", "12"])[12]
#test(["h", "--case", "3"])[-1]
#test(["h"])[-1]
pub fun from_index(argv: [str]) -> int32 {
    if argv.len() != 3 || argv[1] != "--from" { return -1 }
    return case_index(["", "--case", argv[2]])
}

// The markers of a run `--from <n>`: one on both streams before each case,
// one on stderr after a case that ended by returning (its verdict before it,
// as a child's).
const CASE_MARK: str = "\u{1}myla-case\u{1}"
const DONE_MARK: str = "\u{1}myla-done\u{1}"

// A case of a run `--from <n>` begins.
pub fun case_begin() {
    let o = write(1, CASE_MARK)
    let e = write(2, CASE_MARK)
}

// A case of a run `--from <n>` ended by returning, with `detail` ("" when it
// passed): told on stderr as a child tells it, and the end marked.
pub fun case_end(detail: str) {
    if detail != "" { eprint("myla test: " + detail + "\n") }
    let e = write(2, DONE_MARK)
}

// A run `--from <n>` cut into its cases: for each case it began, what it
// printed on stdout and on stderr, and its status as a child's would be
// (0 for one that ended by returning, its verdict in its stderr; the run's
// `code` for the one it ended in). Output before the first case is dropped.
#test("\u{1}myla-case\u{1}a\n\u{1}myla-case\u{1}", "\u{1}myla-case\u{1}\u{1}myla-done\u{1}\u{1}myla-case\u{1}runtime error: x\n", 1)[[("a\n", "", 0), ("", "runtime error: x\n", 1)]]
#test("\u{1}myla-case\u{1}", "\u{1}myla-case\u{1}myla test: no\n\u{1}myla-done\u{1}", 0)[[("", "myla test: no\n", 0)]]
#test("", "", 1)[[]]
pub fun cut_run(stdout: str, stderr: str, code: int32) -> [(str, str, int32)] {
    let outs = pieces(stdout, CASE_MARK)
    let errs = pieces(stderr, CASE_MARK)
    var runs: [(str, str, int32)] = []
    var i = 1
    while i < errs.len() {
        let out = if i < outs.len() { outs[i] } else { "" }
        let e = errs[i]
        let ends = e.len() >= DONE_MARK.len() && after(e, e.len() - DONE_MARK.len()) == DONE_MARK
        if ends { runs.push((out, before(e, e.len() - DONE_MARK.len()), 0)) }
        else { runs.push((out, e, code)) }
        i = i + 1
    }
    return runs
}

// `text` cut at each `mark`: the piece before the first, then one after each.
#test("ab|c|", "|")[["ab", "c", ""]]
#test("abc", "|")[["abc"]]
#test("", "|")[[""]]
fun pieces(text: str, mark: str) -> [str] {
    var out: [str] = []
    var start = 0
    var i = 0
    while i + mark.len() <= text.len() {
        var k = 0
        while k < mark.len() && text[i + k] == mark[k] { k = k + 1 }
        if k == mark.len() {
            out.push(slice_of(text, start, i))
            i = i + mark.len()
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(slice_of(text, start, text.len()))
    return out
}

// A child's end: its case passed (`detail` empty, status 0), or failed
// with `detail`, told to the runner on stderr (status 1).
pub fun child_done(detail: str) {
    if detail == "" { exit(0) }
    eprint("myla test: " + detail + "\n")
    exit(1)
}

// The runner: every case in a child process of `program` (this harness),
// the report printed as `myla test` prints it; Some(status), 0 when all
// passed. None when the first child could not be started: the cases run in
// this process instead (`report_inline`).
pub fun run_in_children(program: str, cases: [Case]) -> Option<int32> {
    var passed = 0
    var k = 0
    // under an emulator (MYLA_TEST_EMULATOR, from `myla test --target`),
    // the children run under it too
    var words: [str] = []
    match env("MYLA_TEST_EMULATOR") {
        Some(e) => { words = split_words(e) },
        None => {},
    }
    var exe = program
    var lead: [str] = []
    if words.len() > 0 {
        exe = words[0]
        var i = 1
        while i < words.len() {
            lead.push(words[i])
            i = i + 1
        }
        lead.push(program)
    }
    var base = match env("TMPDIR") { Some(d) => d, None => "" }
    if base == "" { base = "/tmp" }
    let root = f"{base}/myla-test-{now_ns()}"
    var lines: [str] = []
    while k < cases.len() {
        let dir = f"{root}/c{k}"
        var argv = lead
        argv.push("--case")
        argv.push(f"{k}")
        let ran = command(exe).args(argv).env("MYLA_TEST_DIR", dir).stdin("").output()
        var started = true
        var out = Output { stdout: [], stderr: [], status: ExitStatus.Exited(0) }
        match ran {
            Ok(o) => { out = o },
            Err(e) => { started = false },
        }
        if fs.exists(dir) { let gone = fs.remove_dir_all(dir) }
        if !started {
            if k == 0 { return None }
            lines.push(f"FAIL  {cases[k].name}: could not start the case's process\n")
        } else {
            let code = match out.status {
                ExitStatus.Exited(c) => c,
                ExitStatus.Signaled(s) => -s,
            }
            let (detail, shown) = case_detail(cases[k], text(out.stdout), text(out.stderr), code)
            if detail == "" { passed = passed + 1 }
            for l in case_lines(cases[k], detail, shown) { lines.push(l) }
        }
        k = k + 1
    }
    if fs.exists(root) { let gone = fs.remove_dir_all(root) }
    for l in lines { let w = write(1, l) }
    return Some(summary(passed, cases.len()))
}

// A case's lines in the report: PASS, or FAIL with the detail and the
// output lines it printed under it.
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", ["x"])[["PASS  t\n"]]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "a\nb", ["x"])[["FAIL  t: a\\nb\n", "      | x\n"]]
pub fun case_lines(c: Case, detail: str, shown: [str]) -> [str] {
    if detail == "" { return [f"PASS  {c.name}\n"] }
    var lines = [f"FAIL  {c.name}: {on_one_line(detail)}\n"]
    for l in shown { lines.push("      | " + l + "\n") }
    return lines
}

// What a child's run says of its case: the detail ("" when it passed) and
// the output lines to show under a FAIL line. The child's stderr but the
// verdict and the runtime error is passed on.
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "x\n", "", 0)[("", ["x"])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "x\n", "myla test: expected 1, got 2\n", 1)[("expected 1, got 2", ["x"])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "runtime error: boom\n  --> t.my:1:1\n", 1)[("runtime error: boom", [])]
#test(Case { name: "t", kind: 1, message: "boom", code: 0 }, "", "runtime error: boom\n  --> t.my:1:1\n", 1)[("", [])]
#test(Case { name: "t", kind: 1, message: "list index 3 out of bounds (len 3)", code: 0 }, "", "runtime error: index out of bounds\n", 1)[("expected runtime error 'list index 3 out of bounds (len 3)', got runtime error 'index out of bounds'", [])]
#test(Case { name: "t", kind: 1, message: "boom", code: 0 }, "", "", 3)[("expected runtime error 'boom', exited with status 3", [])]
#test(Case { name: "t", kind: 2, message: "", code: 3 }, "", "", 3)[("", [])]
#test(Case { name: "t", kind: 2, message: "", code: 3 }, "", "", 0)[("expected exit status 3, exited with status 0", [])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "", 2)[("exited with status 2", [])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "", -9)[("killed by signal 9", [])]
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "runtime error: expected a\n, got b\n\n  --> t.my:1:1\n", 1)[("runtime error: expected a\n, got b\n", [])]
pub fun case_detail(c: Case, stdout: str, stderr: str, code: int32) -> (str, [str]) {
    let (detail, shown, rest) = case_outcome(c, stdout, stderr, code)
    if rest != "" { eprint(rest) }
    return (detail, shown)
}

// `case_detail`'s detail and lines, and the rest of the child's stderr,
// which `case_detail` passes on.
#test(Case { name: "t", kind: 0, message: "", code: 0 }, "", "warn\nmyla test: no\n", 1)[("no", [], "warn\n")]
pub fun case_outcome(c: Case, stdout: str, stderr: str, code: int32) -> (str, [str], str) {
    let shown = lines_of(stdout)
    var verdict = ""
    var failure = ""
    var has_failure = false
    var in_message = false     // a message's further lines, before its position
    var passed_on = StringBuilder()
    for l in lines_of(stderr) {
        if verdict == "" && starts_with(l, "myla test: ") { verdict = after(l, 11)
            continue }
        if !has_failure && starts_with(l, "runtime error: ") {
            failure = after(l, 15)
            has_failure = true
            in_message = true
            continue
        }
        if in_message {
            if starts_with(l, "  --> ") { in_message = false }
            else { failure = failure + "\n" + l }
            continue
        }
        if has_failure && (starts_with(l, "  --> ") || starts_with(l, "  |") || starts_with(l, "   |")) { continue }
        passed_on.append(l)
        passed_on.append("\n")
    }
    let rest = passed_on.build()
    if verdict != "" { return (verdict, shown, rest) }
    if has_failure {
        if c.kind == 1 {
            if starts_with(failure, c.message) || starts_with(c.message, failure) { return ("", shown, rest) }
            return (f"expected runtime error '{c.message}', got runtime error '{failure}'", shown, rest)
        }
        if c.kind == 2 { return (f"expected exit status {c.code}, got runtime error '{failure}'", shown, rest) }
        return ("runtime error: " + failure, shown, rest)
    }
    if code < 0 { return (f"killed by signal {-code}", shown, rest) }
    if code == 0 {
        if c.kind == 2 { return (f"expected exit status {c.code}, exited with status 0", shown, rest) }
        return ("", shown, rest)
    }
    if c.kind == 1 { return (f"expected runtime error '{c.message}', exited with status {code}", shown, rest) }
    if c.kind == 2 {
        if code == c.code { return ("", shown, rest) }
        return (f"expected exit status {c.code}, exited with status {code}", shown, rest)
    }
    return (f"exited with status {code}", shown, rest)
}

// A case run in this process (no children here), which gave `detail`: its
// line printed now, so that a later failure that ends the run leaves it;
// whether it passed. (A `[panic]` or `[exit]` case can't pass this way:
// the failure ends the run.)
pub fun report_inline(c: Case, detail: str) -> bool {
    if detail == "" {
        let w = write(1, f"PASS  {c.name}\n")
        return true
    }
    let w = write(1, f"FAIL  {c.name}: {on_one_line(detail)}\n")
    return false
}

// The harness ends with `status`.
pub fun end(status: int32) {
    exit(status)
}

// The summary line, and the status to end with.
pub fun summary(passed: int32, total: int32) -> int32 {
    let w = write(1, f"\n{passed}/{total} passed.\n")
    if passed == total { return 0 }
    return 1
}

// `bytes` as text.
fun text(bytes: [uint8]) -> str {
    var sb = StringBuilder()
    for b in bytes { sb.append_byte(b) }
    return sb.build()
}

#test("a\nb\n")[["a", "b"]]
#test("a")[["a"]]
#test("")[[]]
fun lines_of(text: str) -> [str] {
    var out: [str] = []
    var line = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == '\n' {
            out.push(line.build())
            line = StringBuilder()
        } else {
            line.append_byte(text[i])
        }
        i = i + 1
    }
    let rest = line.build()
    if rest.len() > 0 { out.push(rest) }
    return out
}

// `s` from its byte `n` on (no slice: the harness of `std.slice` itself
// must build).
#test("myla test: x", 11)["x"]
fun after(s: str, n: int32) -> str {
    return slice_of(s, n, s.len())
}

// `s` before its byte `n`.
#test("ab|", 2)["ab"]
fun before(s: str, n: int32) -> str {
    return slice_of(s, 0, n)
}

#test("abc", 1, 2)["b"]
fun slice_of(s: str, a: int32, b: int32) -> str {
    var sb = StringBuilder()
    sb.append(s, a, b)
    return sb.build()
}

#test("myla test: x", "myla test: ")[true]
#test("my", "myla")[false]
fun starts_with(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() { return false }
    var i = 0
    while i < prefix.len() {
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    return true
}

#test("node run.mjs")[["node", "run.mjs"]]
fun split_words(text: str) -> [str] {
    var out: [str] = []
    var word = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == ' ' {
            let w = word.build()
            if w.len() > 0 { out.push(w) }
            word = StringBuilder()
        } else {
            word.append_byte(text[i])
        }
        i = i + 1
    }
    let w = word.build()
    if w.len() > 0 { out.push(w) }
    return out
}

#test("a\nb")["a\\nb"]
fun on_one_line(text: str) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < text.len() {
        if text[i] == '\n' { sb.append("\\n") } else { sb.append_byte(text[i]) }
        i = i + 1
    }
    return sb.build()
}

// --- Values as the report shows them (the interpreter's forms) -----------

// A string as the report quotes it (Python's repr: single quotes unless
// the text has one and no double quote; `\n`, `\t`, `\r`, `\\`, the quote
// and `\xNN` for the other control characters).
#test("it's")["\"it's\""]
#test("a\nb")["'a\\nb'"]
#test("say \"hi\"")["'say \"hi\"'"]
#test("")["''"]
pub fun repr_str(s: str) -> str {
    var has_single = false
    var has_double = false
    for c in s.chars() {
        if c == '\'' { has_single = true }
        if c == '"' { has_double = true }
    }
    var quote = '\''
    if has_single && !has_double { quote = '"' }
    var sb = StringBuilder()
    sb.append(f"{quote}")
    for c in s.chars() {
        let cp = c as int32
        if c == '\\' { sb.append("\\\\") }
        else if c == quote { sb.append(f"\\{c}") }
        else if cp == 10 { sb.append("\\n") }
        else if cp == 9 { sb.append("\\t") }
        else if cp == 13 { sb.append("\\r") }
        else if cp < 32 || (cp >= 127 && cp <= 160) || cp == 173 { sb.append(f"\\x{hex2(cp)}") }
        else { sb.append(f"{c}") }
    }
    sb.append(f"{quote}")
    return sb.build()
}

#test(24)["18"]
#test(108)["6c"]
fun hex2(v: int32) -> str {
    let digits = "0123456789abcdef"
    var sb = StringBuilder()
    sb.append_byte(digits[(v / 16) % 16])
    sb.append_byte(digits[v % 16])
    return sb.build()
}

// `text` with the module ids taken off the names in it, as the report
// shows an `Err(e)` of a test function: `std$fs$IoError.NotFound` is
// `IoError.NotFound`.
#test("std$fs$IoError.NotFound")["IoError.NotFound"]
#test("plain")["plain"]
pub fun without_module_ids(text: str) -> str {
    var sb = StringBuilder()
    var word = StringBuilder()
    var i = 0
    while i < text.len() {
        let c = text[i]
        if c == '$' {
            word = StringBuilder()
        } else if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
            word.append_byte(c)
        } else {
            sb.append(word.build())
            word = StringBuilder()
            sb.append_byte(c)
        }
        i = i + 1
    }
    sb.append(word.build())
    return sb.build()
}
