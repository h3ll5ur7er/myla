// std.json — JSON values, parsing and serialization (MYLA-79).
//
// `parse` reads a JSON text into a `Json` value and `to_string` writes one
// compactly. Both follow Python's `json` module, which the tests compare them
// with: the same values, the same error messages and positions (Python
// 3.13's wording), and `to_string` writes what
// `json.dumps(v, ensure_ascii=False, separators=(",", ":"))` writes. Like
// Python, they accept and write `NaN`, `Infinity` and `-Infinity`. Unlike
// Python, a `\u` escape of a lone surrogate is an error, since a Myla string
// holds UTF-8.
//
// Typed values (D172, MYLA-385): `ToJson` and `FromJson`, their impls for
// the built-in types, and `encode`/`decode<T>` over them; `#derive(Json)`
// writes a struct's or an enum's impls, calling the helpers below
// (`members`, `member`, `optional_member`, `variant_of`, `unit_variant`,
// `payload`, `unknown_variant`) by name, so they keep their signatures.

from .num import parse_int, parse_float, format_float

// A JSON value. A number without a fraction or exponent that fits in int64 is
// an `Int`, any other number a `Float`. An object keeps its members in order,
// duplicates included (`field` finds the last one, as Python keeps it).
pub enum Json {
    Null,
    Bool(bool),
    Int(int64),
    Float(float64),
    Str(str),
    Array([Json]),
    Object([(str, Json)]),
}

// What is wrong: a text that isn't JSON (`parse`), or a value that doesn't
// fit the type it is read into (`decode`, `FromJson`, D172).
#derive(Eq)
pub enum JsonErrorKind {
    // The text isn't JSON: `msg` is Python's message, `line` and `col` where
    Syntax,
    // An object without a field its type needs (the path names the field)
    MissingField,
    // A value of another kind than its type takes: a string for a number, an
    // array for a struct, a fraction for an integer, a variant with or
    // without a payload it hasn't
    WrongType,
    // A number its type can't hold: an integer too large or too small for it
    OutOfRange,
    // A name that isn't one of the enum's variants
    UnknownVariant,
}

// Why a text isn't JSON or a value doesn't fit its type, and where: for a
// `Syntax` error the line and column in the text (counting from 1, the
// column in characters); for the others the path of the value in the
// document, `$.items[2].label` (`$` the whole of it), and a line and column
// of 0. The one error of another kind with a line and column is `decode`'s
// `OutOfRange` for an integer beyond int64 that it can't read exactly,
// found while the text is parsed, before any path is known.
#derive(Eq)
pub struct JsonError {
    kind: JsonErrorKind,
    msg: str,
    line: int32,
    col: int32,
    path: str,
}

impl JsonError {
    // The reason in words, without the position.
    #test(JsonError { kind: JsonErrorKind.MissingField, msg: "missing field", line: 0, col: 0, path: "$.a" })["missing field"]
    fun message(self) -> str {
        return self.msg
    }
}

impl Format for JsonError {
    // `line:col: why` for an error in the text, `path: why` for the others.
    #test(JsonError { kind: JsonErrorKind.Syntax, msg: "Expecting value", line: 1, col: 5, path: "" }, "")["1:5: Expecting value"]
    #test(JsonError { kind: JsonErrorKind.OutOfRange, msg: "300 is out of range for uint8", line: 0, col: 0, path: "$.items[2].n" }, "")["$.items[2].n: 300 is out of range for uint8"]
    #test(JsonError { kind: JsonErrorKind.OutOfRange, msg: "why", line: 2, col: 3, path: "" }, "")["2:3: why"]
    fun format(self, spec: str) -> str {
        if self.kind == JsonErrorKind.Syntax || self.line > 0 { return f"{self.line}:{self.col}: {self.msg}" }
        return f"{self.path}: {self.msg}"
    }
}

// The member `key` of an object (the last one with that key); None if `j`
// isn't an object or has no such member.
pub fun field(j: Json, key: str) -> Option<Json> {
    var found: Option<Json> = None
    match j {
        Json.Object(members) => {
            for m in members {
                if m.0 == key { found = Some(m.1) }
            }
        },
        _ => {},
    }
    return found
}

// --- Parsing ------------------------------------------------------------------

// How deeply arrays and objects may nest. The parser recurses once per
// level, and the interpreters run it on their own stack: the self-hosted
// interpreter's frames are large (it dies at about 300 levels), so the limit
// is what every implementation survives, not what native code could take.
const MAX_DEPTH: int32 = 200

struct Parser {
    s: str,
    i: int32,
    // `decode`'s: an integer beyond int64 that its float64 doesn't hold
    // exactly is an error, not a float that has lost its low bits
    exact: bool,
}

// The JSON value that `text` holds, with optional whitespace around it.
pub fun parse(text: str) -> Result<Json, JsonError> {
    return parse_with(text, false)
}

fun parse_with(text: str, exact: bool) -> Result<Json, JsonError> {
    var p = Parser { s: text, i: 0, exact: exact }
    let v = p.value(0)?
    p.skip_ws()
    if p.i < text.len() { return Err(p.error("Extra data", p.i)) }
    return Ok(v)
}

impl Parser {
    // An error at byte offset `at`.
    fun error(self, msg: str, at: int32) -> JsonError {
        var line = 1
        var col = 1
        var k = 0
        while k < at {
            let c = self.s[k]
            if c == '\n' {
                line = line + 1
                col = 1
            } else if c < 128u8 || c >= 192u8 {
                col = col + 1                  // not a UTF-8 continuation byte
            }
            k = k + 1
        }
        return JsonError { kind: JsonErrorKind.Syntax, msg: msg, line: line, col: col, path: "" }
    }

    fun at_end(self) -> bool {
        return self.i >= self.s.len()
    }

    fun skip_ws(var self) {
        while !self.at_end() {
            let c = self.s[self.i]
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' { self.i = self.i + 1 } else { return }
        }
    }

    // Whether the text at the current position starts with `word`.
    fun looking_at(self, word: str) -> bool {
        if self.i + word.len() > self.s.len() { return false }
        var k = 0
        while k < word.len() {
            if self.s[self.i + k] != word[k] { return false }
            k = k + 1
        }
        return true
    }

    // Move past `word` if the text continues with it.
    fun take(var self, word: str) -> bool {
        if !self.looking_at(word) { return false }
        self.i = self.i + word.len()
        return true
    }

    fun value(var self, depth: int32) -> Result<Json, JsonError> {
        self.skip_ws()
        if self.at_end() { return Err(self.error("Expecting value", self.i)) }
        let c = self.s[self.i]
        if c == '"' { return Ok(Json.Str(self.string()?)) }
        if c == '{' || c == '[' {
            if depth >= MAX_DEPTH { return Err(self.error("Too deeply nested", self.i)) }
            if c == '{' { return self.object(depth + 1) }
            return self.array(depth + 1)
        }
        if self.take("null") { return Ok(Json.Null) }
        if self.take("true") { return Ok(Json.Bool(true)) }
        if self.take("false") { return Ok(Json.Bool(false)) }
        if self.take("NaN") { return Ok(Json.Float(0.0f64 / 0.0f64)) }
        if self.take("Infinity") { return Ok(Json.Float(1.0f64 / 0.0f64)) }
        if self.take("-Infinity") { return Ok(Json.Float(-1.0f64 / 0.0f64)) }
        return self.number()
    }

    fun digits(var self) -> int32 {
        let start = self.i
        while !self.at_end() && self.s[self.i] >= '0' && self.s[self.i] <= '9' { self.i = self.i + 1 }
        return self.i - start
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)? ; an optional part that
    // is incomplete is left for the caller, as Python's scanner does.
    fun number(var self) -> Result<Json, JsonError> {
        let start = self.i
        if self.s[self.i] == '-' { self.i = self.i + 1 }
        if self.at_end() || self.s[self.i] < '0' || self.s[self.i] > '9' {
            return Err(self.error("Expecting value", start))
        }
        if self.s[self.i] == '0' { self.i = self.i + 1 } else { self.digits() }
        var integral = true
        if self.i + 1 < self.s.len() && self.s[self.i] == '.' && self.s[self.i + 1] >= '0' && self.s[self.i + 1] <= '9' {
            self.i = self.i + 1
            self.digits()
            integral = false
        }
        if !self.at_end() && (self.s[self.i] == 'e' || self.s[self.i] == 'E') {
            let mark = self.i
            self.i = self.i + 1
            if !self.at_end() && (self.s[self.i] == '+' || self.s[self.i] == '-') { self.i = self.i + 1 }
            if self.digits() == 0 { self.i = mark } else { integral = false }
        }
        var sb = StringBuilder()
        sb.append(self.s, start, self.i)
        let text = sb.build()
        if integral {
            match parse_int(text) {
                Some(n) => { return Ok(Json.Int(n)) },
                None => {},                       // too large for int64
            }
        }
        return match parse_float(text) {
            Some(f) => {
                if integral && self.exact && !holds_exactly(f, text) {
                    var e = self.error(f"{text} can't be read exactly: beyond int64's range a number is a float64", start)
                    e.kind = JsonErrorKind.OutOfRange
                    return Err(e)
                }
                Ok(Json.Float(f))
            },
            None => Err(self.error("Expecting value", start)),
        }
    }

    // The value of the hex digits s[i..i+4], or -1.
    fun hex4(self, i: int32) -> int32 {
        if i + 4 > self.s.len() { return -1 }
        var v = 0
        var k = i
        while k < i + 4 {
            let c = self.s[k]
            var d = -1
            if c >= '0' && c <= '9' { d = (c - '0') as int32 }
            if c >= 'a' && c <= 'f' { d = (c - 'a') as int32 + 10 }
            if c >= 'A' && c <= 'F' { d = (c - 'A') as int32 + 10 }
            if d < 0 { return -1 }
            v = v * 16 + d
            k = k + 1
        }
        return v
    }

    // A string, the current position at its opening quote.
    fun string(var self) -> Result<str, JsonError> {
        let quote = self.i
        self.i = self.i + 1
        var sb = StringBuilder()
        var run = self.i                         // start of bytes to copy as they are
        while true {
            if self.at_end() { return Err(self.error("Unterminated string starting at", quote)) }
            let c = self.s[self.i]
            if c == '"' {
                sb.append(self.s, run, self.i)
                self.i = self.i + 1
                return Ok(sb.build())
            }
            if c < 32u8 { return Err(self.error("Invalid control character at", self.i)) }
            if c != '\\' {
                self.i = self.i + 1
            } else {
                sb.append(self.s, run, self.i)
                if self.i + 1 >= self.s.len() { return Err(self.error("Unterminated string starting at", quote)) }
                let e = self.s[self.i + 1]
                if e == 'u' {
                    let cp = self.unicode_escape()?
                    sb.append(f"{cp as char}")
                } else {
                    if e == '"' { sb.append_byte('"') }
                    else if e == '\\' { sb.append_byte('\\') }
                    else if e == '/' { sb.append_byte('/') }
                    else if e == 'b' { sb.append_byte(8u8) }
                    else if e == 'f' { sb.append_byte(12u8) }
                    else if e == 'n' { sb.append_byte('\n') }
                    else if e == 'r' { sb.append_byte(13u8) }
                    else if e == 't' { sb.append_byte('\t') }
                    else { return Err(self.error("Invalid \\escape", self.i)) }
                    self.i = self.i + 2
                }
                run = self.i
            }
        }
        unreachable()
    }

    // The code point of a `\uXXXX` escape (a surrogate pair is two), the
    // current position at its backslash; moves past it.
    fun unicode_escape(var self) -> Result<uint32, JsonError> {
        let u = self.i + 1
        let hi = self.hex4(u + 1)
        if hi < 0 { return Err(self.error("Invalid \\uXXXX escape", u)) }
        self.i = u + 5
        if hi >= 56320 && hi < 57344 { return Err(self.error("Lone surrogate in \\uXXXX escape", u)) }
        if hi < 55296 || hi >= 56320 { return Ok(hi as uint32) }
        // a high surrogate: a low one must follow
        if !self.looking_at("\\u") { return Err(self.error("Lone surrogate in \\uXXXX escape", u)) }
        let lo = self.hex4(self.i + 2)
        if lo < 0 { return Err(self.error("Invalid \\uXXXX escape", self.i + 1)) }
        if lo < 56320 || lo >= 57344 { return Err(self.error("Lone surrogate in \\uXXXX escape", u)) }
        self.i = self.i + 6
        return Ok((65536 + (hi - 55296) * 1024 + (lo - 56320)) as uint32)
    }

    // An array, the current position at its "[".
    fun array(var self, depth: int32) -> Result<Json, JsonError> {
        self.i = self.i + 1
        var items: [Json] = []
        self.skip_ws()
        if !self.at_end() && self.s[self.i] == ']' {
            self.i = self.i + 1
            return Ok(Json.Array(items))
        }
        while true {
            items.push(self.value(depth)?)
            self.skip_ws()
            if self.at_end() { return Err(self.error("Expecting ',' delimiter", self.i)) }
            let c = self.s[self.i]
            if c == ']' {
                self.i = self.i + 1
                return Ok(Json.Array(items))
            }
            if c != ',' { return Err(self.error("Expecting ',' delimiter", self.i)) }
            let comma = self.i
            self.i = self.i + 1
            self.skip_ws()
            if !self.at_end() && self.s[self.i] == ']' {
                return Err(self.error("Illegal trailing comma before end of array", comma))
            }
        }
        unreachable()
    }

    // An object, the current position at its "{".
    fun object(var self, depth: int32) -> Result<Json, JsonError> {
        self.i = self.i + 1
        var members: [(str, Json)] = []
        self.skip_ws()
        if !self.at_end() && self.s[self.i] == '}' {
            self.i = self.i + 1
            return Ok(Json.Object(members))
        }
        while true {
            if self.at_end() || self.s[self.i] != '"' {
                return Err(self.error("Expecting property name enclosed in double quotes", self.i))
            }
            let key = self.string()?
            self.skip_ws()
            if self.at_end() || self.s[self.i] != ':' { return Err(self.error("Expecting ':' delimiter", self.i)) }
            self.i = self.i + 1
            let v = self.value(depth)?
            members.push((key, v))
            self.skip_ws()
            if self.at_end() { return Err(self.error("Expecting ',' delimiter", self.i)) }
            let c = self.s[self.i]
            if c == '}' {
                self.i = self.i + 1
                return Ok(Json.Object(members))
            }
            if c != ',' { return Err(self.error("Expecting ',' delimiter", self.i)) }
            let comma = self.i
            self.i = self.i + 1
            self.skip_ws()
            if !self.at_end() && self.s[self.i] == '}' {
                return Err(self.error("Illegal trailing comma before end of object", comma))
            }
        }
        unreachable()
    }
}

// --- Writing ------------------------------------------------------------------

// `j` as compact JSON text.
#test(Json.Array([Json.Int(1), Json.Float(2.5), Json.Str("a\"b"), Json.Null]))["[1,2.5,\"a\\\"b\",null]"]
#test(Json.Object([("k", Json.Bool(true)), ("e", Json.Object([]))]))["{\"k\":true,\"e\":{}}"]
#test(Json.Array([Json.Float(1.0 / 0.0), Json.Float(-1.0 / 0.0), Json.Float(0.0 / 0.0)]))["[null,null,null]"] // JSON has no NaN or infinity
pub fun to_string(j: Json) -> str {
    var w = Writer { sb: StringBuilder() }
    w.value(j)
    return w.sb.build()
}

struct Writer {
    sb: StringBuilder,
}

impl Writer {
    fun value(var self, j: Json) {
        match j {
            Json.Null => { self.sb.append("null") },
            Json.Bool(b) => {
                if b { self.sb.append("true") } else { self.sb.append("false") }
            },
            Json.Int(n) => { self.sb.append(f"{n}") },
            Json.Float(f) => {
                // JSON has no NaN or infinity: `null`, as JavaScript writes them
                if f - f != 0.0 { self.sb.append("null") } else { self.sb.append(float_text(f)) }
            },
            Json.Str(s) => { self.string(s) },
            Json.Array(items) => {
                self.sb.append_byte('[')
                var first = true
                for item in items {
                    if !first { self.sb.append_byte(',') }
                    self.value(item)
                    first = false
                }
                self.sb.append_byte(']')
            },
            Json.Object(members) => {
                self.sb.append_byte('{')
                var first = true
                for m in members {
                    if !first { self.sb.append_byte(',') }
                    self.string(m.0)
                    self.sb.append_byte(':')
                    self.value(m.1)
                    first = false
                }
                self.sb.append_byte('}')
            },
        }
    }

    // `s` quoted: '"' and '\\' escaped, control characters as \n, \t … or
    // \u00XX; everything else (non-ASCII included) as it is.
    fun string(var self, s: str) {
        self.sb.append_byte('"')
        var run = 0
        var i = 0
        while i < s.len() {
            let c = s[i]
            if c == '"' || c == '\\' || c < 32u8 {
                self.sb.append(s, run, i)
                if c == '"' { self.sb.append("\\\"") }
                else if c == '\\' { self.sb.append("\\\\") }
                else if c == '\n' { self.sb.append("\\n") }
                else if c == '\t' { self.sb.append("\\t") }
                else if c == 13u8 { self.sb.append("\\r") }
                else if c == 8u8 { self.sb.append("\\b") }
                else if c == 12u8 { self.sb.append("\\f") }
                else {
                    self.sb.append("\\u00")
                    self.sb.append_byte(HEX[(c >> 4u8) as int32])
                    self.sb.append_byte(HEX[(c & 15u8) as int32])
                }
                run = i + 1
            }
            i = i + 1
        }
        self.sb.append(s, run, s.len())
        self.sb.append_byte('"')
    }
}

const HEX: str = "0123456789abcdef"

// A float as Python's json writes it: its shortest repr, with NaN and the
// infinities spelled as JavaScript does (for messages: `to_string` writes
// them as `null`).
#test(0.1)["0.1"]
#test(1e16)["1e+16"]
fun float_text(f: float64) -> str {
    let t = format_float(f)
    if t == "nan" { return "NaN" }
    if t == "inf" { return "Infinity" }
    if t == "-inf" { return "-Infinity" }
    return t
}

// Whether the float `f` read from the integer `text` (beyond int64) is that
// integer. Below 2^64 in size it must be, as an integer type could take it;
// from 2^64 on no integer type can, and a float type takes the nearest.
#test(9223372036854775808.0, "9223372036854775808")[true]
#test(9223372036854775808.0, "9223372036854775809")[false]
#test(-9223372036854775808.0, "-9223372036854775809")[false]
#test(18446744073709551616.0, "18446744073709551615")[true]
fun holds_exactly(f: float64, text: str) -> bool {
    var a = f
    var digits = text
    if f < 0.0 {
        a = -f
        digits = text[1:]
    }
    if a >= 18446744073709551616.0 { return true }
    return f"{a as uint64}" == digits
}

// `text` parsed and written again, or the error (for the #test cases).
#test(" [1, 2.5, \"x\", true, null, {\"a\": {}}] ")["[1,2.5,\"x\",true,null,{\"a\":{}}]"]
#test("\"\\u00e9\\ud83d\\ude00\\n\"")["\"é😀\\n\""]
#test("[-0, -0.0, 1E2, 1e400, NaN]")["[0,-0.0,100.0,null,null]"] // read, but not written
#test("[1,]")["1:3: Illegal trailing comma before end of array"]
#test("{\"a\" 1}")["1:6: Expecting ':' delimiter"]
#test("[\"abc")["1:2: Unterminated string starting at"]
#test("[\"a\n")["1:4: Invalid control character at"]
#test("\"\\ud800\"")["1:3: Lone surrogate in \\uXXXX escape"]
#test("")["1:1: Expecting value"]
fun round_trip(text: str) -> str {
    return match parse(text) {
        Ok(v) => to_string(v),
        Err(e) => f"{e.line}:{e.col}: {e.msg}",
    }
}


// --- Building values ------------------------------------------------------------

// An object with these members, in order (MYLA-332).
#test([("a", Json.Int(1)), ("b", Json.Null)])[Json.Object([("a", Json.Int(1)), ("b", Json.Null)])]
pub fun obj(members: [(str, Json)]) -> Json {
    return Json.Object(members)
}

// An array of these items.
#test([Json.Int(1), Json.Str("x")])[Json.Array([Json.Int(1), Json.Str("x")])]
pub fun arr(items: [Json]) -> Json {
    return Json.Array(items)
}

// A number: an `Int` when `x` is a whole number below 2^53 in size (every
// such float64 is exact), as JavaScript writes `2.0` as `2`; a `Float`
// otherwise. A larger integer is `Json.Int(n)`, made directly.
#test(2.5)[Json.Float(2.5)]
#test(3.0)[Json.Int(3i64)]
#test(-7.0)[Json.Int(-7i64)]
#test(1e300)[Json.Float(1e300)]
pub fun num(x: float64) -> Json {
    if x > -9007199254740992.0 && x < 9007199254740992.0 {
        let n = x as int64
        if n as float64 == x {
            return Json.Int(n)
        }
    }
    return Json.Float(x)
}

// A string.
#test("hi")[Json.Str("hi")]
pub fun text(s: str) -> Json {
    return Json.Str(s)
}

// --- Reading values -------------------------------------------------------------

impl Json {
    // The integer, if this is an `Int` (a number written without a fraction
    // or an exponent).
    #test(Json.Int(5i64))[Some(5i64)]
    #test(Json.Float(5.0))[None]
    #test(Json.Str("5"))[None]
    fun as_int(self) -> Option<int64> {
        return match self {
            Json.Int(n) => Some(n)
            _ => None
        }
    }

    // The number, if this is a `Float` or an `Int`.
    #test(Json.Float(2.5))[Some(2.5)]
    #test(Json.Int(2i64))[Some(2.0)]
    #test(Json.Null)[None]
    fun as_float(self) -> Option<float64> {
        return match self {
            Json.Float(f) => Some(f)
            Json.Int(n) => Some(n as float64)
            _ => None
        }
    }

    // The string, if this is a `Str`.
    #test(Json.Str("a"))[Some("a")]
    #test(Json.Int(1i64))[None]
    fun as_str(self) -> Option<str> {
        return match self {
            Json.Str(s) => Some(s)
            _ => None
        }
    }

    // The truth value, if this is a `Bool`.
    #test(Json.Bool(false))[Some(false)]
    #test(Json.Null)[None]
    fun as_bool(self) -> Option<bool> {
        return match self {
            Json.Bool(b) => Some(b)
            _ => None
        }
    }

    // The items, if this is an `Array`.
    #test(Json.Array([Json.Null]))[Some([Json.Null])]
    #test(Json.Object([]))[None]
    fun as_list(self) -> Option<[Json]> {
        return match self {
            Json.Array(items) => Some(items)
            _ => None
        }
    }

    // The members in order, if this is an `Object`.
    #test(Json.Object([("k", Json.Int(1i64))]))[Some([("k", Json.Int(1i64))])]
    #test(Json.Array([]))[None]
    fun as_object(self) -> Option<[(str, Json)]> {
        return match self {
            Json.Object(members) => Some(members)
            _ => None
        }
    }
}

// The value at `path` inside `v`: keys of objects after dots and indexes of
// arrays in brackets, such as `a.b[2].c` or `[0].name` ("" is `v` itself). A
// key is every byte up to the next `.` or `[`, and finds what `field` finds.
// None if a step finds nothing or the path isn't of that form.
#test(path_doc(), "a.b[1].c")[Some(Json.Int(2i64))]
#test(path_doc(), "a.b[0]")[Some(Json.Int(1i64))]
#test(path_doc(), "list[1][0]")[Some(Json.Str("y"))]
#test(path_doc(), "")[Some(path_doc())]
#test(path_doc(), "a.b[2]")[None] // past the end
#test(path_doc(), "a.x")[None]
#test(path_doc(), "a[0]")[None] // not an array
#test(path_doc(), "list.x")[None] // not an object
#test(path_doc(), "a..b")[None]
#test(path_doc(), "a.")[None]
#test(path_doc(), ".a")[None]
#test(path_doc(), "list[")[None]
#test(path_doc(), "list[x]")[None]
#test(path_doc(), "list[]")[None]
#test(path_doc(), "list[99999999999]")[None]
#test(Json.Array([Json.Null, Json.Bool(true)]), "[1]")[Some(Json.Bool(true))]
pub fun at(v: Json, path: str) -> Option<Json> {
    var cur = v
    var i = 0
    let n = path.len()
    while i < n {
        if path[i] == '[' {
            i += 1
            let start = i
            var index = 0
            while i < n && path[i] >= '0' && path[i] <= '9' && i - start < 9 {
                index = index * 10 + (path[i] - '0') as int32
                i += 1
            }
            if i == start || i >= n || path[i] != ']' {
                return None
            }
            i += 1
            match cur {
                Json.Array(items) => {
                    if index >= items.len() {
                        return None
                    }
                    cur = items[index]
                }
                _ => {
                    return None
                }
            }
        } else {
            if i > 0 {
                if path[i] != '.' {
                    return None
                }
                i += 1
            }
            let start = i
            while i < n && path[i] != '.' && path[i] != '[' {
                i += 1
            }
            if i == start {
                return None
            }
            cur = field(cur, path[start:i])?
        }
    }
    return Some(cur)
}

// {"a": {"b": [1, {"c": 2}]}, "list": [["x"], ["y"]]}, for the cases of `at`.
fun path_doc() -> Json {
    let b = Json.Array([Json.Int(1), Json.Object([("c", Json.Int(2))])])
    let list = Json.Array([Json.Array([Json.Str("x")]), Json.Array([Json.Str("y")])])
    return Json.Object([("a", Json.Object([("b", b)])), ("list", list)])
}

// --- Writing with indentation ---------------------------------------------------

// `j` as JSON text with one item or member on a line, each level indented by
// `indent` more spaces, as `json.dumps(j, indent=indent, ensure_ascii=False)`
// writes it: `": "` after a key, an empty array or object as `[]` or `{}`.
// An `indent` of 0 or less starts every item on a line of its own without
// indenting it.
#test(Json.Array([Json.Int(1), Json.Array([])]), 2)["[\n  1,\n  []\n]"]
#test(Json.Object([("a", Json.Object([("b", Json.Null)])), ("c", Json.Object([]))]), 4)["{\n    \"a\": {\n        \"b\": null\n    },\n    \"c\": {}\n}"]
#test(Json.Array([Json.Str("x"), Json.Float(0.5)]), 0)["[\n\"x\",\n0.5\n]"]
#test(Json.Str("a\nb"), 2)["\"a\\nb\""]
#test(Json.Array([Json.Float(0.0 / 0.0)]), 2)["[\n  null\n]"]
pub fun pretty(j: Json, indent: int = 2) -> str {
    var p = Pretty { w: Writer { sb: StringBuilder() }, indent: if indent > 0 { indent } else { 0 } }
    p.value(j, 0)
    return p.w.sb.build()
}

struct Pretty {
    w: Writer,
    indent: int,
}

impl Pretty {
    fun value(var self, j: Json, depth: int) {
        match j {
            Json.Array(items) => {
                if items.len() == 0 {
                    self.w.sb.append("[]")
                    return
                }
                self.w.sb.append_byte('[')
                var first = true
                for item in items {
                    if !first {
                        self.w.sb.append_byte(',')
                    }
                    first = false
                    self.newline(depth + 1)
                    self.value(item, depth + 1)
                }
                self.newline(depth)
                self.w.sb.append_byte(']')
            }
            Json.Object(members) => {
                if members.len() == 0 {
                    self.w.sb.append("{}")
                    return
                }
                self.w.sb.append_byte('{')
                var first = true
                for m in members {
                    if !first {
                        self.w.sb.append_byte(',')
                    }
                    first = false
                    self.newline(depth + 1)
                    self.w.string(m.0)
                    self.w.sb.append(": ")
                    self.value(m.1, depth + 1)
                }
                self.newline(depth)
                self.w.sb.append_byte('}')
            }
            _ => {
                self.w.value(j)
            }
        }
    }

    // A line end and the indentation of `depth` levels.
    fun newline(var self, depth: int) {
        self.w.sb.append_byte('\n')
        var k = depth * self.indent
        while k > 0 {
            self.w.sb.append_byte(' ')
            k -= 1
        }
    }
}

// What `pretty` writes, `parse` reads back as `to_string` writes it.
#test
fun pretty_round_trip() {
    let text = "{\"a\": [1, 2.5, \"x\\ty\", true, null, {}, []], \"b\": {\"c\": {\"d\": [[]]}}, \"é\": -0.0}"
    match parse(text) {
        Ok(v) => {
            match parse(pretty(v)) {
                Ok(back) => assert(to_string(back) == to_string(v), pretty(v))
                Err(e) => assert(false, e.msg)
            }
        }
        Err(e) => assert(false, e.msg)
    }
}

// --- Typed values (D172, MYLA-385) ------------------------------------------------

// A value with a JSON form. `#derive(Json)` writes the impl for a struct (an
// object of its fields, named as written, an `Option` field left out when it
// is `None`) and for an enum (`"Red"` for a variant without payload,
// `{"Dot": x}` for one with one, `{"Line": [a, b]}` for one with more).
// Writing never fails: a non-finite float is `null`, a `uint64` beyond
// `int64` a float.
pub trait ToJson {
    fun to_json(self) -> Json
}

// A value read from its JSON form: `Point.from_json(j)`, `T.from_json(j)`
// under a bound `T: FromJson`. An integer is checked for its type's range,
// a struct ignores members it has no field for, and an error says where it
// is (`$.items[2].label`).
pub trait FromJson {
    fun from_json(j: Json) -> Result<Self, JsonError>
}

// `v` as compact JSON text, as `to_string` writes `v.to_json()`.
pub fun encode<T: ToJson>(v: T) -> str {
    return to_string(v.to_json())
}

// The value of type `T` that `text` holds: `json.decode<Point>(text)`, or
// with the type from where the result goes (`let p: Result<Point, JsonError>
// = json.decode(text)`). A text that isn't JSON is a `Syntax` error, a value
// that doesn't fit `T` an error with its path. Unlike `parse`, it refuses an
// integer beyond int64, below 2^64 in size, that a float64 doesn't hold
// exactly (`OutOfRange` at its line and column, D184), which an integer
// type would read without its low bits.
pub fun decode<T: FromJson>(text: str) -> Result<T, JsonError> {
    let j = parse_with(text, true)?
    return T.from_json(j)
}

// `decode` of integers beyond int64 (MYLA-424).
#test("9223372036854775808")[Ok(9223372036854775808u64)] // 2^63: a float64 holds it
#test("9223372036854775809")[Err(JsonError { kind: JsonErrorKind.OutOfRange, msg: "9223372036854775809 can't be read exactly: beyond int64's range a number is a float64", line: 1, col: 1, path: "" })]
#test(" 18446744073709549568")[Ok(18446744073709549568u64)] // the largest float64 below 2^64
#test("18446744073709551615")[Err(JsonError { kind: JsonErrorKind.OutOfRange, msg: "1.8446744073709552e+19 is out of range for uint64", line: 0, col: 0, path: "$" })]
fun decodes_uint64(text: str) -> Result<uint64, JsonError> {
    return decode<uint64>(text)
}

#test("-9223372036854775808")[Ok([-9223372036854775807i64 - 1])]
#test("[1, -9223372036854775809]")[Err(JsonError { kind: JsonErrorKind.OutOfRange, msg: "-9223372036854775809 can't be read exactly: beyond int64's range a number is a float64", line: 1, col: 5, path: "" })]
#test("[-9223372036854775808]")[Ok([-9223372036854775807i64 - 1])]
fun decodes_int64s(text: str) -> Result<[int64], JsonError> {
    if text[0] == '[' { return decode<[int64]>(text) }
    return Ok([decode<int64>(text)?])
}

// The error for a value `found` where `expected` (in words: "an integer",
// "a color") should be, at the value itself (`$`), for a `FromJson` impl
// written by hand: `Err(json.wrong_type("a color", j))`.
#test("a color", Json.Int(3i64))[JsonError { kind: JsonErrorKind.WrongType, msg: "expected a color, found the number 3", line: 0, col: 0, path: "$" }]
pub fun wrong_type(expected: str, found: Json) -> JsonError {
    return value_error(JsonErrorKind.WrongType, f"expected {expected}, found {described(found)}")
}

// The members of the object `j`, for a `FromJson` impl of the type `name`
// (a derived one, or one written by hand); not an object is an error.
#test(Json.Object([("a", Json.Null)]), "P")[Ok([("a", Json.Null)])]
#test(Json.Array([]), "P")[Err(JsonError { kind: JsonErrorKind.WrongType, msg: "expected an object for 'P', found an empty array", line: 0, col: 0, path: "$" })]
pub fun members(j: Json, name: str) -> Result<[(str, Json)], JsonError> {
    return match j {
        Json.Object(ms) => Ok(ms)
        _ => Err(wrong_type(f"an object for '{name}'", j))
    }
}

// The member `name` of an object's `fields` (the last one of that name, as
// `field` finds it) as a `T`; an error if there is none, or with the
// member's step added to its path.
pub fun member<T: FromJson>(fields: [(str, Json)], name: str) -> Result<T, JsonError> {
    return match last_member(fields, name) {
        Some(v) => within(T.from_json(v), key_step(name))
        None => Err(JsonError { kind: JsonErrorKind.MissingField, msg: "missing field", line: 0, col: 0, path: "$" + key_step(name) })
    }
}

// The member `name` of `fields` as an optional `T`: `None` when it is absent
// or `null`.
pub fun optional_member<T: FromJson>(fields: [(str, Json)], name: str) -> Result<Option<T>, JsonError> {
    return match last_member(fields, name) {
        Some(Json.Null) => Ok(None)
        Some(v) => Ok(Some(within(T.from_json(v), key_step(name))?))
        None => Ok(None)
    }
}

// The last member of `fields` named `name`.
fun last_member(fields: [(str, Json)], name: str) -> Option<Json> {
    var found: Option<Json> = None
    for m in fields {
        if m.0 == name { found = Some(m.1) }
    }
    return found
}

// `r`, its error one step further in: `step` (`.name`, `[2]`) after the `$`.
fun within<T>(r: Result<T, JsonError>, step: str) -> Result<T, JsonError> {
    return match r {
        Ok(v) => Ok(v)
        Err(e) => Err(JsonError { kind: e.kind, msg: e.msg, line: e.line, col: e.col, path: "$" + step + e.path[1:] })
    }
}

// The step of a path into the member `key`: `.key` for a name, `["a b"]` for
// another key.
#test("label")[".label"]
#test("_x9")["._x9"]
#test("a b")["[\"a b\"]"]
#test("")["[\"\"]"]
#test("9")["[\"9\"]"]
fun key_step(key: str) -> str {
    var plain = key.len() > 0 && !(key[0] >= '0' && key[0] <= '9')
    for c in key.chars() {
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') { plain = false }
    }
    if plain { return "." + key }
    return "[" + to_string(Json.Str(key)) + "]"
}

// An error at the value itself (`$`).
fun value_error(kind: JsonErrorKind, msg: str) -> JsonError {
    return JsonError { kind: kind, msg: msg, line: 0, col: 0, path: "$" }
}

// What `j` is, for an error: "null", "a string", "the number 1.5", …
#test(Json.Float(1.5))["the number 1.5"]
#test(Json.Array([Json.Null]))["an array of 1 item"]
#test(Json.Object([]))["an object"]
fun described(j: Json) -> str {
    return match j {
        Json.Null => "null"
        Json.Bool(b) => if b { "true" } else { "false" }
        Json.Int(n) => f"the number {n}"
        Json.Float(f) => "the number " + float_text(f)
        Json.Str(s) => "a string"
        Json.Array(items) => match items.len() {
            0 => "an empty array"
            1 => "an array of 1 item"
            n => f"an array of {n} items"
        }
        Json.Object(ms) => "an object"
    }
}

// --- What `#derive(Json)` calls for an enum -----------------------------------------

// The variant's name and its payload, if any, of an enum value of type
// `name`: a string is a variant without payload, an object of one member a
// variant with one.
#test(Json.Str("Red"), "Color")[Ok(("Red", None))]
#test(Json.Object([("Dot", Json.Int(1i64))]), "Shape")[Ok(("Dot", Some(Json.Int(1i64))))]
#test(Json.Object([]), "Shape")[Err(JsonError { kind: JsonErrorKind.WrongType, msg: "expected a variant of 'Shape' (a string, or an object of one member), found an object", line: 0, col: 0, path: "$" })]
fun variant_of(j: Json, name: str) -> Result<(str, Option<Json>), JsonError> {
    match j {
        Json.Str(s) => { return Ok((s, None)) }
        Json.Object(ms) => {
            if ms.len() == 1 { return Ok((ms[0].0, Some(ms[0].1))) }
        }
        _ => {}
    }
    return Err(wrong_type(f"a variant of '{name}' (a string, or an object of one member)", j))
}

// `value`, the variant without payload `v` names, if `v` has none.
fun unit_variant<T>(v: (str, Option<Json>), name: str, value: T) -> Result<T, JsonError> {
    return match v.1 {
        Some(p) => Err(value_error(JsonErrorKind.WrongType, f"variant '{v.0}' of '{name}' has no payload: write it as \"{v.0}\""))
        None => Ok(value)
    }
}

// Item `i` of the payload of `n` items of the variant `v` of enum `name`:
// the payload itself for one item, else an array of `n`.
fun payload<T: FromJson>(v: (str, Option<Json>), name: str, n: int32, i: int32) -> Result<T, JsonError> {
    let step = key_step(v.0)
    match v.1 {
        Some(p) => {
            if n == 1 { return within(T.from_json(p), step) }
            match p {
                Json.Array(items) => {
                    if items.len() == n { return within(T.from_json(items[i]), f"{step}[{i}]") }
                }
                _ => {}
            }
            return within(Err(wrong_type(f"an array of {n} items", p)), step)
        }
        None => {
            return Err(value_error(JsonErrorKind.WrongType, f"variant '{v.0}' of '{name}' has a payload: write it as " + "{" + f"\"{v.0}\": …" + "}"))
        }
    }
}

// The error for a variant `variant` that the enum `name` hasn't.
#test("Blue", "Color", ["Red", "Green"])[JsonError { kind: JsonErrorKind.UnknownVariant, msg: "unknown variant 'Blue' of 'Color', expected one of 'Red', 'Green'", line: 0, col: 0, path: "$" }]
fun unknown_variant(variant: str, name: str, variants: [str]) -> JsonError {
    var sb = StringBuilder()
    sb.append(f"unknown variant '{variant}' of '{name}', expected one of ")
    var first = true
    for v in variants {
        if !first { sb.append(", ") }
        sb.append(f"'{v}'")
        first = false
    }
    return value_error(JsonErrorKind.UnknownVariant, sb.build())
}

// --- The built-in types ---------------------------------------------------------

// The integer `j` holds, checked for the range `lo` to `hi` of the type
// `name`: an `Int`, or a whole `Float` (`2.0`, `1e3`).
#test(Json.Int(-128i64), -128i64, 127i64, "int8")[Ok(-128i64)]
#test(Json.Float(1e3), 0i64, 65535i64, "uint16")[Ok(1000i64)]
#test(Json.Int(256i64), 0i64, 255i64, "uint8")[Err(JsonError { kind: JsonErrorKind.OutOfRange, msg: "256 is out of range for uint8", line: 0, col: 0, path: "$" })]
#test(Json.Float(1e300), -128i64, 127i64, "int8")[Err(JsonError { kind: JsonErrorKind.OutOfRange, msg: "1e+300 is out of range for int8", line: 0, col: 0, path: "$" })]
#test(Json.Float(0.5), -128i64, 127i64, "int8")[Err(JsonError { kind: JsonErrorKind.WrongType, msg: "expected an integer, found the number 0.5", line: 0, col: 0, path: "$" })]
fun int_in(j: Json, lo: int64, hi: int64, name: str) -> Result<int64, JsonError> {
    var n: int64 = 0
    match j {
        Json.Int(v) => { n = v }
        Json.Float(f) => {
            if !is_whole(f) { return Err(wrong_type("an integer", j)) }
            if f < -9223372036854775808.0 || f >= 9223372036854775808.0 {
                return Err(value_error(JsonErrorKind.OutOfRange, f"{float_text(f)} is out of range for {name}"))
            }
            n = f as int64
        }
        _ => { return Err(wrong_type("an integer", j)) }
    }
    if n < lo || n > hi { return Err(value_error(JsonErrorKind.OutOfRange, f"{n} is out of range for {name}")) }
    return Ok(n)
}

// Whether `f` is a whole number (not NaN or an infinity).
fun is_whole(f: float64) -> bool {
    if f != f || f - f != 0.0 { return false }
    if f >= 9007199254740992.0 || f <= -9007199254740992.0 { return true }
    return (f as int64) as float64 == f
}

impl ToJson for int8 {
    fun to_json(self) -> Json { return Json.Int(self as int64) }
}

impl FromJson for int8 {
    fun from_json(j: Json) -> Result<int8, JsonError> { return Ok(int_in(j, -128, 127, "int8")? as int8) }
}

impl ToJson for int16 {
    fun to_json(self) -> Json { return Json.Int(self as int64) }
}

impl FromJson for int16 {
    fun from_json(j: Json) -> Result<int16, JsonError> { return Ok(int_in(j, -32768, 32767, "int16")? as int16) }
}

impl ToJson for int32 {
    fun to_json(self) -> Json { return Json.Int(self as int64) }
}

impl FromJson for int32 {
    fun from_json(j: Json) -> Result<int32, JsonError> { return Ok(int_in(j, -2147483648, 2147483647, "int32")? as int32) }
}

impl ToJson for int64 {
    fun to_json(self) -> Json { return Json.Int(self) }
}

impl FromJson for int64 {
    fun from_json(j: Json) -> Result<int64, JsonError> { return int_in(j, -9223372036854775807 - 1, 9223372036854775807, "int64") }
}

impl ToJson for uint8 {
    fun to_json(self) -> Json { return Json.Int(self as int64) }
}

impl FromJson for uint8 {
    fun from_json(j: Json) -> Result<uint8, JsonError> { return Ok(int_in(j, 0, 255, "uint8")? as uint8) }
}

impl ToJson for uint16 {
    fun to_json(self) -> Json { return Json.Int(self as int64) }
}

impl FromJson for uint16 {
    fun from_json(j: Json) -> Result<uint16, JsonError> { return Ok(int_in(j, 0, 65535, "uint16")? as uint16) }
}

impl ToJson for uint32 {
    fun to_json(self) -> Json { return Json.Int(self as int64) }
}

impl FromJson for uint32 {
    fun from_json(j: Json) -> Result<uint32, JsonError> { return Ok(int_in(j, 0, 4294967295, "uint32")? as uint32) }
}

impl ToJson for uint64 {
    // beyond int64, a float: the nearest float64, which reads back only if
    // it is exact
    #test(18446744073709551615u64)[Json.Float(18446744073709551616.0)]
    fun to_json(self) -> Json {
        if self > 9223372036854775807 { return Json.Float(self as float64) }
        return Json.Int(self as int64)
    }
}

impl FromJson for uint64 {
    #test(Json.Float(9223372036854775808.0))[Ok(9223372036854775808u64)]
    #test(Json.Float(18446744073709551616.0))[Err(JsonError { kind: JsonErrorKind.OutOfRange, msg: "1.8446744073709552e+19 is out of range for uint64", line: 0, col: 0, path: "$" })]
    fun from_json(j: Json) -> Result<uint64, JsonError> {
        match j {
            Json.Float(f) => {
                if is_whole(f) && f >= 9223372036854775808.0 && f < 18446744073709551616.0 { return Ok(f as uint64) }
            }
            _ => {}
        }
        return Ok(int_in(j, 0, 9223372036854775807, "uint64")? as uint64)
    }
}

impl ToJson for float64 {
    #test(1.0 / 0.0)[Json.Null]
    fun to_json(self) -> Json {
        if self != self || self - self != 0.0 { return Json.Null }
        return Json.Float(self)
    }
}

impl FromJson for float64 {
    fun from_json(j: Json) -> Result<float64, JsonError> {
        return match j {
            Json.Float(f) => Ok(f)
            Json.Int(n) => Ok(n as float64)
            _ => Err(wrong_type("a number", j))
        }
    }
}

impl ToJson for float32 {
    // the shortest decimal that reads back as the same float32: 0.1, not
    // 0.10000000149011612
    #test(0.1f32)[Json.Float(0.1)]
    fun to_json(self) -> Json {
        if self != self || self - self != 0.0f32 { return Json.Null }
        return match parse_float(f"{self}") {
            Some(f) => Json.Float(f)
            None => Json.Float(self as float64)
        }
    }
}

impl FromJson for float32 {
    #test(Json.Float(1e300))[Err(JsonError { kind: JsonErrorKind.OutOfRange, msg: "1e+300 is out of range for float32", line: 0, col: 0, path: "$" })]
    fun from_json(j: Json) -> Result<float32, JsonError> {
        let f = float64.from_json(j)?
        let g = f as float32
        if f - f == 0.0 && g - g != 0.0f32 { return Err(value_error(JsonErrorKind.OutOfRange, f"{float_text(f)} is out of range for float32")) }
        return Ok(g)
    }
}

impl ToJson for bool {
    fun to_json(self) -> Json { return Json.Bool(self) }
}

impl FromJson for bool {
    fun from_json(j: Json) -> Result<bool, JsonError> {
        return match j {
            Json.Bool(b) => Ok(b)
            _ => Err(wrong_type("true or false", j))
        }
    }
}

impl ToJson for str {
    fun to_json(self) -> Json { return Json.Str(self) }
}

impl FromJson for str {
    fun from_json(j: Json) -> Result<str, JsonError> {
        return match j {
            Json.Str(s) => Ok(s)
            _ => Err(wrong_type("a string", j))
        }
    }
}

impl ToJson for char {
    // a string of the one character
    fun to_json(self) -> Json { return Json.Str(f"{self}") }
}

impl FromJson for char {
    #test(Json.Str("é"))[Ok('é')]
    #test(Json.Str("ab"))[Err(JsonError { kind: JsonErrorKind.WrongType, msg: "expected a string of one character, found a string of 2", line: 0, col: 0, path: "$" })]
    fun from_json(j: Json) -> Result<char, JsonError> {
        match j {
            Json.Str(s) => {
                let cs = s.chars()
                if cs.len() == 1 { return Ok(cs[0]) }
                return Err(value_error(JsonErrorKind.WrongType, f"expected a string of one character, found a string of {cs.len()}"))
            }
            _ => { return Err(wrong_type("a string of one character", j)) }
        }
    }
}

impl ToJson for Json {
    fun to_json(self) -> Json { return self }
}

impl FromJson for Json {
    fun from_json(j: Json) -> Result<Json, JsonError> { return Ok(j) }
}

impl<T: ToJson> ToJson for [T] {
    fun to_json(self) -> Json {
        var items: [Json] = []
        for x in self { items.push(x.to_json()) }
        return Json.Array(items)
    }
}

impl<T: FromJson> FromJson for [T] {
    fun from_json(j: Json) -> Result<[T], JsonError> {
        match j {
            Json.Array(items) => {
                var out: [T] = []
                var i = 0
                for item in items {
                    out.push(within(T.from_json(item), f"[{i}]")?)
                    i += 1
                }
                return Ok(out)
            }
            _ => { return Err(wrong_type("an array", j)) }
        }
    }
}

// A map with string keys is an object, its members in the map's order.
impl<V: ToJson> ToJson for [str: V] {
    fun to_json(self) -> Json {
        var ms: [(str, Json)] = []
        for k in self { ms.push((k, self[k].to_json())) }
        return Json.Object(ms)
    }
}

impl<V: FromJson> FromJson for [str: V] {
    fun from_json(j: Json) -> Result<[str: V], JsonError> {
        match j {
            Json.Object(ms) => {
                var out: [str: V] = [:]
                for m in ms { out[m.0] = within(V.from_json(m.1), key_step(m.0))? }
                return Ok(out)
            }
            _ => { return Err(wrong_type("an object", j)) }
        }
    }
}

// `None` is `null`; a field of a derived struct leaves it out instead.
impl<T: ToJson> ToJson for Option<T> {
    fun to_json(self) -> Json {
        return match self {
            Some(x) => x.to_json()
            None => Json.Null
        }
    }
}

impl<T: FromJson> FromJson for Option<T> {
    fun from_json(j: Json) -> Result<Option<T>, JsonError> {
        return match j {
            Json.Null => Ok(None)
            _ => Ok(Some(T.from_json(j)?))
        }
    }
}

// Every built-in type's value goes to JSON and back.
#test
fun built_in_types_round_trip() {
    let m: [str: Option<[int8]>] = ["a": Some([-128, 127]), "b": None, "c d": Some([])]
    let text = encode(m)
    assert(text == "{\"a\":[-128,127],\"b\":null,\"c d\":[]}", text)
    match decode<[str: Option<[int8]>]>(text) {
        Ok(back) => assert(encode(back) == text, encode(back))
        Err(e) => assert(false, f"{e}")
    }
    assert(encode(['x', 'ü']) == "[\"x\",\"ü\"]", "chars")
    assert(encode([0.5f32, 1e10f32]) == "[0.5,10000000000.0]", encode([0.5f32, 1e10f32]))
    assert(encode([1.0 / 0.0, -0.0]) == "[null,-0.0]", "floats")
    assert(encode([true, false]) == "[true,false]", "bools")
    assert(encode(Json.Array([Json.Null])) == "[null]", "Json")
    assert(encode([[3u64]]) == "[[3]]", "uint64")
    let big: Result<[int16], JsonError> = decode("[1, 40000]")
    match big {
        Ok(v) => assert(false, "40000 is no int16")
        Err(e) => assert(f"{e}" == "$[1]: 40000 is out of range for int16", f"{e}")
    }
}

// An error's text, or "ok" (for the test functions).
fun outcome<T>(r: Result<T, JsonError>) -> str {
    return match r {
        Ok(v) => "ok"
        Err(e) => f"{e}"
    }
}

// Whether `r` is `Ok(want)` (for the test functions).
fun gives<T: Eq>(r: Result<T, JsonError>, want: T) -> bool {
    return match r {
        Ok(v) => v == want
        Err(e) => false
    }
}

// `encode`, `decode` and the helpers of a `FromJson` impl.
#test
fun encodes_and_decodes() {
    assert(encode([1, 2]) == "[1,2]", "encode")
    let xs: Result<[int], JsonError> = decode("[1, 2]")
    assert(gives(xs, [1, 2]), "decode")
    match decode<[int]>("[1, 2") {
        Ok(v) => assert(false, "not JSON")
        Err(e) => assert(e == JsonError { kind: JsonErrorKind.Syntax, msg: "Expecting ',' delimiter", line: 1, col: 6, path: "" }, f"{e}")
    }
    match decode<[int]>("[1, \"2\"]") {
        Ok(v) => assert(false, "not an int")
        Err(e) => assert(e == JsonError { kind: JsonErrorKind.WrongType, msg: "expected an integer, found a string", line: 0, col: 0, path: "$[1]" }, f"{e}")
    }
    let two = [("a", Json.Int(1)), ("a", Json.Int(2))]
    assert(gives(member<int64>(two, "a"), 2i64), "the last member")
    match member<int64>([("b", Json.Int(1))], "a") {
        Ok(v) => assert(false, "no member a")
        Err(e) => assert(e == JsonError { kind: JsonErrorKind.MissingField, msg: "missing field", line: 0, col: 0, path: "$.a" }, f"{e}")
    }
    assert(outcome(member<int64>([("a b", Json.Null)], "a b")) == "$[\"a b\"]: expected an integer, found null", "a quoted key")
    let cases = [[("a", Json.Null)], [], [("a", Json.Int(4))]]
    var seen: [str] = []
    for fields in cases {
        match optional_member<int64>(fields, "a") {
            Ok(Some(n)) => seen.push(f"{n}")
            Ok(None) => seen.push("none")
            Err(e) => seen.push(f"{e}")
        }
    }
    assert(seen == ["none", "none", "4"], "null, absent, present")
    assert(outcome(optional_member<int8>([("a", Json.Int(400))], "a")) == "$.a: 400 is out of range for int8", "nested")
}

// What `#derive(Json)` calls for an enum's variants.
#test
fun reads_variants() {
    assert(gives(unit_variant(("Red", None), "Color", 1), 1), "unit")
    assert(outcome(unit_variant(("Red", Some(Json.Null)), "Color", 1)) == "$: variant 'Red' of 'Color' has no payload: write it as \"Red\"", "unit with payload")
    let pair = ("P", Some(Json.Array([Json.Int(1), Json.Int(2)])))
    assert(gives(payload<int64>(pair, "E", 2, 1), 2i64), "second item")
    assert(gives(payload<int64>(("P", Some(Json.Int(5))), "E", 1, 0), 5i64), "one item")
    assert(outcome(payload<int64>(("P", Some(Json.Array([Json.Int(1)]))), "E", 2, 0)) == "$.P: expected an array of 2 items, found an array of 1 item", "too few")
    assert(outcome(payload<int64>(("P", None), "E", 1, 0)) == "$: variant 'P' of 'E' has a payload: write it as {\"P\": …}", "no payload")
    assert(outcome(payload<bool>(pair, "E", 2, 0)) == "$.P[0]: expected true or false, found the number 1", "an item's path")
}
