// std.ioerror — why an I/O operation failed (D129, D173): `IoError`, the
// cause of a platform error code (`from_errno`) and its name
// (`io_error_name`).
//
// A module of its own (MYLA-432), so that `std.io` doesn't import `std.fs`
// for it nor `std.fs` `std.io`'s traits back: a program importing `std.io`
// reads this and `std.io`, not all of `std.fs`. `std.fs` re-exports all
// three, so `from std.fs import IoError` and `fs.IoError` name the same
// type as `from std.ioerror import IoError`.

// Why a filesystem or I/O operation failed: the causes a program handles on
// every target (D129). `Unsupported`: the target can't do it at all (wasm32
// has no processes, D132). `Cancelled`: the task waiting for input was asked
// to stop (D96). `BrokenPipe`: a write to a pipe whose reading end is closed
// (D146). `Other` holds the platform's own code for anything else; its
// numbers are the platform's, not portable.
pub enum IoError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    NotADirectory,
    IsADirectory,
    NotEmpty,
    Interrupted,
    Cancelled,
    Unsupported,
    BrokenPipe,
    InvalidInput,
    // the network's (MYLA-346, std.net)
    ConnectionRefused,
    ConnectionReset,
    ConnectionAborted,
    NotConnected,
    AddrInUse,
    AddrNotAvailable,
    TimedOut,
    HostUnreachable,
    NetworkUnreachable,
    InvalidData,
    Other(int32),
}

// The cause of a (nonzero) error code from `std.platform`, which gives Linux's
// numbers on every target so far (wasm32's maps WASI's onto them). Also used
// by `std.io` and `std.process`.
#test(2)[IoError.NotFound]
#test(1)[IoError.PermissionDenied]
#test(17)[IoError.AlreadyExists]
#test(39)[IoError.NotEmpty]
#test(38)[IoError.Unsupported]
#test(32)[IoError.BrokenPipe]
#test(22)[IoError.InvalidInput]
#test(111)[IoError.ConnectionRefused]
#test(98)[IoError.AddrInUse]
#test(97)[IoError.Unsupported]
#test(5)[IoError.Other(5)]
pub fun from_errno(code: int32) -> IoError {
    if code == 2 { return IoError.NotFound }
    if code == 13 || code == 1 { return IoError.PermissionDenied }
    if code == 17 { return IoError.AlreadyExists }
    if code == 20 { return IoError.NotADirectory }
    if code == 21 { return IoError.IsADirectory }
    if code == 39 { return IoError.NotEmpty }
    if code == 4 { return IoError.Interrupted }
    if code == 125 { return IoError.Cancelled }
    if code == 38 || code == 95 { return IoError.Unsupported }
    if code == 32 { return IoError.BrokenPipe }
    if code == 22 { return IoError.InvalidInput }
    return net_error(code)
}

// The network's causes (MYLA-346): ECONNREFUSED, ECONNRESET (and EPIPE's
// cousin on a socket), ECONNABORTED, ENOTCONN, EADDRINUSE, EADDRNOTAVAIL,
// ETIMEDOUT, EHOSTUNREACH, ENETUNREACH, EBADMSG; EAFNOSUPPORT and
// EPROTONOSUPPORT (no IPv6 here) are `Unsupported`.
#test(104)[IoError.ConnectionReset]
#test(110)[IoError.TimedOut]
#test(74)[IoError.InvalidData]
#test(7)[IoError.Other(7)]
fun net_error(code: int32) -> IoError {
    if code == 111 { return IoError.ConnectionRefused }
    if code == 104 { return IoError.ConnectionReset }
    if code == 103 { return IoError.ConnectionAborted }
    if code == 107 { return IoError.NotConnected }
    if code == 98 { return IoError.AddrInUse }
    if code == 99 { return IoError.AddrNotAvailable }
    if code == 110 { return IoError.TimedOut }
    if code == 113 { return IoError.HostUnreachable }
    if code == 101 { return IoError.NetworkUnreachable }
    if code == 74 { return IoError.InvalidData }
    if code == 97 || code == 93 { return IoError.Unsupported }
    return IoError.Other(code)
}

// The name of `e`'s cause, its variant's: `NotFound`, `Other(9)` with the
// platform's code, as `e.message()` ends (D173). A module's error message
// may name an `IoError` by it (MYLA-376).
#test(IoError.NotFound)["NotFound"]
#test(IoError.ConnectionReset)["ConnectionReset"]
#test(IoError.Other(9))["Other(9)"]
pub fun io_error_name(e: IoError) -> str {
    return match e {
        NotFound => "NotFound"
        PermissionDenied => "PermissionDenied"
        AlreadyExists => "AlreadyExists"
        NotADirectory => "NotADirectory"
        IsADirectory => "IsADirectory"
        NotEmpty => "NotEmpty"
        Interrupted => "Interrupted"
        Cancelled => "Cancelled"
        Unsupported => "Unsupported"
        BrokenPipe => "BrokenPipe"
        InvalidInput => "InvalidInput"
        ConnectionRefused => "ConnectionRefused"
        ConnectionReset => "ConnectionReset"
        ConnectionAborted => "ConnectionAborted"
        NotConnected => "NotConnected"
        AddrInUse => "AddrInUse"
        AddrNotAvailable => "AddrNotAvailable"
        TimedOut => "TimedOut"
        HostUnreachable => "HostUnreachable"
        NetworkUnreachable => "NetworkUnreachable"
        InvalidData => "InvalidData"
        Other(code) => f"Other({code})"
    }
}

impl IoError {
    // The cause in words, its name after it (D173, MYLA-379): `not found
    // (NotFound)`, `error 5 (Other(5))` with the platform's code.
    #test(IoError.NotFound)["not found (NotFound)"]
    #test(IoError.PermissionDenied)["permission denied (PermissionDenied)"]
    #test(IoError.ConnectionRefused)["connection refused (ConnectionRefused)"]
    #test(IoError.AddrInUse)["address in use (AddrInUse)"]
    #test(IoError.Other(5))["error 5 (Other(5))"]
    fun message(self) -> str {
        let what = match self {
            NotFound => "not found"
            PermissionDenied => "permission denied"
            AlreadyExists => "already exists"
            NotADirectory => "not a directory"
            IsADirectory => "is a directory"
            NotEmpty => "directory not empty"
            Interrupted => "interrupted"
            Cancelled => "cancelled"
            Unsupported => "unsupported"
            BrokenPipe => "broken pipe"
            InvalidInput => "invalid input"
            ConnectionRefused => "connection refused"
            ConnectionReset => "connection reset"
            ConnectionAborted => "connection aborted"
            NotConnected => "not connected"
            AddrInUse => "address in use"
            AddrNotAvailable => "address not available"
            TimedOut => "timed out"
            HostUnreachable => "host unreachable"
            NetworkUnreachable => "network unreachable"
            InvalidData => "invalid data"
            Other(code) => f"error {code}"
        }
        return f"{what} ({io_error_name(self)})"
    }
}

// `f"{e}"`, `print(e)` and a test's report show the message (D168, D173).
impl Format for IoError {
    #test(IoError.IsADirectory, "")["is a directory (IsADirectory)"]
    fun format(self, spec: str) -> str {
        return self.message()
    }
}
