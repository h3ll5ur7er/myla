// std.ioerror — why an I/O operation failed (D129, D173): `IoError`, the
// cause of a code the standard library's primitives give (`from_cause`),
// of a Linux errno (`from_errno`), and its name (`io_error_name`).
//
// A module of its own (MYLA-432), so that `std.io` doesn't import `std.fs`
// for it nor `std.fs` `std.io`'s traits back: a program importing `std.io`
// reads this and `std.io`, not all of `std.fs`. `std.fs` re-exports
// `IoError`, `from_errno` and `io_error_name`, so `from std.fs import
// IoError` and `fs.IoError` name the same type as `from std.ioerror import
// IoError`.

// Why a filesystem or I/O operation failed: the causes a program handles on
// every target (D129). `Unsupported`: the target can't do it at all (wasm32
// has no processes, D132). `Cancelled`: the task waiting for input was asked
// to stop (D96). `BrokenPipe`: a write to a pipe whose reading end is closed
// (D146). `Other` holds the platform's own code for anything else; its
// numbers are the platform's, not portable.
pub enum IoError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    NotADirectory,
    IsADirectory,
    NotEmpty,
    Interrupted,
    Cancelled,
    Unsupported,
    BrokenPipe,
    InvalidInput,
    // the network's (MYLA-346, std.net)
    ConnectionRefused,
    ConnectionReset,
    ConnectionAborted,
    NotConnected,
    AddrInUse,
    AddrNotAvailable,
    TimedOut,
    HostUnreachable,
    NetworkUnreachable,
    InvalidData,
    Other(int32),
}

// --- cause codes (D208) ----------------------------------------------------------
//
// What a primitive's failure leaves for `__io_errno` (and `__run_errno`, a
// spawn's first word): a cause code, never a system's own number. Each
// platform module maps its system's codes onto them (`std.platform`'s
// constants of the same names and values, which
// tests/burn/test_platform_interface.py holds to these), so nothing above it
// knows Linux's errnos, WASI's or Windows'. 1 to 21 are `IoError`'s causes in
// its order; 32 to 35 those std.rt and std.net act on themselves, which an
// `IoError` shows as `Other` of the number std gives them on every target
// (`code_number`); a code from OTHER on is OTHER plus the system's own code,
// `Other(code)`.
pub const NOT_FOUND: int32 = 1
pub const PERMISSION_DENIED: int32 = 2
pub const ALREADY_EXISTS: int32 = 3
pub const NOT_A_DIRECTORY: int32 = 4
pub const IS_A_DIRECTORY: int32 = 5
pub const NOT_EMPTY: int32 = 6
pub const INTERRUPTED: int32 = 7
pub const CANCELLED: int32 = 8
pub const UNSUPPORTED: int32 = 9
pub const BROKEN_PIPE: int32 = 10
pub const INVALID_INPUT: int32 = 11
pub const CONNECTION_REFUSED: int32 = 12
pub const CONNECTION_RESET: int32 = 13
pub const CONNECTION_ABORTED: int32 = 14
pub const NOT_CONNECTED: int32 = 15
pub const ADDR_IN_USE: int32 = 16
pub const ADDR_NOT_AVAILABLE: int32 = 17
pub const TIMED_OUT: int32 = 18
pub const HOST_UNREACHABLE: int32 = 19
pub const NETWORK_UNREACHABLE: int32 = 20
pub const INVALID_DATA: int32 = 21
// the operation would wait (a non-blocking socket, a full pipe)
pub const WOULD_BLOCK: int32 = 32
// a non-blocking connect goes on
pub const IN_PROGRESS: int32 = 33
// no such open descriptor or handle (closed, or never opened)
pub const BAD_HANDLE: int32 = 34
// a terminal's operation on what isn't one
pub const NOT_A_TERMINAL: int32 = 35
pub const OTHER: int32 = 256

// The cause of the (nonzero) cause code `code` a primitive left (D208).
#test(1)[IoError.NotFound]
#test(2)[IoError.PermissionDenied]
#test(3)[IoError.AlreadyExists]
#test(6)[IoError.NotEmpty]
#test(9)[IoError.Unsupported]
#test(10)[IoError.BrokenPipe]
#test(11)[IoError.InvalidInput]
#test(12)[IoError.ConnectionRefused]
#test(16)[IoError.AddrInUse]
#test(21)[IoError.InvalidData]
#test(34)[IoError.Other(9)]
#test(32)[IoError.Other(11)]
#test(261)[IoError.Other(5)]
#test(256)[IoError.Other(0)]
pub fun from_cause(code: int32) -> IoError {
    if code >= OTHER { return IoError.Other(code - OTHER) }
    if code == NOT_FOUND { return IoError.NotFound }
    if code == PERMISSION_DENIED { return IoError.PermissionDenied }
    if code == ALREADY_EXISTS { return IoError.AlreadyExists }
    if code == NOT_A_DIRECTORY { return IoError.NotADirectory }
    if code == IS_A_DIRECTORY { return IoError.IsADirectory }
    if code == NOT_EMPTY { return IoError.NotEmpty }
    if code == INTERRUPTED { return IoError.Interrupted }
    if code == CANCELLED { return IoError.Cancelled }
    if code == UNSUPPORTED { return IoError.Unsupported }
    if code == BROKEN_PIPE { return IoError.BrokenPipe }
    if code == INVALID_INPUT { return IoError.InvalidInput }
    if code == CONNECTION_REFUSED { return IoError.ConnectionRefused }
    if code == CONNECTION_RESET { return IoError.ConnectionReset }
    if code == CONNECTION_ABORTED { return IoError.ConnectionAborted }
    if code == NOT_CONNECTED { return IoError.NotConnected }
    if code == ADDR_IN_USE { return IoError.AddrInUse }
    if code == ADDR_NOT_AVAILABLE { return IoError.AddrNotAvailable }
    if code == TIMED_OUT { return IoError.TimedOut }
    if code == HOST_UNREACHABLE { return IoError.HostUnreachable }
    if code == NETWORK_UNREACHABLE { return IoError.NetworkUnreachable }
    if code == INVALID_DATA { return IoError.InvalidData }
    return IoError.Other(code_number(code))
}

// The number an error type's `Other` shows for the cause code `code`: the
// system's own code past OTHER; for a cause the type has no variant for,
// the one std gives it on every target, Linux's errno, so that `Other(9)`
// is a closed handle and `terminal error 22` an invalid argument wherever
// the program runs (D129: these numbers are std's, not portable to read).
#test(34)[9]
#test(32)[11]
#test(33)[115]
#test(35)[25]
#test(11)[22]
#test(2)[13]
#test(9)[38]
#test(258)[2]
#test(77)[77]
#test(25)[25]
pub fun code_number(code: int32) -> int32 {
    if code >= OTHER { return code - OTHER }
    let k = code * 3
    if code < 1 || k + 3 > LINUX_NUMBERS.len() { return code }
    let n = ((LINUX_NUMBERS[k] - '0') as int32) * 100 + ((LINUX_NUMBERS[k + 1] - '0') as int32) * 10 + (LINUX_NUMBERS[k + 2] - '0') as int32
    if n == 0 { return code }
    return n
}

// Linux's errno of each cause code, three digits each from code 0 (none)
// to 35 (`000` where there is no cause): ENOENT 2 for NOT_FOUND, EACCES 13,
// EEXIST 17, … EBADMSG 74 for INVALID_DATA, then EAGAIN 11, EINPROGRESS 115,
// EBADF 9, ENOTTY 25.
const LINUX_NUMBERS: str = "000002013017020021039004125038032022111104103107098099110113101074000000000000000000000000000000011115009025"

// The cause of a Linux errno `code` (positive), for a program that holds
// one; the standard library's primitives give cause codes (`from_cause`).
#test(2)[IoError.NotFound]
#test(1)[IoError.PermissionDenied]
#test(17)[IoError.AlreadyExists]
#test(39)[IoError.NotEmpty]
#test(38)[IoError.Unsupported]
#test(32)[IoError.BrokenPipe]
#test(22)[IoError.InvalidInput]
#test(111)[IoError.ConnectionRefused]
#test(98)[IoError.AddrInUse]
#test(97)[IoError.Unsupported]
#test(5)[IoError.Other(5)]
pub fun from_errno(code: int32) -> IoError {
    if code == 2 { return IoError.NotFound }
    if code == 13 || code == 1 { return IoError.PermissionDenied }
    if code == 17 { return IoError.AlreadyExists }
    if code == 20 { return IoError.NotADirectory }
    if code == 21 { return IoError.IsADirectory }
    if code == 39 { return IoError.NotEmpty }
    if code == 4 { return IoError.Interrupted }
    if code == 125 { return IoError.Cancelled }
    if code == 38 || code == 95 { return IoError.Unsupported }
    if code == 32 { return IoError.BrokenPipe }
    if code == 22 { return IoError.InvalidInput }
    return net_error(code)
}

// The network's causes (MYLA-346): ECONNREFUSED, ECONNRESET (and EPIPE's
// cousin on a socket), ECONNABORTED, ENOTCONN, EADDRINUSE, EADDRNOTAVAIL,
// ETIMEDOUT, EHOSTUNREACH, ENETUNREACH, EBADMSG; EAFNOSUPPORT and
// EPROTONOSUPPORT (no IPv6 here) are `Unsupported`.
#test(104)[IoError.ConnectionReset]
#test(110)[IoError.TimedOut]
#test(74)[IoError.InvalidData]
#test(7)[IoError.Other(7)]
fun net_error(code: int32) -> IoError {
    if code == 111 { return IoError.ConnectionRefused }
    if code == 104 { return IoError.ConnectionReset }
    if code == 103 { return IoError.ConnectionAborted }
    if code == 107 { return IoError.NotConnected }
    if code == 98 { return IoError.AddrInUse }
    if code == 99 { return IoError.AddrNotAvailable }
    if code == 110 { return IoError.TimedOut }
    if code == 113 { return IoError.HostUnreachable }
    if code == 101 { return IoError.NetworkUnreachable }
    if code == 74 { return IoError.InvalidData }
    if code == 97 || code == 93 { return IoError.Unsupported }
    return IoError.Other(code)
}

// The name of `e`'s cause, its variant's: `NotFound`, `Other(9)` with the
// platform's code, as `e.message()` ends (D173). A module's error message
// may name an `IoError` by it (MYLA-376).
#test(IoError.NotFound)["NotFound"]
#test(IoError.ConnectionReset)["ConnectionReset"]
#test(IoError.Other(9))["Other(9)"]
pub fun io_error_name(e: IoError) -> str {
    return match e {
        NotFound => "NotFound"
        PermissionDenied => "PermissionDenied"
        AlreadyExists => "AlreadyExists"
        NotADirectory => "NotADirectory"
        IsADirectory => "IsADirectory"
        NotEmpty => "NotEmpty"
        Interrupted => "Interrupted"
        Cancelled => "Cancelled"
        Unsupported => "Unsupported"
        BrokenPipe => "BrokenPipe"
        InvalidInput => "InvalidInput"
        ConnectionRefused => "ConnectionRefused"
        ConnectionReset => "ConnectionReset"
        ConnectionAborted => "ConnectionAborted"
        NotConnected => "NotConnected"
        AddrInUse => "AddrInUse"
        AddrNotAvailable => "AddrNotAvailable"
        TimedOut => "TimedOut"
        HostUnreachable => "HostUnreachable"
        NetworkUnreachable => "NetworkUnreachable"
        InvalidData => "InvalidData"
        Other(code) => f"Other({code})"
    }
}

impl IoError {
    // The cause in words, its name after it (D173, MYLA-379): `not found
    // (NotFound)`, `error 5 (Other(5))` with the platform's code.
    #test(IoError.NotFound)["not found (NotFound)"]
    #test(IoError.PermissionDenied)["permission denied (PermissionDenied)"]
    #test(IoError.ConnectionRefused)["connection refused (ConnectionRefused)"]
    #test(IoError.AddrInUse)["address in use (AddrInUse)"]
    #test(IoError.Other(5))["error 5 (Other(5))"]
    fun message(self) -> str {
        let what = match self {
            NotFound => "not found"
            PermissionDenied => "permission denied"
            AlreadyExists => "already exists"
            NotADirectory => "not a directory"
            IsADirectory => "is a directory"
            NotEmpty => "directory not empty"
            Interrupted => "interrupted"
            Cancelled => "cancelled"
            Unsupported => "unsupported"
            BrokenPipe => "broken pipe"
            InvalidInput => "invalid input"
            ConnectionRefused => "connection refused"
            ConnectionReset => "connection reset"
            ConnectionAborted => "connection aborted"
            NotConnected => "not connected"
            AddrInUse => "address in use"
            AddrNotAvailable => "address not available"
            TimedOut => "timed out"
            HostUnreachable => "host unreachable"
            NetworkUnreachable => "network unreachable"
            InvalidData => "invalid data"
            Other(code) => f"error {code}"
        }
        return f"{what} ({io_error_name(self)})"
    }
}

// `f"{e}"`, `print(e)` and a test's report show the message (D168, D173).
impl Format for IoError {
    #test(IoError.IsADirectory, "")["is a directory (IsADirectory)"]
    fun format(self, spec: str) -> str {
        return self.message()
    }
}
