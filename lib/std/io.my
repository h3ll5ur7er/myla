// std.io — freestanding console/stream I/O (D29; reading MYLA-78; errors D146).
//
// Thin wrappers over the runtime's raw `write` and `read` primitives (the
// platform layer's system calls natively; the same in the interpreter, which
// is a native program).
// String bytes are written verbatim (UTF-8), so `print`/`println` are
// byte-for-byte identical across the interpreter and the native backend.
// Output is not buffered, so whatever a program wrote is out before it waits
// for input.

from .ioerror import IoError, from_errno

// Write `s`'s bytes to file descriptor `fd` (1 = stdout, 2 = stderr), all of
// them, or the error that stopped it (D146). A closed pipe on the standard
// output or error ends the program quietly instead, as Unix tools stop in
// `yes | head`; on another descriptor it is `BrokenPipe`.
pub fun write(fd: int32, s: str) -> Result<(), IoError> {
    __write(fd, s)
    let err = __io_errno()
    if err != 0 {
        return Err(from_errno(err))
    }
    return Ok(())
}

// Write `s` to stdout, followed by a newline. Like `print`, it reports no
// error: a closed pipe ends the program quietly (D146).
pub fun println(s: str) {
    put(1, s)
    put(1, "\n")
}

// Write `s` to stderr (no newline).
pub fun eprint(s: str) {
    put(2, s)
}

// Write `s` to stderr, followed by a newline.
pub fun eprintln(s: str) {
    put(2, s)
    put(2, "\n")
}

// `s` to `fd` by a write without a result: a closed pipe ends the program
// quietly (D146), another error with a runtime error saying why (D153), as
// `print` does.
fun put(fd: int32, s: str) {
    __write(fd, s)
    let err = __io_errno()
    if err != 0 {
        __write(2, f"runtime error: write failed: {errno_text(err)}\n")
        __exit(1)
    }
}

// What the errno `code` of a failed write means (std.rt's `errno_text`).
#test(28)["no space left on device"]
#test(77)["errno 77"]
pub fun errno_text(code: int32) -> str {
    if code == 28 {
        return "no space left on device"
    }
    if code == 5 {
        return "input/output error"
    }
    if code == 9 {
        return "bad file descriptor"
    }
    if code == 27 {
        return "file too large"
    }
    if code == 122 {
        return "disk quota exceeded"
    }
    return f"errno {code}"
}

// --- Streams (MYLA-338) ---------------------------------------------------------
//
// Myla has no references, so a stream is a value kept in a `var` (or a field
// of one) and used through its `var self` methods. An adapter owns the stream
// it wraps, by value: `Buffered<R>` holds its `R`. There are no trait
// objects, so a function that takes "any stream" is generic, and takes the
// stream by value (`read_all`, `copy`).
//
// `Read` and `Write` deal in bytes, `[uint8]`, only (D177): a `str` and a
// `[uint8]` convert in one copy (MYLA-369), so text has no method of its own
// on every stream. `Buffered` gives text (`read_line`, `read_exact`,
// `read_to_end`) and `BufferedWriter` takes it (`write_str`).

// A source of bytes.
pub trait Read {
    // Up to `n` bytes from the cursor on, which moves past them; `[]` at the
    // end of the input (and for `n <= 0`). Fewer than `n` doesn't mean the
    // end: only `[]` does.
    fun read(var self, n: int) -> Result<[uint8], IoError>
}

// A sink of bytes.
pub trait Write {
    // All of `b`, or the error that stopped it; `b.len()`.
    fun write(var self, b: [uint8]) -> Result<int, IoError>
    // Whatever is buffered passed on.
    fun flush(var self) -> Result<(), IoError>
}

// Where a seek goes: so many bytes from the start, the cursor or the end.
#derive(Eq)
pub enum SeekFrom {
    Start(int64),
    Current(int64),
    End(int64),
}

// A stream with a cursor that can be moved.
pub trait Seek {
    // The cursor moved; its new offset from the start. Before the start is
    // `InvalidInput`; past the end is allowed.
    fun seek(var self, pos: SeekFrom) -> Result<int64, IoError>
}

// A stream that is a descriptor of the platform, which a task can wait for
// (`ready` and the async reads of `Buffered`).
pub trait Pollable {
    fun descriptor(self) -> int32
}

// How many bytes one `read` asks for at least.
const CHUNK: int32 = 4096

// How many bytes `copy` reads at a time (MYLA-379): a 256 MiB file copied
// into a new one natively took 164 ms with 4 KiB, 91 with 64 KiB and 85 with
// 128 KiB; to `/dev/null`, 57, 40 and 39.
const COPY_CHUNK: int32 = 65536

// The bytes of `s`, in one copy (MYLA-369).
fun bytes_of(s: str) -> [uint8] {
    return __str_to_bytes(s)
}

// The bytes of `b` from `start` up to `end`, as text: one copy of them
// all, two of a part.
#test([97u8, 98u8, 99u8], 0, 3)["abc"]
#test([97u8, 98u8, 99u8], 1, 2)["b"]
fun text_of(b: [uint8], start: int32, end: int32) -> str {
    if start == 0 && end == b.len() {
        return __bytes_to_str(b)
    }
    return __bytes_to_str(b[start:end])
}

// The bytes of `s` from `start` up to `end`.
fun slice(s: str, start: int32, end: int32) -> str {
    var sb = StringBuilder()
    sb.append(s, start, end)
    return sb.build()
}

// --- A descriptor -----------------------------------------------------------------

// A file descriptor of the platform as a stream, unbuffered: each `read` and
// `write` is a system call. `Buffered` puts a buffer in front of it.
pub struct FdStream {
    fd: int32,
}

// A stream of file descriptor `fd` (0 the standard input, 1 the output, 2 the
// error output).
pub fun fd_stream(fd: int32) -> FdStream {
    return FdStream { fd: fd }
}

impl Read for FdStream {
    // One read of at most `n` bytes; it blocks until there are some or the
    // input ends.
    fun read(var self, n: int) -> Result<[uint8], IoError> {
        if n <= 0 { return Ok([]) }
        let chunk = __read_bytes(self.fd, n)
        let err = __io_errno()
        if err != 0 { return Err(from_errno(err)) }
        return Ok(chunk)
    }
}

impl Write for FdStream {
    // A closed pipe is `BrokenPipe`, but on the standard output or error,
    // where it ends the program quietly, as `write` does (D146).
    fun write(var self, b: [uint8]) -> Result<int, IoError> {
        __write_bytes(self.fd, b)
        let err = __io_errno()
        if err != 0 { return Err(from_errno(err)) }
        return Ok(b.len())
    }

    // Nothing to do: nothing is buffered.
    fun flush(var self) -> Result<(), IoError> {
        return Ok(())
    }
}

// How many bytes a pipe with room takes in one write (POSIX's PIPE_BUF,
// Linux's 4096), which `FdStream.write_async` writes at a time.
const PIPE_BUF: int32 = 4096

impl FdStream {
    // `write`, the task waiting while the descriptor is full, the other
    // tasks running (MYLA-457): the bytes go a piece a pipe with room takes
    // at once (PIPE_BUF bytes), each after a wait for that room if there is
    // none now. `write` waits too, but with its thread blocked, as a blocking
    // descriptor's write does (a non-blocking one's tried again at once
    // before, spinning). A task asked to stop stops waiting: `Cancelled`, the
    // bytes before the piece it waited for written.
    async fun write_async(var self, b: [uint8]) -> Result<int, IoError> {
        var at = 0
        while at < b.len() {
            if __poll_write(self.fd, 0) == 0 {
                await __wait_writable(self.fd)
                if __task_cancelled() {
                    return Err(IoError.Cancelled)
                }
            }
            var end = at + PIPE_BUF
            if end > b.len() {
                end = b.len()
            }
            let w = self.write(b[at:end])?
            at = end
        }
        return Ok(b.len())
    }
}

impl Seek for FdStream {
    // A pipe or a terminal can't seek: `Other(29)` (ESPIPE).
    fun seek(var self, pos: SeekFrom) -> Result<int64, IoError> {
        let (offset, whence) = match pos {
            Start(k) => (k, 0)
            Current(k) => (k, 1)
            End(k) => (k, 2)
        }
        let r = __seek(self.fd, offset, whence)
        if r < 0 { return Err(from_errno(__io_errno())) }
        return Ok(r)
    }
}

impl Pollable for FdStream {
    fun descriptor(self) -> int32 {
        return self.fd
    }
}

// --- In memory --------------------------------------------------------------------

// Bytes in memory and a cursor: read from them, write into them (over what
// is there, and on past the end), seek in them.
pub struct MemoryStream {
    data: [uint8],
    pos: int32,
}

// An empty memory stream.
pub fun memory_stream() -> MemoryStream {
    return MemoryStream { data: [], pos: 0 }
}

// A memory stream of `b`, the cursor at the start.
pub fun from_bytes(b: [uint8]) -> MemoryStream {
    return MemoryStream { data: b, pos: 0 }
}

// A memory stream of the bytes of `s`, the cursor at the start.
pub fun from_str(s: str) -> MemoryStream {
    return from_bytes(bytes_of(s))
}

impl MemoryStream {
    // Every byte it holds, wherever the cursor is.
    fun bytes(self) -> [uint8] {
        return self.data
    }

    // Every byte it holds, as text.
    #test(from_str("abc"))["abc"]
    #test(memory_stream())[""]
    fun text(self) -> str {
        return text_of(self.data, 0, self.data.len())
    }

    // The cursor's offset from the start.
    #test(from_str("abc"))[0i64]
    fun position(self) -> int64 {
        return self.pos as int64
    }

    // Where a read of `n` bytes from the cursor ends.
    fun read_end(self, n: int32) -> int32 {
        let len = self.data.len()
        if n <= 0 || self.pos >= len { return self.pos }
        if n < len - self.pos { return self.pos + n }
        return len
    }

    // Zeros from the end up to the cursor, after a seek past the end.
    fun fill_gap(var self) {
        while self.data.len() < self.pos {
            self.data.push(0)
        }
    }
}

impl Read for MemoryStream {
    #test(from_str("abc"), 2)[Ok([97u8, 98u8])]
    #test(from_str("abc"), 9)[Ok([97u8, 98u8, 99u8])]
    fun read(var self, n: int) -> Result<[uint8], IoError> {
        let end = self.read_end(n)
        if end == self.pos { return Ok([]) }
        let out = self.data[self.pos:end]
        self.pos = end
        return Ok(out)
    }
}

impl Write for MemoryStream {
    // Over the bytes at the cursor, and on past the end; a gap left by a
    // seek past the end is filled with zeros.
    // Past 2,147,483,647 bytes is `Other(27)` (EFBIG), as for a file too
    // large.
    #test(from_str("abc"), [120u8])[Ok(1)]
    fun write(var self, b: [uint8]) -> Result<int, IoError> {
        let n = b.len()
        if self.pos > 2147483647 - n { return Err(IoError.Other(27)) }
        self.fill_gap()
        var i = 0
        let over = self.data.len() - self.pos
        while i < n && i < over {
            self.data[self.pos + i] = b[i]
            i += 1
        }
        while i < n {
            self.data.push(b[i])
            i += 1
        }
        self.pos = self.pos + n
        return Ok(n)
    }

    fun flush(var self) -> Result<(), IoError> {
        return Ok(())
    }
}

impl Seek for MemoryStream {
    // Before the start or past 2,147,483,647 is `InvalidInput`, an offset
    // of any size too (D184).
    #test(from_str("abc"), SeekFrom.End(-1))[Ok(2i64)]
    #test(from_str("abc"), SeekFrom.Current(-1))[Err(IoError.InvalidInput)]
    #test(from_str("abc"), SeekFrom.Current(9223372036854775807))[Err(IoError.InvalidInput)]
    #test(from_str("abc"), SeekFrom.End(-9223372036854775807 - 1))[Err(IoError.InvalidInput)]
    #test(from_str("abc"), SeekFrom.Start(2147483647))[Ok(2147483647i64)]
    fun seek(var self, pos: SeekFrom) -> Result<int64, IoError> {
        let (base, k) = match pos {
            Start(k) => (0i64, k)
            Current(k) => (self.pos as int64, k)
            End(k) => (self.data.len() as int64, k)
        }
        // the base is in 0..2^31, so only an offset that far out overflows
        if k < -4294967296 || k > 4294967296 { return Err(IoError.InvalidInput) }
        let to = base + k
        if to < 0 || to > 2147483647 { return Err(IoError.InvalidInput) }
        self.pos = to as int32
        return Ok(to)
    }
}

// --- Buffered reading -------------------------------------------------------------

// A reader with a buffer in front of the stream `R` it owns: lines, exact
// counts and the rest, as text (the bytes verbatim). Keep it in a `var` (or
// a field of one) and read through its methods. It is a `Read` itself. It
// pulls bytes and keeps them as text, each read's converted once (D177).
//
// The stream is the one element of `src`, and `pull` takes it out for a
// read and puts it back: a stream that is a plain field would be shared
// with the copy a read works on, so a read that changes its bytes (an
// adapter's own buffer) would copy them all each time; and the interpreter
// can't call the method of a field whose type is a type parameter
// (`self.inner.read(n)`, MYLA-338's report).
pub struct Buffered<R> {
    src: [R],
    buf: str,      // bytes read but not returned yet: buf[pos..]
    pos: int32,
    eof: bool,     // the input has ended
}

// A buffered reader of the stream `r`.
pub fun buffered<R: Read>(r: R) -> Buffered<R> {
    return Buffered { src: [r], buf: "", pos: 0, eof: false }
}

// A buffered reader of a file descriptor: what `stdin()` and `reader(fd)`
// give, and what `std.io` had before streams.
pub typealias Reader = Buffered<FdStream>

// A reader of the standard input.
pub fun stdin() -> Reader {
    return reader(0)
}

// A reader of file descriptor `fd`.
pub fun reader(fd: int32) -> Reader {
    return buffered(fd_stream(fd))
}

impl<R: Read> Buffered<R> {
    // One read of the stream, of up to `n` bytes.
    fun pull_bytes(var self, n: int32) -> Result<[uint8], IoError> {
        var r = self.src.pop()
        let got = r.read(n)
        self.src.push(r)
        return got
    }

    // `pull_bytes`, the bytes as text.
    fun pull(var self, n: int32) -> Result<str, IoError> {
        let b = self.pull_bytes(n)?        // not inside the call: MYLA-338's report
        return Ok(text_of(b, 0, b.len()))
    }

    // Read at least `want` more bytes if the input has them (one `read` of at
    // least CHUNK bytes, which may give fewer); false at the end of the
    // input. The bytes already returned are dropped from the buffer, and
    // those not yet returned are copied before the new ones. `read_line` and
    // `read_exact` use the buffer up before they fill it, so they copy
    // nothing here: they gather what they need in a builder of their own,
    // where a byte is copied once, not again with the tail on each read
    // (M17).
    fun fill(var self, want: int32) -> Result<bool, IoError> {
        if self.eof { return Ok(false) }
        var n = CHUNK
        if want > n { n = want }
        let chunk = self.pull(n)?
        if chunk.len() == 0 {
            self.eof = true
            return Ok(false)
        }
        if self.pos >= self.buf.len() {
            self.buf = chunk
        } else {
            var sb = StringBuilder()
            sb.append(self.buf, self.pos, self.buf.len())
            sb.append(chunk)
            self.buf = sb.build()
        }
        self.pos = 0
        return Ok(true)
    }

    // The offset of the first "\n" in the buffer from `start` on, or -1.
    fun newline_from(self, start: int32) -> int32 {
        let buf = self.buf
        let n = buf.len()
        var i = start
        while i < n {
            if buf[i] == '\n' { return i }
            i += 1
        }
        return -1
    }

    // The line up to `end`, past the "\n" there if there is one.
    fun take_line(var self, end: int32) -> str {
        let line = slice(self.buf, self.pos, end)
        if end < self.buf.len() { self.pos = end + 1 } else { self.pos = end }
        return line
    }

    // The next line, without its "\n" (a "\r" before it is kept); a last line
    // without "\n" counts too. None at the end of the input. A line longer
    // than what is buffered is gathered in a builder: linear in its length
    // however short the reads (M17). A failed read leaves what was read of
    // the line unread.
    fun read_line(var self) -> Result<Option<str>, IoError> {
        let found = self.newline_from(self.pos)
        if found >= 0 {
            return Ok(Some(self.take_line(found)))
        }
        var line = StringBuilder()
        while true {
            line.append(self.buf, self.pos, self.buf.len())
            self.buf = ""
            self.pos = 0
            let more = self.fill(1)
            match more {
                Ok(true) => {}
                Ok(false) => {
                    if line.len() == 0 { return Ok(None) }
                    return Ok(Some(line.build()))
                }
                Err(e) => {
                    self.buf = line.build()
                    return Err(e)
                }
            }
            let end = self.newline_from(0)
            if end >= 0 {
                line.append(self.buf, 0, end)
                self.pos = end + 1
                return Ok(Some(line.build()))
            }
        }
        unreachable()
    }

    // Exactly the next `n` bytes ("" for n <= 0); None if the input ends
    // first, and then the bytes that were there stay unread, as after a
    // failed read. Linear in `n` however short the reads (M17).
    fun read_exact(var self, n: int32) -> Result<Option<str>, IoError> {
        if n <= 0 { return Ok(Some("")) }
        var out = StringBuilder()
        while true {
            let need = n - out.len()
            if self.buf.len() - self.pos >= need {
                out.append(self.buf, self.pos, self.pos + need)
                self.pos = self.pos + need
                return Ok(Some(out.build()))
            }
            out.append(self.buf, self.pos, self.buf.len())
            self.buf = ""
            self.pos = 0
            let more = self.fill(n - out.len())
            match more {
                Ok(true) => {}
                Ok(false) => {
                    self.buf = out.build()
                    return Ok(None)
                }
                Err(e) => {
                    self.buf = out.build()
                    return Err(e)
                }
            }
        }
        unreachable()
    }

    // Everything up to the end of the input ("" if it has ended).
    fun read_to_end(var self) -> Result<str, IoError> {
        var sb = StringBuilder()
        sb.append(self.buf, self.pos, self.buf.len())
        while !self.eof {
            let chunk = self.pull(CHUNK)?   // the buffer stays as it was
            if chunk.len() == 0 { self.eof = true } else { sb.append(chunk) }
        }
        self.buf = ""
        self.pos = 0
        return Ok(sb.build())
    }

    // The stream it reads, without the bytes still in the buffer.
    fun into_inner(self) -> R {
        return self.src[0]
    }
}

impl<R: Read> Read for Buffered<R> {
    // From the buffer; a read of at least CHUNK bytes with nothing buffered
    // goes straight to the stream.
    fun read(var self, n: int) -> Result<[uint8], IoError> {
        if n <= 0 { return Ok([]) }
        if self.pos >= self.buf.len() {
            if self.eof { return Ok([]) }
            if n >= CHUNK {
                let chunk = self.pull_bytes(n)?
                if chunk.len() == 0 { self.eof = true }
                return Ok(chunk)
            }
            if !self.fill(n)? { return Ok([]) }
        }
        var end = self.buf.len()
        if n < end - self.pos { end = self.pos + n }
        let out = slice(self.buf, self.pos, end)
        self.pos = end
        return Ok(bytes_of(out))
    }
}

impl<R: Read + Seek> Seek for Buffered<R> {
    // The stream's cursor moved, the buffer dropped; `Current` counts from
    // the next byte a read would give, not from where the stream is.
    fun seek(var self, pos: SeekFrom) -> Result<int64, IoError> {
        var to = pos
        match pos {
            Current(k) => { to = SeekFrom.Current(k - ((self.buf.len() - self.pos) as int64)) }
            _ => {}
        }
        var r = self.src.pop()
        let got = r.seek(to)
        self.src.push(r)
        let at = got?
        self.buf = ""
        self.pos = 0
        self.eof = false
        return Ok(at)
    }
}

impl<R: Pollable> Pollable for Buffered<R> {
    fun descriptor(self) -> int32 {
        let r = self.src[0]
        return r.descriptor()
    }
}

impl<R: Read + Pollable> Buffered<R> {
    // Whether a read won't block: bytes are buffered, or within `timeout_ms`
    // milliseconds (0: don't wait; negative: wait as long as it takes) input
    // arrives, the input ends or reading fails (MYLA-80).
    fun ready(self, timeout_ms: int32) -> bool {
        if self.pos < self.buf.len() || self.eof { return true }
        return __poll(self.descriptor(), timeout_ms) != 0
    }

    // --- In a task: waiting for input without blocking the worker (D124) ---
    // Each async version reads as its blocking twin does, but first waits
    // for input with the task suspended, the other tasks running; outside a
    // task it blocks as the twin does. A task asked to stop (`task.cancel`,
    // a `task.timeout` that ran out) stops waiting at once and gets
    // `Cancelled`.

    // `fill`, the task waiting for the input.
    async fun fill_async(var self, want: int32) -> Result<bool, IoError> {
        if self.eof { return Ok(false) }
        await __wait_readable(self.descriptor())
        if __task_cancelled() { return Err(IoError.Cancelled) }
        return self.fill(want)
    }

    // `read_line`, the task waiting for the input.
    async fun read_line_async(var self) -> Result<Option<str>, IoError> {
        let found = self.newline_from(self.pos)
        if found >= 0 {
            return Ok(Some(self.take_line(found)))
        }
        var line = StringBuilder()
        while true {
            line.append(self.buf, self.pos, self.buf.len())
            self.buf = ""
            self.pos = 0
            let more = await self.fill_async(1)
            match more {
                Ok(true) => {}
                Ok(false) => {
                    if line.len() == 0 { return Ok(None) }
                    return Ok(Some(line.build()))
                }
                Err(e) => {
                    self.buf = line.build()
                    return Err(e)
                }
            }
            let end = self.newline_from(0)
            if end >= 0 {
                line.append(self.buf, 0, end)
                self.pos = end + 1
                return Ok(Some(line.build()))
            }
        }
        unreachable()
    }

    // `read_exact`, the task waiting for the input.
    async fun read_exact_async(var self, n: int32) -> Result<Option<str>, IoError> {
        if n <= 0 { return Ok(Some("")) }
        var out = StringBuilder()
        while true {
            let need = n - out.len()
            if self.buf.len() - self.pos >= need {
                out.append(self.buf, self.pos, self.pos + need)
                self.pos = self.pos + need
                return Ok(Some(out.build()))
            }
            out.append(self.buf, self.pos, self.buf.len())
            self.buf = ""
            self.pos = 0
            let more = await self.fill_async(n - out.len())
            match more {
                Ok(true) => {}
                Ok(false) => {
                    self.buf = out.build()
                    return Ok(None)
                }
                Err(e) => {
                    self.buf = out.build()
                    return Err(e)
                }
            }
        }
        unreachable()
    }

    // `read_to_end`, the task waiting for the input.
    async fun read_to_end_async(var self) -> Result<str, IoError> {
        var sb = StringBuilder()
        sb.append(self.buf, self.pos, self.buf.len())
        let fd = self.descriptor()
        while !self.eof {
            await __wait_readable(fd)
            if __task_cancelled() { return Err(IoError.Cancelled) }
            let chunk = self.pull(CHUNK)?
            if chunk.len() == 0 { self.eof = true } else { sb.append(chunk) }
        }
        self.buf = ""
        self.pos = 0
        return Ok(sb.build())
    }
}

// --- Short reads ------------------------------------------------------------------

// A stream that gives at most `most` bytes a read of the stream it owns, as
// a pipe, a socket or a decompressor may: for the tests of code that reads
// streams, which must not count on a read giving all it asked for.
pub struct ShortReads<R> {
    src: [R],
    most: int32,
}

// The stream `r` read at most `most` bytes at a time (at least 1).
pub fun short_reads<R: Read>(r: R, most: int32) -> ShortReads<R> {
    var k = most
    if k < 1 { k = 1 }
    return ShortReads { src: [r], most: k }
}

impl<R: Read> ShortReads<R> {
    // The stream it reads.
    fun into_inner(self) -> R {
        return self.src[0]
    }
}

impl<R: Read> Read for ShortReads<R> {
    fun read(var self, n: int) -> Result<[uint8], IoError> {
        var k = n
        if k > self.most { k = self.most }
        var r = self.src.pop()
        let got = r.read(k)
        self.src.push(r)
        return got
    }
}

// --- Buffered writing -------------------------------------------------------------

// How many bytes a `buffered_writer` keeps before it passes them on.
const WRITE_BUFFER: int32 = 8192

// A writer with a buffer in front of the stream `W` it owns: small writes
// are gathered, and passed on when the buffer is full, on `flush` and on
// `into_inner`. Nothing flushes it at the end of a program: flush it. The
// stream is the one element of `sink`, as `Buffered`'s is of `src`.
pub struct BufferedWriter<W> {
    sink: [W],
    buf: StringBuilder,
    cap: int32,
}

// A buffered writer to `w`, with a buffer of 8 KiB.
pub fun buffered_writer<W: Write>(w: W) -> BufferedWriter<W> {
    return buffered_writer_with(w, WRITE_BUFFER)
}

// A buffered writer to `w` that keeps up to `capacity` bytes (at least 1).
pub fun buffered_writer_with<W: Write>(w: W, capacity: int32) -> BufferedWriter<W> {
    var cap = capacity
    if cap < 1 { cap = 1 }
    return BufferedWriter { sink: [w], buf: StringBuilder(cap), cap: cap }
}

impl<W: Write> BufferedWriter<W> {
    // One write of `b` to the stream.
    fun push_out(var self, b: [uint8]) -> Result<int, IoError> {
        var w = self.sink.pop()
        let r = w.write(b)
        self.sink.push(w)
        return r
    }

    // The bytes of `s` written: gathered in the buffer, or straight on if
    // they are as many as it holds, or more; `s.len()`.
    fun write_str(var self, s: str) -> Result<int, IoError> {
        if !self.make_room(s.len())? { return self.push_out(bytes_of(s)) }
        self.buf.append(s)
        return Ok(s.len())
    }

    // The buffer passed on, without flushing the stream.
    fun drain(var self) -> Result<(), IoError> {
        if self.buf.len() == 0 { return Ok(()) }
        self.push_out(bytes_of(self.buf.build()))?
        self.buf = StringBuilder(self.cap)
        return Ok(())
    }

    // Room for `n` more bytes: the buffer passed on if they don't fit;
    // whether they go in it (false: they are as many as it holds, or more,
    // and go straight on).
    fun make_room(var self, n: int32) -> Result<bool, IoError> {
        if n <= self.cap - self.buf.len() { return Ok(true) }
        self.drain()?
        return Ok(n < self.cap)
    }

    // The stream it writes, flushed.
    fun into_inner(self) -> Result<W, IoError> {
        var me = self
        me.flush()?
        return Ok(me.sink[0])
    }
}

impl<W: Write> Write for BufferedWriter<W> {
    fun write(var self, b: [uint8]) -> Result<int, IoError> {
        if !self.make_room(b.len())? { return self.push_out(b) }
        self.buf.append(text_of(b, 0, b.len()))
        return Ok(b.len())
    }

    // The buffer passed on, then the stream flushed.
    fun flush(var self) -> Result<(), IoError> {
        self.drain()?
        var w = self.sink.pop()
        let r = w.flush()
        self.sink.push(w)
        return r
    }
}

impl<W: Write + Seek> Seek for BufferedWriter<W> {
    // The buffer passed on, then the stream's cursor moved.
    fun seek(var self, pos: SeekFrom) -> Result<int64, IoError> {
        self.drain()?
        var w = self.sink.pop()
        let got = w.seek(pos)
        self.sink.push(w)
        return got
    }
}

// --- Any stream ---------------------------------------------------------------------

// Everything `r` gives up to its end. The stream is taken by value: the
// caller's copy doesn't move (a descriptor's offset, which the platform
// keeps, does).
pub fun read_all<R: Read>(r: R) -> Result<[uint8], IoError> {
    var src = r
    var out = StringBuilder()
    while true {
        let chunk = src.read(CHUNK)?
        if chunk.len() == 0 { break }
        out.append(text_of(chunk, 0, chunk.len()))
    }
    return Ok(bytes_of(out.build()))
}

// Everything `r` gives up to its end written to `w`, 64 KiB at a time, which
// is flushed and given back (the way to the bytes of a `MemoryStream` or a
// `BufferedWriter`'s stream). Both are taken by value, as in `read_all`.
pub fun copy<R: Read, W: Write>(r: R, w: W) -> Result<W, IoError> {
    var src = r
    var dst = w
    while true {
        let chunk = src.read(COPY_CHUNK)?
        if chunk.len() == 0 { break }
        dst.write(chunk)?
    }
    dst.flush()?
    return Ok(dst)
}

// --- Tests of the generic code (D162) ------------------------------------------

// The bytes as text, to compare them.
fun shown(r: Result<[uint8], IoError>) -> str {
    return match r {
        Ok(b) => text_of(b, 0, b.len())
        Err(_) => "<error>"
    }
}

// A result as text: its value, or the error's name.
fun said<T: Format>(r: Result<T, IoError>) -> str {
    return match r {
        Ok(v) => f"{v}"
        Err(IoError.InvalidInput) => "InvalidInput"
        Err(IoError.Other(code)) => f"Other({code})"
        Err(_) => "<error>"
    }
}

fun ok(r: Result<(), IoError>) -> bool {
    return match r {
        Ok(()) => true
        Err(_) => false
    }
}

fun shown_line(r: Result<Option<str>, IoError>) -> str {
    return match r {
        Ok(Some(s)) => s
        Ok(None) => "<end>"
        Err(_) => "<error>"
    }
}

// What a memory stream holds, written, sought and read back.
#test
fun memory_round_trip() {
    var m = memory_stream()
    assert(said(m.write(bytes_of("hello, "))) == "7", "write gives its length")
    assert(said(m.write(bytes_of("world"))) == "5", "a second write")
    assert(m.text() == "hello, world", "the bytes written")
    assert(shown(m.read(4)) == "", "the cursor is at the end")
    assert(said(m.seek(SeekFrom.Start(0))) == "0", "seek to the start")
    assert(shown(m.read(5)) == "hello", "read from the start")
    assert(m.position() == 5i64, "the cursor moved")
    assert(shown(m.read(100)) == ", world", "a read past the end gives the rest")
    assert(shown(m.read(1)) == "", "then nothing")
    let b = from_str("bytes").bytes()
    assert(b.len() == 5 && b[0] == 98u8, "bytes()")
    var e = from_bytes(b)
    assert(shown(e.read(0)) == "", "a read of 0")
    assert(shown(e.read(-3)) == "", "a read of fewer than 0")
}

// Seeks from each place, and writes over and past the end.
#test
fun memory_seeks() {
    var m = from_str("0123456789")
    assert(said(m.seek(SeekFrom.End(-3))) == "7", "from the end")
    assert(shown(m.read(10)) == "789", "the last three")
    assert(said(m.seek(SeekFrom.Current(-5))) == "5", "back from the cursor")
    assert(said(m.seek(SeekFrom.Current(2))) == "7", "on from the cursor")
    assert(said(m.seek(SeekFrom.Start(-1))) == "InvalidInput", "before the start")
    assert(m.position() == 7i64, "a failed seek leaves the cursor")
    assert(said(m.seek(SeekFrom.Start(2))) == "2", "to 2")
    assert(said(m.write(bytes_of("ab"))) == "2", "write over")
    assert(m.text() == "01ab456789", "written over in place")
    assert(said(m.seek(SeekFrom.End(0))) == "10", "to the end")
    assert(said(m.write(bytes_of("XYZ"))) == "3", "append")
    assert(m.text() == "01ab456789XYZ", "appended")
    assert(said(m.seek(SeekFrom.End(2))) == "15", "past the end")
    assert(shown(m.read(4)) == "", "nothing to read past the end")
    assert(said(m.write(bytes_of("!"))) == "1", "write past the end")
    let b = m.bytes()
    assert(b.len() == 16 && b[13] == 0u8 && b[14] == 0u8 && b[15] == '!', "the gap is zeros")
    assert(ok(m.flush()), "flush")
}

// A `Buffered` over a memory stream reads lines, exact counts and the rest.
#test
fun buffered_lines() {
    var r = buffered(from_str("one\r\ntwo\n\nthree"))
    assert(shown_line(r.read_line()) == "one\r", "the \\r stays")
    assert(shown_line(r.read_line()) == "two", "a plain line")
    assert(shown_line(r.read_line()) == "", "an empty line")
    assert(shown_line(r.read_line()) == "three", "a last line without \\n")
    assert(shown_line(r.read_line()) == "<end>", "then the end")
    assert(shown_line(r.read_line()) == "<end>", "and again")
    var e = buffered(memory_stream())
    assert(shown_line(e.read_line()) == "<end>", "nothing at all")
    var n = buffered(from_str("\n"))
    assert(shown_line(n.read_line()) == "", "one empty line")
    assert(shown_line(n.read_line()) == "<end>", "and no more")
}

// Lines longer than a read, so a line is put together over several.
#test
fun buffered_long_lines() {
    var sb = StringBuilder()
    var i = 0
    while i < 3 {
        var k = 0
        while k < 5000 + i {
            sb.append_byte(97u8 + (i as uint8))
            k += 1
        }
        sb.append("\r\n")
        i += 1
    }
    var r = buffered(from_str(sb.build()))
    i = 0
    while i < 3 {
        match r.read_line() {
            Ok(Some(l)) => {
                assert(l.len() == 5000 + i + 1, f"line {i}'s length")
                assert(l[0] == 97u8 + (i as uint8) && l[^1] == 13u8, f"line {i}'s bytes")
            }
            _ => panic(f"line {i}")
        }
        i += 1
    }
    assert(shown_line(r.read_line()) == "<end>", "the end")
}

// After a line: exact counts, a plain read and the rest; too few bytes
// for an exact count leave them unread.
#test
fun buffered_exact_and_rest() {
    var r = buffered(from_str("header\nbody bytes and the rest"))
    assert(shown_line(r.read_line()) == "header", "a line")
    assert(shown_line(r.read_exact(4)) == "body", "four bytes")
    assert(shown_line(r.read_exact(0)) == "", "none")
    assert(shown(r.read(6)) == " bytes", "a read through it")
    match r.read_to_end() {
        Ok(s) => assert(s == " and the rest", "the rest")
        Err(_) => panic("read_to_end")
    }
    assert(said(r.read_to_end()) == "", "nothing after the end")
    var s = buffered(from_str("abc"))
    assert(shown_line(s.read_exact(4)) == "<end>", "too few bytes")
    assert(shown_line(s.read_exact(3)) == "abc", "which stay unread")
}

// A `Buffered` is a `Read` itself, so adapters stack, and a big read goes
// past its buffer.
#test
fun buffered_stacks() {
    var sb = StringBuilder()
    var i = 0
    while i < 10000 {
        sb.append_byte(48u8 + ((i % 10) as uint8))
        i += 1
    }
    let text = sb.build()
    var r = buffered(buffered(from_str(text)))
    assert(shown(r.read(3)) == "012", "a small read")
    match r.read(9000) {
        Ok(b) => assert(b.len() > 0 && b[0] == '3', "a big read goes on where the small one stopped")
        Err(_) => panic("read")
    }
    let all = read_all(buffered(buffered(from_str(text))))
    assert(shown(all) == text, "read_all through two")
    let inner = buffered(from_str("xyz")).into_inner()
    assert(inner.text() == "xyz", "into_inner")
}

// `copy` and `read_all` over any `Read`, `copy` to any `Write`.
#test
fun copy_and_read_all() {
    let w = copy(from_str("copied"), memory_stream())
    match w {
        Ok(m) => assert(m.text() == "copied", "into a memory stream")
        Err(_) => panic("copy")
    }
    var src = from_str("abc")
    assert(shown(read_all(src)) == "abc", "read_all")
    assert(src.position() == 0i64, "the caller's stream doesn't move")
    assert(shown(read_all(memory_stream())) == "", "read_all of nothing")
    match copy(from_str("through a writer"), buffered_writer_with(memory_stream(), 4)) {
        Ok(bw) => {
            match bw.into_inner() {
                Ok(m) => assert(m.text() == "through a writer", "copy into a BufferedWriter")
                Err(_) => panic("into_inner")
            }
        }
        Err(_) => panic("copy")
    }
    // more than one of its reads (MYLA-379)
    var sb = StringBuilder()
    var i = 0
    while i < COPY_CHUNK + 7 {
        sb.append_byte((i % 251) as uint8)
        i += 1
    }
    let big = sb.build()
    match copy(from_str(big), memory_stream()) {
        Ok(m) => assert(m.text() == big, "a copy of more than 64 KiB")
        Err(_) => panic("copy")
    }
}

// A `BufferedWriter` passes its bytes on when its buffer fills, on `flush`,
// and on `into_inner`.
#test
fun buffered_writer_flushes() {
    var w = buffered_writer_with(memory_stream(), 8)
    assert(said(w.write_str("abc")) == "3", "a small write")
    assert(w.sink[0].text() == "", "kept in the buffer")
    assert(said(w.write_str("defgh")) == "5", "fills the buffer")
    assert(w.sink[0].text() == "", "still kept: exactly full")
    assert(said(w.write(bytes_of("i"))) == "1", "one more")
    assert(w.sink[0].text() == "abcdefgh", "the full buffer went on")
    assert(said(w.write(bytes_of("a write longer than the buffer"))) == "30", "a long write")
    assert(w.sink[0].text() == "abcdefghia write longer than the buffer", "goes straight on")
    assert(said(w.write_str("tail")) == "4", "a tail")
    assert(ok(w.flush()), "flush")
    assert(w.sink[0].text() == "abcdefghia write longer than the buffertail", "flushed")
    var big = buffered_writer(memory_stream())
    var i = 0
    while i < 3000 {
        assert(said(big.write_str("line\n")) == "5", "write_str")
        i += 1
    }
    match big.into_inner() {
        Ok(m) => assert(m.bytes().len() == 15000, "every byte, in order")
        Err(_) => panic("into_inner")
    }
}

// A seek through a `Buffered` drops what it buffered, and one through a
// `BufferedWriter` passes its buffer on first.
#test
fun buffered_seeks() {
    var r = buffered(from_str("first\nsecond\nthird\n"))
    assert(shown_line(r.read_line()) == "first", "a line, and the rest buffered")
    assert(said(r.seek(SeekFrom.Current(0))) == "6", "the cursor is after the line, not after the buffer")
    assert(shown_line(r.read_line()) == "second", "the next line")
    assert(said(r.seek(SeekFrom.Start(0))) == "0", "back to the start")
    assert(shown_line(r.read_line()) == "first", "the first line again")
    assert(said(r.seek(SeekFrom.End(-6))) == "13", "near the end")
    assert(shown_line(r.read_line()) == "third", "the last line")
    assert(shown_line(r.read_line()) == "<end>", "the end")
    assert(said(r.seek(SeekFrom.Start(13))) == "13", "a seek after the end of the input")
    assert(shown_line(r.read_line()) == "third", "reads again")
    var w = buffered_writer(from_str("0123456789"))
    assert(said(w.write_str("ab")) == "2", "buffered")
    assert(said(w.seek(SeekFrom.Start(5))) == "5", "a seek")
    assert(said(w.write_str("XY")) == "2", "written after the seek")
    match w.into_inner() {
        Ok(m) => assert(m.text() == "ab234XY789", "each write where the cursor was")
        Err(_) => panic("into_inner")
    }
}

// Bytes that aren't text go through every path unchanged.
#test
fun any_bytes() {
    var b: [uint8] = []
    var i = 0
    while i < 256 {
        b.push(i as uint8)
        i += 1
    }
    let all = read_all(buffered(from_bytes(b)))
    assert(said_bytes(all) == "256 0 255", "read_all")
    match copy(buffered(from_bytes(b)), buffered_writer_with(memory_stream(), 7)) {
        Ok(w) => {
            match w.into_inner() {
                Ok(m) => assert(said_bytes(Ok(m.bytes())) == "256 0 255", "copy")
                Err(_) => panic("into_inner")
            }
        }
        Err(_) => panic("copy")
    }
    var m = from_bytes(b)
    assert(said_bytes(m.read(300)) == "256 0 255", "read")
    var r = buffered(from_bytes(b))
    match r.read_to_end() {
        Ok(s) => assert(s.len() == 256 && s[0] == 0u8 && s[255] == 255u8, "read_to_end")
        Err(_) => panic("read_to_end")
    }
}

// The length, first and last byte of a result's bytes.
fun said_bytes(r: Result<[uint8], IoError>) -> str {
    return match r {
        Ok(b) => {
            if b.len() == 0 { "0" } else { f"{b.len()} {b[0]} {b[^1]}" }
        }
        Err(_) => "<error>"
    }
}

// A stream on a descriptor is `Pollable`, a `Buffered` over one too; a bad
// descriptor fails each operation.
#test
fun descriptors() {
    assert(fd_stream(0).descriptor() == 0, "a descriptor stream's descriptor")
    assert(stdin().descriptor() == 0, "stdin's descriptor")
    assert(reader(5).descriptor() == 5, "a reader's descriptor")
    var bad = fd_stream(-1)
    assert(shown(bad.read(4)) == "<error>", "a read of a bad descriptor fails")
    assert(said(bad.write(bytes_of("x"))) == "Other(9)", "and a write")
    assert(said(bad.seek(SeekFrom.Start(0))) == "Other(9)", "and a seek")
}

// A stream of its own implements `read` alone, or `write` and `flush` (D177),
// and `Buffered`, `BufferedWriter`, `read_all` and `copy` work over it.
struct Countdown {
    left: int,
}

impl Read for Countdown {
    // Up to `n` of the bytes "9", "8", … "0", at most three a read.
    fun read(var self, n: int) -> Result<[uint8], IoError> {
        var out: [uint8] = []
        while out.len() < n && out.len() < 3 && self.left > 0 {
            self.left -= 1
            out.push(48u8 + (self.left as uint8))
        }
        return Ok(out)
    }
}

struct Tally {
    seen: int,
    flushes: int,
}

impl Write for Tally {
    fun write(var self, b: [uint8]) -> Result<int, IoError> {
        self.seen += b.len()
        return Ok(b.len())
    }

    fun flush(var self) -> Result<(), IoError> {
        self.flushes += 1
        return Ok(())
    }
}

#test
fun bytes_only_streams() {
    var r = buffered(Countdown { left: 10 })
    assert(shown_line(r.read_exact(4)) == "9876", "read_exact over short reads")
    assert(said(r.read_to_end()) == "543210", "and the rest")
    assert(shown(read_all(Countdown { left: 5 })) == "43210", "read_all")
    var w = buffered_writer_with(Tally { seen: 0, flushes: 0 }, 4)
    assert(said(w.write_str("ab")) == "2", "write_str into the buffer")
    assert(said(w.write(bytes_of("cdefg"))) == "5", "write past it")
    match w.into_inner() {
        Ok(t) => assert(t.seen == 7 && t.flushes == 1, "every byte, flushed once")
        Err(_) => panic("into_inner")
    }
    match copy(Countdown { left: 7 }, Tally { seen: 0, flushes: 0 }) {
        Ok(t) => assert(t.seen == 7, "copy")
        Err(_) => panic("copy")
    }
}

// The lines and exact counts of a text read 1, 2, 3, 7, 64 bytes at a
// time and all at once are the same (M17's reads, which give little).
#test
fun buffered_over_short_reads() {
    var long = StringBuilder()
    var i = 0
    while i < 300 {
        long.append_byte('x')
        i += 1
    }
    let text = "one\r\n\ntwo words\n" + long.build() + "\nlast"
    let want = ["one\r", "", "two words", long.build(), "last", "<end>"]
    for k in [1, 2, 3, 7, 64, 100000] {
        var r = buffered(short_reads(from_str(text), k))
        for w in want {
            assert(shown_line(r.read_line()) == w, f"a line, {k} bytes a read")
        }
        var e = buffered(short_reads(from_str("abcdefghij"), k))
        assert(shown_line(e.read_exact(3)) == "abc", "three bytes")
        assert(shown_line(e.read_exact(4)) == "defg", "four more")
        assert(shown_line(e.read_exact(5)) == "<end>", "too few left")
        assert(shown_line(e.read_exact(3)) == "hij", "which stay unread")
        assert(shown_line(e.read_exact(1)) == "<end>", "the end")
    }
    var s = short_reads(from_str("abcdef"), 4)
    assert(shown(s.read(10)) == "abcd", "at most four bytes a read")
    assert(shown(s.read(1)) == "e", "fewer if asked")
    assert(s.into_inner().position() == 5i64, "into_inner")
    var one = short_reads(from_str("ab"), 0)
    assert(shown(one.read(5)) == "a", "at least one byte a read")
}

// A stream that gives one of `parts` a read, and fails for a part "!".
struct Hiccup {
    parts: [str],
    at: int,
}

impl Read for Hiccup {
    fun read(var self, n: int) -> Result<[uint8], IoError> {
        if self.at >= self.parts.len() { return Ok([]) }
        let p = self.parts[self.at]
        self.at += 1
        if p == "!" { return Err(IoError.Interrupted) }
        return Ok(bytes_of(p))
    }
}

// A read that fails in the middle of a line or an exact count leaves the
// bytes read so far unread.
#test
fun buffered_failed_read_keeps_bytes() {
    var r = buffered(Hiccup { parts: ["ab", "cd", "!", "ef\ngh", "!", "ij"], at: 0 })
    assert(shown_line(r.read_line()) == "<error>", "the read fails")
    assert(shown_line(r.read_line()) == "abcdef", "the line read before it is kept")
    assert(shown_line(r.read_exact(3)) == "<error>", "a read fails again")
    assert(shown_line(r.read_exact(3)) == "ghi", "the bytes before it are kept")
    assert(shown_line(r.read_line()) == "j", "the rest")
    assert(shown_line(r.read_line()) == "<end>", "the end")
}

// Offsets and lengths a memory stream can't hold are errors, not overflow
// (D184).
#test
fun memory_limits() {
    var m = from_str("abc")
    assert(said(m.seek(SeekFrom.Current(9223372036854775807))) == "InvalidInput", "far past the end")
    assert(said(m.seek(SeekFrom.Start(-9223372036854775807 - 1))) == "InvalidInput", "far before the start")
    assert(said(m.seek(SeekFrom.Start(2147483647))) == "2147483647", "the last offset")
    assert(said(m.write(bytes_of("x"))) == "Other(27)", "a write past it")
    assert(m.bytes().len() == 3, "which changes nothing")
}
