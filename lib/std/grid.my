// std.grid: a two-dimensional array of cells (MYLA-342, D164).
//
// A `Grid<T>` has a width, a height and `width * height` cells, row by row:
// the cell at `(x, y)` is `cells[y * width + x]`. `x` counts columns from
// the left and `y` rows from the top, so "up" is `y - 1`, as text reads.
//
// A position is an `(int, int)` tuple `(x, y)`, not a struct: a tuple is a
// map key and a `Set` element as it is (D163), is written and taken apart
// without an import (`(x + 1, y)`, `let (x, y) = p`), and is the node a
// search of `std.graph` over the grid wants. A struct key costs the same
// (measured, MYLA-342), but its literal needs a `from std.grid import`.
//
// A constructor's `T` comes from its arguments; `parse` makes a
// `Grid<char>` of text and `parse_with` a grid of anything a character maps
// to.

import std.list as list_m // `filled`, `extend`, `map` and `iter` of the cells
import std.option as option_m // `is_none`, `err` in the test functions

// Two grids are equal when their sizes and cells are (`T: Eq`); a grid of
// `Hash` cells is a map key (MYLA-379).
#derive(Eq, Hash)
pub struct Grid<T> {
    width: int,
    height: int,
    // The cells, row by row
    cells: [T],
}

// Why a text or a list of rows isn't a grid.
#derive(Eq)
pub enum GridError {
    // The row (from 1) with another number of cells than the first, its
    // number of cells and the first row's
    Ragged(int, int, int),
}

impl GridError {
    #test(GridError.Ragged(3, 4, 5))["row 3 has 4 cells, row 1 has 5"]
    #test(GridError.Ragged(2, 1, 0))["row 2 has 1 cell, row 1 has 0"]
    fun message(self) -> str {
        return match self {
            Ragged(row, n, first) => {
                let cells = if n == 1 { "cell" } else { "cells" }
                f"row {row} has {n} {cells}, row 1 has {first}"
            }
        }
    }
}

impl Format for GridError {
    #test(GridError.Ragged(2, 0, 1), "")["row 2 has 0 cells, row 1 has 1"]
    fun format(self, spec: str) -> str {
        return self.message()
    }
}

// A grid of `width` by `height` cells, each `fill`. A negative size, or one
// of more cells than an `int` counts, is a failure (D184).
pub fun new<T>(width: int, height: int, fill: T) -> Grid<T> {
    if width < 0 || height < 0 {
        panic(f"grid size {width} by {height} is negative")
    }
    if width > 0 && height > 2147483647 / width {
        panic(f"grid size {width} by {height} is more than 2147483647 cells")
    }
    return Grid { width: width, height: height, cells: list_m.filled(width * height, fill) }
}

// The grid of `rows`, `rows[y][x]` the cell at `(x, y)`; every row must
// have as many cells as the first.
pub fun of<T>(rows: [[T]]) -> Result<Grid<T>, GridError> {
    var cells: [T] = []
    let width = if rows.len() > 0 { rows[0].len() } else { 0 }
    for y in 0..rows.len() {
        if rows[y].len() != width {
            return Err(GridError.Ragged(y + 1, rows[y].len(), width))
        }
        cells.extend(rows[y])
    }
    return Ok(Grid { width: width, height: rows.len(), cells: cells })
}

// The grid of the characters of `text`, a line a row. A `"\r\n"` ends a
// line too, and a line break at the end is no row of its own. The empty
// text is the grid of no cells.
pub fun parse(text: str) -> Result<Grid<char>, GridError> {
    return parse_with(text, (c: char) => c)
}

// The grid of `text` as `parse` reads it, each character mapped by `f`.
pub fun parse_with<T>(text: str, f: (char) -> T) -> Result<Grid<T>, GridError> {
    var cells: [T] = []
    var width = 0
    var height = 0
    var start = 0
    while start < text.len() {
        var end = start
        while end < text.len() && text[end] != '\n' {
            end += 1
        }
        var stop = end
        if stop > start && text[stop - 1] == '\r' {
            stop -= 1
        }
        var n = 0
        for c in text[start:stop] {
            cells.push(f(c))
            n += 1
        }
        height += 1
        if height == 1 {
            width = n
        } else if n != width {
            return Err(GridError.Ragged(height, n, width))
        }
        start = end + 1
    }
    return Ok(Grid { width: width, height: height, cells: cells })
}

impl<T> Grid<T> {
    // Whether `p` is a position of the grid.
    fun in_bounds(self, p: (int, int)) -> bool {
        let (x, y) = p
        return x >= 0 && x < self.width && y >= 0 && y < self.height
    }

    // The cell at `p`, if `p` is in bounds.
    fun at(self, p: (int, int)) -> Option<T> {
        let (x, y) = p
        if x < 0 || x >= self.width || y < 0 || y >= self.height {
            return None
        }
        return Some(self.cells[y * self.width + x])
    }

    // Sets the cell at `p` to `v`; a `p` out of bounds is a failure, as it
    // is for a list.
    fun set(var self, p: (int, int), v: T) {
        let (x, y) = p
        if x < 0 || x >= self.width || y < 0 || y >= self.height {
            panic(f"grid position ({x}, {y}) out of bounds for {self.width} by {self.height}")
        }
        self.cells[y * self.width + x] = v
    }

    // The positions next to `p` across an edge that are in bounds: up,
    // right, down, left. A `p` out of bounds has those of its neighbours
    // that are in bounds.
    fun neighbours4(self, p: (int, int)) -> [(int, int)] {
        let (x, y) = p
        // Whether `x`, `x + 1` and `x - 1` are columns of the grid, and `y`,
        // `y - 1` and `y + 1` rows, compared so that nothing overflows
        let w = self.width
        let h = self.height
        let col = x >= 0 && x < w
        let row = y >= 0 && y < h
        var out: [(int, int)] = []
        if col && y > 0 && y <= h {
            out.push((x, y - 1))
        }
        if row && x >= -1 && x < w - 1 {
            out.push((x + 1, y))
        }
        if col && y >= -1 && y < h - 1 {
            out.push((x, y + 1))
        }
        if row && x > 0 && x <= w {
            out.push((x - 1, y))
        }
        return out
    }

    // The positions next to `p` across an edge or a corner that are in
    // bounds, clockwise from up: up, up-right, right, down-right, down,
    // down-left, left, up-left.
    fun neighbours8(self, p: (int, int)) -> [(int, int)] {
        let (x, y) = p
        // Whether the column `x`, the one right of it and the one left of
        // it are the grid's, and the row `y`, the one up and the one down,
        // compared as in `neighbours4`
        let w = self.width
        let h = self.height
        let col = x >= 0 && x < w
        let right = x >= -1 && x < w - 1
        let left = x > 0 && x <= w
        let row = y >= 0 && y < h
        let up = y > 0 && y <= h
        let down = y >= -1 && y < h - 1
        var out: [(int, int)] = []
        if col && up {
            out.push((x, y - 1))
        }
        if right && up {
            out.push((x + 1, y - 1))
        }
        if right && row {
            out.push((x + 1, y))
        }
        if right && down {
            out.push((x + 1, y + 1))
        }
        if col && down {
            out.push((x, y + 1))
        }
        if left && down {
            out.push((x - 1, y + 1))
        }
        if left && row {
            out.push((x - 1, y))
        }
        if left && up {
            out.push((x - 1, y - 1))
        }
        return out
    }

    // The index of `p` in `cells`, `y * width + x`: a node number for the
    // searches of `std.graph` over integers (`bfs_dense`, `dijkstra_dense`).
    // A `p` out of bounds is a failure, as it is for `set`.
    fun index(self, p: (int, int)) -> int {
        let (x, y) = p
        if x < 0 || x >= self.width || y < 0 || y >= self.height {
            panic(f"grid position ({x}, {y}) out of bounds for {self.width} by {self.height}")
        }
        return y * self.width + x
    }

    // The position of the cell `cells[i]`; an `i` out of bounds is a
    // failure.
    fun pos(self, i: int) -> (int, int) {
        if i < 0 || i >= self.cells.len() {
            panic(f"grid index {i} out of bounds for {self.cells.len()} cells")
        }
        return (i % self.width, i / self.width)
    }

    // An iterator over the cells, row by row (D171): `for c in g.iter()`,
    // or a pipeline of `std.iter`; `g.pos(i)` is the position of the `i`th,
    // `g.iter() |> iter.enumerate()` numbering them. It holds the grid as it
    // is now (MYLA-553).
    fun iter(self) -> list_m.ListIter<T> {
        return self.cells.iter()
    }

    // Every position, row by row.
    fun positions(self) -> [(int, int)] {
        var out: [(int, int)] = []
        for y in 0..self.height {
            for x in 0..self.width {
                out.push((x, y))
            }
        }
        return out
    }

    // The cells of row `y`, left to right; a `y` out of bounds is a
    // failure, as it is for `column`.
    fun row(self, y: int) -> [T] {
        if y < 0 || y >= self.height {
            panic(f"grid row {y} out of bounds for height {self.height}")
        }
        return self.cells[y * self.width:(y + 1) * self.width]
    }

    // The cells of column `x`, top to bottom; an `x` out of bounds is a
    // failure.
    fun column(self, x: int) -> [T] {
        if x < 0 || x >= self.width {
            panic(f"grid column {x} out of bounds for width {self.width}")
        }
        var out: [T] = []
        for y in 0..self.height {
            out.push(self.cells[y * self.width + x])
        }
        return out
    }

    // The grid of `f` of each cell.
    fun map<U>(self, f: (T) -> U) -> Grid<U> {
        return Grid { width: self.width, height: self.height, cells: self.cells.map(f) }
    }

    // The grid flipped about its diagonal: the cell at `(x, y)` goes to
    // `(y, x)`, rows become columns.
    fun transposed(self) -> Grid<T> {
        var cells: [T] = []
        for x in 0..self.width {
            for y in 0..self.height {
                cells.push(self.cells[y * self.width + x])
            }
        }
        return Grid { width: self.height, height: self.width, cells: cells }
    }
}

impl<T: Eq> Grid<T> {
    // The first position, row by row, whose cell is `v`.
    fun find(self, v: T) -> Option<(int, int)> {
        for i in 0..self.cells.len() {
            if self.cells[i] == v {
                return Some((i % self.width, i / self.width))
            }
        }
        return None
    }

    // Every position whose cell is `v`, row by row.
    fun find_all(self, v: T) -> [(int, int)] {
        var out: [(int, int)] = []
        for i in 0..self.cells.len() {
            if self.cells[i] == v {
                out.push((i % self.width, i / self.width))
            }
        }
        return out
    }
}

impl<T: Format> Grid<T> {
    // The grid as text, a line a row, each cell as `{}` formats it, with no
    // line break after the last row: `parse` reads a `Grid<char>`'s text
    // back.
    fun text(self) -> str {
        var sb = StringBuilder()
        for y in 0..self.height {
            if y > 0 {
                sb.append("\n")
            }
            for x in 0..self.width {
                sb.append(f"{self.cells[y * self.width + x]}")
            }
        }
        return sb.build()
    }
}

// --- tests -------------------------------------------------------------------
// The grid is generic, which a `#test` case can't take (D116), so most tests
// are test functions (D162).

// The grid of an `Ok`; a failure for an `Err`, with its message (std.option's
// `expect` can't show it).
fun ok<T>(r: Result<Grid<T>, GridError>) -> Grid<T> {
    return match r {
        Ok(g) => g
        Err(e) => panic(e.message())
    }
}


const MAZE: str = "#####\n#S..#\n#.#E#\n#####\n"

#test
fun parse_and_print() {
    let g = ok(parse(MAZE))
    assert(g.width == 5 && g.height == 4, "the size")
    assert(g.at((1, 1)) == Some('S') && g.at((3, 2)) == Some('E'), "at")
    assert(g.at((5, 0)).is_none() && g.at((0, -1)).is_none(), "at out of bounds")
    assert(g.text() + "\n" == MAZE, "text gives the text back")
    let digits = ok(parse_with("123\n456", (c: char) => c - '0'))
    assert(digits.at((2, 1)) == Some(6) && digits.text() == "123\n456", "parse_with")
    match parse_with("12\n3", (c: char) => c) {
        Ok(_) => assert(false, "ragged")
        Err(e) => assert(e.message() == "row 2 has 1 cell, row 1 has 2", "the error")
    }
    let e: Grid<int> = new(0, 0, 7)
    assert(e.text() == "" && e.positions() == [], "the empty grid")
}

// `parse`'s results, as a test function: the native harness can't compare an
// enum of one variant yet, as `#test` cases would (it adds a `_` arm, which is
// unreachable).
#test
fun parsing() {
    let g = ok(parse("ab\ncd\n"))
    assert(g.width == 2 && g.height == 2 && g.cells == ['a', 'b', 'c', 'd'], "a line break at the end")
    assert(ok(parse("#.\r\n.#")).cells == ['#', '.', '.', '#'], "CRLF")
    let e = ok(parse(""))
    assert(e.width == 0 && e.height == 0 && e.cells == [], "the empty text")
    let u = ok(parse("é·\n··"))
    assert(u.width == 2 && u.cells == ['é', '·', '·', '·'], "a cell a character")
    let blank = ok(parse("\n"))
    assert(blank.width == 0 && blank.height == 1, "one empty line")
    assert(parse("abc\nab\nabc").err() == Some(GridError.Ragged(2, 2, 3)), "a short row")
    assert(parse("ab\n\nab").err() == Some(GridError.Ragged(2, 0, 2)), "an empty row")
    assert(parse("a\nb\ncd\n").err() == Some(GridError.Ragged(3, 2, 1)), "a long row")
    assert(of([[1, 2], [3]]).err() == Some(GridError.Ragged(2, 1, 2)), "of")
    let none_rows: Grid<int> = ok(of([]))
    assert(none_rows.width == 0 && none_rows.height == 0, "no rows")
}

#test
fun cells() {
    var g = new(3, 2, 0)
    assert(g.cells == [0, 0, 0, 0, 0, 0], "filled")
    g.set((2, 1), 5)
    g.set((0, 1), 4)
    assert(g.at((2, 1)) == Some(5) && g.cells[g.index((2, 1))] == 5, "set and index")
    assert(g.pos(5) == (2, 1) && g.index(g.pos(4)) == 4, "pos")
    assert(g.row(1) == [4, 0, 5] && g.column(2) == [0, 5], "row and column")
    assert(g.in_bounds((2, 1)) && !g.in_bounds((3, 1)) && !g.in_bounds((-1, 0)) && !g.in_bounds((0, 2)), "in_bounds")
    assert(g.positions() == [(0, 0), (1, 0), (2, 0), (0, 1), (1, 1), (2, 1)], "positions")
    let t = g.transposed()
    assert(t.width == 2 && t.height == 3 && t.at((1, 2)) == Some(5) && t.row(2) == [0, 5], "transposed")
    let s = g.map((v: int) => if v > 0 { '#' } else { '.' })
    assert(s.text() == "...\n#.#", "map")
    assert(s.find('#') == Some((0, 1)) && s.find('x').is_none(), "find")
    assert(s.find_all('#') == [(0, 1), (2, 1)] && s.find_all('.').len() == 4, "find_all")
    let r = ok(of([[1, 2], [3, 4], [5, 6]]))
    assert(r.width == 2 && r.height == 3 && r.at((1, 2)) == Some(6), "of")
    // `==` and map keys (MYLA-379)
    assert(r == ok(of([[1, 2], [3, 4], [5, 6]])) && r != ok(of([[1, 2, 3], [4, 5, 6]])) && t != r, "==")
    var seen: [Grid<int>: int] = [:]
    seen[r] = 1
    seen[t] = 2
    seen[ok(of([[1, 2], [3, 4], [5, 6]]))] = 3
    assert(seen.len() == 2 && seen[r] == 3, "a map key")
}

#test
fun neighbours() {
    let g = new(3, 3, '.')
    assert(g.neighbours4((1, 1)) == [(1, 0), (2, 1), (1, 2), (0, 1)], "four in the middle")
    assert(g.neighbours4((0, 0)) == [(1, 0), (0, 1)], "two in a corner")
    assert(g.neighbours4((2, 1)) == [(2, 0), (2, 2), (1, 1)], "three on an edge")
    assert(g.neighbours8((1, 1)) == [(1, 0), (2, 0), (2, 1), (2, 2), (1, 2), (0, 2), (0, 1), (0, 0)], "eight in the middle")
    assert(g.neighbours8((2, 2)) == [(2, 1), (1, 2), (1, 1)], "three in a corner")
    assert(new(1, 1, 0).neighbours8((0, 0)) == [], "none in a grid of one cell")
}

// The number of cells of a new grid of `w` by `h`.
#test(3, 4)[12]
#test(0, 5)[0]
#test(-1, 2)[panic("grid size -1 by 2 is negative")]
#test(65536, 65536)[panic("grid size 65536 by 65536 is more than 2147483647 cells")] // M18: 0 cells natively
#test(0, 2147483647)[0]
fun new_cells(w: int, h: int) -> int {
    return new(w, h, 'x').cells.len()
}

// Row `y` and column `x` of a 3 by 2 grid of 0 to 5: out of bounds both are
// a failure, as `set` is (MYLA-342's follow-up: a row out of bounds was
// empty and a column wrapped into the next row).
#test(1)[[3, 4, 5]]
#test(2)[panic("grid row 2 out of bounds for height 2")]
#test(-1)[panic("grid row -1 out of bounds for height 2")]
fun row_of(y: int) -> [int] {
    return ok(of([[0, 1, 2], [3, 4, 5]])).row(y)
}

#test(2)[[2, 5]]
#test(3)[panic("grid column 3 out of bounds for width 3")]
#test(-1)[panic("grid column -1 out of bounds for width 3")]
fun column_of(x: int) -> [int] {
    return ok(of([[0, 1, 2], [3, 4, 5]])).column(x)
}

// `index` and `pos` of a 3 by 2 grid, which are a failure out of bounds.
#test(2, 1)[5]
#test(3, 0)[panic("grid position (3, 0) out of bounds for 3 by 2")]
#test(0, 2147483647)[panic("grid position (0, 2147483647) out of bounds for 3 by 2")] // overflowed
fun index_of(x: int, y: int) -> int {
    return new(3, 2, 0).index((x, y))
}

#test(5)[(2, 1)]
#test(6)[panic("grid index 6 out of bounds for 6 cells")]
#test(-1)[panic("grid index -1 out of bounds for 6 cells")]
fun pos_of(i: int) -> (int, int) {
    return new(3, 2, 0).pos(i)
}

// The neighbours of a position out of bounds are those in bounds, and no
// coordinate overflows.
#test
fun neighbours_out_of_bounds() {
    let g = new(3, 3, '.')
    assert(g.neighbours4((-1, 1)) == [(0, 1)] && g.neighbours4((1, 3)) == [(1, 2)], "next to an edge")
    assert(g.neighbours4((5, 0)) == [] && g.neighbours4((3, 3)) == [], "far or diagonal")
    assert(g.neighbours8((3, 3)) == [(2, 2)] && g.neighbours8((-1, 1)) == [(0, 0), (0, 1), (0, 2)], "eight, from outside")
    assert(g.neighbours8((1, -1)) == [(2, 0), (1, 0), (0, 0)], "eight, from above")
    let big = 2147483647
    assert(g.neighbours4((big, big)) == [] && g.neighbours8((big, 0)) == [], "at int's maximum")
    let small = -2147483647 - 1
    assert(g.neighbours4((small, small)) == [] && g.neighbours8((0, small)) == [], "at int's minimum")
}

// The cells of a 2 by 2 grid of zeros after a 1 is set at `(x, y)`.
#test(1, 1)[[0, 0, 0, 1]]
#test(2, 0)[panic("grid position (2, 0) out of bounds for 2 by 2")]
#test(0, -1)[panic("grid position (0, -1) out of bounds for 2 by 2")]
fun set_one(x: int, y: int) -> [int] {
    var g = new(2, 2, 0)
    g.set((x, y), 1)
    return g.cells
}

// `iter()` visits the cells row by row, as `positions()` lists their
// places (MYLA-553).
#test
fun iterating() {
    let g = of([['a', 'b'], ['c', 'd'], ['e', 'f']]).expect("a grid")
    var seen: [char] = []
    for c in g.iter() {
        seen.push(c)
    }
    assert(seen == ['a', 'b', 'c', 'd', 'e', 'f'], "row by row")
    var i = 0
    for c in g.iter() {
        assert(g.at(g.pos(i)) == Some(c) && g.positions()[i] == g.pos(i), f"cell {i} at its position")
        i += 1
    }
    var none = 0
    for c in new(0, 4, 'x').iter() {
        none += 1
    }
    assert(none == 0, "a grid without cells")
}
