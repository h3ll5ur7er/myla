// std.toml — TOML 1.0 documents, read and written (MYLA-89, MYLA-402,
// MYLA-407).
//
// `parse` reads a TOML 1.0 document into a `Toml` table: strings (basic,
// literal and both multi-line kinds), integers (decimal, hexadecimal, octal
// and binary, in int64), floats (`inf`, `nan`), booleans, offset and local
// date-times, local dates and times, arrays of any values, inline tables,
// dotted keys, tables and arrays of tables. The tests compare it with
// Python's `tomllib` and with the toml-test suite. An error says what is
// wrong and where (line and column).
//
// `parse_doc` also keeps where each key and its value are, so a program that
// checks the document (the project tool, MYLA-93) can point at them.
//
// `to_string` writes a document back (MYLA-402), so that `parse` reads it as
// the same value, keys in the same order (see "Writing" below).
//
// Typed values (MYLA-407, as std.json's D172): `ToToml` and `FromToml`,
// their impls for the built-in types, and `encode`/`decode<T>` over them;
// `#derive(Toml)` writes a struct's or an enum's impls, calling the helpers
// below (`members`, `member`, `optional_member`, `variant_of`,
// `unit_variant`, `payload`, `unknown_variant`) by name, so they keep their
// signatures.

import std.map as map_m // `m.get(k)`
from .num import parse_float, format_float

// A TOML value. A table keeps its keys in the order they were defined (a
// table that a header like `[a.b]` or a dotted key creates on the way counts
// from there); an array of tables is an `Array` of `Table`s. Two values are
// equal when they hold the same, a NaN equal to a NaN, so that a document
// written and read back equals itself.
pub enum Toml {
    Str(str),
    Int(int64),
    Float(float64),
    Bool(bool),
    // an offset date-time (`1979-05-27T07:32:00Z`, `…-07:00`) or a local
    // one (`1979-05-27T07:32:00`)
    DateTime(TomlDateTime),
    // a local date, `1979-05-27`
    Date(TomlDate),
    // a local time, `07:32:00.5`
    Time(TomlTime),
    Array([Toml]),
    Table([(str, Toml)]),
}

// A date: `year` 1 to 9999, `month` 1 to 12, `day` 1 to the month's last.
#derive(Eq)
pub struct TomlDate {
    year: int32,
    month: int32,
    day: int32,
}

// A time of day: `hour` 0 to 23, `minute` and `second` 0 to 59,
// `nanosecond` 0 to 999999999 (digits past the ninth are cut off, as TOML
// allows).
#derive(Eq)
pub struct TomlTime {
    hour: int32,
    minute: int32,
    second: int32,
    nanosecond: int32,
}

// A date and a time, with the offset from UTC in minutes (`Some(0)` for `Z`,
// `Some(-420)` for `-07:00`), or `None` for a local date-time.
#derive(Eq)
pub struct TomlDateTime {
    date: TomlDate,
    time: TomlTime,
    offset: Option<int32>,
}

impl Eq for Toml {
    #test(Toml.Float(0.0 / 0.0), Toml.Float(0.0 / 0.0))[true]
    #test(Toml.Array([Toml.Int(1)]), Toml.Array([Toml.Float(1.0)]))[false]
    #test(Toml.Table([("a", Toml.Str("x"))]), Toml.Table([("a", Toml.Str("x"))]))[true]
    fun eq(self, other: Toml) -> bool {
        return match (self, other) {
            (Toml.Str(a), Toml.Str(b)) => a == b
            (Toml.Int(a), Toml.Int(b)) => a == b
            (Toml.Float(a), Toml.Float(b)) => a == b || (a != a && b != b)
            (Toml.Bool(a), Toml.Bool(b)) => a == b
            (Toml.DateTime(a), Toml.DateTime(b)) => a == b
            (Toml.Date(a), Toml.Date(b)) => a == b
            (Toml.Time(a), Toml.Time(b)) => a == b
            (Toml.Array(a), Toml.Array(b)) => a == b
            (Toml.Table(a), Toml.Table(b)) => a == b
            _ => false
        }
    }
}

// What is wrong: a text that isn't TOML (`parse`), or a value that doesn't
// fit the type it is read into (`decode`, `FromToml`).
#derive(Eq)
pub enum TomlErrorKind {
    // The text isn't TOML: `line` and `col` say where
    Syntax,
    // A table without a key its type needs (the path names the key)
    MissingField,
    // A value of another kind than its type takes: a string for a number, an
    // array for a struct, a variant with or without a payload it hasn't;
    // also a value `encode` can't make a document of (one that isn't a table)
    WrongType,
    // A number its type can't hold
    OutOfRange,
    // A name that isn't one of the enum's variants
    UnknownVariant,
}

// Why a text isn't TOML or a value doesn't fit its type, and where: for a
// `Syntax` error the line and column in the text (counting from 1, the
// column in characters) and an empty path; for the others the path of the
// value in the document, `$.servers[2].ip` (`$` the whole of it, as std.json
// writes paths), and a line and column of 0.
#derive(Eq)
pub struct TomlError {
    kind: TomlErrorKind,
    msg: str,
    line: int32,
    col: int32,
    path: str,
}

impl TomlError {
    // The reason in words, without the position.
    #test(TomlError { kind: TomlErrorKind.Syntax, msg: "expected a value", line: 1, col: 5, path: "" })["expected a value"]
    fun message(self) -> str {
        return self.msg
    }
}

impl Format for TomlError {
    // `line:col: why` for a syntax error, `path: why` for the others.
    #test(TomlError { kind: TomlErrorKind.Syntax, msg: "expected a value", line: 1, col: 5, path: "" }, "")["1:5: expected a value"]
    #test(TomlError { kind: TomlErrorKind.MissingField, msg: "missing field", line: 0, col: 0, path: "$.a" }, "")["$.a: missing field"]
    fun format(self, spec: str) -> str {
        return match self.kind {
            Syntax => f"{self.line}:{self.col}: {self.msg}"
            _ => f"{self.path}: {self.msg}"
        }
    }
}

// Where something is in the text: from `line`:`col` to just before
// `end_line`:`end_col` (lines and columns count from 1, columns in
// characters).
#derive(Eq)
pub struct TomlPos {
    line: int32,
    col: int32,
    end_line: int32,
    end_col: int32,
}

// A parsed document: its table, and where each key path was defined (see
// `key_pos` and `value_pos`).
pub struct TomlDoc {
    root: Toml,
    text: str,
    // byte offsets of the key and of the value, by `path_key`
    spans: [str: (int32, int32, int32, int32)],
}

// The value of `key` in the table `t`; None if `t` isn't a table or has no
// such key.
pub fun field(t: Toml, key: str) -> Option<Toml> {
    match t {
        Toml.Table(members) => {
            for m in members {
                if m.0 == key { return Some(m.1) }
            }
        },
        _ => {},
    }
    return None
}

// The table that `text` holds.
pub fun parse(text: str) -> Result<Toml, TomlError> {
    let d = parse_doc(text)?
    return Ok(d.root)
}

// The table that `text` holds, with the positions of its keys and values.
pub fun parse_doc(text: str) -> Result<TomlDoc, TomlError> {
    var p = Parser { s: text, i: 0, keys: [], kinds: [], values: [], explicit: [], dotted: [], first: [], last: [], next: [], index: [:], pending: [], table: 0, path: [], depth: 0, spans: [:] }
    let bad = utf8_error(text)
    if bad >= 0 { return Err(p.error("invalid UTF-8", bad)) }
    let root = p.node(-1, "", TABLE, Toml.Bool(false))
    p.table = root
    p.document()?
    return Ok(TomlDoc { root: p.build(root), text: text, spans: p.spans })
}

// Where the key of the key path `path` is: the key of a key/value pair (the
// last part of a dotted key, also inside an inline table), or the header
// that opened the table (the first header or dotted key on the way to it,
// if none opened it). Inside an array of tables, its last element's. None
// if nothing defined it.
pub fun key_pos(d: TomlDoc, path: [str]) -> Option<TomlPos> {
    return match d.spans.get(path_key(path)) {
        Some(sp) => Some(pos_of(d.text, sp.0, sp.1))
        None => None
    }
}

// Where the value of the key path `path` is (for a table opened by a header,
// the header).
pub fun value_pos(d: TomlDoc, path: [str]) -> Option<TomlPos> {
    return match d.spans.get(path_key(path)) {
        Some(sp) => Some(pos_of(d.text, sp.2, sp.3))
        None => None
    }
}

fun pos_of(text: str, start: int32, end: int32) -> TomlPos {
    let (line, col) = line_col(text, start)
    let (end_line, end_col) = line_col(text, end)
    return TomlPos { line: line, col: col, end_line: end_line, end_col: end_col }
}

// The line and column of byte offset `at` in `s`.
#test("ab\ncd", 4)[(2, 2)]
#test("é=1", 2)[(1, 2)]
#test("x", 9)[(1, 2)]
fun line_col(s: str, at: int32) -> (int32, int32) {
    var line = 1
    var col = 1
    var k = 0
    while k < at && k < s.len() {
        let c = s[k]
        if c == '\n' {
            line = line + 1
            col = 1
        } else if c < 128u8 || c >= 192u8 {
            col = col + 1                  // not a UTF-8 continuation byte
        }
        k = k + 1
    }
    return (line, col)
}

// The offset of the first byte of `s` that is no part of well-formed UTF-8
// (as `s.chars()` decodes it: no overlong forms, surrogates or code points
// past U+10FFFF), -1 if there is none.
#test("aé€😀")[-1]
#test("")[-1]
fun utf8_error(s: str) -> int32 {
    var i = 0
    while i < s.len() {
        let c = s[i]
        if c < 128u8 {
            i += 1
            continue
        }
        var n = 0
        var lo = 128u8
        var hi = 191u8
        if c >= 194u8 && c <= 223u8 {
            n = 1
        } else if c >= 224u8 && c <= 239u8 {
            n = 2
            if c == 224u8 { lo = 160u8 }
            if c == 237u8 { hi = 159u8 }
        } else if c >= 240u8 && c <= 244u8 {
            n = 3
            if c == 240u8 { lo = 144u8 }
            if c == 244u8 { hi = 143u8 }
        } else {
            return i
        }
        if i + n >= s.len() { return i }
        if s[i + 1] < lo || s[i + 1] > hi { return i }
        var k = 2
        while k <= n {
            if s[i + k] < 128u8 || s[i + k] > 191u8 { return i }
            k += 1
        }
        i += n + 1
    }
    return -1
}

#test
fun finds_bad_utf8() {
    for bytes in [[97u8, 255u8], [195u8], [237u8, 160u8, 128u8], [224u8, 128u8, 128u8], [244u8, 144u8, 128u8, 128u8], [97u8, 98u8, 128u8]] {
        var sb = StringBuilder()
        for b in bytes { sb.append_byte(b) }
        let s = sb.build()
        let at = utf8_error(s)
        assert(at >= 0 && at < s.len(), f"case {bytes.len()}")
    }
}

// --- Parsing ------------------------------------------------------------------
//
// The document is built as a tree of nodes, node 0 its table: a table, an
// array of tables (its elements tables, the last one the one headers and
// keys go to), or a value (anything else, an inline table and an array
// included, which nothing may add to). The rules on what may be added where
// are TOML's, as `tomllib` keeps them: a table a header defined, or that
// dotted keys of an earlier section defined, is `explicit`, and neither a
// header nor a dotted key may define it again.

const TABLE: int32 = 1
const TABLES: int32 = 2
const VALUE: int32 = 3

// How deeply tables and arrays may nest, the document's own table not
// counted: a header's or a dotted key's tables, an array of tables (its
// array and its element), arrays and inline tables. The parser recurses a
// few frames a level, and the interpreters run it on their own stack;
// std.yaml allows 100 as well, std.json 200.
const MAX_DEPTH: int32 = 100

struct Parser {
    s: str,
    i: int32,
    // the nodes: each one's key in its table, kind, value (a VALUE's), and
    // its first child, last child and next sibling (-1 for none)
    keys: [str],
    kinds: [int32],
    values: [Toml],
    explicit: [bool],
    // a table a dotted key defined (or went through), for the messages
    dotted: [bool],
    first: [int32],
    last: [int32],
    next: [int32],
    // a table's child by "<table>:<key>"
    index: [str: int32],
    // the tables the current section's dotted keys defined or went through:
    // explicit from the next header on
    pending: [int32],
    // the table key/value lines go to, its key path, and how many tables
    // and arrays it is in (itself included)
    table: int32,
    path: [str],
    depth: int32,
    // where each key path was defined: the byte offsets of the key's start
    // and end and of the value's (see `TomlDoc`)
    spans: [str: (int32, int32, int32, int32)],
}

// One string for a key path, unambiguous whatever the keys hold.
#test(["a", "b:c"])["1:a3:b:c"]
#test([])[""]
fun path_key(path: [str]) -> str {
    var sb = StringBuilder()
    for k in path {
        sb.append(f"{k.len()}:")
        sb.append(k)
    }
    return sb.build()
}

#test(["a"], "b")[["a", "b"]]
fun with_key(path: [str], key: str) -> [str] {
    var out = path
    out.push(key)
    return out
}

// A key path as TOML writes it, for messages: keys that aren't bare quoted,
// with '"', '\' and control characters escaped, so a message is one line.
#test(["server", "port"])["server.port"]
#test(["a b", "q\""])["\"a b\".\"q\\\"\""]
#test(["tab\t"])["\"tab\\u0009\""]
fun dotted(path: [str]) -> str {
    var sb = StringBuilder()
    for k in path {
        if sb.len() > 0 { sb.append_byte('.') }
        if is_bare_key(k) {
            sb.append(k)
        } else {
            sb.append_byte('"')
            var i = 0
            while i < k.len() {
                let c = k[i]
                if c == '"' || c == '\\' {
                    sb.append_byte('\\')
                    sb.append_byte(c)
                } else if is_control(c) || c == '\t' {
                    sb.append("\\u" + hex4(c as int32))
                } else {
                    sb.append_byte(c)
                }
                i = i + 1
            }
            sb.append_byte('"')
        }
    }
    return sb.build()
}

// `n` (below 65536) as four hex digits.
#test(9)["0009"]
#test(65535)["FFFF"]
fun hex4(n: int32) -> str {
    let digits = "0123456789ABCDEF"
    var sb = StringBuilder()
    var shift = 12
    while shift >= 0 {
        sb.append_byte(digits[(n >> shift) & 15])
        shift = shift - 4
    }
    return sb.build()
}

fun is_bare_char(c: uint8) -> bool {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-'
}

#test("a_b-1")[true]
#test("a.b")[false]
#test("")[false]
fun is_bare_key(k: str) -> bool {
    if k.len() == 0 { return false }
    var i = 0
    while i < k.len() {
        if !is_bare_char(k[i]) { return false }
        i = i + 1
    }
    return true
}

fun is_digit(c: uint8) -> bool {
    return c >= '0' && c <= '9'
}

// The value of the digit `c` in `base` (2, 8 or 16), -1 if it isn't one.
#test('f', 16i64)[15i64]
#test('8', 8i64)[-1i64]
#test('_', 2i64)[-1i64]
fun digit_value(c: uint8, base: int64) -> int64 {
    var d: int64 = -1
    if c >= '0' && c <= '9' { d = (c - '0') as int64 }
    if c >= 'a' && c <= 'f' { d = (c - 'a') as int64 + 10 }
    if c >= 'A' && c <= 'F' { d = (c - 'A') as int64 + 10 }
    if d >= base { return -1 }
    return d
}

// A control character TOML allows nowhere but in multi-line strings (tab is
// allowed everywhere).
fun is_control(c: uint8) -> bool {
    return (c < 32u8 && c != '\t') || c == 127u8
}

// The days of the month `month` of `year`.
#test(2024, 2)[29]
#test(1900, 2)[28]
#test(2000, 2)[29]
#test(2023, 4)[30]
fun days_in(year: int32, month: int32) -> int32 {
    if month == 2 {
        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) { return 29 }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

impl Parser {
    // An error at byte offset `at`.
    fun error(self, msg: str, at: int32) -> TomlError {
        let (line, col) = line_col(self.s, at)
        return TomlError { kind: TomlErrorKind.Syntax, msg: msg, line: line, col: col, path: "" }
    }

    // The error of a container `depth` deep at `at`, if that is too deep.
    fun nesting(self, depth: int32, at: int32) -> Result<int32, TomlError> {
        if depth > MAX_DEPTH { return Err(self.error(f"tables and arrays nested too deeply (more than {MAX_DEPTH} levels)", at)) }
        return Ok(depth)
    }

    fun at_end(self) -> bool {
        return self.i >= self.s.len()
    }

    // The byte at the current position, or 0 at the end.
    fun peek(self) -> uint8 {
        if self.at_end() { return 0u8 }
        return self.s[self.i]
    }

    // The byte `k` places ahead, or 0 past the end.
    fun ahead(self, k: int32) -> uint8 {
        if self.i + k >= self.s.len() { return 0u8 }
        return self.s[self.i + k]
    }

    // A new node in the table or array of tables `parent` (none: -1), last
    // of its children.
    fun node(var self, parent: int32, key: str, kind: int32, v: Toml) -> int32 {
        let k = self.keys.len()
        self.keys.push(key)
        self.kinds.push(kind)
        self.values.push(v)
        self.explicit.push(false)
        self.dotted.push(false)
        self.first.push(-1)
        self.last.push(-1)
        self.next.push(-1)
        if parent >= 0 {
            if self.last[parent] < 0 {
                self.first[parent] = k
            } else {
                self.next[self.last[parent]] = k
            }
            self.last[parent] = k
            if self.kinds[parent] == TABLE { self.index[f"{parent}:{key}"] = k }
        }
        return k
    }

    // The child `key` of the table `parent`, -1 if it has none.
    fun child(self, parent: int32, key: str) -> int32 {
        return match self.index.get(f"{parent}:{key}") {
            Some(k) => k
            None => -1
        }
    }

    // The value of the node `k`.
    fun build(self, k: int32) -> Toml {
        let kind = self.kinds[k]
        if kind == VALUE { return self.values[k] }
        var c = self.first[k]
        if kind == TABLES {
            var items: [Toml] = []
            while c >= 0 {
                items.push(self.build(c))
                c = self.next[c]
            }
            return Toml.Array(items)
        }
        var members: [(str, Toml)] = []
        while c >= 0 {
            members.push((self.keys[c], self.build(c)))
            c = self.next[c]
        }
        return Toml.Table(members)
    }

    fun skip_ws(var self) {
        while self.peek() == ' ' || self.peek() == '\t' { self.i = self.i + 1 }
    }

    // A comment, the current position at its "#"; up to the line's end.
    fun comment(var self) -> Result<int32, TomlError> {
        while !self.at_end() && self.peek() != '\n' {
            if self.peek() == 13u8 && self.ahead(1) == '\n' { return Ok(0) }
            if is_control(self.peek()) { return Err(self.error("control character in a comment", self.i)) }
            self.i = self.i + 1
        }
        return Ok(0)
    }

    // A line break ("\n" or "\r\n") at the current position, if any.
    fun newline(var self) -> Result<bool, TomlError> {
        if self.peek() == '\n' {
            self.i = self.i + 1
            return Ok(true)
        }
        if self.peek() == 13u8 {
            if self.ahead(1) != '\n' { return Err(self.error("a carriage return must be followed by a line feed", self.i)) }
            self.i = self.i + 2
            return Ok(true)
        }
        return Ok(false)
    }

    // White space, comments and line breaks (inside an array).
    fun skip_blank(var self) -> Result<int32, TomlError> {
        while true {
            self.skip_ws()
            if self.peek() == '#' { self.comment()? }
            if !self.newline()? { return Ok(0) }
        }
        return Ok(0)
    }

    // The rest of a line after a statement: white space and a comment.
    fun end_of_line(var self) -> Result<int32, TomlError> {
        self.skip_ws()
        if self.peek() == '#' { self.comment()? }
        if self.at_end() || self.newline()? { return Ok(0) }
        return Err(self.error("expected the end of the line", self.i))
    }

    fun document(var self) -> Result<int32, TomlError> {
        while true {
            self.skip_ws()
            if self.at_end() { return Ok(0) }
            let c = self.peek()
            if c == '#' {
                self.comment()?
                self.end_of_line()?
            } else if c == '\n' || c == 13u8 {
                self.newline()?
            } else if c == '[' {
                self.header()?
                self.end_of_line()?
            } else {
                self.assign(self.table, self.path, self.depth, true, true)?
                self.end_of_line()?
            }
        }
        return Ok(0)
    }

    // A key, dotted or not, and the white space after it: its parts, each
    // with the offsets of its start and end.
    fun dotted_key(var self) -> Result<[(str, int32, int32)], TomlError> {
        var parts: [(str, int32, int32)] = []
        while true {
            let start = self.i
            let k = self.key()?
            parts.push((k, start, self.i))
            self.skip_ws()
            if self.peek() != '.' { return Ok(parts) }
            self.i = self.i + 1
            self.skip_ws()
        }
        return Ok(parts)
    }

    // A table header, `[a.b]`, or an array of tables' `[[a.b]]`, the current
    // position at its "[": the table key/value lines go to from here.
    fun header(var self) -> Result<int32, TomlError> {
        let start = self.i
        let tables = self.ahead(1) == '['
        self.i = self.i + 1
        if tables { self.i = self.i + 1 }
        self.skip_ws()
        let parts = self.dotted_key()?
        if self.peek() != ']' { return Err(self.error("expected '.' or ']' in a table header", self.i)) }
        self.i = self.i + 1
        if tables {
            if self.peek() != ']' { return Err(self.error("expected ']]' to end the header of an array of tables", self.i)) }
            self.i = self.i + 1
        }
        let end = self.i
        for p in self.pending { self.explicit[p] = true }
        self.pending = []
        var node = 0
        var path: [str] = []
        var depth = 0
        var j = 0
        while j < parts.len() {
            let key = parts[j].0
            path.push(key)
            let pk = path_key(path)
            let last = j == parts.len() - 1
            var c = self.child(node, key)
            // a table, or an array of tables and its (last) element
            depth = depth + 1
            if (last && tables) || (c >= 0 && self.kinds[c] == TABLES) { depth = depth + 1 }
            self.nesting(depth, start)?
            if c < 0 {
                var kind = TABLE
                if last && tables { kind = TABLES }
                c = self.node(node, key, kind, Toml.Bool(false))
                self.spans[pk] = (start, end, start, end)
            } else if self.kinds[c] == VALUE {
                return Err(self.error(f"'{dotted(path)}' is not a table that can be extended", start))
            } else if self.kinds[c] == TABLES {
                if last && !tables { return Err(self.error(f"'{dotted(path)}' is an array of tables, not a table", start)) }
                if !last { c = self.last[c] }
            } else if last {
                if tables { return Err(self.error(f"'{dotted(path)}' is a table, not an array of tables", start)) }
                if self.explicit[c] {
                    if self.dotted[c] { return Err(self.error(f"table '{dotted(path)}' is defined by dotted keys already", start)) }
                    return Err(self.error(f"table '{dotted(path)}' is defined twice", start))
                }
                self.spans[pk] = (start, end, start, end)
            }
            if last {
                if tables {
                    self.spans[pk] = (start, end, start, end)
                    c = self.node(c, "", TABLE, Toml.Bool(false))
                }
                self.explicit[c] = true
            }
            node = c
            j = j + 1
        }
        self.table = node
        self.path = path
        self.depth = depth
        return Ok(0)
    }

    // `key = value` in the table `node`, whose key path is `base` and which
    // is `depth` deep: a key/value line of a section (`section`: the tables
    // its dotted keys define are explicit from the next header on) or a pair
    // of an inline table; `record` keeps the spans (not inside an array).
    fun assign(var self, node: int32, base: [str], depth: int32, section: bool, record: bool) -> Result<int32, TomlError> {
        let at = self.i
        let parts = self.dotted_key()?
        if self.peek() != '=' { return Err(self.error("expected '=' after a key", self.i)) }
        self.i = self.i + 1
        self.skip_ws()
        self.nesting(depth + parts.len() - 1, at)?
        var table = node
        var path = base
        var j = 0
        while j < parts.len() - 1 {
            let key = parts[j].0
            path.push(key)
            var c = self.child(table, key)
            if c < 0 {
                c = self.node(table, key, TABLE, Toml.Bool(false))
                if record { self.spans[path_key(path)] = (parts[0].1, parts[j].2, parts[0].1, parts[j].2) }
            } else if self.kinds[c] != TABLE {
                return Err(self.error(f"'{dotted(path)}' is not a table that can be extended", at))
            } else if self.explicit[c] {
                return Err(self.error(f"table '{dotted(path)}' is defined elsewhere and can't be extended with dotted keys", at))
            }
            self.dotted[c] = true
            if section { self.pending.push(c) }
            table = c
            j = j + 1
        }
        let last = parts[parts.len() - 1]
        path.push(last.0)
        if self.child(table, last.0) >= 0 { return Err(self.error(f"'{dotted(path)}' is defined twice", at)) }
        let value_start = self.i
        let v = self.value(path, depth + parts.len(), record)?
        let k = self.node(table, last.0, VALUE, v)
        if record { self.spans[path_key(path)] = (last.1, last.2, value_start, self.i) }
        return Ok(k)
    }

    fun key(var self) -> Result<str, TomlError> {
        let c = self.peek()
        if c == '"' || c == '\'' {
            if self.ahead(1) == c && self.ahead(2) == c { return Err(self.error("a key can't be a multi-line string", self.i)) }
            if c == '"' { return self.basic_string() }
            return self.literal_string()
        }
        let start = self.i
        while is_bare_char(self.peek()) { self.i = self.i + 1 }
        if self.i == start { return Err(self.error("expected a key", self.i)) }
        var sb = StringBuilder()
        sb.append(self.s, start, self.i)
        return Ok(sb.build())
    }

    // A value, of the key path `path` (for the spans of an inline table's
    // keys, kept when `record`), `depth` deep if it is an array or a table.
    fun value(var self, path: [str], depth: int32, record: bool) -> Result<Toml, TomlError> {
        let c = self.peek()
        if c == '"' {
            if self.ahead(1) == '"' && self.ahead(2) == '"' { return Ok(Toml.Str(self.multi_line_basic()?)) }
            return Ok(Toml.Str(self.basic_string()?))
        }
        if c == '\'' {
            if self.ahead(1) == '\'' && self.ahead(2) == '\'' { return Ok(Toml.Str(self.multi_line_literal()?)) }
            return Ok(Toml.Str(self.literal_string()?))
        }
        if c == '[' || c == '{' { self.nesting(depth, self.i)? }
        if c == '[' { return self.array(path, depth) }
        if c == '{' { return self.inline_table(path, depth, record) }
        if self.word("true") {
            self.i = self.i + 4
            return Ok(Toml.Bool(true))
        }
        if self.word("false") {
            self.i = self.i + 5
            return Ok(Toml.Bool(false))
        }
        for w in ["inf", "+inf", "-inf", "nan", "+nan", "-nan"] {
            if self.word(w) {
                self.i = self.i + w.len()
                if w[w.len() - 1] == 'n' { return Ok(Toml.Float(0.0 / 0.0)) }
                if w[0] == '-' { return Ok(Toml.Float(-1.0 / 0.0)) }
                return Ok(Toml.Float(1.0 / 0.0))
            }
        }
        if is_digit(c) && is_digit(self.ahead(1)) {
            if is_digit(self.ahead(2)) && is_digit(self.ahead(3)) && self.ahead(4) == '-' { return self.date_time() }
            if self.ahead(2) == ':' { return Ok(Toml.Time(self.time()?)) }
        }
        if c == '+' || c == '-' || is_digit(c) { return self.number() }
        return Err(self.error("expected a value", self.i))
    }

    // Whether the text continues with `w`, not followed by a key character.
    fun word(self, w: str) -> bool {
        if self.i + w.len() > self.s.len() { return false }
        var k = 0
        while k < w.len() {
            if self.s[self.i + k] != w[k] { return false }
            k = k + 1
        }
        return !is_bare_char(self.ahead(w.len()))
    }

    // The digits at the current position, a '_' allowed between two of them,
    // without the '_'s ("" if there is no digit).
    fun digit_run(var self) -> Result<str, TomlError> {
        var sb = StringBuilder()
        while is_digit(self.peek()) || self.peek() == '_' {
            if self.peek() == '_' {
                if sb.len() == 0 || !is_digit(self.s[self.i - 1]) || !is_digit(self.ahead(1)) { return Err(self.error("'_' must stand between digits", self.i)) }
            } else {
                sb.append_byte(self.peek())
            }
            self.i = self.i + 1
        }
        return Ok(sb.build())
    }

    // A decimal integer or a float (not `inf` or `nan`), or an integer in
    // hexadecimal, octal or binary.
    fun number(var self) -> Result<Toml, TomlError> {
        let start = self.i
        var negative = false
        var signed = false
        if self.peek() == '+' || self.peek() == '-' {
            negative = self.peek() == '-'
            signed = true
            self.i = self.i + 1
        }
        if self.peek() == '0' && (self.ahead(1) == 'x' || self.ahead(1) == 'o' || self.ahead(1) == 'b') {
            if signed { return Err(self.error("a hexadecimal, octal or binary integer has no sign", start)) }
            return self.based_integer()
        }
        let first = self.i
        let int_part = self.digit_run()?
        if int_part.len() == 0 { return Err(self.error("expected a value", start)) }
        if int_part.len() > 1 && int_part[0] == '0' { return Err(self.error("leading zeros are not allowed", first)) }
        var text = StringBuilder()
        if negative { text.append_byte('-') }
        text.append(int_part)
        var is_float = false
        if self.peek() == '.' {
            self.i = self.i + 1
            let frac = self.digit_run()?
            if frac.len() == 0 { return Err(self.error("expected a digit after the '.' of a float", self.i)) }
            text.append_byte('.')
            text.append(frac)
            is_float = true
        }
        if self.peek() == 'e' || self.peek() == 'E' {
            self.i = self.i + 1
            text.append_byte('e')
            if self.peek() == '+' || self.peek() == '-' {
                text.append_byte(self.peek())
                self.i = self.i + 1
            }
            let exp = self.digit_run()?
            if exp.len() == 0 { return Err(self.error("expected a digit in the exponent of a float", self.i)) }
            text.append(exp)
            is_float = true
        }
        if is_float {
            return match parse_float(text.build()) {
                Some(f) => Ok(Toml.Float(f))
                None => Err(self.error("not a float", start))
            }
        }
        // accumulate negatively, so the int64 minimum fits
        var n: int64 = 0
        var k = 0
        while k < int_part.len() {
            let d = (int_part[k] - '0') as int64
            if n < (-9223372036854775807i64 - 1i64 + d) / 10i64 { return Err(self.error("integer out of range", start)) }
            n = n * 10i64 - d
            k = k + 1
        }
        if negative { return Ok(Toml.Int(n)) }
        if n == -9223372036854775807i64 - 1i64 { return Err(self.error("integer out of range", start)) }
        return Ok(Toml.Int(-n))
    }

    // An integer in hexadecimal (`0x`), octal (`0o`) or binary (`0b`), the
    // current position at its "0".
    fun based_integer(var self) -> Result<Toml, TomlError> {
        let start = self.i
        let b = self.ahead(1)
        var base: int64 = 2
        var name = "a binary"
        if b == 'x' {
            base = 16
            name = "a hexadecimal"
        }
        if b == 'o' {
            base = 8
            name = "an octal"
        }
        self.i = self.i + 2
        var n: int64 = 0
        var count = 0
        while true {
            let c = self.peek()
            if c == '_' {
                if count == 0 || digit_value(self.s[self.i - 1], base) < 0 || digit_value(self.ahead(1), base) < 0 { return Err(self.error("'_' must stand between digits", self.i)) }
                self.i = self.i + 1
                continue
            }
            let d = digit_value(c, base)
            if d < 0 { break }
            if n > (9223372036854775807i64 - d) / base { return Err(self.error("integer out of range", start)) }
            n = n * base + d
            count = count + 1
            self.i = self.i + 1
        }
        if is_bare_char(self.peek()) { return Err(self.error(f"'{self.s[self.i:self.i + 1]}' is not a digit of {name} integer", self.i)) }
        if count == 0 { return Err(self.error(f"expected a digit of {name} integer", self.i)) }
        return Ok(Toml.Int(n))
    }

    // The number the `n` digits at the current position make, moving past
    // them; -1 if they aren't `n` digits.
    fun fixed(var self, n: int32) -> int32 {
        var v = 0
        var k = 0
        while k < n {
            let c = self.ahead(k)
            if !is_digit(c) { return -1 }
            v = v * 10 + (c - '0') as int32
            k = k + 1
        }
        self.i = self.i + n
        return v
    }

    // A date, `YYYY-MM-DD`.
    fun date(var self) -> Result<TomlDate, TomlError> {
        let at = self.i
        let y = self.fixed(4)
        if y < 0 || self.peek() != '-' { return Err(self.error("expected a date, YYYY-MM-DD", at)) }
        self.i = self.i + 1
        let m = self.fixed(2)
        if m < 0 || self.peek() != '-' { return Err(self.error("expected a date, YYYY-MM-DD", at)) }
        self.i = self.i + 1
        let d = self.fixed(2)
        if d < 0 || is_digit(self.peek()) { return Err(self.error("expected a date, YYYY-MM-DD", at)) }
        if y < 1 { return Err(self.error("the year must be 0001 to 9999", at)) }
        if m < 1 || m > 12 { return Err(self.error("the month must be 01 to 12", at + 5)) }
        let most = days_in(y, m)
        if d < 1 || d > most { return Err(self.error(f"the day must be 01 to {most} in {y:04}-{m:02}", at + 8)) }
        return Ok(TomlDate { year: y, month: m, day: d })
    }

    // A time, `HH:MM:SS` with a fraction of a second or none.
    fun time(var self) -> Result<TomlTime, TomlError> {
        let at = self.i
        let h = self.fixed(2)
        if h < 0 || self.peek() != ':' { return Err(self.error("expected a time, HH:MM:SS", at)) }
        self.i = self.i + 1
        let mi = self.fixed(2)
        if mi < 0 || self.peek() != ':' { return Err(self.error("expected a time with seconds, HH:MM:SS", at)) }
        self.i = self.i + 1
        let sec = self.fixed(2)
        if sec < 0 || is_digit(self.peek()) { return Err(self.error("expected a time, HH:MM:SS", at)) }
        var nano = 0
        if self.peek() == '.' {
            self.i = self.i + 1
            if !is_digit(self.peek()) { return Err(self.error("expected a digit after the '.' of a time", self.i)) }
            var scale = 100000000
            while is_digit(self.peek()) {
                nano = nano + (self.peek() - '0') as int32 * scale
                scale = scale / 10
                self.i = self.i + 1
            }
        }
        if h > 23 { return Err(self.error("the hour must be 00 to 23", at)) }
        if mi > 59 { return Err(self.error("the minute must be 00 to 59", at + 3)) }
        if sec > 59 { return Err(self.error("the second must be 00 to 59", at + 6)) }
        return Ok(TomlTime { hour: h, minute: mi, second: sec, nanosecond: nano })
    }

    // A date, or a date-time (local, or with its offset), the current
    // position at the date.
    fun date_time(var self) -> Result<Toml, TomlError> {
        let d = self.date()?
        let c = self.peek()
        let spaced = c == ' ' && is_digit(self.ahead(1)) && is_digit(self.ahead(2)) && self.ahead(3) == ':'
        if c != 'T' && c != 't' && !spaced { return Ok(Toml.Date(d)) }
        self.i = self.i + 1
        let t = self.time()?
        let o = self.peek()
        if o == 'Z' || o == 'z' {
            self.i = self.i + 1
            return Ok(Toml.DateTime(TomlDateTime { date: d, time: t, offset: Some(0) }))
        }
        if o != '+' && o != '-' { return Ok(Toml.DateTime(TomlDateTime { date: d, time: t, offset: None })) }
        let at = self.i
        self.i = self.i + 1
        let oh = self.fixed(2)
        if oh < 0 || self.peek() != ':' { return Err(self.error("expected an offset, +HH:MM or -HH:MM", at)) }
        self.i = self.i + 1
        let om = self.fixed(2)
        if om < 0 || is_digit(self.peek()) { return Err(self.error("expected an offset, +HH:MM or -HH:MM", at)) }
        if oh > 23 || om > 59 { return Err(self.error("the offset must be at most 23:59", at)) }
        var off = oh * 60 + om
        if o == '-' { off = -off }
        return Ok(Toml.DateTime(TomlDateTime { date: d, time: t, offset: Some(off) }))
    }

    // The value of the `count` hex digits at the current position, or -1.
    fun hex(self, count: int32) -> int64 {
        if self.i + count > self.s.len() { return -1i64 }
        var v: int64 = 0
        var k = 0
        while k < count {
            let d = digit_value(self.s[self.i + k], 16)
            if d < 0i64 { return -1i64 }
            v = v * 16i64 + d
            k = k + 1
        }
        return v
    }

    // The escape at the current position, a '\', moving past it: what it
    // stands for.
    fun escape(var self) -> Result<str, TomlError> {
        let esc = self.i
        let e = self.ahead(1)
        self.i = self.i + 2
        if e == 'u' || e == 'U' {
            var count = 4
            if e == 'U' { count = 8 }
            let cp = self.hex(count)
            if cp < 0i64 || (cp >= 55296i64 && cp < 57344i64) || cp > 1114111i64 {
                return Err(self.error("invalid unicode escape", esc))
            }
            self.i = self.i + count
            return Ok(f"{cp as uint32 as char}")
        }
        if e == '"' { return Ok("\"") }
        if e == '\\' { return Ok("\\") }
        if e == 'b' { return Ok("\u{8}") }
        if e == 'f' { return Ok("\u{c}") }
        if e == 'n' { return Ok("\n") }
        if e == 'r' { return Ok("\r") }
        if e == 't' { return Ok("\t") }
        return Err(self.error("invalid escape in a string", esc))
    }

    // A basic string, the current position at its opening quote.
    fun basic_string(var self) -> Result<str, TomlError> {
        let quote = self.i
        self.i = self.i + 1
        var sb = StringBuilder()
        var run = self.i                         // start of bytes to copy as they are
        while true {
            if self.at_end() || self.peek() == '\n' { return Err(self.error("unterminated string", quote)) }
            let c = self.peek()
            if c == '"' {
                sb.append(self.s, run, self.i)
                self.i = self.i + 1
                return Ok(sb.build())
            }
            if is_control(c) { return Err(self.error("control character in a string", self.i)) }
            if c != '\\' {
                self.i = self.i + 1
            } else {
                sb.append(self.s, run, self.i)
                sb.append(self.escape()?)
                run = self.i
            }
        }
        return Ok("")
    }

    // A literal string, the current position at its opening quote.
    fun literal_string(var self) -> Result<str, TomlError> {
        let quote = self.i
        self.i = self.i + 1
        let start = self.i
        while true {
            if self.at_end() || self.peek() == '\n' { return Err(self.error("unterminated string", quote)) }
            let c = self.peek()
            if c == '\'' {
                var sb = StringBuilder()
                sb.append(self.s, start, self.i)
                self.i = self.i + 1
                return Ok(sb.build())
            }
            if is_control(c) { return Err(self.error("control character in a string", self.i)) }
            self.i = self.i + 1
        }
        return Ok("")
    }

    // The line break right after the opening quotes of a multi-line string,
    // which isn't part of it.
    fun skip_first_newline(var self) {
        if self.peek() == '\n' {
            self.i = self.i + 1
        } else if self.peek() == 13u8 && self.ahead(1) == '\n' {
            self.i = self.i + 2
        }
    }

    // The number of `q`s from the current position on (at least 3, the
    // closing ones) if they close a multi-line string, -1 if there are more
    // than 5 (two may be part of the string).
    fun closing(self, q: uint8) -> int32 {
        var run = 3
        while self.ahead(run) == q { run = run + 1 }
        if run > 5 { return -1 }
        return run
    }

    // A multi-line basic string, the current position at its opening
    // quotes; a line break is "\n", and a '\' at the end of a line leaves out
    // the white space and line breaks after it.
    fun multi_line_basic(var self) -> Result<str, TomlError> {
        let quote = self.i
        self.i = self.i + 3
        self.skip_first_newline()
        var sb = StringBuilder()
        var run = self.i                         // start of bytes to copy as they are
        while true {
            if self.at_end() { return Err(self.error("unterminated string", quote)) }
            let c = self.peek()
            if c == '"' && self.ahead(1) == '"' && self.ahead(2) == '"' {
                let n = self.closing('"')
                if n < 0 { return Err(self.error("too many quotes at the end of a string", self.i)) }
                sb.append(self.s, run, self.i + n - 3)
                self.i = self.i + n
                return Ok(sb.build())
            }
            if c == '\\' {
                sb.append(self.s, run, self.i)
                var k = 1
                while self.ahead(k) == ' ' || self.ahead(k) == '\t' { k = k + 1 }
                if self.ahead(k) == '\n' || (self.ahead(k) == 13u8 && self.ahead(k + 1) == '\n') {
                    self.i = self.i + k
                    while self.peek() == ' ' || self.peek() == '\t' || self.peek() == '\n' || (self.peek() == 13u8 && self.ahead(1) == '\n') {
                        self.i = self.i + 1
                    }
                } else {
                    sb.append(self.escape()?)
                }
                run = self.i
            } else if c == 13u8 && self.ahead(1) == '\n' {
                sb.append(self.s, run, self.i)
                self.i = self.i + 1
                run = self.i
            } else if c != '\n' && is_control(c) {
                return Err(self.error("control character in a string", self.i))
            } else {
                self.i = self.i + 1
            }
        }
        return Ok("")
    }

    // A multi-line literal string, the current position at its opening
    // quotes.
    fun multi_line_literal(var self) -> Result<str, TomlError> {
        let quote = self.i
        self.i = self.i + 3
        self.skip_first_newline()
        var sb = StringBuilder()
        var run = self.i
        while true {
            if self.at_end() { return Err(self.error("unterminated string", quote)) }
            let c = self.peek()
            if c == '\'' && self.ahead(1) == '\'' && self.ahead(2) == '\'' {
                let n = self.closing('\'')
                if n < 0 { return Err(self.error("too many quotes at the end of a string", self.i)) }
                sb.append(self.s, run, self.i + n - 3)
                self.i = self.i + n
                return Ok(sb.build())
            }
            if c == 13u8 && self.ahead(1) == '\n' {
                sb.append(self.s, run, self.i)
                self.i = self.i + 1
                run = self.i
            } else if c != '\n' && is_control(c) {
                return Err(self.error("control character in a string", self.i))
            } else {
                self.i = self.i + 1
            }
        }
        return Ok("")
    }

    // An array, of any values, `depth` deep, the current position at its "[".
    fun array(var self, path: [str], depth: int32) -> Result<Toml, TomlError> {
        self.i = self.i + 1
        var items: [Toml] = []
        while true {
            self.skip_blank()?
            if self.peek() == ']' {
                self.i = self.i + 1
                return Ok(Toml.Array(items))
            }
            if self.peek() == ',' || self.at_end() { return Err(self.error("expected a value", self.i)) }
            items.push(self.value(path, depth + 1, false)?)
            self.skip_blank()?
            if self.peek() == ',' {
                self.i = self.i + 1
            } else if self.peek() != ']' {
                return Err(self.error("expected ',' or ']' in an array", self.i))
            }
        }
        return Ok(Toml.Array(items))
    }

    // An inline table, the value of `path`, `depth` deep, the current
    // position at its "{"; its keys' spans kept when `record`.
    fun inline_table(var self, path: [str], depth: int32, record: bool) -> Result<Toml, TomlError> {
        self.i = self.i + 1
        let table = self.node(-1, "", TABLE, Toml.Bool(false))
        self.skip_ws()
        if self.peek() == '}' {
            self.i = self.i + 1
            return Ok(Toml.Table([]))
        }
        while true {
            self.skip_ws()
            if self.peek() == '}' { return Err(self.error("a trailing comma is not allowed in an inline table", self.i)) }
            self.assign(table, path, depth, false, record)?
            self.skip_ws()
            if self.peek() == '}' {
                self.i = self.i + 1
                return Ok(self.build(table))
            }
            if self.peek() != ',' { return Err(self.error("expected ',' or '}' in an inline table", self.i)) }
            self.i = self.i + 1
        }
        return Ok(Toml.Table([]))
    }
}

// --- Tests of the parser -------------------------------------------------------

// The value `text` holds as `inline_string` writes it, or the error with
// its position.
fun read(text: str) -> str {
    return match parse(text) {
        Ok(v) => inline_string(v)
        Err(e) => f"{e}"
    }
}

#test("a = 1.5\nb = -2e3\nc = 1_000.0_1\nd = 6.626E-34\ne = +0.0\nf = -0.0\ng = 0e0")["{ a = 1.5, b = -2000.0, c = 1000.01, d = 6.626e-34, e = 0.0, f = -0.0, g = 0.0 }"] // floats
#test("a = inf\nb = -inf\nc = +nan\nd = nan")["{ a = inf, b = -inf, c = nan, d = nan }"]
#test("a = 0xDEAD_beef\nb = 0o755\nc = 0b1101\nd = 0x7FFFFFFFFFFFFFFF\ne = 0x0")["{ a = 3735928559, b = 493, c = 13, d = 9223372036854775807, e = 0 }"] // other bases
#test("a = 0x8000000000000000")["1:5: integer out of range"]
#test("a = 9223372036854775808")["1:5: integer out of range"]
#test("a = -0x1")["1:5: a hexadecimal, octal or binary integer has no sign"]
#test("a = 0o8")["1:7: '8' is not a digit of an octal integer"]
#test("a = 0x")["1:7: expected a digit of a hexadecimal integer"]
#test("a = 0x_1")["1:7: '_' must stand between digits"]
#test("a = 01.5")["1:5: leading zeros are not allowed"]
#test("a = 1.")["1:7: expected a digit after the '.' of a float"]
#test("a = 1e")["1:7: expected a digit in the exponent of a float"]
#test("a = 1_.5")["1:6: '_' must stand between digits"]
#test("a = .5")["1:5: expected a value"]
#test("a = infinity")["1:5: expected a value"]
fun reads_numbers(text: str) -> str {
    return read(text)
}

#test("a = 1979-05-27T07:32:00Z\nb = 1979-05-27 00:32:00.999999-07:00\nc = 1979-05-27t07:32:00\nd = 1979-05-27\ne = 07:32:00.5\nf = 00:00:00.1234567891")["{ a = 1979-05-27T07:32:00Z, b = 1979-05-27T00:32:00.999999-07:00, c = 1979-05-27T07:32:00, d = 1979-05-27, e = 07:32:00.5, f = 00:00:00.123456789 }"] // dates and times
#test("a = 2024-02-29 # leap\nb = 1987-07-05 17:45:00+05:30")["{ a = 2024-02-29, b = 1987-07-05T17:45:00+05:30 }"]
#test("a = 2023-02-29")["1:13: the day must be 01 to 28 in 2023-02"]
#test("a = 2023-13-01")["1:10: the month must be 01 to 12"]
#test("a = 0000-01-01")["1:5: the year must be 0001 to 9999"]
#test("a = 1979-05-27T24:00:00")["1:16: the hour must be 00 to 23"]
#test("a = 1979-05-27T07:60:00")["1:19: the minute must be 00 to 59"]
#test("a = 07:32:60")["1:11: the second must be 00 to 59"]
#test("a = 07:32")["1:5: expected a time with seconds, HH:MM:SS"]
#test("a = 1979-05-27T07:32:00+24:00")["1:24: the offset must be at most 23:59"]
#test("a = 1979-05-27T07:32:00+1:00")["1:24: expected an offset, +HH:MM or -HH:MM"]
#test("a = 1979-5-27")["1:5: expected a date, YYYY-MM-DD"]
#test("a = 1979-05-27T")["1:16: expected a time, HH:MM:SS"]
#test("a = 1979-05-27 x")["1:16: expected the end of the line"]
#test("a = 07:32:00.")["1:14: expected a digit after the '.' of a time"]
fun reads_dates_and_times(text: str) -> str {
    return read(text)
}

#test("a = \"\"\"\nline 1\n  line 2\\\n     joined \\\"\"\" \"\"\"\"")["{ a = \"line 1\\n  line 2joined \\\"\\\"\\\" \\\"\" }"] // multi-line basic
#test("a = '''\r\nC:\\x\r\n''''\nb = '''''two'''''")["{ a = \"C:\\\\x\\n'\", b = \"''two''\" }"] // multi-line literal
#test("a = \"\"\"a\\  \n\n  b\\tc\"\"\"")["{ a = \"ab\\tc\" }"]
#test("a = \"\"\"x\"\"\"\"\"\"")["1:9: too many quotes at the end of a string"]
#test("a = \"\"\"x\\ y\"\"\"")["1:9: invalid escape in a string"]
#test("a = '''x\u{1}'''")["1:9: control character in a string"]
#test("a = \"\"\"x")["1:5: unterminated string"]
#test("a = \"\\e\"")["1:6: invalid escape in a string"]
#test("a = \"\\uD800\"")["1:6: invalid unicode escape"]
#test("\"\"\"k\"\"\" = 1")["1:1: a key can't be a multi-line string"]
fun reads_strings(text: str) -> str {
    return read(text)
}

#test("a.b.c = 1\na.b.d = 2\na . 'e' = 3\n")["{ a = { b = { c = 1, d = 2 }, e = 3 } }"] // dotted keys
#test("[x]\ny.z = 1\n[x.y.w]\nv = 2\n")["{ x = { y = { z = 1, w = { v = 2 } } } }"] // a sub-table of a dotted one
#test("a = { b.c = 1, b.d = [1, 'x', { e = 2 }] }")["{ a = { b = { c = 1, d = [1, \"x\", { e = 2 }] } } }"]
#test("[[a]]\nx = 1\n[a.b]\ny = 2\n[[a]]\n[[a.c]]\nz = 3\n[[a.c]]\n")["{ a = [{ x = 1, b = { y = 2 } }, { c = [{ z = 3 }, {}] }] }"] // arrays of tables
#test("a = [\n  1, # one\n  [2.5, \"s\"],\n  2024-01-01,\n]")["{ a = [1, [2.5, \"s\"], 2024-01-01] }"]
#test("a.b = 1\n[a]\n")["2:1: table 'a' is defined by dotted keys already"]
#test("[a.b.c]\n[a]\nb.c.d = 1\n")["3:1: table 'a.b.c' is defined elsewhere and can't be extended with dotted keys"]
#test("[a]\nb = 1\n[a]\n")["3:1: table 'a' is defined twice"]
#test("a = { b = 1 }\na.c = 2\n")["2:1: 'a' is not a table that can be extended"]
#test("a = { b.c = 1, b = 2 }")["1:16: 'a.b' is defined twice"]
#test("a = { b = {}, b.c = 2 }")["1:15: 'a.b' is not a table that can be extended"]
#test("a = []\n[[a]]\n")["2:1: 'a' is not a table that can be extended"]
#test("[a]\n[[a]]\n")["2:1: 'a' is a table, not an array of tables"]
#test("[[a]]\n[a]\n")["2:1: 'a' is an array of tables, not a table"]
#test("[[a]\n")["1:5: expected ']]' to end the header of an array of tables"]
#test("a = { b = 1, }")["1:14: a trailing comma is not allowed in an inline table"]
#test("a = { b = 1\n}")["1:12: expected ',' or '}' in an inline table"]
#test("a = [1,,2]")["1:8: expected a value"]
#test("a = 1\r")["1:6: a carriage return must be followed by a line feed"]
fun reads_tables(text: str) -> str {
    return read(text)
}

// Tables and arrays nest at most MAX_DEPTH deep, however they are written:
// deeper is an error at the container that goes past it, not a crash or
// quadratic work (M20 of [[Project/Review-2026-11-09]]).
// `s` `n` times (for the tests: the module doesn't import std.str).
#test("ab", 3)["ababab"]
fun rep(s: str, n: int32) -> str {
    var sb = StringBuilder(s.len() * n)
    var k = 0
    while k < n {
        sb.append(s)
        k = k + 1
    }
    return sb.build()
}

#test
fun nesting_limit() {
    let cases = [
        ("a = " + rep("[", 100) + rep("]", 100), ""),
        ("a = " + rep("[", 101) + rep("]", 101), "1:105"),
        ("a = " + rep("{a=", 100) + "1" + rep("}", 100), ""),
        ("a = " + rep("{a=", 101) + "1" + rep("}", 101), "1:305"),
        (rep("a.", 100) + "a = 1", ""),
        (rep("a.", 101) + "a = 1", "1:1"),
        ("[" + rep("a.", 99) + "a]\nx = 1", ""),
        ("[" + rep("a.", 100) + "a]\nx = 1", "1:1"),
        ("[[" + rep("a.", 98) + "a]]\nx = 1", ""),
        ("[[" + rep("a.", 99) + "a]]\nx = 1", "1:1"),
        ("[" + rep("a.", 49) + "a]\nb = " + rep("[{c = ", 25) + "1" + rep("}]", 25), ""),
        ("[" + rep("a.", 49) + "a]\nb = " + rep("[{c = ", 25) + "[1]" + rep("}]", 25), "2:155"),
        ("[" + rep("a.", 49) + "a]\nb." + rep("c.", 49) + "d = 1", ""),
        ("[" + rep("a.", 49) + "a]\nb." + rep("c.", 50) + "d = 1", "2:1"),
        ("a = " + rep("[", 100000), "1:105"),
    ]
    for (text, at) in cases {
        match parse(text) {
            Ok(_) => assert(at == "", f"{text.len()} bytes: read, expected an error at {at}")
            Err(e) => assert(f"{e}" == f"{at}: tables and arrays nested too deeply (more than 100 levels)", f"{text.len()} bytes: {e}")
        }
    }
}

#test
fun refuses_bad_utf8() {
    var sb = StringBuilder()
    sb.append("# ok\na = \"x")
    sb.append_byte(192u8)
    sb.append("\"\n")
    match parse(sb.build()) {
        Ok(v) => assert(false, "not UTF-8")
        Err(e) => assert(f"{e}" == "2:7: invalid UTF-8", f"{e}")
    }
}

#test
fun keeps_positions() {
    let text = "[dependencies]\ngeo.path = \"../geo\"\nbig = { path = \"vendor\" }\n[[bin]]\nname = \"a\"\n"
    match parse_doc(text) {
        Ok(d) => {
            assert(key_pos(d, ["dependencies", "geo", "path"]) == Some(TomlPos { line: 2, col: 5, end_line: 2, end_col: 9 }), "a dotted key's last part")
            assert(key_pos(d, ["dependencies", "geo"]) == Some(TomlPos { line: 2, col: 1, end_line: 2, end_col: 4 }), "its table")
            assert(value_pos(d, ["dependencies", "big", "path"]) == Some(TomlPos { line: 3, col: 16, end_line: 3, end_col: 24 }), "in an inline table")
            assert(key_pos(d, ["bin", "name"]) == Some(TomlPos { line: 5, col: 1, end_line: 5, end_col: 5 }), "in an array of tables")
            assert(key_pos(d, ["bin"]) == Some(TomlPos { line: 4, col: 1, end_line: 4, end_col: 8 }), "an array of tables' header")
        },
        Err(e) => assert(false, f"{e}"),
    }
}

// --- Writing ------------------------------------------------------------------
//
// A table's members are written in order: its key/value pairs under its
// header, then its tables, each under a header of its own (`[a.b]`), and its
// arrays of tables (`[[a.b]]`, one header an element). A header ends the
// table above it, so a table that comes before a key/value pair of its table
// is written inline (`point = { x = 1 }`), and the keys keep their order: a
// document `parse` gives is read back as itself. A table that holds only
// tables gets no header of its own (`[git.color]`, not `[git]` first).

// The TOML text of the document `doc`, a table, one line a key/value pair
// or a header, a blank line before each header. A value that isn't a table
// is written as `inline_string` writes it.
pub fun to_string(doc: Toml) -> str {
    return match doc {
        Toml.Table(members) => {
            var w = Writer { sb: StringBuilder() }
            w.body([], members)
            w.sb.build()
        }
        _ => inline_string(doc)
    }
}

// The TOML text of the value `v` on one line, as it stands on the right of
// `=`: a string quoted (a literal string when that saves escaping a '"' or a
// '\', else a basic string with escapes), an integer in decimal, a float in
// its shortest form (`0.1`, `1e+16`, `inf`, `nan`), a date or time as RFC
// 3339 writes it (`1979-05-27T07:32:00.5-07:00`, `Z` for a zero offset), an
// array `[a, b]`, a table `{ k = v }`.
pub fun inline_string(v: Toml) -> str {
    return match v {
        Toml.Str(s) => quote_string(s)
        Toml.Int(n) => f"{n}"
        Toml.Float(f) => format_float(f)
        Toml.Bool(b) => match b { true => "true", false => "false" }
        Toml.DateTime(dt) => datetime_text(dt)
        Toml.Date(d) => date_text(d)
        Toml.Time(t) => time_text(t)
        Toml.Array(items) => {
            var sb = StringBuilder()
            sb.append_byte('[')
            for x in items {
                if sb.len() > 1 { sb.append(", ") }
                sb.append(inline_string(x))
            }
            sb.append_byte(']')
            sb.build()
        }
        Toml.Table(members) => {
            if members.len() == 0 { return "{}" }
            var sb = StringBuilder()
            sb.append("{ ")
            for m in members {
                if sb.len() > 2 { sb.append(", ") }
                sb.append(key_text(m.0))
                sb.append(" = ")
                sb.append(inline_string(m.1))
            }
            sb.append(" }")
            sb.build()
        }
    }
}

// A date as TOML writes it.
#test(TomlDate { year: 1, month: 2, day: 3 })["0001-02-03"]
fun date_text(d: TomlDate) -> str {
    return f"{d.year:04}-{d.month:02}-{d.day:02}"
}

// A time as TOML writes it, with as many digits of the fraction as it needs.
#test(TomlTime { hour: 7, minute: 5, second: 0, nanosecond: 0 })["07:05:00"]
#test(TomlTime { hour: 23, minute: 59, second: 59, nanosecond: 120000000 })["23:59:59.12"]
#test(TomlTime { hour: 0, minute: 0, second: 0, nanosecond: 1 })["00:00:00.000000001"]
fun time_text(t: TomlTime) -> str {
    let hms = f"{t.hour:02}:{t.minute:02}:{t.second:02}"
    if t.nanosecond == 0 { return hms }
    let digits = f"{t.nanosecond:09}"
    var end = 9
    while digits[end - 1] == '0' { end -= 1 }
    return hms + "." + digits[:end]
}

// A date-time as TOML writes it: `T` between the date and the time, `Z` for
// a zero offset.
#test(TomlDateTime { date: TomlDate { year: 1979, month: 5, day: 27 }, time: TomlTime { hour: 0, minute: 32, second: 0, nanosecond: 0 }, offset: Some(-420) })["1979-05-27T00:32:00-07:00"]
#test(TomlDateTime { date: TomlDate { year: 1979, month: 5, day: 27 }, time: TomlTime { hour: 0, minute: 32, second: 0, nanosecond: 0 }, offset: Some(330) })["1979-05-27T00:32:00+05:30"]
#test(TomlDateTime { date: TomlDate { year: 1979, month: 5, day: 27 }, time: TomlTime { hour: 0, minute: 32, second: 0, nanosecond: 0 }, offset: None })["1979-05-27T00:32:00"]
fun datetime_text(dt: TomlDateTime) -> str {
    let text = date_text(dt.date) + "T" + time_text(dt.time)
    return match dt.offset {
        None => text
        Some(0) => text + "Z"
        Some(m) => {
            var sign = "+"
            var a = m
            if m < 0 {
                sign = "-"
                a = -m
            }
            text + sign + f"{a / 60:02}:{a % 60:02}"
        }
    }
}

// A key as TOML writes it: bare when it can be, else a basic string.
#test("name")["name"]
#test("a.b")["\"a.b\""]
#test("")["\"\""]
#test("é")["\"é\""]
fun key_text(k: str) -> str {
    if is_bare_key(k) { return k }
    return basic_string_text(k)
}

// `s` as a literal string when it holds a '"' or a '\' and needs no other escape
// (no "'" and no control character, tab included), else as a basic string.
fun quote_string(s: str) -> str {
    var special = false
    var i = 0
    while i < s.len() {
        let c = s[i]
        if c == '\'' || c == '\t' || is_control(c) { return basic_string_text(s) }
        if c == '"' || c == '\\' { special = true }
        i += 1
    }
    if !special { return basic_string_text(s) }
    return "'" + s + "'"
}

// `s` as a basic string: '"', '\' and the control characters escaped,
// `\b \t \n \f \r` by name, the others as `\u00XX`.
#test("a\"b")["\"a\\\"b\""]
#test("\u{1b}x")["\"\\u001Bx\""]
fun basic_string_text(s: str) -> str {
    var sb = StringBuilder(s.len() + 2)
    sb.append_byte('"')
    var run = 0                                  // start of bytes to copy as they are
    var i = 0
    while i < s.len() {
        let c = s[i]
        if c == '"' || c == '\\' || c < 32u8 || c == 127u8 {
            sb.append(s, run, i)
            if c == '"' { sb.append("\\\"") }
            else if c == '\\' { sb.append("\\\\") }
            else if c == 8u8 { sb.append("\\b") }
            else if c == '\t' { sb.append("\\t") }
            else if c == '\n' { sb.append("\\n") }
            else if c == 12u8 { sb.append("\\f") }
            else if c == 13u8 { sb.append("\\r") }
            else { sb.append("\\u" + hex4(c as int32)) }
            run = i + 1
        }
        i += 1
    }
    sb.append(s, run, s.len())
    sb.append_byte('"')
    return sb.build()
}

// Whether `v` is written under a header of its own when it can be: a table,
// or an array of tables (not empty).
#test(Toml.Table([]))[true]
#test(Toml.Array([Toml.Table([]), Toml.Table([])]))[true]
#test(Toml.Array([Toml.Table([]), Toml.Int(1)]))[false]
#test(Toml.Array([]))[false]
#test(Toml.Str("x"))[false]
fun is_section(v: Toml) -> bool {
    return match v {
        Toml.Table(_) => true
        Toml.Array(items) => {
            if items.len() == 0 { return false }
            for x in items {
                match x {
                    Toml.Table(_) => {},
                    _ => { return false },
                }
            }
            true
        }
        _ => false
    }
}

// The index of the last member of a table that is written as a key/value
// pair under the table's header, -1 if none is: every member up to it is
// one, the rest are sections.
fun last_pair(members: [(str, Toml)]) -> int32 {
    var k = members.len() - 1
    while k >= 0 && is_section(members[k].1) { k -= 1 }
    return k
}

// A key path as a header writes it.
#test(["dependencies", "a b"])["dependencies.\"a b\""]
fun header_path(path: [str]) -> str {
    var sb = StringBuilder()
    for k in path {
        if sb.len() > 0 { sb.append_byte('.') }
        sb.append(key_text(k))
    }
    return sb.build()
}

struct Writer {
    sb: StringBuilder,
}

impl Writer {
    // The header `open path close`, after a blank line unless it starts the
    // text.
    fun header(var self, open: str, path: [str], close: str) {
        if self.sb.len() > 0 { self.sb.append_byte('\n') }
        self.sb.append(open)
        self.sb.append(header_path(path))
        self.sb.append(close)
        self.sb.append_byte('\n')
    }

    // The members of the table at `path`, its header written already (or
    // left out).
    fun body(var self, path: [str], members: [(str, Toml)]) {
        let last = last_pair(members)
        var k = 0
        while k <= last {
            self.sb.append(key_text(members[k].0))
            self.sb.append(" = ")
            self.sb.append(inline_string(members[k].1))
            self.sb.append_byte('\n')
            k += 1
        }
        k = last + 1
        while k < members.len() {
            let sub = with_key(path, members[k].0)
            match members[k].1 {
                Toml.Table(ms) => {
                    if ms.len() == 0 || last_pair(ms) >= 0 { self.header("[", sub, "]") }
                    self.body(sub, ms)
                },
                Toml.Array(items) => {
                    for x in items {
                        self.header("[[", sub, "]]")
                        match x {
                            Toml.Table(ms) => { self.body(sub, ms) },
                            _ => {},
                        }
                    }
                },
                _ => {},
            }
            k += 1
        }
    }
}

// --- Tests of the writer -------------------------------------------------------

// "same" when the document `text` holds is written and read back as itself;
// else what went wrong, with the text written.
fun round_trip(text: str) -> str {
    let doc = match parse(text) {
        Ok(d) => d,
        Err(e) => { return f"{e} in the original" },
    }
    let written = to_string(doc)
    return match parse(written) {
        Ok(back) => match back == doc { true => "same", false => "different:\n" + written }
        Err(e) => f"{e} in\n{written}"
    }
}

#test
fun writes_a_manifest() {
    let doc = Toml.Table([
        ("package", Toml.Table([
            ("name", Toml.Str("shapes")),
            ("version", Toml.Str("0.1.0")),
            ("authors", Toml.Array([Toml.Str("Ada <ada@example.org>")])),
        ])),
        ("dependencies", Toml.Table([
            ("geo", Toml.Table([("path", Toml.Str("../geo"))])),
            ("big", Toml.Table([("path", Toml.Str("vendor/big")), ("optional", Toml.Bool(true))])),
        ])),
    ])
    let want = "[package]\nname = \"shapes\"\nversion = \"0.1.0\"\nauthors = [\"Ada <ada@example.org>\"]\n\n[dependencies.geo]\npath = \"../geo\"\n\n[dependencies.big]\npath = \"vendor/big\"\noptional = true\n"
    assert(to_string(doc) == want, to_string(doc))
}

#test
fun writes_tables_inline_before_a_key() {
    // a table before a key/value pair is written inline, so the keys keep
    // their order
    let doc = Toml.Table([
        ("version", Toml.Int(1)),
        ("point", Toml.Table([("x", Toml.Int(-3)), ("y", Toml.Int(9223372036854775807i64))])),
        ("empty", Toml.Table([])),
        ("last", Toml.Bool(false)),
        ("tail", Toml.Table([])),
    ])
    let want = "version = 1\npoint = { x = -3, y = 9223372036854775807 }\nempty = {}\nlast = false\n\n[tail]\n"
    assert(to_string(doc) == want, to_string(doc))
}

#test
fun writes_arrays_of_tables() {
    // an array of tables as `[[…]]` sections, an array of other values
    // inline
    let doc = Toml.Table([
        ("mixed", Toml.Array([Toml.Int(1), Toml.Array([]), Toml.Table([("a", Toml.Str("b"))])])),
        ("bin", Toml.Array([
            Toml.Table([("name", Toml.Str("a")), ("opt", Toml.Table([("x", Toml.Int(1))]))]),
            Toml.Table([]),
        ])),
    ])
    let want = "mixed = [1, [], { a = \"b\" }]\n\n[[bin]]\nname = \"a\"\n\n[bin.opt]\nx = 1\n\n[[bin]]\n"
    assert(to_string(doc) == want, to_string(doc))
    assert(parse(want) == Ok(doc), "read back")
    // a value that isn't a table is written as `inline_string` writes it
    assert(to_string(Toml.Int(7)) == "7", "a value")
}

#test(Toml.Str("plain"))["\"plain\""]
#test(Toml.Str("tab\there \"q\" \\ \n\r\u{8}\u{c}\u{1}\u{7f}é"))["\"tab\\there \\\"q\\\" \\\\ \\n\\r\\b\\f\\u0001\\u007Fé\""]
#test(Toml.Str("C:\\dir\\file"))["'C:\\dir\\file'"] // a literal string reads better
#test(Toml.Str("say \"hi\""))["'say \"hi\"'"]
#test(Toml.Str("it's \"x\""))["\"it's \\\"x\\\"\""]
#test(Toml.Int(-9223372036854775807i64 - 1i64))["-9223372036854775808"]
#test(Toml.Float(0.1))["0.1"]
#test(Toml.Float(-1e16))["-1e+16"]
#test(Toml.Float(-1.0 / 0.0))["-inf"]
#test(Toml.Float(3.0))["3.0"]
#test(Toml.Array([Toml.Str("a"), Toml.Bool(true)]))["[\"a\", true]"]
#test(Toml.Table([("a b", Toml.Int(1)), ("", Toml.Int(2)), ("ok-1_x", Toml.Table([]))]))["{ \"a b\" = 1, \"\" = 2, ok-1_x = {} }"]
fun inline_cases(v: Toml) -> str {
    return inline_string(v)
}

#test("a = 1\n")["same"]
#test("")["same"]
#test("# only a comment\n")["same"]
#test("[package]\nname = \"geo\"\nauthors = [\"Ada\", 'Bob']\n")["same"] // the page's
#test("# myla.toml\n[package]\nname = \"shapes\"\nversion = \"0.1.0\"\ndescription = \"Shapes and their areas\"\nauthors = [\"Ada <ada@example.org>\"]\nlicense = \"MIT\"\n\n[dependencies]\ngeo = { path = \"../geo\" }\njson5 = { url = \"https://example.org/json5.git\", tag = \"v1.2.0\" }\n\n[dependencies.big]            # the same as big = { path = \"vendor/big\" }\npath = \"vendor/big\"\n")["same"] // a manifest
#test("version = 1\n\n[pkgs.color]\nurl = \"https://example.org/color.git\"\nbranch = \"main\"\ncommit = \"0b1c2d3e\"\n\n[pkgs.json5]\nurl = \"x\"\ntag = \"v1.2.0\"\n")["same"] // a lock file
#test("[a.b]\nx = 1\n[a]\ny = 2\n[a.c.d]\n[e]\n")["same"] // a table after its sub-table
#test("\"a.b\" = 1\n'c\"d' = \"\\u00e9\\t\\\\\"\n[\"x y\".'z']\n\"\" = { \"\" = { q = [] } }\n")["same"] // quoted keys
#test("n = -9223372036854775808\nm = +1_000\nt = true\nf = false\ns = 'lit\\eral'\n")["same"]
#test("[a]\n[b]\n[a.x]\n")["same"] // a table extended after another
#test("k = \"\\u0000\\u001f\\u007f\\b\\f\\r\\n\"\n")["same"] // control characters
#test("f = [nan, -inf, 0.1, -0.0, 1e300, 5e-324]\nd = [1979-05-27T07:32:00.123456789+01:00, 1979-05-27T07:32:00, 2000-01-01, 23:59:59]\n")["same"] // floats, dates and times
#test("s = \"\"\"\nmulti\nline\"\"\"\nx.y.z = 1\nx.w = { a.b = 2 }\n[[t]]\n[t.u]\n[[t.v]]\n[[t]]\nq = [[1], [{ r = 0x10 }]]\n")["same"] // the rest of TOML
fun round_trip_cases(text: str) -> str {
    return round_trip(text)
}

// --- Typed values (MYLA-407, as std.json's D172) ----------------------------------

// A value with a TOML form. `#derive(Toml)` writes the impl for a struct (a
// table of its fields, named as written, an `Option` field left out when it
// is `None`: TOML has no null) and for an enum (`"Red"` for a variant without
// payload, `{ Dot = x }` for one with one, `{ Line = [a, b] }` for one with
// more), as `#derive(Json)` does. Writing never fails: a `uint64` beyond
// `int64` is a float.
pub trait ToToml {
    fun to_toml(self) -> Toml
}

// A value read from its TOML form: `Point.from_toml(t)`, `T.from_toml(t)`
// under a bound `T: FromToml`. An integer is checked for its type's range,
// a struct ignores keys it has no field for, and an error says where it is
// (`$.servers[2].ip`).
pub trait FromToml {
    fun from_toml(t: Toml) -> Result<Self, TomlError>
}

// `v` as a TOML document, as `to_string` writes `v.to_toml()`; an error
// (`WrongType`) when that isn't a table, as a document must be: a number, a
// list, a variant without payload.
pub fun encode<T: ToToml>(v: T) -> Result<str, TomlError> {
    let t = v.to_toml()
    return match t {
        Toml.Table(ms) => Ok(to_string(t))
        _ => Err(wrong_type("a table for a TOML document", t))
    }
}

// The value of type `T` that the document `text` holds:
// `toml.decode<Config>(text)`, or with the type from where the result goes.
// A text that isn't TOML is a `Syntax` error, a value that doesn't fit `T`
// an error with its path.
pub fun decode<T: FromToml>(text: str) -> Result<T, TomlError> {
    let t = parse(text)?
    return T.from_toml(t)
}

// The error for a value `found` where `expected` (in words: "an integer",
// "a color") should be, at the value itself (`$`), for a `FromToml` impl
// written by hand: `Err(toml.wrong_type("a color", t))`.
#test("a color", Toml.Int(3i64))[TomlError { kind: TomlErrorKind.WrongType, msg: "expected a color, found the integer 3", line: 0, col: 0, path: "$" }]
pub fun wrong_type(expected: str, found: Toml) -> TomlError {
    return value_error(TomlErrorKind.WrongType, f"expected {expected}, found {described(found)}")
}

// The members of the table `t`, for a `FromToml` impl of the type `name` (a
// derived one, or one written by hand); not a table is an error.
#test(Toml.Table([("a", Toml.Int(1i64))]), "P")[Ok([("a", Toml.Int(1i64))])]
#test(Toml.Array([]), "P")[Err(TomlError { kind: TomlErrorKind.WrongType, msg: "expected a table for 'P', found an empty array", line: 0, col: 0, path: "$" })]
pub fun members(t: Toml, name: str) -> Result<[(str, Toml)], TomlError> {
    return match t {
        Toml.Table(ms) => Ok(ms)
        _ => Err(wrong_type(f"a table for '{name}'", t))
    }
}

// The member `name` of a table's `fields` as a `T`; an error if there is
// none, or with the member's step added to its path.
pub fun member<T: FromToml>(fields: [(str, Toml)], name: str) -> Result<T, TomlError> {
    return match field(Toml.Table(fields), name) {
        Some(v) => within(T.from_toml(v), key_step(name))
        None => Err(TomlError { kind: TomlErrorKind.MissingField, msg: "missing field", line: 0, col: 0, path: "$" + key_step(name) })
    }
}

// The member `name` of `fields` as an optional `T`: `None` when it is absent
// (TOML has no null).
pub fun optional_member<T: FromToml>(fields: [(str, Toml)], name: str) -> Result<Option<T>, TomlError> {
    return match field(Toml.Table(fields), name) {
        Some(v) => Ok(Some(within(T.from_toml(v), key_step(name))?))
        None => Ok(None)
    }
}

// `r`, its error one step further in: `step` (`.name`, `[2]`) after the `$`.
fun within<T>(r: Result<T, TomlError>, step: str) -> Result<T, TomlError> {
    return match r {
        Ok(v) => Ok(v)
        Err(e) => Err(TomlError { kind: e.kind, msg: e.msg, line: e.line, col: e.col, path: "$" + step + e.path[1:] })
    }
}

// The step of a path into the member `key`: `.key` for a name, `["a b"]` for
// another key (as std.json writes it).
#test("label")[".label"]
#test("_x9")["._x9"]
#test("a b")["[\"a b\"]"]
#test("")["[\"\"]"]
#test("9")["[\"9\"]"]
fun key_step(key: str) -> str {
    var plain = key.len() > 0 && !is_digit(key[0])
    var i = 0
    while i < key.len() {
        let c = key[i]
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c) || c == '_') { plain = false }
        i += 1
    }
    if plain { return "." + key }
    return "[" + basic_string_text(key) + "]"
}

// An error at the value itself (`$`).
fun value_error(kind: TomlErrorKind, msg: str) -> TomlError {
    return TomlError { kind: kind, msg: msg, line: 0, col: 0, path: "$" }
}

// What `t` is, for an error: "a string", "the integer 1", "the float 1.5", …
#test(Toml.Float(1.5))["the float 1.5"]
#test(Toml.Array([Toml.Bool(true)]))["an array of 1 item"]
#test(Toml.Date(TomlDate { year: 2024, month: 1, day: 2 }))["the date 2024-01-02"]
fun described(t: Toml) -> str {
    return match t {
        Toml.Str(s) => "a string"
        Toml.Int(n) => f"the integer {n}"
        Toml.Float(f) => "the float " + format_float(f)
        Toml.Bool(b) => if b { "true" } else { "false" }
        Toml.DateTime(d) => "the date-time " + datetime_text(d)
        Toml.Date(d) => "the date " + date_text(d)
        Toml.Time(x) => "the time " + time_text(x)
        Toml.Array(items) => match items.len() {
            0 => "an empty array"
            1 => "an array of 1 item"
            n => f"an array of {n} items"
        }
        Toml.Table(ms) => "a table"
    }
}

// --- What `#derive(Toml)` calls for an enum -----------------------------------------

// The variant's name and its payload, if any, of an enum value of type
// `name`: a string is a variant without payload, a table of one key a
// variant with one.
#test(Toml.Str("Red"), "Color")[Ok(("Red", None))]
#test(Toml.Table([("Dot", Toml.Int(1i64))]), "Shape")[Ok(("Dot", Some(Toml.Int(1i64))))]
#test(Toml.Table([]), "Shape")[Err(TomlError { kind: TomlErrorKind.WrongType, msg: "expected a variant of 'Shape' (a string, or a table of one key), found a table", line: 0, col: 0, path: "$" })]
fun variant_of(t: Toml, name: str) -> Result<(str, Option<Toml>), TomlError> {
    match t {
        Toml.Str(s) => { return Ok((s, None)) }
        Toml.Table(ms) => {
            if ms.len() == 1 { return Ok((ms[0].0, Some(ms[0].1))) }
        }
        _ => {}
    }
    return Err(wrong_type(f"a variant of '{name}' (a string, or a table of one key)", t))
}

// `value`, the variant without payload `v` names, if `v` has none.
fun unit_variant<T>(v: (str, Option<Toml>), name: str, value: T) -> Result<T, TomlError> {
    return match v.1 {
        Some(p) => Err(value_error(TomlErrorKind.WrongType, f"variant '{v.0}' of '{name}' has no payload: write it as \"{v.0}\""))
        None => Ok(value)
    }
}

// Item `i` of the payload of `n` items of the variant `v` of enum `name`:
// the payload itself for one item, else an array of `n`.
fun payload<T: FromToml>(v: (str, Option<Toml>), name: str, n: int32, i: int32) -> Result<T, TomlError> {
    let step = key_step(v.0)
    match v.1 {
        Some(p) => {
            if n == 1 { return within(T.from_toml(p), step) }
            match p {
                Toml.Array(items) => {
                    if items.len() == n { return within(T.from_toml(items[i]), f"{step}[{i}]") }
                }
                _ => {}
            }
            return within(Err(wrong_type(f"an array of {n} items", p)), step)
        }
        None => {
            return Err(value_error(TomlErrorKind.WrongType, f"variant '{v.0}' of '{name}' has a payload: write it as " + "{ " + key_text(v.0) + " = … }"))
        }
    }
}

// The error for a variant `variant` that the enum `name` hasn't.
#test("Blue", "Color", ["Red", "Green"])[TomlError { kind: TomlErrorKind.UnknownVariant, msg: "unknown variant 'Blue' of 'Color', expected one of 'Red', 'Green'", line: 0, col: 0, path: "$" }]
fun unknown_variant(variant: str, name: str, variants: [str]) -> TomlError {
    var sb = StringBuilder()
    sb.append(f"unknown variant '{variant}' of '{name}', expected one of ")
    var first = true
    for v in variants {
        if !first { sb.append(", ") }
        sb.append(f"'{v}'")
        first = false
    }
    return value_error(TomlErrorKind.UnknownVariant, sb.build())
}

// --- The built-in types ---------------------------------------------------------

// The integer `t` holds, checked for the range `lo` to `hi` of the type
// `name` (TOML's integers and floats are apart: a float isn't an integer).
#test(Toml.Int(-128i64), -128i64, 127i64, "int8")[Ok(-128i64)]
#test(Toml.Int(256i64), 0i64, 255i64, "uint8")[Err(TomlError { kind: TomlErrorKind.OutOfRange, msg: "256 is out of range for uint8", line: 0, col: 0, path: "$" })]
#test(Toml.Float(2.0), -128i64, 127i64, "int8")[Err(TomlError { kind: TomlErrorKind.WrongType, msg: "expected an integer, found the float 2.0", line: 0, col: 0, path: "$" })]
fun int_in(t: Toml, lo: int64, hi: int64, name: str) -> Result<int64, TomlError> {
    let n = match t {
        Toml.Int(v) => v
        _ => { return Err(wrong_type("an integer", t)) }
    }
    if n < lo || n > hi { return Err(value_error(TomlErrorKind.OutOfRange, f"{n} is out of range for {name}")) }
    return Ok(n)
}

impl ToToml for int8 {
    fun to_toml(self) -> Toml { return Toml.Int(self as int64) }
}

impl FromToml for int8 {
    fun from_toml(t: Toml) -> Result<int8, TomlError> { return Ok(int_in(t, -128, 127, "int8")? as int8) }
}

impl ToToml for int16 {
    fun to_toml(self) -> Toml { return Toml.Int(self as int64) }
}

impl FromToml for int16 {
    fun from_toml(t: Toml) -> Result<int16, TomlError> { return Ok(int_in(t, -32768, 32767, "int16")? as int16) }
}

impl ToToml for int32 {
    fun to_toml(self) -> Toml { return Toml.Int(self as int64) }
}

impl FromToml for int32 {
    fun from_toml(t: Toml) -> Result<int32, TomlError> { return Ok(int_in(t, -2147483648, 2147483647, "int32")? as int32) }
}

impl ToToml for int64 {
    fun to_toml(self) -> Toml { return Toml.Int(self) }
}

impl FromToml for int64 {
    fun from_toml(t: Toml) -> Result<int64, TomlError> { return int_in(t, -9223372036854775807 - 1, 9223372036854775807, "int64") }
}

impl ToToml for uint8 {
    fun to_toml(self) -> Toml { return Toml.Int(self as int64) }
}

impl FromToml for uint8 {
    fun from_toml(t: Toml) -> Result<uint8, TomlError> { return Ok(int_in(t, 0, 255, "uint8")? as uint8) }
}

impl ToToml for uint16 {
    fun to_toml(self) -> Toml { return Toml.Int(self as int64) }
}

impl FromToml for uint16 {
    fun from_toml(t: Toml) -> Result<uint16, TomlError> { return Ok(int_in(t, 0, 65535, "uint16")? as uint16) }
}

impl ToToml for uint32 {
    fun to_toml(self) -> Toml { return Toml.Int(self as int64) }
}

impl FromToml for uint32 {
    fun from_toml(t: Toml) -> Result<uint32, TomlError> { return Ok(int_in(t, 0, 4294967295, "uint32")? as uint32) }
}

impl ToToml for uint64 {
    // beyond int64 (TOML's integers), a float: the nearest float64, which
    // reads back only if it is exact
    #test(18446744073709551615u64)[Toml.Float(18446744073709551616.0)]
    fun to_toml(self) -> Toml {
        if self > 9223372036854775807 { return Toml.Float(self as float64) }
        return Toml.Int(self as int64)
    }
}

impl FromToml for uint64 {
    #test(Toml.Float(9223372036854775808.0))[Ok(9223372036854775808u64)]
    #test(Toml.Float(18446744073709551616.0))[Err(TomlError { kind: TomlErrorKind.OutOfRange, msg: "1.8446744073709552e+19 is out of range for uint64", line: 0, col: 0, path: "$" })]
    fun from_toml(t: Toml) -> Result<uint64, TomlError> {
        match t {
            Toml.Float(f) => {
                if f >= 9223372036854775808.0 && f < 18446744073709551616.0 && f == (f as uint64) as float64 { return Ok(f as uint64) }
                if f >= 9223372036854775808.0 { return Err(value_error(TomlErrorKind.OutOfRange, f"{format_float(f)} is out of range for uint64")) }
            }
            _ => {}
        }
        return Ok(int_in(t, 0, 9223372036854775807, "uint64")? as uint64)
    }
}

impl ToToml for float64 {
    // `inf` and `nan` are TOML floats too
    #test(1.0 / 0.0)[Toml.Float(1.0 / 0.0)]
    fun to_toml(self) -> Toml { return Toml.Float(self) }
}

impl FromToml for float64 {
    // an integer is a float's value too
    #test(Toml.Int(3i64))[Ok(3.0)]
    fun from_toml(t: Toml) -> Result<float64, TomlError> {
        return match t {
            Toml.Float(f) => Ok(f)
            Toml.Int(n) => Ok(n as float64)
            _ => Err(wrong_type("a number", t))
        }
    }
}

impl ToToml for float32 {
    // the shortest decimal that reads back as the same float32: 0.1, not
    // 0.10000000149011612
    #test(0.1f32)[Toml.Float(0.1)]
    fun to_toml(self) -> Toml {
        if self != self || self - self != 0.0f32 { return Toml.Float(self as float64) }
        return match parse_float(f"{self}") {
            Some(f) => Toml.Float(f)
            None => Toml.Float(self as float64)
        }
    }
}

impl FromToml for float32 {
    #test(Toml.Float(1e300))[Err(TomlError { kind: TomlErrorKind.OutOfRange, msg: "1e+300 is out of range for float32", line: 0, col: 0, path: "$" })]
    fun from_toml(t: Toml) -> Result<float32, TomlError> {
        let f = float64.from_toml(t)?
        let g = f as float32
        if f - f == 0.0 && g - g != 0.0f32 { return Err(value_error(TomlErrorKind.OutOfRange, f"{format_float(f)} is out of range for float32")) }
        return Ok(g)
    }
}

impl ToToml for bool {
    fun to_toml(self) -> Toml { return Toml.Bool(self) }
}

impl FromToml for bool {
    fun from_toml(t: Toml) -> Result<bool, TomlError> {
        return match t {
            Toml.Bool(b) => Ok(b)
            _ => Err(wrong_type("true or false", t))
        }
    }
}

impl ToToml for str {
    fun to_toml(self) -> Toml { return Toml.Str(self) }
}

impl FromToml for str {
    fun from_toml(t: Toml) -> Result<str, TomlError> {
        return match t {
            Toml.Str(s) => Ok(s)
            _ => Err(wrong_type("a string", t))
        }
    }
}

impl ToToml for char {
    // a string of the one character
    fun to_toml(self) -> Toml { return Toml.Str(f"{self}") }
}

impl FromToml for char {
    #test(Toml.Str("é"))[Ok('é')]
    #test(Toml.Str("ab"))[Err(TomlError { kind: TomlErrorKind.WrongType, msg: "expected a string of one character, found a string of 2", line: 0, col: 0, path: "$" })]
    fun from_toml(t: Toml) -> Result<char, TomlError> {
        match t {
            Toml.Str(s) => {
                let cs = s.chars()
                if cs.len() == 1 { return Ok(cs[0]) }
                return Err(value_error(TomlErrorKind.WrongType, f"expected a string of one character, found a string of {cs.len()}"))
            }
            _ => { return Err(wrong_type("a string of one character", t)) }
        }
    }
}

impl ToToml for TomlDateTime {
    fun to_toml(self) -> Toml { return Toml.DateTime(self) }
}

impl FromToml for TomlDateTime {
    fun from_toml(t: Toml) -> Result<TomlDateTime, TomlError> {
        return match t {
            Toml.DateTime(d) => Ok(d)
            _ => Err(wrong_type("a date-time", t))
        }
    }
}

impl ToToml for TomlDate {
    fun to_toml(self) -> Toml { return Toml.Date(self) }
}

impl FromToml for TomlDate {
    fun from_toml(t: Toml) -> Result<TomlDate, TomlError> {
        return match t {
            Toml.Date(d) => Ok(d)
            _ => Err(wrong_type("a date", t))
        }
    }
}

impl ToToml for TomlTime {
    fun to_toml(self) -> Toml { return Toml.Time(self) }
}

impl FromToml for TomlTime {
    fun from_toml(t: Toml) -> Result<TomlTime, TomlError> {
        return match t {
            Toml.Time(x) => Ok(x)
            _ => Err(wrong_type("a time", t))
        }
    }
}

impl ToToml for Toml {
    fun to_toml(self) -> Toml { return self }
}

impl FromToml for Toml {
    fun from_toml(t: Toml) -> Result<Toml, TomlError> { return Ok(t) }
}

impl<T: ToToml> ToToml for [T] {
    fun to_toml(self) -> Toml {
        var items: [Toml] = []
        for x in self { items.push(x.to_toml()) }
        return Toml.Array(items)
    }
}

impl<T: FromToml> FromToml for [T] {
    fun from_toml(t: Toml) -> Result<[T], TomlError> {
        match t {
            Toml.Array(items) => {
                var out: [T] = []
                var i = 0
                for item in items {
                    out.push(within(T.from_toml(item), f"[{i}]")?)
                    i += 1
                }
                return Ok(out)
            }
            _ => { return Err(wrong_type("an array", t)) }
        }
    }
}

// A map with string keys is a table, its keys in the map's order.
impl<V: ToToml> ToToml for [str: V] {
    fun to_toml(self) -> Toml {
        var ms: [(str, Toml)] = []
        for k in self { ms.push((k, self[k].to_toml())) }
        return Toml.Table(ms)
    }
}

impl<V: FromToml> FromToml for [str: V] {
    fun from_toml(t: Toml) -> Result<[str: V], TomlError> {
        match t {
            Toml.Table(ms) => {
                var out: [str: V] = [:]
                for m in ms { out[m.0] = within(V.from_toml(m.1), key_step(m.0))? }
                return Ok(out)
            }
            _ => { return Err(wrong_type("a table", t)) }
        }
    }
}

// An error's text, or "ok" (for the test functions).
fun outcome<T>(r: Result<T, TomlError>) -> str {
    return match r {
        Ok(v) => "ok"
        Err(e) => f"{e}"
    }
}

// Whether `r` is `Ok(want)` (for the test functions).
fun gives<T: Eq>(r: Result<T, TomlError>, want: T) -> bool {
    return match r {
        Ok(v) => v == want
        Err(e) => false
    }
}

// Every built-in type's value goes to TOML and back.
#test
fun built_in_types_round_trip() {
    let m: [str: [int8]] = ["a": [-128, 127], "c d": []]
    let text = match encode(m) {
        Ok(t) => t
        Err(e) => f"{e}"
    }
    assert(text == "a = [-128, 127]\n\"c d\" = []\n", text)
    match decode<[str: [int8]]>(text) {
        Ok(back) => assert(back.to_toml() == m.to_toml(), "read back")
        Err(e) => assert(false, f"{e}")
    }
    assert(['x', 'ü'].to_toml() == Toml.Array([Toml.Str("x"), Toml.Str("ü")]), "chars")
    assert(inline_string([0.5f32, 1e10f32].to_toml()) == "[0.5, 10000000000.0]", "float32")
    assert(inline_string([1.0 / 0.0, -0.0].to_toml()) == "[inf, -0.0]", "floats")
    assert(outcome(encode([1, 2])) == "$: expected a table for a TOML document, found an array of 2 items", "not a document")
    let big: Result<[str: [int16]], TomlError> = decode("x = [1, 40000]")
    assert(outcome(big) == "$.x[1]: 40000 is out of range for int16", outcome(big))
    let day = TomlDate { year: 2024, month: 2, day: 29 }
    assert(gives(TomlDate.from_toml(day.to_toml()), day), "a date")
    assert(outcome(TomlTime.from_toml(day.to_toml())) == "$: expected a time, found the date 2024-02-29", "not a time")
}

// `encode`, `decode` and the helpers of a `FromToml` impl.
#test
fun encodes_and_decodes() {
    let xs: Result<[str: [int]], TomlError> = decode("a = [1, 2]")
    match xs {
        Ok(m) => assert(m["a"] == [1, 2], "decode")
        Err(e) => assert(false, f"{e}")
    }
    match decode<[str: int]>("a = [1, 2") {
        Ok(v) => assert(false, "not TOML")
        Err(e) => assert(e == TomlError { kind: TomlErrorKind.Syntax, msg: "expected ',' or ']' in an array", line: 1, col: 10, path: "" }, f"{e}")
    }
    match decode<[str: int]>("a = \"2\"") {
        Ok(v) => assert(false, "not an int")
        Err(e) => assert(e == TomlError { kind: TomlErrorKind.WrongType, msg: "expected an integer, found a string", line: 0, col: 0, path: "$.a" }, f"{e}")
    }
    match member<int64>([("b", Toml.Int(1))], "a") {
        Ok(v) => assert(false, "no member a")
        Err(e) => assert(e == TomlError { kind: TomlErrorKind.MissingField, msg: "missing field", line: 0, col: 0, path: "$.a" }, f"{e}")
    }
    assert(outcome(member<int64>([("a b", Toml.Bool(true))], "a b")) == "$[\"a b\"]: expected an integer, found true", "a quoted key")
    var seen: [str] = []
    let cases: [[(str, Toml)]] = [[], [("a", Toml.Int(4))]]
    for fields in cases {
        match optional_member<int64>(fields, "a") {
            Ok(Some(n)) => seen.push(f"{n}")
            Ok(None) => seen.push("none")
            Err(e) => seen.push(f"{e}")
        }
    }
    assert(seen == ["none", "4"], "absent, present")
    assert(outcome(optional_member<int8>([("a", Toml.Int(400))], "a")) == "$.a: 400 is out of range for int8", "nested")
}

// What `#derive(Toml)` calls for an enum's variants.
#test
fun reads_variants() {
    assert(gives(unit_variant(("Red", None), "Color", 1), 1), "unit")
    assert(outcome(unit_variant(("Red", Some(Toml.Int(0))), "Color", 1)) == "$: variant 'Red' of 'Color' has no payload: write it as \"Red\"", "unit with payload")
    let pair = ("P", Some(Toml.Array([Toml.Int(1), Toml.Int(2)])))
    assert(gives(payload<int64>(pair, "E", 2, 1), 2i64), "second item")
    assert(gives(payload<int64>(("P", Some(Toml.Int(5))), "E", 1, 0), 5i64), "one item")
    assert(outcome(payload<int64>(("P", Some(Toml.Array([Toml.Int(1)]))), "E", 2, 0)) == "$.P: expected an array of 2 items, found an array of 1 item", "too few")
    assert(outcome(payload<int64>(("P", None), "E", 1, 0)) == "$: variant 'P' of 'E' has a payload: write it as { P = … }", "no payload")
    assert(outcome(payload<bool>(pair, "E", 2, 0)) == "$.P[0]: expected true or false, found the integer 1", "an item's path")
}
