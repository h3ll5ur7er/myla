        w4 = w1 ^ w12 ^ w6 ^ w4; t = w4 >> 31u32; w4 = (w4 << 1u32) | t
        t = e | a; t = (b & t) | (e & a); c = c.wrapping_add(t).wrapping_add(0x8f1bbcdcu32).wrapping_add(w4)
        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)
        t = e >> 2u32; e = (e << 30u32) | t
        w5 = w2 ^ w13 ^ w7 ^ w5; t = w5 >> 31u32; w5 = (w5 << 1u32) | t
        t = d | e; t = (a & t) | (d & e); b = b.wrapping_add(t).wrapping_add(0x8f1bbcdcu32).wrapping_add(w5)
        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)
        t = d >> 2u32; d = (d << 30u32) | t
        w6 = w3 ^ w14 ^ w8 ^ w6; t = w6 >> 31u32; w6 = (w6 << 1u32) | t
        t = c | d; t = (e & t) | (c & d); a = a.wrapping_add(t).wrapping_add(0x8f1bbcdcu32).wrapping_add(w6)
        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)
