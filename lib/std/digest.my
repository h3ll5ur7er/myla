        d = d.wrapping_add(a ^ b ^ c).wrapping_add(0xca62c1d6u32).wrapping_add(w12)
        t = e >> 27u32; t = (e << 5u32) | t; d = d.wrapping_add(t)
        t = a >> 2u32; a = (a << 30u32) | t
        w13 = w10 ^ w5 ^ w15 ^ w13; t = w13 >> 31u32; w13 = (w13 << 1u32) | t
        c = c.wrapping_add(e ^ a ^ b).wrapping_add(0xca62c1d6u32).wrapping_add(w13)
        t = d >> 27u32; t = (d << 5u32) | t; c = c.wrapping_add(t)
        t = e >> 2u32; e = (e << 30u32) | t
        w14 = w11 ^ w6 ^ w0 ^ w14; t = w14 >> 31u32; w14 = (w14 << 1u32) | t
        b = b.wrapping_add(d ^ e ^ a).wrapping_add(0xca62c1d6u32).wrapping_add(w14)
        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)
        t = d >> 2u32; d = (d << 30u32) | t
        w15 = w12 ^ w7 ^ w1 ^ w15; t = w15 >> 31u32; w15 = (w15 << 1u32) | t
        a = a.wrapping_add(c ^ d ^ e).wrapping_add(0xca62c1d6u32).wrapping_add(w15)
        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)
        t = c >> 2u32; c = (c << 30u32) | t
        self.a = self.a.wrapping_add(a)
        self.b = self.b.wrapping_add(b)
        self.c = self.c.wrapping_add(c)
        self.d = self.d.wrapping_add(d)
        self.e = self.e.wrapping_add(e)
    }

    fun close(var self) {
        if self.blk.pad() {
            self.compress()
            self.blk.clear()
        }
        self.blk.put_length()
        self.compress()
    }

    fun bytes(self) -> [uint8] {
        return be_bytes([self.a, self.b, self.c, self.d, self.e], 5)
    }

    fun hex(self) -> str {
        var x = new_hex()
        x.be32(self.a)
        x.be32(self.b)
        x.be32(self.c)
        x.be32(self.d)
        x.be32(self.e)
        return x.sb.build()
    }
}

impl Digest for Sha1 {
    fun update(var self, data: [uint8]) {
        var i = 0
        while i < data.len() {
            i = self.blk.fill(data, i)
            if self.blk.used == 64 {
                self.compress()
                self.blk.used = 0
            }
        }
    }

    #test(new_sha1())[[0xdau8, 0x39u8, 0xa3u8, 0xeeu8, 0x5eu8, 0x6bu8, 0x4bu8, 0x0du8, 0x32u8, 0x55u8, 0xbfu8, 0xefu8, 0x95u8, 0x60u8, 0x18u8, 0x90u8, 0xafu8, 0xd8u8, 0x07u8, 0x09u8]]
    fun finish(self) -> [uint8] {
        var h = self
        h.close()
        return h.bytes()
    }

    #test(new_sha1())[64]
    fun block_size(self) -> int {
        return 64
    }
}

// The SHA-1 digest of `data`, 20 bytes.
#test([97u8, 98u8, 99u8])[[0xa9u8, 0x99u8, 0x3eu8, 0x36u8, 0x47u8, 0x06u8, 0x81u8, 0x6au8, 0xbau8, 0x3eu8, 0x25u8, 0x71u8, 0x78u8, 0x50u8, 0xc2u8, 0x6cu8, 0x9cu8, 0xd0u8, 0xd8u8, 0x9du8]]
pub fun sha1(data: [uint8]) -> [uint8] {
    var h = new_sha1()
    h.update(data)
    h.close()
    return h.bytes()
}

#test("")["da39a3ee5e6b4b0d3255bfef95601890afd80709"]
#test("abc")["a9993e364706816aba3e25717850c26c9cd0d89d"]
#test("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")["84983e441c3bd26ebaae4aa1f95129e5e54670f1"] // 448 bits
#test("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")["a49b2446a02c645bf419f995b67091253a04a259"] // 896 bits
pub fun sha1_hex(s: str) -> str {
    var h = new_sha1()
    h.update_str(s)
    h.close()
    return h.hex()
}

// ---- SHA-256 and SHA-224 (FIPS 180-4, 6.2 and 6.3)

// SHA-256, or SHA-224 (other initial values, 7 words of output).
pub struct Sha256 {
    blk: Block32,
    a: uint32,
    b: uint32,
    c: uint32,
    d: uint32,
    e: uint32,
    f: uint32,
    g: uint32,
    h: uint32,
    words: int,
}

pub fun new_sha256() -> Sha256 {
    return Sha256 {
        blk: new_block32(true),
        a: 0x6a09e667, b: 0xbb67ae85, c: 0x3c6ef372, d: 0xa54ff53a,
        e: 0x510e527f, f: 0x9b05688c, g: 0x1f83d9ab, h: 0x5be0cd19,
        words: 8,
    }
}

pub fun new_sha224() -> Sha256 {
    return Sha256 {
        blk: new_block32(true),
        a: 0xc1059ed8, b: 0x367cd507, c: 0x3070dd17, d: 0xf70e5939,
