// ---- HMAC (RFC 2104)

// The HMAC of `msg` under `key` with the digest of `d`, a new hasher:
// `hmac(new_sha256(), key, msg)`. A key longer than the digest's block is
// hashed first, as the RFC says.
pub fun hmac<D: Digest>(d: D, key: [uint8], msg: [uint8]) -> [uint8] {
    let size = d.block_size()
    var k = key
    if k.len() > size {
        var kh = d
        kh.update(key)
        k = kh.finish()
    }
    var ipad: [uint8] = []
    var opad: [uint8] = []
    for i in 0..size {
        let b = if i < k.len() { k[i] } else { 0u8 }
        ipad.push(b ^ 0x36u8)
        opad.push(b ^ 0x5cu8)
    }
    var inner = d
    inner.update(ipad)
    inner.update(msg)
    var outer = d
    outer.update(opad)
    outer.update(inner.finish())
    return outer.finish()
}

// HMAC-MD5 (RFC 2202) of `msg` under `key`, 16 bytes.
#test([0x6bu8, 0x65u8, 0x79u8], [0x61u8, 0x62u8, 0x63u8])[[0xd2u8, 0xfeu8, 0x98u8, 0x06u8, 0x3fu8, 0x87u8, 0x6bu8, 0x03u8, 0x19u8, 0x3au8, 0xfbu8, 0x49u8, 0xb4u8, 0x97u8, 0x95u8, 0x91u8]]
pub fun hmac_md5(key: [uint8], msg: [uint8]) -> [uint8] {
    return hmac(new_md5(), key, msg)
}

