        g = g.wrapping_add(sha512_maj(h, a, b))
        f = f.wrapping_add(sha512_s1(c))
        f = f.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0xb5c0fbcfec4d3b2fu64).wrapping_add(w2)
