        w9 = w6 ^ w1 ^ w11 ^ w9; t = w9 >> 31u32; w9 = (w9 << 1u32) | t
        b = b.wrapping_add(d ^ e ^ a).wrapping_add(0xca62c1d6u32).wrapping_add(w9)
        t = c >> 27u32; t = (c << 5u32) | t; b = b.wrapping_add(t)
        t = d >> 2u32; d = (d << 30u32) | t
        w10 = w7 ^ w2 ^ w12 ^ w10; t = w10 >> 31u32; w10 = (w10 << 1u32) | t
        a = a.wrapping_add(c ^ d ^ e).wrapping_add(0xca62c1d6u32).wrapping_add(w10)
        t = b >> 27u32; t = (b << 5u32) | t; a = a.wrapping_add(t)
        t = c >> 2u32; c = (c << 30u32) | t
        w11 = w8 ^ w3 ^ w13 ^ w11; t = w11 >> 31u32; w11 = (w11 << 1u32) | t
        e = e.wrapping_add(b ^ c ^ d).wrapping_add(0xca62c1d6u32).wrapping_add(w11)
        t = a >> 27u32; t = (a << 5u32) | t; e = e.wrapping_add(t)
