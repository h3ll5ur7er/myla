// ---- Tests

// `n` copies of the byte `b`.
fun repeated(b: uint8, n: int) -> [uint8] {
    var out: [uint8] = []
    for i in 0..n {
        out.push(b)
    }
    return out
}

fun check(got: [uint8], want: str, what: str) {
    let hex = enc_m.hex_encode(got)
    assert(hex == want, f"{what}: {hex}, expected {want}")
}

// RFC 2202's test cases 1 to 7.
#test
fun hmac_rfc2202() {
    let k1 = repeated(0x0bu8, 16)
    let hi = bytes_of("Hi There")
    check(hmac_md5(k1, hi), "9294727a3638bb1c13f48ef8158bfc9d", "md5 1")
    check(hmac_sha1(repeated(0x0bu8, 20), hi), "b617318655057264e28bc0b6fb378c8ef146be00", "sha1 1")
    let k3 = repeated(0xaau8, 16)
    let d3 = repeated(0xddu8, 50)
    check(hmac_md5(k3, d3), "56be34521d144c88dbb8c733f0e8b3f6", "md5 3")
    check(hmac_sha1(repeated(0xaau8, 20), d3), "125d7342b9ac11cd91a39af48aa17b4f63f175d3", "sha1 3")
    var k4: [uint8] = []
    for i in 1..26 {
        k4.push(i as uint8)
    }
    let d4 = repeated(0xcdu8, 50)
    check(hmac_md5(k4, d4), "697eaf0aca3a3aea3a75164746ffaa79", "md5 4")
    check(hmac_sha1(k4, d4), "4c9007f4026250c6bc8414f9bf50c86c2d7235da", "sha1 4")
    let big = repeated(0xaau8, 80)
    let long_key = bytes_of("Test Using Larger Than Block-Size Key - Hash Key First")
    check(hmac_md5(big, long_key), "6b1ab7fe4bd7bf8f0b62e6ce61b9d0cd", "md5 6")
    check(hmac_sha1(big, long_key), "aa4ae5e15272d00e95705637ce8a3b55ed402112", "sha1 6")
    let two = bytes_of("Test Using Larger Than Block-Size Key and Larger Than One Block-Size Data")
    check(hmac_md5(big, two), "6f630fad67cda0ee1fb1f562db3aa53e", "md5 7")
    check(hmac_sha1(big, two), "e8e99d0f45237d786d6bbaa7965c7808bbff1a91", "sha1 7")
}

// RFC 4231's test cases 1, 2, 3, 4, 6 and 7 (5 truncates).
#test
fun hmac_rfc4231() {
    let hi = bytes_of("Hi There")
    let k1 = repeated(0x0bu8, 20)
    check(hmac_sha256(k1, hi), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", "256 1")
    check(hmac_sha512(k1, hi), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854", "512 1")
    check(hmac(new_sha224(), k1, hi), "896fb1128abbdf196832107cd49df33f47b4b1169912ba4f53684b22", "224 1")
    check(hmac(new_sha384(), k1, hi), "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6", "384 1")
    let k3 = repeated(0xaau8, 20)
    let d3 = repeated(0xddu8, 50)
    check(hmac_sha256(k3, d3), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe", "256 3")
    check(hmac_sha512(k3, d3), "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb", "512 3")
    var k4: [uint8] = []
    for i in 1..26 {
        k4.push(i as uint8)
    }
    let d4 = repeated(0xcdu8, 50)
    check(hmac_sha256(k4, d4), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b", "256 4")
    check(hmac_sha512(k4, d4), "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd", "512 4")
    let big = repeated(0xaau8, 131)
    let long_key = bytes_of("Test Using Larger Than Block-Size Key - Hash Key First")
    check(hmac_sha256(big, long_key), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", "256 6")
    check(hmac_sha512(big, long_key), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598", "512 6")
    let d7 = bytes_of("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")
    check(hmac_sha256(big, d7), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2", "256 7")
    check(hmac_sha512(big, d7), "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58", "512 7")
}

// Pieces of every size give the one-shot digest, through both `update`s.
#test
fun incremental() {
    var data: [uint8] = []
    var text = StringBuilder()
    for i in 0..300 {
        let b = (32 + (i * 7 + 3) % 95) as uint8
        data.push(b)
        text.append_byte(b)
    }
    let s = text.build()
    let want5 = enc_m.hex_encode(md5(data))
    let want1 = enc_m.hex_encode(sha1(data))
    let want256 = enc_m.hex_encode(sha256(data))
    let want512 = enc_m.hex_encode(sha512(data))
    assert(md5_hex(s) == want5, "md5_hex")
    assert(sha512_hex(s) == want512, "sha512_hex")
    for step in [1, 3, 4, 63, 64, 65, 127, 129] {
        var h5 = new_md5()
        var h1 = new_sha1()
        var h256 = new_sha256()
        var h512 = new_sha512()
        var i = 0
        var odd = false
        while i < data.len() {
            let j = if i + step < data.len() { i + step } else { data.len() }
            if odd {
                h5.update_str(s[i:j])
                h1.update_str(s[i:j])
                h256.update_str(s[i:j])
                h512.update_str(s[i:j])
            } else {
                h5.update(data[i:j])
                h1.update(data[i:j])
                h256.update(data[i:j])
                h512.update(data[i:j])
            }
            odd = !odd
            i = j
        }
        assert(h5.finish_hex() == want5, f"md5 by {step}")
        assert(h1.finish_hex() == want1, f"sha1 by {step}")
        assert(h256.finish_hex() == want256, f"sha256 by {step}")
        assert(h512.finish_hex() == want512, f"sha512 by {step}")
        // finish leaves the hasher as it was
        h5.update(data)
        assert(h5.finish_hex() == md5_hex(s + s), f"md5 after finish by {step}")
    }
    // a copy of a hasher goes on by itself
    var p = new_sha256()
    p.update_str("ab")
    var q = p
    p.update_str("c")
    q.update_str("d")
    assert(p.finish_hex() == sha256_hex("abc"), "copy: the original")
    assert(q.finish_hex() == sha256_hex("abd"), "copy: the copy")
}
