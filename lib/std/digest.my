        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0xe9b5dba58189dbbcu64).wrapping_add(w3)
        a = a.wrapping_add(e)
        e = e.wrapping_add(sha512_s0(f))
        e = e.wrapping_add(sha512_maj(f, g, h))
        d = d.wrapping_add(sha512_s1(a))
        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x3956c25bf348b538u64).wrapping_add(w4)
        h = h.wrapping_add(d)
