// ---- SHA-512 and SHA-384 (FIPS 180-4, 6.4 and 6.5)

// The functions of FIPS 180-4, 4.1.3, that SHA-512's rounds call: Σ0, Σ1,
// σ0 (g0), σ1 (g1) and Maj, a rotation as two shifts.
fun sha512_s0(a: uint64) -> uint64 {
    var r = a << 36u64
    r = (a >> 28u64) | r
    var s = a << 30u64
    s = (a >> 34u64) | s
    r = r ^ s
    s = a << 25u64
    s = (a >> 39u64) | s
    return r ^ s
}

fun sha512_s1(e: uint64) -> uint64 {
    var r = e << 50u64
    r = (e >> 14u64) | r
    var s = e << 46u64
    s = (e >> 18u64) | s
    r = r ^ s
    s = e << 23u64
    s = (e >> 41u64) | s
    return r ^ s
}

fun sha512_g0(w: uint64) -> uint64 {
    var r = w << 63u64
    r = (w >> 1u64) | r
    var s = w << 56u64
    s = (w >> 8u64) | s
    r = r ^ s
    return (w >> 7u64) ^ r
}

fun sha512_g1(w: uint64) -> uint64 {
    var r = w << 45u64
    r = (w >> 19u64) | r
    var s = w << 3u64
    s = (w >> 61u64) | s
    r = r ^ s
    return (w >> 6u64) ^ r
}

fun sha512_maj(a: uint64, b: uint64, c: uint64) -> uint64 {
    var t = a | b
    t = c & t
    return (a & b) | t
}

// SHA-512, or SHA-384 (other initial values, 6 words of output).
pub struct Sha512 {
    blk: Block64,
    a: uint64,
    b: uint64,
    c: uint64,
    d: uint64,
    e: uint64,
    f: uint64,
    g: uint64,
    h: uint64,
    words: int,
}

pub fun new_sha512() -> Sha512 {
    return Sha512 {
        blk: new_block64(),
        a: 0x6a09e667f3bcc908, b: 0xbb67ae8584caa73b, c: 0x3c6ef372fe94f82b, d: 0xa54ff53a5f1d36f1,
        e: 0x510e527fade682d1, f: 0x9b05688c2b3e6c1f, g: 0x1f83d9abfb41bd6b, h: 0x5be0cd19137e2179,
        words: 8,
    }
}

pub fun new_sha384() -> Sha512 {
    return Sha512 {
        blk: new_block64(),
        a: 0xcbbb9d5dc1059ed8, b: 0x629a292a367cd507, c: 0x9159015a3070dd17, d: 0x152fecd8f70e5939,
        e: 0x67332667ffc00b31, f: 0x8eb44a8768581511, g: 0xdb0c2e0d64f98fa7, h: 0x47b5481dbefa4fa4,
        words: 6,
    }
}

impl Sha512 {
    fun update_str(var self, s: str) {
        var i = 0
        while i < s.len() {
            i = self.blk.fill_str(s, i)
            if self.blk.used == 128 {
                self.compress()
                self.blk.used = 0
            }
        }
    }

    #test(new_sha512())["cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"]
    #test(new_sha384())["38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"]
    fun finish_hex(self) -> str {
        var h = self
        h.close()
        return h.hex()
    }

    fun compress(var self) {
        let w = self.blk.w
        var w0 = w[0]
        var w1 = w[1]
        var w2 = w[2]
        var w3 = w[3]
        var w4 = w[4]
        var w5 = w[5]
        var w6 = w[6]
        var w7 = w[7]
        var w8 = w[8]
        var w9 = w[9]
        var w10 = w[10]
        var w11 = w[11]
        var w12 = w[12]
        var w13 = w[13]
        var w14 = w[14]
        var w15 = w[15]
        var a = self.a
        var b = self.b
        var c = self.c
        var d = self.d
        var e = self.e
        var f = self.f
        var g = self.g
        var h = self.h
        // SHA-256's rounds, with SHA-512's functions
        h = h.wrapping_add(sha512_s1(e))
        h = h.wrapping_add(g ^ (e & (f ^ g))).wrapping_add(0x428a2f98d728ae22u64).wrapping_add(w0)
        d = d.wrapping_add(h)
        h = h.wrapping_add(sha512_s0(a))
        h = h.wrapping_add(sha512_maj(a, b, c))
        g = g.wrapping_add(sha512_s1(d))
        g = g.wrapping_add(f ^ (d & (e ^ f))).wrapping_add(0x7137449123ef65cdu64).wrapping_add(w1)
        c = c.wrapping_add(g)
