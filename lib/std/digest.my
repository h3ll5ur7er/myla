    fun close(var self) {
        if self.blk.pad() {
            self.compress()
            self.blk.clear()
        }
        self.blk.put_length()
        self.compress()
    }

    fun bytes(self) -> [uint8] {
        return be_bytes([self.a, self.b, self.c, self.d, self.e, self.f, self.g, self.h], self.words)
    }

    fun hex(self) -> str {
        var x = new_hex()
        x.be32(self.a)
        x.be32(self.b)
        x.be32(self.c)
        x.be32(self.d)
        x.be32(self.e)
        x.be32(self.f)
        x.be32(self.g)
        if self.words == 8 {
            x.be32(self.h)
        }
        return x.sb.build()
    }
}

impl Digest for Sha256 {
    fun update(var self, data: [uint8]) {
        var i = 0
        while i < data.len() {
            i = self.blk.fill(data, i)
            if self.blk.used == 64 {
                self.compress()
                self.blk.used = 0
            }
        }
    }

    #test(new_sha256())[[0xe3u8, 0xb0u8, 0xc4u8, 0x42u8, 0x98u8, 0xfcu8, 0x1cu8, 0x14u8, 0x9au8, 0xfbu8, 0xf4u8, 0xc8u8, 0x99u8, 0x6fu8, 0xb9u8, 0x24u8, 0x27u8, 0xaeu8, 0x41u8, 0xe4u8, 0x64u8, 0x9bu8, 0x93u8, 0x4cu8, 0xa4u8, 0x95u8, 0x99u8, 0x1bu8, 0x78u8, 0x52u8, 0xb8u8, 0x55u8]]
    #test(new_sha224())[[0xd1u8, 0x4au8, 0x02u8, 0x8cu8, 0x2au8, 0x3au8, 0x2bu8, 0xc9u8, 0x47u8, 0x61u8, 0x02u8, 0xbbu8, 0x28u8, 0x82u8, 0x34u8, 0xc4u8, 0x15u8, 0xa2u8, 0xb0u8, 0x1fu8, 0x82u8, 0x8eu8, 0xa6u8, 0x2au8, 0xc5u8, 0xb3u8, 0xe4u8, 0x2fu8]]
    fun finish(self) -> [uint8] {
        var h = self
        h.close()
        return h.bytes()
    }

    #test(new_sha256())[64]
    fun block_size(self) -> int {
        return 64
    }
}

// The SHA-256 digest of `data`, 32 bytes.
#test([97u8, 98u8, 99u8])[[0xbau8, 0x78u8, 0x16u8, 0xbfu8, 0x8fu8, 0x01u8, 0xcfu8, 0xeau8, 0x41u8, 0x41u8, 0x40u8, 0xdeu8, 0x5du8, 0xaeu8, 0x22u8, 0x23u8, 0xb0u8, 0x03u8, 0x61u8, 0xa3u8, 0x96u8, 0x17u8, 0x7au8, 0x9cu8, 0xb4u8, 0x10u8, 0xffu8, 0x61u8, 0xf2u8, 0x00u8, 0x15u8, 0xadu8]]
pub fun sha256(data: [uint8]) -> [uint8] {
    var h = new_sha256()
    h.update(data)
    h.close()
    return h.bytes()
}

#test("")["e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"]
