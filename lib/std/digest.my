        a = a.wrapping_add(h ^ (f & (g ^ h))).wrapping_add(0x1b710b35131c471bu64).wrapping_add(w7)
        e = e.wrapping_add(a)
        a = a.wrapping_add(sha512_s0(b))
        a = a.wrapping_add(sha512_maj(b, c, d))
        w8 = w8.wrapping_add(sha512_g1(w6))
        w8 = w8.wrapping_add(w1)
        w8 = w8.wrapping_add(sha512_g0(w9))
        h = h.wrapping_add(sha512_s1(e))
        h = h.wrapping_add(g ^ (e & (f ^ g))).wrapping_add(0x28db77f523047d84u64).wrapping_add(w8)
        d = d.wrapping_add(h)
        h = h.wrapping_add(sha512_s0(a))
        h = h.wrapping_add(sha512_maj(a, b, c))
        w9 = w9.wrapping_add(sha512_g1(w7))
        w9 = w9.wrapping_add(w2)
        w9 = w9.wrapping_add(sha512_g0(w10))
        g = g.wrapping_add(sha512_s1(d))
        g = g.wrapping_add(f ^ (d & (e ^ f))).wrapping_add(0x32caab7b40c72493u64).wrapping_add(w9)
        c = c.wrapping_add(g)
        g = g.wrapping_add(sha512_s0(h))
        g = g.wrapping_add(sha512_maj(h, a, b))
        w10 = w10.wrapping_add(sha512_g1(w8))
        w10 = w10.wrapping_add(w3)
        w10 = w10.wrapping_add(sha512_g0(w11))
        f = f.wrapping_add(sha512_s1(c))
        f = f.wrapping_add(e ^ (c & (d ^ e))).wrapping_add(0x3c9ebe0a15c9bebcu64).wrapping_add(w10)
        b = b.wrapping_add(f)
        f = f.wrapping_add(sha512_s0(g))
        f = f.wrapping_add(sha512_maj(g, h, a))
        w11 = w11.wrapping_add(sha512_g1(w9))
        w11 = w11.wrapping_add(w4)
        w11 = w11.wrapping_add(sha512_g0(w12))
        e = e.wrapping_add(sha512_s1(b))
        e = e.wrapping_add(d ^ (b & (c ^ d))).wrapping_add(0x431d67c49c100d4cu64).wrapping_add(w11)
        a = a.wrapping_add(e)
        e = e.wrapping_add(sha512_s0(f))
        e = e.wrapping_add(sha512_maj(f, g, h))
        w12 = w12.wrapping_add(sha512_g1(w10))
        w12 = w12.wrapping_add(w5)
        w12 = w12.wrapping_add(sha512_g0(w13))
        d = d.wrapping_add(sha512_s1(a))
        d = d.wrapping_add(c ^ (a & (b ^ c))).wrapping_add(0x4cc5d4becb3e42b6u64).wrapping_add(w12)
        h = h.wrapping_add(d)
        d = d.wrapping_add(sha512_s0(e))
        d = d.wrapping_add(sha512_maj(e, f, g))
        w13 = w13.wrapping_add(sha512_g1(w11))
        w13 = w13.wrapping_add(w6)
        w13 = w13.wrapping_add(sha512_g0(w14))
        c = c.wrapping_add(sha512_s1(h))
        c = c.wrapping_add(b ^ (h & (a ^ b))).wrapping_add(0x597f299cfc657e2au64).wrapping_add(w13)
        g = g.wrapping_add(c)
        c = c.wrapping_add(sha512_s0(d))
        c = c.wrapping_add(sha512_maj(d, e, f))
        w14 = w14.wrapping_add(sha512_g1(w12))
        w14 = w14.wrapping_add(w7)
        w14 = w14.wrapping_add(sha512_g0(w15))
        b = b.wrapping_add(sha512_s1(g))
        b = b.wrapping_add(a ^ (g & (h ^ a))).wrapping_add(0x5fcb6fab3ad6faecu64).wrapping_add(w14)
        f = f.wrapping_add(b)
        b = b.wrapping_add(sha512_s0(c))
        b = b.wrapping_add(sha512_maj(c, d, e))
        w15 = w15.wrapping_add(sha512_g1(w13))
        w15 = w15.wrapping_add(w8)
        w15 = w15.wrapping_add(sha512_g0(w0))
        a = a.wrapping_add(sha512_s1(f))
        a = a.wrapping_add(h ^ (f & (g ^ h))).wrapping_add(0x6c44198c4a475817u64).wrapping_add(w15)
        e = e.wrapping_add(a)
        a = a.wrapping_add(sha512_s0(b))
        a = a.wrapping_add(sha512_maj(b, c, d))
        self.a = self.a.wrapping_add(a)
        self.b = self.b.wrapping_add(b)
        self.c = self.c.wrapping_add(c)
        self.d = self.d.wrapping_add(d)
        self.e = self.e.wrapping_add(e)
        self.f = self.f.wrapping_add(f)
        self.g = self.g.wrapping_add(g)
        self.h = self.h.wrapping_add(h)
    }

    fun close(var self) {
        if self.blk.pad() {
            self.compress()
            self.blk.clear()
        }
        self.blk.put_length()
        self.compress()
    }

    fun bytes(self) -> [uint8] {
        return be_bytes64([self.a, self.b, self.c, self.d, self.e, self.f, self.g, self.h], self.words)
    }

    fun hex(self) -> str {
        var x = new_hex()
        x.be64(self.a)
        x.be64(self.b)
        x.be64(self.c)
        x.be64(self.d)
        x.be64(self.e)
        x.be64(self.f)
        if self.words == 8 {
            x.be64(self.g)
            x.be64(self.h)
        }
        return x.sb.build()
    }
}

impl Digest for Sha512 {
    fun update(var self, data: [uint8]) {
        var i = 0
        while i < data.len() {
            i = self.blk.fill(data, i)
            if self.blk.used == 128 {
                self.compress()
                self.blk.used = 0
            }
        }
    }

    #test(new_sha512())[[0xcfu8, 0x83u8, 0xe1u8, 0x35u8, 0x7eu8, 0xefu8, 0xb8u8, 0xbdu8, 0xf1u8, 0x54u8, 0x28u8, 0x50u8, 0xd6u8, 0x6du8, 0x80u8, 0x07u8, 0xd6u8, 0x20u8, 0xe4u8, 0x05u8, 0x0bu8, 0x57u8, 0x15u8, 0xdcu8, 0x83u8, 0xf4u8, 0xa9u8, 0x21u8, 0xd3u8, 0x6cu8, 0xe9u8, 0xceu8, 0x47u8, 0xd0u8, 0xd1u8, 0x3cu8, 0x5du8, 0x85u8, 0xf2u8, 0xb0u8, 0xffu8, 0x83u8, 0x18u8, 0xd2u8, 0x87u8, 0x7eu8, 0xecu8, 0x2fu8, 0x63u8, 0xb9u8, 0x31u8, 0xbdu8, 0x47u8, 0x41u8, 0x7au8, 0x81u8, 0xa5u8, 0x38u8, 0x32u8, 0x7au8, 0xf9u8, 0x27u8, 0xdau8, 0x3eu8]]
    #test(new_sha384())[[0x38u8, 0xb0u8, 0x60u8, 0xa7u8, 0x51u8, 0xacu8, 0x96u8, 0x38u8, 0x4cu8, 0xd9u8, 0x32u8, 0x7eu8, 0xb1u8, 0xb1u8, 0xe3u8, 0x6au8, 0x21u8, 0xfdu8, 0xb7u8, 0x11u8, 0x14u8, 0xbeu8, 0x07u8, 0x43u8, 0x4cu8, 0x0cu8, 0xc7u8, 0xbfu8, 0x63u8, 0xf6u8, 0xe1u8, 0xdau8, 0x27u8, 0x4eu8, 0xdeu8, 0xbfu8, 0xe7u8, 0x6fu8, 0x65u8, 0xfbu8, 0xd5u8, 0x1au8, 0xd2u8, 0xf1u8, 0x48u8, 0x98u8, 0xb9u8, 0x5bu8]]
    fun finish(self) -> [uint8] {
        var h = self
        h.close()
        return h.bytes()
    }

    #test(new_sha512())[128]
    fun block_size(self) -> int {
        return 128
    }
}

