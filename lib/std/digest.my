impl Sha256 {
    fun update_str(var self, s: str) {
        var i = 0
        while i < s.len() {
            i = self.blk.fill_str(s, i)
            if self.blk.used == 64 {
                self.compress()
                self.blk.used = 0
            }
        }
    }

    #test(new_sha256())["e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"]
    #test(new_sha224())["d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f"]
