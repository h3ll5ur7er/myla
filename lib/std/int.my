// std.int: methods on every integer width (MYLA-322, D164).
//
// GENERATED by scripts/gen_std_int.py: change that and run it, don't edit this
// file. Each width, int8 to int64 and uint8 to uint64, has its own `impl` with
// the same methods (`int` is `int32`); the cases are computed by the
// generator's exact integers.
//
// - `abs` and `signum` (signed widths), `min`, `max`, `clamp`, `pow`, `gcd`,
//   `lcm`, `div_euclid` and `rem_euclid` (never negative);
// - `count_ones`, `leading_zeros` and `trailing_zeros`, of the bits;
// - `checked_*` (an `Option`), `wrapping_*`, `saturating_*` and
//   `overflowing_*` (the result and whether it overflowed) of add, sub, mul and
//   pow, `checked_div`, `checked_rem`, `checked_neg`, `checked_abs`,
//   `wrapping_neg` and `overflowing_neg`;
// - `mulmod`, `powmod` and `modinv`, computed without overflow at every width.
//
// The plain methods (`pow`, `abs`, `lcm`) overflow as the operators do,
// wrapping today (D4). The `wrapping_*` methods are the one place that relies on
// the operators wrapping: if MYLA-311 makes them trap, those methods change and
// the rest stays, since the checked, saturating and overflowing ones decide
// overflow before they compute, by comparisons that can't overflow.
//
// Imported into every program by MYLA-320; until then, `import std.int`.
// It imports nothing.


impl int8 {
    // The absolute value. The minimum has none that fits: its `abs` is the
    // minimum again, as `-` wraps it (`checked_abs` says so).
    #test(5i8)[5]
    #test(-5i8)[5]
    #test(0i8)[0]
    #test(127i8)[127]
    #test(-128i8)[-128] // MIN, which wraps
    #test(-127i8)[127]
    fun abs(self) -> int8 {
        return if self < 0 { -self } else { self }
    }

    // -1, 0 or 1, the sign of the number.
    #test(5i8)[1]
    #test(-5i8)[-1]
    #test(0i8)[0]
    #test(127i8)[1]
    #test(-128i8)[-1]
    #test(-127i8)[-1]
    fun signum(self) -> int8 {
        return if self > 0 { 1 } else if self < 0 { -1 } else { 0 }
    }

    // The smaller of the two.
    #test(3i8, 4)[3]
    #test(4i8, 3)[3]
    #test(-3i8, 2)[-3]
    #test(-128i8, 127)[-128]
    #test(5i8, 5)[5]
    fun min(self, other: int8) -> int8 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3i8, 4)[4]
    #test(4i8, 3)[4]
    #test(-3i8, 2)[2]
    #test(-128i8, 127)[127]
    #test(5i8, 5)[5]
    fun max(self, other: int8) -> int8 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5i8, 0, 10)[5]
    #test(-5i8, 0, 10)[0]
    #test(15i8, 0, 10)[10]
    #test(0i8, 0, 0)[0]
    #test(127i8, -128, 3)[3]
    #test(7i8, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: int8, hi: int8) -> int8 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3i8, 4)[81]
    #test(2i8, 0)[1]
    #test(0i8, 0)[1]
    #test(0i8, 3)[0]
    #test(-2i8, 3)[-8]
    #test(-1i8, 7)[-1]
    #test(2i8, 6)[64]
    #test(2i8, 7)[-128] // wraps
    #test(3i8, 40)[33] // wraps
    #test(-2i8, 7)[-128]
    fun pow(self, exp: uint32) -> int8 {
        var base = self
        var e = exp
        var acc: int8 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor, never negative but for a result of 2^(bits - 1),
    // which wraps to the minimum (`MIN.gcd(0)`); `0.gcd(0)` is 0.
    #test(12i8, 18)[6]
    #test(-12i8, 18)[6]
    #test(12i8, -18)[6]
    #test(0i8, 5)[5]
    #test(0i8, 0)[0]
    #test(17i8, 5)[1]
    #test(127i8, 126)[1]
    #test(-128i8, -64)[64]
    fun gcd(self, other: int8) -> int8 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a.abs()
    }

    // The least common multiple, never negative; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4i8, 6)[12]
    #test(-4i8, 6)[12]
    #test(0i8, 6)[0]
    #test(21i8, 6)[42]
    #test(127i8, 1)[127]
    fun lcm(self, other: int8) -> int8 {
        if self == 0 || other == 0 {
            return 0
        }
        return (self / self.gcd(other) * other).abs()
    }

    // The quotient of Euclidean division: the `q` with `self == q * other + r`
    // and `0 <= r < |other|`. Division by zero is a runtime error; `MIN.div_euclid(-1)`
    // wraps to `MIN`, as `/` does.
    #test(7i8, 3)[2]
    #test(-7i8, 3)[-3]
    #test(7i8, -3)[-2]
    #test(-7i8, -3)[3]
    #test(6i8, 3)[2]
    #test(-6i8, 3)[-2]
    #test(-128i8, -1)[-128] // wraps, as / does
    #test(-127i8, -128)[1]
    #test(127i8, 10)[12]
    fun div_euclid(self, other: int8) -> int8 {
        let q = self / other
        if self % other < 0 {
            return if other > 0 { q - 1 } else { q + 1 }
        }
        return q
    }

    // The remainder of Euclidean division, never negative: from 0 to
    // `|other| - 1`. Division by zero is a runtime error.
    #test(7i8, 3)[1]
    #test(-7i8, 3)[2]
    #test(7i8, -3)[1]
    #test(-7i8, -3)[2]
    #test(6i8, 3)[0]
    #test(-6i8, 3)[0]
    #test(-128i8, -1)[0]
    #test(-127i8, -128)[1]
    #test(127i8, 10)[7]
    fun rem_euclid(self, other: int8) -> int8 {
        let r = self % other
        if r < 0 {
            return if other < 0 { r - other } else { r + other }
        }
        return r
    }

    // The number of bits set (a negative number's are its two's complement's).
    #test(0i8)[0]
    #test(1i8)[1]
    #test(2i8)[1]
    #test(80i8)[2]
    #test(64i8)[1]
    #test(127i8)[7] // MAX
    #test(-128i8)[1] // MIN
    #test(-1i8)[8]
    #test(126i8)[6] // MAX - 1
    #test(85i8)[4]
    fun count_ones(self) -> int {
        let v: uint64 = (self as uint64) & 0xFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 8 for 0, 0 for a
    // negative number.
    #test(0i8)[8]
    #test(1i8)[7]
    #test(2i8)[6]
    #test(80i8)[1]
    #test(64i8)[1]
    #test(127i8)[1] // MAX
    #test(-128i8)[0] // MIN
    #test(-1i8)[0]
    #test(126i8)[1] // MAX - 1
    #test(85i8)[1]
    fun leading_zeros(self) -> int {
        var x: uint64 = (self as uint64) & 0xFF
        if x == 0 {
            return 8
        }
        var n = 7
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 8 for 0.
    #test(0i8)[8]
    #test(1i8)[0]
    #test(2i8)[1]
    #test(80i8)[4]
    #test(64i8)[6]
    #test(127i8)[0] // MAX
    #test(-128i8)[7] // MIN
    #test(-1i8)[0]
    #test(126i8)[1] // MAX - 1
    #test(85i8)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = (self as uint64) & 0xFF
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1) & 0xFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2i8, 3)[Some(5)]
    #test(-7i8, 3)[Some(-4)]
    #test(127i8, 1)[None] // MAX + 1
    #test(126i8, 1)[Some(127)] // MAX - 1 + 1
    #test(127i8, 127)[None] // MAX + MAX
    #test(-128i8, -1)[None] // MIN + -1
    #test(-128i8, 127)[Some(-1)] // MIN + MAX
    #test(-127i8, -1)[Some(-128)] // MIN + 1 + -1
    fun checked_add(self, other: int8) -> Option<int8> {
        return if add_overflows_i8(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5i8, 3)[Some(2)]
    #test(3i8, 5)[Some(-2)]
    #test(-128i8, 1)[None] // MIN - 1
    #test(-127i8, 1)[Some(-128)] // MIN + 1 - 1
    #test(127i8, -1)[None] // MAX - -1
    #test(0i8, -128)[None] // 0 - MIN
    #test(-1i8, -128)[Some(127)] // -1 - MIN
    #test(127i8, 127)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: int8) -> Option<int8> {
        return if sub_overflows_i8(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6i8, 7)[Some(42)]
    #test(-6i8, 7)[Some(-42)]
    #test(127i8, 2)[None] // MAX * 2
    #test(63i8, 2)[Some(126)]
    #test(-128i8, -1)[None] // MIN * -1
    #test(-128i8, 1)[Some(-128)] // MIN * 1
    #test(-64i8, 2)[Some(-128)]
    #test(127i8, -1)[Some(-127)] // MAX * -1
    #test(0i8, 127)[Some(0)] // 0 * MAX
    #test(127i8, 127)[None] // MAX * MAX
    fun checked_mul(self, other: int8) -> Option<int8> {
        return if mul_overflows_i8(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i8, 2)[Some(3)]
    #test(-7i8, 2)[Some(-3)]
    #test(7i8, 0)[None]
    #test(-128i8, -1)[None] // MIN / -1
    #test(127i8, 127)[Some(1)] // MAX / MAX
    fun checked_div(self, other: int8) -> Option<int8> {
        return if other == 0 || (self == MIN_I8 && other == -1) { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i8, 2)[Some(1)]
    #test(-7i8, 2)[Some(-1)]
    #test(7i8, 0)[None]
    #test(-128i8, -1)[None] // MIN % -1
    #test(127i8, 127)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: int8) -> Option<int8> {
        return if other == 0 || (self == MIN_I8 && other == -1) { None } else { Some(self % other) }
    }

    // `-self`, or `None` for the minimum.
    #test(5i8)[Some(-5)]
    #test(-5i8)[Some(5)]
    #test(0i8)[Some(0)]
    #test(127i8)[Some(-127)]
    #test(-128i8)[None]
    #test(-127i8)[Some(127)]
    fun checked_neg(self) -> Option<int8> {
        return if self == MIN_I8 { None } else { Some(-self) }
    }

    // The absolute value, or `None` for the minimum.
    #test(5i8)[Some(5)]
    #test(-5i8)[Some(5)]
    #test(0i8)[Some(0)]
    #test(127i8)[Some(127)]
    #test(-128i8)[None]
    #test(-127i8)[Some(127)]
    fun checked_abs(self) -> Option<int8> {
        return if self == MIN_I8 { None } else { Some(self.abs()) }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3i8, 4)[Some(81)]
    #test(2i8, 0)[Some(1)]
    #test(0i8, 0)[Some(1)]
    #test(0i8, 3)[Some(0)]
    #test(-2i8, 3)[Some(-8)]
    #test(-1i8, 7)[Some(-1)]
    #test(2i8, 6)[Some(64)]
    #test(2i8, 7)[None]
    #test(3i8, 40)[None]
    #test(-2i8, 7)[Some(-128)]
    fun checked_pow(self, exp: uint32) -> Option<int8> {
        var base = self
        var e = exp
        var acc: int8 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^8.
    #test(3i8, 4)[81]
    #test(2i8, 0)[1]
    #test(0i8, 0)[1]
    #test(0i8, 3)[0]
    #test(-2i8, 3)[-8]
    #test(-1i8, 7)[-1]
    #test(2i8, 6)[64]
    #test(2i8, 7)[-128] // wraps
    #test(3i8, 40)[33] // wraps
    #test(-2i8, 7)[-128]
    fun wrapping_pow(self, exp: uint32) -> int8 {
        var base = self
        var e = exp
        var acc: int8 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2i8, 3)[5]
    #test(-7i8, 3)[-4]
    #test(127i8, 1)[127] // MAX + 1
    #test(126i8, 1)[127] // MAX - 1 + 1
    #test(127i8, 127)[127] // MAX + MAX
    #test(-128i8, -1)[-128] // MIN + -1
    #test(-128i8, 127)[-1] // MIN + MAX
    #test(-127i8, -1)[-128] // MIN + 1 + -1
    fun saturating_add(self, other: int8) -> int8 {
        if add_overflows_i8(self, other) {
            return if other > 0 { MAX_I8 } else { MIN_I8 }
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5i8, 3)[2]
    #test(3i8, 5)[-2]
    #test(-128i8, 1)[-128] // MIN - 1
    #test(-127i8, 1)[-128] // MIN + 1 - 1
    #test(127i8, -1)[127] // MAX - -1
    #test(0i8, -128)[127] // 0 - MIN
    #test(-1i8, -128)[127] // -1 - MIN
    #test(127i8, 127)[0] // MAX - MAX
    fun saturating_sub(self, other: int8) -> int8 {
        if sub_overflows_i8(self, other) {
            return if other < 0 { MAX_I8 } else { MIN_I8 }
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6i8, 7)[42]
    #test(-6i8, 7)[-42]
    #test(127i8, 2)[127] // MAX * 2
    #test(63i8, 2)[126]
    #test(-128i8, -1)[127] // MIN * -1
    #test(-128i8, 1)[-128] // MIN * 1
    #test(-64i8, 2)[-128]
    #test(127i8, -1)[-127] // MAX * -1
    #test(0i8, 127)[0] // 0 * MAX
    #test(127i8, 127)[127] // MAX * MAX
    fun saturating_mul(self, other: int8) -> int8 {
        if mul_overflows_i8(self, other) {
            return if (self < 0) == (other < 0) { MAX_I8 } else { MIN_I8 }
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3i8, 4)[81]
    #test(2i8, 0)[1]
    #test(0i8, 0)[1]
    #test(0i8, 3)[0]
    #test(-2i8, 3)[-8]
    #test(-1i8, 7)[-1]
    #test(2i8, 6)[64]
    #test(2i8, 7)[127]
    #test(3i8, 40)[127]
    #test(-2i8, 7)[-128]
    fun saturating_pow(self, exp: uint32) -> int8 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => if self < 0 && (exp & 1) == 1 { MIN_I8 } else { MAX_I8 }
        }
    }

    // `self + other` modulo 2^8, and whether it didn't fit.
    #test(2i8, 3)[(5, false)]
    #test(-7i8, 3)[(-4, false)]
    #test(127i8, 1)[(-128, true)] // MAX + 1
    #test(126i8, 1)[(127, false)] // MAX - 1 + 1
    #test(127i8, 127)[(-2, true)] // MAX + MAX
    #test(-128i8, -1)[(127, true)] // MIN + -1
    #test(-128i8, 127)[(-1, false)] // MIN + MAX
    #test(-127i8, -1)[(-128, false)] // MIN + 1 + -1
    fun overflowing_add(self, other: int8) -> (int8, bool) {
        return (self + other, add_overflows_i8(self, other))
    }

    // `self - other` modulo 2^8, and whether it didn't fit.
    #test(5i8, 3)[(2, false)]
    #test(3i8, 5)[(-2, false)]
    #test(-128i8, 1)[(127, true)] // MIN - 1
    #test(-127i8, 1)[(-128, false)] // MIN + 1 - 1
    #test(127i8, -1)[(-128, true)] // MAX - -1
    #test(0i8, -128)[(-128, true)] // 0 - MIN
    #test(-1i8, -128)[(127, false)] // -1 - MIN
    #test(127i8, 127)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: int8) -> (int8, bool) {
        return (self - other, sub_overflows_i8(self, other))
    }

    // `self * other` modulo 2^8, and whether it didn't fit.
    #test(6i8, 7)[(42, false)]
    #test(-6i8, 7)[(-42, false)]
    #test(127i8, 2)[(-2, true)] // MAX * 2
    #test(63i8, 2)[(126, false)]
    #test(-128i8, -1)[(-128, true)] // MIN * -1
    #test(-128i8, 1)[(-128, false)] // MIN * 1
    #test(-64i8, 2)[(-128, false)]
    #test(127i8, -1)[(-127, false)] // MAX * -1
    #test(0i8, 127)[(0, false)] // 0 * MAX
    #test(127i8, 127)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: int8) -> (int8, bool) {
        return (self * other, mul_overflows_i8(self, other))
    }

    // `-self` modulo 2^8, and whether it didn't fit.
    #test(5i8)[(-5, false)]
    #test(-5i8)[(5, false)]
    #test(0i8)[(0, false)]
    #test(127i8)[(-127, false)]
    #test(-128i8)[(-128, true)]
    #test(-127i8)[(127, false)]
    fun overflowing_neg(self) -> (int8, bool) {
        return (0 - self, self == MIN_I8)
    }

    // The number to the power `exp` modulo 2^8, and whether it didn't fit.
    #test(3i8, 4)[(81, false)]
    #test(2i8, 0)[(1, false)]
    #test(0i8, 0)[(1, false)]
    #test(0i8, 3)[(0, false)]
    #test(-2i8, 3)[(-8, false)]
    #test(-1i8, 7)[(-1, false)]
    #test(2i8, 6)[(64, false)]
    #test(2i8, 7)[(-128, true)]
    #test(3i8, 40)[(33, true)]
    #test(-2i8, 7)[(-128, false)]
    fun overflowing_pow(self, exp: uint32) -> (int8, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7i8, 8, 5)[1]
    #test(-7i8, 8, 5)[4]
    #test(7i8, -8, 5)[4]
    #test(127i8, 127, 126)[1] // MAX, MAX, MAX - 1
    #test(127i8, 127, 127)[0] // MAX, MAX, MAX
    #test(126i8, 125, 127)[2] // MAX - 1, 125, MAX
    #test(-128i8, -128, 127)[1] // MIN, MIN, MAX
    #test(3i8, 4, 1)[0]
    #test(3i8, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    #test(3i8, 4, -5)[panic("mulmod: the modulus must be positive, not -5")]
    fun mulmod(self, other: int8, m: int8) -> int8 {
        if m <= 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        return ((self as int64) * (other as int64)).rem_euclid(m as int64) as int8
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive and `exp` not negative.
    #test(3i8, 0, 7)[1]
    #test(3i8, 0, 1)[0]
    #test(-2i8, 3, 7)[6]
    #test(0i8, 0, 5)[1]
    #test(2i8, 126, 127)[1] // 2, MAX - 1, MAX
    #test(127i8, 127, 127)[0] // MAX, MAX, MAX
    #test(126i8, 3, 127)[126] // MAX - 1, 3, MAX
    #test(5i8, 0, 127)[1] // 5, 0, MAX
    #test(2i8, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    #test(2i8, -1, 7)[panic("powmod: the exponent must not be negative, not -1")]
    fun powmod(self, exp: int8, m: int8) -> int8 {
        if m <= 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        if exp < 0 {
            panic(f"powmod: the exponent must not be negative, not {exp}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: int8 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3i8, 7)[Some(5)]
    #test(-3i8, 7)[Some(2)]
    #test(4i8, 8)[None]
    #test(0i8, 7)[None]
    #test(5i8, 1)[Some(0)]
    #test(10i8, 17)[Some(12)]
    #test(127i8, 127)[None] // MAX mod MAX
    #test(2i8, 127)[Some(64)] // 2 mod MAX
    #test(3i8, 0)[panic("modinv: the modulus must be positive, not 0")]
    #test(3i8, -7)[panic("modinv: the modulus must be positive, not -7")]
    fun modinv(self, m: int8) -> Option<int8> {
        if m <= 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: int8 = 0
        var t1: int8 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

impl int16 {
    // The absolute value. The minimum has none that fits: its `abs` is the
    // minimum again, as `-` wraps it (`checked_abs` says so).
    #test(5i16)[5]
    #test(-5i16)[5]
    #test(0i16)[0]
    #test(32767i16)[32767]
    #test(-32768i16)[-32768] // MIN, which wraps
    #test(-32767i16)[32767]
    fun abs(self) -> int16 {
        return if self < 0 { -self } else { self }
    }

    // -1, 0 or 1, the sign of the number.
    #test(5i16)[1]
    #test(-5i16)[-1]
    #test(0i16)[0]
    #test(32767i16)[1]
    #test(-32768i16)[-1]
    #test(-32767i16)[-1]
    fun signum(self) -> int16 {
        return if self > 0 { 1 } else if self < 0 { -1 } else { 0 }
    }

    // The smaller of the two.
    #test(3i16, 4)[3]
    #test(4i16, 3)[3]
    #test(-3i16, 2)[-3]
    #test(-32768i16, 32767)[-32768]
    #test(5i16, 5)[5]
    fun min(self, other: int16) -> int16 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3i16, 4)[4]
    #test(4i16, 3)[4]
    #test(-3i16, 2)[2]
    #test(-32768i16, 32767)[32767]
    #test(5i16, 5)[5]
    fun max(self, other: int16) -> int16 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5i16, 0, 10)[5]
    #test(-5i16, 0, 10)[0]
    #test(15i16, 0, 10)[10]
    #test(0i16, 0, 0)[0]
    #test(32767i16, -32768, 3)[3]
    #test(7i16, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: int16, hi: int16) -> int16 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3i16, 4)[81]
    #test(2i16, 0)[1]
    #test(0i16, 0)[1]
    #test(0i16, 3)[0]
    #test(-2i16, 3)[-8]
    #test(-1i16, 7)[-1]
    #test(2i16, 14)[16384]
    #test(2i16, 15)[-32768] // wraps
    #test(3i16, 40)[-6111] // wraps
    #test(-2i16, 15)[-32768]
    fun pow(self, exp: uint32) -> int16 {
        var base = self
        var e = exp
        var acc: int16 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor, never negative but for a result of 2^(bits - 1),
    // which wraps to the minimum (`MIN.gcd(0)`); `0.gcd(0)` is 0.
    #test(12i16, 18)[6]
    #test(-12i16, 18)[6]
    #test(12i16, -18)[6]
    #test(0i16, 5)[5]
    #test(0i16, 0)[0]
    #test(17i16, 5)[1]
    #test(32767i16, 32766)[1]
    #test(-32768i16, -16384)[16384]
    fun gcd(self, other: int16) -> int16 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a.abs()
    }

    // The least common multiple, never negative; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4i16, 6)[12]
    #test(-4i16, 6)[12]
    #test(0i16, 6)[0]
    #test(21i16, 6)[42]
    #test(32767i16, 1)[32767]
    fun lcm(self, other: int16) -> int16 {
        if self == 0 || other == 0 {
            return 0
        }
        return (self / self.gcd(other) * other).abs()
    }

    // The quotient of Euclidean division: the `q` with `self == q * other + r`
    // and `0 <= r < |other|`. Division by zero is a runtime error; `MIN.div_euclid(-1)`
    // wraps to `MIN`, as `/` does.
    #test(7i16, 3)[2]
    #test(-7i16, 3)[-3]
    #test(7i16, -3)[-2]
    #test(-7i16, -3)[3]
    #test(6i16, 3)[2]
    #test(-6i16, 3)[-2]
    #test(-32768i16, -1)[-32768] // wraps, as / does
    #test(-32767i16, -32768)[1]
    #test(32767i16, 10)[3276]
    fun div_euclid(self, other: int16) -> int16 {
        let q = self / other
        if self % other < 0 {
            return if other > 0 { q - 1 } else { q + 1 }
        }
        return q
    }

    // The remainder of Euclidean division, never negative: from 0 to
    // `|other| - 1`. Division by zero is a runtime error.
    #test(7i16, 3)[1]
    #test(-7i16, 3)[2]
    #test(7i16, -3)[1]
    #test(-7i16, -3)[2]
    #test(6i16, 3)[0]
    #test(-6i16, 3)[0]
    #test(-32768i16, -1)[0]
    #test(-32767i16, -32768)[1]
    #test(32767i16, 10)[7]
    fun rem_euclid(self, other: int16) -> int16 {
        let r = self % other
        if r < 0 {
            return if other < 0 { r - other } else { r + other }
        }
        return r
    }

    // The number of bits set (a negative number's are its two's complement's).
    #test(0i16)[0]
    #test(1i16)[1]
    #test(2i16)[1]
    #test(80i16)[2]
    #test(16384i16)[1]
    #test(32767i16)[15] // MAX
    #test(-32768i16)[1] // MIN
    #test(-1i16)[16]
    #test(32766i16)[14] // MAX - 1
    #test(21845i16)[8]
    fun count_ones(self) -> int {
        let v: uint64 = (self as uint64) & 0xFFFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 16 for 0, 0 for a
    // negative number.
    #test(0i16)[16]
    #test(1i16)[15]
    #test(2i16)[14]
    #test(80i16)[9]
    #test(16384i16)[1]
    #test(32767i16)[1] // MAX
    #test(-32768i16)[0] // MIN
    #test(-1i16)[0]
    #test(32766i16)[1] // MAX - 1
    #test(21845i16)[1]
    fun leading_zeros(self) -> int {
        var x: uint64 = (self as uint64) & 0xFFFF
        if x == 0 {
            return 16
        }
        var n = 15
        if x >> 8 != 0 {
            n -= 8
            x = x >> 8
        }
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 16 for 0.
    #test(0i16)[16]
    #test(1i16)[0]
    #test(2i16)[1]
    #test(80i16)[4]
    #test(16384i16)[14]
    #test(32767i16)[0] // MAX
    #test(-32768i16)[15] // MIN
    #test(-1i16)[0]
    #test(32766i16)[1] // MAX - 1
    #test(21845i16)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = (self as uint64) & 0xFFFF
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1) & 0xFFFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2i16, 3)[Some(5)]
    #test(-7i16, 3)[Some(-4)]
    #test(32767i16, 1)[None] // MAX + 1
    #test(32766i16, 1)[Some(32767)] // MAX - 1 + 1
    #test(32767i16, 32767)[None] // MAX + MAX
    #test(-32768i16, -1)[None] // MIN + -1
    #test(-32768i16, 32767)[Some(-1)] // MIN + MAX
    #test(-32767i16, -1)[Some(-32768)] // MIN + 1 + -1
    fun checked_add(self, other: int16) -> Option<int16> {
        return if add_overflows_i16(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5i16, 3)[Some(2)]
    #test(3i16, 5)[Some(-2)]
    #test(-32768i16, 1)[None] // MIN - 1
    #test(-32767i16, 1)[Some(-32768)] // MIN + 1 - 1
    #test(32767i16, -1)[None] // MAX - -1
    #test(0i16, -32768)[None] // 0 - MIN
    #test(-1i16, -32768)[Some(32767)] // -1 - MIN
    #test(32767i16, 32767)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: int16) -> Option<int16> {
        return if sub_overflows_i16(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6i16, 7)[Some(42)]
    #test(-6i16, 7)[Some(-42)]
    #test(32767i16, 2)[None] // MAX * 2
    #test(16383i16, 2)[Some(32766)]
    #test(-32768i16, -1)[None] // MIN * -1
    #test(-32768i16, 1)[Some(-32768)] // MIN * 1
    #test(-16384i16, 2)[Some(-32768)]
    #test(32767i16, -1)[Some(-32767)] // MAX * -1
    #test(0i16, 32767)[Some(0)] // 0 * MAX
    #test(32767i16, 32767)[None] // MAX * MAX
    fun checked_mul(self, other: int16) -> Option<int16> {
        return if mul_overflows_i16(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i16, 2)[Some(3)]
    #test(-7i16, 2)[Some(-3)]
    #test(7i16, 0)[None]
    #test(-32768i16, -1)[None] // MIN / -1
    #test(32767i16, 32767)[Some(1)] // MAX / MAX
    fun checked_div(self, other: int16) -> Option<int16> {
        return if other == 0 || (self == MIN_I16 && other == -1) { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i16, 2)[Some(1)]
    #test(-7i16, 2)[Some(-1)]
    #test(7i16, 0)[None]
    #test(-32768i16, -1)[None] // MIN % -1
    #test(32767i16, 32767)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: int16) -> Option<int16> {
        return if other == 0 || (self == MIN_I16 && other == -1) { None } else { Some(self % other) }
    }

    // `-self`, or `None` for the minimum.
    #test(5i16)[Some(-5)]
    #test(-5i16)[Some(5)]
    #test(0i16)[Some(0)]
    #test(32767i16)[Some(-32767)]
    #test(-32768i16)[None]
    #test(-32767i16)[Some(32767)]
    fun checked_neg(self) -> Option<int16> {
        return if self == MIN_I16 { None } else { Some(-self) }
    }

    // The absolute value, or `None` for the minimum.
    #test(5i16)[Some(5)]
    #test(-5i16)[Some(5)]
    #test(0i16)[Some(0)]
    #test(32767i16)[Some(32767)]
    #test(-32768i16)[None]
    #test(-32767i16)[Some(32767)]
    fun checked_abs(self) -> Option<int16> {
        return if self == MIN_I16 { None } else { Some(self.abs()) }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3i16, 4)[Some(81)]
    #test(2i16, 0)[Some(1)]
    #test(0i16, 0)[Some(1)]
    #test(0i16, 3)[Some(0)]
    #test(-2i16, 3)[Some(-8)]
    #test(-1i16, 7)[Some(-1)]
    #test(2i16, 14)[Some(16384)]
    #test(2i16, 15)[None]
    #test(3i16, 40)[None]
    #test(-2i16, 15)[Some(-32768)]
    fun checked_pow(self, exp: uint32) -> Option<int16> {
        var base = self
        var e = exp
        var acc: int16 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^16.
    #test(3i16, 4)[81]
    #test(2i16, 0)[1]
    #test(0i16, 0)[1]
    #test(0i16, 3)[0]
    #test(-2i16, 3)[-8]
    #test(-1i16, 7)[-1]
    #test(2i16, 14)[16384]
    #test(2i16, 15)[-32768] // wraps
    #test(3i16, 40)[-6111] // wraps
    #test(-2i16, 15)[-32768]
    fun wrapping_pow(self, exp: uint32) -> int16 {
        var base = self
        var e = exp
        var acc: int16 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2i16, 3)[5]
    #test(-7i16, 3)[-4]
    #test(32767i16, 1)[32767] // MAX + 1
    #test(32766i16, 1)[32767] // MAX - 1 + 1
    #test(32767i16, 32767)[32767] // MAX + MAX
    #test(-32768i16, -1)[-32768] // MIN + -1
    #test(-32768i16, 32767)[-1] // MIN + MAX
    #test(-32767i16, -1)[-32768] // MIN + 1 + -1
    fun saturating_add(self, other: int16) -> int16 {
        if add_overflows_i16(self, other) {
            return if other > 0 { MAX_I16 } else { MIN_I16 }
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5i16, 3)[2]
    #test(3i16, 5)[-2]
    #test(-32768i16, 1)[-32768] // MIN - 1
    #test(-32767i16, 1)[-32768] // MIN + 1 - 1
    #test(32767i16, -1)[32767] // MAX - -1
    #test(0i16, -32768)[32767] // 0 - MIN
    #test(-1i16, -32768)[32767] // -1 - MIN
    #test(32767i16, 32767)[0] // MAX - MAX
    fun saturating_sub(self, other: int16) -> int16 {
        if sub_overflows_i16(self, other) {
            return if other < 0 { MAX_I16 } else { MIN_I16 }
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6i16, 7)[42]
    #test(-6i16, 7)[-42]
    #test(32767i16, 2)[32767] // MAX * 2
    #test(16383i16, 2)[32766]
    #test(-32768i16, -1)[32767] // MIN * -1
    #test(-32768i16, 1)[-32768] // MIN * 1
    #test(-16384i16, 2)[-32768]
    #test(32767i16, -1)[-32767] // MAX * -1
    #test(0i16, 32767)[0] // 0 * MAX
    #test(32767i16, 32767)[32767] // MAX * MAX
    fun saturating_mul(self, other: int16) -> int16 {
        if mul_overflows_i16(self, other) {
            return if (self < 0) == (other < 0) { MAX_I16 } else { MIN_I16 }
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3i16, 4)[81]
    #test(2i16, 0)[1]
    #test(0i16, 0)[1]
    #test(0i16, 3)[0]
    #test(-2i16, 3)[-8]
    #test(-1i16, 7)[-1]
    #test(2i16, 14)[16384]
    #test(2i16, 15)[32767]
    #test(3i16, 40)[32767]
    #test(-2i16, 15)[-32768]
    fun saturating_pow(self, exp: uint32) -> int16 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => if self < 0 && (exp & 1) == 1 { MIN_I16 } else { MAX_I16 }
        }
    }

    // `self + other` modulo 2^16, and whether it didn't fit.
    #test(2i16, 3)[(5, false)]
    #test(-7i16, 3)[(-4, false)]
    #test(32767i16, 1)[(-32768, true)] // MAX + 1
    #test(32766i16, 1)[(32767, false)] // MAX - 1 + 1
    #test(32767i16, 32767)[(-2, true)] // MAX + MAX
    #test(-32768i16, -1)[(32767, true)] // MIN + -1
    #test(-32768i16, 32767)[(-1, false)] // MIN + MAX
    #test(-32767i16, -1)[(-32768, false)] // MIN + 1 + -1
    fun overflowing_add(self, other: int16) -> (int16, bool) {
        return (self + other, add_overflows_i16(self, other))
    }

    // `self - other` modulo 2^16, and whether it didn't fit.
    #test(5i16, 3)[(2, false)]
    #test(3i16, 5)[(-2, false)]
    #test(-32768i16, 1)[(32767, true)] // MIN - 1
    #test(-32767i16, 1)[(-32768, false)] // MIN + 1 - 1
    #test(32767i16, -1)[(-32768, true)] // MAX - -1
    #test(0i16, -32768)[(-32768, true)] // 0 - MIN
    #test(-1i16, -32768)[(32767, false)] // -1 - MIN
    #test(32767i16, 32767)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: int16) -> (int16, bool) {
        return (self - other, sub_overflows_i16(self, other))
    }

    // `self * other` modulo 2^16, and whether it didn't fit.
    #test(6i16, 7)[(42, false)]
    #test(-6i16, 7)[(-42, false)]
    #test(32767i16, 2)[(-2, true)] // MAX * 2
    #test(16383i16, 2)[(32766, false)]
    #test(-32768i16, -1)[(-32768, true)] // MIN * -1
    #test(-32768i16, 1)[(-32768, false)] // MIN * 1
    #test(-16384i16, 2)[(-32768, false)]
    #test(32767i16, -1)[(-32767, false)] // MAX * -1
    #test(0i16, 32767)[(0, false)] // 0 * MAX
    #test(32767i16, 32767)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: int16) -> (int16, bool) {
        return (self * other, mul_overflows_i16(self, other))
    }

    // `-self` modulo 2^16, and whether it didn't fit.
    #test(5i16)[(-5, false)]
    #test(-5i16)[(5, false)]
    #test(0i16)[(0, false)]
    #test(32767i16)[(-32767, false)]
    #test(-32768i16)[(-32768, true)]
    #test(-32767i16)[(32767, false)]
    fun overflowing_neg(self) -> (int16, bool) {
        return (0 - self, self == MIN_I16)
    }

    // The number to the power `exp` modulo 2^16, and whether it didn't fit.
    #test(3i16, 4)[(81, false)]
    #test(2i16, 0)[(1, false)]
    #test(0i16, 0)[(1, false)]
    #test(0i16, 3)[(0, false)]
    #test(-2i16, 3)[(-8, false)]
    #test(-1i16, 7)[(-1, false)]
    #test(2i16, 14)[(16384, false)]
    #test(2i16, 15)[(-32768, true)]
    #test(3i16, 40)[(-6111, true)]
    #test(-2i16, 15)[(-32768, false)]
    fun overflowing_pow(self, exp: uint32) -> (int16, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7i16, 8, 5)[1]
    #test(-7i16, 8, 5)[4]
    #test(7i16, -8, 5)[4]
    #test(32767i16, 32767, 32766)[1] // MAX, MAX, MAX - 1
    #test(32767i16, 32767, 32767)[0] // MAX, MAX, MAX
    #test(32766i16, 32765, 32767)[2] // MAX - 1, 32765, MAX
    #test(-32768i16, -32768, 32767)[1] // MIN, MIN, MAX
    #test(-32768i16, 3, 1000)[696] // MIN, 3, 1000
    #test(3i16, 4, 1)[0]
    #test(3i16, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    #test(3i16, 4, -5)[panic("mulmod: the modulus must be positive, not -5")]
    fun mulmod(self, other: int16, m: int16) -> int16 {
        if m <= 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        return ((self as int64) * (other as int64)).rem_euclid(m as int64) as int16
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive and `exp` not negative.
    #test(2i16, 10, 1000)[24]
    #test(3i16, 0, 7)[1]
    #test(3i16, 0, 1)[0]
    #test(-2i16, 3, 7)[6]
    #test(0i16, 0, 5)[1]
    #test(2i16, 32748, 32749)[1]
    #test(32767i16, 32767, 32749)[83] // MAX, MAX, 32749
    #test(32766i16, 3, 32767)[32766] // MAX - 1, 3, MAX
    #test(5i16, 0, 32767)[1] // 5, 0, MAX
    #test(2i16, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    #test(2i16, -1, 7)[panic("powmod: the exponent must not be negative, not -1")]
    fun powmod(self, exp: int16, m: int16) -> int16 {
        if m <= 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        if exp < 0 {
            panic(f"powmod: the exponent must not be negative, not {exp}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: int16 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3i16, 7)[Some(5)]
    #test(-3i16, 7)[Some(2)]
    #test(4i16, 8)[None]
    #test(0i16, 7)[None]
    #test(5i16, 1)[Some(0)]
    #test(10i16, 17)[Some(12)]
    #test(32767i16, 32749)[Some(9097)] // MAX mod 32749
    #test(2i16, 32767)[Some(16384)] // 2 mod MAX
    #test(3i16, 0)[panic("modinv: the modulus must be positive, not 0")]
    #test(3i16, -7)[panic("modinv: the modulus must be positive, not -7")]
    fun modinv(self, m: int16) -> Option<int16> {
        if m <= 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: int16 = 0
        var t1: int16 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

impl int32 {
    // The absolute value. The minimum has none that fits: its `abs` is the
    // minimum again, as `-` wraps it (`checked_abs` says so).
    #test(5i32)[5]
    #test(-5i32)[5]
    #test(0i32)[0]
    #test(2147483647i32)[2147483647]
    #test(-2147483648i32)[-2147483648] // MIN, which wraps
    #test(-2147483647i32)[2147483647]
    fun abs(self) -> int32 {
        return if self < 0 { -self } else { self }
    }

    // -1, 0 or 1, the sign of the number.
    #test(5i32)[1]
    #test(-5i32)[-1]
    #test(0i32)[0]
    #test(2147483647i32)[1]
    #test(-2147483648i32)[-1]
    #test(-2147483647i32)[-1]
    fun signum(self) -> int32 {
        return if self > 0 { 1 } else if self < 0 { -1 } else { 0 }
    }

    // The smaller of the two.
    #test(3i32, 4)[3]
    #test(4i32, 3)[3]
    #test(-3i32, 2)[-3]
    #test(-2147483648i32, 2147483647)[-2147483648]
    #test(5i32, 5)[5]
    fun min(self, other: int32) -> int32 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3i32, 4)[4]
    #test(4i32, 3)[4]
    #test(-3i32, 2)[2]
    #test(-2147483648i32, 2147483647)[2147483647]
    #test(5i32, 5)[5]
    fun max(self, other: int32) -> int32 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5i32, 0, 10)[5]
    #test(-5i32, 0, 10)[0]
    #test(15i32, 0, 10)[10]
    #test(0i32, 0, 0)[0]
    #test(2147483647i32, -2147483648, 3)[3]
    #test(7i32, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: int32, hi: int32) -> int32 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3i32, 4)[81]
    #test(2i32, 0)[1]
    #test(0i32, 0)[1]
    #test(0i32, 3)[0]
    #test(-2i32, 3)[-8]
    #test(-1i32, 7)[-1]
    #test(2i32, 30)[1073741824]
    #test(2i32, 31)[-2147483648] // wraps
    #test(3i32, 40)[689956897] // wraps
    #test(-2i32, 31)[-2147483648]
    fun pow(self, exp: uint32) -> int32 {
        var base = self
        var e = exp
        var acc: int32 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor, never negative but for a result of 2^(bits - 1),
    // which wraps to the minimum (`MIN.gcd(0)`); `0.gcd(0)` is 0.
    #test(12i32, 18)[6]
    #test(-12i32, 18)[6]
    #test(12i32, -18)[6]
    #test(0i32, 5)[5]
    #test(0i32, 0)[0]
    #test(17i32, 5)[1]
    #test(2147483647i32, 2147483646)[1]
    #test(-2147483648i32, -1073741824)[1073741824]
    fun gcd(self, other: int32) -> int32 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a.abs()
    }

    // The least common multiple, never negative; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4i32, 6)[12]
    #test(-4i32, 6)[12]
    #test(0i32, 6)[0]
    #test(21i32, 6)[42]
    #test(2147483647i32, 1)[2147483647]
    fun lcm(self, other: int32) -> int32 {
        if self == 0 || other == 0 {
            return 0
        }
        return (self / self.gcd(other) * other).abs()
    }

    // The quotient of Euclidean division: the `q` with `self == q * other + r`
    // and `0 <= r < |other|`. Division by zero is a runtime error; `MIN.div_euclid(-1)`
    // wraps to `MIN`, as `/` does.
    #test(7i32, 3)[2]
    #test(-7i32, 3)[-3]
    #test(7i32, -3)[-2]
    #test(-7i32, -3)[3]
    #test(6i32, 3)[2]
    #test(-6i32, 3)[-2]
    #test(-2147483648i32, -1)[-2147483648] // wraps, as / does
    #test(-2147483647i32, -2147483648)[1]
    #test(2147483647i32, 10)[214748364]
    fun div_euclid(self, other: int32) -> int32 {
        let q = self / other
        if self % other < 0 {
            return if other > 0 { q - 1 } else { q + 1 }
        }
        return q
    }

    // The remainder of Euclidean division, never negative: from 0 to
    // `|other| - 1`. Division by zero is a runtime error.
    #test(7i32, 3)[1]
    #test(-7i32, 3)[2]
    #test(7i32, -3)[1]
    #test(-7i32, -3)[2]
    #test(6i32, 3)[0]
    #test(-6i32, 3)[0]
    #test(-2147483648i32, -1)[0]
    #test(-2147483647i32, -2147483648)[1]
    #test(2147483647i32, 10)[7]
    fun rem_euclid(self, other: int32) -> int32 {
        let r = self % other
        if r < 0 {
            return if other < 0 { r - other } else { r + other }
        }
        return r
    }

    // The number of bits set (a negative number's are its two's complement's).
    #test(0i32)[0]
    #test(1i32)[1]
    #test(2i32)[1]
    #test(80i32)[2]
    #test(1073741824i32)[1]
    #test(2147483647i32)[31] // MAX
    #test(-2147483648i32)[1] // MIN
    #test(-1i32)[32]
    #test(2147483646i32)[30] // MAX - 1
    #test(21845i32)[8]
    fun count_ones(self) -> int {
        let v: uint64 = (self as uint64) & 0xFFFFFFFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 32 for 0, 0 for a
    // negative number.
    #test(0i32)[32]
    #test(1i32)[31]
    #test(2i32)[30]
    #test(80i32)[25]
    #test(1073741824i32)[1]
    #test(2147483647i32)[1] // MAX
    #test(-2147483648i32)[0] // MIN
    #test(-1i32)[0]
    #test(2147483646i32)[1] // MAX - 1
    #test(21845i32)[17]
    fun leading_zeros(self) -> int {
        var x: uint64 = (self as uint64) & 0xFFFFFFFF
        if x == 0 {
            return 32
        }
        var n = 31
        if x >> 16 != 0 {
            n -= 16
            x = x >> 16
        }
        if x >> 8 != 0 {
            n -= 8
            x = x >> 8
        }
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 32 for 0.
    #test(0i32)[32]
    #test(1i32)[0]
    #test(2i32)[1]
    #test(80i32)[4]
    #test(1073741824i32)[30]
    #test(2147483647i32)[0] // MAX
    #test(-2147483648i32)[31] // MIN
    #test(-1i32)[0]
    #test(2147483646i32)[1] // MAX - 1
    #test(21845i32)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = (self as uint64) & 0xFFFFFFFF
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1) & 0xFFFFFFFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2i32, 3)[Some(5)]
    #test(-7i32, 3)[Some(-4)]
    #test(2147483647i32, 1)[None] // MAX + 1
    #test(2147483646i32, 1)[Some(2147483647)] // MAX - 1 + 1
    #test(2147483647i32, 2147483647)[None] // MAX + MAX
    #test(-2147483648i32, -1)[None] // MIN + -1
    #test(-2147483648i32, 2147483647)[Some(-1)] // MIN + MAX
    #test(-2147483647i32, -1)[Some(-2147483648)] // MIN + 1 + -1
    fun checked_add(self, other: int32) -> Option<int32> {
        return if add_overflows_i32(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5i32, 3)[Some(2)]
    #test(3i32, 5)[Some(-2)]
    #test(-2147483648i32, 1)[None] // MIN - 1
    #test(-2147483647i32, 1)[Some(-2147483648)] // MIN + 1 - 1
    #test(2147483647i32, -1)[None] // MAX - -1
    #test(0i32, -2147483648)[None] // 0 - MIN
    #test(-1i32, -2147483648)[Some(2147483647)] // -1 - MIN
    #test(2147483647i32, 2147483647)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: int32) -> Option<int32> {
        return if sub_overflows_i32(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6i32, 7)[Some(42)]
    #test(-6i32, 7)[Some(-42)]
    #test(2147483647i32, 2)[None] // MAX * 2
    #test(1073741823i32, 2)[Some(2147483646)]
    #test(-2147483648i32, -1)[None] // MIN * -1
    #test(-2147483648i32, 1)[Some(-2147483648)] // MIN * 1
    #test(-1073741824i32, 2)[Some(-2147483648)]
    #test(2147483647i32, -1)[Some(-2147483647)] // MAX * -1
    #test(0i32, 2147483647)[Some(0)] // 0 * MAX
    #test(2147483647i32, 2147483647)[None] // MAX * MAX
    fun checked_mul(self, other: int32) -> Option<int32> {
        return if mul_overflows_i32(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i32, 2)[Some(3)]
    #test(-7i32, 2)[Some(-3)]
    #test(7i32, 0)[None]
    #test(-2147483648i32, -1)[None] // MIN / -1
    #test(2147483647i32, 2147483647)[Some(1)] // MAX / MAX
    fun checked_div(self, other: int32) -> Option<int32> {
        return if other == 0 || (self == MIN_I32 && other == -1) { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i32, 2)[Some(1)]
    #test(-7i32, 2)[Some(-1)]
    #test(7i32, 0)[None]
    #test(-2147483648i32, -1)[None] // MIN % -1
    #test(2147483647i32, 2147483647)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: int32) -> Option<int32> {
        return if other == 0 || (self == MIN_I32 && other == -1) { None } else { Some(self % other) }
    }

    // `-self`, or `None` for the minimum.
    #test(5i32)[Some(-5)]
    #test(-5i32)[Some(5)]
    #test(0i32)[Some(0)]
    #test(2147483647i32)[Some(-2147483647)]
    #test(-2147483648i32)[None]
    #test(-2147483647i32)[Some(2147483647)]
    fun checked_neg(self) -> Option<int32> {
        return if self == MIN_I32 { None } else { Some(-self) }
    }

    // The absolute value, or `None` for the minimum.
    #test(5i32)[Some(5)]
    #test(-5i32)[Some(5)]
    #test(0i32)[Some(0)]
    #test(2147483647i32)[Some(2147483647)]
    #test(-2147483648i32)[None]
    #test(-2147483647i32)[Some(2147483647)]
    fun checked_abs(self) -> Option<int32> {
        return if self == MIN_I32 { None } else { Some(self.abs()) }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3i32, 4)[Some(81)]
    #test(2i32, 0)[Some(1)]
    #test(0i32, 0)[Some(1)]
    #test(0i32, 3)[Some(0)]
    #test(-2i32, 3)[Some(-8)]
    #test(-1i32, 7)[Some(-1)]
    #test(2i32, 30)[Some(1073741824)]
    #test(2i32, 31)[None]
    #test(3i32, 40)[None]
    #test(-2i32, 31)[Some(-2147483648)]
    fun checked_pow(self, exp: uint32) -> Option<int32> {
        var base = self
        var e = exp
        var acc: int32 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^32.
    #test(3i32, 4)[81]
    #test(2i32, 0)[1]
    #test(0i32, 0)[1]
    #test(0i32, 3)[0]
    #test(-2i32, 3)[-8]
    #test(-1i32, 7)[-1]
    #test(2i32, 30)[1073741824]
    #test(2i32, 31)[-2147483648] // wraps
    #test(3i32, 40)[689956897] // wraps
    #test(-2i32, 31)[-2147483648]
    fun wrapping_pow(self, exp: uint32) -> int32 {
        var base = self
        var e = exp
        var acc: int32 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2i32, 3)[5]
    #test(-7i32, 3)[-4]
    #test(2147483647i32, 1)[2147483647] // MAX + 1
    #test(2147483646i32, 1)[2147483647] // MAX - 1 + 1
    #test(2147483647i32, 2147483647)[2147483647] // MAX + MAX
    #test(-2147483648i32, -1)[-2147483648] // MIN + -1
    #test(-2147483648i32, 2147483647)[-1] // MIN + MAX
    #test(-2147483647i32, -1)[-2147483648] // MIN + 1 + -1
    fun saturating_add(self, other: int32) -> int32 {
        if add_overflows_i32(self, other) {
            return if other > 0 { MAX_I32 } else { MIN_I32 }
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5i32, 3)[2]
    #test(3i32, 5)[-2]
    #test(-2147483648i32, 1)[-2147483648] // MIN - 1
    #test(-2147483647i32, 1)[-2147483648] // MIN + 1 - 1
    #test(2147483647i32, -1)[2147483647] // MAX - -1
    #test(0i32, -2147483648)[2147483647] // 0 - MIN
    #test(-1i32, -2147483648)[2147483647] // -1 - MIN
    #test(2147483647i32, 2147483647)[0] // MAX - MAX
    fun saturating_sub(self, other: int32) -> int32 {
        if sub_overflows_i32(self, other) {
            return if other < 0 { MAX_I32 } else { MIN_I32 }
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6i32, 7)[42]
    #test(-6i32, 7)[-42]
    #test(2147483647i32, 2)[2147483647] // MAX * 2
    #test(1073741823i32, 2)[2147483646]
    #test(-2147483648i32, -1)[2147483647] // MIN * -1
    #test(-2147483648i32, 1)[-2147483648] // MIN * 1
    #test(-1073741824i32, 2)[-2147483648]
    #test(2147483647i32, -1)[-2147483647] // MAX * -1
    #test(0i32, 2147483647)[0] // 0 * MAX
    #test(2147483647i32, 2147483647)[2147483647] // MAX * MAX
    fun saturating_mul(self, other: int32) -> int32 {
        if mul_overflows_i32(self, other) {
            return if (self < 0) == (other < 0) { MAX_I32 } else { MIN_I32 }
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3i32, 4)[81]
    #test(2i32, 0)[1]
    #test(0i32, 0)[1]
    #test(0i32, 3)[0]
    #test(-2i32, 3)[-8]
    #test(-1i32, 7)[-1]
    #test(2i32, 30)[1073741824]
    #test(2i32, 31)[2147483647]
    #test(3i32, 40)[2147483647]
    #test(-2i32, 31)[-2147483648]
    fun saturating_pow(self, exp: uint32) -> int32 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => if self < 0 && (exp & 1) == 1 { MIN_I32 } else { MAX_I32 }
        }
    }

    // `self + other` modulo 2^32, and whether it didn't fit.
    #test(2i32, 3)[(5, false)]
    #test(-7i32, 3)[(-4, false)]
    #test(2147483647i32, 1)[(-2147483648, true)] // MAX + 1
    #test(2147483646i32, 1)[(2147483647, false)] // MAX - 1 + 1
    #test(2147483647i32, 2147483647)[(-2, true)] // MAX + MAX
    #test(-2147483648i32, -1)[(2147483647, true)] // MIN + -1
    #test(-2147483648i32, 2147483647)[(-1, false)] // MIN + MAX
    #test(-2147483647i32, -1)[(-2147483648, false)] // MIN + 1 + -1
    fun overflowing_add(self, other: int32) -> (int32, bool) {
        return (self + other, add_overflows_i32(self, other))
    }

    // `self - other` modulo 2^32, and whether it didn't fit.
    #test(5i32, 3)[(2, false)]
    #test(3i32, 5)[(-2, false)]
    #test(-2147483648i32, 1)[(2147483647, true)] // MIN - 1
    #test(-2147483647i32, 1)[(-2147483648, false)] // MIN + 1 - 1
    #test(2147483647i32, -1)[(-2147483648, true)] // MAX - -1
    #test(0i32, -2147483648)[(-2147483648, true)] // 0 - MIN
    #test(-1i32, -2147483648)[(2147483647, false)] // -1 - MIN
    #test(2147483647i32, 2147483647)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: int32) -> (int32, bool) {
        return (self - other, sub_overflows_i32(self, other))
    }

    // `self * other` modulo 2^32, and whether it didn't fit.
    #test(6i32, 7)[(42, false)]
    #test(-6i32, 7)[(-42, false)]
    #test(2147483647i32, 2)[(-2, true)] // MAX * 2
    #test(1073741823i32, 2)[(2147483646, false)]
    #test(-2147483648i32, -1)[(-2147483648, true)] // MIN * -1
    #test(-2147483648i32, 1)[(-2147483648, false)] // MIN * 1
    #test(-1073741824i32, 2)[(-2147483648, false)]
    #test(2147483647i32, -1)[(-2147483647, false)] // MAX * -1
    #test(0i32, 2147483647)[(0, false)] // 0 * MAX
    #test(2147483647i32, 2147483647)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: int32) -> (int32, bool) {
        return (self * other, mul_overflows_i32(self, other))
    }

    // `-self` modulo 2^32, and whether it didn't fit.
    #test(5i32)[(-5, false)]
    #test(-5i32)[(5, false)]
    #test(0i32)[(0, false)]
    #test(2147483647i32)[(-2147483647, false)]
    #test(-2147483648i32)[(-2147483648, true)]
    #test(-2147483647i32)[(2147483647, false)]
    fun overflowing_neg(self) -> (int32, bool) {
        return (0 - self, self == MIN_I32)
    }

    // The number to the power `exp` modulo 2^32, and whether it didn't fit.
    #test(3i32, 4)[(81, false)]
    #test(2i32, 0)[(1, false)]
    #test(0i32, 0)[(1, false)]
    #test(0i32, 3)[(0, false)]
    #test(-2i32, 3)[(-8, false)]
    #test(-1i32, 7)[(-1, false)]
    #test(2i32, 30)[(1073741824, false)]
    #test(2i32, 31)[(-2147483648, true)]
    #test(3i32, 40)[(689956897, true)]
    #test(-2i32, 31)[(-2147483648, false)]
    fun overflowing_pow(self, exp: uint32) -> (int32, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7i32, 8, 5)[1]
    #test(-7i32, 8, 5)[4]
    #test(7i32, -8, 5)[4]
    #test(2147483647i32, 2147483647, 2147483646)[1] // MAX, MAX, MAX - 1
    #test(2147483647i32, 2147483647, 2147483647)[0] // MAX, MAX, MAX
    #test(2147483646i32, 2147483645, 2147483647)[2] // MAX - 1, 2147483645, MAX
    #test(-2147483648i32, -2147483648, 2147483647)[1] // MIN, MIN, MAX
    #test(-2147483648i32, 3, 1000)[56] // MIN, 3, 1000
    #test(3i32, 4, 1)[0]
    #test(3i32, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    #test(3i32, 4, -5)[panic("mulmod: the modulus must be positive, not -5")]
    fun mulmod(self, other: int32, m: int32) -> int32 {
        if m <= 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        return ((self as int64) * (other as int64)).rem_euclid(m as int64) as int32
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive and `exp` not negative.
    #test(2i32, 10, 1000)[24]
    #test(3i32, 0, 7)[1]
    #test(3i32, 0, 1)[0]
    #test(-2i32, 3, 7)[6]
    #test(0i32, 0, 5)[1]
    #test(2i32, 2147483646, 2147483647)[1] // 2, MAX - 1, MAX
    #test(2147483647i32, 2147483647, 2147483647)[0] // MAX, MAX, MAX
    #test(2147483646i32, 3, 2147483647)[2147483646] // MAX - 1, 3, MAX
    #test(5i32, 0, 2147483647)[1] // 5, 0, MAX
    #test(2i32, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    #test(2i32, -1, 7)[panic("powmod: the exponent must not be negative, not -1")]
    fun powmod(self, exp: int32, m: int32) -> int32 {
        if m <= 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        if exp < 0 {
            panic(f"powmod: the exponent must not be negative, not {exp}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: int32 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3i32, 7)[Some(5)]
    #test(-3i32, 7)[Some(2)]
    #test(4i32, 8)[None]
    #test(0i32, 7)[None]
    #test(5i32, 1)[Some(0)]
    #test(10i32, 17)[Some(12)]
    #test(2147483647i32, 2147483647)[None] // MAX mod MAX
    #test(2i32, 2147483647)[Some(1073741824)] // 2 mod MAX
    #test(3i32, 0)[panic("modinv: the modulus must be positive, not 0")]
    #test(3i32, -7)[panic("modinv: the modulus must be positive, not -7")]
    fun modinv(self, m: int32) -> Option<int32> {
        if m <= 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: int32 = 0
        var t1: int32 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

impl int64 {
    // The absolute value. The minimum has none that fits: its `abs` is the
    // minimum again, as `-` wraps it (`checked_abs` says so).
    #test(5i64)[5]
    #test(-5i64)[5]
    #test(0i64)[0]
    #test(9223372036854775807i64)[9223372036854775807]
    #test(-9223372036854775808i64)[-9223372036854775808] // MIN, which wraps
    #test(-9223372036854775807i64)[9223372036854775807]
    fun abs(self) -> int64 {
        return if self < 0 { -self } else { self }
    }

    // -1, 0 or 1, the sign of the number.
    #test(5i64)[1]
    #test(-5i64)[-1]
    #test(0i64)[0]
    #test(9223372036854775807i64)[1]
    #test(-9223372036854775808i64)[-1]
    #test(-9223372036854775807i64)[-1]
    fun signum(self) -> int64 {
        return if self > 0 { 1 } else if self < 0 { -1 } else { 0 }
    }

    // The smaller of the two.
    #test(3i64, 4)[3]
    #test(4i64, 3)[3]
    #test(-3i64, 2)[-3]
    #test(-9223372036854775808i64, 9223372036854775807)[-9223372036854775808]
    #test(5i64, 5)[5]
    fun min(self, other: int64) -> int64 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3i64, 4)[4]
    #test(4i64, 3)[4]
    #test(-3i64, 2)[2]
    #test(-9223372036854775808i64, 9223372036854775807)[9223372036854775807]
    #test(5i64, 5)[5]
    fun max(self, other: int64) -> int64 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5i64, 0, 10)[5]
    #test(-5i64, 0, 10)[0]
    #test(15i64, 0, 10)[10]
    #test(0i64, 0, 0)[0]
    #test(9223372036854775807i64, -9223372036854775808, 3)[3]
    #test(7i64, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: int64, hi: int64) -> int64 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3i64, 4)[81]
    #test(2i64, 0)[1]
    #test(0i64, 0)[1]
    #test(0i64, 3)[0]
    #test(-2i64, 3)[-8]
    #test(-1i64, 7)[-1]
    #test(2i64, 62)[4611686018427387904]
    #test(2i64, 63)[-9223372036854775808] // wraps
    #test(3i64, 40)[-6289078614652622815] // wraps
    #test(-2i64, 63)[-9223372036854775808]
    fun pow(self, exp: uint32) -> int64 {
        var base = self
        var e = exp
        var acc: int64 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor, never negative but for a result of 2^(bits - 1),
    // which wraps to the minimum (`MIN.gcd(0)`); `0.gcd(0)` is 0.
    #test(12i64, 18)[6]
    #test(-12i64, 18)[6]
    #test(12i64, -18)[6]
    #test(0i64, 5)[5]
    #test(0i64, 0)[0]
    #test(17i64, 5)[1]
    #test(9223372036854775807i64, 9223372036854775806)[1]
    #test(-9223372036854775808i64, -4611686018427387904)[4611686018427387904]
    fun gcd(self, other: int64) -> int64 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a.abs()
    }

    // The least common multiple, never negative; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4i64, 6)[12]
    #test(-4i64, 6)[12]
    #test(0i64, 6)[0]
    #test(21i64, 6)[42]
    #test(9223372036854775807i64, 1)[9223372036854775807]
    fun lcm(self, other: int64) -> int64 {
        if self == 0 || other == 0 {
            return 0
        }
        return (self / self.gcd(other) * other).abs()
    }

    // The quotient of Euclidean division: the `q` with `self == q * other + r`
    // and `0 <= r < |other|`. Division by zero is a runtime error; `MIN.div_euclid(-1)`
    // wraps to `MIN`, as `/` does.
    #test(7i64, 3)[2]
    #test(-7i64, 3)[-3]
    #test(7i64, -3)[-2]
    #test(-7i64, -3)[3]
    #test(6i64, 3)[2]
    #test(-6i64, 3)[-2]
    #test(-9223372036854775808i64, -1)[-9223372036854775808] // wraps, as / does
    #test(-9223372036854775807i64, -9223372036854775808)[1]
    #test(9223372036854775807i64, 10)[922337203685477580]
    fun div_euclid(self, other: int64) -> int64 {
        let q = self / other
        if self % other < 0 {
            return if other > 0 { q - 1 } else { q + 1 }
        }
        return q
    }

    // The remainder of Euclidean division, never negative: from 0 to
    // `|other| - 1`. Division by zero is a runtime error.
    #test(7i64, 3)[1]
    #test(-7i64, 3)[2]
    #test(7i64, -3)[1]
    #test(-7i64, -3)[2]
    #test(6i64, 3)[0]
    #test(-6i64, 3)[0]
    #test(-9223372036854775808i64, -1)[0]
    #test(-9223372036854775807i64, -9223372036854775808)[1]
    #test(9223372036854775807i64, 10)[7]
    fun rem_euclid(self, other: int64) -> int64 {
        let r = self % other
        if r < 0 {
            return if other < 0 { r - other } else { r + other }
        }
        return r
    }

    // The number of bits set (a negative number's are its two's complement's).
    #test(0i64)[0]
    #test(1i64)[1]
    #test(2i64)[1]
    #test(80i64)[2]
    #test(4611686018427387904i64)[1]
    #test(9223372036854775807i64)[63] // MAX
    #test(-9223372036854775808i64)[1] // MIN
    #test(-1i64)[64]
    #test(9223372036854775806i64)[62] // MAX - 1
    #test(21845i64)[8]
    fun count_ones(self) -> int {
        let v: uint64 = self as uint64
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 64 for 0, 0 for a
    // negative number.
    #test(0i64)[64]
    #test(1i64)[63]
    #test(2i64)[62]
    #test(80i64)[57]
    #test(4611686018427387904i64)[1]
    #test(9223372036854775807i64)[1] // MAX
    #test(-9223372036854775808i64)[0] // MIN
    #test(-1i64)[0]
    #test(9223372036854775806i64)[1] // MAX - 1
    #test(21845i64)[49]
    fun leading_zeros(self) -> int {
        var x: uint64 = self as uint64
        if x == 0 {
            return 64
        }
        var n = 63
        if x >> 32 != 0 {
            n -= 32
            x = x >> 32
        }
        if x >> 16 != 0 {
            n -= 16
            x = x >> 16
        }
        if x >> 8 != 0 {
            n -= 8
            x = x >> 8
        }
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 64 for 0.
    #test(0i64)[64]
    #test(1i64)[0]
    #test(2i64)[1]
    #test(80i64)[4]
    #test(4611686018427387904i64)[62]
    #test(9223372036854775807i64)[0] // MAX
    #test(-9223372036854775808i64)[63] // MIN
    #test(-1i64)[0]
    #test(9223372036854775806i64)[1] // MAX - 1
    #test(21845i64)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = self as uint64
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1)
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2i64, 3)[Some(5)]
    #test(-7i64, 3)[Some(-4)]
    #test(9223372036854775807i64, 1)[None] // MAX + 1
    #test(9223372036854775806i64, 1)[Some(9223372036854775807)] // MAX - 1 + 1
    #test(9223372036854775807i64, 9223372036854775807)[None] // MAX + MAX
    #test(-9223372036854775808i64, -1)[None] // MIN + -1
    #test(-9223372036854775808i64, 9223372036854775807)[Some(-1)] // MIN + MAX
    #test(-9223372036854775807i64, -1)[Some(-9223372036854775808)] // MIN + 1 + -1
    fun checked_add(self, other: int64) -> Option<int64> {
        return if add_overflows_i64(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5i64, 3)[Some(2)]
    #test(3i64, 5)[Some(-2)]
    #test(-9223372036854775808i64, 1)[None] // MIN - 1
    #test(-9223372036854775807i64, 1)[Some(-9223372036854775808)] // MIN + 1 - 1
    #test(9223372036854775807i64, -1)[None] // MAX - -1
    #test(0i64, -9223372036854775808)[None] // 0 - MIN
    #test(-1i64, -9223372036854775808)[Some(9223372036854775807)] // -1 - MIN
    #test(9223372036854775807i64, 9223372036854775807)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: int64) -> Option<int64> {
        return if sub_overflows_i64(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6i64, 7)[Some(42)]
    #test(-6i64, 7)[Some(-42)]
    #test(9223372036854775807i64, 2)[None] // MAX * 2
    #test(4611686018427387903i64, 2)[Some(9223372036854775806)]
    #test(-9223372036854775808i64, -1)[None] // MIN * -1
    #test(-9223372036854775808i64, 1)[Some(-9223372036854775808)] // MIN * 1
    #test(-4611686018427387904i64, 2)[Some(-9223372036854775808)]
    #test(9223372036854775807i64, -1)[Some(-9223372036854775807)] // MAX * -1
    #test(0i64, 9223372036854775807)[Some(0)] // 0 * MAX
    #test(9223372036854775807i64, 9223372036854775807)[None] // MAX * MAX
    fun checked_mul(self, other: int64) -> Option<int64> {
        return if mul_overflows_i64(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i64, 2)[Some(3)]
    #test(-7i64, 2)[Some(-3)]
    #test(7i64, 0)[None]
    #test(-9223372036854775808i64, -1)[None] // MIN / -1
    #test(9223372036854775807i64, 9223372036854775807)[Some(1)] // MAX / MAX
    fun checked_div(self, other: int64) -> Option<int64> {
        return if other == 0 || (self == MIN_I64 && other == -1) { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0 or the quotient doesn't fit
    // (`MIN / -1`).
    #test(7i64, 2)[Some(1)]
    #test(-7i64, 2)[Some(-1)]
    #test(7i64, 0)[None]
    #test(-9223372036854775808i64, -1)[None] // MIN % -1
    #test(9223372036854775807i64, 9223372036854775807)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: int64) -> Option<int64> {
        return if other == 0 || (self == MIN_I64 && other == -1) { None } else { Some(self % other) }
    }

    // `-self`, or `None` for the minimum.
    #test(5i64)[Some(-5)]
    #test(-5i64)[Some(5)]
    #test(0i64)[Some(0)]
    #test(9223372036854775807i64)[Some(-9223372036854775807)]
    #test(-9223372036854775808i64)[None]
    #test(-9223372036854775807i64)[Some(9223372036854775807)]
    fun checked_neg(self) -> Option<int64> {
        return if self == MIN_I64 { None } else { Some(-self) }
    }

    // The absolute value, or `None` for the minimum.
    #test(5i64)[Some(5)]
    #test(-5i64)[Some(5)]
    #test(0i64)[Some(0)]
    #test(9223372036854775807i64)[Some(9223372036854775807)]
    #test(-9223372036854775808i64)[None]
    #test(-9223372036854775807i64)[Some(9223372036854775807)]
    fun checked_abs(self) -> Option<int64> {
        return if self == MIN_I64 { None } else { Some(self.abs()) }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3i64, 4)[Some(81)]
    #test(2i64, 0)[Some(1)]
    #test(0i64, 0)[Some(1)]
    #test(0i64, 3)[Some(0)]
    #test(-2i64, 3)[Some(-8)]
    #test(-1i64, 7)[Some(-1)]
    #test(2i64, 62)[Some(4611686018427387904)]
    #test(2i64, 63)[None]
    #test(3i64, 40)[None]
    #test(-2i64, 63)[Some(-9223372036854775808)]
    fun checked_pow(self, exp: uint32) -> Option<int64> {
        var base = self
        var e = exp
        var acc: int64 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^64.
    #test(3i64, 4)[81]
    #test(2i64, 0)[1]
    #test(0i64, 0)[1]
    #test(0i64, 3)[0]
    #test(-2i64, 3)[-8]
    #test(-1i64, 7)[-1]
    #test(2i64, 62)[4611686018427387904]
    #test(2i64, 63)[-9223372036854775808] // wraps
    #test(3i64, 40)[-6289078614652622815] // wraps
    #test(-2i64, 63)[-9223372036854775808]
    fun wrapping_pow(self, exp: uint32) -> int64 {
        var base = self
        var e = exp
        var acc: int64 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2i64, 3)[5]
    #test(-7i64, 3)[-4]
    #test(9223372036854775807i64, 1)[9223372036854775807] // MAX + 1
    #test(9223372036854775806i64, 1)[9223372036854775807] // MAX - 1 + 1
    #test(9223372036854775807i64, 9223372036854775807)[9223372036854775807] // MAX + MAX
    #test(-9223372036854775808i64, -1)[-9223372036854775808] // MIN + -1
    #test(-9223372036854775808i64, 9223372036854775807)[-1] // MIN + MAX
    #test(-9223372036854775807i64, -1)[-9223372036854775808] // MIN + 1 + -1
    fun saturating_add(self, other: int64) -> int64 {
        if add_overflows_i64(self, other) {
            return if other > 0 { MAX_I64 } else { MIN_I64 }
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5i64, 3)[2]
    #test(3i64, 5)[-2]
    #test(-9223372036854775808i64, 1)[-9223372036854775808] // MIN - 1
    #test(-9223372036854775807i64, 1)[-9223372036854775808] // MIN + 1 - 1
    #test(9223372036854775807i64, -1)[9223372036854775807] // MAX - -1
    #test(0i64, -9223372036854775808)[9223372036854775807] // 0 - MIN
    #test(-1i64, -9223372036854775808)[9223372036854775807] // -1 - MIN
    #test(9223372036854775807i64, 9223372036854775807)[0] // MAX - MAX
    fun saturating_sub(self, other: int64) -> int64 {
        if sub_overflows_i64(self, other) {
            return if other < 0 { MAX_I64 } else { MIN_I64 }
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6i64, 7)[42]
    #test(-6i64, 7)[-42]
    #test(9223372036854775807i64, 2)[9223372036854775807] // MAX * 2
    #test(4611686018427387903i64, 2)[9223372036854775806]
    #test(-9223372036854775808i64, -1)[9223372036854775807] // MIN * -1
    #test(-9223372036854775808i64, 1)[-9223372036854775808] // MIN * 1
    #test(-4611686018427387904i64, 2)[-9223372036854775808]
    #test(9223372036854775807i64, -1)[-9223372036854775807] // MAX * -1
    #test(0i64, 9223372036854775807)[0] // 0 * MAX
    #test(9223372036854775807i64, 9223372036854775807)[9223372036854775807] // MAX * MAX
    fun saturating_mul(self, other: int64) -> int64 {
        if mul_overflows_i64(self, other) {
            return if (self < 0) == (other < 0) { MAX_I64 } else { MIN_I64 }
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3i64, 4)[81]
    #test(2i64, 0)[1]
    #test(0i64, 0)[1]
    #test(0i64, 3)[0]
    #test(-2i64, 3)[-8]
    #test(-1i64, 7)[-1]
    #test(2i64, 62)[4611686018427387904]
    #test(2i64, 63)[9223372036854775807]
    #test(3i64, 40)[9223372036854775807]
    #test(-2i64, 63)[-9223372036854775808]
    fun saturating_pow(self, exp: uint32) -> int64 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => if self < 0 && (exp & 1) == 1 { MIN_I64 } else { MAX_I64 }
        }
    }

    // `self + other` modulo 2^64, and whether it didn't fit.
    #test(2i64, 3)[(5, false)]
    #test(-7i64, 3)[(-4, false)]
    #test(9223372036854775807i64, 1)[(-9223372036854775808, true)] // MAX + 1
    #test(9223372036854775806i64, 1)[(9223372036854775807, false)] // MAX - 1 + 1
    #test(9223372036854775807i64, 9223372036854775807)[(-2, true)] // MAX + MAX
    #test(-9223372036854775808i64, -1)[(9223372036854775807, true)] // MIN + -1
    #test(-9223372036854775808i64, 9223372036854775807)[(-1, false)] // MIN + MAX
    #test(-9223372036854775807i64, -1)[(-9223372036854775808, false)] // MIN + 1 + -1
    fun overflowing_add(self, other: int64) -> (int64, bool) {
        return (self + other, add_overflows_i64(self, other))
    }

    // `self - other` modulo 2^64, and whether it didn't fit.
    #test(5i64, 3)[(2, false)]
    #test(3i64, 5)[(-2, false)]
    #test(-9223372036854775808i64, 1)[(9223372036854775807, true)] // MIN - 1
    #test(-9223372036854775807i64, 1)[(-9223372036854775808, false)] // MIN + 1 - 1
    #test(9223372036854775807i64, -1)[(-9223372036854775808, true)] // MAX - -1
    #test(0i64, -9223372036854775808)[(-9223372036854775808, true)] // 0 - MIN
    #test(-1i64, -9223372036854775808)[(9223372036854775807, false)] // -1 - MIN
    #test(9223372036854775807i64, 9223372036854775807)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: int64) -> (int64, bool) {
        return (self - other, sub_overflows_i64(self, other))
    }

    // `self * other` modulo 2^64, and whether it didn't fit.
    #test(6i64, 7)[(42, false)]
    #test(-6i64, 7)[(-42, false)]
    #test(9223372036854775807i64, 2)[(-2, true)] // MAX * 2
    #test(4611686018427387903i64, 2)[(9223372036854775806, false)]
    #test(-9223372036854775808i64, -1)[(-9223372036854775808, true)] // MIN * -1
    #test(-9223372036854775808i64, 1)[(-9223372036854775808, false)] // MIN * 1
    #test(-4611686018427387904i64, 2)[(-9223372036854775808, false)]
    #test(9223372036854775807i64, -1)[(-9223372036854775807, false)] // MAX * -1
    #test(0i64, 9223372036854775807)[(0, false)] // 0 * MAX
    #test(9223372036854775807i64, 9223372036854775807)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: int64) -> (int64, bool) {
        return (self * other, mul_overflows_i64(self, other))
    }

    // `-self` modulo 2^64, and whether it didn't fit.
    #test(5i64)[(-5, false)]
    #test(-5i64)[(5, false)]
    #test(0i64)[(0, false)]
    #test(9223372036854775807i64)[(-9223372036854775807, false)]
    #test(-9223372036854775808i64)[(-9223372036854775808, true)]
    #test(-9223372036854775807i64)[(9223372036854775807, false)]
    fun overflowing_neg(self) -> (int64, bool) {
        return (0 - self, self == MIN_I64)
    }

    // The number to the power `exp` modulo 2^64, and whether it didn't fit.
    #test(3i64, 4)[(81, false)]
    #test(2i64, 0)[(1, false)]
    #test(0i64, 0)[(1, false)]
    #test(0i64, 3)[(0, false)]
    #test(-2i64, 3)[(-8, false)]
    #test(-1i64, 7)[(-1, false)]
    #test(2i64, 62)[(4611686018427387904, false)]
    #test(2i64, 63)[(-9223372036854775808, true)]
    #test(3i64, 40)[(-6289078614652622815, true)]
    #test(-2i64, 63)[(-9223372036854775808, false)]
    fun overflowing_pow(self, exp: uint32) -> (int64, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7i64, 8, 5)[1]
    #test(-7i64, 8, 5)[4]
    #test(7i64, -8, 5)[4]
    #test(9223372036854775807i64, 9223372036854775807, 9223372036854775806)[1] // MAX, MAX, MAX - 1
    #test(9223372036854775807i64, 9223372036854775807, 9223372036854775807)[0] // MAX, MAX, MAX
    #test(9223372036854775806i64, 9223372036854775805, 9223372036854775807)[2] // MAX - 1, 9223372036854775805, MAX
    #test(-9223372036854775808i64, -9223372036854775808, 9223372036854775807)[1] // MIN, MIN, MAX
    #test(-9223372036854775808i64, 3, 1000)[576] // MIN, 3, 1000
    #test(3i64, 4, 1)[0]
    #test(3i64, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    #test(3i64, 4, -5)[panic("mulmod: the modulus must be positive, not -5")]
    fun mulmod(self, other: int64, m: int64) -> int64 {
        if m <= 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        var a = self.rem_euclid(m)
        var b = other.rem_euclid(m)
        if a <= 3037000499 && b <= 3037000499 {
            return a * b % m
        }
        // Double and add: addmod adds only below m, so nothing overflows.
        var r: int64 = 0
        while b > 0 {
            if (b & 1) == 1 {
                r = addmod_i64(r, a, m)
            }
            a = addmod_i64(a, a, m)
            b = b >> 1
        }
        return r
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive and `exp` not negative.
    #test(2i64, 10, 1000)[24]
    #test(3i64, 0, 7)[1]
    #test(3i64, 0, 1)[0]
    #test(-2i64, 3, 7)[6]
    #test(0i64, 0, 5)[1]
    #test(2i64, 9223372036854775782, 9223372036854775783)[1]
    #test(9223372036854775807i64, 9223372036854775807, 9223372036854775783)[86762353606963200] // MAX, MAX, 9223372036854775783
    #test(9223372036854775806i64, 3, 9223372036854775807)[9223372036854775806] // MAX - 1, 3, MAX
    #test(5i64, 0, 9223372036854775807)[1] // 5, 0, MAX
    #test(2i64, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    #test(2i64, -1, 7)[panic("powmod: the exponent must not be negative, not -1")]
    fun powmod(self, exp: int64, m: int64) -> int64 {
        if m <= 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        if exp < 0 {
            panic(f"powmod: the exponent must not be negative, not {exp}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: int64 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3i64, 7)[Some(5)]
    #test(-3i64, 7)[Some(2)]
    #test(4i64, 8)[None]
    #test(0i64, 7)[None]
    #test(5i64, 1)[Some(0)]
    #test(10i64, 17)[Some(12)]
    #test(9223372036854775807i64, 9223372036854775783)[Some(6533221859438799513)] // MAX mod 9223372036854775783
    #test(2i64, 9223372036854775807)[Some(4611686018427387904)] // 2 mod MAX
    #test(3i64, 0)[panic("modinv: the modulus must be positive, not 0")]
    #test(3i64, -7)[panic("modinv: the modulus must be positive, not -7")]
    fun modinv(self, m: int64) -> Option<int64> {
        if m <= 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: int64 = 0
        var t1: int64 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

impl uint8 {
    // The smaller of the two.
    #test(3u8, 4)[3]
    #test(4u8, 3)[3]
    #test(0u8, 255)[0]
    #test(5u8, 5)[5]
    fun min(self, other: uint8) -> uint8 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3u8, 4)[4]
    #test(4u8, 3)[4]
    #test(0u8, 255)[255]
    #test(5u8, 5)[5]
    fun max(self, other: uint8) -> uint8 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5u8, 0, 10)[5]
    #test(15u8, 0, 10)[10]
    #test(0u8, 0, 0)[0]
    #test(255u8, 0, 3)[3]
    #test(7u8, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: uint8, hi: uint8) -> uint8 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3u8, 4)[81]
    #test(2u8, 0)[1]
    #test(0u8, 0)[1]
    #test(0u8, 3)[0]
    #test(2u8, 7)[128]
    #test(2u8, 8)[0] // wraps
    #test(3u8, 40)[33] // wraps
    fun pow(self, exp: uint32) -> uint8 {
        var base = self
        var e = exp
        var acc: uint8 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor; `0.gcd(0)` is 0.
    #test(12u8, 18)[6]
    #test(0u8, 5)[5]
    #test(0u8, 0)[0]
    #test(17u8, 5)[1]
    #test(255u8, 254)[1]
    fun gcd(self, other: uint8) -> uint8 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a
    }

    // The least common multiple; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4u8, 6)[12]
    #test(0u8, 6)[0]
    #test(21u8, 6)[42]
    #test(255u8, 1)[255]
    fun lcm(self, other: uint8) -> uint8 {
        if self == 0 || other == 0 {
            return 0
        }
        return self / self.gcd(other) * other
    }

    // The quotient of Euclidean division; for an unsigned number `/`.
    #test(7u8, 3)[2]
    #test(6u8, 3)[2]
    #test(255u8, 10)[25]
    fun div_euclid(self, other: uint8) -> uint8 {
        return self / other
    }

    // The remainder of Euclidean division; for an unsigned number `%`.
    #test(7u8, 3)[1]
    #test(6u8, 3)[0]
    #test(255u8, 10)[5]
    fun rem_euclid(self, other: uint8) -> uint8 {
        return self % other
    }

    // The number of bits set.
    #test(0u8)[0]
    #test(1u8)[1]
    #test(2u8)[1]
    #test(80u8)[2]
    #test(64u8)[1]
    #test(255u8)[8] // MAX
    #test(254u8)[7] // MAX - 1
    #test(85u8)[4]
    fun count_ones(self) -> int {
        let v: uint64 = self as uint64
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 8 for 0.
    #test(0u8)[8]
    #test(1u8)[7]
    #test(2u8)[6]
    #test(80u8)[1]
    #test(64u8)[1]
    #test(255u8)[0] // MAX
    #test(254u8)[0] // MAX - 1
    #test(85u8)[1]
    fun leading_zeros(self) -> int {
        var x: uint64 = self as uint64
        if x == 0 {
            return 8
        }
        var n = 7
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 8 for 0.
    #test(0u8)[8]
    #test(1u8)[0]
    #test(2u8)[1]
    #test(80u8)[4]
    #test(64u8)[6]
    #test(255u8)[0] // MAX
    #test(254u8)[1] // MAX - 1
    #test(85u8)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = self as uint64
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1) & 0xFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2u8, 3)[Some(5)]
    #test(255u8, 1)[None] // MAX + 1
    #test(254u8, 1)[Some(255)] // MAX - 1 + 1
    #test(255u8, 255)[None] // MAX + MAX
    #test(0u8, 255)[Some(255)] // 0 + MAX
    fun checked_add(self, other: uint8) -> Option<uint8> {
        return if add_overflows_u8(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5u8, 3)[Some(2)]
    #test(3u8, 5)[None]
    #test(0u8, 1)[None]
    #test(1u8, 1)[Some(0)]
    #test(0u8, 0)[Some(0)]
    #test(255u8, 255)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: uint8) -> Option<uint8> {
        return if sub_overflows_u8(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6u8, 7)[Some(42)]
    #test(255u8, 2)[None] // MAX * 2
    #test(127u8, 2)[Some(254)]
    #test(0u8, 1)[Some(0)]
    #test(0u8, 2)[Some(0)]
    #test(0u8, 255)[Some(0)] // 0 * MAX
    #test(255u8, 255)[None] // MAX * MAX
    fun checked_mul(self, other: uint8) -> Option<uint8> {
        return if mul_overflows_u8(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0.
    #test(7u8, 2)[Some(3)]
    #test(7u8, 0)[None]
    #test(255u8, 255)[Some(1)] // MAX / MAX
    fun checked_div(self, other: uint8) -> Option<uint8> {
        return if other == 0 { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0.
    #test(7u8, 2)[Some(1)]
    #test(7u8, 0)[None]
    #test(255u8, 255)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: uint8) -> Option<uint8> {
        return if other == 0 { None } else { Some(self % other) }
    }

    // `-self`: `Some(0)` for 0, `None` for any other unsigned number.
    #test(5u8)[None]
    #test(0u8)[Some(0)]
    #test(255u8)[None]
    #test(1u8)[None]
    fun checked_neg(self) -> Option<uint8> {
        return if self == 0 { Some(0) } else { None }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3u8, 4)[Some(81)]
    #test(2u8, 0)[Some(1)]
    #test(0u8, 0)[Some(1)]
    #test(0u8, 3)[Some(0)]
    #test(2u8, 7)[Some(128)]
    #test(2u8, 8)[None]
    #test(3u8, 40)[None]
    fun checked_pow(self, exp: uint32) -> Option<uint8> {
        var base = self
        var e = exp
        var acc: uint8 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^8.
    #test(3u8, 4)[81]
    #test(2u8, 0)[1]
    #test(0u8, 0)[1]
    #test(0u8, 3)[0]
    #test(2u8, 7)[128]
    #test(2u8, 8)[0] // wraps
    #test(3u8, 40)[33] // wraps
    fun wrapping_pow(self, exp: uint32) -> uint8 {
        var base = self
        var e = exp
        var acc: uint8 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2u8, 3)[5]
    #test(255u8, 1)[255] // MAX + 1
    #test(254u8, 1)[255] // MAX - 1 + 1
    #test(255u8, 255)[255] // MAX + MAX
    #test(0u8, 255)[255] // 0 + MAX
    fun saturating_add(self, other: uint8) -> uint8 {
        if add_overflows_u8(self, other) {
            return MAX_U8
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5u8, 3)[2]
    #test(3u8, 5)[0]
    #test(0u8, 1)[0]
    #test(1u8, 1)[0]
    #test(0u8, 0)[0]
    #test(255u8, 255)[0] // MAX - MAX
    fun saturating_sub(self, other: uint8) -> uint8 {
        if sub_overflows_u8(self, other) {
            return 0
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6u8, 7)[42]
    #test(255u8, 2)[255] // MAX * 2
    #test(127u8, 2)[254]
    #test(0u8, 1)[0]
    #test(0u8, 2)[0]
    #test(0u8, 255)[0] // 0 * MAX
    #test(255u8, 255)[255] // MAX * MAX
    fun saturating_mul(self, other: uint8) -> uint8 {
        if mul_overflows_u8(self, other) {
            return MAX_U8
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3u8, 4)[81]
    #test(2u8, 0)[1]
    #test(0u8, 0)[1]
    #test(0u8, 3)[0]
    #test(2u8, 7)[128]
    #test(2u8, 8)[255]
    #test(3u8, 40)[255]
    fun saturating_pow(self, exp: uint32) -> uint8 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => MAX_U8
        }
    }

    // `self + other` modulo 2^8, and whether it didn't fit.
    #test(2u8, 3)[(5, false)]
    #test(255u8, 1)[(0, true)] // MAX + 1
    #test(254u8, 1)[(255, false)] // MAX - 1 + 1
    #test(255u8, 255)[(254, true)] // MAX + MAX
    #test(0u8, 255)[(255, false)] // 0 + MAX
    fun overflowing_add(self, other: uint8) -> (uint8, bool) {
        return (self + other, add_overflows_u8(self, other))
    }

    // `self - other` modulo 2^8, and whether it didn't fit.
    #test(5u8, 3)[(2, false)]
    #test(3u8, 5)[(254, true)]
    #test(0u8, 1)[(255, true)]
    #test(1u8, 1)[(0, false)]
    #test(0u8, 0)[(0, false)]
    #test(255u8, 255)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: uint8) -> (uint8, bool) {
        return (self - other, sub_overflows_u8(self, other))
    }

    // `self * other` modulo 2^8, and whether it didn't fit.
    #test(6u8, 7)[(42, false)]
    #test(255u8, 2)[(254, true)] // MAX * 2
    #test(127u8, 2)[(254, false)]
    #test(0u8, 1)[(0, false)]
    #test(0u8, 2)[(0, false)]
    #test(0u8, 255)[(0, false)] // 0 * MAX
    #test(255u8, 255)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: uint8) -> (uint8, bool) {
        return (self * other, mul_overflows_u8(self, other))
    }

    // `-self` modulo 2^8, and whether it didn't fit.
    #test(5u8)[(251, true)]
    #test(0u8)[(0, false)]
    #test(255u8)[(1, true)]
    #test(1u8)[(255, true)]
    fun overflowing_neg(self) -> (uint8, bool) {
        return (0 - self, self != 0)
    }

    // The number to the power `exp` modulo 2^8, and whether it didn't fit.
    #test(3u8, 4)[(81, false)]
    #test(2u8, 0)[(1, false)]
    #test(0u8, 0)[(1, false)]
    #test(0u8, 3)[(0, false)]
    #test(2u8, 7)[(128, false)]
    #test(2u8, 8)[(0, true)]
    #test(3u8, 40)[(33, true)]
    fun overflowing_pow(self, exp: uint32) -> (uint8, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7u8, 8, 5)[1]
    #test(255u8, 255, 254)[1] // MAX, MAX, MAX - 1
    #test(255u8, 255, 255)[0] // MAX, MAX, MAX
    #test(254u8, 253, 255)[2] // MAX - 1, 253, MAX
    #test(0u8, 0, 255)[0] // 0, 0, MAX
    #test(3u8, 4, 1)[0]
    #test(3u8, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    fun mulmod(self, other: uint8, m: uint8) -> uint8 {
        if m == 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        return ((self as uint64) * (other as uint64) % (m as uint64)) as uint8
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive.
    #test(3u8, 0, 7)[1]
    #test(3u8, 0, 1)[0]
    #test(0u8, 0, 5)[1]
    #test(2u8, 250, 251)[1]
    #test(255u8, 255, 251)[20] // MAX, MAX, 251
    #test(254u8, 3, 255)[254] // MAX - 1, 3, MAX
    #test(5u8, 0, 255)[1] // 5, 0, MAX
    #test(2u8, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    fun powmod(self, exp: uint8, m: uint8) -> uint8 {
        if m == 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: uint8 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3u8, 7)[Some(5)]
    #test(4u8, 8)[None]
    #test(0u8, 7)[None]
    #test(5u8, 1)[Some(0)]
    #test(10u8, 17)[Some(12)]
    #test(255u8, 251)[Some(63)] // MAX mod 251
    #test(2u8, 255)[Some(128)] // 2 mod MAX
    #test(3u8, 0)[panic("modinv: the modulus must be positive, not 0")]
    fun modinv(self, m: uint8) -> Option<uint8> {
        if m == 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: uint8 = 0
        var t1: uint8 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

impl uint16 {
    // The smaller of the two.
    #test(3u16, 4)[3]
    #test(4u16, 3)[3]
    #test(0u16, 65535)[0]
    #test(5u16, 5)[5]
    fun min(self, other: uint16) -> uint16 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3u16, 4)[4]
    #test(4u16, 3)[4]
    #test(0u16, 65535)[65535]
    #test(5u16, 5)[5]
    fun max(self, other: uint16) -> uint16 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5u16, 0, 10)[5]
    #test(15u16, 0, 10)[10]
    #test(0u16, 0, 0)[0]
    #test(65535u16, 0, 3)[3]
    #test(7u16, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: uint16, hi: uint16) -> uint16 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3u16, 4)[81]
    #test(2u16, 0)[1]
    #test(0u16, 0)[1]
    #test(0u16, 3)[0]
    #test(2u16, 15)[32768]
    #test(2u16, 16)[0] // wraps
    #test(3u16, 40)[59425] // wraps
    fun pow(self, exp: uint32) -> uint16 {
        var base = self
        var e = exp
        var acc: uint16 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor; `0.gcd(0)` is 0.
    #test(12u16, 18)[6]
    #test(0u16, 5)[5]
    #test(0u16, 0)[0]
    #test(17u16, 5)[1]
    #test(65535u16, 65534)[1]
    fun gcd(self, other: uint16) -> uint16 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a
    }

    // The least common multiple; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4u16, 6)[12]
    #test(0u16, 6)[0]
    #test(21u16, 6)[42]
    #test(65535u16, 1)[65535]
    fun lcm(self, other: uint16) -> uint16 {
        if self == 0 || other == 0 {
            return 0
        }
        return self / self.gcd(other) * other
    }

    // The quotient of Euclidean division; for an unsigned number `/`.
    #test(7u16, 3)[2]
    #test(6u16, 3)[2]
    #test(65535u16, 10)[6553]
    fun div_euclid(self, other: uint16) -> uint16 {
        return self / other
    }

    // The remainder of Euclidean division; for an unsigned number `%`.
    #test(7u16, 3)[1]
    #test(6u16, 3)[0]
    #test(65535u16, 10)[5]
    fun rem_euclid(self, other: uint16) -> uint16 {
        return self % other
    }

    // The number of bits set.
    #test(0u16)[0]
    #test(1u16)[1]
    #test(2u16)[1]
    #test(80u16)[2]
    #test(16384u16)[1]
    #test(65535u16)[16] // MAX
    #test(65534u16)[15] // MAX - 1
    #test(21845u16)[8]
    fun count_ones(self) -> int {
        let v: uint64 = self as uint64
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 16 for 0.
    #test(0u16)[16]
    #test(1u16)[15]
    #test(2u16)[14]
    #test(80u16)[9]
    #test(16384u16)[1]
    #test(65535u16)[0] // MAX
    #test(65534u16)[0] // MAX - 1
    #test(21845u16)[1]
    fun leading_zeros(self) -> int {
        var x: uint64 = self as uint64
        if x == 0 {
            return 16
        }
        var n = 15
        if x >> 8 != 0 {
            n -= 8
            x = x >> 8
        }
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 16 for 0.
    #test(0u16)[16]
    #test(1u16)[0]
    #test(2u16)[1]
    #test(80u16)[4]
    #test(16384u16)[14]
    #test(65535u16)[0] // MAX
    #test(65534u16)[1] // MAX - 1
    #test(21845u16)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = self as uint64
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1) & 0xFFFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2u16, 3)[Some(5)]
    #test(65535u16, 1)[None] // MAX + 1
    #test(65534u16, 1)[Some(65535)] // MAX - 1 + 1
    #test(65535u16, 65535)[None] // MAX + MAX
    #test(0u16, 65535)[Some(65535)] // 0 + MAX
    fun checked_add(self, other: uint16) -> Option<uint16> {
        return if add_overflows_u16(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5u16, 3)[Some(2)]
    #test(3u16, 5)[None]
    #test(0u16, 1)[None]
    #test(1u16, 1)[Some(0)]
    #test(0u16, 0)[Some(0)]
    #test(65535u16, 65535)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: uint16) -> Option<uint16> {
        return if sub_overflows_u16(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6u16, 7)[Some(42)]
    #test(65535u16, 2)[None] // MAX * 2
    #test(32767u16, 2)[Some(65534)]
    #test(0u16, 1)[Some(0)]
    #test(0u16, 2)[Some(0)]
    #test(0u16, 65535)[Some(0)] // 0 * MAX
    #test(65535u16, 65535)[None] // MAX * MAX
    fun checked_mul(self, other: uint16) -> Option<uint16> {
        return if mul_overflows_u16(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0.
    #test(7u16, 2)[Some(3)]
    #test(7u16, 0)[None]
    #test(65535u16, 65535)[Some(1)] // MAX / MAX
    fun checked_div(self, other: uint16) -> Option<uint16> {
        return if other == 0 { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0.
    #test(7u16, 2)[Some(1)]
    #test(7u16, 0)[None]
    #test(65535u16, 65535)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: uint16) -> Option<uint16> {
        return if other == 0 { None } else { Some(self % other) }
    }

    // `-self`: `Some(0)` for 0, `None` for any other unsigned number.
    #test(5u16)[None]
    #test(0u16)[Some(0)]
    #test(65535u16)[None]
    #test(1u16)[None]
    fun checked_neg(self) -> Option<uint16> {
        return if self == 0 { Some(0) } else { None }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3u16, 4)[Some(81)]
    #test(2u16, 0)[Some(1)]
    #test(0u16, 0)[Some(1)]
    #test(0u16, 3)[Some(0)]
    #test(2u16, 15)[Some(32768)]
    #test(2u16, 16)[None]
    #test(3u16, 40)[None]
    fun checked_pow(self, exp: uint32) -> Option<uint16> {
        var base = self
        var e = exp
        var acc: uint16 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^16.
    #test(3u16, 4)[81]
    #test(2u16, 0)[1]
    #test(0u16, 0)[1]
    #test(0u16, 3)[0]
    #test(2u16, 15)[32768]
    #test(2u16, 16)[0] // wraps
    #test(3u16, 40)[59425] // wraps
    fun wrapping_pow(self, exp: uint32) -> uint16 {
        var base = self
        var e = exp
        var acc: uint16 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2u16, 3)[5]
    #test(65535u16, 1)[65535] // MAX + 1
    #test(65534u16, 1)[65535] // MAX - 1 + 1
    #test(65535u16, 65535)[65535] // MAX + MAX
    #test(0u16, 65535)[65535] // 0 + MAX
    fun saturating_add(self, other: uint16) -> uint16 {
        if add_overflows_u16(self, other) {
            return MAX_U16
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5u16, 3)[2]
    #test(3u16, 5)[0]
    #test(0u16, 1)[0]
    #test(1u16, 1)[0]
    #test(0u16, 0)[0]
    #test(65535u16, 65535)[0] // MAX - MAX
    fun saturating_sub(self, other: uint16) -> uint16 {
        if sub_overflows_u16(self, other) {
            return 0
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6u16, 7)[42]
    #test(65535u16, 2)[65535] // MAX * 2
    #test(32767u16, 2)[65534]
    #test(0u16, 1)[0]
    #test(0u16, 2)[0]
    #test(0u16, 65535)[0] // 0 * MAX
    #test(65535u16, 65535)[65535] // MAX * MAX
    fun saturating_mul(self, other: uint16) -> uint16 {
        if mul_overflows_u16(self, other) {
            return MAX_U16
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3u16, 4)[81]
    #test(2u16, 0)[1]
    #test(0u16, 0)[1]
    #test(0u16, 3)[0]
    #test(2u16, 15)[32768]
    #test(2u16, 16)[65535]
    #test(3u16, 40)[65535]
    fun saturating_pow(self, exp: uint32) -> uint16 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => MAX_U16
        }
    }

    // `self + other` modulo 2^16, and whether it didn't fit.
    #test(2u16, 3)[(5, false)]
    #test(65535u16, 1)[(0, true)] // MAX + 1
    #test(65534u16, 1)[(65535, false)] // MAX - 1 + 1
    #test(65535u16, 65535)[(65534, true)] // MAX + MAX
    #test(0u16, 65535)[(65535, false)] // 0 + MAX
    fun overflowing_add(self, other: uint16) -> (uint16, bool) {
        return (self + other, add_overflows_u16(self, other))
    }

    // `self - other` modulo 2^16, and whether it didn't fit.
    #test(5u16, 3)[(2, false)]
    #test(3u16, 5)[(65534, true)]
    #test(0u16, 1)[(65535, true)]
    #test(1u16, 1)[(0, false)]
    #test(0u16, 0)[(0, false)]
    #test(65535u16, 65535)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: uint16) -> (uint16, bool) {
        return (self - other, sub_overflows_u16(self, other))
    }

    // `self * other` modulo 2^16, and whether it didn't fit.
    #test(6u16, 7)[(42, false)]
    #test(65535u16, 2)[(65534, true)] // MAX * 2
    #test(32767u16, 2)[(65534, false)]
    #test(0u16, 1)[(0, false)]
    #test(0u16, 2)[(0, false)]
    #test(0u16, 65535)[(0, false)] // 0 * MAX
    #test(65535u16, 65535)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: uint16) -> (uint16, bool) {
        return (self * other, mul_overflows_u16(self, other))
    }

    // `-self` modulo 2^16, and whether it didn't fit.
    #test(5u16)[(65531, true)]
    #test(0u16)[(0, false)]
    #test(65535u16)[(1, true)]
    #test(1u16)[(65535, true)]
    fun overflowing_neg(self) -> (uint16, bool) {
        return (0 - self, self != 0)
    }

    // The number to the power `exp` modulo 2^16, and whether it didn't fit.
    #test(3u16, 4)[(81, false)]
    #test(2u16, 0)[(1, false)]
    #test(0u16, 0)[(1, false)]
    #test(0u16, 3)[(0, false)]
    #test(2u16, 15)[(32768, false)]
    #test(2u16, 16)[(0, true)]
    #test(3u16, 40)[(59425, true)]
    fun overflowing_pow(self, exp: uint32) -> (uint16, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7u16, 8, 5)[1]
    #test(65535u16, 65535, 65534)[1] // MAX, MAX, MAX - 1
    #test(65535u16, 65535, 65535)[0] // MAX, MAX, MAX
    #test(65534u16, 65533, 65535)[2] // MAX - 1, 65533, MAX
    #test(0u16, 0, 65535)[0] // 0, 0, MAX
    #test(0u16, 3, 1000)[0]
    #test(3u16, 4, 1)[0]
    #test(3u16, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    fun mulmod(self, other: uint16, m: uint16) -> uint16 {
        if m == 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        return ((self as uint64) * (other as uint64) % (m as uint64)) as uint16
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive.
    #test(2u16, 10, 1000)[24]
    #test(3u16, 0, 7)[1]
    #test(3u16, 0, 1)[0]
    #test(0u16, 0, 5)[1]
    #test(2u16, 65520, 65521)[1]
    #test(65535u16, 65535, 65521)[18532] // MAX, MAX, 65521
    #test(65534u16, 3, 65535)[65534] // MAX - 1, 3, MAX
    #test(5u16, 0, 65535)[1] // 5, 0, MAX
    #test(2u16, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    fun powmod(self, exp: uint16, m: uint16) -> uint16 {
        if m == 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: uint16 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3u16, 7)[Some(5)]
    #test(4u16, 8)[None]
    #test(0u16, 7)[None]
    #test(5u16, 1)[Some(0)]
    #test(10u16, 17)[Some(12)]
    #test(65535u16, 65521)[Some(60841)] // MAX mod 65521
    #test(2u16, 65535)[Some(32768)] // 2 mod MAX
    #test(3u16, 0)[panic("modinv: the modulus must be positive, not 0")]
    fun modinv(self, m: uint16) -> Option<uint16> {
        if m == 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: uint16 = 0
        var t1: uint16 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

impl uint32 {
    // The smaller of the two.
    #test(3u32, 4)[3]
    #test(4u32, 3)[3]
    #test(0u32, 4294967295)[0]
    #test(5u32, 5)[5]
    fun min(self, other: uint32) -> uint32 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3u32, 4)[4]
    #test(4u32, 3)[4]
    #test(0u32, 4294967295)[4294967295]
    #test(5u32, 5)[5]
    fun max(self, other: uint32) -> uint32 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5u32, 0, 10)[5]
    #test(15u32, 0, 10)[10]
    #test(0u32, 0, 0)[0]
    #test(4294967295u32, 0, 3)[3]
    #test(7u32, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: uint32, hi: uint32) -> uint32 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3u32, 4)[81]
    #test(2u32, 0)[1]
    #test(0u32, 0)[1]
    #test(0u32, 3)[0]
    #test(2u32, 31)[2147483648]
    #test(2u32, 32)[0] // wraps
    #test(3u32, 40)[689956897] // wraps
    fun pow(self, exp: uint32) -> uint32 {
        var base = self
        var e = exp
        var acc: uint32 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor; `0.gcd(0)` is 0.
    #test(12u32, 18)[6]
    #test(0u32, 5)[5]
    #test(0u32, 0)[0]
    #test(17u32, 5)[1]
    #test(4294967295u32, 4294967294)[1]
    fun gcd(self, other: uint32) -> uint32 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a
    }

    // The least common multiple; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4u32, 6)[12]
    #test(0u32, 6)[0]
    #test(21u32, 6)[42]
    #test(4294967295u32, 1)[4294967295]
    fun lcm(self, other: uint32) -> uint32 {
        if self == 0 || other == 0 {
            return 0
        }
        return self / self.gcd(other) * other
    }

    // The quotient of Euclidean division; for an unsigned number `/`.
    #test(7u32, 3)[2]
    #test(6u32, 3)[2]
    #test(4294967295u32, 10)[429496729]
    fun div_euclid(self, other: uint32) -> uint32 {
        return self / other
    }

    // The remainder of Euclidean division; for an unsigned number `%`.
    #test(7u32, 3)[1]
    #test(6u32, 3)[0]
    #test(4294967295u32, 10)[5]
    fun rem_euclid(self, other: uint32) -> uint32 {
        return self % other
    }

    // The number of bits set.
    #test(0u32)[0]
    #test(1u32)[1]
    #test(2u32)[1]
    #test(80u32)[2]
    #test(1073741824u32)[1]
    #test(4294967295u32)[32] // MAX
    #test(4294967294u32)[31] // MAX - 1
    #test(21845u32)[8]
    fun count_ones(self) -> int {
        let v: uint64 = self as uint64
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 32 for 0.
    #test(0u32)[32]
    #test(1u32)[31]
    #test(2u32)[30]
    #test(80u32)[25]
    #test(1073741824u32)[1]
    #test(4294967295u32)[0] // MAX
    #test(4294967294u32)[0] // MAX - 1
    #test(21845u32)[17]
    fun leading_zeros(self) -> int {
        var x: uint64 = self as uint64
        if x == 0 {
            return 32
        }
        var n = 31
        if x >> 16 != 0 {
            n -= 16
            x = x >> 16
        }
        if x >> 8 != 0 {
            n -= 8
            x = x >> 8
        }
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 32 for 0.
    #test(0u32)[32]
    #test(1u32)[0]
    #test(2u32)[1]
    #test(80u32)[4]
    #test(1073741824u32)[30]
    #test(4294967295u32)[0] // MAX
    #test(4294967294u32)[1] // MAX - 1
    #test(21845u32)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = self as uint64
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1) & 0xFFFFFFFF
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2u32, 3)[Some(5)]
    #test(4294967295u32, 1)[None] // MAX + 1
    #test(4294967294u32, 1)[Some(4294967295)] // MAX - 1 + 1
    #test(4294967295u32, 4294967295)[None] // MAX + MAX
    #test(0u32, 4294967295)[Some(4294967295)] // 0 + MAX
    fun checked_add(self, other: uint32) -> Option<uint32> {
        return if add_overflows_u32(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5u32, 3)[Some(2)]
    #test(3u32, 5)[None]
    #test(0u32, 1)[None]
    #test(1u32, 1)[Some(0)]
    #test(0u32, 0)[Some(0)]
    #test(4294967295u32, 4294967295)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: uint32) -> Option<uint32> {
        return if sub_overflows_u32(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6u32, 7)[Some(42)]
    #test(4294967295u32, 2)[None] // MAX * 2
    #test(2147483647u32, 2)[Some(4294967294)]
    #test(0u32, 1)[Some(0)]
    #test(0u32, 2)[Some(0)]
    #test(0u32, 4294967295)[Some(0)] // 0 * MAX
    #test(4294967295u32, 4294967295)[None] // MAX * MAX
    fun checked_mul(self, other: uint32) -> Option<uint32> {
        return if mul_overflows_u32(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0.
    #test(7u32, 2)[Some(3)]
    #test(7u32, 0)[None]
    #test(4294967295u32, 4294967295)[Some(1)] // MAX / MAX
    fun checked_div(self, other: uint32) -> Option<uint32> {
        return if other == 0 { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0.
    #test(7u32, 2)[Some(1)]
    #test(7u32, 0)[None]
    #test(4294967295u32, 4294967295)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: uint32) -> Option<uint32> {
        return if other == 0 { None } else { Some(self % other) }
    }

    // `-self`: `Some(0)` for 0, `None` for any other unsigned number.
    #test(5u32)[None]
    #test(0u32)[Some(0)]
    #test(4294967295u32)[None]
    #test(1u32)[None]
    fun checked_neg(self) -> Option<uint32> {
        return if self == 0 { Some(0) } else { None }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3u32, 4)[Some(81)]
    #test(2u32, 0)[Some(1)]
    #test(0u32, 0)[Some(1)]
    #test(0u32, 3)[Some(0)]
    #test(2u32, 31)[Some(2147483648)]
    #test(2u32, 32)[None]
    #test(3u32, 40)[None]
    fun checked_pow(self, exp: uint32) -> Option<uint32> {
        var base = self
        var e = exp
        var acc: uint32 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^32.
    #test(3u32, 4)[81]
    #test(2u32, 0)[1]
    #test(0u32, 0)[1]
    #test(0u32, 3)[0]
    #test(2u32, 31)[2147483648]
    #test(2u32, 32)[0] // wraps
    #test(3u32, 40)[689956897] // wraps
    fun wrapping_pow(self, exp: uint32) -> uint32 {
        var base = self
        var e = exp
        var acc: uint32 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2u32, 3)[5]
    #test(4294967295u32, 1)[4294967295] // MAX + 1
    #test(4294967294u32, 1)[4294967295] // MAX - 1 + 1
    #test(4294967295u32, 4294967295)[4294967295] // MAX + MAX
    #test(0u32, 4294967295)[4294967295] // 0 + MAX
    fun saturating_add(self, other: uint32) -> uint32 {
        if add_overflows_u32(self, other) {
            return MAX_U32
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5u32, 3)[2]
    #test(3u32, 5)[0]
    #test(0u32, 1)[0]
    #test(1u32, 1)[0]
    #test(0u32, 0)[0]
    #test(4294967295u32, 4294967295)[0] // MAX - MAX
    fun saturating_sub(self, other: uint32) -> uint32 {
        if sub_overflows_u32(self, other) {
            return 0
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6u32, 7)[42]
    #test(4294967295u32, 2)[4294967295] // MAX * 2
    #test(2147483647u32, 2)[4294967294]
    #test(0u32, 1)[0]
    #test(0u32, 2)[0]
    #test(0u32, 4294967295)[0] // 0 * MAX
    #test(4294967295u32, 4294967295)[4294967295] // MAX * MAX
    fun saturating_mul(self, other: uint32) -> uint32 {
        if mul_overflows_u32(self, other) {
            return MAX_U32
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3u32, 4)[81]
    #test(2u32, 0)[1]
    #test(0u32, 0)[1]
    #test(0u32, 3)[0]
    #test(2u32, 31)[2147483648]
    #test(2u32, 32)[4294967295]
    #test(3u32, 40)[4294967295]
    fun saturating_pow(self, exp: uint32) -> uint32 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => MAX_U32
        }
    }

    // `self + other` modulo 2^32, and whether it didn't fit.
    #test(2u32, 3)[(5, false)]
    #test(4294967295u32, 1)[(0, true)] // MAX + 1
    #test(4294967294u32, 1)[(4294967295, false)] // MAX - 1 + 1
    #test(4294967295u32, 4294967295)[(4294967294, true)] // MAX + MAX
    #test(0u32, 4294967295)[(4294967295, false)] // 0 + MAX
    fun overflowing_add(self, other: uint32) -> (uint32, bool) {
        return (self + other, add_overflows_u32(self, other))
    }

    // `self - other` modulo 2^32, and whether it didn't fit.
    #test(5u32, 3)[(2, false)]
    #test(3u32, 5)[(4294967294, true)]
    #test(0u32, 1)[(4294967295, true)]
    #test(1u32, 1)[(0, false)]
    #test(0u32, 0)[(0, false)]
    #test(4294967295u32, 4294967295)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: uint32) -> (uint32, bool) {
        return (self - other, sub_overflows_u32(self, other))
    }

    // `self * other` modulo 2^32, and whether it didn't fit.
    #test(6u32, 7)[(42, false)]
    #test(4294967295u32, 2)[(4294967294, true)] // MAX * 2
    #test(2147483647u32, 2)[(4294967294, false)]
    #test(0u32, 1)[(0, false)]
    #test(0u32, 2)[(0, false)]
    #test(0u32, 4294967295)[(0, false)] // 0 * MAX
    #test(4294967295u32, 4294967295)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: uint32) -> (uint32, bool) {
        return (self * other, mul_overflows_u32(self, other))
    }

    // `-self` modulo 2^32, and whether it didn't fit.
    #test(5u32)[(4294967291, true)]
    #test(0u32)[(0, false)]
    #test(4294967295u32)[(1, true)]
    #test(1u32)[(4294967295, true)]
    fun overflowing_neg(self) -> (uint32, bool) {
        return (0 - self, self != 0)
    }

    // The number to the power `exp` modulo 2^32, and whether it didn't fit.
    #test(3u32, 4)[(81, false)]
    #test(2u32, 0)[(1, false)]
    #test(0u32, 0)[(1, false)]
    #test(0u32, 3)[(0, false)]
    #test(2u32, 31)[(2147483648, false)]
    #test(2u32, 32)[(0, true)]
    #test(3u32, 40)[(689956897, true)]
    fun overflowing_pow(self, exp: uint32) -> (uint32, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7u32, 8, 5)[1]
    #test(4294967295u32, 4294967295, 4294967294)[1] // MAX, MAX, MAX - 1
    #test(4294967295u32, 4294967295, 4294967295)[0] // MAX, MAX, MAX
    #test(4294967294u32, 4294967293, 4294967295)[2] // MAX - 1, 4294967293, MAX
    #test(0u32, 0, 4294967295)[0] // 0, 0, MAX
    #test(0u32, 3, 1000)[0]
    #test(3u32, 4, 1)[0]
    #test(3u32, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    fun mulmod(self, other: uint32, m: uint32) -> uint32 {
        if m == 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        return ((self as uint64) * (other as uint64) % (m as uint64)) as uint32
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive.
    #test(2u32, 10, 1000)[24]
    #test(3u32, 0, 7)[1]
    #test(3u32, 0, 1)[0]
    #test(0u32, 0, 5)[1]
    #test(2u32, 4294967290, 4294967291)[1]
    #test(4294967295u32, 4294967295, 4294967291)[1024] // MAX, MAX, 4294967291
    #test(4294967294u32, 3, 4294967295)[4294967294] // MAX - 1, 3, MAX
    #test(5u32, 0, 4294967295)[1] // 5, 0, MAX
    #test(2u32, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    fun powmod(self, exp: uint32, m: uint32) -> uint32 {
        if m == 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: uint32 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3u32, 7)[Some(5)]
    #test(4u32, 8)[None]
    #test(0u32, 7)[None]
    #test(5u32, 1)[Some(0)]
    #test(10u32, 17)[Some(12)]
    #test(4294967295u32, 4294967291)[Some(1073741823)] // MAX mod 4294967291
    #test(2u32, 4294967295)[Some(2147483648)] // 2 mod MAX
    #test(3u32, 0)[panic("modinv: the modulus must be positive, not 0")]
    fun modinv(self, m: uint32) -> Option<uint32> {
        if m == 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: uint32 = 0
        var t1: uint32 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

impl uint64 {
    // The smaller of the two.
    #test(3u64, 4)[3]
    #test(4u64, 3)[3]
    #test(0u64, 18446744073709551615)[0]
    #test(5u64, 5)[5]
    fun min(self, other: uint64) -> uint64 {
        return if other < self { other } else { self }
    }

    // The larger of the two.
    #test(3u64, 4)[4]
    #test(4u64, 3)[4]
    #test(0u64, 18446744073709551615)[18446744073709551615]
    #test(5u64, 5)[5]
    fun max(self, other: uint64) -> uint64 {
        return if other > self { other } else { self }
    }

    // The number held to `lo` to `hi`; `lo` above `hi` is a runtime error.
    #test(5u64, 0, 10)[5]
    #test(15u64, 0, 10)[10]
    #test(0u64, 0, 0)[0]
    #test(18446744073709551615u64, 0, 3)[3]
    #test(7u64, 10, 3)[panic("clamp: the minimum 10 is above the maximum 3")]
    fun clamp(self, lo: uint64, hi: uint64) -> uint64 {
        if lo > hi {
            panic(f"clamp: the minimum {lo} is above the maximum {hi}")
        }
        return if self < lo { lo } else if self > hi { hi } else { self }
    }

    // The number to the power `exp`, multiplied as `*` does: past the width
    // it wraps today (D4).
    #test(3u64, 4)[81]
    #test(2u64, 0)[1]
    #test(0u64, 0)[1]
    #test(0u64, 3)[0]
    #test(2u64, 63)[9223372036854775808]
    #test(2u64, 64)[0] // wraps
    #test(3u64, 40)[12157665459056928801]
    fun pow(self, exp: uint32) -> uint64 {
        var base = self
        var e = exp
        var acc: uint64 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // The greatest common divisor; `0.gcd(0)` is 0.
    #test(12u64, 18)[6]
    #test(0u64, 5)[5]
    #test(0u64, 0)[0]
    #test(17u64, 5)[1]
    #test(18446744073709551615u64, 18446744073709551614)[1]
    fun gcd(self, other: uint64) -> uint64 {
        var a = self
        var b = other
        while b != 0 {
            let r = a % b
            a = b
            b = r
        }
        return a
    }

    // The least common multiple; 0 if either is 0. Past the width it wraps
    // as `*` does.
    #test(4u64, 6)[12]
    #test(0u64, 6)[0]
    #test(21u64, 6)[42]
    #test(18446744073709551615u64, 1)[18446744073709551615]
    fun lcm(self, other: uint64) -> uint64 {
        if self == 0 || other == 0 {
            return 0
        }
        return self / self.gcd(other) * other
    }

    // The quotient of Euclidean division; for an unsigned number `/`.
    #test(7u64, 3)[2]
    #test(6u64, 3)[2]
    #test(18446744073709551615u64, 10)[1844674407370955161]
    fun div_euclid(self, other: uint64) -> uint64 {
        return self / other
    }

    // The remainder of Euclidean division; for an unsigned number `%`.
    #test(7u64, 3)[1]
    #test(6u64, 3)[0]
    #test(18446744073709551615u64, 10)[5]
    fun rem_euclid(self, other: uint64) -> uint64 {
        return self % other
    }

    // The number of bits set.
    #test(0u64)[0]
    #test(1u64)[1]
    #test(2u64)[1]
    #test(80u64)[2]
    #test(4611686018427387904u64)[1]
    #test(18446744073709551615u64)[64] // MAX
    #test(18446744073709551614u64)[63] // MAX - 1
    #test(21845u64)[8]
    fun count_ones(self) -> int {
        let v: uint64 = self
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // The number of zero bits above the highest one set: 64 for 0.
    #test(0u64)[64]
    #test(1u64)[63]
    #test(2u64)[62]
    #test(80u64)[57]
    #test(4611686018427387904u64)[1]
    #test(18446744073709551615u64)[0] // MAX
    #test(18446744073709551614u64)[0] // MAX - 1
    #test(21845u64)[49]
    fun leading_zeros(self) -> int {
        var x: uint64 = self
        if x == 0 {
            return 64
        }
        var n = 63
        if x >> 32 != 0 {
            n -= 32
            x = x >> 32
        }
        if x >> 16 != 0 {
            n -= 16
            x = x >> 16
        }
        if x >> 8 != 0 {
            n -= 8
            x = x >> 8
        }
        if x >> 4 != 0 {
            n -= 4
            x = x >> 4
        }
        if x >> 2 != 0 {
            n -= 2
            x = x >> 2
        }
        if x >> 1 != 0 {
            n -= 1
        }
        return n
    }

    // The number of zero bits below the lowest one set: 64 for 0.
    #test(0u64)[64]
    #test(1u64)[0]
    #test(2u64)[1]
    #test(80u64)[4]
    #test(4611686018427387904u64)[62]
    #test(18446744073709551615u64)[0] // MAX
    #test(18446744073709551614u64)[1] // MAX - 1
    #test(21845u64)[0]
    fun trailing_zeros(self) -> int {
        let b: uint64 = self
        // the bits below the lowest one set (all of them for 0), counted as
        // `count_ones` counts them: written out, as a method isn't inlined
        let v = ((b & (0 - b)) - 1)
        // SWAR: the counts of each 2, 4 and 8 bits side by side, then the
        // bytes' added up by a multiplication into the top byte.
        var x = v - ((v >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        return ((x * 0x0101010101010101) >> 56) as int
    }

    // `self + other`, or `None` if it doesn't fit.
    #test(2u64, 3)[Some(5)]
    #test(18446744073709551615u64, 1)[None] // MAX + 1
    #test(18446744073709551614u64, 1)[Some(18446744073709551615)] // MAX - 1 + 1
    #test(18446744073709551615u64, 18446744073709551615)[None] // MAX + MAX
    #test(0u64, 18446744073709551615)[Some(18446744073709551615)] // 0 + MAX
    fun checked_add(self, other: uint64) -> Option<uint64> {
        return if add_overflows_u64(self, other) { None } else { Some(self + other) }
    }

    // `self - other`, or `None` if it doesn't fit.
    #test(5u64, 3)[Some(2)]
    #test(3u64, 5)[None]
    #test(0u64, 1)[None]
    #test(1u64, 1)[Some(0)]
    #test(0u64, 0)[Some(0)]
    #test(18446744073709551615u64, 18446744073709551615)[Some(0)] // MAX - MAX
    fun checked_sub(self, other: uint64) -> Option<uint64> {
        return if sub_overflows_u64(self, other) { None } else { Some(self - other) }
    }

    // `self * other`, or `None` if it doesn't fit.
    #test(6u64, 7)[Some(42)]
    #test(18446744073709551615u64, 2)[None] // MAX * 2
    #test(9223372036854775807u64, 2)[Some(18446744073709551614)]
    #test(0u64, 1)[Some(0)]
    #test(0u64, 2)[Some(0)]
    #test(0u64, 18446744073709551615)[Some(0)] // 0 * MAX
    #test(18446744073709551615u64, 18446744073709551615)[None] // MAX * MAX
    fun checked_mul(self, other: uint64) -> Option<uint64> {
        return if mul_overflows_u64(self, other) { None } else { Some(self * other) }
    }

    // `self / other`, or `None` if `other` is 0.
    #test(7u64, 2)[Some(3)]
    #test(7u64, 0)[None]
    #test(18446744073709551615u64, 18446744073709551615)[Some(1)] // MAX / MAX
    fun checked_div(self, other: uint64) -> Option<uint64> {
        return if other == 0 { None } else { Some(self / other) }
    }

    // `self % other`, or `None` if `other` is 0.
    #test(7u64, 2)[Some(1)]
    #test(7u64, 0)[None]
    #test(18446744073709551615u64, 18446744073709551615)[Some(0)] // MAX % MAX
    fun checked_rem(self, other: uint64) -> Option<uint64> {
        return if other == 0 { None } else { Some(self % other) }
    }

    // `-self`: `Some(0)` for 0, `None` for any other unsigned number.
    #test(5u64)[None]
    #test(0u64)[Some(0)]
    #test(18446744073709551615u64)[None]
    #test(1u64)[None]
    fun checked_neg(self) -> Option<uint64> {
        return if self == 0 { Some(0) } else { None }
    }

    // The number to the power `exp`, or `None` if it doesn't fit.
    #test(3u64, 4)[Some(81)]
    #test(2u64, 0)[Some(1)]
    #test(0u64, 0)[Some(1)]
    #test(0u64, 3)[Some(0)]
    #test(2u64, 63)[Some(9223372036854775808)]
    #test(2u64, 64)[None]
    #test(3u64, 40)[Some(12157665459056928801)]
    fun checked_pow(self, exp: uint32) -> Option<uint64> {
        var base = self
        var e = exp
        var acc: uint64 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.checked_mul(base)?
            }
            e = e >> 1
            if e > 0 {
                base = base.checked_mul(base)?
            }
        }
        return Some(acc)
    }

    // The number to the power `exp`, modulo 2^64.
    #test(3u64, 4)[81]
    #test(2u64, 0)[1]
    #test(0u64, 0)[1]
    #test(0u64, 3)[0]
    #test(2u64, 63)[9223372036854775808]
    #test(2u64, 64)[0] // wraps
    #test(3u64, 40)[12157665459056928801]
    fun wrapping_pow(self, exp: uint32) -> uint64 {
        var base = self
        var e = exp
        var acc: uint64 = 1
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc * base
            }
            e = e >> 1
            if e > 0 {
                base = base * base
            }
        }
        return acc
    }

    // `self + other`, or the bound it passes if it doesn't fit.
    #test(2u64, 3)[5]
    #test(18446744073709551615u64, 1)[18446744073709551615] // MAX + 1
    #test(18446744073709551614u64, 1)[18446744073709551615] // MAX - 1 + 1
    #test(18446744073709551615u64, 18446744073709551615)[18446744073709551615] // MAX + MAX
    #test(0u64, 18446744073709551615)[18446744073709551615] // 0 + MAX
    fun saturating_add(self, other: uint64) -> uint64 {
        if add_overflows_u64(self, other) {
            return MAX_U64
        }
        return self + other
    }

    // `self - other`, or the bound it passes if it doesn't fit.
    #test(5u64, 3)[2]
    #test(3u64, 5)[0]
    #test(0u64, 1)[0]
    #test(1u64, 1)[0]
    #test(0u64, 0)[0]
    #test(18446744073709551615u64, 18446744073709551615)[0] // MAX - MAX
    fun saturating_sub(self, other: uint64) -> uint64 {
        if sub_overflows_u64(self, other) {
            return 0
        }
        return self - other
    }

    // `self * other`, or the bound it passes if it doesn't fit.
    #test(6u64, 7)[42]
    #test(18446744073709551615u64, 2)[18446744073709551615] // MAX * 2
    #test(9223372036854775807u64, 2)[18446744073709551614]
    #test(0u64, 1)[0]
    #test(0u64, 2)[0]
    #test(0u64, 18446744073709551615)[0] // 0 * MAX
    #test(18446744073709551615u64, 18446744073709551615)[18446744073709551615] // MAX * MAX
    fun saturating_mul(self, other: uint64) -> uint64 {
        if mul_overflows_u64(self, other) {
            return MAX_U64
        }
        return self * other
    }

    // The number to the power `exp`, or the bound it passes if it doesn't fit.
    #test(3u64, 4)[81]
    #test(2u64, 0)[1]
    #test(0u64, 0)[1]
    #test(0u64, 3)[0]
    #test(2u64, 63)[9223372036854775808]
    #test(2u64, 64)[18446744073709551615]
    #test(3u64, 40)[12157665459056928801]
    fun saturating_pow(self, exp: uint32) -> uint64 {
        return match self.checked_pow(exp) {
            Some(v) => v
            None => MAX_U64
        }
    }

    // `self + other` modulo 2^64, and whether it didn't fit.
    #test(2u64, 3)[(5, false)]
    #test(18446744073709551615u64, 1)[(0, true)] // MAX + 1
    #test(18446744073709551614u64, 1)[(18446744073709551615, false)] // MAX - 1 + 1
    #test(18446744073709551615u64, 18446744073709551615)[(18446744073709551614, true)] // MAX + MAX
    #test(0u64, 18446744073709551615)[(18446744073709551615, false)] // 0 + MAX
    fun overflowing_add(self, other: uint64) -> (uint64, bool) {
        return (self + other, add_overflows_u64(self, other))
    }

    // `self - other` modulo 2^64, and whether it didn't fit.
    #test(5u64, 3)[(2, false)]
    #test(3u64, 5)[(18446744073709551614, true)]
    #test(0u64, 1)[(18446744073709551615, true)]
    #test(1u64, 1)[(0, false)]
    #test(0u64, 0)[(0, false)]
    #test(18446744073709551615u64, 18446744073709551615)[(0, false)] // MAX - MAX
    fun overflowing_sub(self, other: uint64) -> (uint64, bool) {
        return (self - other, sub_overflows_u64(self, other))
    }

    // `self * other` modulo 2^64, and whether it didn't fit.
    #test(6u64, 7)[(42, false)]
    #test(18446744073709551615u64, 2)[(18446744073709551614, true)] // MAX * 2
    #test(9223372036854775807u64, 2)[(18446744073709551614, false)]
    #test(0u64, 1)[(0, false)]
    #test(0u64, 2)[(0, false)]
    #test(0u64, 18446744073709551615)[(0, false)] // 0 * MAX
    #test(18446744073709551615u64, 18446744073709551615)[(1, true)] // MAX * MAX
    fun overflowing_mul(self, other: uint64) -> (uint64, bool) {
        return (self * other, mul_overflows_u64(self, other))
    }

    // `-self` modulo 2^64, and whether it didn't fit.
    #test(5u64)[(18446744073709551611, true)]
    #test(0u64)[(0, false)]
    #test(18446744073709551615u64)[(1, true)]
    #test(1u64)[(18446744073709551615, true)]
    fun overflowing_neg(self) -> (uint64, bool) {
        return (0 - self, self != 0)
    }

    // The number to the power `exp` modulo 2^64, and whether it didn't fit.
    #test(3u64, 4)[(81, false)]
    #test(2u64, 0)[(1, false)]
    #test(0u64, 0)[(1, false)]
    #test(0u64, 3)[(0, false)]
    #test(2u64, 63)[(9223372036854775808, false)]
    #test(2u64, 64)[(0, true)]
    #test(3u64, 40)[(12157665459056928801, false)]
    fun overflowing_pow(self, exp: uint32) -> (uint64, bool) {
        let over = match self.checked_pow(exp) {
            Some(_) => false
            None => true
        }
        return (self.wrapping_pow(exp), over)
    }

    // `self * other` modulo `m`, from 0 to `m - 1`, computed without overflow;
    // `m` must be positive.
    #test(7u64, 8, 5)[1]
    #test(18446744073709551615u64, 18446744073709551615, 18446744073709551614)[1] // MAX, MAX, MAX - 1
    #test(18446744073709551615u64, 18446744073709551615, 18446744073709551615)[0] // MAX, MAX, MAX
    #test(18446744073709551614u64, 18446744073709551613, 18446744073709551615)[2] // MAX - 1, 18446744073709551613, MAX
    #test(0u64, 0, 18446744073709551615)[0] // 0, 0, MAX
    #test(0u64, 3, 1000)[0]
    #test(3u64, 4, 1)[0]
    #test(3u64, 4, 0)[panic("mulmod: the modulus must be positive, not 0")]
    fun mulmod(self, other: uint64, m: uint64) -> uint64 {
        if m == 0 {
            panic(f"mulmod: the modulus must be positive, not {m}")
        }
        var a = self.rem_euclid(m)
        var b = other.rem_euclid(m)
        if a <= 4294967295 && b <= 4294967295 {
            return a * b % m
        }
        // Double and add: addmod adds only below m, so nothing overflows.
        var r: uint64 = 0
        while b > 0 {
            if (b & 1) == 1 {
                r = addmod_u64(r, a, m)
            }
            a = addmod_u64(a, a, m)
            b = b >> 1
        }
        return r
    }

    // The number to the power `exp` modulo `m`, from 0 to `m - 1`, computed
    // without overflow; `m` must be positive.
    #test(2u64, 10, 1000)[24]
    #test(3u64, 0, 7)[1]
    #test(3u64, 0, 1)[0]
    #test(0u64, 0, 5)[1]
    #test(2u64, 18446744073709551556, 18446744073709551557)[1]
    #test(18446744073709551615u64, 18446744073709551615, 18446744073709551557)[4959809447704153900] // MAX, MAX, 18446744073709551557
    #test(18446744073709551614u64, 3, 18446744073709551615)[18446744073709551614] // MAX - 1, 3, MAX
    #test(5u64, 0, 18446744073709551615)[1] // 5, 0, MAX
    #test(2u64, 5, 0)[panic("powmod: the modulus must be positive, not 0")]
    fun powmod(self, exp: uint64, m: uint64) -> uint64 {
        if m == 0 {
            panic(f"powmod: the modulus must be positive, not {m}")
        }
        var base = self.rem_euclid(m)
        var e = exp
        var acc: uint64 = if m == 1 { 0 } else { 1 }
        while e > 0 {
            if (e & 1) == 1 {
                acc = acc.mulmod(base, m)
            }
            e = e >> 1
            if e > 0 {
                base = base.mulmod(base, m)
            }
        }
        return acc
    }

    // The inverse modulo `m`: the `x` from 0 to `m - 1` with `self * x` ≡ 1, or
    // `None` if there is none (`self` and `m` have a common divisor); `m` must be
    // positive.
    #test(3u64, 7)[Some(5)]
    #test(4u64, 8)[None]
    #test(0u64, 7)[None]
    #test(5u64, 1)[Some(0)]
    #test(10u64, 17)[Some(12)]
    #test(18446744073709551615u64, 18446744073709551557)[Some(1590236558078409617)] // MAX mod 18446744073709551557
    #test(2u64, 18446744073709551615)[Some(9223372036854775808)] // 2 mod MAX
    #test(3u64, 0)[panic("modinv: the modulus must be positive, not 0")]
    fun modinv(self, m: uint64) -> Option<uint64> {
        if m == 0 {
            panic(f"modinv: the modulus must be positive, not {m}")
        }
        // Extended Euclid, the coefficients of `self` kept modulo `m`, so none
        // overflows: t0 * self ≡ r0 and t1 * self ≡ r1.
        var r0 = m
        var r1 = self.rem_euclid(m)
        var t0: uint64 = 0
        var t1: uint64 = if m == 1 { 0 } else { 1 }
        while r1 != 0 {
            let q = r0 / r1
            let r2 = r0 % r1
            r0 = r1
            r1 = r2
            let qt = q.mulmod(t1, m)
            let t2 = if t0 >= qt { t0 - qt } else { m - (qt - t0) }
            t0 = t1
            t1 = t2
        }
        return if r0 == 1 { Some(t0) } else { None }
    }
}

// --- the overflow tests and the constants, per width -------------------------

const MIN_I8: int8 = -128
const MAX_I8: int8 = 127

fun add_overflows_i8(a: int8, b: int8) -> bool {
    return if b > 0 { a > MAX_I8 - b } else { a < MIN_I8 - b }
}

fun sub_overflows_i8(a: int8, b: int8) -> bool {
    return if b < 0 { a > MAX_I8 + b } else { a < MIN_I8 + b }
}

fun mul_overflows_i8(a: int8, b: int8) -> bool {
    let p = (a as int64) * (b as int64)
    return p < (MIN_I8 as int64) || p > (MAX_I8 as int64)
}

const MIN_I16: int16 = -32768
const MAX_I16: int16 = 32767

fun add_overflows_i16(a: int16, b: int16) -> bool {
    return if b > 0 { a > MAX_I16 - b } else { a < MIN_I16 - b }
}

fun sub_overflows_i16(a: int16, b: int16) -> bool {
    return if b < 0 { a > MAX_I16 + b } else { a < MIN_I16 + b }
}

fun mul_overflows_i16(a: int16, b: int16) -> bool {
    let p = (a as int64) * (b as int64)
    return p < (MIN_I16 as int64) || p > (MAX_I16 as int64)
}

const MIN_I32: int32 = -2147483648
const MAX_I32: int32 = 2147483647

fun add_overflows_i32(a: int32, b: int32) -> bool {
    return if b > 0 { a > MAX_I32 - b } else { a < MIN_I32 - b }
}

fun sub_overflows_i32(a: int32, b: int32) -> bool {
    return if b < 0 { a > MAX_I32 + b } else { a < MIN_I32 + b }
}

fun mul_overflows_i32(a: int32, b: int32) -> bool {
    let p = (a as int64) * (b as int64)
    return p < (MIN_I32 as int64) || p > (MAX_I32 as int64)
}

const MIN_I64: int64 = -9223372036854775808
const MAX_I64: int64 = 9223372036854775807

fun add_overflows_i64(a: int64, b: int64) -> bool {
    return if b > 0 { a > MAX_I64 - b } else { a < MIN_I64 - b }
}

fun sub_overflows_i64(a: int64, b: int64) -> bool {
    return if b < 0 { a > MAX_I64 + b } else { a < MIN_I64 + b }
}

fun mul_overflows_i64(a: int64, b: int64) -> bool {
    // By division (CERT INT32-C), as no wider type holds the product.
    if a > 0 {
        return if b > 0 { a > MAX_I64 / b } else { b < MIN_I64 / a }
    }
    if b > 0 {
        return a < MIN_I64 / b
    }
    return a != 0 && b < MAX_I64 / a
}

// `(x + y) % m` for x and y from 0 to m - 1, without overflow.
fun addmod_i64(x: int64, y: int64, m: int64) -> int64 {
    return if x >= m - y { x - (m - y) } else { x + y }
}

const MIN_U8: uint8 = 0
const MAX_U8: uint8 = 255

fun add_overflows_u8(a: uint8, b: uint8) -> bool {
    return a > MAX_U8 - b
}

fun sub_overflows_u8(a: uint8, b: uint8) -> bool {
    return a < b
}

fun mul_overflows_u8(a: uint8, b: uint8) -> bool {
    return (a as uint64) * (b as uint64) > (MAX_U8 as uint64)
}

const MIN_U16: uint16 = 0
const MAX_U16: uint16 = 65535

fun add_overflows_u16(a: uint16, b: uint16) -> bool {
    return a > MAX_U16 - b
}

fun sub_overflows_u16(a: uint16, b: uint16) -> bool {
    return a < b
}

fun mul_overflows_u16(a: uint16, b: uint16) -> bool {
    return (a as uint64) * (b as uint64) > (MAX_U16 as uint64)
}

const MIN_U32: uint32 = 0
const MAX_U32: uint32 = 4294967295

fun add_overflows_u32(a: uint32, b: uint32) -> bool {
    return a > MAX_U32 - b
}

fun sub_overflows_u32(a: uint32, b: uint32) -> bool {
    return a < b
}

fun mul_overflows_u32(a: uint32, b: uint32) -> bool {
    return (a as uint64) * (b as uint64) > (MAX_U32 as uint64)
}

const MIN_U64: uint64 = 0
const MAX_U64: uint64 = 18446744073709551615

fun add_overflows_u64(a: uint64, b: uint64) -> bool {
    return a > MAX_U64 - b
}

fun sub_overflows_u64(a: uint64, b: uint64) -> bool {
    return a < b
}

fun mul_overflows_u64(a: uint64, b: uint64) -> bool {
    return b != 0 && a > MAX_U64 / b
}

// `(x + y) % m` for x and y from 0 to m - 1, without overflow.
fun addmod_u64(x: uint64, y: uint64, m: uint64) -> uint64 {
    return if x >= m - y { x - (m - y) } else { x + y }
}

// --- test functions -----------------------------------------------------------

// Fermat's little theorem and the inverses, at the largest 64-bit primes,
// where every product of two residues overflows 64 bits.
#test
fun modular_at_64_bits() {
    let p: int64 = 9223372036854775783
    let q: uint64 = 18446744073709551557
    var a: int64 = 2
    var b: uint64 = 2
    var i = 0
    while i < 20 {
        holds(a.powmod(p - 1, p) == 1, "a^(p-1) mod p, int64")
        holds(b.powmod(q - 1, q) == 1, "b^(q-1) mod q, uint64")
        match a.modinv(p) {
            Some(x) => holds(a.mulmod(x, p) == 1, "a * a^-1 mod p, int64")
            None => holds(false, "no inverse modulo a prime, int64")
        }
        match b.modinv(q) {
            Some(x) => holds(b.mulmod(x, q) == 1, "b * b^-1 mod q, uint64")
            None => holds(false, "no inverse modulo a prime, uint64")
        }
        a = a.mulmod(a, p) + 1
        b = b.mulmod(b, q) + 1
        i += 1
    }
}

// The four kinds of an operation agree, over boundary values of int64.
#test
fun kinds_agree() {
    let vs: [int64] = [0, 1, -1, 2, -2, 3037000499, -3037000500, 4611686018427387904,
        9223372036854775807, -9223372036854775807, -9223372036854775807 - 1]
    for a in vs {
        for b in vs {
            let (s, over) = a.overflowing_add(b)
            holds(s == a + b, "overflowing_add's value")
            match a.checked_add(b) {
                Some(v) => holds(!over && v == s && a.saturating_add(b) == s, "add fits")
                None => holds(over && a.saturating_add(b) == (if b > 0 { MAX_I64 } else { MIN_I64 }), "add overflows")
            }
            let (p, mover) = a.overflowing_mul(b)
            holds(p == a * b, "overflowing_mul's value")
            match a.checked_mul(b) {
                Some(v) => holds(!mover && v == p && a.saturating_mul(b) == p, "mul fits")
                None => holds(mover && a.saturating_mul(b) == (if (a < 0) == (b < 0) { MAX_I64 } else { MIN_I64 }), "mul overflows")
            }
            if b != 0 {
                let r = a.rem_euclid(b)
                holds(r >= 0 && (r < b || r < -b || b == -9223372036854775807 - 1), "rem_euclid's range")
                holds(a.div_euclid(b) * b + r == a, "q * b + r")
            }
        }
    }
}

// The test functions' assertion: `assert(ok, f"…")` doesn't compile
// natively yet (an IR verifier error on the f-string message), a function
// call with one does.
fun holds(ok: bool, what: str) {
    if !ok {
        panic(what)
    }
}
