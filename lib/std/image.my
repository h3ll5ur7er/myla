// std.image: the image type the codecs, std.imgproc, std.draw and std.font
// share (D311, MYLA-933). An `Image<S>` holds its samples interleaved, row
// by row, without padding: the sample `c` of the pixel `(x, y)` is
// `data[(y * width + x) * channels + c]`.
//
// This is the skeleton the lanes of wave 1 build on: the types and their
// basic access. MYLA-933 completes the module; what is declared here keeps
// its names and signatures.

from std.ioerror import IoError, io_error_name
import std.list as list_m // `filled`
import std.float as fl // `is_nan`
import std.option as option_m // `expect` in the tests

// The most pixels a decoder allocates unless told otherwise: 2^28.
pub const MAX_PIXELS: int64 = 0x10000000

// The most samples an image holds: a list's limit.
pub const MAX_SAMPLES: int64 = 2147483647

// A sample type: `uint8`, `uint16` or `float32`. Integers are full scale at
// their maximum, floats at 1.0.
pub trait Sample {
    // 255, 65535 or 1.0.
    fun max_value() -> Self
    // The sample's value, unscaled: 255u8 is 255.0.
    fun to_f32(self) -> float32
    // A value back to the sample type, rounded and clamped for the integers.
    fun from_f32(v: float32) -> Self
    // The sample scaled to 0..255.
    fun to_unorm8(self) -> uint8
    // A sample from 0..255, scaled to the type's range.
    fun from_unorm8(v: uint8) -> Self
    // The BT.601 luma of `r`, `g`, `b`: for the integers in fixed point,
    // (R * 19595 + G * 38470 + B * 7471 + 0x8000) >> 16, which is what
    // Pillow's `convert("L")` computes; for floats 0.299 R + 0.587 G + 0.114 B.
    fun luma(r: Self, g: Self, b: Self) -> Self
    // The sample times alpha `a` (premultiplying), rounded half up for
    // the integers: `v * a / max`.
    fun mul_alpha(self, a: Self) -> Self
    // The sample divided by alpha `a` (unpremultiplying), truncated and
    // clamped for the integers: `v * max / a`, as Pillow's "RGBa" to "RGBA";
    // unchanged where `a` is 0.
    fun div_alpha(self, a: Self) -> Self
}

impl Sample for uint8 {
    #test()[255u8]
    fun max_value() -> uint8 {
        return 255u8
    }

    #test(7u8)[7.0f32]
    fun to_f32(self) -> float32 {
        return self as float32
    }

    #test(254.5f32)[255u8]
    #test(-3.0f32)[0u8]
    #test(300.0f32)[255u8]
    #test(1.49f32)[1u8]
    fun from_f32(v: float32) -> uint8 {
        if v.is_nan() || v <= 0.0f32 {
            return 0u8
        }
        if v >= 255.0f32 {
            return 255u8
        }
        return (v + 0.5f32) as uint8
    }

    #test(9u8)[9u8]
    fun to_unorm8(self) -> uint8 {
        return self
    }

    #test(9u8)[9u8]
    fun from_unorm8(v: uint8) -> uint8 {
        return v
    }

    // Pillow's `convert("L")` gives the same for every one of the 2^24
    // triples (checked with Pillow 13 when this was written).
    #test(10u8, 200u8, 30u8)[124u8]
    #test(255u8, 0u8, 0u8)[76u8]
    #test(0u8, 255u8, 0u8)[150u8]
    #test(0u8, 0u8, 255u8)[29u8]
    #test(254u8, 1u8, 127u8)[91u8]
    #test(37u8, 99u8, 211u8)[93u8]
    #test(255u8, 255u8, 255u8)[255u8]
    fun luma(r: uint8, g: uint8, b: uint8) -> uint8 {
        return (((r as uint32) * 19595u32 + (g as uint32) * 38470u32 + (b as uint32) * 7471u32 + 0x8000u32) >> 16) as uint8
    }

    // Pillow's "RGBa": 200 * 128 / 255 is 100.4
    #test(200u8, 128u8)[100u8]
    #test(255u8, 51u8)[51u8]
    #test(1u8, 128u8)[1u8]
    fun mul_alpha(self, a: uint8) -> uint8 {
        return (((self as uint32) * (a as uint32) + 127u32) / 255u32) as uint8
    }

    // Pillow agrees on all 65536 pairs
    #test(100u8, 128u8)[199u8]
    #test(1u8, 2u8)[127u8]
    #test(9u8, 3u8)[255u8]
    #test(9u8, 0u8)[9u8]
    fun div_alpha(self, a: uint8) -> uint8 {
        if a == 0u8 {
            return self
        }
        let v = ((self as uint32) * 255u32) / (a as uint32)
        return if v > 255u32 { 255u8 } else { v as uint8 }
    }
}

impl Sample for uint16 {
    #test()[65535u16]
    fun max_value() -> uint16 {
        return 65535u16
    }

    #test(700u16)[700.0f32]
    fun to_f32(self) -> float32 {
        return self as float32
    }

    #test(65535.4f32)[65535u16]
    #test(-1.0f32)[0u16]
    #test(70000.0f32)[65535u16]
    fun from_f32(v: float32) -> uint16 {
        if v.is_nan() || v <= 0.0f32 {
            return 0u16
        }
        if v >= 65535.0f32 {
            return 65535u16
        }
        return (v + 0.5f32) as uint16
    }

    // Rounded: (v * 255 + 32767) / 65535, as libpng scales 16 bits to 8.
    #test(65535u16)[255u8]
    #test(0u16)[0u8]
    #test(32896u16)[128u8]
    #test(257u16)[1u8]
    fun to_unorm8(self) -> uint8 {
        return (((self as uint32) * 255u32 + 32767u32) / 65535u32) as uint8
    }

    // Widened by 257, so 255 is 65535.
    #test(255u8)[65535u16]
    #test(1u8)[257u16]
    fun from_unorm8(v: uint8) -> uint16 {
        return (v as uint16) * 257u16
    }

    // The 8-bit formula on 16 bits: 65535 * 65536 + 0x8000 fits a uint32.
    #test(65535u16, 65535u16, 65535u16)[65535u16]
    #test(2570u16, 51400u16, 7710u16)[31819u16]
    fun luma(r: uint16, g: uint16, b: uint16) -> uint16 {
        return (((r as uint32) * 19595u32 + (g as uint32) * 38470u32 + (b as uint32) * 7471u32 + 0x8000u32) >> 16) as uint16
    }

    // 39196 * 5505 / 65535 is 3292.4997..., which float32 would round up
    #test(39196u16, 5505u16)[3292u16]
    #test(65535u16, 65535u16)[65535u16]
    fun mul_alpha(self, a: uint16) -> uint16 {
        return (((self as uint64) * (a as uint64) + 32767u64) / 65535u64) as uint16
    }

    #test(3292u16, 5505u16)[39190u16]
    #test(7u16, 0u16)[7u16]
    #test(9u16, 3u16)[65535u16]
    fun div_alpha(self, a: uint16) -> uint16 {
        if a == 0u16 {
            return self
        }
        let v = ((self as uint64) * 65535u64) / (a as uint64)
        return if v > 65535u64 { 65535u16 } else { v as uint16 }
    }
}

impl Sample for float32 {
    #test()[1.0f32]
    fun max_value() -> float32 {
        return 1.0f32
    }

    #test(0.25f32)[0.25f32]
    fun to_f32(self) -> float32 {
        return self
    }

    #test(0.25f32)[0.25f32]
    fun from_f32(v: float32) -> float32 {
        return v
    }

    #test(1.0f32)[255u8]
    #test(0.5f32)[128u8]
    #test(-1.0f32)[0u8]
    #test(2.0f32)[255u8]
    fun to_unorm8(self) -> uint8 {
        return uint8.from_f32(self * 255.0f32)
    }

    #test(255u8)[1.0f32]
    #test(0u8)[0.0f32]
    fun from_unorm8(v: uint8) -> float32 {
        return (v as float32) / 255.0f32
    }

    #test(1.0f32, 0.0f32, 0.0f32)[0.299f32]
    #test(0.0f32, 0.0f32, 1.0f32)[0.114f32]
    fun luma(r: float32, g: float32, b: float32) -> float32 {
        return 0.299f32 * r + 0.587f32 * g + 0.114f32 * b
    }

    #test(0.5f32, 0.5f32)[0.25f32]
    fun mul_alpha(self, a: float32) -> float32 {
        return self * a
    }

    #test(0.25f32, 0.5f32)[0.5f32]
    #test(0.25f32, 0.0f32)[0.25f32]
    fun div_alpha(self, a: float32) -> float32 {
        return if a == 0.0f32 { self } else { self / a }
    }
}

// How a pixel's samples are laid out.
#derive(Eq, Hash)
pub enum Layout {
    Gray
    GrayAlpha
    Rgb
    Rgba
}

impl Layout {
    #test(Layout.Gray)[1]
    #test(Layout.GrayAlpha)[2]
    #test(Layout.Rgb)[3]
    #test(Layout.Rgba)[4]
    fun channels(self) -> int {
        return match self {
            Gray => 1
            GrayAlpha => 2
            Rgb => 3
            Rgba => 4
        }
    }

    #test(Layout.GrayAlpha)[true]
    #test(Layout.Rgb)[false]
    fun has_alpha(self) -> bool {
        return match self {
            GrayAlpha | Rgba => true
            Gray | Rgb => false
        }
    }

    #test(Layout.Rgb)[true]
    #test(Layout.GrayAlpha)[false]
    fun is_color(self) -> bool {
        return match self {
            Rgb | Rgba => true
            Gray | GrayAlpha => false
        }
    }

}

// The layout of `n` channels: 1 to 4.
#test(3)[Some(Layout.Rgb)]
#test(5)[None]
pub fun layout_of(n: int) -> Option<Layout> {
    return match n {
        1 => Some(Layout.Gray)
        2 => Some(Layout.GrayAlpha)
        3 => Some(Layout.Rgb)
        4 => Some(Layout.Rgba)
        _ => None
    }
}

impl Format for Layout {
    #test(Layout.GrayAlpha, "")["gray+alpha"]
    fun format(self, spec: str) -> str {
        return match self {
            Gray => "gray"
            GrayAlpha => "gray+alpha"
            Rgb => "rgb"
            Rgba => "rgba"
        }
    }
}

// An image: `width` by `height` pixels of `layout`, the samples interleaved
// row by row in `data`.
#derive(Eq)
pub struct Image<S> {
    width: int,
    height: int,
    layout: Layout,
    data: [S],
}

pub typealias Image8 = Image<uint8>
pub typealias Image16 = Image<uint16>
pub typealias ImageF = Image<float32>

// A colour: sRGB, straight (not premultiplied) alpha.
#derive(Eq, Hash)
pub struct Color {
    r: uint8,
    g: uint8,
    b: uint8,
    a: uint8,
}

// A rectangle of pixels: `x`, `y` its top left corner.
#derive(Eq, Hash)
pub struct Rect {
    x: int,
    y: int,
    w: int,
    h: int,
}

// What a codec's `info` tells without decoding: `bit_depth` is the bits
// of a sample as stored (1 to 16, 32 for floats), `format` the codec's name
// ("png", "jpeg", …).
#derive(Eq)
pub struct ImageInfo {
    width: int,
    height: int,
    layout: Layout,
    bit_depth: int,
    frames: int,
    format: str,
}

// The errors of every codec, std.imageio and std.imgproc (D311, D168).
#derive(Eq)
pub enum ImageError {
    // The input ends early.
    Truncated
    // The input isn't this format.
    BadSignature
    // A valid feature this module doesn't read, by name.
    Unsupported(str)
    // What is wrong with the input, with its offset where there is one.
    Corrupt(str)
    // A chunk's CRC or a stream's checksum doesn't match.
    Checksum
    // The pixels (or samples) asked for, past the limit.
    TooLarge(int64)
    // Sizes or layouts that don't fit together.
    Mismatch(str)
    // A file couldn't be read or written.
    Io(IoError)
}

impl ImageError {
    #test(ImageError.Truncated)["truncated input"]
    #test(ImageError.Unsupported("arithmetic coding"))["unsupported: arithmetic coding"]
    #test(ImageError.TooLarge(300000000i64))["image too large: 300000000 pixels"]
    #test(ImageError.Io(IoError.NotFound))["NotFound"]
    fun message(self) -> str {
        return match self {
            Truncated => "truncated input"
            BadSignature => "not an image of this format"
            Unsupported(what) => f"unsupported: {what}"
            Corrupt(what) => f"corrupt image: {what}"
            Checksum => "checksum mismatch"
            TooLarge(n) => f"image too large: {n} pixels"
            Mismatch(what) => f"mismatch: {what}"
            Io(e) => io_error_name(e)
        }
    }
}

impl Format for ImageError {
    // The message; the spec is ignored.
    #test(ImageError.Checksum, "")["checksum mismatch"]
    fun format(self, spec: str) -> str {
        return self.message()
    }
}

// The samples of a `width` by `height` image of `channels`, in int64;
// None if a size is negative.
#test(3, 2, 4)[Some(24i64)]
#test(-1, 2, 1)[None]
#test(65536, 65536, 4)[Some(17179869184i64)]
pub fun sample_count(width: int, height: int, channels: int) -> Option<int64> {
    if width < 0 || height < 0 || channels < 0 {
        return None
    }
    return Some((width as int64) * (height as int64) * (channels as int64))
}

// Whether a decoder may allocate a `width` by `height` image of `channels`:
// `Ok` if the pixels are at most `max_pixels` and the samples fit a list,
// else `TooLarge` with the pixels asked for (`Corrupt` for a negative size).
#test(100, 100, 4, 20000i64)[Ok(())]
#test(1000, 1000, 1, 20000i64)[Err(ImageError.TooLarge(1000000i64))]
#test(40000, 40000, 4, 0x10000000i64)[Err(ImageError.TooLarge(1600000000i64))]
pub fun check_size(width: int, height: int, channels: int, max_pixels: int64) -> Result<(), ImageError> {
    if width < 0 || height < 0 {
        return Err(ImageError.Corrupt(f"negative size {width}x{height}"))
    }
    let pixels = (width as int64) * (height as int64)
    if pixels > max_pixels || pixels * (channels as int64) > MAX_SAMPLES {
        return Err(ImageError.TooLarge(pixels))
    }
    return Ok(())
}

// A `width` by `height` image of `layout`, every sample `fill`. A negative
// size, or more than 2147483647 samples, is a failure (as for `grid.new`).
pub fun new<S: Sample>(width: int, height: int, layout: Layout, fill: S) -> Image<S> {
    if width < 0 || height < 0 {
        panic(f"image size {width} by {height} is negative")
    }
    let n = (width as int64) * (height as int64) * (layout.channels() as int64)
    if n > MAX_SAMPLES {
        panic(f"image size {width} by {height} is more than 2147483647 samples")
    }
    return Image { width: width, height: height, layout: layout, data: list_m.filled(n as int, fill) }
}

// The image of `data`, which must hold `width * height * channels` samples.
pub fun from_data<S: Sample>(width: int, height: int, layout: Layout, data: [S]) -> Result<Image<S>, ImageError> {
    if width < 0 || height < 0 {
        return Err(ImageError.Mismatch(f"negative size {width}x{height}"))
    }
    let n = (width as int64) * (height as int64) * (layout.channels() as int64)
    if n != (data.len() as int64) {
        return Err(ImageError.Mismatch(f"{width}x{height} {layout} needs {n} samples, got {data.len()}"))
    }
    return Ok(Image { width: width, height: height, layout: layout, data: data })
}

impl<S: Sample> Image<S> {
    // The samples of a pixel: 1 to 4.
    fun channels(self) -> int {
        return self.layout.channels()
    }

    // Whether `(x, y)` is a pixel of the image.
    fun in_bounds(self, x: int, y: int) -> bool {
        return x >= 0 && y >= 0 && x < self.width && y < self.height
    }

    // The index in `data` of the sample `c` of the pixel `(x, y)`; the
    // position isn't checked.
    fun offset(self, x: int, y: int, c: int) -> int {
        return (y * self.width + x) * self.layout.channels() + c
    }

    // The sample `c` of the pixel `(x, y)`; None out of bounds.
    fun get(self, x: int, y: int, c: int) -> Option<S> {
        if !self.in_bounds(x, y) || c < 0 || c >= self.layout.channels() {
            return None
        }
        return Some(self.data[self.offset(x, y, c)])
    }
}

impl<S: Sample> Index<(int, int, int), S> for Image<S> {
    // `img[(x, y, c)]`: out of bounds is a failure, as for a list.
    fun index(self, p: (int, int, int)) -> S {
        let (x, y, c) = p
        if !self.in_bounds(x, y) || c < 0 || c >= self.layout.channels() {
            panic(f"pixel ({x}, {y}, {c}) out of bounds of a {self.width}x{self.height} {self.layout} image")
        }
        return self.data[(y * self.width + x) * self.layout.channels() + c]
    }
}

impl<S: Sample> IndexSet<(int, int, int), S> for Image<S> {
    // `img[(x, y, c)] = v`: out of bounds is a failure, as for a list.
    fun set_index(var self, p: (int, int, int), v: S) {
        let (x, y, c) = p
        if !self.in_bounds(x, y) || c < 0 || c >= self.layout.channels() {
            panic(f"pixel ({x}, {y}, {c}) out of bounds of a {self.width}x{self.height} {self.layout} image")
        }
        self.data[(y * self.width + x) * self.layout.channels() + c] = v
    }
}

// The rest of the image's own operations. They work on `data` with index
// arithmetic, one loop per case, so natively they run at the speed of the
// loop a program would write by hand.
impl<S: Sample> Image<S> {
    // The whole image as a rectangle: `(0, 0)`, `width` by `height`.
    fun bounds(self) -> Rect {
        return Rect { x: 0, y: 0, w: self.width, h: self.height }
    }

    // The pixel `(x, y)` as a colour of 8 bits a channel: gray repeated, a
    // layout without alpha opaque. Out of bounds is a failure.
    fun color_at(self, x: int, y: int) -> Color {
        if !self.in_bounds(x, y) {
            panic(f"pixel ({x}, {y}) out of bounds of a {self.width}x{self.height} image")
        }
        let i = (y * self.width + x) * self.layout.channels()
        let d = self.data
        return match self.layout {
            Gray => {
                let v = d[i].to_unorm8()
                Color { r: v, g: v, b: v, a: 255u8 }
            }
            GrayAlpha => {
                let v = d[i].to_unorm8()
                Color { r: v, g: v, b: v, a: d[i + 1].to_unorm8() }
            }
            Rgb => Color { r: d[i].to_unorm8(), g: d[i + 1].to_unorm8(), b: d[i + 2].to_unorm8(), a: 255u8 }
            Rgba => Color { r: d[i].to_unorm8(), g: d[i + 1].to_unorm8(), b: d[i + 2].to_unorm8(), a: d[i + 3].to_unorm8() }
        }
    }

    // Sets the pixel `(x, y)` to `c`: its luma in a gray layout, its alpha
    // dropped in one without. Out of bounds is a failure.
    fun set_color(var self, x: int, y: int, c: Color) {
        if !self.in_bounds(x, y) {
            panic(f"pixel ({x}, {y}) out of bounds of a {self.width}x{self.height} image")
        }
        let i = (y * self.width + x) * self.layout.channels()
        match self.layout {
            Gray => {
                self.data[i] = S.from_unorm8(uint8.luma(c.r, c.g, c.b))
            }
            GrayAlpha => {
                self.data[i] = S.from_unorm8(uint8.luma(c.r, c.g, c.b))
                self.data[i + 1] = S.from_unorm8(c.a)
            }
            Rgb => {
                self.data[i] = S.from_unorm8(c.r)
                self.data[i + 1] = S.from_unorm8(c.g)
                self.data[i + 2] = S.from_unorm8(c.b)
            }
            Rgba => {
                self.data[i] = S.from_unorm8(c.r)
                self.data[i + 1] = S.from_unorm8(c.g)
                self.data[i + 2] = S.from_unorm8(c.b)
                self.data[i + 3] = S.from_unorm8(c.a)
            }
        }
    }

    // The samples of row `y`, interleaved. Out of bounds is a failure.
    fun row(self, y: int) -> [S] {
        if y < 0 || y >= self.height {
            panic(f"row {y} out of bounds of a {self.width}x{self.height} image")
        }
        let n = self.width * self.layout.channels()
        return self.data[y * n:(y + 1) * n]
    }

    // The channel `c` as a gray image. Out of range is a failure.
    fun channel(self, c: int) -> Image<S> {
        let ch = self.layout.channels()
        if c < 0 || c >= ch {
            panic(f"channel {c} out of range of a {self.layout} image")
        }
        let n = self.width * self.height
        let d = self.data
        var out = list_m.filled(n, S.from_unorm8(0u8))
        var i = c
        for j in 0..n {
            out[j] = d[i]
            i += ch
        }
        return Image { width: self.width, height: self.height, layout: Layout.Gray, data: out }
    }

    // The image in `layout`. Colour to gray is BT.601 luma (`S.luma`, as
    // Pillow's and OpenCV's), gray to colour repeats the gray; gaining
    // alpha makes it opaque, losing alpha drops it.
    fun convert(self, layout: Layout) -> Image<S> {
        if layout == self.layout {
            return self
        }
        let sc = self.layout.channels()
        let dc = layout.channels()
        let n = self.width * self.height
        let d = self.data
        let top = S.max_value()
        var out = list_m.filled(n * dc, top)
        var i = 0
        var j = 0
        if self.layout.is_color() && !layout.is_color() {
            if dc == 1 {
                for _ in 0..n {
                    out[j] = S.luma(d[i], d[i + 1], d[i + 2])
                    i += sc
                    j += 1
                }
            } else {
                for _ in 0..n {
                    out[j] = S.luma(d[i], d[i + 1], d[i + 2])
                    if sc == 4 {
                        out[j + 1] = d[i + 3]
                    }
                    i += sc
                    j += 2
                }
            }
        } else if self.layout.is_color() {
            // Rgb and Rgba: the alpha left at `top` when the source has none
            for _ in 0..n {
                out[j] = d[i]
                out[j + 1] = d[i + 1]
                out[j + 2] = d[i + 2]
                if sc == 4 && dc == 4 {
                    out[j + 3] = d[i + 3]
                }
                i += sc
                j += dc
            }
        } else if layout.is_color() {
            for _ in 0..n {
                let v = d[i]
                out[j] = v
                out[j + 1] = v
                out[j + 2] = v
                if sc == 2 && dc == 4 {
                    out[j + 3] = d[i + 1]
                }
                i += sc
                j += dc
            }
        } else {
            // Gray and GrayAlpha
            for _ in 0..n {
                out[j] = d[i]
                if sc == 2 && dc == 2 {
                    out[j + 1] = d[i + 1]
                }
                i += sc
                j += dc
            }
        }
        return Image { width: self.width, height: self.height, layout: layout, data: out }
    }

    // The image in float32, scaled to 0..1.
    fun to_f32(self) -> ImageF {
        let d = self.data
        let k = S.max_value().to_f32()
        var out = list_m.filled(d.len(), 0.0f32)
        for i in 0..d.len() {
            out[i] = d[i].to_f32() / k
        }
        return Image { width: self.width, height: self.height, layout: self.layout, data: out }
    }

    // The image in 8 bits: rounded and clamped from floats, 16 bits rounded
    // as libpng scales them.
    fun to_u8(self) -> Image8 {
        let d = self.data
        var out = list_m.filled(d.len(), 0u8)
        for i in 0..d.len() {
            out[i] = d[i].to_unorm8()
        }
        return Image { width: self.width, height: self.height, layout: self.layout, data: out }
    }

    // The image in 16 bits: 8 bits widened by 257, floats rounded and clamped.
    fun to_u16(self) -> Image16 {
        let d = self.data
        let k = 65535.0f32 / S.max_value().to_f32()
        var out = list_m.filled(d.len(), 0u16)
        for i in 0..d.len() {
            out[i] = uint16.from_f32(d[i].to_f32() * k)
        }
        return Image { width: self.width, height: self.height, layout: self.layout, data: out }
    }

    // The image of `f` applied to every sample, alpha included.
    fun map<T: Sample>(self, f: (S) -> T) -> Image<T> {
        let d = self.data
        var out = list_m.filled(d.len(), T.from_unorm8(0u8))
        for i in 0..d.len() {
            out[i] = f(d[i])
        }
        return Image { width: self.width, height: self.height, layout: self.layout, data: out }
    }

    // A copy of the part of the image inside `r`: smaller where `r` reaches
    // past the image, empty where it misses it.
    fun crop(self, r: Rect) -> Image<S> {
        let k = r.intersect(self.bounds())
        let ch = self.layout.channels()
        let d = self.data
        var out = list_m.filled(k.w * k.h * ch, S.from_unorm8(0u8))
        let n = k.w * ch
        var j = 0
        for y in k.y..k.y + k.h {
            var i = (y * self.width + k.x) * ch
            for _ in 0..n {
                out[j] = d[i]
                i += 1
                j += 1
            }
        }
        return Image { width: k.w, height: k.h, layout: self.layout, data: out }
    }

    // Copies `src` with its top left corner at `(x, y)`, converted to this
    // image's layout; what falls outside the image is left out. The pixels
    // replace these, alpha included (std.draw blends).
    fun paste(var self, src: Image<S>, x: int, y: int) {
        let s = if src.layout == self.layout { src } else { src.convert(self.layout) }
        let k = rect(x, y, s.width, s.height).intersect(self.bounds())
        if k.w == 0 || k.h == 0 {
            return
        }
        let ch = self.layout.channels()
        let n = k.w * ch
        let sd = s.data
        var d = self.data
        self.data = []
        for yy in k.y..k.y + k.h {
            var i = ((yy - y) * s.width + (k.x - x)) * ch
            var j = (yy * self.width + k.x) * ch
            for _ in 0..n {
                d[j] = sd[i]
                i += 1
                j += 1
            }
        }
        self.data = d
    }

    // Sets every pixel to `v`, one sample a channel. A `v` of another
    // length is a failure.
    fun fill(var self, v: [S]) {
        let ch = self.layout.channels()
        if v.len() != ch {
            panic(f"fill of a {self.layout} image with {v.len()} samples")
        }
        var d = self.data
        self.data = []
        var i = 0
        while i < d.len() {
            for c in 0..ch {
                d[i + c] = v[c]
            }
            i += ch
        }
        self.data = d
    }

    // The image mirrored left to right.
    fun flip_h(self) -> Image<S> {
        let ch = self.layout.channels()
        let stride = self.width * ch
        var p = Pixels { out: list_m.filled(self.data.len(), S.from_unorm8(0u8)) }
        for y in 0..self.height {
            p.copy(self.data, y * stride, (y + 1) * stride - ch, -ch, self.width, ch)
        }
        return Image { width: self.width, height: self.height, layout: self.layout, data: p.out }
    }

    // The image mirrored top to bottom.
    fun flip_v(self) -> Image<S> {
        let stride = self.width * self.layout.channels()
        let d = self.data
        var out = list_m.filled(d.len(), S.from_unorm8(0u8))
        for y in 0..self.height {
            var i = y * stride
            var j = (self.height - 1 - y) * stride
            for _ in 0..stride {
                out[j] = d[i]
                i += 1
                j += 1
            }
        }
        return Image { width: self.width, height: self.height, layout: self.layout, data: out }
    }

    // The image turned half a turn.
    fun rotate180(self) -> Image<S> {
        let ch = self.layout.channels()
        let n = self.data.len()
        var p = Pixels { out: list_m.filled(n, S.from_unorm8(0u8)) }
        p.copy(self.data, 0, n - ch, -ch, self.width * self.height, ch)
        return Image { width: self.width, height: self.height, layout: self.layout, data: p.out }
    }

    // The image turned a quarter turn clockwise (Pillow's
    // `Transpose.ROTATE_270`): `height` by `width`.
    fun rotate90(self) -> Image<S> {
        return turned(self, 0, 1, self.height - 1, -1)
    }

    // The image turned a quarter turn counter-clockwise (Pillow's
    // `Transpose.ROTATE_90`, `rotate(90)`): `height` by `width`.
    fun rotate270(self) -> Image<S> {
        return turned(self, self.width - 1, -1, 0, 1)
    }

    // The image mirrored along its main diagonal: the pixel `(x, y)` moves to
    // `(y, x)`.
    fun transpose(self) -> Image<S> {
        return turned(self, 0, 1, 0, 1)
    }

    // The colour samples multiplied by alpha (`S.mul_alpha`: rounded for
    // the integers, as Pillow's "RGBa"); an image without alpha unchanged.
    fun premultiplied(self) -> Image<S> {
        return alpha_scaled(self, true)
    }

    // The colour samples divided by alpha again (`S.div_alpha`: truncated
    // and clamped for the integers, as Pillow's; unchanged where alpha is
    // 0); an image without alpha unchanged.
    fun unpremultiplied(self) -> Image<S> {
        return alpha_scaled(self, false)
    }
}

// `premultiplied` (`times`) and `unpremultiplied`, by `S.mul_alpha` and
// `S.div_alpha`: integer arithmetic for the integer samples.
fun alpha_scaled<S: Sample>(img: Image<S>, times: bool) -> Image<S> {
    if !img.layout.has_alpha() {
        return img
    }
    let ch = img.layout.channels()
    var d = img.data
    var i = ch - 1
    if ch == 2 {
        while i < d.len() {
            let a = d[i]
            d[i - 1] = if times { d[i - 1].mul_alpha(a) } else { d[i - 1].div_alpha(a) }
            i += 2
        }
    } else if times {
        while i < d.len() {
            let a = d[i]
            d[i - 3] = d[i - 3].mul_alpha(a)
            d[i - 2] = d[i - 2].mul_alpha(a)
            d[i - 1] = d[i - 1].mul_alpha(a)
            i += 4
        }
    } else {
        while i < d.len() {
            let a = d[i]
            d[i - 3] = d[i - 3].div_alpha(a)
            d[i - 2] = d[i - 2].div_alpha(a)
            d[i - 1] = d[i - 1].div_alpha(a)
            i += 4
        }
    }
    return Image { width: img.width, height: img.height, layout: img.layout, data: d }
}

// The quarter turns and the transpose: the pixel `(x, y)` goes to row
// `ry + x * dy` and column `cx + y * dx` of a `height` by `width` image.
fun turned<S: Sample>(img: Image<S>, ry: int, dy: int, cx: int, dx: int) -> Image<S> {
    let ch = img.layout.channels()
    let h = img.height
    var p = Pixels { out: list_m.filled(img.data.len(), S.from_unorm8(0u8)) }
    // a row of the source is a column of the output, whose rows are `h`
    // pixels long
    for y in 0..h {
        p.copy(img.data, y * img.width * ch, (ry * h + cx + y * dx) * ch, dy * h * ch, img.width, ch)
    }
    return Image { width: h, height: img.width, layout: img.layout, data: p.out }
}

// The samples being moved by the flips and turns.
struct Pixels<S> {
    out: [S],
}

impl<S: Sample> Pixels<S> {
    // Copies `count` pixels of `ch` samples, from `d` at `i` on, one after
    // the other, to `out` at `j` on, `step` samples apart; unrolled for
    // each number of channels.
    fun copy(var self, d: [S], i: int, j: int, step: int, count: int, ch: int) {
        var o = self.out
        self.out = []
        var a = i
        var b = j
        if ch == 1 {
            for _ in 0..count {
                o[b] = d[a]
                a += 1
                b += step
            }
        } else if ch == 2 {
            for _ in 0..count {
                o[b] = d[a]
                o[b + 1] = d[a + 1]
                a += 2
                b += step
            }
        } else if ch == 3 {
            for _ in 0..count {
                o[b] = d[a]
                o[b + 1] = d[a + 1]
                o[b + 2] = d[a + 2]
                a += 3
                b += step
            }
        } else {
            for _ in 0..count {
                o[b] = d[a]
                o[b + 1] = d[a + 1]
                o[b + 2] = d[a + 2]
                o[b + 3] = d[a + 3]
                a += 4
                b += step
            }
        }
        self.out = o
    }
}

// The gray planes `planes` (each a channel, in order) as one image of
// `layout`: `Mismatch` if their number isn't the layout's channels, or one
// isn't gray or the first one's size.
pub fun merge<S: Sample>(planes: [Image<S>], layout: Layout) -> Result<Image<S>, ImageError> {
    let ch = layout.channels()
    if planes.len() != ch {
        return Err(ImageError.Mismatch(f"{layout} needs {ch} planes, got {planes.len()}"))
    }
    let w = planes[0].width
    let h = planes[0].height
    for (k, p) in planes.enumerate() {
        if p.layout != Layout.Gray || p.width != w || p.height != h {
            return Err(ImageError.Mismatch(f"plane {k} is a {p.width}x{p.height} {p.layout} image, not {w}x{h} gray"))
        }
    }
    let n = w * h
    var out = list_m.filled(n * ch, S.from_unorm8(0u8))
    for c in 0..ch {
        let d = planes[c].data
        var j = c
        for i in 0..n {
            out[j] = d[i]
            j += ch
        }
    }
    return Ok(Image { width: w, height: h, layout: layout, data: out })
}

// The colour of `r`, `g`, `b`, opaque.
#test(1u8, 2u8, 3u8)[Color { r: 1u8, g: 2u8, b: 3u8, a: 255u8 }]
pub fun rgb(r: uint8, g: uint8, b: uint8) -> Color {
    return Color { r: r, g: g, b: b, a: 255u8 }
}

// The colour of `r`, `g`, `b` and alpha `a`.
#test(1u8, 2u8, 3u8, 4u8)[Color { r: 1u8, g: 2u8, b: 3u8, a: 4u8 }]
pub fun rgba(r: uint8, g: uint8, b: uint8, a: uint8) -> Color {
    return Color { r: r, g: g, b: b, a: a }
}

// The rectangle at `(x, y)` of `w` by `h`.
#test(1, 2, 3, 4)[Rect { x: 1, y: 2, w: 3, h: 4 }]
pub fun rect(x: int, y: int, w: int, h: int) -> Rect {
    return Rect { x: x, y: y, w: w, h: h }
}

impl Rect {
    // Whether the pixel `(x, y)` lies inside.
    #test(Rect { x: 1, y: 2, w: 3, h: 4 }, 3, 5)[true]
    #test(Rect { x: 1, y: 2, w: 3, h: 4 }, 4, 5)[false]
    #test(Rect { x: 1, y: 2, w: 3, h: 4 }, 1, 1)[false]
    #test(Rect { x: 2147483646, y: 0, w: 5, h: 1 }, 2147483647, 0)[true]
    fun contains(self, x: int, y: int) -> bool {
        return x >= self.x && y >= self.y && (x as int64) < (self.x as int64) + (self.w as int64) && (y as int64) < (self.y as int64) + (self.h as int64)
    }

    // Whether it holds no pixel: a width or height of 0 or less.
    #test(Rect { x: 1, y: 2, w: 0, h: 4 })[true]
    #test(Rect { x: 1, y: 2, w: 1, h: 1 })[false]
    fun is_empty(self) -> bool {
        return self.w <= 0 || self.h <= 0
    }

    // The pixels inside both; `rect(0, 0, 0, 0)` if there are none.
    #test(Rect { x: 0, y: 0, w: 4, h: 4 }, Rect { x: 2, y: -1, w: 5, h: 2 })[Rect { x: 2, y: 0, w: 2, h: 1 }]
    #test(Rect { x: 0, y: 0, w: 4, h: 4 }, Rect { x: 4, y: 0, w: 5, h: 2 })[Rect { x: 0, y: 0, w: 0, h: 0 }]
    #test(Rect { x: 0, y: 0, w: 4, h: 4 }, Rect { x: 1, y: 1, w: -3, h: 2 })[Rect { x: 0, y: 0, w: 0, h: 0 }]
    fun intersect(self, o: Rect) -> Rect {
        let x0 = if self.x > o.x { self.x } else { o.x }
        let y0 = if self.y > o.y { self.y } else { o.y }
        let a = (self.x as int64) + (self.w as int64)
        let b = (o.x as int64) + (o.w as int64)
        let x1 = if a < b { a } else { b }
        let c = (self.y as int64) + (self.h as int64)
        let d = (o.y as int64) + (o.h as int64)
        let y1 = if c < d { c } else { d }
        if x1 <= (x0 as int64) || y1 <= (y0 as int64) {
            return Rect { x: 0, y: 0, w: 0, h: 0 }
        }
        return Rect { x: x0, y: y0, w: (x1 - (x0 as int64)) as int, h: (y1 - (y0 as int64)) as int }
    }
}

impl Color {
    // The colour with alpha `a`.
    #test(Color { r: 1u8, g: 2u8, b: 3u8, a: 255u8 }, 9u8)[Color { r: 1u8, g: 2u8, b: 3u8, a: 9u8 }]
    fun with_alpha(self, a: uint8) -> Color {
        return Color { r: self.r, g: self.g, b: self.b, a: a }
    }

    // The colour a fraction `t` of the way to `o`, every channel (alpha
    // too) rounded; `t` clamped to 0..1.
    #test(Color { r: 0u8, g: 100u8, b: 255u8, a: 255u8 }, Color { r: 255u8, g: 0u8, b: 255u8, a: 0u8 }, 0.5f32)[Color { r: 128u8, g: 50u8, b: 255u8, a: 128u8 }]
    #test(Color { r: 0u8, g: 100u8, b: 255u8, a: 255u8 }, Color { r: 255u8, g: 0u8, b: 255u8, a: 0u8 }, 0.0f32)[Color { r: 0u8, g: 100u8, b: 255u8, a: 255u8 }]
    #test(Color { r: 0u8, g: 100u8, b: 255u8, a: 255u8 }, Color { r: 255u8, g: 0u8, b: 255u8, a: 0u8 }, 7.0f32)[Color { r: 255u8, g: 0u8, b: 255u8, a: 0u8 }]
    fun lerp(self, o: Color, t: float32) -> Color {
        let k = if t.is_nan() || t <= 0.0f32 { 0.0f32 } else if t >= 1.0f32 { 1.0f32 } else { t }
        return Color { r: lerp8(self.r, o.r, k), g: lerp8(self.g, o.g, k), b: lerp8(self.b, o.b, k), a: lerp8(self.a, o.a, k) }
    }
}

fun lerp8(a: uint8, b: uint8, t: float32) -> uint8 {
    let x = a as float32
    return uint8.from_f32(x + ((b as float32) - x) * t)
}

impl Format for Color {
    // `#rrggbbaa` in lower case, which `parse_color` reads back; the spec
    // is ignored.
    #test(Color { r: 255u8, g: 136u8, b: 0u8, a: 255u8 }, "")["#ff8800ff"]
    #test(Color { r: 1u8, g: 2u8, b: 3u8, a: 4u8 }, "")["#01020304"]
    fun format(self, spec: str) -> str {
        return f"#{self.r:02x}{self.g:02x}{self.b:02x}{self.a:02x}"
    }
}

// The colour of `#rgb`, `#rgba`, `#rrggbb` or `#rrggbbaa` (hex digits in
// either case); None for anything else.
#test("#ff8800")[Some(Color { r: 255u8, g: 136u8, b: 0u8, a: 255u8 })]
#test("#FF880080")[Some(Color { r: 255u8, g: 136u8, b: 0u8, a: 128u8 })]
#test("#f80")[Some(Color { r: 255u8, g: 136u8, b: 0u8, a: 255u8 })]
#test("#f808")[Some(Color { r: 255u8, g: 136u8, b: 0u8, a: 136u8 })]
#test("ff8800")[None]
#test("#ff88")[Some(Color { r: 255u8, g: 255u8, b: 136u8, a: 136u8 })]
#test("#ff880")[None]
#test("#gg8800")[None]
#test("")[None]
pub fun parse_color(s: str) -> Option<Color> {
    let n = s.len() - 1
    if n < 0 || s[0] != '#' || (n != 3 && n != 4 && n != 6 && n != 8) {
        return None
    }
    var v = list_m.filled(n, 0)
    for i in 0..n {
        let d = hex_digit(s[i + 1])
        if d < 0 {
            return None
        }
        v[i] = d
    }
    if n <= 4 {
        let a = if n == 4 { v[3] * 17 } else { 255 }
        return Some(Color { r: (v[0] * 17) as uint8, g: (v[1] * 17) as uint8, b: (v[2] * 17) as uint8, a: a as uint8 })
    }
    let a = if n == 8 { v[6] * 16 + v[7] } else { 255 }
    return Some(Color { r: (v[0] * 16 + v[1]) as uint8, g: (v[2] * 16 + v[3]) as uint8, b: (v[4] * 16 + v[5]) as uint8, a: a as uint8 })
}

// The value of a hex digit, -1 if `b` isn't one.
#test(102u8)[15]
#test(57u8)[9]
#test(71u8)[-1]
fun hex_digit(b: uint8) -> int {
    if b >= '0' && b <= '9' {
        return (b - '0') as int
    }
    if b >= 'a' && b <= 'f' {
        return (b - 'a') as int + 10
    }
    if b >= 'A' && b <= 'F' {
        return (b - 'A') as int + 10
    }
    return -1
}

// An image of palette indices: what PNG palettes and GIF store, and what
// `quantize` makes. The pixel `(x, y)` is `palette[indices[y * width + x]]`.
#derive(Eq)
pub struct Indexed {
    width: int,
    height: int,
    palette: [Color],
    indices: [uint8],
}

impl Indexed {
    // The pixels again: `Rgb` if every colour of the palette is opaque,
    // else `Rgba`. An index past the palette is transparent black.
    fun to_image(self) -> Image8 {
        let p = self.palette
        var alpha = false
        for c in p {
            if c.a != 255u8 {
                alpha = true
            }
        }
        for i in self.indices {
            if (i as int) >= p.len() {
                alpha = true
            }
        }
        let ch = if alpha { 4 } else { 3 }
        let n = self.indices.len()
        var out = list_m.filled(n * ch, 0u8)
        var j = 0
        for i in self.indices {
            if (i as int) < p.len() {
                let c = p[i as int]
                out[j] = c.r
                out[j + 1] = c.g
                out[j + 2] = c.b
                if alpha {
                    out[j + 3] = c.a
                }
            }
            j += ch
        }
        let layout = if alpha { Layout.Rgba } else { Layout.Rgb }
        return Image { width: self.width, height: self.height, layout: layout, data: out }
    }
}

// `img` reduced to at most `colors` colours (1 to 256; else a failure):
// exactly its own colours if it has that few, else a palette by median
// cut (Heckbert's: the box with the widest channel range split at its
// median pixel, alpha a channel like the others), every pixel mapped to
// the nearest colour, with Floyd–Steinberg dithering of red, green and
// blue if `dither`. Deterministic, in integers.
pub fun quantize(img: Image8, colors: int, dither: bool = true) -> Indexed {
    if colors < 1 || colors > 256 {
        panic(f"quantize to {colors} colours: it takes 1 to 256")
    }
    let w = img.width
    let n = w * img.height
    let px = packed_rgba(img)
    var sorted = px
    sorted.sort_unstable()
    // the distinct colours, in order, and how many pixels each has
    var keys: [uint32] = []
    var counts: [int] = []
    for v in sorted {
        if keys.len() > 0 && keys[keys.len() - 1] == v {
            counts[counts.len() - 1] += 1
        } else {
            keys.push(v)
            counts.push(1)
        }
    }
    var indices = list_m.filled(n, 0u8)
    if keys.len() <= colors {
        var palette: [Color] = []
        for k in keys {
            palette.push(unpack(k))
        }
        for i in 0..n {
            indices[i] = find_key(keys, px[i]) as uint8
        }
        return Indexed { width: w, height: img.height, palette: palette, indices: indices }
    }
    let palette = median_cut(keys, counts, colors)
    let near = nearest_table(palette)
    if !dither {
        var of_key = list_m.filled(keys.len(), 0u8)
        for k in 0..keys.len() {
            let c = unpack(keys[k])
            of_key[k] = near.find(c.r as int, c.g as int, c.b as int, c.a as int) as uint8
        }
        for i in 0..n {
            indices[i] = of_key[find_key(keys, px[i])]
        }
        return Indexed { width: w, height: img.height, palette: palette, indices: indices }
    }
    // Floyd–Steinberg: the errors of this row and the next, times 16, with
    // a pixel of margin on each side
    var cur = list_m.filled((w + 2) * 3, 0)
    var nxt = list_m.filled((w + 2) * 3, 0)
    var i = 0
    for _ in 0..img.height {
        for x in 0..w {
            let v = px[i]
            let e = (x + 1) * 3
            let r = clamp255(((v >> 24) as int) + ((cur[e] + 8) >> 4))
            let g = clamp255((((v >> 16) & 255u32) as int) + ((cur[e + 1] + 8) >> 4))
            let b = clamp255((((v >> 8) & 255u32) as int) + ((cur[e + 2] + 8) >> 4))
            let k = near.find(r, g, b, (v & 255u32) as int)
            indices[i] = k as uint8
            let p = palette[k]
            let dr = r - (p.r as int)
            let dg = g - (p.g as int)
            let db = b - (p.b as int)
            cur[e + 3] += dr * 7
            cur[e + 4] += dg * 7
            cur[e + 5] += db * 7
            nxt[e - 3] += dr * 3
            nxt[e - 2] += dg * 3
            nxt[e - 1] += db * 3
            nxt[e] += dr * 5
            nxt[e + 1] += dg * 5
            nxt[e + 2] += db * 5
            nxt[e + 3] += dr
            nxt[e + 4] += dg
            nxt[e + 5] += db
            i += 1
        }
        cur = nxt
        nxt = list_m.filled((w + 2) * 3, 0)
    }
    return Indexed { width: w, height: img.height, palette: palette, indices: indices }
}

fun clamp255(v: int) -> int {
    return if v < 0 { 0 } else if v > 255 { 255 } else { v }
}

// Every pixel of `img` as `r << 24 | g << 16 | b << 8 | a`.
fun packed_rgba(img: Image8) -> [uint32] {
    let n = img.width * img.height
    let d = img.data
    var out = list_m.filled(n, 0u32)
    var i = 0
    match img.layout {
        Gray => {
            for j in 0..n {
                let g = d[j] as uint32
                out[j] = (g << 24) | (g << 16) | (g << 8) | 255u32
            }
        }
        GrayAlpha => {
            for j in 0..n {
                let g = d[i] as uint32
                out[j] = (g << 24) | (g << 16) | (g << 8) | (d[i + 1] as uint32)
                i += 2
            }
        }
        Rgb => {
            for j in 0..n {
                out[j] = ((d[i] as uint32) << 24) | ((d[i + 1] as uint32) << 16) | ((d[i + 2] as uint32) << 8) | 255u32
                i += 3
            }
        }
        Rgba => {
            for j in 0..n {
                out[j] = ((d[i] as uint32) << 24) | ((d[i + 1] as uint32) << 16) | ((d[i + 2] as uint32) << 8) | (d[i + 3] as uint32)
                i += 4
            }
        }
    }
    return out
}

#test(0x01020304u32)[Color { r: 1u8, g: 2u8, b: 3u8, a: 4u8 }]
fun unpack(v: uint32) -> Color {
    return Color { r: (v >> 24) as uint8, g: ((v >> 16) & 255u32) as uint8, b: ((v >> 8) & 255u32) as uint8, a: (v & 255u32) as uint8 }
}

// The position of `v` in the sorted `keys`, which hold it.
#test([1u32, 5u32, 9u32, 12u32], 9u32)[2]
#test([1u32, 5u32, 9u32, 12u32], 1u32)[0]
fun find_key(keys: [uint32], v: uint32) -> int {
    var lo = 0
    var hi = keys.len() - 1
    while lo < hi {
        let mid = (lo + hi) / 2
        if keys[mid] < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// Channel `c` (0 red to 3 alpha) of a packed colour.
fun chan(v: uint32, c: int) -> int {
    return ((v >> (24 - 8 * c) as uint32) & 255u32) as int
}

// A box of median cut: the entries `start..end` of the order, the channel
// with the widest range and that range.
struct CutBox {
    start: int,
    end: int,
    channel: int,
    range: int,
}

fun cut_box(keys: [uint32], order: [int], start: int, end: int) -> CutBox {
    var best = 0
    var range = -1
    for c in 0..4 {
        var lo = 255
        var hi = 0
        for k in start..end {
            let v = chan(keys[order[k]], c)
            if v < lo {
                lo = v
            }
            if v > hi {
                hi = v
            }
        }
        if hi - lo > range {
            range = hi - lo
            best = c
        }
    }
    return CutBox { start: start, end: end, channel: best, range: range }
}

// A palette of `colors` colours for the distinct `keys` with `counts`
// pixels each, by median cut; each colour the mean of its box's pixels.
fun median_cut(keys: [uint32], counts: [int], colors: int) -> [Color] {
    let m = keys.len()
    var order = list_m.filled(m, 0)
    for k in 0..m {
        order[k] = k
    }
    var boxes = [cut_box(keys, order, 0, m)]
    while boxes.len() < colors {
        var pick = -1
        for b in 0..boxes.len() {
            let x = boxes[b]
            if x.end - x.start >= 2 && (pick < 0 || x.range > boxes[pick].range) {
                pick = b
            }
        }
        if pick < 0 {
            break
        }
        let x = boxes[pick]
        // the box's entries by the channel, then by position for ties
        var keyed = list_m.filled(x.end - x.start, 0i64)
        for k in x.start..x.end {
            keyed[k - x.start] = ((chan(keys[order[k]], x.channel) as int64) << 32) | (order[k] as int64)
        }
        keyed.sort_unstable()
        var total: int64 = 0
        for k in x.start..x.end {
            let e = (keyed[k - x.start] & 0xFFFFFFFFi64) as int
            order[k] = e
            total += counts[e] as int64
        }
        // split after the entry that holds the median pixel, leaving
        // neither half empty
        var acc: int64 = 0
        var s = x.start + 1
        for k in x.start..x.end - 1 {
            acc += counts[order[k]] as int64
            s = k + 1
            if acc * 2 >= total {
                break
            }
        }
        boxes[pick] = cut_box(keys, order, x.start, s)
        boxes.push(cut_box(keys, order, s, x.end))
    }
    var palette: [Color] = []
    for x in boxes {
        var sums = [0i64, 0i64, 0i64, 0i64]
        var total: int64 = 0
        for k in x.start..x.end {
            let e = order[k]
            let c = counts[e] as int64
            for ch in 0..4 {
                sums[ch] += (chan(keys[e], ch) as int64) * c
            }
            total += c
        }
        let half = total / 2
        palette.push(Color { r: ((sums[0] + half) / total) as uint8, g: ((sums[1] + half) / total) as uint8, b: ((sums[2] + half) / total) as uint8, a: ((sums[3] + half) / total) as uint8 })
    }
    return palette
}

// A palette sorted by red, for the nearest colour: a search outwards from
// the red asked for stops once red alone is farther than the best.
struct Nearest {
    r: [int],
    g: [int],
    b: [int],
    a: [int],
    index: [int],
}

fun nearest_table(palette: [Color]) -> Nearest {
    var keyed: [int] = []
    for (k, c) in palette.enumerate() {
        keyed.push((c.r as int) * 256 + k)
    }
    keyed.sort_unstable()
    var t = Nearest { r: [], g: [], b: [], a: [], index: [] }
    for v in keyed {
        let c = palette[v % 256]
        t.r.push(c.r as int)
        t.g.push(c.g as int)
        t.b.push(c.b as int)
        t.a.push(c.a as int)
        t.index.push(v % 256)
    }
    return t
}

impl Nearest {
    // The palette index nearest `(r, g, b, a)` in squared distance, the
    // lowest index among equals.
    fun find(self, r: int, g: int, b: int, a: int) -> int {
        let n = self.r.len()
        var lo = 0
        var hi = n
        while lo < hi {
            let mid = (lo + hi) / 2
            if self.r[mid] < r {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        var best = 0x7FFFFFFF
        var best_index = 0
        var up = lo
        var down = lo - 1
        while up < n || down >= 0 {
            if up < n {
                let dr = self.r[up] - r
                if dr * dr > best {
                    up = n
                } else {
                    let dg = self.g[up] - g
                    let db = self.b[up] - b
                    let da = self.a[up] - a
                    let d = dr * dr + dg * dg + db * db + da * da
                    if d < best || (d == best && self.index[up] < best_index) {
                        best = d
                        best_index = self.index[up]
                    }
                    up += 1
                }
            }
            if down >= 0 {
                let dr = self.r[down] - r
                if dr * dr > best {
                    down = -1
                } else {
                    let dg = self.g[down] - g
                    let db = self.b[down] - b
                    let da = self.a[down] - a
                    let d = dr * dr + dg * dg + db * db + da * da
                    if d < best || (d == best && self.index[down] < best_index) {
                        best = d
                        best_index = self.index[down]
                    }
                    down -= 1
                }
            }
        }
        return best_index
    }
}

// The image as truecolor half blocks for a terminal, two pixels a
// character cell (`▀`, its top the foreground and its bottom the
// background), each line ending in a reset and a newline: `print` it.
// Scaled down to `columns` wide (never up), the height in proportion,
// each pixel the average of the source pixels it covers, weighted by
// alpha; one less than half opaque is left to the terminal's background.
pub fun ansi<S: Sample>(img: Image<S>, columns: int) -> str {
    let w = img.width
    let h = img.height
    if w == 0 || h == 0 || columns < 1 {
        return ""
    }
    let cols = if columns < w { columns } else { w }
    let rows64 = ((h as int64) * (cols as int64) * 2i64 + (w as int64)) / ((w as int64) * 2i64)
    let rows = if rows64 < 1i64 { 1 } else { rows64 as int }
    // each pixel of the preview as 0xrrggbb, -1 where transparent
    var px = list_m.filled(rows * cols, -1)
    for ty in 0..rows {
        let y0 = ((ty as int64) * (h as int64) / (rows as int64)) as int
        let y1 = (((ty + 1) as int64) * (h as int64) / (rows as int64)) as int
        for tx in 0..cols {
            let x0 = ((tx as int64) * (w as int64) / (cols as int64)) as int
            let x1 = (((tx + 1) as int64) * (w as int64) / (cols as int64)) as int
            var sr: int64 = 0
            var sg: int64 = 0
            var sb: int64 = 0
            var sa: int64 = 0
            for y in y0..y1 {
                for x in x0..x1 {
                    let c = img.color_at(x, y)
                    let a = c.a as int64
                    sr += (c.r as int64) * a
                    sg += (c.g as int64) * a
                    sb += (c.b as int64) * a
                    sa += a
                }
            }
            let area = ((y1 - y0) as int64) * ((x1 - x0) as int64)
            if sa * 2i64 >= 255i64 * area {
                let half = sa / 2i64
                px[ty * cols + tx] = ((((sr + half) / sa) as int) << 16) | ((((sg + half) / sa) as int) << 8) | (((sb + half) / sa) as int)
            }
        }
    }
    var out = StringBuilder()
    var ty = 0
    while ty < rows {
        var fg = -1
        var bg = -1
        for tx in 0..cols {
            let top = px[ty * cols + tx]
            let bottom = if ty + 1 < rows { px[(ty + 1) * cols + tx] } else { -1 }
            let (f, b, glyph) = if top >= 0 { (top, bottom, "▀") } else if bottom >= 0 { (bottom, -1, "▄") } else { (fg, -1, " ") }
            if f != fg {
                out.append(sgr(38, f))
                fg = f
            }
            if b != bg {
                out.append(sgr(48, b))
                bg = b
            }
            out.append(glyph)
        }
        out.append("\u{1b}[0m\n")
        ty += 2
    }
    return out.build()
}

// The escape that sets the foreground (38) or background (48) to `c`,
// 0xrrggbb, or back to the terminal's own (-1).
#test(38, 0xff8001)["\u{1b}[38;2;255;128;1m"]
#test(48, -1)["\u{1b}[49m"]
fun sgr(code: int, c: int) -> str {
    if c < 0 {
        return f"\u{1b}[{code + 1}m"
    }
    return f"\u{1b}[{code};2;{(c >> 16) & 255};{(c >> 8) & 255};{c & 255}m"
}

// A test of the generic parts: construction, indexing and their checks.
#test
fun image_basics() {
    var img: Image8 = new(3, 2, Layout.Rgb, 0u8)
    assert(img.data.len() == 18)
    img[(2, 1, 0)] = 200u8
    assert(img[(2, 1, 0)] == 200u8)
    assert(img.data[img.offset(2, 1, 0)] == 200u8)
    assert(img.get(3, 0, 0) == None)
    assert(img.get(2, 1, 0) == Some(200u8))
    let f: ImageF = new(1, 1, Layout.Gray, 0.5f32)
    assert(f[(0, 0, 0)] == 0.5f32)
    match from_data<uint8>(2, 2, Layout.Gray, [1u8, 2u8, 3u8]) {
        Ok(_) => assert(false)
        Err(e) => assert(e == ImageError.Mismatch("2x2 gray needs 4 samples, got 3"))
    }
    let ok = from_data<uint16>(1, 2, Layout.Gray, [1u16, 2u16]).expect("an image")
    assert(ok.height == 2)
}

// The test functions of the generic parts (D162). The values marked
// "Pillow" are what Pillow 13 gives for the same pixels.

fun test_img(w: int, h: int, layout: Layout, xs: [uint8]) -> Image8 {
    return from_data<uint8>(w, h, layout, xs).expect("a test image")
}

#test
fun pixels_as_colors() {
    let g = test_img(2, 1, Layout.Gray, [7u8, 9u8])
    assert(g.color_at(1, 0) == rgb(9u8, 9u8, 9u8))
    let ga = test_img(1, 1, Layout.GrayAlpha, [7u8, 100u8])
    assert(ga.color_at(0, 0) == rgba(7u8, 7u8, 7u8, 100u8))
    let c = test_img(1, 1, Layout.Rgb, [1u8, 2u8, 3u8])
    assert(c.color_at(0, 0) == rgb(1u8, 2u8, 3u8))
    let w: Image16 = new(1, 1, Layout.Rgba, 65535u16)
    assert(w.color_at(0, 0) == rgba(255u8, 255u8, 255u8, 255u8))
    let f: ImageF = new(1, 1, Layout.GrayAlpha, 0.5f32)
    assert(f.color_at(0, 0) == rgba(128u8, 128u8, 128u8, 128u8))

    var gray: Image8 = new(2, 1, Layout.Gray, 0u8)
    gray.set_color(1, 0, rgb(10u8, 200u8, 30u8))
    assert(gray.data == [0u8, 124u8])
    var la: Image16 = new(1, 1, Layout.GrayAlpha, 0u16)
    la.set_color(0, 0, rgba(255u8, 255u8, 255u8, 1u8))
    assert(la.data == [65535u16, 257u16])
    var rgb_img: Image8 = new(1, 1, Layout.Rgb, 0u8)
    rgb_img.set_color(0, 0, rgba(1u8, 2u8, 3u8, 4u8))
    assert(rgb_img.data == [1u8, 2u8, 3u8])
    var fa: ImageF = new(1, 1, Layout.Rgba, 0.0f32)
    fa.set_color(0, 0, rgba(255u8, 0u8, 0u8, 255u8))
    assert(fa.data == [1.0f32, 0.0f32, 0.0f32, 1.0f32])
}

#test
fun rows_planes_and_merge() {
    let img = test_img(2, 2, Layout.GrayAlpha, [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8])
    assert(img.row(1) == [5u8, 6u8, 7u8, 8u8])
    let a = img.channel(1)
    assert(a.layout == Layout.Gray && a.width == 2 && a.data == [2u8, 4u8, 6u8, 8u8])
    let back = merge([img.channel(0), a], Layout.GrayAlpha).expect("merged")
    assert(back == img)
    match merge([a], Layout.Rgb) {
        Ok(_) => assert(false)
        Err(e) => assert(e == ImageError.Mismatch("rgb needs 3 planes, got 1"))
    }
    match merge([a, test_img(1, 1, Layout.Gray, [0u8])], Layout.GrayAlpha) {
        Ok(_) => assert(false)
        Err(e) => assert(e == ImageError.Mismatch("plane 1 is a 1x1 gray image, not 2x2 gray"))
    }
    assert(img.bounds() == rect(0, 0, 2, 2))
}

#test
fun converting_layouts() {
    // Pillow: convert("L") of these triples
    let c = test_img(4, 1, Layout.Rgb, [10u8, 200u8, 30u8, 255u8, 0u8, 0u8, 1u8, 2u8, 3u8, 254u8, 1u8, 127u8])
    assert(c.convert(Layout.Gray).data == [124u8, 76u8, 2u8, 91u8])
    assert(c.convert(Layout.GrayAlpha).data == [124u8, 255u8, 76u8, 255u8, 2u8, 255u8, 91u8, 255u8])
    assert(c.convert(Layout.Rgba).convert(Layout.Rgb) == c)
    assert(c.convert(Layout.Rgb) == c)
    // Pillow: convert("LA") of RGBA
    let ca = test_img(2, 1, Layout.Rgba, [200u8, 100u8, 50u8, 128u8, 10u8, 20u8, 30u8, 0u8])
    assert(ca.convert(Layout.GrayAlpha).data == [124u8, 128u8, 18u8, 0u8])
    assert(ca.convert(Layout.Gray).data == [124u8, 18u8])
    assert(ca.convert(Layout.Rgb).data == [200u8, 100u8, 50u8, 10u8, 20u8, 30u8])
    let g = test_img(2, 1, Layout.GrayAlpha, [7u8, 100u8, 9u8, 0u8])
    assert(g.convert(Layout.Rgba).data == [7u8, 7u8, 7u8, 100u8, 9u8, 9u8, 9u8, 0u8])
    assert(g.convert(Layout.Rgb).data == [7u8, 7u8, 7u8, 9u8, 9u8, 9u8])
    assert(g.convert(Layout.Gray).data == [7u8, 9u8])
    assert(g.convert(Layout.Gray).convert(Layout.GrayAlpha).data == [7u8, 255u8, 9u8, 255u8])
    assert(g.convert(Layout.Gray).convert(Layout.Rgba).data == [7u8, 7u8, 7u8, 255u8, 9u8, 9u8, 9u8, 255u8])
    let f: ImageF = new(1, 1, Layout.Rgb, 1.0f32)
    assert(f.convert(Layout.GrayAlpha).data == [0.299f32 + 0.587f32 + 0.114f32, 1.0f32])
    let w = from_data<uint16>(1, 1, Layout.Rgb, [2570u16, 51400u16, 7710u16]).expect("an image")
    assert(w.convert(Layout.Gray).data == [31819u16])
}

#test
fun sample_types() {
    let img = test_img(3, 1, Layout.Gray, [0u8, 51u8, 255u8])
    let f = img.to_f32()
    assert(f.data == [0.0f32, 0.2f32, 1.0f32])
    assert(f.to_u8() == img)
    assert(img.to_u16().data == [0u16, 13107u16, 65535u16])
    assert(img.to_u16().to_u8() == img)
    assert(img.to_u8() == img)
    let over = from_data<float32>(2, 1, Layout.Gray, [-0.5f32, 1.5f32]).expect("an image")
    assert(over.to_u8().data == [0u8, 255u8])
    assert(over.to_u16().data == [0u16, 65535u16])
    let inv = img.map<uint8>((v: uint8) => 255u8 - v)
    assert(inv.data == [255u8, 204u8, 0u8])
    let half = img.map<float32>((v: uint8) => (v as float32) / 2.0f32)
    assert(half.layout == Layout.Gray && half.data == [0.0f32, 25.5f32, 127.5f32])
}

#test
fun crops_pastes_and_fills() {
    let img = test_img(3, 2, Layout.Gray, [1u8, 2u8, 3u8, 4u8, 5u8, 6u8])
    assert(img.crop(rect(1, 0, 2, 2)).data == [2u8, 3u8, 5u8, 6u8])
    let clipped = img.crop(rect(2, 1, 5, 5))
    assert(clipped.width == 1 && clipped.height == 1 && clipped.data == [6u8])
    assert(img.crop(rect(5, 5, 2, 2)).data.len() == 0)
    assert(img.crop(rect(-1, -1, 2, 2)).data == [1u8])

    var dst: Image8 = new(3, 2, Layout.Gray, 0u8)
    dst.paste(test_img(2, 2, Layout.Gray, [7u8, 8u8, 9u8, 10u8]), 2, -1)
    assert(dst.data == [0u8, 0u8, 9u8, 0u8, 0u8, 0u8])
    dst.paste(test_img(1, 1, Layout.Rgb, [255u8, 0u8, 0u8]), 0, 1)
    assert(dst.data == [0u8, 0u8, 9u8, 76u8, 0u8, 0u8])
    dst.paste(img, 100, 0)
    dst.paste(img, -100, 0)
    assert(dst.data == [0u8, 0u8, 9u8, 76u8, 0u8, 0u8])
    dst.paste(img, 0, 0)
    assert(dst == img)

    var c: Image8 = new(2, 1, Layout.Rgb, 0u8)
    c.fill([1u8, 2u8, 3u8])
    assert(c.data == [1u8, 2u8, 3u8, 1u8, 2u8, 3u8])
}

#test
fun flips_and_rotations() {
    // 1 2 3
    // 4 5 6
    let img = test_img(3, 2, Layout.Gray, [1u8, 2u8, 3u8, 4u8, 5u8, 6u8])
    assert(img.flip_h().data == [3u8, 2u8, 1u8, 6u8, 5u8, 4u8])
    assert(img.flip_v().data == [4u8, 5u8, 6u8, 1u8, 2u8, 3u8])
    assert(img.rotate180().data == [6u8, 5u8, 4u8, 3u8, 2u8, 1u8])
    let cw = img.rotate90()
    assert(cw.width == 2 && cw.height == 3 && cw.data == [4u8, 1u8, 5u8, 2u8, 6u8, 3u8])
    let ccw = img.rotate270()
    assert(ccw.width == 2 && ccw.height == 3 && ccw.data == [3u8, 6u8, 2u8, 5u8, 1u8, 4u8])
    let t = img.transpose()
    assert(t.width == 2 && t.height == 3 && t.data == [1u8, 4u8, 2u8, 5u8, 3u8, 6u8])
    assert(img.rotate90().rotate270() == img && img.transpose().transpose() == img)
    // whole pixels move, their samples in order
    let two = test_img(2, 1, Layout.GrayAlpha, [1u8, 2u8, 3u8, 4u8])
    assert(two.flip_h().data == [3u8, 4u8, 1u8, 2u8])
    assert(two.rotate90().data == [1u8, 2u8, 3u8, 4u8] && two.rotate90().height == 2)
    assert(two.rotate270().data == [3u8, 4u8, 1u8, 2u8])
}

#test
fun premultiplying_alpha() {
    // Pillow: convert("RGBa"), and back to "RGBA"
    let img = test_img(2, 1, Layout.Rgba, [200u8, 100u8, 50u8, 128u8, 10u8, 20u8, 30u8, 0u8])
    let p = img.premultiplied()
    assert(p.data == [100u8, 50u8, 25u8, 128u8, 0u8, 0u8, 0u8, 0u8])
    assert(p.unpremultiplied().data == [199u8, 99u8, 49u8, 128u8, 0u8, 0u8, 0u8, 0u8])
    let g = test_img(1, 1, Layout.GrayAlpha, [255u8, 51u8])
    assert(g.premultiplied().data == [51u8, 51u8])
    let opaque = test_img(1, 1, Layout.Rgb, [1u8, 2u8, 3u8])
    assert(opaque.premultiplied() == opaque && opaque.unpremultiplied() == opaque)
    // 39196 * 5505 / 65535 is 3292.4997...: float32 alone rounds it up
    let w = from_data<uint16>(1, 1, Layout.GrayAlpha, [39196u16, 5505u16]).expect("an image")
    assert(w.premultiplied().data == [3292u16, 5505u16])
    let f = from_data<float32>(1, 1, Layout.GrayAlpha, [0.5f32, 0.5f32]).expect("an image")
    assert(f.premultiplied().data == [0.25f32, 0.5f32])
    assert(f.premultiplied().unpremultiplied() == f)
}

#test
fun quantizing() {
    // as few colours as asked: exact, the palette in order
    let few = test_img(3, 1, Layout.Rgba, [9u8, 9u8, 9u8, 0u8, 255u8, 0u8, 0u8, 255u8, 9u8, 9u8, 9u8, 0u8])
    let q = quantize(few, 2)
    assert(q.palette == [rgba(9u8, 9u8, 9u8, 0u8), rgb(255u8, 0u8, 0u8)])
    assert(q.indices == [0u8, 1u8, 0u8] && q.width == 3 && q.height == 1)
    assert(q.to_image() == few)
    let one = quantize(test_img(2, 1, Layout.Gray, [5u8, 5u8]), 1)
    assert(one.palette == [rgb(5u8, 5u8, 5u8)] && one.to_image().data == [5u8, 5u8, 5u8, 5u8, 5u8, 5u8])

    // 0 to 15 in four boxes of four, each its rounded mean; 4, 8 and 12 lie
    // halfway, and go to the lower index
    var ramp: [uint8] = []
    for v in 0..16 {
        ramp.push(v as uint8)
    }
    let g = test_img(16, 1, Layout.Gray, ramp)
    let m = quantize(g, 4, false)
    assert(m.palette == [rgb(2u8, 2u8, 2u8), rgb(10u8, 10u8, 10u8), rgb(6u8, 6u8, 6u8), rgb(14u8, 14u8, 14u8)])
    assert(m.indices == [0u8, 0u8, 0u8, 0u8, 0u8, 2u8, 2u8, 2u8, 1u8, 1u8, 1u8, 1u8, 1u8, 3u8, 3u8, 3u8])

    // dithering keeps a ramp's mean where two colours alone can't
    var big: [uint8] = []
    for y in 0..8 {
        for x in 0..16 {
            big.push((x * 16 + y) as uint8)
        }
    }
    let ramp2 = test_img(16, 8, Layout.Gray, big)
    let plain = quantize(ramp2, 2, false)
    let dithered = quantize(ramp2, 2)
    assert(plain.palette == dithered.palette && plain.indices != dithered.indices)
    let mean = (img: Image8) => img.data.fold(0, (s: int, v: uint8) => s + (v as int)) / img.data.len()
    let want = mean(ramp2.convert(Layout.Rgb))
    let got = mean(dithered.to_image())
    assert(got - want < 3 && want - got < 3)
    // a palette index past the palette is transparent
    let bad = Indexed { width: 2, height: 1, palette: [rgb(1u8, 2u8, 3u8)], indices: [0u8, 7u8] }
    assert(bad.to_image().data == [1u8, 2u8, 3u8, 255u8, 0u8, 0u8, 0u8, 0u8])
}

#test
fun terminal_preview() {
    let e = "\u{1b}["
    let img = test_img(2, 2, Layout.Rgb, [255u8, 0u8, 0u8, 0u8, 255u8, 0u8, 0u8, 0u8, 255u8, 255u8, 255u8, 255u8])
    let want = f"{e}38;2;255;0;0m{e}48;2;0;0;255m▀{e}38;2;0;255;0m{e}48;2;255;255;255m▀{e}0m\n"
    assert(ansi(img, 2) == want)
    // scaled to one column, one row: the average of all four, on the
    // terminal's own background
    assert(ansi(img, 1) == f"{e}38;2;128;128;128m▀{e}0m\n")
    // transparent pixels leave the background alone
    let t = test_img(2, 1, Layout.GrayAlpha, [255u8, 255u8, 0u8, 0u8])
    assert(ansi(t, 5) == f"{e}38;2;255;255;255m▀ {e}0m\n")
    let below = test_img(1, 2, Layout.GrayAlpha, [0u8, 0u8, 9u8, 255u8])
    assert(ansi(below, 1) == f"{e}38;2;9;9;9m▄{e}0m\n")
    let empty: Image8 = new(0, 0, Layout.Rgb, 0u8)
    assert(ansi(empty, 10) == "")
}
