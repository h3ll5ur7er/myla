// std.num — numbers from text (MYLA-79).
//
// `parse_int` and `parse_float` read decimal numbers such as `-42` and
// `1.5e-3`. A float is the correctly rounded double, computed in integers,
// so the result is the same in every implementation; the self-hosted
// compiler converts its float literals with the same code
// (`f64_literal_bits`, `f32_round_bits`), so it needs no float arithmetic
// (MYLA-29). Up to 19 significant digits with a 128-bit approximation of
// the power of ten (Eisel–Lemire), and in big integers only where that
// can't decide the rounding (MYLA-843).
//
// A big integer is a list of 32-bit limbs held in uint64, least significant
// first, with no high zero limbs (zero is the empty list).

const LIMB: uint64 = 4294967296
const F64_INF: uint64 = 9218868437227405312     // 0x7ff0000000000000

fun big_norm(a: [uint64]) -> [uint64] {
    var r = a
    while r.len() > 0 && r[r.len() - 1] == 0 {
        r.pop()
    }
    return r
}

fun big_from_u64(x: uint64) -> [uint64] {
    return big_norm([x % LIMB, x / LIMB])
}

// a * m + add, for m, add < 2^32
fun big_mul_add(a: [uint64], m: uint64, add: uint64) -> [uint64] {
    var out: [uint64] = []
    var carry = add
    for limb in a {
        let t = limb * m + carry
        out.push(t % LIMB)
        carry = t / LIMB
    }
    if carry > 0 {
        out.push(carry)
    }
    return big_norm(out)
}

// the bits of `x` up to its highest set one (0 for 0), halving the range
#test(0u64)[0]
#test(1u64)[1]
#test(4294967296u64)[33]
#test(18446744073709551615u64)[64]
fun u64_bitlen(x: uint64) -> int32 {
    if x == 0 {
        return 0
    }
    var n = 1
    var v = x
    if v >> 32 != 0 {
        n += 32
        v = v >> 32
    }
    if v >> 16 != 0 {
        n += 16
        v = v >> 16
    }
    if v >> 8 != 0 {
        n += 8
        v = v >> 8
    }
    if v >> 4 != 0 {
        n += 4
        v = v >> 4
    }
    if v >> 2 != 0 {
        n += 2
        v = v >> 2
    }
    if v >> 1 != 0 {
        n += 1
    }
    return n
}

fun big_bitlen(a: [uint64]) -> int32 {
    if a.len() == 0 {
        return 0
    }
    return (a.len() as int32 - 1) * 32 + u64_bitlen(a[a.len() - 1])
}

fun big_bit(a: [uint64], i: int32) -> bool {
    let limb = i / 32
    if limb >= a.len() as int32 {
        return false
    }
    return ((a[limb] >> ((i % 32) as uint64)) & 1) == 1
}

// whether any of the low `n` bits of `a` is set
fun big_low_bits_set(a: [uint64], n: int32) -> bool {
    var i = 0
    while i < n {
        if big_bit(a, i) {
            return true
        }
        i = i + 1
    }
    return false
}

fun big_shl(a: [uint64], s: int32) -> [uint64] {
    if a.len() == 0 {
        return a
    }
    var out: [uint64] = []
    var i = 0
    while i < s / 32 {
        out.push(0)
        i = i + 1
    }
    let bits = (s % 32) as uint64
    var carry: uint64 = 0
    for limb in a {
        let t = (limb << bits) | carry
        out.push(t % LIMB)
        carry = t / LIMB
    }
    if carry > 0 {
        out.push(carry)
    }
    return big_norm(out)
}

fun big_shr(a: [uint64], s: int32) -> [uint64] {
    let skip = s / 32
    let bits = (s % 32) as uint64
    var out: [uint64] = []
    var i = skip
    while i < a.len() as int32 {
        var t = a[i] >> bits
        if i + 1 < a.len() as int32 && bits > 0 {
            t = t | ((a[i + 1] << (32 - bits)) % LIMB)
        }
        out.push(t)
        i = i + 1
    }
    return big_norm(out)
}

fun big_cmp(a: [uint64], b: [uint64]) -> int32 {
    if a.len() != b.len() {
        return match a.len() < b.len() { true => -1, false => 1 }
    }
    var i = a.len() as int32 - 1
    while i >= 0 {
        if a[i] != b[i] {
            return match a[i] < b[i] { true => -1, false => 1 }
        }
        i = i - 1
    }
    return 0
}

// a - b, for a >= b
fun big_sub(a: [uint64], b: [uint64]) -> [uint64] {
    var out: [uint64] = []
    var borrow: uint64 = 0
    var i = 0
    while i < a.len() {
        var sub = borrow
        if i < b.len() {
            sub = sub + b[i]
        }
        if a[i] >= sub {
            out.push(a[i] - sub)
            borrow = 0
        } else {
            out.push(a[i] + LIMB - sub)
            borrow = 1
        }
        i = i + 1
    }
    return big_norm(out)
}

fun big_to_u64(a: [uint64]) -> uint64 {
    var r: uint64 = 0
    if a.len() > 0 {
        r = a[0]
    }
    if a.len() > 1 {
        r = r | (a[1] << 32)
    }
    return r
}

#derive(Eq)
struct DivMod { q: [uint64], r: [uint64] }

// schoolbook binary long division; the quotients here have about 64 bits,
// so the remainder starts as `n`'s bits above the quotient's, which are
// less than `d`, and a step is taken for each of the quotient's bits only,
// not each of `n`'s (MYLA-795: 300 kB of JSON numbers of 801 digits parsed
// in 695 ms, now 259 ms, 2026-11-18 at e659342)
#test([100u64], [7u64])[DivMod { q: [14u64], r: [2u64] }]
#test([5u64], [7u64])[DivMod { q: [], r: [5u64] }]
#test([0u64, 1u64], [3u64])[DivMod { q: [1431655765u64], r: [1u64] }]
fun big_divmod(n: [uint64], d: [uint64]) -> DivMod {
    var q: [uint64] = []
    var i = big_bitlen(n) - big_bitlen(d)
    if i < 0 {
        return DivMod { q: q, r: n }
    }
    var r = big_shr(n, i + 1)
    while i >= 0 {
        r = big_shl(r, 1)
        if big_bit(n, i) {
            r = big_mul_add(r, 1, 1)
        }
        q = big_shl(q, 1)
        if big_cmp(r, d) >= 0 {
            r = big_sub(r, d)
            q = big_mul_add(q, 1, 1)
        }
        i = i - 1
    }
    return DivMod { q: q, r: r }
}

// A rounded binary value: mant * 2^exp, or infinity.
#derive(Eq)
struct Rounded { mant: uint64, exp: int32, inf: bool }

// Round v * 2^e0 (plus a nonzero tail below it when `sticky`) to nearest, ties
// to even, keeping at most `prec` significant bits and no bit below 2^emin
// (which makes subnormals come out right); infinity above 2^(emax+1).
fun round_binary(v: [uint64], e0: int32, sticky: bool, prec: int32, emin: int32, emax: int32) -> Rounded {
    let bl = big_bitlen(v)
    if bl == 0 {
        return Rounded { mant: 0, exp: 0, inf: false }
    }
    var drop = bl - prec
    if emin - e0 > drop {
        drop = emin - e0
    }
    var mant: uint64 = 0
    var e = e0
    if drop <= 0 {
        mant = big_to_u64(v)     // exact; a sticky tail alone rounds down
    } else {
        mant = big_to_u64(big_shr(v, drop))
        let half = big_bit(v, drop - 1)
        let rest = sticky || big_low_bits_set(v, drop - 1)
        if half && (rest || (mant & 1) == 1) {
            mant = mant + 1
        }
        e = e0 + drop
        if mant == (1 as uint64) << (prec as uint64) {
            mant = mant >> 1
            e = e + 1
        }
    }
    if mant != 0 && u64_bitlen(mant) - 1 + e > emax {
        return Rounded { mant: 0, exp: 0, inf: true }
    }
    return Rounded { mant: mant, exp: e, inf: false }
}

// The double bits of the exact value mant * 2^e (representable as a double).
fun f64_bits_exact(r: Rounded) -> uint64 {
    if r.inf {
        return F64_INF
    }
    if r.mant == 0 {
        return 0
    }
    let bl = u64_bitlen(r.mant)
    let top = bl - 1 + r.exp
    if top >= -1022 {
        let m53 = r.mant << ((53 - bl) as uint64)
        return (((top + 1023) as uint64) << 52) | (m53 - ((1 as uint64) << 52))
    }
    return r.mant << ((r.exp + 1074) as uint64)    // subnormal
}

// The correctly rounded double of a float literal's lexeme, such as
// `3.25`, `1_000.5e-3`, `2f32` (underscores and the suffix are ignored).
#test("0.5")[4602678819172646912u64]
#test("0.1")[4591870180066957722u64]
#test("2f32")[4611686018427387904u64]
#test("1e400")[9218868437227405312u64]
#test("1 ")[panic("f64_literal_bits: '1 ' is not a float literal")]
#test("1_000.5e-3")[4607184670599831093u64]
#test("0.000_000_1e7")[4607182418800017408u64] // leading zeros aren't significant
#test("2.2250738585072011e-308")[4503599627370495u64] // the greatest subnormal
#test("123456789012345678901234567890")[5042042089369253694u64] // 30 digits
#test("1e-400")[0u64]
pub fun f64_literal_bits(lexeme: str) -> uint64 {
    var d = Significand { w: 0, kept: 0, shift: 0, dropped: false }
    var in_frac = false
    var exp = 0
    var exp_neg = false
    var in_exp = false
    var i = 0
    while i < lexeme.len() {
        let c = lexeme[i]
        if c == 'f' {
            break                // the suffix
        } else if c == '_' {
            i = i + 1
            continue
        } else if c == '.' {
            in_frac = true
        } else if c == 'e' || c == 'E' {
            in_exp = true
        } else if c == '-' {
            exp_neg = true
        } else if c == '+' {
            exp_neg = false
        } else if c < '0' || c > '9' {
            panic(f"f64_literal_bits: '{lexeme}' is not a float literal")
        } else if in_exp {
            if exp < 100000 {
                exp = exp * 10 + (c - '0') as int32
            }
        } else {
            d.take(c, in_frac)
        }
        i = i + 1
    }
    if exp_neg {
        exp = -exp
    }
    let bits = d.bits(exp)
    if bits != NO_BITS {
        return bits
    }
    return big_literal_bits(lexeme)
}

// The first 19 significant digits of a decimal, `w`, and the power of ten
// that scales them, `shift` (minus the digits after the point that `w`
// holds, plus those before it that it doesn't); `dropped` when a digit it
// doesn't hold isn't 0.
struct Significand { w: uint64, kept: int32, shift: int32, dropped: bool }

impl Significand {
    // The digit `c` added, after the point when `in_frac`.
    fun take(var self, c: uint8, in_frac: bool) {
        if self.kept < 19 {
            if self.kept > 0 || c != '0' {
                self.w = self.w * 10 + (c - '0') as uint64
                self.kept += 1
            }
            if in_frac {
                self.shift -= 1
            }
        } else {
            if c != '0' {
                self.dropped = true
            }
            if !in_frac {
                self.shift += 1
            }
        }
    }

    // The float64 bits of the decimal times 10^`exp`, or NO_BITS where
    // Eisel–Lemire can't decide them: with digits dropped, those of `w` and
    // of `w + 1`, the bounds of its value, must agree.
    fun bits(self, exp: int32) -> uint64 {
        if self.w == 0 {
            return 0
        }
        let q = exp + self.shift
        let bits = eisel_lemire(self.w, q)
        if self.dropped && bits != NO_BITS && eisel_lemire(self.w + 1, q) != bits {
            return NO_BITS
        }
        return bits
    }
}

// --- Eisel–Lemire (MYLA-843) ----------------------------------------------------

// Not a float64's bits that `eisel_lemire` gives (a NaN's): it couldn't
// decide them.
const NO_BITS: uint64 = 18446744073709551615

// The significands of the powers of ten from 10^-342 to 10^308, the 128 bits
// from the highest set one, truncated, in hex: 32 digits each, the high 64
// bits first. 10^q is POW10_SIG[q] * 2^(floor(q * log2(10)) - 127) and a
// part of 2^-128 of it more. Below 10^-342 a decimal of 19 digits is below
// half the least float64, from 10^309 on it is infinite. Computed by Python:
// for q >= 0, 10^q shifted to 128 bits (down: truncated), for q < 0,
// 2^k // 10^-q for a k that gives more than 128 bits, shifted down to 128;
