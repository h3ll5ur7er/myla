#test("(|a)b", "ab")["0-2 0-1"]
#test("(a|ab)(c|bcd)(d*)", "abcd")["0-4 0-1 1-4 4-4"]
#test("(a|ab)(bcd|c)(d*)", "abcd")["0-4 0-1 1-4 4-4"]
#test("()", "x")["0-0 0-0"]
#test("(()|a)+", "aa")["0-0 0-0 0-0"]
#test("(a*)*", "b")["0-0 0-0"]
#test("(a*)+", "b")["0-0 0-0"]
#test("(a*|b)*", "ab")["0-2 1-2"]
#test("(a+|b+)*", "aabb")["0-4 2-4"]
#test("(a|b)*c", "abbac")["0-5 3-4"]
#test("(ab|a)(bc|c)", "abc")["0-3 0-2 2-3"]
#test("((a)|b)+", "ab")["0-2 1-2 0-1"]
#test("((a)|b)+", "ba")["0-2 1-2 1-2"]
#test("a*", "baaa")["0-0"]
#test("a+", "baaa")["1-4"]
#test("a?", "baaa")["0-0"]
#test("ba?", "baaa")["0-2"]
#test("ba*", "baaa")["0-4"]
#test("a{2}", "aaaa")["0-2"]
#test("a{2,}", "aaaaa")["0-5"]
#test("a{2,3}", "aaaaa")["0-3"]
#test("a{0}", "aaa")["0-0"]
#test("a{0,1}", "aaa")["0-1"]
#test("(ab){2}", "abababab")["0-4 2-4"]
#test("(ab){1,2}c", "abababc")["2-7 4-6"]
#test("x(ab)?y", "xy xaby")["0-2 -"]
#test("(a){0}b", "ab")["1-2 -"]
#test("a{3,3}", "aa aaa")["3-6"]
#test("a{1,1000}", "aaaa")["0-4"]
#test("a*?", "aaa")["0-0"]
#test("a+?", "aaa")["0-1"]
#test("a??", "aaa")["0-0"]
#test("a{2,}?", "aaaa")["0-2"]
#test("a{2,4}?", "aaaa")["0-2"]
#test("a{2}?", "aaaa")["0-2"]
#test("<.+?>", "<a><b>")["0-3"]
#test("<.+>", "<a><b>")["0-6"]
#test("(a+?)(a*)", "aaa")["0-3 0-1 1-3"]
#test("(a*?)b", "aaab")["0-4 0-3"]
#test("(?U)a+", "aaa")["0-1"]
#test("(?U)a+?", "aaa")["0-3"]
#test("(.*?),(.*)", "a,b,c")["0-5 0-1 2-5"]
#test("a(b|bc)", "abc")["0-2 1-2"]
#test("a(bc|b)", "abc")["0-3 1-3"]
#test("(a+)(a+)", "aaaa")["0-4 0-3 3-4"]
#test("(a+?)(a+)", "aaaa")["0-4 0-1 1-4"]
#test("(a*)(a*)", "aa")["0-2 0-2 2-2"]
#test("(.*)c(.*)", "abcdcef")["0-7 0-4 5-7"]
#test("x*", "\n\nx")["0-0"]
#test("\\w+@\\w+\\.com", "mail bob@example.com now")["5-20"]
#test("\\w+@\\w+\\.com", "bob@example.org")["-"]
#test("\\xc3\\xa9", "café")["3-5"] // é is two bytes
#test("[\\x80-\\xff]+", "abécd")["2-4"]
#test("..", "é")["0-2"] // . is one byte
#test("a.b", "aéb")["-"]
#test("a..b", "aéb")["0-4"]
#test("é+", "éé")["0-4"] // a character in a pattern is one atom
#test("(?i)é", "É")["-"] // case folding is ASCII
#test("\\C", "\n")["0-1"]
#test("(?m)^\\w+$", "ab\ncd")["0-2"]
#test("\\bcd\\b", "ab cd")["3-5"]
fun spans(pattern: str, text: str) -> str {
    let re = match compile(pattern) {
        Ok(r) => r
        Err(e) => {
            return f"error: {e}"
        }
    }
    // the Pike VM alone, and the DFAs with it, must agree
    let n = 2 * re.names.len()
    var pike = re.searcher(text, n, -1)
    var dfa = re.searcher(text, n, 1)
    let found = pike.search(0)
    if dfa.search(0) != found || (found && shown_slots(dfa.slots) != shown_slots(pike.slots)) {
        return "the engines disagree: " + shown_slots(dfa.slots)
    }
    var pike0 = re.searcher(text, 0, -1)
    var dfa0 = re.searcher(text, 0, 1)
    if pike0.is_match() != found || dfa0.is_match() != found {
        return "is_match disagrees"
    }
    if !found {
        return "-"
    }
    return shown_slots(pike.slots)
}

// Slots as start-end pairs, `-` for a group that didn't take part.
#test([0, 2, -1, -1, 1, 2])["0-2 - 1-2"]
fun shown_slots(slots: [int]) -> str {
    var sb = StringBuilder()
    var i = 0
    while i + 1 < slots.len() {
        if i > 0 {
            sb.append(" ")
        }
        if slots[i] < 0 {
            sb.append("-")
        } else {
            sb.append(f"{slots[i]}-{slots[i + 1]}")
        }
        i += 2
    }
    return sb.build()
}

// Why `pattern` doesn't compile, or "ok".
#test("a(b")["missing closing ) at 1"]
#test("a(b(c)")["missing closing ) at 1"]
#test("a)")["unexpected ) at 1"]
#test(")")["unexpected ) at 0"]
#test("[a")["missing closing ] at 0"]
#test("[]")["missing closing ] at 0"]
#test("[^]")["missing closing ] at 0"]
#test("x[a-")["missing closing ] at 1"]
#test("a\\")["invalid escape sequence at 1"]
#test("\\q")["invalid escape sequence at 0"]
#test("\\1")["invalid escape sequence at 0"] // no backreferences
#test("(a)\\1")["invalid escape sequence at 3"]
#test("\\8")["invalid escape sequence at 0"]
#test("\\x4")["invalid escape sequence at 0"]
#test("\\x{100}")["invalid escape sequence at 0"] // above a byte
#test("\\777")["invalid escape sequence at 0"]
#test("\\pL")["invalid escape sequence at 0"] // no Unicode classes
#test("[\\b]")["invalid escape sequence at 1"]
#test("[z-a]")["invalid character class range at 1"]
#test("[a-\\d]")["invalid escape sequence at 3"]
#test("[[:foo:]]")["invalid POSIX character class at 1"]
#test("[é]")["non-ASCII character in a class at 1"]
#test("*")["missing argument to repetition operator at 0"]
#test("a|*")["missing argument to repetition operator at 2"]
#test("(*)")["missing argument to repetition operator at 1"]
#test("(?i)*")["missing argument to repetition operator at 4"]
#test("{2}")["missing argument to repetition operator at 0"]
#test("a**")["invalid nested repetition operator at 2"]
#test("a*+")["invalid nested repetition operator at 2"]
#test("a*??")["invalid nested repetition operator at 3"]
#test("x{2}{3}")["invalid nested repetition operator at 4"]
#test("a{1001}")["invalid repeat count at 1"]
#test("a{2,1}")["invalid repeat count at 1"]
#test("a{0,1001}")["invalid repeat count at 1"]
#test("(?=a)")["invalid or unsupported group syntax at 0"] // no lookaround
#test("(?!a)")["invalid or unsupported group syntax at 0"]
#test("(?<=a)")["invalid or unsupported group syntax at 0"]
#test("(?P=n)")["invalid or unsupported group syntax at 0"]
#test("(?P<>a)")["invalid group name at 4"]
#test("(?P<a-b>a)")["invalid group name at 4"]
#test("(?P<n>a)(?P<n>b)")["duplicate group name at 12"]
#test("(?<n>a)(?<n>b)")["duplicate group name at 10"]
#test("(?x)")["invalid flags at 0"]
#test("(?i-)")["invalid flags at 0"]
#test("(?)")["invalid flags at 0"]
#test("(?--i)")["invalid flags at 0"]
#test("(?i")["missing closing ) at 0"]
#test(repeated("(", 101) + "a" + repeated(")", 101))["groups nested too deeply at 100"]
#test(repeated("(", 100) + "a" + repeated(")", 100))["ok"]
#test("((a{1000}){1000}){1000}")["expression too large at 0"]
#test("(?i:a)(?im-s:b)(?U)c")["ok"]
#test("a{,3}x{")["ok"] // a { that isn't a count is a literal
fun error_of(pattern: str) -> str {
    return match compile(pattern) {
        Ok(_) => "ok"
        Err(e) => f"{e}"
    }
}

// The matches of `pattern` in `text`, each start-end.
#test("a", "banana")["1-2 3-4 5-6"]
#test("a*", "baaac")["0-0 1-4 5-5"] // no empty match right after a match
#test("", "abc")["0-0 1-1 2-2 3-3"]
#test("", "é")["0-0 2-2"] // an empty match moves on by a character
#test("\\b", "ab cd")["0-0 2-2 3-3 5-5"]
#test("(?m)^", "a\nb\n")["0-0 2-2 4-4"]
#test("x*", "")["0-0"]
#test("\\d+", "no digits")[""]
#test("[[:alpha:]]+", "one, two, three")["0-3 5-8 10-15"]
fun all_spans(pattern: str, text: str) -> str {
    let re = match compile(pattern) {
        Ok(r) => r
        Err(e) => {
            return f"error: {e}"
        }
    }
    var parts: [str] = []
    for m in re.find_all(text) {
        parts.push(f"{m.start}-{m.end}")
    }
    var sb = StringBuilder()
    var i = 0
    while i < parts.len() {
        if i > 0 {
            sb.append(" ")
        }
        sb.append(parts[i])
        i += 1
    }
    let pike = re.all_slots(text, 2, -1, -1)
    let dfa = re.all_slots(text, 2, -1, 1)
    if pike.len() != dfa.len() {
        return "the engines disagree"
    }
    var k = 0
    while k < pike.len() {
        if shown_slots(pike[k]) != shown_slots(dfa[k]) {
            return "the engines disagree"
        }
        k += 1
    }
    return sb.build()
}

// `pattern`'s every match in `text` replaced by `with`; the first only if
// `all` is false.
#test("a", "banana", "o", true)["bonono"]
#test("a", "banana", "o", false)["bonana"]
#test("(\\w+)@(\\w+)", "bob@example", "$2 at $1", true)["example at bob"]
#test("(?P<y>\\d{4})-(?P<m>\\d\\d)", "2026-11", "${m}/${y}", true)["11/2026"]
#test("x*", "abc", "-", true)["-a-b-c-"]
#test("a|", "baaa", "-", true)["-b---"]
#test("b", "abc", "$$1", true)["a$1c"]
#test("(a)|b", "ab", "[$1]", true)["[a][]"] // a group that didn't take part is empty
#test("q", "abc", "x", true)["abc"]
fun replaced(pattern: str, text: str, with: str, all: bool) -> str {
    return match compile(pattern) {
        Ok(re) => if all { re.replace_all(text, with) } else { re.replace(text, with) }
        Err(e) => f"error: {e}"
    }
}

// The pieces of `text` between `pattern`'s matches, joined with `|`.
#test(",", "a,b,,c")["a|b||c"]
#test("\\s*,\\s*", "a , b,c")["a|b|c"]
#test(",", ",a,")["|a|"]
#test(",", "")[""]
#test("x*", "abc")["|a|b|c|"]
#test("\\d", "a1b2c3")["a|b|c|"]
fun split_joined(pattern: str, text: str) -> str {
    let re = match compile(pattern) {
        Ok(r) => r
        Err(e) => {
            return f"error: {e}"
        }
    }
    let pieces = re.split(text)
    var sb = StringBuilder()
    var i = 0
    while i < pieces.len() {
        if i > 0 {
            sb.append("|")
        }
        sb.append(pieces[i])
        i += 1
    }
    return sb.build()
}

// Whether `pattern` matches somewhere in `text`.
#test("b+", "abbc")[true]
#test("^b", "abbc")[false]
#test("(a*)*b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")[false]
#test("", "")[true]
fun matches(pattern: str, text: str) -> bool {
    return match compile(pattern) {
        Ok(re) => re.is_match(text)
        Err(_) => false
    }
}

// The test functions' assertion (an f-string in `assert` doesn't compile
// natively yet).
fun holds(ok: bool, what: str) {
    if !ok {
        panic(what)
    }
}

fun compiled(pattern: str) -> Regex {
    return match compile(pattern) {
        Ok(re) => re
        Err(e) => {
            panic(f"{pattern}: {e}")
        }
    }
}

#test
fun finds_and_captures() {
    let re = compiled("(?P<user>[\\w.]+)@(?P<host>\\w+)\\.com")
    holds(re.group_count() == 2, "two groups")
    holds(re.as_str() == "(?P<user>[\\w.]+)@(?P<host>\\w+)\\.com", "as_str")
    match re.find("write to ann.lee@example.com today") {
        Some(m) => holds(m.start == 9 && m.end == 28 && m.text == "ann.lee@example.com", f"find: {m.start}-{m.end}")
        None => panic("no match")
    }
    match re.captures("write to ann.lee@example.com today") {
        Some(c) => {
            holds(c.len() == 3, "three groups with the whole match")
            holds(c.text(1) == "ann.lee" && c.text(2) == "example", "group texts")
            match c.name("host") {
                Some(m) => holds(m.start == 17 && m.end == 24 && m.text == "example", "host")
                None => panic("no host")
            }
            match c.name("nobody") {
                Some(_) => panic("a group that doesn't exist")
                None => {}
            }
            match c.get(3) {
                Some(_) => panic("group 3")
                None => {}
            }
        }
        None => panic("no captures")
    }
    match re.find("nothing here") {
        Some(_) => panic("a match in nothing")
        None => {}
    }
    match re.find_at("a@b.com c@d.com", 1) {
        Some(m) => holds(m.start == 8 && m.text == "c@d.com", "find_at")
        None => panic("find_at found nothing")
    }
    let all = re.captures_all("a@b.com, c@d.com")
    holds(all.len() == 2 && all[1].text(1) == "c" && all[1].text(2) == "d", "captures_all")
}

#test
fun finds_all_with_text() {
    let ms = compiled("\\d+").find_all("1 22 333")
    holds(ms.len() == 3, "three numbers")
    holds(ms[2] == Match { start: 5, end: 8, text: "333" }, "the third")
    // `.` matches a byte, so a match can end inside a character
    let half = compiled("a.").find_all("aé")
    holds(half.len() == 1 && half[0].end == 2 && half[0].text.len() == 2, "a match inside a character")
}

#test
fun escapes_round_trip() {
    let text = "1+1=2? (a|b) [x] {y} ^$ \\."
    let re = compiled(escape(text))
    match re.find("so " + text + " so") {
        Some(m) => holds(m.start == 3 && m.text == text, "an escaped pattern matches its text")
        None => panic("no match of the escaped text")
    }
}

// A backtracking matcher takes exponential time on these; a Pike VM visits
// each position once.
#test
fun pathological_patterns_are_linear() {
    let aaa = repeated("a", 10000)
    holds(!compiled("(a*)*b").is_match(aaa), "(a*)*b")
    holds(!compiled("(a|a)*b").is_match(aaa), "(a|a)*b")
    holds(!compiled("(a|aa)*b").is_match(aaa), "(a|aa)*b")
    match compiled("(a*)*$").find(aaa) {
        Some(m) => holds(m.end == 10000, "(a*)*$ matches it all")
        None => panic("(a*)*$")
    }
    match compiled("(x+x+)+y").find(repeated("x", 5000)) {
        Some(_) => panic("(x+x+)+y")
        None => {}
    }
}

fun repeated(s: str, n: int) -> str {
    var sb = StringBuilder()
    var k = 0
    while k < n {
        sb.append(s)
        k += 1
    }
    return sb.build()
}

// Text of `n` bytes, `a` and `b` in a pseudo-random order.
fun ab_text(n: int) -> str {
    var sb = StringBuilder()
    var seed: uint32 = 7
    var k = 0
    while k < n {
        seed = seed.wrapping_mul(1103515245u32).wrapping_add(12345u32)
        sb.append_byte(if ((seed >> 16) & 1u32) == 1u32 { 'a' } else { 'b' })
        k += 1
    }
    return sb.build()
}

// A pattern whose DFA has more states than the cache takes: the search
// goes on in the Pike VM and finds what the Pike VM alone finds.
#test
fun dfa_gives_up_for_the_pike_vm() {
    let text = ab_text(3000)
    var sr = compiled("a[ab]{14}c").searcher(text, 0, 1)
    holds(!sr.is_match(), "no c")
    holds(!sr.use_dfa, "the DFA gave up")
    let re = compiled("a[ab]{14}b")
    let auto = re.all_slots(text, 2, -1, 1)
    let pike = re.all_slots(text, 2, -1, -1)
    holds(auto.len() == pike.len() && auto.len() > 100, f"{auto.len()} matches")
    var k = 0
    while k < pike.len() {
        holds(shown_slots(auto[k]) == shown_slots(pike[k]), f"match {k}")
        k += 1
    }
}
