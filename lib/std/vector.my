impl Vec2 {
    #test(Vec2 { x: 1.0, y: 2.0 }, Vec2 { x: 1.0, y: 1.0 })[3.0]
    fun dot(self, o: Vec2) -> float64 {
        return self.x * o.x + self.y * o.y
    }

    #test(vec2(1.0, 2.0))[5.0]
    fun length_squared(self) -> float64 {
        return self.dot(self)
