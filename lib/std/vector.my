// std.vector: vectors of float64 (D201, MYLA-587).
//
// GENERATED by scripts/gen_std_linalg.py, with its float32 twin
// std.vector32, from one template: edit the script, not this file.
//
// `Vec2`, `Vec3` and `Vec4` (fields `x`, `y`, `z`, `w`), made by `vec3(x, y, z)`,
// `splat3(s)` or `Vec3.zero()` / `Vec3.one()` (std.algebra's traits), and
// `Vector`, of any length, made by `vector([…])` or `zeros(n)`, whose
// operators check that the lengths agree. `+`, `-` and `*`, `/` between two
// vectors are by component, `v * s`, `s * v` and `v / s` scale, `-v` negates,
// `v[i]` reads a component and `v[i] = s` writes one (D200); `dot`, `cross`,
// `length`, `normalized` and the rest are methods. Vectors are `Eq`, `Hash`
// (map keys, D198), print as `(1, 2, 3)` and are JSON arrays, `[1.0, 2.0, 3.0]`,
// as glTF writes them (`Vector` too).

import std.float as fl
import std.json as json_m
from std.json import Json, JsonError
from std.algebra import Zero, One
from std.vector32 import Vec2 as Vec2F32, Vec3 as Vec3F32, Vec4 as Vec4F32, Vector as VectorF32

// `x` formatted by `spec`, a spec given at run time: a vector's or matrix's
// applies to each element (`f"{v:.2}"` is `(1.00, 2.50)`).
fun with_spec<T: Format>(x: T, spec: str) -> str {
    return x.format(spec)
}

#derive(Eq, Hash)
pub struct Vec2 {
    x: float64,
    y: float64,
}

// A Vec2 of its components.
#test(1.0, 2.0)[Vec2 { x: 1.0, y: 2.0 }]
pub fun vec2(x: float64, y: float64) -> Vec2 {
    return Vec2 { x: x, y: y }
}

// A Vec2 with every component `s`.
#test(2.0)[Vec2 { x: 2.0, y: 2.0 }]
pub fun splat2(s: float64) -> Vec2 {
    return Vec2 { x: s, y: s }
}

impl Zero for Vec2 {
    #test()[vec2(0.0, 0.0)]
    fun zero() -> Vec2 {
        return splat2(0.0)
    }
}

impl One for Vec2 {
    #test()[vec2(1.0, 1.0)]
    fun one() -> Vec2 {
        return splat2(1.0)
    }
}

// `(x, y)`, the spec applied to each component.
impl Format for Vec2 {
    #test(vec2(1.5, -2.0), "")["(1.5, -2)"]
    #test(vec2(1.5, -2.0), ".1")["(1.5, -2.0)"]
    fun format(self, spec: str) -> str {
        return "(" + with_spec(self.x, spec) + ", " + with_spec(self.y, spec) + ")"
    }
}

