#derive(Eq, Hash)
pub struct Vec3 {
    x: float64,
    y: float64,
    z: float64,
}

// A Vec3 of its components.
#test(1.0, 2.0, 3.0)[Vec3 { x: 1.0, y: 2.0, z: 3.0 }]
pub fun vec3(x: float64, y: float64, z: float64) -> Vec3 {
    return Vec3 { x: x, y: y, z: z }
}

// A Vec3 with every component `s`.
#test(2.0)[Vec3 { x: 2.0, y: 2.0, z: 2.0 }]
pub fun splat3(s: float64) -> Vec3 {
    return Vec3 { x: s, y: s, z: s }
}

impl Zero for Vec3 {
    #test()[vec3(0.0, 0.0, 0.0)]
    fun zero() -> Vec3 {
        return splat3(0.0)
    }
}

impl One for Vec3 {
    #test()[vec3(1.0, 1.0, 1.0)]
    fun one() -> Vec3 {
        return splat3(1.0)
    }
}

// `(x, y, z)`, the spec applied to each component.
impl Format for Vec3 {
    #test(vec3(1.5, -2.0, 0.125), "")["(1.5, -2, 0.125)"]
    #test(vec3(1.5, -2.0, 0.125), ".1")["(1.5, -2.0, 0.1)"]
    fun format(self, spec: str) -> str {
        return "(" + with_spec(self.x, spec) + ", " + with_spec(self.y, spec) + ", " + with_spec(self.z, spec) + ")"
    }
}

impl Add for Vec3 {
    #test(vec3(1.0, 2.0, 3.0), vec3(2.0, 4.0, 8.0))[vec3(3.0, 6.0, 11.0)]
    fun add(self, o: Vec3) -> Vec3 {
        return Vec3 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z }
    }
}

impl Sub for Vec3 {
    #test(vec3(1.0, 2.0, 3.0), vec3(2.0, 4.0, 8.0))[vec3(-1.0, -2.0, -5.0)]
    fun sub(self, o: Vec3) -> Vec3 {
        return Vec3 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z }
    }
}

impl Mul for Vec3 {
    #test(vec3(1.0, 2.0, 3.0), vec3(2.0, 4.0, 8.0))[vec3(2.0, 8.0, 24.0)]
    fun mul(self, o: Vec3) -> Vec3 {
        return Vec3 { x: self.x * o.x, y: self.y * o.y, z: self.z * o.z }
    }
}

impl Div for Vec3 {
    #test(vec3(1.0, 2.0, 3.0), vec3(2.0, 4.0, 8.0))[vec3(0.5, 0.5, 0.375)]
    fun div(self, o: Vec3) -> Vec3 {
        return Vec3 { x: self.x / o.x, y: self.y / o.y, z: self.z / o.z }
    }
}

impl Neg for Vec3 {
    #test(vec3(1.0, 2.0, 3.0))[vec3(-1.0, -2.0, -3.0)]
    fun neg(self) -> Vec3 {
        return Vec3 { x: -self.x, y: -self.y, z: -self.z }
    }
}

impl Mul<float64> for Vec3 {
    #test(Vec3 { x: 1.0, y: 2.0, z: 3.0 }, 2.0)[Vec3 { x: 2.0, y: 4.0, z: 6.0 }]
    fun mul(self, k: float64) -> Vec3 {
        return Vec3 { x: self.x * k, y: self.y * k, z: self.z * k }
    }
}

impl Div<float64> for Vec3 {
    #test(vec3(1.0, 2.0, 3.0), 2.0)[vec3(0.5, 1.0, 1.5)]
    fun div(self, k: float64) -> Vec3 {
