    // The length, also of a vector whose squares would over- or underflow
    // (MYLA-796): then of the vector scaled by its largest component.
    #test(vec2(3.0, 4.0))[5.0]
    #test(vec2(1.2448546706642979e181, 1.6598062275523972e181))[2.0747577844404965e181]
    #test(vec2(7.229759595308652e-181, 9.639679460411536e-181))[1.204959932551442e-180]
    #test(vec2(0.0, 0.0))[0.0]
    fun length(self) -> float64 {
        let l = self.dot(self).sqrt()
        if l > 1e-150 && l < 1e150 { return l }
        let m = self.abs().max_element()
        if m == 0.0 || !m.is_finite() { return l }
        let u = self / m
        return u.dot(u).sqrt() * m
    }

    // The vector of length 1 in its direction; a zero vector's components
    // are NaN (`try_normalized` says None there).
    #test(vec2(3.0, 4.0))[vec2(0.6, 0.8)]
    #test(vec2(1.2448546706642979e181, 1.6598062275523972e181))[vec2(0.6, 0.8)]
    #test(vec2(7.229759595308652e-181, 9.639679460411536e-181))[vec2(0.6, 0.8)]
    fun normalized(self) -> Vec2 {
        return self / self.length()
    }

    #test(vec2(3.0, 4.0))[Some(vec2(0.6, 0.8))]
    #test(vec2(0.0, 0.0))[None]
    fun try_normalized(self) -> Option<Vec2> {
        let l = self.length()
        if l == 0.0 || !l.is_finite() { return None }
        return Some(self / l)
    }

    #test(vec2(1.0, 1.0), vec2(4.0, 5.0))[5.0]
    fun distance(self, o: Vec2) -> float64 {
        return (self - o).length()
    }

    #test(vec2(1.0, 1.0), vec2(4.0, 5.0))[25.0]
    fun distance_squared(self, o: Vec2) -> float64 {
        return (self - o).length_squared()
    }

    // The point `t` of the way from `self` to `o`.
    #test(vec2(0.0, 0.0), vec2(4.0, 8.0), 0.25)[vec2(1.0, 2.0)]
    fun lerp(self, o: Vec2, t: float64) -> Vec2 {
        return self + (o - self) * t
    }

    // The smaller of each component.
    #test(vec2(1.0, 5.0), vec2(4.0, 2.0))[vec2(1.0, 2.0)]
    fun min(self, o: Vec2) -> Vec2 {
        return Vec2 { x: self.x.min(o.x), y: self.y.min(o.y) }
    }

    #test(vec2(1.0, 5.0), vec2(4.0, 2.0))[vec2(4.0, 5.0)]
    fun max(self, o: Vec2) -> Vec2 {
        return Vec2 { x: self.x.max(o.x), y: self.y.max(o.y) }
    }

    #test(vec2(-1.0, 2.0))[vec2(1.0, 2.0)]
    fun abs(self) -> Vec2 {
        return Vec2 { x: self.x.abs(), y: self.y.abs() }
    }

    #test(vec2(3.0, -1.0))[-1.0]
    fun min_element(self) -> float64 {
        return self.x.min(self.y)
    }

    #test(vec2(3.0, -1.0))[3.0]
    fun max_element(self) -> float64 {
        return self.x.max(self.y)
    }

    // `self` mirrored at the plane (line) of the unit normal `normal`.
    #test(vec2(1.0, -1.0), vec2(0.0, 1.0))[vec2(1.0, 1.0)]
    fun reflect(self, normal: Vec2) -> Vec2 {
        return self - normal * (2.0 * self.dot(normal))
    }

    // The part of `self` along `o`.
    #test(vec2(1.0, 2.0), vec2(2.0, 0.0))[vec2(1.0, 0.0)]
    fun project_onto(self, o: Vec2) -> Vec2 {
        return o * (self.dot(o) / o.dot(o))
