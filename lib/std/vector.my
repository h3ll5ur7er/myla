    // The angle between `self` and `o`, in radians, also of vectors whose
    // lengths' product would overflow.
    #test(vec2(1.0, 0.0), vec2(0.0, 3.0))[1.5707963267948966]
    #test(vec2(0.0, 1.0), vec2(0.0, -2.0))[3.141592653589793]
    fun angle_between(self, o: Vec2) -> float64 {
        let c = (self / self.length()).dot(o / o.length())
        return c.clamp(-1.0, 1.0).acos()
    }

    #test(vec2(1.0, 2.0))[[1.0, 2.0]]
    fun to_list(self) -> [float64] {
        return [self.x, self.y]
    }

    // The same vector in float32 (std.vector32).
    #test(vec2(1.5, -2.0))[Vec2F32 { x: 1.5, y: -2.0 }]
    fun to_f32(self) -> Vec2F32 {
