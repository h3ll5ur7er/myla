// A vector of any length, its components in a list. Its operators check
// that the lengths agree: `vector lengths differ: 2 and 3` otherwise.
#derive(Eq, Hash)
pub struct Vector {
    data: [float64],
}

pub fun vector(xs: [float64]) -> Vector {
    return Vector { data: xs }
}

// `n` zeros.
pub fun zeros(n: int) -> Vector {
    return filled(n, 0.0)
}

// `n` times `v`.
pub fun filled(n: int, v: float64) -> Vector {
    var d: [float64] = []
    var i = 0
    while i < n {
        d.push(v)
        i += 1
    }
    return Vector { data: d }
}

fun same_len(a: Vector, b: Vector) {
    if a.data.len() != b.data.len() { panic(f"vector lengths differ: {a.data.len()} and {b.data.len()}") }
}

// `a op b` by element, the lengths checked.
fun zip_with(a: Vector, b: Vector, f: (float64, float64) -> float64) -> Vector {
    same_len(a, b)
    var d: [float64] = []
    var i = 0
    while i < a.data.len() {
        d.push(f(a.data[i], b.data[i]))
        i += 1
    }
    return Vector { data: d }
}

impl Format for Vector {
    fun format(self, spec: str) -> str {
        var sb = StringBuilder()
        sb.append("[")
        var i = 0
        while i < self.data.len() {
            if i > 0 { sb.append(", ") }
            sb.append(f"{self.data[i]}")
            i += 1
        }
        sb.append("]")
        return sb.build()
    }
}

impl Add for Vector {
    fun add(self, o: Vector) -> Vector {
        return zip_with(self, o, (a: float64, b: float64) => a + b)
    }
}

impl Sub for Vector {
    fun sub(self, o: Vector) -> Vector {
        return zip_with(self, o, (a: float64, b: float64) => a - b)
    }
}

impl Mul for Vector {
    fun mul(self, o: Vector) -> Vector {
        return zip_with(self, o, (a: float64, b: float64) => a * b)
    }
}

impl Neg for Vector {
    fun neg(self) -> Vector {
        return self.map((a: float64) => -a)
    }
}

impl Mul<float64> for Vector {
    fun mul(self, k: float64) -> Vector {
        return self.map((a: float64) => a * k)
    }
}

impl Div<float64> for Vector {
    fun div(self, k: float64) -> Vector {
        return self.map((a: float64) => a / k)
    }
}

impl Mul<Vector, Vector> for float64 {
    fun mul(self, v: Vector) -> Vector {
        return v * self
    }
}

impl Index<int, float64> for Vector {
    fun index(self, i: int) -> float64 {
        return self.data[i]
    }
}

impl IndexSet<int, float64> for Vector {
    fun set_index(var self, i: int, v: float64) {
        self.data[i] = v
    }
}

impl Vector {
    fun len(self) -> int {
        return self.data.len()
    }

    #test(Vector { data: [1.0, 2.0, 3.0] }, Vector { data: [4.0, 5.0, 6.0] })[32.0]
    fun dot(self, o: Vector) -> float64 {
        same_len(self, o)
        var acc: float64 = 0.0
        var i = 0
        while i < self.data.len() {
            acc += self.data[i] * o.data[i]
            i += 1
        }
        return acc
    }

    fun length(self) -> float64 {
        return self.dot(self).sqrt()
    }

    fun normalized(self) -> Vector {
        return self / self.length()
    }

    fun distance(self, o: Vector) -> float64 {
        return (self - o).length()
    }

    #test(Vector { data: [1.0, 2.0] })[3.0]
    fun sum(self) -> float64 {
        var acc: float64 = 0.0
        for x in self.data { acc += x }
        return acc
    }

    fun map(self, f: (float64) -> float64) -> Vector {
        var d: [float64] = []
        for x in self.data { d.push(f(x)) }
        return Vector { data: d }
    }

    fun to_list(self) -> [float64] {
        return self.data
    }

    fun to_f32(self) -> VectorF32 {
        var d: [float32] = []
        for x in self.data { d.push(x as float32) }
        return VectorF32 { data: d }
    }
}
