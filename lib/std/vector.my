impl Index<int, float64> for Vec3 {
    #test(vec3(1.0, 2.0, 3.0), 2)[3.0]
    #test(vec3(1.0, 2.0, 3.0), 3)[panic("index 3 out of range for a Vec3")]
    fun index(self, i: int) -> float64 {
        if i == 0 { return self.x }
        if i == 1 { return self.y }
        if i == 2 { return self.z }
