impl IndexSet<int, float64> for Vec3 {
    fun set_index(var self, i: int, v: float64) {
        if i == 0 { self.x = v } else if i == 1 { self.y = v } else if i == 2 { self.z = v } else { panic(f"index {i} out of range for a Vec3") }
    }
