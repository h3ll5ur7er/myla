// std.platform — the platform layer under std.rt: Linux on aarch64
// (MYLA-163, D117). The module `std/platform.my` stands for on that target
// (the x86-64 one's functions, over aarch64's system calls: the generic
// table, with `openat`, `newfstatat`, `mkdirat`, `unlinkat`, `renameat2`,
// `pipe2`, `dup3`, `ppoll`, `epoll_pwait` and `clone` in place of the old
// calls x86-64 still has).
//
// Everything the runtime written in Myla needs from the operating system
// goes through this module: the heap's memory, files and directories, the
// standard streams, processes, the CPUs a program may use, parking and
// waking a worker, and ending the process. A port to another system
// (aarch64 Linux, macOS, Windows: MYLA-163 to MYLA-165) gives these
// functions again over its own interface; std.rt above them stays as it
// is. What the platform's assembly does instead (the program's start,
// starting threads, thread-local state, the jumps into frames, the
// stack-overflow handler) is the backend's, per target.
//
// Each function gives what the system gives: a result (0 or more), or a
// negative errno, which std.rt records for `std.io` (`EINTR`, `EAGAIN`
// below are the ones it retries on). Paths are Myla strings; addresses
// are `int64`. Not for programs (its primitives are the standard
// library's, D100).

// The target this module is the platform layer of, as `--target` names it:
// the target a program built with it runs on (aarch64 Linux). The toolchain's
// own build of it is its default target, the host's.
pub const TARGET: str = "aarch64-linux"

pub const EINTR: int64 = -4
pub const EAGAIN: int64 = -11
pub const EPIPE: int64 = -32
// Whether memory unmapped goes back to the system (munmap gives a mapping back).
pub const RETURNS_MEMORY: bool = true

const SYS_READ: int64 = 63
const SYS_WRITE: int64 = 64
const SYS_OPENAT: int64 = 56
const SYS_CLOSE: int64 = 57
const SYS_NEWFSTATAT: int64 = 79
const SYS_FSTAT: int64 = 80
const SYS_PPOLL: int64 = 73
const SYS_MMAP: int64 = 222
const SYS_MUNMAP: int64 = 215
const SYS_WRITEV: int64 = 66
const SYS_PIPE2: int64 = 59
const SYS_DUP3: int64 = 24
const SYS_CLONE: int64 = 220
const SYS_EXECVE: int64 = 221
const SYS_EXIT: int64 = 93
const SYS_WAIT4: int64 = 260
const SYS_GETCWD: int64 = 17
const SYS_RENAMEAT2: int64 = 276
const SYS_MKDIRAT: int64 = 34
const SYS_UNLINKAT: int64 = 35
const SYS_FUTEX: int64 = 98
const SYS_NANOSLEEP: int64 = 101
const SYS_CLOCK_GETTIME: int64 = 113
const SYS_EPOLL_PWAIT: int64 = 22
const SYS_EPOLL_CTL: int64 = 21
const SYS_EVENTFD2: int64 = 19
const SYS_EPOLL_CREATE1: int64 = 20
const SYS_SCHED_GETAFFINITY: int64 = 123
const SYS_GETDENTS64: int64 = 61
const SYS_EXIT_GROUP: int64 = 94
const SYS_CHDIR: int64 = 49
const SYS_MEMFD_CREATE: int64 = 279
const SYS_LSEEK: int64 = 62
const SYS_RT_SIGACTION: int64 = 134
const SYS_GETPID: int64 = 172
const SYS_KILL: int64 = 129
const SYS_PIDFD_OPEN: int64 = 434
const SYS_GETRANDOM: int64 = 278
const SYS_SOCKET: int64 = 198
const SYS_BIND: int64 = 200
const SYS_LISTEN: int64 = 201
const SYS_CONNECT: int64 = 203
const SYS_GETSOCKNAME: int64 = 204
const SYS_GETPEERNAME: int64 = 205
const SYS_SENDTO: int64 = 206
const SYS_RECVFROM: int64 = 207
const SYS_SETSOCKOPT: int64 = 208
const SYS_GETSOCKOPT: int64 = 209
const SYS_SHUTDOWN: int64 = 210
const SYS_SENDMSG: int64 = 211
const SYS_RECVMSG: int64 = 212
const SYS_ACCEPT4: int64 = 242
const SYS_IOCTL: int64 = 29
// where an `epoll_event`'s data begins (not packed on aarch64)
const EVENT_DATA: int64 = 8
const AT_FDCWD: int64 = -100
const FUTEX_WAIT_PRIVATE: int64 = 128
const FUTEX_WAKE_PRIVATE: int64 = 129
const LOW32: int64 = 4294967295i64

// --- files and directories -----------------------------------------------------

// `path` as the NUL-terminated copy the kernel reads, which the caller frees.
fun c_path(path: str) -> int64 {
    let p = __addr_of(path)
    let n = __load64(p)
    let buf = __alloc(n + 1)
    __copy_bytes(buf, p + 8, n)
    __store8(buf + n, 0u8)
    return buf
}

// A system call on one path and a number.
fun on_path(nr: int64, path: str, arg: int64) -> int64 {
    let p = c_path(path)
    let r = __syscall5(nr, AT_FDCWD, p, arg, 0, 0)
    __free(p)
    return r
}

// The file at `path` opened for reading: its descriptor.
pub fun open_read(path: str) -> int64 {
    return on_path(SYS_OPENAT, path, 0)
}

// The file at `path` opened for writing, created (permissions 0644) or
// emptied.
pub fun open_write(path: str) -> int64 {
    let p = c_path(path)
    let r = __syscall5(SYS_OPENAT, AT_FDCWD, p, 577, 420, 0)  // O_WRONLY | O_CREAT | O_TRUNC, 0644
    __free(p)
    return r
}

// The directory at `path` opened for listing (`dir_read`).
pub fun open_dir(path: str) -> int64 {
    return on_path(SYS_OPENAT, path, 540672)  // O_RDONLY | O_DIRECTORY (0x4000 here) | O_CLOEXEC
}

// Up to `n` bytes of `fd` read to `buf`: how many (0 at the end).
pub fun read(fd: int64, buf: int64, n: int64) -> int64 {
    return __syscall(SYS_READ, fd, buf, n)
}

// Up to `n` bytes at `buf` written to `fd`: how many.
pub fun write(fd: int64, buf: int64, n: int64) -> int64 {
    return __syscall(SYS_WRITE, fd, buf, n)
}

// The descriptor `fd` closed: 0, or minus the errno (EBADF, EIO, EINTR).
pub fun close(fd: int64) -> int64 {
    return __syscall(SYS_CLOSE, fd, 0, 0)
}

// The size of the open file `fd`, 0 when it reports none (/proc, a pipe).
pub fun file_size(fd: int64) -> int64 {
    let st = __alloc(144)
    __syscall(SYS_FSTAT, fd, st, 0)
    let size = __load64(st + 48)
    __free(st)
    return size
}

// The file at `path` opened with std.rt's portable `flags` (1 read, 2
// write, 4 create, 8 truncate, 16 append, 32 exclusive; at least one of
// the first two) and, for a file it creates, the permissions `mode` (less
// the umask): its descriptor, closed on exec (MYLA-336).
pub fun open_file(path: str, flags: int64, mode: int64) -> int64 {
    let p = c_path(path)
    let r = __syscall5(SYS_OPENAT, AT_FDCWD, p, linux_open_flags(flags), mode, 0)
    __free(p)
    return r
}

// The portable open flags as Linux's, the same on x86-64 and aarch64:
// O_RDONLY, O_WRONLY or O_RDWR, then O_CREAT, O_TRUNC, O_APPEND, O_EXCL,
// and O_CLOEXEC always.
#test(1)[524288]
#test(3)[524290]
#test(2 | 4 | 8)[524865]
#test(2 | 16 | 32)[525441]
pub fun linux_open_flags(flags: int64) -> int64 {
    var f: int64 = 524288          // O_CLOEXEC
    if (flags & 3) == 3 {
        f |= 2                     // O_RDWR
    } else if (flags & 2) != 0 {
        f |= 1                     // O_WRONLY
    }
    if (flags & 4) != 0 { f |= 64 }      // O_CREAT
    if (flags & 8) != 0 { f |= 512 }     // O_TRUNC
    if (flags & 16) != 0 { f |= 1024 }   // O_APPEND
    if (flags & 32) != 0 { f |= 128 }    // O_EXCL
    return f
}

// The cursor of `fd` moved to `offset` from the start (`whence` 0), the
// cursor (1) or the end (2): the new offset.
pub fun seek(fd: int64, offset: int64, whence: int64) -> int64 {
    return __syscall(SYS_LSEEK, fd, offset, whence)
}

// The size, the mode (type bits and permissions) and the modification
// time (nanoseconds since 1970) of the open file `fd`, as three words at
// `out`: 0, or minus the errno (aarch64's `struct stat`: the mode at 16).
pub fun fd_stat(fd: int64, out: int64) -> int64 {
    let st = __alloc(128)
    let r = __syscall(SYS_FSTAT, fd, st, 0)
    if r >= 0 {
        __store64(out, __load64(st + 48))
        __store64(out + 8, __load64(st + 16) & LOW32)
        __store64(out + 16, __load64(st + 88) * 1000000000 + __load64(st + 96))
    }
    __free(st)
    return r
}

// The size, the mode, the modification time, the device and the file's
// number on it of what `path` names, as five words at `out`, without
// opening it (MYLA-378): a symbolic link followed when `follow`, else
// described itself (newfstatat with AT_SYMLINK_NOFOLLOW). 0, or minus the
// errno.
pub fun path_stat(path: str, follow: bool, out: int64) -> int64 {
    let p = c_path(path)
    let st = __alloc(144)
    var flags: int64 = 256           // AT_SYMLINK_NOFOLLOW
    if follow {
        flags = 0
    }
    let r = __syscall5(SYS_NEWFSTATAT, AT_FDCWD, p, st, flags, 0)
    if r >= 0 {
        __store64(out, __load64(st + 48))
        __store64(out + 8, __load64(st + 16) & LOW32)
        __store64(out + 16, __load64(st + 88) * 1000000000 + __load64(st + 96))
        __store64(out + 24, __load64(st))
        __store64(out + 32, __load64(st + 8))
    }
    __free(st)
    __free(p)
    return r
}

// `n` bytes from the system's entropy at `buf` (getrandom(2), again after
// an interruption and for what a call left): 0, or minus the errno.
pub fun random_fill(buf: int64, n: int64) -> int64 {
    var done: int64 = 0
    while done < n {
        let r = __syscall(SYS_GETRANDOM, buf + done, n - done, 0)
        if r == EINTR {
            continue
        }
        if r < 0 {
            return r
        }
        done += r
    }
    return 0
}

// The mode of what `path` names (the type bits and permissions, symbolic
// links followed).
pub fun mode_of(path: str) -> int64 {
    let p = c_path(path)
    let buf = __alloc(144)
    var r = __syscall5(SYS_NEWFSTATAT, AT_FDCWD, p, buf, 0, 0)
    if r >= 0 {
        r = __load64(buf + 16) & LOW32  // (aarch64's st_mode)
    }
    __free(buf)
    __free(p)
    return r
}

// A directory with the permissions `mode` (less the umask).
pub fun make_dir(path: str, mode: int64) -> int64 {
    return on_path(SYS_MKDIRAT, path, mode)
}

// The file (or symbolic link) at `path` removed.
pub fun remove_file(path: str) -> int64 {
    return on_path(SYS_UNLINKAT, path, 0)
}

// The empty directory at `path` removed.
pub fun remove_dir(path: str) -> int64 {
    return on_path(SYS_UNLINKAT, path, 512)  // AT_REMOVEDIR
}

pub fun rename(from_path: str, to_path: str) -> int64 {
    let a = c_path(from_path)
    let b = c_path(to_path)
    let r = __syscall5(SYS_RENAMEAT2, AT_FDCWD, a, AT_FDCWD, b, 0)
    __free(b)
    __free(a)
    return r
}

// The working directory's path written to `buf` (room for `n` bytes): its
// length.
pub fun cwd(buf: int64, n: int64) -> int64 {
    let r = __syscall(SYS_GETCWD, buf, n, 0)
    if r < 0 {
        return r
    }
    return r - 1  // the kernel counts the NUL
}

// The next entries of the directory `fd` read to `buf` (room for `n`
// bytes), as records `dir_entry_name` and `dir_entry_size` read: how many
// bytes of them (0 at the end).
pub fun dir_read(fd: int64, buf: int64, n: int64) -> int64 {
    return __syscall(SYS_GETDENTS64, fd, buf, n)
}

// The NUL-terminated name in the directory record at `rec`.
pub fun dir_entry_name(rec: int64) -> int64 {
    return rec + 19
}

// The size of the directory record at `rec` (the next one follows it).
pub fun dir_entry_size(rec: int64) -> int64 {
    return __load64(rec + 16) & 65535i64
}

// --- the standard streams --------------------------------------------------------

// 1 when a read of `fd` won't block (input, its end, or an error), 0 when
// `timeout_ms` (negative: none) ran out.
pub fun poll_read(fd: int64, timeout_ms: int64) -> int64 {
    let pfd = __alloc(8)
    __store64(pfd, (fd & LOW32) | (1i64 << 32))  // POLLIN
    var r = ppoll(pfd, 1, timeout_ms)
    __free(pfd)
    if r > 0 {
        r = 1
    }
    return r
}

// 1 when `fd` has room for a write (or a write fails at once), 0 when
// `timeout_ms` (negative: none) ran out (MYLA-419).
pub fun poll_write(fd: int64, timeout_ms: int64) -> int64 {
    let pfd = __alloc(8)
    __store64(pfd, (fd & LOW32) | (4i64 << 32))  // POLLOUT
    var r = ppoll(pfd, 1, timeout_ms)
    __free(pfd)
    if r > 0 {
        r = 1
    }
    return r
}

// The `n` bytes at `p` written to `fd`, a write at a time, again after an
// interruption (EINTR) or, for a non-blocking descriptor that is full
// (EAGAIN), once it has room: the thread waits in a poll as a blocking
// write would, where it tried again at once and spun (MYLA-457); 0, or the
// first error (minus its errno).
pub fun write_all(fd: int64, p: int64, n: int64) -> int64 {
    var at = p
    var left = n
    while left > 0 {
        let r = __syscall(SYS_WRITE, fd, at, left)
        if r >= 0 {
            at += r
            left -= r
        } else if r == EAGAIN {
            let room = poll_write(fd, -1)
        } else if r != EINTR {
            return r
        }
    }
    return 0
}

// The `n` bytes at `p` and a newline on the standard output in one write,
// so the lines of tasks on other workers don't interleave; what a partial
// write left, written after it. 0, or the first error (minus its errno).
pub fun write_line(p: int64, n: int64) -> int64 {
    let nl = __addr_of("\n") + 8
    let iov = __alloc(32)
    __store64(iov, p)
    __store64(iov + 8, n)
    __store64(iov + 16, nl)
    __store64(iov + 24, 1)
    var r = __syscall(SYS_WRITEV, 1, iov, 2)
    while r == EINTR || r == EAGAIN {
        if r == EAGAIN {
            let room = poll_write(1, -1)
        }
        r = __syscall(SYS_WRITEV, 1, iov, 2)
    }
    __free(iov)
    if r < 0 {
        return r
    }
    if r < n {
        let e = write_all(1, p + r, n - r)
        if e < 0 {
            return e
        }
        return write_all(1, nl, 1)
    }
    if r == n {
        return write_all(1, nl, 1)
    }
    return 0
}

// A write to a closed pipe on the standard output or error ends the program
// quietly (D146), as the default SIGPIPE does, which the runtime ignores so
// that other writes report the error: the default restored and the signal
// raised; the exit code a shell would show, should it not end the process.
pub fun broken_pipe() {
    let act = __alloc(32)
    __store64(act, 0)
    __store64(act + 8, 0)
    __store64(act + 16, 0)
    __store64(act + 24, 0)
    __syscall5(SYS_RT_SIGACTION, 13, act, 0, 8, 0)
    __syscall(SYS_KILL, __syscall(SYS_GETPID, 0, 0, 0), 13, 0)
    __syscall(SYS_EXIT_GROUP, 141, 0, 0)
}

// `poll`'s `timeout_ms` (negative: none) through `ppoll`'s timespec.
fun ppoll(fds: int64, n: int64, timeout_ms: int64) -> int64 {
    if timeout_ms < 0 {
        return __syscall5(SYS_PPOLL, fds, n, 0, 0, 8)
    }
    let ts = __alloc(16)
    __store64(ts, timeout_ms / 1000)
    __store64(ts + 8, (timeout_ms % 1000) * 1000000)
    let r = __syscall5(SYS_PPOLL, fds, n, ts, 0, 8)
    __free(ts)
    return r
}

// --- processes ---------------------------------------------------------------

// Added to the errno `exec_child` reports when the directory can't be
// entered (std.process's `SpawnError.WorkingDir`).
const DIR_FAILED: int64 = 4096

// The child's side of `run`, between fork and exec: system calls on numbers
// the parent prepared (`spec`, `child_spec`), nothing allocated or released.
// Its stdin, stdout and stderr become the three descriptors at `fds` (-1:
// this process's stays), each of the others the parent made is closed on
// exec; its directory is the one given; each of the paths is tried in turn,
// as `execvp` tries PATH's (one not there or not a directory: the next; one
// that may not be run: remembered). When none could be run its errno goes
// back through `report` (closed on exec) and the child ends with 127; one
// the directory gave goes back as DIR_FAILED plus it.
fun exec_child(fds: int64, report: int64, spec: int64, argv: int64, scratch: int64) {
    var k: int64 = 0
    while k < 3 {
        let fd = __load64(fds + 8 * k)
        if fd == k {
            __syscall(SYS_FCNTL, fd, 2, 0)    // F_SETFD: kept open on exec
        } else if fd >= 0 {
            __syscall(SYS_DUP3, fd, k, 0)
        }
        k += 1
    }
    // SIGPIPE back to its default, which the runtime ignores (D146) and
    // an exec would keep: the child's `head` must stop as it would anywhere
    __store64(scratch, 0)
    __store64(scratch + 8, 0)
    __store64(scratch + 16, 0)
    __store64(scratch + 24, 0)
    __syscall5(SYS_RT_SIGACTION, 13, scratch, 0, 8, 0)
    var r: int64 = 0
    let dir = __load64(spec + 24)
    if dir != 0 {
        r = __syscall(SYS_CHDIR, dir, 0, 0)
        if r < 0 {
            // the directory's errno, told apart from the program's
            // (MYLA-419: a bad `cwd` read as "program not found")
            r = r - DIR_FAILED
        }
    }
    if r == 0 {
        r = -2                         // ENOENT: no path to try
        var denied = false
        let n = __load64(spec + 8)
        var k: int64 = 0
        while k < n {
            r = __syscall(SYS_EXECVE, __load64(__load64(spec) + k * 8), argv, __load64(spec + 16))
            if r == -13 {
                denied = true          // EACCES: kept unless one runs
            } else if r != -2 && r != -20 {
                break                  // not ENOENT or ENOTDIR: that one's error
            }
            k += 1
        }
        if denied && (r == -2 || r == -20) {
            r = -13
        }
    }
    __store64(scratch, -r)
    __syscall(SYS_WRITE, report >> 32, scratch, 4)
    __syscall(SYS_EXIT, 127, 0, 0)
}

// What `exec_child` needs besides the argument vector, made before the fork
// (D147): `[paths, n, envp, dir, input]`, the `n` paths to try as C strings,
// the environment (the one given as `NAME=value` entries, or this process's),
// the directory to change to (0: none) and the descriptor the child's stdin
// becomes (-1: none, the child reads this process's stdin): an anonymous
// file holding the input given when `how` starts with `t`, the descriptor
// `opts[2]` names when it starts with `d` (closed here once the child has
// it). `opts` as `std.rt.run_with` describes it, `how` as `stdio_mode`
// gives it. A negative errno when the input's file can't be made.
fun child_spec(paths: [str], opts: [str], how: str) -> int64 {
    let spec = __alloc(40)
    let n = paths.len() as int64
    let ps = __alloc(n * 8 + 8)
    var k: int64 = 0
    for p in paths {
        __store64(ps + k * 8, c_path(p))
        k += 1
    }
    __store64(spec, ps)
    __store64(spec + 8, n)
    var envp = __environ()
    if opts.len() > 3 && opts[3] != "" {
        // this process's environment ("keep") or none ("clear"), with the
        // changes after it applied in order
        var entries: [str] = []
        if opts[3] != "clear" {
            entries = environ_entries()
        }
        var i = 4
        while i < opts.len() {
            entries = env_change(entries, opts[i])
            i += 1
        }
        let m = entries.len() as int64
        envp = __alloc(m * 8 + 8)
        var j: int64 = 0
        for en in entries {
            __store64(envp + j * 8, c_path(en))
            j += 1
        }
        __store64(envp + m * 8, 0)
    }
    __store64(spec + 16, envp)
    var dir: int64 = 0
    if opts.len() > 0 && opts[0] != "" {
        dir = c_path(opts[0])
    }
    __store64(spec + 24, dir)
    var input: int64 = -1
    if how[0] == 't' && opts.len() > 2 {
        let name = c_path("stdin")
        input = __syscall(SYS_MEMFD_CREATE, name, 1, 0)   // MFD_CLOEXEC
        __free(name)
        if input >= 0 {
            let t = __addr_of(opts[2])
            let w = write_all(input, t + 8, __load64(t))
            __syscall(SYS_LSEEK, input, 0, 0)
            if w < 0 {
                __syscall(SYS_CLOSE, input, 0, 0)
                input = w
            }
        }
    } else if how[0] == 'd' && opts.len() > 2 {
        // one that isn't open is EBADF here: the child's dup2 would fail
        // unseen, leaving it this process's stdin
        input = descriptor_of(opts[2])
        if input < 0 || __syscall(SYS_FCNTL, input, 1, 0) < 0 {   // F_GETFD
            input = -9
        }
    }
    __store64(spec + 32, input)
    if input < -1 {
        free_spec(spec)
        return input
    }
    return spec
}

// How a child's standard streams are made, from `opts` (`std.rt.run_with`'s
// and `spawn_piped`'s): three letters, for stdin, stdout and stderr, each
// `p` (a pipe this process holds the other end of), `i` (this process's),
// `n` (nothing: /dev/null), and for stdin also `t` (the text `opts[2]`) or
// `d` (the descriptor `opts[2]` names, MYLA-378). `opts[1]` gives them;
// else "1" there is a text input, and the input is a pipe when `piped` and
// this process's otherwise, the output and the error pipes.
#test(["", "1", "x"], false)["tpp"]
#test(["", "", ""], false)["ipp"]
#test([], true)["ppp"]
#test(["", "din", "5"], true)["din"]
fun stdio_mode(opts: [str], piped: bool) -> str {
    if opts.len() > 1 && opts[1].len() == 3 {
        return opts[1]
    }
    if opts.len() > 2 && opts[1] == "1" {
        return "tpp"
    }
    if piped {
        return "ppp"
    }
    return "ipp"
}

// The descriptor the decimal `s` names (-1 for none).
#test("17")[17]
#test("")[-1]
#test("x")[-1]
fun descriptor_of(s: str) -> int64 {
    if s.len() == 0 || s.len() > 9 {
        return -1
    }
    var n: int64 = 0
    var i = 0
    while i < s.len() {
        let c = s[i]
        if c < 48u8 || c > 57u8 {
            return -1
        }
        n = n * 10 + (c - 48u8) as int64
        i += 1
    }
    return n
}

// The entries of the environment this process started with.
fun environ_entries() -> [str] {
    var out: [str] = []
    var entry = __environ()
    while __load64(entry) != 0 {
        let e = __load64(entry)
        var len: int64 = 0
        while __load8(e + len) != 0u8 {
            len += 1
        }
        let p = __alloc(len + 8)
        __store64(p, len)
        __copy_bytes(p + 8, e, len)
        out.push(__str_of(p))
        entry += 8
    }
    return out
}

// `entries` with `change` made: `NAME=value` sets NAME (in place of what it
// was), a bare `NAME` removes it.
#test(["A=1", "B=2"], "A=3")[["B=2", "A=3"]]
#test(["A=1", "B=2"], "B")[["A=1"]]
fun env_change(entries: [str], change: str) -> [str] {
    var n = 0
    while n < change.len() && change[n] != 61u8 {   // '='
        n += 1
    }
    var out: [str] = []
    for en in entries {
        let same = en.len() > n && en[n] == 61u8 && starts(en, change, n)
        if !same {
            out.push(en)
        }
    }
    if n < change.len() {
        out.push(change)
    }
    return out
}

// Whether the first `n` bytes of `a` and `b` are the same.
fun starts(a: str, b: str, n: int32) -> bool {
    var i = 0
    while i < n {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    return true
}

// What `child_spec` made, released (the parent's copy of the input closed).
fun free_spec(spec: int64) {
    let ps = __load64(spec)
    var k: int64 = 0
    while k < __load64(spec + 8) {
        __free(__load64(ps + k * 8))
        k += 1
    }
    __free(ps)
    let envp = __load64(spec + 16)
    if envp != __environ() {
        var i: int64 = 0
        while __load64(envp + i * 8) != 0 {
            __free(__load64(envp + i * 8))
            i += 1
        }
        __free(envp)
    }
    if __load64(spec + 24) != 0 {
        __free(__load64(spec + 24))
    }
    if __load64(spec + 32) >= 0 {
        __syscall(SYS_CLOSE, __load64(spec + 32), 0, 0)
    }
    __free(spec)
}

// A read of up to 4 KB of `fd` into `buf`: the bytes read, 0 for none yet
// (EINTR), -1 at the end of the file or on an error.
fun read_some(fd: int64, buf: int64) -> int64 {
    let got = __syscall(SYS_READ, fd, buf, 4096)
    if got == EINTR {
        return 0
    }
    if got <= 0 {
        return -1
    }
    return got
}

// `program` (its path, not searched for) run with the argument vector
// `argv` and the environment the process started with (fork and exec), its
// stdout and stderr read as they come (poll), and waited for. Gives what it
// wrote to stdout; `__set_run_stderr` and `__set_run_status` (its exit
// code, a signal that ended it with exit code -1, or the errno of a failed
// spawn) record the rest.
pub fun run(program: str, argv: [str]) -> [uint8] {
    return run_with([program], argv, [])
}

// `run` with the paths to try, in turn, and the options of
// `std.rt.run_with` (D147).
pub fun run_with(paths: [str], argv: [str], opts: [str]) -> [uint8] {
    var out: [uint8] = []
    var err: [uint8] = []
    let spec = child_spec(paths, opts, stdio_mode(opts, false))
    if spec < 0 {
        __set_run_status(0, 0, -spec)
        __set_run_stderr(err)
        return out
    }
    let n = argv.len() as int64
    let args = __alloc(n * 8 + 8)
    var k: int64 = 0
    for a in argv {
        __store64(args + k * 8, c_path(a))
        k += 1
    }
    __store64(args + n * 8, 0)
    // three pipes, a pair of int32 file descriptors each: read end low,
    // both closed on exec (the child's ends become its 1 and 2 first)
    let pipes = __alloc(24)
    let buf = __alloc(4096)
    var errno: int64 = 0
    var exit_code: int64 = 0
    var signal: int64 = 0
    var r = __syscall(SYS_PIPE2, pipes, 524288, 0)
    if r >= 0 {
        r = __syscall(SYS_PIPE2, pipes + 8, 524288, 0)
    }
    if r >= 0 {
        r = __syscall(SYS_PIPE2, pipes + 16, 524288, 0)  // O_CLOEXEC
    }
    var pid: int64 = -1
    if r >= 0 {
        pid = __syscall5(SYS_CLONE, 17, 0, 0, 0, 0)
        r = pid
    }
    if r < 0 {
        errno = -r
    } else {
        let out_pipe = __load64(pipes)
        let err_pipe = __load64(pipes + 8)
        let report = __load64(pipes + 16)
        if pid == 0 {
            let fds = buf + 1024
            __store64(fds, __load64(spec + 32))
            __store64(fds + 8, out_pipe >> 32)
            __store64(fds + 16, err_pipe >> 32)
            exec_child(fds, report, spec, args, buf)
        }
        __syscall(SYS_CLOSE, out_pipe >> 32, 0, 0)
        __syscall(SYS_CLOSE, err_pipe >> 32, 0, 0)
        __syscall(SYS_CLOSE, report >> 32, 0, 0)
        var out_fd = out_pipe & LOW32
        var err_fd = err_pipe & LOW32
        // the child's errno when the exec failed, nothing when it succeeded
        if __syscall(SYS_READ, report & LOW32, buf, 4) > 0 {
            errno = __load64(buf) & LOW32
            __syscall(SYS_CLOSE, out_fd, 0, 0)
            __syscall(SYS_CLOSE, err_fd, 0, 0)
            out_fd = -1
            err_fd = -1
        }
        __syscall(SYS_CLOSE, report & LOW32, 0, 0)
        // two pollfds {fd: int32, events: int16, revents: int16}, POLLIN
        let fds = __alloc(16)
        while out_fd >= 0 || err_fd >= 0 {
            __store64(fds, (out_fd & LOW32) | (1i64 << 32))
            __store64(fds + 8, (err_fd & LOW32) | (1i64 << 32))
            let ready = ppoll(fds, 2, -1)
            if ready == EINTR {
                continue
            }
            if ready < 0 {
                break
            }
            if out_fd >= 0 && (__load64(fds) >> 48) != 0 {
                let got = read_some(out_fd, buf)
                if got < 0 {
                    __syscall(SYS_CLOSE, out_fd, 0, 0)
                    out_fd = -1
                }
                var i: int64 = 0
                while i < got {
                    out.push(__load8(buf + i))
                    i += 1
                }
            }
            if err_fd >= 0 && (__load64(fds + 8) >> 48) != 0 {
                let got = read_some(err_fd, buf)
                if got < 0 {
                    __syscall(SYS_CLOSE, err_fd, 0, 0)
                    err_fd = -1
                }
                var i: int64 = 0
                while i < got {
                    err.push(__load8(buf + i))
                    i += 1
                }
            }
        }
        if out_fd >= 0 {
            __syscall(SYS_CLOSE, out_fd, 0, 0)
        }
        if err_fd >= 0 {
            __syscall(SYS_CLOSE, err_fd, 0, 0)
        }
        __free(fds)
        while __syscall5(SYS_WAIT4, pid, buf, 0, 0, 0) == EINTR {
        }
        if errno == 0 {
            let status = __load64(buf) & LOW32
            if (status & 127) != 0 {
                signal = status & 127
                exit_code = -1
            } else {
                exit_code = (status >> 8) & 255
            }
        }
    }
    __free(buf)
    __free(pipes)
    k = 0
    while k < n {
        __free(__load64(args + k * 8))
        k += 1
    }
    __free(args)
    free_spec(spec)
    __set_run_status(exit_code, signal, errno)
    __set_run_stderr(err)
    return out
}

// `program` started with the argument vector `argv` (fork and exec, as
// `run` does) and not waited for (D124, `std.process.run_async`): `[errno,
// pid, out, err, exited]`, `out` and `err` the read ends of its stdout's and
// stderr's pipes and `exited` a descriptor that becomes readable when it ends
// (a pidfd), or `[errno, 0, -1, -1, -1]` when it couldn't be started.
pub fun spawn(program: str, argv: [str]) -> [int] {
    return spawn_with([program], argv, [])
}

// `spawn` with the paths to try, in turn, and the options of
// `std.rt.run_with` (D147).
pub fun spawn_with(paths: [str], argv: [str], opts: [str]) -> [int] {
    let h = start_child(paths, argv, opts, stdio_mode(opts, false))
    return [h[0], h[1], h[3], h[4], h[5]]
}

// `spawn_with` with each standard stream as `opts[1]` says (`stdio_mode`:
// a pipe, this process's, nothing, a text, a descriptor; all three pipes
// unless it says otherwise, MYLA-336, MYLA-378): `[errno, pid, in, out,
// err, exited]`, `in` the write end of its stdin's pipe and `out` and `err`
// the read ends of its stdout's and stderr's (-1 for a stream that isn't a
// pipe), or `[errno, 0, -1, -1, -1, -1]`.
pub fun spawn_piped(paths: [str], argv: [str], opts: [str]) -> [int] {
    return start_child(paths, argv, opts, stdio_mode(opts, true))
}

// A child started as `spawn_piped` describes, its streams as `how` (three
// letters of `stdio_mode`) says.
fun start_child(paths: [str], argv: [str], opts: [str], how: str) -> [int] {
    let spec = child_spec(paths, opts, how)
    if spec < 0 {
        return [(-spec) as int, 0, -1, -1, -1, -1]
    }
    let n = argv.len() as int64
    let args = __alloc(n * 8 + 8)
    var k: int64 = 0
    for a in argv {
        __store64(args + k * 8, c_path(a))
        k += 1
    }
    __store64(args + n * 8, 0)
    // the report's pipe, then stdin's, stdout's and stderr's when each is
    // one: a pair of int32 file descriptors each, read end low, all closed
    // on exec (the child's ends become its 0 to 2 first)
    let pipes = __alloc(32)
    // a sigaction for exec_child, then what the child's 0 to 2 become
    let buf = __alloc(64)
    let fds = buf + 32
    __store64(fds, __load64(spec + 32))       // a text or a descriptor, or -1
    __store64(fds + 8, -1)
    __store64(fds + 16, -1)
    var ends: [int64] = [-1, -1, -1]           // this process's end of each pipe
    var errno: int64 = 0
    var pid: int64 = 0
    var exited: int64 = -1
    var null_fd: int64 = -1
    var r = __syscall(SYS_PIPE2, pipes, 524288, 0)   // O_CLOEXEC
    let reporting = r >= 0
    k = 0
    while r >= 0 && k < 3 {
        let c = how[k as int]
        if c == 'p' {
            r = __syscall(SYS_PIPE2, pipes + 8 + 8 * k, 524288, 0)
            if r >= 0 {
                let p = __load64(pipes + 8 + 8 * k)
                if k == 0 {
                    __store64(fds, p & LOW32)
                    ends[0] = p >> 32
                } else {
                    __store64(fds + 8 * k, p >> 32)
                    ends[k as int] = p & LOW32
                }
            }
        } else if c == 'n' {
            if null_fd < 0 {
                null_fd = open_file("/dev/null", 3, 0)
                r = null_fd
            }
            __store64(fds + 8 * k, null_fd)
        }
        k += 1
    }
    if r >= 0 {
        r = __syscall5(SYS_CLONE, 17, 0, 0, 0, 0)
        pid = r
    }
    if r < 0 {
        errno = -r
        pid = 0
    } else if pid == 0 {
        exec_child(fds, __load64(pipes), spec, args, buf)
    }
    // the child's ends closed here (a text or descriptor is free_spec's)
    let report = __load64(pipes)
    if reporting {
        __syscall(SYS_CLOSE, report >> 32, 0, 0)
    }
    k = 0
    while k < 3 {
        if ends[k as int] >= 0 {
            __syscall(SYS_CLOSE, __load64(fds + 8 * k), 0, 0)
        }
        k += 1
    }
    if null_fd >= 0 {
        __syscall(SYS_CLOSE, null_fd, 0, 0)
    }
    if errno == 0 && __syscall(SYS_READ, report & LOW32, buf, 4) > 0 {
        // the exec failed: its errno, the child reaped
        errno = __load64(buf) & LOW32
        while __syscall5(SYS_WAIT4, pid, buf, 0, 0, 0) == EINTR {
        }
        pid = 0
    }
    if reporting {
        __syscall(SYS_CLOSE, report & LOW32, 0, 0)
    }
    if errno != 0 {
        // nothing started: this process's ends too
        k = 0
        while k < 3 {
            if ends[k as int] >= 0 {
                __syscall(SYS_CLOSE, ends[k as int], 0, 0)
                ends[k as int] = -1
            }
            k += 1
        }
    }
    if pid != 0 {
        exited = __syscall(SYS_PIDFD_OPEN, pid, 0, 0)
    }
    __free(buf)
    __free(pipes)
    k = 0
    while k < n {
        __free(__load64(args + k * 8))
        k += 1
    }
    __free(args)
    free_spec(spec)
    return [errno as int, pid as int, ends[0] as int, ends[1] as int, ends[2] as int, exited as int]
}

// A wait status as `reap` gives it: the exit code (0 to 255), or minus the
// signal that ended the child.
#test(1792)[7]
#test(15)[-15]
fun exit_of(status: int64) -> int64 {
    if (status & 127) != 0 {
        return -(status & 127)
    }
    return (status >> 8) & 255
}

// The child `pid` (from `spawn`) waited for and reaped: its exit code (0 to
// 255), or minus the signal that ended it.
pub fun reap(pid: int64) -> int64 {
    let buf = __alloc(8)
    __store64(buf, 0)
    while __syscall5(SYS_WAIT4, pid, buf, 0, 0, 0) == EINTR {
    }
    let status = __load64(buf) & LOW32
    __free(buf)
    return exit_of(status)
}

// The child `pid` reaped if it has ended, not waited for (WNOHANG,
// MYLA-336): 0 while it runs, minus the errno, or 1 when it was reaped,
// with what `reap` would give as the word at `out`.
pub fun try_reap(pid: int64, out: int64) -> int64 {
    let buf = __alloc(8)
    __store64(buf, 0)
    var r = __syscall5(SYS_WAIT4, pid, buf, 1, 0, 0)
    while r == EINTR {
        r = __syscall5(SYS_WAIT4, pid, buf, 1, 0, 0)
    }
    if r > 0 {
        __store64(out, exit_of(__load64(buf) & LOW32))
        r = 1
    }
    __free(buf)
    return r
}

// The signal `sig` sent to the process `pid`: 0, or minus the errno.
pub fun kill(pid: int64, sig: int64) -> int64 {
    return __syscall(SYS_KILL, pid, sig, 0)
}

// --- sockets (MYLA-346) ----------------------------------------------------------
// What std.net needs, over the BSD socket calls. A socket is a handle (here
// a descriptor) that only these functions take: data is sent and received
// on it, not read or written, and it is closed with `sock_close`. An
// address crosses this layer as a portable record, never as a `sockaddr`:
// the family (4 or 6), the port (big-endian, 2 bytes), then the address's 4
// or 16 bytes, 7 or 19 bytes in all (`sockaddr_of`, `record_into`). Each
// function gives what the system gives: 0 or more, or minus a Linux errno.
// A port to another system gives these functions again over its own
// interface and maps its error codes onto the same numbers (Winsock's
// WSAECONNREFUSED onto ECONNREFUSED, WSAEWOULDBLOCK onto EAGAIN, or onto
// EINPROGRESS for a connect), so std.rt and std.net stay as they are.

// A new socket of the family `family` (4: IPv4, 6: IPv6) and the kind
// `kind` (1: a stream, TCP; 2: datagrams, UDP), blocking, closed on exec:
// its handle.
pub fun sock_open(family: int64, kind: int64) -> int64 {
    var af: int64 = 2               // AF_INET
    if family == 6 {
        af = 10                     // AF_INET6
    } else if family != 4 {
        return -97                  // EAFNOSUPPORT
    }
    if kind != 1 && kind != 2 {
        return -22
    }
    return __syscall(SYS_SOCKET, af, kind | 524288, 0)  // SOCK_STREAM or SOCK_DGRAM, SOCK_CLOEXEC
}

// The socket `h` in non-blocking mode (`on` 1) or blocking (0): in the
// first, an operation that would wait fails with EAGAIN instead, and a
// connect with EINPROGRESS. 0, or minus the errno.
pub fun sock_nonblocking(h: int64, on: int64) -> int64 {
    let v = __alloc(8)
    __store64(v, on)
    let r = __syscall(SYS_IOCTL, h, 21537, v)   // FIONBIO
    __free(v)
    return r
}

// The address record `rec` as a `sockaddr_in` or `sockaddr_in6` in a new
// block of 32 bytes, which the caller frees, its length stored at `len`;
// 0 for a record that is neither.
fun sockaddr_of(rec: str, len: int64) -> int64 {
    let p = __addr_of(rec)
    let n = __load64(p)
    let sa = __alloc(32)
    __store64(sa, 0)
    __store64(sa + 8, 0)
    __store64(sa + 16, 0)
    __store64(sa + 24, 0)
    if n == 7 && __load8(p + 8) == 4u8 {
        __store8(sa, 2u8)                       // AF_INET (little-endian)
        __store8(sa + 2, __load8(p + 9))        // the port, big-endian
        __store8(sa + 3, __load8(p + 10))
        __copy_bytes(sa + 4, p + 11, 4)
        __store64(len, 16)
        return sa
    }
    if n == 19 && __load8(p + 8) == 6u8 {
        __store8(sa, 10u8)                      // AF_INET6
        __store8(sa + 2, __load8(p + 9))
        __store8(sa + 3, __load8(p + 10))
        __copy_bytes(sa + 8, p + 11, 16)        // after the flow information
        __store64(len, 28)
        return sa
    }
    __free(sa)
    return 0
}

// The address record of the `sockaddr` at `sa` written at `at` (room for
// 19 bytes): its length, 7 or 19; 0 for another family.
fun record_into(sa: int64, at: int64) -> int64 {
    let fam = (__load8(sa) as int64) | ((__load8(sa + 1) as int64) << 8)
    var n: int64 = 0
    if fam == 2 {
        __store8(at, 4u8)
        __copy_bytes(at + 3, sa + 4, 4)
        n = 7
    } else if fam == 10 {
        __store8(at, 6u8)
        __copy_bytes(at + 3, sa + 8, 16)
        n = 19
    }
    if n > 0 {
        __store8(at + 1, __load8(sa + 2))
        __store8(at + 2, __load8(sa + 3))
    }
    return n
}

// A call on a socket and an address record: bind(2) or connect(2).
fun on_addr(nr: int64, h: int64, rec: str) -> int64 {
    let len = __alloc(8)
    let sa = sockaddr_of(rec, len)
    if sa == 0 {
        __free(len)
        return -22
    }
    let r = __syscall(nr, h, sa, __load64(len))
    __free(sa)
    __free(len)
    return r
}

// The socket `h` bound to the address record `rec` (port 0: one the
// system picks): 0, or minus the errno (EADDRINUSE, EADDRNOTAVAIL, …).
pub fun sock_bind(h: int64, rec: str) -> int64 {
    return on_addr(SYS_BIND, h, rec)
}

// The stream socket `h` listening, at most `backlog` connections queued.
pub fun sock_listen(h: int64, backlog: int64) -> int64 {
    return __syscall(SYS_LISTEN, h, backlog, 0)
}

// The next connection queued on the listening socket `h`: a new socket,
// blocking, closed on exec (EAGAIN when `h` is non-blocking and none is
// queued).
pub fun sock_accept(h: int64) -> int64 {
    return __syscall5(SYS_ACCEPT4, h, 0, 0, 524288, 0)   // SOCK_CLOEXEC
}

// The socket `h` connected to the address record `rec`: 0, or minus the
// errno; EINPROGRESS for a non-blocking socket whose connection goes on (it
// becomes writable once it is made or has failed: `sock_error` tells which).
pub fun sock_connect(h: int64, rec: str) -> int64 {
    return on_addr(SYS_CONNECT, h, rec)
}

// The error pending on the socket `h` (SO_ERROR), taken: 0 for none, else
// the errno, positive (a connect in progress that failed: ECONNREFUSED).
pub fun sock_error(h: int64) -> int64 {
    let v = __alloc(16)
    __store64(v, 0)
    __store64(v + 8, 4)
    let r = __syscall5(SYS_GETSOCKOPT, h, 1, 4, v, v + 8)  // SOL_SOCKET, SO_ERROR
    let e = __load64(v) & LOW32
    __free(v)
    if r < 0 {
        return r
    }
    return e
}

// Up to `n` bytes at `p` sent on the connected socket `h`: how many. A peer
// that went away is EPIPE (no signal) or ECONNRESET.
pub fun sock_send(h: int64, p: int64, n: int64) -> int64 {
    return __syscall5(SYS_SENDTO, h, p, n, 16384, 0)   // MSG_NOSIGNAL, no address
}

// Up to `n` bytes received on the connected socket `h` at `p`: how many,
// 0 when the peer ended the stream.
pub fun sock_recv(h: int64, p: int64, n: int64) -> int64 {
    return __syscall5(SYS_RECVFROM, h, p, n, 0, 0)     // no address
}

// A message header (`struct msghdr`, 56 bytes) for the address at `sa` and
// one buffer, its iovec after it.
fun msg_header(sa: int64, salen: int64, p: int64, n: int64) -> int64 {
    let m = __alloc(72)
    __store64(m, sa)
    __store64(m + 8, salen)
    __store64(m + 16, m + 56)
    __store64(m + 24, 1)
    __store64(m + 32, 0)
    __store64(m + 40, 0)
    __store64(m + 48, 0)
    __store64(m + 56, p)
    __store64(m + 64, n)
    return m
}

// The `n` bytes at `p` sent as one datagram on the socket `h` to the
// address record `rec` (sendmsg(2)): how many.
pub fun sock_send_to(h: int64, p: int64, n: int64, rec: str) -> int64 {
    let len = __alloc(8)
    let sa = sockaddr_of(rec, len)
    if sa == 0 {
        __free(len)
        return -22
    }
    let m = msg_header(sa, __load64(len), p, n)
    let r = __syscall(SYS_SENDMSG, h, m, 16384)       // MSG_NOSIGNAL
    __free(m)
    __free(sa)
    __free(len)
    return r
}

// The next datagram on the socket `h`: its first `n` bytes at `p` (the rest
// of a longer one dropped), its sender's address record at `sender` (room
// for 19 bytes), by recvmsg(2): how many bytes.
pub fun sock_recv_from(h: int64, p: int64, n: int64, sender: int64) -> int64 {
    let sa = __alloc(32)
    __store64(sa, 0)
    let m = msg_header(sa, 28, p, n)
    let r = __syscall(SYS_RECVMSG, h, m, 0)
    if r >= 0 {
        let k = record_into(sa, sender)
    }
    __free(m)
    __free(sa)
    return r
}

// The address record of the socket `h`'s own end (`peer` 0, getsockname(2))
// or of its peer (1, getpeername(2)) written at `at` (room for 19 bytes):
// its length, or minus the errno (ENOTCONN: no peer).
pub fun sock_addr(h: int64, peer: int64, at: int64) -> int64 {
    let sa = __alloc(48)
    __store64(sa, 0)
    __store64(sa + 32, 28)
    var nr = SYS_GETSOCKNAME
    if peer != 0 {
        nr = SYS_GETPEERNAME
    }
    var r = __syscall(nr, h, sa, sa + 32)
    if r >= 0 {
        r = record_into(sa, at)
    }
    __free(sa)
    return r
}

// The socket `h`'s receiving (`how` 1), sending (2) or both (3) ended.
pub fun sock_shutdown(h: int64, how: int64) -> int64 {
    if how < 1 || how > 3 {
        return -22
    }
    return __syscall(SYS_SHUTDOWN, h, how - 1, 0)     // SHUT_RD, SHUT_WR, SHUT_RDWR
}

// The option `opt` of the socket `h` set to `value` (0 off, 1 on): 1 no
// delay (TCP_NODELAY), 2 broadcast (SO_BROADCAST), 3 a listener's address
// reused while old connections to it linger (SO_REUSEADDR; Windows allows
// that anyway and its SO_REUSEADDR means more, so a port there does
// nothing for it).
pub fun sock_option(h: int64, opt: int64, value: int64) -> int64 {
    var level: int64 = 1          // SOL_SOCKET
    var name: int64 = 0
    if opt == 1 {
        level = 6                 // IPPROTO_TCP
        name = 1                  // TCP_NODELAY
    } else if opt == 2 {
        name = 6                  // SO_BROADCAST
    } else if opt == 3 {
        name = 2                  // SO_REUSEADDR
    } else {
        return -22
    }
    let v = __alloc(8)
    __store64(v, value)
    let r = __syscall5(SYS_SETSOCKOPT, h, level, name, v, 4)
    __free(v)
    return r
}

// Whether the socket `h` is ready for what `events` asks (1: to receive or
// accept, 2: to send, or a connect's end), waiting at most `timeout_ms`
// milliseconds (negative: no limit): the events ready, an error or a
// hang-up counting as both (the operation then reports it); 0 when the time
// ran out.
pub fun sock_poll(h: int64, events: int64, timeout_ms: int64) -> int64 {
    var want: int64 = 0
    if (events & 1) != 0 { want |= 1 }     // POLLIN
    if (events & 2) != 0 { want |= 4 }     // POLLOUT
    let pfd = __alloc(8)
    __store64(pfd, (h & LOW32) | (want << 32))
    let r = ppoll(pfd, 1, timeout_ms)
    let got = (__load64(pfd) >> 48) & 65535
    __free(pfd)
    if r <= 0 {
        return r
    }
    return ready_events(got, events)
}

// The portable readiness of poll(2)'s `revents` for the `events` asked.
#test(1i64, 3i64)[1]
#test(4i64, 3i64)[2]
#test(8i64, 1i64)[1]
#test(16i64, 3i64)[3]
#test(32i64, 2i64)[2]
fun ready_events(got: int64, events: int64) -> int64 {
    var out: int64 = 0
    if (got & 1) != 0 { out |= 1 }         // POLLIN
    if (got & 4) != 0 { out |= 2 }         // POLLOUT
    if (got & 56) != 0 { out |= 3 }        // POLLERR, POLLHUP, POLLNVAL
    return out & events
}

// The socket `h` closed.
pub fun sock_close(h: int64) -> int64 {
    return __syscall(SYS_CLOSE, h, 0, 0)
}

// What std.net reads of the system's configuration: `which` 0, the path of
// the hosts file; 1, the resolver's configuration as resolv.conf(5) text
// (its `nameserver` lines matter); "" for none. A port gives the same from
// its own places: Windows keeps the hosts file in
// `%SystemRoot%\System32\drivers\etc` and its name servers in the registry
// (GetNetworkParams).
pub fun net_config(which: int64) -> str {
    if which == 0 {
        return "/etc/hosts"
    }
    if which == 1 {
        return small_file("/etc/resolv.conf")
    }
    return ""
}

// The first 64 KiB of the file at `path`, "" when it can't be read.
fun small_file(path: str) -> str {
    let fd = open_read(path)
    let cell = __alloc(8 + 65536)
    var got: int64 = 0
    while fd >= 0 && got < 65536 {
        let r = __syscall(SYS_READ, fd, cell + 8 + got, 65536 - got)
        if r == EINTR {
            continue
        }
        if r <= 0 {
            break
        }
        got += r
    }
    if fd >= 0 {
        __syscall(SYS_CLOSE, fd, 0, 0)
    }
    __store64(cell, got)
    return __str_of(cell)
}

// --- the terminal and signals (MYLA-350) ---------------------------------------------
// What std.term and std.signal rest on, through std.rt's `__term_*` and
// `__signal_*` primitives. A terminal is a descriptor's: ioctl on the
// kernel's `struct termios` (36 bytes: the input, output, control and local
// flags, the line discipline, 19 control characters) and on its window
// size. A terminal's saved mode is a block of bytes std.term never looks
// into, which a port fills with its own (Windows: the console's modes).
// Signals come through a self-pipe: the runtime's `__on_signal` (the
// backend's assembly) writes each caught signal's number as a byte to the
// pipe whose write end is the first word of `__sig_pipe`, and the reactor
// waits for the read end as it waits for input. `__sig_pipe`'s words: the
// write end, the read end plus one (0 before the first listener), how many
// listen, a lock, and what SIGINT and SIGTERM did before the first listener
// (their handlers: 0 the default, 1 ignored).

const TCGETS: int64 = 21505
const TCSETS: int64 = 21506
const TIOCGWINSZ: int64 = 21523
const TERMIOS_SIZE: int64 = 36
const SIGINT: int64 = 2
const SIGTERM: int64 = 15
const O_NONBLOCK: int64 = 2048
const F_SETFL: int64 = 4
const SYS_FCNTL: int64 = 25

// Whether the descriptor `fd` is a terminal: 1 or 0.
pub fun term_is_tty(fd: int64) -> int64 {
    let t = __alloc(64)
    let r = __syscall(SYS_IOCTL, fd, TCGETS, t)
    __free(t)
    if r < 0 {
        return 0
    }
    return 1
}

// The size of the terminal `fd`: its columns from bit 16 up, its rows in
// the low 16 bits (TIOCGWINSZ's `ws_col` and `ws_row`), or minus the errno
// (ENOTTY for a descriptor that isn't one). A port reads its console's
// window (Windows: GetConsoleScreenBufferInfo's `srWindow`).
pub fun term_size(fd: int64) -> int64 {
    let w = __alloc(16)
    var r = __syscall(SYS_IOCTL, fd, TIOCGWINSZ, w)
    if r >= 0 {
        let rows = (__load8(w) as int64) | ((__load8(w + 1) as int64) << 8)
        var cols = (__load8(w + 2) as int64) | ((__load8(w + 3) as int64) << 8)
        if cols > 32767 {
            cols = 32767                                // what an `int` holds shifted
        }
        r = (cols << 16) | rows
    }
    __free(w)
    return r
}

// The mode of the terminal `fd`, written at `buf` (at most 64 bytes, which
// the caller gives back to `term_set_mode` as they are): how many bytes, or
// minus the errno.
pub fun term_get_mode(fd: int64, buf: int64) -> int64 {
    let r = __syscall(SYS_IOCTL, fd, TCGETS, buf)
    if r < 0 {
        return r
    }
    return TERMIOS_SIZE
}

// The terminal `fd` set to the mode `term_get_mode` gave, at once: 0, or
// minus the errno (EINVAL for a block of another size).
pub fun term_set_mode(fd: int64, mode: str) -> int64 {
    let p = __addr_of(mode)
    if __load64(p) != TERMIOS_SIZE {
        return -22
    }
    return __syscall(SYS_IOCTL, fd, TCSETS, p + 8)
}

// The terminal `fd` made raw from its mode now: keys come one at a time as
// they are typed, not echoed; Ctrl-C and Ctrl-Z are bytes, not signals; a
// CR stays a CR; special keys arrive as their escape sequences. Output is
// as before (a "\n" still starts a line). 0, or minus the errno. A port does
// the same to its console (Windows: SetConsoleMode on the input without
// ENABLE_LINE_INPUT, ENABLE_ECHO_INPUT and ENABLE_PROCESSED_INPUT, and with
// ENABLE_VIRTUAL_TERMINAL_INPUT).
pub fun term_make_raw(fd: int64) -> int64 {
    let t = __alloc(64)
    var r = __syscall(SYS_IOCTL, fd, TCGETS, t)
    if r >= 0 {
        __store32(t, raw_iflag(__load32(t)))
        __store32(t + 8, __load32(t + 8) | 48u32)       // CS8
        __store32(t + 12, raw_lflag(__load32(t + 12)))
        __store8(t + 17 + 5, 0u8)                       // VTIME: no timer
        __store8(t + 17 + 6, 1u8)                       // VMIN: a byte at a time
        r = __syscall(SYS_IOCTL, fd, TCSETS, t)
    }
    __free(t)
    return r
}

// A raw terminal's input flags: without BRKINT, ICRNL, INPCK, ISTRIP and
// IXON (as `cfmakeraw` and line editors set them).
#test(1280u32)[0u32]
#test(1290u32)[8u32]
fun raw_iflag(f: uint32) -> uint32 {
    return f & ~(2u32 | 256u32 | 16u32 | 32u32 | 1024u32)
}

// A raw terminal's local flags: without ECHO, ICANON, IEXTEN and ISIG.
#test(35387u32)[2608u32]
fun raw_lflag(f: uint32) -> uint32 {
    return f & ~(8u32 | 2u32 | 32768u32 | 1u32)
}

// Escape sequences written to `fd` interpreted from now on: 0 for a
// terminal, which on Linux always does, or minus the errno. A port turns
// them on (Windows: ENABLE_VIRTUAL_TERMINAL_PROCESSING on the console's
// output mode).
pub fun term_enable_vt(fd: int64) -> int64 {
    if term_is_tty(fd) == 0 {
        return -25                                      // ENOTTY
    }
    return 0
}

// The interrupt and terminate signals caught (`on` 1), or back to what
// they did before once the last of those who asked lets go (`on` 0). Caught, each
// goes to the pipe whose read end `on` 1 gives, as a byte: 2 for an
// interrupt, 15 for termination; let go, what is queued is dropped. A port
// gives the same handle and bytes (Windows: a pipe its
// SetConsoleCtrlHandler routine writes CTRL_C_EVENT and CTRL_BREAK_EVENT to
// as 2, CTRL_CLOSE_EVENT, CTRL_LOGOFF_EVENT and CTRL_SHUTDOWN_EVENT as 15).
pub fun signal_listen(on: int64) -> int64 {
    let st = __rt_addr("__sig_pipe")
    while __xchg64(st + 24, 1) != 0 {
        __pause()
    }
    var r: int64 = 0
    if on != 0 {
        if __load64(st + 8) == 0 {
            let fds = __alloc(8)
            r = __syscall(SYS_PIPE2, fds, 524288, 0)    // O_CLOEXEC
            if r >= 0 {
                let rd = __load32(fds) as int64
                let wr = __load32(fds + 4) as int64
                __syscall(SYS_FCNTL, wr, F_SETFL, O_NONBLOCK)  // the handler never waits
                __store64(st, wr)
                __store64(st + 8, rd + 1)
            }
            __free(fds)
        }
        if r >= 0 {
            if __load64(st + 16) == 0 {
                catch_signal(SIGINT, __rt_addr("__on_signal"), st + 32)
                catch_signal(SIGTERM, __rt_addr("__on_signal"), st + 40)
            }
            __store64(st + 16, __load64(st + 16) + 1)
            r = __load64(st + 8) - 1
        }
    } else if __load64(st + 16) > 0 {
        __store64(st + 16, __load64(st + 16) - 1)
        if __load64(st + 16) == 0 {
            catch_signal(SIGINT, __load64(st + 32), 0)
            catch_signal(SIGTERM, __load64(st + 40), 0)
            drain(__load64(st + 8) - 1)
        }
    }
    __store_rel64(st + 24, 0)
    return r
}

// The signal `sig` handled by the code at `handler` (0: its default, 1:
// ignored), the system calls it interrupts restarted; what handled it
// before written at `saved` (unless 0).
fun catch_signal(sig: int64, handler: int64, saved: int64) {
    let act = __alloc(64)
    __store64(act, handler)
    __store64(act + 8, 0)
    __store64(act + 16, 0)
    __store64(act + 24, 0)
    if handler == __rt_addr("__on_raw_signal") {
        // raw mode's (D192): the default back as it runs, the signal it
        // sends again not held
        __store64(act + 8, 3489660928)                 // SA_RESETHAND | SA_NODEFER | SA_RESTART
    } else if handler > 1 {
        __store64(act + 8, 268435456)                  // SA_RESTART: the kernel's own trampoline returns
    }
    var old: int64 = 0
    if saved != 0 {
        old = act + 32
    }
    __syscall5(SYS_RT_SIGACTION, sig, act, old, 8, 0)
    if saved != 0 {
        __store64(saved, __load64(old))
    }
    __free(act)
}

// What the pipe's read end `fd` holds, read and dropped, without waiting.
fun drain(fd: int64) {
    let buf = __alloc(64)
    __syscall(SYS_FCNTL, fd, F_SETFL, O_NONBLOCK)
    while __syscall(SYS_READ, fd, buf, 64) > 0 {
    }
    __syscall(SYS_FCNTL, fd, F_SETFL, 0)
    __free(buf)
}

// The descriptor `signal_listen(1)` gives (the pipe's read end), or -1
// before the first listener: what std.rt checks a listener's handle holds
// (D181, MYLA-548).
pub fun signal_fd() -> int64 {
    return __load64(__rt_addr("__sig_pipe") + 8) - 1
}

// The next signal caught on the handle `h` that `signal_listen` gave, the
// thread waiting for one: 2 or 15, 0 when the pipe ended, or minus the
// errno.
pub fun signal_take(h: int64) -> int64 {
    let b = __alloc(8)
    __store64(b, 0)
    var r = __syscall(SYS_READ, h, b, 1)
    while r == EINTR {
        r = __syscall(SYS_READ, h, b, 1)
    }
    if r > 0 {
        r = __load8(b) as int64
    }
    __free(b)
    return r
}

// --- raw mode and signals (D192) ---------------------------------------------------
// While std.term holds the terminal raw, the signals that would end the
// program by their default, SIGHUP, SIGINT, SIGQUIT and SIGTERM, run
// `raw_signal` instead (`raw_signals`, from std.rt's `__term_raw`): it puts
// the terminal's mode back, as the exit hook does (D187), and ends the
// program as the signal would have. A signal ignored or caught (std.signal)
// is left as it is. Installed with SA_RESETHAND and SA_NODEFER, the
// default is back when the handler runs and the signal sent again isn't
// held, so it ends the program at once. The handler allocates nothing and
// reads only the exit hook's block (the runtime's `__exit_hook`: the
// terminal's descriptor plus one, then the mode as a string's cell, its
// bytes at 32); `__on_raw_signal` is its address (the code generator's
// name for it, as for the executor's routines). A port does the same on
// its console (Windows: a SetConsoleCtrlHandler routine that puts the mode
// back and returns FALSE, so the next handler, the default, ends the
// process).

const SIGHUP: int64 = 1
const SIGQUIT: int64 = 3

// The handler of a signal that ends the program while the terminal is raw.
pub fun raw_signal(sig: int64) {
    let h = __rt_addr("__exit_hook")
    let fd = __load64(h) - 1
    if fd >= 0 {
        __store64(h, 0)
        __syscall(SYS_IOCTL, fd, TCSETS, h + 32)
    }
    __syscall(SYS_KILL, __syscall(SYS_GETPID, 0, 0, 0), sig, 0)
}

// `raw_signal` the handler, from now on, of each of the four signals whose
// handler is the default (`on`; or it already, as a listener that let go
// put it back), or the default again for each whose handler it is (not
// `on`); under `signal_listen`'s lock.
pub fun raw_signals(on: bool) {
    let st = __rt_addr("__sig_pipe")
    while __xchg64(st + 24, 1) != 0 {
        __pause()
    }
    let raw = __rt_addr("__on_raw_signal")
    let act = __alloc(64)
    for sig in [SIGHUP, SIGINT, SIGQUIT, SIGTERM] {
        __store64(act, 0)
        __syscall5(SYS_RT_SIGACTION, sig, 0, act, 8, 0)
        let now = __load64(act)
        if on && (now == 0 || now == raw) {
            catch_signal(sig, raw, 0)
        } else if !on && now == raw {
            catch_signal(sig, 0, 0)
        }
    }
    __free(act)
    __store_rel64(st + 24, 0)
}

// --- memory --------------------------------------------------------------------

// `n` bytes of fresh memory, zeroed, readable and writable (private,
// anonymous): their address.
pub fun map_memory(n: int64) -> int64 {
    return __syscall5(SYS_MMAP, 0, n, 3, 34, -1)  // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
}

// The `n` bytes at `p` (a whole number of pages of a mapping) given back.
pub fun unmap_memory(p: int64, n: int64) {
    __syscall(SYS_MUNMAP, p, n, 0)
}

// --- time ----------------------------------------------------------------------

// The monotonic clock, in nanoseconds since some fixed point in the past.
pub fun clock_ns() -> int64 {
    let ts = __alloc(16)
    __syscall(SYS_CLOCK_GETTIME, 1, ts, 0)  // CLOCK_MONOTONIC
    let t = __load64(ts) * 1000000000 + __load64(ts + 8)
    __free(ts)
    return t
}

// The wall clock, in nanoseconds since 1970-01-01T00:00:00Z (it follows
// changes to the date, so it can go back).
pub fun wall_ns() -> int64 {
    let ts = __alloc(16)
    __syscall(SYS_CLOCK_GETTIME, 0, ts, 0)  // CLOCK_REALTIME
    let t = __load64(ts) * 1000000000 + __load64(ts + 8)
    __free(ts)
    return t
}

// The calling thread asleep for `n` nanoseconds (again after an
// interruption, for what is left).
pub fun sleep_ns(n: int64) {
    let ts = __alloc(16)
    __store64(ts, n / 1000000000)
    __store64(ts + 8, n % 1000000000)
    while __syscall(SYS_NANOSLEEP, ts, ts, 0) == EINTR {
    }
    __free(ts)
}

// --- the poller (D124) -----------------------------------------------------------
// What an idle worker waits in when tasks sleep (or, later, wait for
// descriptors): epoll, with an eventfd another worker writes to wake it.
// One worker polls at a time, so its buffers are the process's
// (`__poll_buf`); a wake-up only writes the constant 1 there.

// A new poller with its wake-up descriptor watched: the poller's
// descriptor in the low 32 bits, the wake-up one's in the high ones; or
// minus the errno (EMFILE: no descriptor left, MYLA-548), nothing kept.
pub fun poller_new() -> int64 {
    let ep = __syscall(SYS_EPOLL_CREATE1, 524288, 0, 0)  // EPOLL_CLOEXEC
    if ep < 0 {
        return ep
    }
    let ev = __syscall(SYS_EVENTFD2, 0, 526336, 0)  // EFD_CLOEXEC | EFD_NONBLOCK
    if ev < 0 {
        __syscall(SYS_CLOSE, ep, 0, 0)
        return ev
    }
    let e = __rt_addr("__poll_buf") + 32
    __store32(e, 1u32)  // EPOLLIN
    __store64(e + 8, 0)  // the token: 0, the wake-up (epoll_event isn't packed here)
    __syscall5(SYS_EPOLL_CTL, ep, 1, ev, e, 0)  // EPOLL_CTL_ADD
    return ep | (ev << 32)
}

// Waiting in the poller `p` (from `poller_new`) for at most `timeout_ms`
// milliseconds (negative: no limit), or until `poller_wake`: how many
// events (0 when the time ran out, or after an interruption). A wake-up is
// taken (its count read back to 0).
pub fun poller_wait(p: int64, timeout_ms: int64) -> int64 {
    let events = __rt_addr("__poll_buf") + 48
    let n = __syscall5(SYS_EPOLL_PWAIT, p & LOW32, events, 4, timeout_ms, 0)
    if n > 0 {
        __syscall(SYS_READ, p >> 32, __rt_addr("__poll_buf") + 112, 8)
    }
    if n < 0 {
        return 0
    }
    return n
}

// The token of event `i` of the last `poller_wait` (0: the wake-up).
pub fun poller_event(i: int64) -> int64 {
    return __load64(__rt_addr("__poll_buf") + 48 + i * 16 + 8)
}

// What event `i` of the last `poller_wait` found its descriptor ready for:
// 1 to receive (or its input ended), 2 to send, 3 both (an error or a
// hang-up counts as either), as `poller_watch_socket`'s `events` (MYLA-518).
pub fun poller_event_ready(i: int64) -> int64 {
    let ev = __load32(__rt_addr("__poll_buf") + 48 + i * 16) as int64
    var r: int64 = 0
    if (ev & 8219) != 0 { r |= 1 }  // EPOLLIN | EPOLLPRI | EPOLLERR | EPOLLHUP | EPOLLRDHUP
    if (ev & 28) != 0 { r |= 2 }    // EPOLLOUT | EPOLLERR | EPOLLHUP
    return r
}

// The descriptor `fd` watched by the poller `p` until it is readable (or
// its input ended), once (EPOLLONESHOT): the next wait gives `token`.
// `again`: the poller watched it before (a one-shot that fired, MYLA-518),
// so it is armed again first, added only if the poller has it no more (the
// descriptor was closed meanwhile).
pub fun poller_watch(p: int64, fd: int64, token: int64, again: bool) -> int64 {
    let e = __alloc(16)
    __store32(e, 1073741825u32)  // EPOLLIN | EPOLLONESHOT
    __store64(e + 8, token)
    let r = poller_ctl(p, fd, e, again)
    __free(e)
    return r
}

// The event `e` for `fd` given to the poller `p`: added, or when it has the
// descriptor already armed again (EEXIST); `again`: armed again first, and
// added when it hasn't (ENOENT).
fun poller_ctl(p: int64, fd: int64, e: int64, again: bool) -> int64 {
    var op: int64 = 1        // EPOLL_CTL_ADD
    var other: int64 = 3     // EPOLL_CTL_MOD
    var miss: int64 = -17    // EEXIST
    if again {
        op = 3
        other = 1
        miss = -2            // ENOENT
    }
    var r = __syscall5(SYS_EPOLL_CTL, p & LOW32, op, fd, e, 0)
    if r == miss {
        r = __syscall5(SYS_EPOLL_CTL, p & LOW32, other, fd, e, 0)
    }
    return r
}

// The descriptor `fd` no longer watched by the poller `p`.
pub fun poller_forget(p: int64, fd: int64) {
    __syscall5(SYS_EPOLL_CTL, p & LOW32, 2, fd, 0, 0)  // EPOLL_CTL_DEL
}

// The socket `h` watched by the poller `p` until it is ready for `events`
// (1: to receive or accept, 2: to send or a connect's end; an error or a
// hang-up always counts), once: the next wait gives `token` (MYLA-346). A
// socket watched already is armed again with the new `events`, which the
// caller makes the union of what its waiters ask; `again` as
// `poller_watch`'s. A port whose sockets aren't the poller's descriptors
// (Windows: WSAPoll, or IOCP) watches them its own way here.
pub fun poller_watch_socket(p: int64, h: int64, events: int64, token: int64, again: bool) -> int64 {
    var ev: int64 = 1073741824          // EPOLLONESHOT
    if (events & 1) != 0 { ev |= 1 }    // EPOLLIN
    if (events & 2) != 0 { ev |= 4 }    // EPOLLOUT
    let e = __alloc(16)
    __store32(e, ev as uint32)
    __store64(e + EVENT_DATA, token)
    let r = poller_ctl(p, h, e, again)
    __free(e)
    return r
}

// The socket `h` no longer watched by the poller `p`.
pub fun poller_forget_socket(p: int64, h: int64) {
    __syscall5(SYS_EPOLL_CTL, p & LOW32, 2, h, 0, 0)  // EPOLL_CTL_DEL
}

// The worker waiting in the poller `p` woken (or the next wait returns at
// once).
pub fun poller_wake(p: int64) {
    let one = __rt_addr("__poll_buf") + 120
    __store64(one, 1)
    __syscall(SYS_WRITE, p >> 32, one, 8)
}

// --- workers -------------------------------------------------------------------

// How many CPUs this process may run on (0 when the system won't say).
pub fun cpus_allowed() -> int64 {
    let mask = __rt_addr("__cpu_mask")
    let got = __syscall(SYS_SCHED_GETAFFINITY, 0, 128, mask)
    var n: int64 = 0
    var i: int64 = 0
    while i < got {
        var b = __load8(mask + i) as int64
        while b != 0 {
            b = b & (b - 1)
            n += 1
        }
        i += 1
    }
    return n
}

// The worker parked while the 32-bit word at `addr` still holds `seen`
// (it may also wake for no reason).
pub fun park(addr: int64, seen: int64) {
    __syscall(SYS_FUTEX, addr, FUTEX_WAIT_PRIVATE, seen)
}

// One worker parked on the word at `addr` woken.
pub fun unpark_one(addr: int64) {
    __syscall(SYS_FUTEX, addr, FUTEX_WAKE_PRIVATE, 1)
}

// The process ended with the status `code`, every thread with it.
pub fun exit(code: int64) {
    __syscall(SYS_EXIT_GROUP, code, 0, 0)
}
