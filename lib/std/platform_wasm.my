// std.platform — the platform layer under std.rt: WebAssembly on WASI
// preview 1 (MYLA-158, D125).
//
// The same functions as std/platform.my (Linux on x86-64), over the
// `wasi_snapshot_preview1` imports. Each call goes through `__syscall(n,
// args, 0, 0)`: `n` is one of the W_ numbers below, the runtime's
// dispatcher (selfhost/runtime_wasm.my) calls the import of that number
// with the words in the block `__wasi_args` as its arguments, and gives
// its errno (or, for `W_MEMORY_GROW`, `memory.grow`'s result). WASI's
// errnos are given back as Linux's, negative, which std.io knows.
//
// WASI has no working directory and no processes: paths are resolved
// against the first directory the host opened for the program (descriptor
// 3, `/` in the test runner) and the working directory the host's `PWD`
// names; `run` and `spawn` fail with ENOSYS. One worker runs every task
// (D125), so nothing here waits for another thread. Not for programs (its
// primitives are the standard library's, D100).

// The target this module is the platform layer of, as `--target` names it:
// the target a program built with it runs on (wasm32 on WASI). The toolchain's
// own build of it is its default target, the host's.
pub const TARGET: str = "wasm32-wasi"

pub const EINTR: int64 = -4
pub const EAGAIN: int64 = -11
pub const EPIPE: int64 = -32
// Whether memory unmapped goes back to the system (the linear memory doesn't shrink).
pub const RETURNS_MEMORY: bool = false
// Whether `advise_huge_pages` can back memory with huge pages (the linear
// memory's pages are the engine's).
pub const HUGE_PAGES: bool = false

const W_FD_WRITE: int64 = 1
const W_FD_READ: int64 = 2
const W_FD_CLOSE: int64 = 3
const W_FD_FILESTAT_GET: int64 = 4
const W_FD_READDIR: int64 = 5
const W_PATH_OPEN: int64 = 6
const W_PATH_FILESTAT_GET: int64 = 7
const W_PATH_CREATE_DIRECTORY: int64 = 8
const W_PATH_REMOVE_DIRECTORY: int64 = 9
const W_PATH_UNLINK_FILE: int64 = 10
const W_PATH_RENAME: int64 = 11
const W_CLOCK_TIME_GET: int64 = 12
const W_POLL_ONEOFF: int64 = 13
const W_PROC_EXIT: int64 = 14
const W_ARGS_SIZES_GET: int64 = 15
const W_ARGS_GET: int64 = 16
const W_ENVIRON_SIZES_GET: int64 = 17
const W_ENVIRON_GET: int64 = 18
const W_RANDOM_GET: int64 = 19
const W_FD_SEEK: int64 = 20
const W_MEMORY_GROW: int64 = 21

const ENOSYS: int64 = -38
const PREOPEN: int64 = 3
const PAGE: int64 = 65536
const LOW32: int64 = 4294967295i64

// --- calls ---------------------------------------------------------------------

// The `k`-th argument word of the next call.
fun arg(k: int64, v: int64) {
    __store64(__rt_addr("__wasi_args") + 8 * k, v)
}

// The import `n` called with the arguments set: 0, or a negative errno.
fun call(n: int64) -> int64 {
    let e = __syscall(n, __rt_addr("__wasi_args"), 0, 0)
    if e == 0 {
        return 0
    }
    return -errno_linux(e)
}

// Linux's number of each of WASI preview 1's errnos, 0 (success) to 76
// (ENOTCAPABLE, which Linux hasn't: EACCES), three digits each in WASI's
// order: E2BIG 7, EACCES 13, EADDRINUSE 98, … ELOOP 40, … ENAMETOOLONG 36, …
// EPERM 1, … EXDEV 18.
const LINUX_ERRNOS: str = "000007013098099097011114009074016125010103111104035089033122017014027113043084115004022005106021040024031090072036100102101023105019002008037067012042092028038107020039131088095025006075130001032071093091034030029003116110026018013"

// WASI's errno `e` as Linux's; one WASI doesn't define (a later host's)
// 4096 plus it, past every Linux errno, so it stays `Other` and its own
// rather than becoming another cause (MYLA-426: they were all EIO).
#test(44)[2]
#test(76)[13]
#test(63)[1] // EPERM
#test(6)[11]
#test(51)[28]
#test(70)[29]
#test(32)[40] // ELOOP
#test(37)[36] // ENAMETOOLONG
#test(1)[7]
#test(75)[18]
#test(77)[4173]
fun errno_linux(e: int64) -> int64 {
    if e < 1 || e > 76 {
        return 4096 + e
    }
    let k = (3 * e) as int
    return ((LINUX_ERRNOS[k] - '0') as int64) * 100 + ((LINUX_ERRNOS[k + 1] - '0') as int64) * 10 + (LINUX_ERRNOS[k + 2] - '0') as int64
}

// A scratch word of the calls (`__wasi_buf`, 64 bytes).
fun scratch(k: int64) -> int64 {
    return __rt_addr("__wasi_buf") + 8 * k
}

// --- the start -------------------------------------------------------------------

// The arguments and the environment as the kernel lays them out on Linux,
// for `__argv` and `__environ`: a list of 8-byte pointers to NUL-terminated
// strings ending with 0 (the runtime's `_start` calls this first).
pub fun wasm_start() {
    __store64(__rt_addr("__argv"), c_vector(W_ARGS_SIZES_GET, W_ARGS_GET))
    __store64(__rt_addr("__envp"), c_vector(W_ENVIRON_SIZES_GET, W_ENVIRON_GET))
}

// The vector of `sizes`/`get` (args or environ): WASI writes 4-byte
// pointers, widened here to the 8-byte ones std.rt reads.
fun c_vector(sizes: int64, get: int64) -> int64 {
    arg(0, scratch(0))
    arg(1, scratch(1))
    __store64(scratch(0), 0)
    __store64(scratch(1), 0)
    let r = call(sizes)
    let n = __load64(scratch(0)) & LOW32
    let bytes = __load64(scratch(1)) & LOW32
    let ptrs = map_memory(4 * n + bytes + 8 * n + 8)
    let strs = ptrs + 4 * n
    let out = strs + bytes
    if r == 0 && n > 0 {
        arg(0, ptrs)
        arg(1, strs)
        let g = call(get)
    }
    var i: int64 = 0
    while i < n {
        __store64(out + 8 * i, __load32(ptrs + 4 * i) as int64)
        i += 1
    }
    __store64(out + 8 * n, 0)
    return out
}

// --- files and directories -----------------------------------------------------

// The value of the environment variable `name` (no `=`), "" when unset.
fun env_value(name: str) -> str {
    var at = __load64(__rt_addr("__envp"))
    if at == 0 {
        return ""
    }
    let np = __addr_of(name)
    let nlen = __load64(np)
    while __load64(at) != 0 {
        let s = __load64(at)
        var i: int64 = 0
        while i < nlen && __load8(s + i) == __load8(np + 8 + i) {
            i += 1
        }
        if i == nlen && __load8(s + nlen) == 61u8 {
            var sb = StringBuilder()
            var j = nlen + 1
            while __load8(s + j) != 0u8 {
                sb.append_byte(__load8(s + j))
                j += 1
            }
            return sb.build()
        }
        at += 8
    }
    return ""
}

// `path` as WASI takes it: relative to the preopened `/`, a relative one
// first joined to the working directory (`PWD`).
#test("/tmp/x")["tmp/x"]
#test("/")["."]
fun wasi_path(path: str) -> str {
    var full = path
    if path.len() == 0 || path[0] != '/' {
        var wd = env_value("PWD")
        if wd == "" {
            wd = "/"
        }
        full = wd + "/" + path
    }
    var i = 0
    while i < full.len() && full[i] == '/' {
        i += 1
    }
    if i == full.len() {
        return "."
    }
    var sb = StringBuilder()
    sb.append(full, i, full.len())
    return sb.build()
}

// The import `n` on a path of the preopened directory: `(dir, path, len)`
// as its first three arguments, then `rest` from the fourth on.
// An empty path names nothing, as on Linux (ENOENT); WASI would take it for
// the preopened directory itself (MYLA-281).
fun on_path(n: int64, path: str, flags_first: bool, rest: [int64]) -> int64 {
    var lookup: int64 = -1
    if flags_first {
        lookup = 1  // LOOKUPFLAGS_SYMLINK_FOLLOW
    }
    return on_path_lookup(n, path, lookup, rest)
}

// `on_path` with the lookup flags `lookup` second (-1: none), so a link
// can be looked at itself (0, MYLA-363).
fun on_path_lookup(n: int64, path: str, lookup: int64, rest: [int64]) -> int64 {
    if path.len() == 0 {
        return -2
    }
    let p = wasi_path(path)
    let a = __addr_of(p)
    var k: int64 = 0
    arg(k, PREOPEN)
    k += 1
    if lookup >= 0 {
        arg(k, lookup)
        k += 1
    }
    arg(k, a + 8)
    arg(k + 1, __load64(a))
    k += 2
    for v in rest {
        arg(k, v)
        k += 1
    }
    return call(n)
}

// `path` opened with WASI's open flags `oflags`: its descriptor.
fun open_with(path: str, oflags: int64) -> int64 {
    let fdp = scratch(7)
    // every right the directory may pass on
    let r = on_path(W_PATH_OPEN, path, true, [oflags, -1, -1, 0, fdp])
    if r < 0 {
        return r
    }
    return __load64(fdp) & LOW32
}

pub fun open_read(path: str) -> int64 {
    return open_with(path, 0)
}

pub fun open_write(path: str) -> int64 {
    return open_with(path, 9)  // OFLAGS_CREAT | OFLAGS_TRUNC
}

// A directory opened to read it from its start: its descriptor's cookie
// (`dir_read`) starts at 0, whatever an earlier descriptor of that number,
// or one 64 apart, left there.
pub fun open_dir(path: str) -> int64 {
    let fd = open_with(path, 2)  // OFLAGS_DIRECTORY
    if fd >= 0 {
        __store64(__rt_addr("__wasi_cookies") + 8 * (fd & 63), 0)
    }
    return fd
}

// One read or write of `n` bytes at `buf` (`op`: the import).
fun rw(op: int64, fd: int64, buf: int64, n: int64) -> int64 {
    let iov = scratch(2)
    __store32(iov, buf as uint32)
    __store32(iov + 4, n as uint32)
    arg(0, fd)
    arg(1, iov)
    arg(2, 1)
    arg(3, scratch(3))
    let r = call(op)
    if r < 0 {
        return r
    }
    return __load64(scratch(3)) & LOW32
}

// A read of a directory is Linux's EISDIR, as `std.io` reports it on every
// target (MYLA-281): WASI hosts refuse it otherwise (EBADF, a directory's
// descriptor has no read right), so a refused read of one is that.
pub fun read(fd: int64, buf: int64, n: int64) -> int64 {
    let r = rw(W_FD_READ, fd, buf, n)
    if r == -9 && is_dir_fd(fd) {
        return -21
    }
    return r
}

// Whether the open descriptor `fd` is a directory (its filestat's type at
// 16, 3).
fun is_dir_fd(fd: int64) -> bool {
    let st = __rt_addr("__wasi_stat")
    arg(0, fd)
    arg(1, st)
    if call(W_FD_FILESTAT_GET) < 0 {
        return false
    }
    return __load8(st + 16) as int64 == 3
}

pub fun write(fd: int64, buf: int64, n: int64) -> int64 {
    return rw(W_FD_WRITE, fd, buf, n)
}

// The descriptor `fd` closed (`fd_close`): 0, or minus the errno.
pub fun close(fd: int64) -> int64 {
    arg(0, fd)
    return call(W_FD_CLOSE)
}

// The size of the open file `fd` (a filestat's size at 32).
pub fun file_size(fd: int64) -> int64 {
    let st = __rt_addr("__wasi_stat")
    arg(0, fd)
    arg(1, st)
    if call(W_FD_FILESTAT_GET) < 0 {
        return 0
    }
    return __load64(st + 32)
}

// The mode of what `path` names, from its file type (`mode_of_type`).
pub fun mode_of(path: str) -> int64 {
    let st = __rt_addr("__wasi_stat")
    let r = on_path(W_PATH_FILESTAT_GET, path, true, [st])
    if r < 0 {
        return r
    }
    return mode_of_type(__load8(st + 16) as int64)
}

// A mode for WASI's file type `t`, which has no permissions: a directory
// 0o40755, a regular file 0o100644, a symbolic link 0o120777, anything
// else 0o644.
#test(3)[16877]
#test(4)[33188]
#test(7)[41471]
#test(2)[420]
fun mode_of_type(t: int64) -> int64 {
    if t == 3 {
        return 16877
    }
    if t == 4 {
        return 33188
    }
    if t == 7 {
        return 41471
    }
    return 420
}

// The size, the mode (`mode_of_type`), the modification time, the device
// and the file's number on it of what `path` names, as five words at
// `out` (`path_filestat_get`, a link followed when `follow`, MYLA-378): 0,
// or minus the errno.
pub fun path_stat(path: str, follow: bool, out: int64) -> int64 {
    let st = __rt_addr("__wasi_stat")
    var lookup: int64 = 0
    if follow {
        lookup = 1  // LOOKUPFLAGS_SYMLINK_FOLLOW
    }
    let r = on_path_lookup(W_PATH_FILESTAT_GET, path, lookup, [st])
    if r < 0 {
        return r
    }
    __store64(out, __load64(st + 32))
    __store64(out + 8, mode_of_type(__load8(st + 16) as int64))
    __store64(out + 16, __load64(st + 48))
    __store64(out + 24, __load64(st))
    __store64(out + 32, __load64(st + 8))
    return 0
}

// The file at `path` opened with std.rt's portable `flags` (1 read, 2
// write, 4 create, 8 truncate, 16 append, 32 exclusive) as `path_open`
// takes them (MYLA-336): the open flags (CREAT 1, EXCL 4, TRUNC 8), the
// rights to read or write (`open_rights`) and the descriptor's flags
// (APPEND 1); WASI has no permissions, so `mode` is not used.
pub fun open_file(path: str, flags: int64, mode: int64) -> int64 {
    var oflags: int64 = 0
    if (flags & 4) != 0 { oflags |= 1 }
    if (flags & 32) != 0 { oflags |= 4 }
    if (flags & 8) != 0 { oflags |= 8 }
    var fdflags: int64 = 0
    if (flags & 16) != 0 { fdflags = 1 }
    let rights = open_rights(flags)
    let fdp = scratch(7)
    let r = on_path(W_PATH_OPEN, path, true, [oflags, rights, rights, fdflags, fdp])
    if r < 0 {
        return r
    }
    return __load64(fdp) & LOW32
}

// The rights a descriptor opened with the portable `flags` asks for: to
// seek, tell, stat and poll it always, to read it (FD_READ) and to write
// it (FD_WRITE, FD_DATASYNC, FD_SYNC, FD_ALLOCATE, FD_FILESTAT_SET_SIZE
// and _TIMES) as the flags say.
#test(1)[136315054]
#test(2)[148898301]
fun open_rights(flags: int64) -> int64 {
    // FD_SEEK, FD_FDSTAT_SET_FLAGS, FD_TELL, FD_ADVISE, FD_FILESTAT_GET, POLL_FD_READWRITE
    var r: int64 = 4 | 8 | 32 | 128 | (1i64 << 21) | (1i64 << 27)
    if (flags & 1) != 0 {
        r |= 2
    }
    if (flags & 2) != 0 {
        r |= 1 | 16 | 64 | 256 | (1i64 << 22) | (1i64 << 23)
    }
    return r
}

// The cursor of `fd` moved to `offset` from the start (`whence` 0), the
// cursor (1) or the end (2), WASI's whences too: the new offset. A host's
// offset past `int64`'s range (WASI's is a `uint64`) is EINVAL, as Linux's
// lseek gives for one past its largest (MYLA-426).
pub fun seek(fd: int64, offset: int64, whence: int64) -> int64 {
    arg(0, fd)
    arg(1, offset)
    arg(2, whence)
    arg(3, scratch(6))
    let r = call(W_FD_SEEK)
    if r < 0 {
        return r
    }
    let at = __load64(scratch(6))
    if at < 0 {
        return -22
    }
    return at
}

// The size, the mode (`mode_of_type`) and the modification time
// (nanoseconds since 1970) of the open file `fd`, as three words at `out`:
// 0, or minus the errno (a filestat: the type at 16, the size at 32, the
// modification time at 48).
pub fun fd_stat(fd: int64, out: int64) -> int64 {
    let st = __rt_addr("__wasi_stat")
    arg(0, fd)
    arg(1, st)
    let r = call(W_FD_FILESTAT_GET)
    if r < 0 {
        return r
    }
    __store64(out, __load64(st + 32))
    __store64(out + 8, mode_of_type(__load8(st + 16) as int64))
    __store64(out + 16, __load64(st + 48))
    return 0
}

// `n` bytes from the host's entropy at `buf` (`random_get`, in pieces of
// 64 KB): 0, or minus the errno.
pub fun random_fill(buf: int64, n: int64) -> int64 {
    var done: int64 = 0
    while done < n {
        var len = n - done
        if len > PAGE {
            len = PAGE
        }
        arg(0, buf + done)
        arg(1, len)
        let r = call(W_RANDOM_GET)
        if r < 0 {
            return r
        }
        done += len
    }
    return 0
}

pub fun make_dir(path: str, mode: int64) -> int64 {
    return on_path(W_PATH_CREATE_DIRECTORY, path, false, [])
}

pub fun remove_file(path: str) -> int64 {
    return on_path(W_PATH_UNLINK_FILE, path, false, [])
}

pub fun remove_dir(path: str) -> int64 {
    return on_path(W_PATH_REMOVE_DIRECTORY, path, false, [])
}

pub fun rename(from_path: str, to_path: str) -> int64 {
    let b = wasi_path(to_path)
    let ba = __addr_of(b)
    return on_path(W_PATH_RENAME, from_path, false, [PREOPEN, ba + 8, __load64(ba)])
}

// The working directory (`PWD`, else `/`) written to `buf`: its length; as
// Linux's `getcwd`, ENOENT when it was removed (MYLA-281).
pub fun cwd(buf: int64, n: int64) -> int64 {
    var wd = env_value("PWD")
    if wd == "" {
        wd = "/"
    }
    let st = __rt_addr("__wasi_stat")
    if on_path(W_PATH_FILESTAT_GET, wd, true, [st]) == -2 {
        return -2
    }
    let a = __addr_of(wd)
    let len = __load64(a)
    if len + 1 > n {
        return -34  // ERANGE
    }
    __copy_bytes(buf, a + 8, len)
    __store8(buf + len, 0u8)
    return len
}

// The next entries of the directory `fd` read to `buf` as Linux's records
// (`dir_entry_name`, `dir_entry_size`): WASI's records (a 24-byte header,
// the name not terminated) read after the cookie of the last entry given,
// kept in the descriptor's word of `__wasi_cookies`, and each rewritten
// with its name NUL-terminated at 19.
pub fun dir_read(fd: int64, buf: int64, n: int64) -> int64 {
    let cookie_at = __rt_addr("__wasi_cookies") + 8 * (fd & 63)
    let raw = __alloc(n)
    arg(0, fd)
    arg(1, raw)
    arg(2, n / 2)
    arg(3, __load64(cookie_at))
    arg(4, scratch(4))
    let r = call(W_FD_READDIR)
    if r < 0 {
        __free(raw)
        return r
    }
    let used = __load64(scratch(4)) & LOW32
    var at: int64 = 0
    var out: int64 = 0
    while at + 24 <= used {
        let namlen = __load32(raw + at + 16) as int64
        if at + 24 + namlen > used {
            break
        }
        let size = (19 + namlen + 1 + 7) / 8 * 8
        if out + size > n {
            break
        }
        __store64(buf + out, __load64(raw + at + 8))
        __store64(buf + out + 8, 0)
        __store64(buf + out + 16, size)
        __copy_bytes(buf + out + 19, raw + at + 24, namlen)
        __store8(buf + out + 19 + namlen, 0u8)
        __store64(cookie_at, __load64(raw + at))
        out += size
        at += 24 + namlen
    }
    __free(raw)
    return out
}

pub fun dir_entry_name(rec: int64) -> int64 {
    return rec + 19
}

pub fun dir_entry_size(rec: int64) -> int64 {
    return __load64(rec + 16) & 65535i64
}

// --- the standard streams --------------------------------------------------------

// 1 when a read of `fd` won't block, 0 when `timeout_ms` (negative: none)
// ran out: poll_oneoff on the descriptor and, with a limit, the clock.
pub fun poll_read(fd: int64, timeout_ms: int64) -> int64 {
    return poll_fd(fd, 1u8, timeout_ms)
}

// `poll_read` for room to write (MYLA-419).
pub fun poll_write(fd: int64, timeout_ms: int64) -> int64 {
    return poll_fd(fd, 2u8, timeout_ms)
}

// `poll_read` and `poll_write`: the subscription's tag `tag` (1 read, 2
// write).
fun poll_fd(fd: int64, tag: uint8, timeout_ms: int64) -> int64 {
    let subs = __rt_addr("__wasi_subs")
    // a subscription: userdata 8, tag 1 or 2 (+8), then the fd (+16)
    __store64(subs, 1)
    __store8(subs + 8, tag)
    __store32(subs + 16, fd as uint32)
    var n: int64 = 1
    if timeout_ms >= 0 {
        clock_sub(subs + 48, 2, timeout_ms * 1000000)
        n = 2
    }
    let got = poll(subs, n)
    var i: int64 = 0
    while i < got {
        if __load64(__rt_addr("__wasi_events") + 32 * i) == 1 {
            return 1
        }
        i += 1
    }
    return 0
}

// A clock subscription at `s` (userdata `tag`) for `ns` nanoseconds from now.
fun clock_sub(s: int64, tag: int64, ns: int64) {
    __store64(s, tag)
    __store8(s + 8, 0u8)
    __store32(s + 16, 1u32)  // CLOCKID_MONOTONIC
    __store64(s + 24, ns)
    __store64(s + 32, 1000)
    __store64(s + 40, 0)
}

// poll_oneoff on the `n` subscriptions at `subs`: how many events
// (`__wasi_events`, 32 bytes each, the userdata first).
fun poll(subs: int64, n: int64) -> int64 {
    arg(0, subs)
    arg(1, __rt_addr("__wasi_events"))
    arg(2, n)
    arg(3, scratch(5))
    if call(W_POLL_ONEOFF) < 0 {
        return 0
    }
    return __load64(scratch(5)) & LOW32
}

pub fun write_all(fd: int64, p: int64, n: int64) -> int64 {
    var at = p
    var left = n
    while left > 0 {
        let r = write(fd, at, left)
        if r >= 0 {
            at += r
            left -= r
        } else if r != EINTR && r != EAGAIN {
            return r
        }
    }
    return 0
}

// The `n` bytes at `p` and a newline on the standard output in one write.
pub fun write_line(p: int64, n: int64) -> int64 {
    let iov = scratch(2)
    __store32(iov, p as uint32)
    __store32(iov + 4, n as uint32)
    __store32(iov + 8, (__addr_of("\n") + 8) as uint32)
    __store32(iov + 12, 1u32)
    arg(0, 1)
    arg(1, iov)
    arg(2, 2)
    arg(3, scratch(4))
    let c = call(W_FD_WRITE)
    if c < 0 {
        return c
    }
    let r = __load64(scratch(4)) & LOW32
    if r < n {
        let e = write_all(1, p + r, n - r)
        if e < 0 {
            return e
        }
        return write_all(1, __addr_of("\n") + 8, 1)
    }
    if r == n {
        return write_all(1, __addr_of("\n") + 8, 1)
    }
    return 0
}

// A write to a closed pipe on the standard output or error ends the program
// quietly (D146): WASI has no signals, so with the exit code a shell shows
// for one that SIGPIPE ended.
pub fun broken_pipe() {
    exit(141)
}

// --- processes: none on WASI -------------------------------------------------------

pub fun run(program: str, argv: [str]) -> [uint8] {
    let none: [uint8] = []
    __set_run_stderr(none)
    __set_run_status(-1, 0, 38)
    return none
}

pub fun spawn(program: str, argv: [str]) -> [int] {
    return [38, 0, -1, -1, -1]
}

// `run` and `spawn` with the paths to try and options (D147): no processes
// either.
pub fun run_with(paths: [str], argv: [str], opts: [str]) -> [uint8] {
    return run("", argv)
}

pub fun spawn_with(paths: [str], argv: [str], opts: [str]) -> [int] {
    return spawn("", argv)
}

// A child with pipes (MYLA-336): none either.
pub fun spawn_piped(paths: [str], argv: [str], opts: [str]) -> [int] {
    return [38, 0, -1, -1, -1, -1]
}

