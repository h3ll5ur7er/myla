// --- memory --------------------------------------------------------------------

// `n` bytes of fresh, zeroed memory: the pages the linear memory grew by.
pub fun map_memory(n: int64) -> int64 {
    arg(0, (n + PAGE - 1) / PAGE)
    let old = __syscall(W_MEMORY_GROW, __rt_addr("__wasi_args"), 0, 0)
    if old < 0 {
        return -12  // ENOMEM
    }
    return old * PAGE
}

// The linear memory doesn't shrink: nothing given back.
pub fun unmap_memory(p: int64, n: int64) {
}

// No huge pages to ask for: nothing changes.
pub fun advise_huge_pages(p: int64, n: int64) {
}

// --- time ----------------------------------------------------------------------

pub fun clock_ns() -> int64 {
    arg(0, 1)  // CLOCKID_MONOTONIC
    arg(1, 1)
    arg(2, scratch(6))
    let r = call(W_CLOCK_TIME_GET)
    return __load64(scratch(6))
}

// The wall clock, in nanoseconds since 1970-01-01T00:00:00Z.
pub fun wall_ns() -> int64 {
    arg(0, 0)  // CLOCKID_REALTIME
    arg(1, 1)
    arg(2, scratch(6))
    let r = call(W_CLOCK_TIME_GET)
    return __load64(scratch(6))
}

pub fun sleep_ns(n: int64) {
    if n <= 0 {
        return
    }
    let subs = __rt_addr("__wasi_subs")
    clock_sub(subs, 2, n)
    let got = poll(subs, 1)
}

// --- the poller (D124) -----------------------------------------------------------
// One worker, so the poller is poll_oneoff over the watched descriptors and
// the clock: `poller_watch` records a descriptor (`__wasi_watch`, up to 32,
// `[fd][token]`), `poller_wait` polls them all, `poller_event` gives the
// tokens of those ready. Nothing can wake it from another thread.

pub fun poller_new() -> int64 {
    __store64(__rt_addr("__wasi_watch"), 0)
    return 1
}

pub fun poller_wait(p: int64, timeout_ms: int64) -> int64 {
    let w = __rt_addr("__wasi_watch")
    let n = __load64(w)
    let subs = __rt_addr("__wasi_subs")
    var i: int64 = 0
    while i < n {
        let s = subs + 48 * i
        __store64(s, __load64(w + 16 + 16 * i))
        __store8(s + 8, 1u8)
        __store32(s + 16, __load64(w + 8 + 16 * i) as uint32)
        i += 1
    }
    var m = n
    if timeout_ms >= 0 || n == 0 {
        var t = timeout_ms
        if t < 0 {
            t = 3600000
        }
        clock_sub(subs + 48 * n, 0, t * 1000000)
        m = n + 1
    }
    let got = poll(subs, m)
    // the descriptors ready, their tokens kept for `poller_event`, unwatched
    var k: int64 = 0
    var e: int64 = 0
    while e < got {
        let tok = __load64(__rt_addr("__wasi_events") + 32 * e)
        if tok != 0 && ((__load32(__rt_addr("__wasi_events") + 32 * e + 8) as int64) >> 16) == 1 {
            __store64(__rt_addr("__wasi_ready") + 8 * k, tok)
            forget_token(tok)
            k += 1
        }
        e += 1
    }
    return k
}

// The watch with the token `tok` taken off.
fun forget_token(tok: int64) {
    let w = __rt_addr("__wasi_watch")
    let n = __load64(w)
    var i: int64 = 0
    while i < n {
        if __load64(w + 16 + 16 * i) == tok {
            __store64(w + 8 + 16 * i, __load64(w + 8 + 16 * (n - 1)))
            __store64(w + 16 + 16 * i, __load64(w + 16 + 16 * (n - 1)))
            __store64(w, n - 1)
            return
        }
        i += 1
    }
}

pub fun poller_event(i: int64) -> int64 {
    return __load64(__rt_addr("__wasi_ready") + 8 * i)
}

// Only reads are watched here: an event is a descriptor ready to read.
pub fun poller_event_ready(i: int64) -> int64 {
    return 1
}

pub fun poller_watch(p: int64, fd: int64, token: int64, again: bool) -> int64 {
    let w = __rt_addr("__wasi_watch")
    let n = __load64(w)
    if n >= 32 {
        return -12
    }
    __store64(w + 8 + 16 * n, fd)
    __store64(w + 16 + 16 * n, token)
    __store64(w, n + 1)
    return 0
}

pub fun poller_forget(p: int64, fd: int64) {
    let w = __rt_addr("__wasi_watch")
    var i: int64 = 0
    while i < __load64(w) {
        if __load64(w + 8 + 16 * i) == fd {
            forget_token(__load64(w + 16 + 16 * i))
        } else {
            i += 1
        }
    }
}

