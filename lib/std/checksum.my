// --- Adler-32 ---------------------------------------------------------------

const ADLER_MOD: uint32 = 65521
// The most bytes after which `b` still fits 32 bits, so the sums are reduced
// once per block (zlib's NMAX).
const ADLER_BLOCK: int = 5552

// Adler-32 as zlib computes it (RFC 1950): the sum of the bytes plus 1, and
// the sum of those sums, each modulo 65521.
#test("")[1u32]
#test("Wikipedia")[0x11E60398u32]
#test("123456789")[0x091E01DEu32]
#test("The quick brown fox jumps over the lazy dog")[0x5BDC0FDAu32]
pub fun adler32(s: str) -> uint32 {
    return adler32_update(1, s)
}

#test([])[1u32]
#test([87u8, 105u8, 107u8, 105u8, 112u8, 101u8, 100u8, 105u8, 97u8])[0x11E60398u32]
pub fun adler32_bytes(b: [uint8]) -> uint32 {
    return adler32_update_bytes(1, b)
}

// The Adler-32 of the bytes behind `adler` followed by `s`, as zlib's
// `adler32(adler, buf, len)`: start from 1 (not 0, as for `crc32_update`),
// and `adler32_update(adler32(a), b) == adler32(a + b)`.
#test(1u32, "Wikipedia")[0x11E60398u32]
#test(adler32("Wiki"), "pedia")[0x11E60398u32]
pub fun adler32_update(adler: uint32, s: str) -> uint32 {
    var a = adler & 0xFFFF
    var b = adler >> 16
    let n = s.len()
    var i = 0
    while i < n {
        var end = i + ADLER_BLOCK
        if end > n {
            end = n
        }
        while i < end {
            a += s[i] as uint32
            b += a
            i += 1
        }
        a = a % ADLER_MOD
        b = b % ADLER_MOD
    }
    return (b << 16) | a
}

#test(adler32("Wiki"), [112u8, 101u8, 100u8, 105u8, 97u8])[0x11E60398u32]
pub fun adler32_update_bytes(adler: uint32, bytes: [uint8]) -> uint32 {
    var a = adler & 0xFFFF
    var b = adler >> 16
    let n = bytes.len()
    var i = 0
    while i < n {
        var end = i + ADLER_BLOCK
        if end > n {
            end = n
        }
        while i < end {
            a += bytes[i] as uint32
            b += a
            i += 1
        }
        a = a % ADLER_MOD
        b = b % ADLER_MOD
    }
    return (b << 16) | a
}

// --- test functions -----------------------------------------------------------

// `n` bytes of a pattern that runs through every byte value: (7i + 3) mod 256.
fun pattern(n: int) -> str {
    var sb = StringBuilder()
    var i = 0
    while i < n {
        sb.append_byte(((i * 7 + 3) & 255) as uint8)
        i += 1
    }
    return sb.build()
}

// The bytes `s[start:end]`; a slice of a `str` would refuse a bound inside
// a UTF-8 character, and the pattern isn't UTF-8.
fun part(s: str, start: int, end: int) -> str {
    var sb = StringBuilder()
    sb.append(s, start, end)
    return sb.build()
}

fun bytes_of(s: str) -> [uint8] {
    var b: [uint8] = []
    var i = 0
    while i < s.len() {
        b.push(s[i])
        i += 1
    }
    return b
}

// 10000 bytes of the pattern: every path of every algorithm (slicing by
// 8, several Adler blocks). The values are Python's zlib and a model of
// FNV-1a in Python.
#test
fun long_input() {
    let s = pattern(10000)
    let b = bytes_of(s)
    assert(crc32(s) == 0xd5e50a16, "crc32")
    assert(crc32_bytes(b) == 0xd5e50a16, "crc32_bytes")
    assert(adler32(s) == 0x0d817116, "adler32")
    assert(adler32_bytes(b) == 0x0d817116, "adler32_bytes")
    assert(fnv1a32(s) == 0xc3cecd45, "fnv1a32")
    assert(fnv1a32_bytes(b) == 0xc3cecd45, "fnv1a32_bytes")
    assert(fnv1a64(s) == 0xf620631576c1ec25, "fnv1a64")
    assert(fnv1a64_bytes(b) == 0xf620631576c1ec25, "fnv1a64_bytes")
}

// At every length up to 130, the `str` and `[uint8]` forms agree, and a
// checksum is the same however the input is split.
#test
fun forms_agree() {
    let all = pattern(130)
    var n = 0
    while n <= 130 {
        let s = part(all, 0, n)
        let b = bytes_of(s)
        assert(fnv1a32(s) == fnv1a32_bytes(b), f"fnv1a32 at {n}")
        assert(fnv1a64(s) == fnv1a64_bytes(b), f"fnv1a64 at {n}")
        assert(crc32(s) == crc32_bytes(b), f"crc32 at {n}")
        assert(adler32(s) == adler32_bytes(b), f"adler32 at {n}")
        for k in [0, n / 3, n / 2, n] {
            let head = part(s, 0, k)
            let tail = part(s, k, n)
            assert(crc32_update(crc32(head), tail) == crc32(s), f"crc32 split {k} of {n}")
            assert(crc32_update_bytes(crc32(head), b[k:]) == crc32(s), f"crc32_bytes split {k} of {n}")
            assert(adler32_update(adler32(head), tail) == adler32(s), f"adler32 split {k} of {n}")
            assert(adler32_update_bytes(adler32(head), b[k:]) == adler32(s), f"adler32_bytes split {k} of {n}")
        }
        n += 1
    }
}

// Around the length where CRC-32 starts slicing by 8, and past Adler's
// block, a whole input agrees with the same input given in pieces of 100
// bytes, which take the byte-at-a-time paths.
#test
fun fast_paths_agree() {
    let all = pattern(6000)
    var n = CRC_SLICE_MIN - 9
    while n <= all.len() {
        let s = part(all, 0, n)
        let b = bytes_of(s)
        var crc: uint32 = 0
        var adler: uint32 = 1
        var at = 0
        while at < n {
            let piece = part(s, at, if at + 100 < n { at + 100 } else { n })
            crc = crc32_update(crc, piece)
            adler = adler32_update(adler, piece)
            at += 100
        }
        assert(crc32(s) == crc, f"crc32 at {n}")
        assert(crc32_bytes(b) == crc, f"crc32_bytes at {n}")
        assert(adler32(s) == adler, f"adler32 at {n}")
        assert(adler32_bytes(b) == adler, f"adler32_bytes at {n}")
        if n < CRC_SLICE_MIN + 9 {
            n += 1
        } else {
            n += 997
        }
    }
}

// The table is the CRC register after each byte, computed bit by bit.
#test
fun crc_table_matches() {
    let t = crc_table()
    assert(t.len() == 256, "256 entries")
    var x: uint32 = 0
    while x < 256 {
        var c = x
        var k = 0
        while k < 8 {
            if (c & 1) != 0 {
                c = 0xEDB88320 ^ (c >> 1)
            } else {
                c = c >> 1
            }
            k += 1
        }
        assert(t[x as int] == c, f"entry {x}")
        x += 1
    }
}
