// std.checksum: FNV-1a, CRC-32 and Adler-32 (MYLA-327, MYLA-359).
//
// - `fnv1a32` and `fnv1a64` hash a `str` or a `[uint8]` at once.
// - `crc32` (IEEE, the one of zlib, gzip and PNG) and `adler32` (zlib's) are
//   checksums, incremental through their `_update` forms.
//
// They were std.hash's, which every program has (D166); a program imports
// this module. Every operation has a `str` form and a `[uint8]` form
// (`_bytes`), equal on equal bytes. The integers wrap (D4), which these
// algorithms rely on.

// --- FNV-1a -----------------------------------------------------------------

const FNV32_BASIS: uint32 = 0x811c9dc5
const FNV32_PRIME: uint32 = 16777619
const FNV64_BASIS: uint64 = 0xcbf29ce484222325
const FNV64_PRIME: uint64 = 0x100000001b3

// FNV-1a with 32 bits: for each byte, xor it in, then multiply by the prime.
// Simple and short, but a byte at a time, so slower than wyhash on long
// input. The vectors are the reference's (Fowler, Noll and Vo).
#test("")[0x811c9dc5u32]
#test("a")[0xe40c292cu32]
#test("foobar")[0xbf9cf968u32]
pub fun fnv1a32(s: str) -> uint32 {
    var h = FNV32_BASIS
    let n = s.len()
    var i = 0
    while i < n {
        h = (h ^ (s[i] as uint32)).wrapping_mul(FNV32_PRIME)
        i += 1
    }
    return h
}

#test([])[0x811c9dc5u32]
#test([102u8, 111u8, 111u8, 98u8, 97u8, 114u8])[0xbf9cf968u32]
pub fun fnv1a32_bytes(b: [uint8]) -> uint32 {
    var h = FNV32_BASIS
    let n = b.len()
    var i = 0
    while i < n {
        h = (h ^ (b[i] as uint32)).wrapping_mul(FNV32_PRIME)
        i += 1
    }
    return h
}

// FNV-1a with 64 bits.
#test("")[0xcbf29ce484222325u64]
#test("a")[0xaf63dc4c8601ec8cu64]
#test("foobar")[0x85944171f73967e8u64]
pub fun fnv1a64(s: str) -> uint64 {
    var h = FNV64_BASIS
    let n = s.len()
    var i = 0
    while i < n {
        h = (h ^ (s[i] as uint64)).wrapping_mul(FNV64_PRIME)
        i += 1
    }
    return h
}

#test([])[0xcbf29ce484222325u64]
#test([102u8, 111u8, 111u8, 98u8, 97u8, 114u8])[0x85944171f73967e8u64]
pub fun fnv1a64_bytes(b: [uint8]) -> uint64 {
    var h = FNV64_BASIS
    let n = b.len()
    var i = 0
    while i < n {
        h = (h ^ (b[i] as uint64)).wrapping_mul(FNV64_PRIME)
        i += 1
    }
    return h
}

// --- CRC-32 -----------------------------------------------------------------

// From this many bytes on, the CRC is computed eight bytes at a time
// ("slicing by 8"), which needs seven more tables, derived from the first.
// Deriving them takes about as long as 1700 bytes a byte at a time.
const CRC_SLICE_MIN: int = 2048

// CRC-32 as zlib, gzip, PNG and Ethernet compute it (CRC-32/ISO-HDLC: the
// reflected polynomial 0xEDB88320, the register starting at and xored with
// 0xFFFFFFFF).
#test("")[0u32]
#test("123456789")[0xCBF43926u32] // the check value of CRC-32/ISO-HDLC
#test("The quick brown fox jumps over the lazy dog")[0x414FA339u32]
pub fun crc32(s: str) -> uint32 {
    return crc32_update(0, s)
}

#test([])[0u32]
#test([49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8])[0xCBF43926u32]
pub fun crc32_bytes(b: [uint8]) -> uint32 {
    return crc32_update_bytes(0, b)
}

// The CRC-32 of the bytes behind `crc` followed by `s`, as zlib's
// `crc32(crc, buf, len)`: start from 0, and
// `crc32_update(crc32(a), b) == crc32(a + b)`.
#test(0u32, "123456789")[0xCBF43926u32]
#test(crc32("1234"), "56789")[0xCBF43926u32]
#test(0xCBF43926u32, "")[0xCBF43926u32]
pub fun crc32_update(crc: uint32, s: str) -> uint32 {
    let n = s.len()
    var c = crc ^ 0xFFFFFFFF
    var t = crc_table()
    var i = 0
    if n >= CRC_SLICE_MIN {
        t = crc_slices(t)
        while i + 8 <= n {
            c = c ^ ((s[i] as uint32) | ((s[i + 1] as uint32) << 8) | ((s[i + 2] as uint32) << 16) |
                ((s[i + 3] as uint32) << 24))
            c = t[1792 + (c & 0xFF) as int] ^ t[1536 + ((c >> 8) & 0xFF) as int] ^
                t[1280 + ((c >> 16) & 0xFF) as int] ^ t[1024 + (c >> 24) as int] ^
                t[768 + s[i + 4] as int] ^ t[512 + s[i + 5] as int] ^ t[256 + s[i + 6] as int] ^ t[s[i + 7] as int]
            i += 8
        }
    }
    while i < n {
        c = t[((c ^ (s[i] as uint32)) & 0xFF) as int] ^ (c >> 8)
        i += 1
    }
    return c ^ 0xFFFFFFFF
}

#test(crc32("1234"), [53u8, 54u8, 55u8, 56u8, 57u8])[0xCBF43926u32]
pub fun crc32_update_bytes(crc: uint32, b: [uint8]) -> uint32 {
    let n = b.len()
    var c = crc ^ 0xFFFFFFFF
    var t = crc_table()
    var i = 0
    if n >= CRC_SLICE_MIN {
        t = crc_slices(t)
        while i + 8 <= n {
            c = c ^ ((b[i] as uint32) | ((b[i + 1] as uint32) << 8) | ((b[i + 2] as uint32) << 16) |
                ((b[i + 3] as uint32) << 24))
            c = t[1792 + (c & 0xFF) as int] ^ t[1536 + ((c >> 8) & 0xFF) as int] ^
                t[1280 + ((c >> 16) & 0xFF) as int] ^ t[1024 + (c >> 24) as int] ^
                t[768 + b[i + 4] as int] ^ t[512 + b[i + 5] as int] ^ t[256 + b[i + 6] as int] ^ t[b[i + 7] as int]
            i += 8
        }
    }
    while i < n {
        c = t[((c ^ (b[i] as uint32)) & 0xFF) as int] ^ (c >> 8)
        i += 1
    }
    return c ^ 0xFFFFFFFF
}

// `crc_table()` followed by tables 1 to 7 of slicing by 8: entry k·256 + x
// is the CRC register after byte x and k zero bytes.
fun crc_slices(t0: [uint32]) -> [uint32] {
    var t = t0
    var k = 256
    while k < 2048 {
        let prev = t[k - 256]
        t.push((prev >> 8) ^ t[(prev & 0xFF) as int])
        k += 1
    }
    return t
}

// The CRC register after the byte x, for each x: the table every CRC-32
// implementation has (`crc_table_matches` derives it bit by bit).
fun crc_table() -> [uint32] {
    return [
        0x00000000, 0x77073096, 0xEE0E612C, 0x990951BA, 0x076DC419, 0x706AF48F, 0xE963A535, 0x9E6495A3,
        0x0EDB8832, 0x79DCB8A4, 0xE0D5E91E, 0x97D2D988, 0x09B64C2B, 0x7EB17CBD, 0xE7B82D07, 0x90BF1D91,
        0x1DB71064, 0x6AB020F2, 0xF3B97148, 0x84BE41DE, 0x1ADAD47D, 0x6DDDE4EB, 0xF4D4B551, 0x83D385C7,
        0x136C9856, 0x646BA8C0, 0xFD62F97A, 0x8A65C9EC, 0x14015C4F, 0x63066CD9, 0xFA0F3D63, 0x8D080DF5,
        0x3B6E20C8, 0x4C69105E, 0xD56041E4, 0xA2677172, 0x3C03E4D1, 0x4B04D447, 0xD20D85FD, 0xA50AB56B,
        0x35B5A8FA, 0x42B2986C, 0xDBBBC9D6, 0xACBCF940, 0x32D86CE3, 0x45DF5C75, 0xDCD60DCF, 0xABD13D59,
        0x26D930AC, 0x51DE003A, 0xC8D75180, 0xBFD06116, 0x21B4F4B5, 0x56B3C423, 0xCFBA9599, 0xB8BDA50F,
        0x2802B89E, 0x5F058808, 0xC60CD9B2, 0xB10BE924, 0x2F6F7C87, 0x58684C11, 0xC1611DAB, 0xB6662D3D,
        0x76DC4190, 0x01DB7106, 0x98D220BC, 0xEFD5102A, 0x71B18589, 0x06B6B51F, 0x9FBFE4A5, 0xE8B8D433,
        0x7807C9A2, 0x0F00F934, 0x9609A88E, 0xE10E9818, 0x7F6A0DBB, 0x086D3D2D, 0x91646C97, 0xE6635C01,
